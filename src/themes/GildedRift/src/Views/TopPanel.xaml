<!--
    Gilded Rift: top bar. 52px of navy (TopPanelBackgroundBrush) closed by a 1px gold rule (TopPanelRuleStartBrush, strong for
    the first 40% then fading to TopPanelRuleEndBrush) with a 10px gold keystone diamond on the rule 12.5px from the left.
    Order: menu (sidebar hidden only), search (232x34), filter toggle, then the main items with sorting first (a
    content-sized Grid, template-based column triggers: sorting, a 1x18 separator, details / grid / list, then group,
    search button and the rest), notifications on the right, plugin items, the running task. View switches are icons only
    at IconSize. All cells are 34px. Toggled cells are bronze plates with a gold underline. Filter active: an 8x8 gold
    diamond (DataChangeNotifBrush) on the filter icon's top-right corner, no text. Notifications: a 15px hextech count disc
    (RunningIndicatorBrush, the live colour). 142px stay clear on the right for the window buttons.
    Playnite adds two plain Canvas separators to the main items; the implicit Canvas style draws them (both in column 1)
    as one 1x18 rule in TopPanelSeparatorBrush; the second rule of the preview is a wider gap before the group cell.
    Colors: TopPanelBackgroundBrush, TopPanelRuleStartBrush, TopPanelRuleEndBrush, TopPanelSeparatorBrush, GlyphBrush,
    TopPanelItemHoverBackgroundBrush, TopPanelItemCheckedBackgroundBrush, DataChangeNotifBrush, RunningIndicatorBrush,
    TextBrushDark. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">
    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentControl Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentControl Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentControl Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentControl Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentControl Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentControl Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentControl Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentControl Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentControl Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentControl Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />
    <!-- Filter toggle: a 34px cell like the other items. Panel open (IsChecked) = bronze plate, gold underline and a TextBrush glyph.
         Filter active (Tag True): an 8x8 diamond in the notification accent on the icon's top-right corner, no text. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="HoverPlate" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                        <Border x:Name="ActivePlate" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TopPanelItemCheckedBackgroundBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle Height="8" Margin="5,0,5,0" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" Opacity="0.35">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="Transparent" />
                                            <GradientStop Offset="0.6" Color="Black" />
                                            <GradientStop Offset="1" Color="Transparent" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Rectangle Height="2" Margin="7,0,7,2" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                        <ContentControl Content="{DynamicResource IconFilter}" ContentTemplate="{DynamicResource IconTemplate}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Focusable="False" IsHitTestVisible="False"
                                        Foreground="{TemplateBinding Foreground}" />
                        <Path x:Name="TextFilter" Visibility="Collapsed" IsHitTestVisible="False" Width="8" Height="8" Stretch="Fill"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                              Data="M4,0 L8,4 L4,8 L0,4 Z" Fill="{DynamicResource DataChangeNotifBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="ActivePlate" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="HoverPlate" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Notifications: a 34px cell with the bell and a 15px count disc in the live colour (hextech teal) at its top-right.
         Hidden while there are none; the list panel being open (IsChecked) takes the bronze plate and underline. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="HoverPlate" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                        <Border x:Name="ActivePlate" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TopPanelItemCheckedBackgroundBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Rectangle Height="2" Margin="7,0,7,2" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" SnapsToDevicePixels="True" />
                        </Border>
                        <ContentControl Content="{DynamicResource IconNotifications}" ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Focusable="False" IsHitTestVisible="False" />
                        <!-- Count badge: a 15px disc (grows to a pill for two digits) in the live colour. -->
                        <Border MinWidth="15" Height="15" CornerRadius="7.5" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,1,0"
                                Background="{DynamicResource RunningIndicatorBrush}" IsHitTestVisible="False">
                            <TextBlock Text="{Api Notifications.Count}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrushDark}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="ActivePlate" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="HoverPlate" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Grid Height="52" Panel.ZIndex="2"
                          d:DesignWidth="1280"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource TopPanelBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- The bar's closing rule: 1px of TopPanelRuleEndBrush with TopPanelRuleStartBrush over it, strong for the first 40% and
                             fading out, then the keystone diamond sitting on it (it hangs 4.5px below the bar over the views, which sit under the bar's ZIndex). -->
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource TopPanelRuleEndBrush}" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource TopPanelRuleStartBrush}" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="Black" />
                                    <GradientStop Offset="0.4" Color="Black" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Path x:Name="Keystone" Data="M5,0 L10,5 L5,10 L0,5 Z" Width="10" Height="10" Stretch="None"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12.5,0,0,-4.5"
                              Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                        <DockPanel Margin="18,9,142,9">
                            <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                    DockPanel.Dock="Left" Margin="0,0,8,0" Cursor="Hand" Width="32"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <ContentControl Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <SearchBox x:Name="PART_TextMainSearch" Style="{DynamicResource TopPanelSearchBox}"
                                       Margin="0,0,8,0"
                                       WindowChrome.IsHitTestVisibleInChrome="True"
                                       Width="232" DockPanel.Dock="Left" HorizontalAlignment="Left" />
                            <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" DockPanel.Dock="Left" />
                            <!-- Keep sorting first even though Playnite inserts it after view settings and grouping. -->
                            <Grid x:Name="PART_PanelMainItems" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="{x:Type TopPanelItem}" BasedOn="{StaticResource {x:Type TopPanelItem}}">
                                        <Style.Triggers>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSortSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="0" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchDetailsViewTemplate}">
                                                <Setter Property="Grid.Column" Value="2" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchGridViewTemplate}">
                                                <Setter Property="Grid.Column" Value="3" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchListViewTemplate}">
                                                <Setter Property="Grid.Column" Value="4" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGroupSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="5" />
                                                <Setter Property="Margin" Value="9,0,0,0" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSearchButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="6" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGeneralViewSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="7" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelFilterPresetsSelectionTemplate}">
                                                <Setter Property="Grid.Column" Value="8" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelUpdateButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="9" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="10" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelViewSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="11" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelExplorerSwitchTemplate}">
                                                <Setter Property="Grid.Column" Value="12" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="Separator">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Grid.Column" Value="1" />
                                        <Setter Property="Width" Value="1" />
                                        <Setter Property="Height" Value="18" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="MaxWidth" Value="1" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Style>
                                </Grid.Resources>
                            </Grid>
                            <CheckBox x:Name="PART_ToggleNotifications"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" DockPanel.Dock="Right" />
                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Stretch" Margin="12,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Center" Margin="0,2">
                                <Grid MaxWidth="600" MinWidth="300">
                                    <ProgressBar Name="PART_ProgressGlobal" Height="12" />
                                    <TextBlock Name="PART_TextProgressText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Style="{DynamicResource BaseTextBlockStyle}" Margin="14,0,14,0" />
                                </Grid>
                                <Button Name="PART_ButtonProgressCancel" Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True" Padding="10,0" Margin="5,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
