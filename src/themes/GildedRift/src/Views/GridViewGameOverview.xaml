                                                            <Border x:Name="MetaLinks"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource FrameBrush}" Height="9" Margin="0,4,0,4" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                                                    <Border x:Name="PART_ElemLinks" MinHeight="23">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="2*" />
                                                                                <ColumnDefinition Width="12" />
                                                                                <ColumnDefinition Width="3*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{DynamicResource LOCLinksLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                                            <ItemsControl Grid.Column="2" x:Name="PART_ItemsLinks" Tag="">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                            </ItemsControl>
                                                                        </Grid>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </WrapPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        </Grid>
                                        </Grid>
                                    </StackPanel>
                                    <Grid VerticalAlignment="Top" Height="{Binding ViewportHeight, ElementName=PART_ScrollViewHost}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24" IsHitTestVisible="False">
                                            <Control Template="{DynamicResource EmptyGameTemplate}" Foreground="{DynamicResource GlyphBrush}" BorderBrush="{DynamicResource RunningIndicatorBrush}" Background="{DynamicResource ShellBackgroundBrush}"
                                                     Width="300" Height="300" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" Margin="0,-34,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource HeadingForegroundBrush}" />
                                            <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource FrameBrush}" Width="180" Height="9" Margin="0,10,0,0" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                            <Button x:Name="SidePanelCloseButton" Tag="{DynamicResource GameBannerHeight}"

                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" Width="28" Height="28" Padding="0"
                                    Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}"
                                    Command="{MainViewModel CloseGameSideBarCommand}">
<Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Visibility" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Collapsed` : `Visible`'}" />
    <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
</Style></Button.Style>
                                <!-- Close: a 28x28 plate with its top-left and bottom-right corners cut 5px. It reads at rest (ButtonBackgroundBrush fill, a NormalBorderBrush
                                     rim, a 14px TextBrush glyph) and has an animated hover: a DangerBrush plate fades in over 0.12s and the glyph turns DangerForegroundBrush. -->
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="Transparent">
                                            <Path Data="M 5.5,0.5 L 27.5,0.5 L 27.5,22.5 L 22.5,27.5 L 0.5,27.5 L 0.5,5.5 Z" Fill="{DynamicResource ButtonBackgroundBrush}"
                                                  Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1" StrokeLineJoin="Miter" IsHitTestVisible="False" />
                                            <Path x:Name="HoverPlate" Data="M 5.5,0.5 L 27.5,0.5 L 27.5,22.5 L 22.5,27.5 L 0.5,27.5 L 0.5,5.5 Z" Fill="{DynamicResource DangerBrush}"
                                                  Opacity="0" IsHitTestVisible="False" />
                                            <ContentControl x:Name="Glyph" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                            Content="{DynamicResource IconWindowClose}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                    </Storyboard></BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard><Storyboard>
                                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                    </Storyboard></BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HoverPlate" Property="Opacity" Value="0.7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
