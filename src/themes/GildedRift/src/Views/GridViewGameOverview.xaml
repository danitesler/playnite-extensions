<!--
    Gilded Rift: grid side panel. Generated by art/gen-overviews.mjs; edit the generator, not this file.
    Same skeleton as the details view, narrower: banner, spacer x * 100 / 300 (14 floor), the icon plate (56px) and the game
    name in Cinzel Bold 28px with the flourish, actions under it, then text left and the notched metadata frame right
    (GridDetailsPaneWidth, 300 content width) with captions beside values. Close (CloseGameSideBarCommand) is a 28x28 notched plate
    that sits before the icon below 120px banner height, otherwise at the top-left corner, and is always in the empty
    state's corner. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="GridViewGameOverview">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewGameOverview">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <ScrollViewer CanContentScroll="False" x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                                <Grid x:Name="PageRoot" UseLayoutRounding="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                        <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                        <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                        <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0.38" />
                                                    <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.96" />
                                                    <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                    <StackPanel Panel.ZIndex="2" Margin="24,0,24,26">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border x:Name="GridBannerSpacer" MinHeight="14">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 100 / 300'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="14" />
                                                        </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed"><Setter Property="Height" Value="14" /></DataTrigger>
                                        </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Panel.ZIndex="2" Margin="0,10,0,16">
                                            <DockPanel Panel.ZIndex="2">
                                                <Button x:Name="InlineSidePanelCloseButton" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Margin="0,0,10,0" Width="28" Height="28" Padding="0" Focusable="False" Cursor="Hand"
                                                        ToolTip="{DynamicResource LOCCloseLabel}" Command="{MainViewModel CloseGameSideBarCommand}"
                                                        Template="{Binding Template, ElementName=SidePanelCloseButton}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="{Binding Tag, ElementName=SidePanelCloseButton, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Visible` : `Collapsed`'}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.RenderTransform>
                                                        <TranslateTransform Y="{Binding ContentVerticalOffset, ElementName=PART_ScrollViewHost}" />
                                                    </Button.RenderTransform>
                                                </Button>
                                                <Grid x:Name="IconPlate" DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageIcon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid Margin="2" Width="44" Height="44" Clip="M 5,0 L 44,0 L 44,39 L 39,44 L 0,44 L 0,5 Z">
                                                        <Rectangle Fill="{DynamicResource ShellBackgroundBrush}" />
                                                        <Image x:Name="PART_ImageIcon" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" />
                                                    </Grid>
                                                    <Path Data="M 6,1 L 47,1 L 47,42 L 42,47 L 1,47 L 1,6 Z" Stroke="{DynamicResource FrameBrush}" StrokeThickness="2" StrokeLineJoin="Miter" IsHitTestVisible="False" />
                                                    <Path Data="M 6,1 L 47,1 L 47,42 L 42,47 L 1,47 L 1,6 Z" Stroke="{DynamicResource BevelLightBrush}" StrokeThickness="2" StrokeLineJoin="Miter" IsHitTestVisible="False">
                                                        <Path.OpacityMask>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="Black" Offset="0" />
                                                                <GradientStop Color="Black" Offset="0.18" />
                                                                <GradientStop Color="Transparent" Offset="0.6" />
                                                            </LinearGradientBrush>
                                                        </Path.OpacityMask>
                                                    </Path>
                                                    <Path Data="M 6,1 L 47,1 L 47,42 L 42,47 L 1,47 L 1,6 Z" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="2" StrokeLineJoin="Miter" IsHitTestVisible="False">
                                                        <Path.OpacityMask>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="Transparent" Offset="0.45" />
                                                                <GradientStop Color="Black" Offset="0.95" />
                                                            </LinearGradientBrush>
                                                        </Path.OpacityMask>
                                                    </Path>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center" Margin="0">
                                                    <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="28"
                                                               LineHeight="32" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource HeadingForegroundBrush}" TextWrapping="Wrap" />
                                                    <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Width="240" Height="9" HorizontalAlignment="Left" Margin="0,8,0,0" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                        <Control.Style>
                                                            <Style TargetType="Control">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Control.Style>
                                                    </Control>
                                                </StackPanel>
                                            </DockPanel>
                                            <WrapPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                <Grid Width="196" Height="46" Margin="16,0,16,0" VerticalAlignment="Center">
                                                    <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                    <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                                    <Control Style="{DynamicResource RunningActionIndicator}" />
                                                </Grid>
                                                <Button x:Name="PART_ButtonMoreActions" Width="40" Height="40" Padding="0" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{DynamicResource LOCMoreAction}">
                                                    <ContentControl Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                                <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="{DynamicResource LOCEditGame}">
                                                    <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Grid x:Name="GridOverviewBody" Margin="0,4,0,0">
                                        <Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400">
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="GridMetadataContent" />
                                        </MultiBinding></Grid.Tag>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid x:Name="GridMainColumn" VerticalAlignment="Top">
                                        <Grid.Style><Style TargetType="Grid">
                                            <Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" />
                                            
                                            <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
                                                <Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="2" />
                                                
                                            </DataTrigger></Style.Triggers>
                                        </Style></Grid.Style>
                                        <Grid.MaxWidth><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="z == true ? x : Max(0, x - y - 24)">
                                            <Binding Path="ActualWidth" ElementName="GridOverviewBody" /><Binding Path="ActualWidth" ElementName="GridMetadataColumn" /><Binding Path="Tag" ElementName="GridOverviewBody" />
                                        </MultiBinding></Grid.MaxWidth>
                                        <StackPanel>
                                            <Grid x:Name="SteamScreenshotsGameScope">
                                                <!-- Plugin visibility is shared: a late Steam load must never reveal a different game's section. -->
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Game.Source.Name}" Value="Steam">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                            <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" Margin="0,0,0,16">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Game.PluginId}" Value="CB91DFC9-B977-43BF-8E70-55F46E410FAB" />
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Border Tag="{Binding Game.Id, NotifyOnTargetUpdated=True}" Visibility="Collapsed" Height="128" Margin="0,0,0,16">
                                                    <Border.Triggers>
                                                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Border.Triggers>
                                                    <Grid x:Name="SkeletonCells">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                        <Border Grid.Column="2" Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                        <Border Grid.Column="4" Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            </Grid>
                                            <StackPanel x:Name="PART_ElemDescription">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Data="M 4,0 L 8,4 L 4,8 L 0,4 Z" Fill="{DynamicResource HeadingMarkerBrush}" Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    <TextBlock Grid.Column="1" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource HeadingForegroundBrush}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{DynamicResource LOCGameDescriptionTitle}" />
                                                    <Rectangle Grid.Column="2" Height="1" Margin="12,1,0,0" VerticalAlignment="Center" Fill="{DynamicResource HeadingRuleBrush}" IsHitTestVisible="False">
                                                        <Rectangle.OpacityMask>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="Black" Offset="0" />
                                                                <GradientStop Color="Transparent" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                </Grid>
                                                <HtmlTextView x:Name="PART_HtmlDescription" HtmlFontFamily="{DynamicResource FontFamily}" HtmlFontSize="13"
                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}" Tag="{DynamicResource LinkBrush}"
                                                              HtmlForeground="{Binding Path=(TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                              LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}" />
                                            </StackPanel>
                                            <StackPanel x:Name="PART_ElemNotes" Margin="0,20,0,0">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Data="M 4,0 L 8,4 L 4,8 L 0,4 Z" Fill="{DynamicResource HeadingMarkerBrush}" Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    <TextBlock Grid.Column="1" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource HeadingForegroundBrush}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{DynamicResource LOCNotesLabel}" />
                                                    <Rectangle Grid.Column="2" Height="1" Margin="12,1,0,0" VerticalAlignment="Center" Fill="{DynamicResource HeadingRuleBrush}" IsHitTestVisible="False">
                                                        <Rectangle.OpacityMask>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="Black" Offset="0" />
                                                                <GradientStop Color="Transparent" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                </Grid>
                                                <TextBox x:Name="PART_TextNotes" IsReadOnly="True" TextWrapping="Wrap" Style="{DynamicResource BareTextBox}" FontSize="13" Foreground="{DynamicResource TextBrushDarker}" />
                                            </StackPanel>
                                        </StackPanel>
                                        </Grid>
                                        <Grid x:Name="GridMetadataColumn" VerticalAlignment="Top">
                                        <Grid.Style><Style TargetType="Grid">
                                            <Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" />
                                            <Setter Property="Margin" Value="24,0,0,0" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
                                                <Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" />
                                                <Setter Property="Margin" Value="0,24,0,0" />
                                            </DataTrigger></Style.Triggers>
                                        </Style></Grid.Style>

                                        <Grid VerticalAlignment="Top">
                                            <Grid IsHitTestVisible="False">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="12" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="12" />
                                                    </Grid.RowDefinitions>
                                                    <Path Data="M 12,0 L 12,12 L 0,12 Z" Fill="{DynamicResource FrameBrush}" />
                                                    <Rectangle Grid.Column="1" Grid.ColumnSpan="2" Fill="{DynamicResource FrameBrush}" />
                                                    <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="{DynamicResource FrameBrush}" />
                                                    <Rectangle Grid.Row="2" Grid.ColumnSpan="2" Fill="{DynamicResource FrameBrush}" />
                                                    <Path Grid.Row="2" Grid.Column="2" Data="M 0,0 L 12,0 L 0,12 Z" Fill="{DynamicResource FrameBrush}" />
                                                </Grid>
                                                <Grid Margin="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="11" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="11" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="11" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="11" />
                                                    </Grid.RowDefinitions>
                                                    <Path Data="M 11,0 L 11,11 L 0,11 Z" Fill="{DynamicResource FrameInnerBrush}" />
                                                    <Rectangle Grid.Column="1" Grid.ColumnSpan="2" Fill="{DynamicResource FrameInnerBrush}" />
                                                    <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="{DynamicResource FrameInnerBrush}" />
                                                    <Rectangle Grid.Row="2" Grid.ColumnSpan="2" Fill="{DynamicResource FrameInnerBrush}" />
                                                    <Path Grid.Row="2" Grid.Column="2" Data="M 0,0 L 11,0 L 0,11 Z" Fill="{DynamicResource FrameInnerBrush}" />
                                                </Grid>
                                                <Grid Margin="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="11" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="11" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="11" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="11" />
                                                    </Grid.RowDefinitions>
                                                    <Path Data="M 11,0 L 11,11 L 0,11 Z" Fill="{DynamicResource NormalBrushDark}" />
                                                    <Rectangle Grid.Column="1" Grid.ColumnSpan="2" Fill="{DynamicResource NormalBrushDark}" />
                                                    <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="{DynamicResource NormalBrushDark}" />
                                                    <Rectangle Grid.Row="2" Grid.ColumnSpan="2" Fill="{DynamicResource NormalBrushDark}" />
                                                    <Path Grid.Row="2" Grid.Column="2" Data="M 0,0 L 11,0 L 0,11 Z" Fill="{DynamicResource NormalBrushDark}" />
                                                </Grid>
                                            </Grid>
                                            <Border Padding="22,17,22,17">
                                                <StackPanel x:Name="GridMetadataContent" Tag="{DynamicResource GridDetailsPaneWidth}" HorizontalAlignment="Stretch">
                                        <StackPanel.Style><Style TargetType="StackPanel">
                                            <Setter Property="Width" Value="{DynamicResource GridDetailsPaneWidth}" />
                                            <Setter Property="MaxWidth" Value="{DynamicResource GridDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers>
                                        </Style></StackPanel.Style>
                                                    <Grid ClipToBounds="True" x:Name="GridMetadataViewport">
                                                        <WrapPanel x:Name="GridMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-17,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-17,-24,0" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                            <Border x:Name="MetaProgress"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
