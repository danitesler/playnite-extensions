                                        <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Width="340" Height="9" HorizontalAlignment="Left" Margin="0,8,0,0" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                            <Control.Style>
                                                <Style TargetType="Control">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Control.Style>
                                        </Control>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Margin="0,0,0,0" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
