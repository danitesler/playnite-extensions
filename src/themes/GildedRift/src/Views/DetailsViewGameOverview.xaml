                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Game.Icon}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid Margin="2" Width="52" Height="52" Clip="M 6,0 L 52,0 L 52,46 L 46,52 L 0,52 L 0,6 Z">
