                                        </Grid>
                                        <Path Data="M 7,1 L 55,1 L 55,49 L 49,55 L 1,55 L 1,7 Z" Stroke="{DynamicResource FrameBrush}" StrokeThickness="2" StrokeLineJoin="Miter" IsHitTestVisible="False" />
