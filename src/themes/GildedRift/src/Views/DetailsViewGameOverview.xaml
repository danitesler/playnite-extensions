                                            <Path.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="Black" Offset="0" />
                                                    <GradientStop Color="Black" Offset="0.18" />
                                                    <GradientStop Color="Transparent" Offset="0.6" />
                                                </LinearGradientBrush>
                                            </Path.OpacityMask>
                                        </Path>
                                        <Path Data="M 7,1 L 55,1 L 55,49 L 49,55 L 1,55 L 1,7 Z" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="2" StrokeLineJoin="Miter" IsHitTestVisible="False">
                                            <Path.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="Transparent" Offset="0.45" />
                                                    <GradientStop Color="Black" Offset="0.95" />
                                                </LinearGradientBrush>
                                            </Path.OpacityMask>
                                        </Path>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,2">
                                        <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="34"
