<!--
    Gilded Rift: the details view's game list on the flat library layer (ContentBackgroundBrush) with the roster rows of
    DerivedStyles/DetailsViewItemStyle.xaml. The list's inner edge toward the game page is closed by a 1px FrameInnerBrush
    hairline (the preview's list edge). With Playnite's window art on, the ground drops away and the art shows through.
    Structure: Playnite Default 10.60 (PART_ListGames, PART_ControlGameView, Default's group style and item template).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type LibraryDetailsView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type LibraryDetailsView}">
                    <DockPanel d:DesignWidth="1280" d:DesignHeight="960"
                               d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid x:Name="ListGround" DockPanel.Dock="{Settings DetailsListPosition}"
                              Width="{Settings DetailsListWitdh}" Background="{DynamicResource ContentBackgroundBrush}" ClipToBounds="True">
                            <ExtendedListBox x:Name="PART_ListGames"
                                             Background="Transparent"
                                             BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                                             ItemContainerStyle="{DynamicResource DetailsViewItemStyle}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.PanningMode="VerticalOnly"
                                             Padding="0">
                                <ExtendedListBox.Style>
                                    <Style TargetType="ExtendedListBox" BasedOn="{StaticResource {x:Type ExtendedListBox}}">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ExtendedListBox.Style>
                                <ExtendedListBox.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource DetailsViewGroupStyle}" />
                                </ExtendedListBox.GroupStyle>
                                <ExtendedListBox.ItemTemplate>
                                    <DataTemplate>
                                        <GameListItem Style="{StaticResource DetailsViewItemTemplate}" />
                                    </DataTemplate>
                                </ExtendedListBox.ItemTemplate>
                            </ExtendedListBox>
                            <TextBlock FontSize="{StaticResource FontSizeLarge}" Margin="0,15,0,0"
                                       Text="{DynamicResource LOCNoItemsFound}" TextWrapping="Wrap"
                                       TextAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGames, Mode=OneWay}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- The list's inner edge: a 1px hairline on the side that faces the game page. -->
                            <Rectangle x:Name="ListEdge" Width="1" HorizontalAlignment="Right" Fill="{DynamicResource FrameInnerBrush}" IsHitTestVisible="False" />
                        </Grid>
                        <DetailsViewGameOverview x:Name="PART_ControlGameView" DockPanel.Dock="Left" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the list goes see-through like the rail; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="ListGround" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings DetailsListPosition}" Value="Right">
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="ListEdge" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
