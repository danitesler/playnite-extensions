<!--
    Gilded Rift: left rail. 44px of void (ShellBackgroundBrush) closed on its inner edge by a double gold line: a 1px
    FrameBrush at the very edge and a 1px FrameInnerBrush just inside it (drawn as overlay rectangles, so the rail stays
    44px). The main menu is the crest: a 32px diamond ring (1px FrameBrush, void fill) holding the winged gem
    (BrandMarkTemplate) in MainMenuButtonForegroundBrush; hover lights the ring (FrameHoverBrush) and the mark
    (HighlightGlyphBrush). Items are Views' CustomControls/SidebarItem.xaml. Right mirrors the edge lines and keeps
    Playnite's 25px drop; top and bottom lay the strip out horizontally with the edge lines along the free side.
    Colors: ShellBackgroundBrush, MainMenuButtonBackgroundBrush, MainMenuButtonForegroundBrush, FrameBrush,
    FrameInnerBrush, FrameHoverBrush, HighlightGlyphBrush. While Playnite draws the game art behind the window
    ({Settings ShowBackgroundImageOnWindow}) the rail fill goes transparent. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <!-- The rail's double gold edge: outer line at the border, a dimmer hairline one pixel inside. -->
                            <Rectangle x:Name="EdgeOuter" Width="1" HorizontalAlignment="Right" Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />
                            <Rectangle x:Name="EdgeInner" Width="1" HorizontalAlignment="Right" Margin="0,0,1,0" Fill="{DynamicResource FrameInnerBrush}" IsHitTestVisible="False" />
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="52" Margin="0,0,0,0"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <!-- The crest: a 32px diamond ring, void inside, with the winged gem centred in it. -->
                                        <Path x:Name="Ring" Data="M16,0.5 L31.5,16 L16,31.5 L0.5,16 Z" Width="32" Height="32" Stretch="None"
                                              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                                              Fill="{DynamicResource MainMenuButtonBackgroundBrush}" Stroke="{DynamicResource FrameBrush}"
                                              StrokeThickness="1" StrokeLineJoin="Miter" SnapsToDevicePixels="True" IsHitTestVisible="False" />
                                        <Control x:Name="MenuMark" Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                 Width="22" Height="22" VerticalAlignment="Top" Margin="0,15,0,0" Focusable="False" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Stroke" Value="{DynamicResource FrameHoverBrush}" TargetName="Ring" />
                            <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" TargetName="MenuMark" />
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeOuter" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeInner" />
                            <Setter Property="Margin" Value="1,0,0,0" TargetName="EdgeInner" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Margin" Value="0,6,0,0" TargetName="Ring" />
                            <Setter Property="Margin" Value="0,11,0,0" TargetName="MenuMark" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeOuter" />
                            <Setter Property="Height" Value="1" TargetName="EdgeOuter" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeOuter" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="EdgeOuter" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeInner" />
                            <Setter Property="Height" Value="1" TargetName="EdgeInner" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeInner" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="EdgeInner" />
                            <Setter Property="Margin" Value="0,0,0,1" TargetName="EdgeInner" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Margin" Value="0,6,0,0" TargetName="Ring" />
                            <Setter Property="Margin" Value="0,11,0,0" TargetName="MenuMark" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeOuter" />
                            <Setter Property="Height" Value="1" TargetName="EdgeOuter" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeOuter" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="EdgeOuter" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeInner" />
                            <Setter Property="Height" Value="1" TargetName="EdgeInner" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeInner" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="EdgeInner" />
                            <Setter Property="Margin" Value="0,1,0,0" TargetName="EdgeInner" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
