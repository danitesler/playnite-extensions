<!--
    Gilded Rift: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    Gilded Rift's token names stay in tokens.css; here each placeholder names the token that plays the key's role.
    Theme XAML reads brushes only, never Color keys. Placeholder syntax: docs/themes/reference.md. Keep double
    braces out of comments here: the build renders them too.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Typography. Segoe UI (every Windows has it) stands in for Spiegel; Cinzel (OFL, bundled in src/Typography and led
         as ./Typography/#Cinzel) stands in for Beaufort. Headings are caps, so only the title sizes use it. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">22</sys:Double>
    <sys:Double x:Key="FontSizeLargest">32</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Cinzel, {{text:font-heading|Cinzel}}, Palatino Linotype, Georgia, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width; apply inside the pane's horizontal padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: the client's plates are cut, not rounded. Ordinary controls take a 2px radius; Play, chips and banners draw
         their notches as paths. Discs use CornerRadiusFull on 1:1 squares only. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-small|1}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-large|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:radius-xlarge|6}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{gr-gold-pale}}</Color>                   <!-- cream text on the dark -->
    <Color x:Key="TextColorDarker">{{gr-ash}}</Color>                   <!-- muted text -->
    <Color x:Key="TextColorDark">{{gr-void}}</Color>                    <!-- text on gold fills in views Playnite draws itself -->
    <Color x:Key="MainColor">{{gr-slate}}</Color>                       <!-- control plate -->
    <Color x:Key="MainColorDark">{{gr-navy}}</Color>                    <!-- raised surfaces: cards, panels -->
    <Color x:Key="HoverColor">{{gr-slate-lit}}</Color>
    <Color x:Key="GlyphColor">{{gr-gold}}</Color>                       <!-- accent: hextech gold -->
    <Color x:Key="HighlightGlyphColor">{{gr-gold-lit}}</Color>
    <Color x:Key="PopupBackgroundColor">{{gr-void}}</Color>             <!-- the ability tooltip panel -->
    <Color x:Key="PopupBorderColor">{{gr-gold-dim}}</Color>
    <Color x:Key="BackgroundToneColor">{{gr-navy}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">#00000000</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{gr-gold-dark}}</Color>
    <Color x:Key="DataChangeNotifColor">{{gr-gold-rich}}</Color>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{gr-void}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{gr-slate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{gr-void}}" />  <!-- the dark well of the unchecked box -->
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{gr-leaf}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{gr-blood}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{gr-gold-rich}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{gr-gold-rich}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{gr-navy}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{gr-abyss}}" />

    <!-- Surfaces and art -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{gr-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{gr-abyss}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{gr-navy}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{gr-abyss}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{gr-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{gr-navy}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the client's navy
         panel (#0A1428), the darkest branded surface that is not the blue-black void. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{gr-navy}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{gr-void}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{gr-gold}}" />

    <!-- Selection and states: the cursor is a bronze wash with a gold bar and cream text; hextech teal means running. -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{gr-bronze}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{gr-gold}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{gr-slate}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{gr-bronze}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{gr-slate-lit}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{gr-hex}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{gr-blood}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{gr-hex}}" />

    <!-- Buttons: a slate plate with a dim gold rim that lights on hover; Play is the void plate with a bright gold bevel. -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{gr-gold}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{gr-slate-lit}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{gr-slate-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{gr-void}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{gr-gold}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{gr-gold-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{gr-bronze}}" />

    <!-- Inputs: a recessed void well with a dark gold rim that warms on hover and focus. -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{gr-void}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{gr-gold-dark}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{gr-gold}}" />

    <!-- Tracks and thumbs: a gold range on a slate rail, a teal progress fill (the live colour), dim gold scroll thumbs. -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{gr-slate-lit}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{gr-gold-lit}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{gr-slate}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{gr-hex}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{gr-gold}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{gr-void}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{gr-gold}}" />

    <!-- Tabs, covers, shell items -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{gr-ash}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{gr-gold-lit}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{gr-gold}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{gr-gold}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{gr-slate}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{gr-bronze}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{gr-ash}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{gr-gold}}" />

    <!-- Metadata, menus, tooltips, dialogs -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{gr-slate}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{gr-gold-lit}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{gr-slate-lit}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{gr-gold-dark}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{gr-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{gr-gold-pale}}" />

    <!-- Frames and headings: the bevel ladder. FrameBrush is the resting line, FrameInnerBrush the inner hairline,
         FrameHoverBrush the lit line; BevelLight and BevelShadow are the two ends of a lit-top-left bevel. -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{gr-gold-dark}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{gr-gold}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{gr-void}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{gr-gold}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{gr-gold-lit}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{gr-gold-lit}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{gr-gold-dark}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{gr-navy}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{gr-gold-dark}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{gr-gold-dark}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{gr-void}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{gr-gold-lit}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{gr-slate}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{gr-gold-dim}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{gr-ash}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{gr-void}}" />

    <!-- Section header bands (GroupBox, Expander, Settings headings): a navy slab under a gold rule. -->
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{gr-navy}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{gr-gold-pale}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{gr-gold-dark}}" />
    <SolidColorBrush x:Key="StripeDeepBrush" Color="{{gr-bronze}}" />
</ResourceDictionary>
