<!--
    Gumshoe: caption buttons. A 36x40 hit area holding a 30x30 chalk plate with a 2px rim and ControlCornerRadius corners,
    the cartoon's button-prompt plates. Playnite passes the Marlett codes 0 / 1 / 2 / r as Content; triggers swap them for
    the theme's glyphs. Hover lifts the plate; close hovers on a stamp-red plate. MainWindowButton (38x52, the main window's
    corner, plate centred on the 52px top bar) lives here so it is built on this file's WindowBarButton, not on Default's
    (files merge one by one). Colors: ButtonBackgroundBrush, ButtonBorderBrush, HoverBrush, DangerBrush, DangerForegroundBrush.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WindowBarButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Plate" Width="30" Height="30" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True"
                                Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="2" />
                        <ContentControl x:Name="Glyph" Focusable="False" Content="{DynamicResource IconWindowMinimize}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Content" Value="{DynamicResource IconWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="r">
                            <Setter Property="Content" Value="{DynamicResource IconWindowClose}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" TargetName="Plate" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" TargetName="Plate" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="r" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" TargetName="Plate" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" TargetName="Plate" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MainWindowButton" TargetType="Button" BasedOn="{StaticResource WindowBarButton}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="52" />
    </Style>
</ResourceDictionary>
