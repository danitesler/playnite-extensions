<!--
    Gumshoe: dialog windows (Settings, game editor, add-ons). A 40px void band (CaptionHeight 40 = the content offset) with
    faint grain: the brand coin (the paper button-prompt disc holding the Gumshoe mark) opens the title in the heading face
    with its hand-drawn underline, a row of marquee bulbs runs along the top between title and caption buttons, and a
    curtain valance (SwagTemplate scallops) hangs over the top of the content from the band's lower edge. 2px rim frames
    the window. The Settings window has no Title, so a trigger names it. Colors: WindowTitleBackgroundBrush,
    WindowTitleForegroundBrush, MainMenuButtonBackgroundBrush, MainMenuButtonForegroundBrush, ParchmentEdgeBrush,
    StripeBrush, PopupBorderBrush. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>
    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="40" VerticalAlignment="Top" ClipToBounds="True">
                                    <Border Background="{DynamicResource WindowTitleBackgroundBrush}" />
                                    <Control Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource SelectedBrush}" Opacity="0.05" Focusable="False" />
                                    <!-- Marquee bulbs along the top, clear of the title and the caption buttons. -->
                                    <Control Template="{DynamicResource BulbRowTemplate}" Foreground="{DynamicResource StripeBrush}" Opacity="0.7"
                                             Margin="176,5,112,0" VerticalAlignment="Top" Focusable="False" IsHitTestVisible="False" />
                                    <!-- The brand coin opens the title. -->
                                    <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" SnapsToDevicePixels="True"
                                            Background="{DynamicResource MainMenuButtonBackgroundBrush}" BorderBrush="{DynamicResource ParchmentEdgeBrush}" BorderThickness="2" IsHitTestVisible="False" />
                                    <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource MainMenuButtonForegroundBrush}" Width="19" Height="19"
                                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16.5,0,0,0" Focusable="False" IsHitTestVisible="False" />
                                    <!-- PART_TextTitle keeps the real title (Playnite and the Settings trigger set it); the band shows a copy with its underline.
                                         Playnite makes this element visible once a window has a Title, and unstyled it draws bare text over the band's
                                         top-left corner. So it lives in a Collapsed parent (a collapsed parent hides it whatever its own Visibility)
                                         and is also zero-sized and transparent. -->
                                    <Border Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="{TemplateBinding Title}" x:Name="PART_TextTitle" Width="0" Height="0" Opacity="0" Foreground="Transparent" />
                                    </Border>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="50,0,150,0" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                   Style="{DynamicResource BaseTextBlockStyle}" />
                                        <Control Template="{DynamicResource UnderlineTemplate}" Foreground="{DynamicResource WindowTitleForegroundBrush}" Margin="0,-8,0,0" Focusable="False" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,40,0,0" />
                                <!-- The valance: 14px of scallops hanging from the band over the top of the content; it adds no layout height. -->
                                <Control Template="{DynamicResource SwagTemplate}" Foreground="{DynamicResource WindowTitleBackgroundBrush}" VerticalAlignment="Top" Margin="0,40,0,0"
                                         Focusable="False" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
