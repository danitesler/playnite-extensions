<!--
    Gumshoe: left rail, 44px of void black with faint film grain and a column of film-sprocket holes along its inner
    edge. The main menu is a 30px paper coin (the cartoon's grey button-prompt disc) holding the Gumshoe mark; hover
    lights the coin. With the sidebar at the top or bottom the sprocket column drops away. Colors: ShellBackgroundBrush,
    MainMenuButtonBackgroundBrush, MainMenuButtonForegroundBrush, ParchmentEdgeBrush, FrameInnerBrush, SelectedBrush.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <Control x:Name="Grain" Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource SelectedBrush}" Opacity="0.05" Focusable="False" />
                            <!-- Film sprocket holes down the inner edge, 4px from it. -->
                            <Control x:Name="Sprockets" Visibility="Collapsed" Template="{DynamicResource SprocketStripTemplate}" Tag="V" Foreground="{DynamicResource FrameInnerBrush}"
                                     HorizontalAlignment="Right" Margin="0,0,4,0" Focusable="False" IsHitTestVisible="False" />
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="56" Margin="0,0,0,0"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Border x:Name="Coin" Width="30" Height="30" VerticalAlignment="Top" Margin="0,10,0,0" CornerRadius="15"
                                                Background="{DynamicResource MainMenuButtonBackgroundBrush}" BorderBrush="{DynamicResource ParchmentEdgeBrush}" BorderThickness="2"
                                                SnapsToDevicePixels="True" />
                                        <Control x:Name="MenuMark" Template="{DynamicResource LocalGumshoeMenuMarkTemplate}" Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                 Width="20" Height="20" VerticalAlignment="Top" Margin="0,15,0,0" Focusable="False" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" TargetName="Coin" />
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="Sprockets" />
                            <Setter Property="Margin" Value="4,0,0,0" TargetName="Sprockets" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Sprockets" />
                            <Setter Property="Margin" Value="0,4,0,0" TargetName="Coin" />
                            <Setter Property="Margin" Value="0,9,0,0" TargetName="MenuMark" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Sprockets" />
                            <Setter Property="Margin" Value="0,4,0,0" TargetName="Coin" />
                            <Setter Property="Margin" Value="0,9,0,0" TargetName="MenuMark" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
