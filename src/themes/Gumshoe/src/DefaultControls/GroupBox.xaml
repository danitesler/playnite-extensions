<!--
    Gumshoe: GroupBox. A card (ExpanderBackgroundBrush, CornerRadiusLarge, 2px FrameBrush rim, GroupBoxPadding) under a swallowtail
    ribbon header: RibbonTemplate in HeaderBandBrush, 30px tall, the title in HeadingFontFamily at FontSizeLarge in
    HeaderBandForegroundBrush. The ribbon overlaps the card's top edge by 10px. The template is content-sized (Statistics
    sections wrap as cards): no fixed or stretched wide art, the ribbon takes its width from its text and RibbonTemplate reports
    no width of its own. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="1" Margin="0,-10,0,0" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusLarge}">
                            <Border Padding="0,10,0,0">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Border>
                        <Grid Grid.Row="0" Panel.ZIndex="1" Height="30" Margin="12,0,0,0" HorizontalAlignment="Left">
                            <Control Template="{DynamicResource RibbonTemplate}" Foreground="{DynamicResource HeaderBandBrush}"
                                     Focusable="False" IsHitTestVisible="False" />
                            <TextBlock Margin="26,0" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFontFamily}"
                                       FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource HeaderBandForegroundBrush}">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                            </TextBlock>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
