<!--
    Gumshoe: ContextMenu. Every popup menu and dropdown list (the hamburger menu, top bar dropdowns via TopPanelMenu,
    GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select boxes) wears
    the chalkboard modal (LocalChalkboardMenuTemplate): PopupBackgroundBrush with 2px PopupBorderBrush rim, ControlCornerRadius,
    faint film grain (GrainTemplate at 0.05), an inset chalk hairline, and a short masking-tape strip (ParchmentBrush)
    taping the top centre edge (rising 2px above the rim, so hosts leave 3px above the board and start rows 8px down).
    Rows and the 10px flourish group break are in Menu.xaml.
    Structure: Playnite Default 10.60. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalChalkboardMenuTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="{DynamicResource PopupBorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Control Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource TextBrush}"
                     Opacity="0.05" Margin="2" Focusable="False" IsTabStop="False" />
            <Border Margin="4" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                    CornerRadius="5" Opacity="0.28" />
            <!-- Masking-tape tab holding the top edge of the chalkboard modal -->
            <Border Width="54" Height="6" Margin="0,-2,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="{DynamicResource ParchmentBrush}" BorderBrush="{DynamicResource ParchmentEdgeBrush}"
                    BorderThickness="0,0,0,1" CornerRadius="1" Opacity="0.92" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" Margin="0,3,0,0" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalChalkboardMenuTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,8,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="6,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
