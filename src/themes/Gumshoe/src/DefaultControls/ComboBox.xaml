<!--
    Gumshoe: ComboBox. The option row: the value sits in the recessed well (InputBackgroundBrush, 2px InputBorderBrush rim) and
    on the right a 22x22 paper plate (SelectedSheenBrush, radius 6) holds an ink triangle (SelectedForegroundBrush) that flips
    with a BackEase while the list is open.
    List: the menus' chalkboard modal (LocalChalkboardMenuTemplate, ContextMenu.xaml). Items (ComboBoxItem) are 30px rows
    matching Menu.xaml: cream at rest, a feathered lit-paper smudge with an ink triangle pip sliding in on IsHighlighted (label
    flips to ink), and the chosen item (IsSelected) keeps its button-prompt check disc visible in the leading column.
    Chevron room: ContentSite sits in a Border with right margin 36 = plate 22 + margin 5 + 8; PART_EditableTextBox keeps the
    same 36 (AGENTS.md ComboBox chevron room). Structure: Playnite Default 10.60. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Border" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Control x:Name="FieldOverlay" Template="{DynamicResource LocalDeskLampFieldTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Grid Background="Transparent">
                                        <Border x:Name="ArrowPlate" Width="22" Height="22" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                CornerRadius="6" Background="{DynamicResource SelectedSheenBrush}">
                                            <Path x:Name="Arrow" Data="M0,0 L10,0 L5,7 Z" Width="10" Height="7" Margin="0,1,0,0" Stretch="None"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                                  Fill="{DynamicResource SelectedForegroundBrush}">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="ArrowRotation" Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ArrowPlate" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ArrowPlate" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ArrowRotation" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard FillBehavior="Stop">
                                                        <DoubleAnimation Storyboard.TargetName="ArrowRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.12" FillBehavior="Stop">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseIn" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border Margin="0,0,36,0" IsHitTestVisible="False">
                            <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        </Border>
                        <TextBox x:Name="PART_EditableTextBox" MinHeight="0" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 Margin="0,0,36,0" Focusable="True" BorderThickness="0" Background="Transparent"
                                 Style="{DynamicResource BareTextBox}" Padding="{DynamicResource InputPadding}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" Foreground="{DynamicResource TextBrush}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               Focusable="False" AllowsTransparency="True">
                            <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                  Margin="0,3,0,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Control Template="{DynamicResource LocalChalkboardMenuTemplate}" Focusable="False" IsTabStop="False" />
                                <ScrollViewer Margin="0,8,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Name="ItemsPresenter" Margin="6,0" KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource TextBrushDarker}" TargetName="Border" />
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{DynamicResource TextBrushDarker}" TargetName="Border" />
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                        </MultiTrigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="ContentSite" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid x:Name="ListRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid x:Name="ListSmudge" Margin="0,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ListSmudgeShift" X="-6" />
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="{DynamicResource SelectedBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#FF000000" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle Grid.Column="1" Fill="{DynamicResource SelectedBrush}" />
                            <Rectangle Grid.Column="2" Fill="{DynamicResource SelectedBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FF000000" />
                                        <GradientStop Offset="1" Color="#00000000" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                        <Path x:Name="ListPip" Width="5" Height="8" Margin="6,0,0,0" Stretch="Fill" HorizontalAlignment="Left"
                              VerticalAlignment="Center" Data="M 0,0 L 5,4 L 0,8 Z" Fill="{DynamicResource SelectedForegroundBrush}"
                              Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                            <Path.RenderTransform>
                                <TranslateTransform x:Name="ListPipShift" X="-5" />
                            </Path.RenderTransform>
                        </Path>
                        <Grid Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ListCheckDisc" Grid.Column="0" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="Collapsed" CornerRadius="8" Background="{DynamicResource SelectedBrush}"
                                    BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1.5">
                                <Path Width="8" Height="6" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 1,3.5 L 3.8,6.5 L 9,1" Stroke="{DynamicResource SelectedForegroundBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Border>
                            <ContentPresenter x:Name="ListLabel" Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="ListLabelShift" X="0" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="ListCheckDisc" />
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedForegroundBrush}" TargetName="ListCheckDisc" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ListHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListSmudge" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListPip" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListSmudge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ListSmudgeShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ListPip" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="ListPipShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ListLabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ListHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListSmudge" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListPip" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListSmudge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ListSmudgeShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ListPip" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ListPipShift" Storyboard.TargetProperty="X" To="-5" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ListLabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" TargetName="ListRow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
