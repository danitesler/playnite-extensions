    <!-- Play: a fat triangle with a small one inside so the thick stroke reads as a solid wedge. -->
    <Geometry x:Key="IconPlay">M8,5.5 L18.5,12 L8,18.5 Z M10,9.2 L14.4,12 L10,14.8 Z</Geometry>
    <Geometry x:Key="IconInfo">M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 M12,11 V16.5 M12,7.6 L12.01,7.6</Geometry>
    <Geometry x:Key="IconDownload">M12,4 V15 M7,10.5 L12,15.5 L17,10.5 M5,20 H19</Geometry>

    <DataTemplate x:Key="IconTemplate">
        <Viewbox MaxWidth="{DynamicResource IconSize}" MaxHeight="{DynamicResource IconSize}">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                      StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </DataTemplate>
    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox MaxWidth="12" MaxHeight="12">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                      StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentPresenter MaxWidth="14" MaxHeight="14" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentPresenter MaxWidth="16" MaxHeight="16" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <!-- Playnite menu icons with hardcoded colors in Default: red moves onto the stamp red, yellow onto the lamp amber. -->
