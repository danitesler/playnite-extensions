<!--
    Gumshoe: the icon set. Chunky rounded-stroke glyphs on a 24 grid, the way the cartoon's menus draw things:
    thick round-capped lines, bulbous corners, no hairlines. The geometries are centre lines: IconTemplate strokes
    them (2.6 units, round caps and joins) in the control's Foreground and does not fill. A zero-length segment
    with round caps is a dot.
    Menu item icons are the theme's own PNG set (art/menu-icons.json, docs/themes/menu-icons.md).
-->
<ResourceDictionary xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

