<!--
    Gumshoe: SidebarItem. A 44x40 cell with a 16px glyph. Idle glyphs are smoke grey; hover lifts a chalk plate and
    brightens the glyph. Current: a paper bookmark (BookmarkTemplate: lit paper body, swallowtail foot, page-edge rim)
    hanging from above the cell that drops in with a BackEase in 200 ms, the glyph in ink. The bookmark nudges 3px down
    on hover. Fixed 14,12 padding sizes the glyph; IconPadding is not added on top (it would collapse the Viewbox).
    Library and Statistics use the theme's glyphs. Colors: SidebarItemForegroundBrush, SidebarItemSelectedForegroundBrush,
    TopPanelItemHoverBackgroundBrush, SelectedBrush, ParchmentEdgeBrush. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="Plate" Width="32" Height="32" SnapsToDevicePixels="True" Background="{TemplateBinding Background}" />
                        <!-- Hover: a lifted chalk plate. -->
                        <Border x:Name="HoverPlate" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource TopPanelItemHoverBackgroundBrush}" Opacity="0" IsHitTestVisible="False" />
                        <!-- Current: the paper bookmark hanging from above the cell. -->
                        <Grid x:Name="Marks" Visibility="Collapsed" IsHitTestVisible="False" Width="28" Height="46" VerticalAlignment="Top" Margin="0,-6,0,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="MarkShift" Y="0" />
                            </Grid.RenderTransform>
                            <Control Template="{DynamicResource BookmarkTemplate}" Background="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource ParchmentEdgeBrush}" Focusable="False" />
                        </Grid>
                        <Border x:Name="GlyphHost" Padding="14,12">
                            <Viewbox x:Name="ItemIcon">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                        </Border>
                        <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                        Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ContentTemplate="{DynamicResource IconTemplate}" />
                        <ProgressBar x:Name="PART_ProgressStatus" Height="2" Margin="10,0,10,2" BorderThickness="0" Background="Transparent"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="MarkShift" Storyboard.TargetProperty="Y" To="3" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="MarkShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Hidden" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Marks" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MarkShift" Storyboard.TargetProperty="Y" From="-30" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
