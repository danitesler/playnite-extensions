<!--
    Gumshoe: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    Gumshoe's token names stay in tokens.css; here each placeholder names the token that plays the key's role.
    Theme XAML reads brushes only, never Color keys. Placeholder syntax: docs/themes/reference.md. Keep double
    braces out of comments here: the build renders them too.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Typography. Patrick Hand (hand-lettered body and headings) and Anton (poster capitals) are OFL stand-ins for the
         game's custom faces; both are bundled in src/Typography and lead their stacks as ./Typography/#Family.
         Patrick Hand runs small for its size, so the scale is one step above Playnite's. -->
    <sys:Double x:Key="FontSizeSmall">13</sys:Double>
    <sys:Double x:Key="FontSize">15</sys:Double>
    <sys:Double x:Key="FontSizeLarge">17</sys:Double>
    <sys:Double x:Key="FontSizeLarger">23</sys:Double>
    <sys:Double x:Key="FontSizeLargest">38</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Patrick Hand, {{text:font-body|Patrick Hand}}, Segoe Print, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Patrick Hand, {{text:font-heading|Patrick Hand}}, Segoe Print, Segoe UI</FontFamily>
    <FontFamily x:Key="PosterFontFamily">./Typography/#Anton, {{text:font-poster|Anton}}, Impact, Arial Narrow, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width; apply inside the pane's horizontal padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: the game's plates are soft-cornered with a darker rim. Medium step 8px; discs use CornerRadiusFull on 1:1 squares only. -->
    <Thickness x:Key="PopupBorderThickness">2</Thickness>
    <Thickness x:Key="ControlBorderThickness">2</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius|8}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-small|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-large|12}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:radius-xlarge|16}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{gs-cream}}</Color>                       <!-- text on the dark -->
    <Color x:Key="TextColorDarker">{{gs-smoke}}</Color>                 <!-- muted text -->
    <Color x:Key="TextColorDark">{{gs-ink}}</Color>                     <!-- ink on paper: selected rows, the lit Play plate -->
    <Color x:Key="MainColor">{{gs-chalk}}</Color>                       <!-- control plate -->
    <Color x:Key="MainColorDark">{{gs-felt}}</Color>                    <!-- raised surfaces: cards, panels -->
    <Color x:Key="HoverColor">{{gs-chalk-lit}}</Color>
    <Color x:Key="GlyphColor">{{gs-paper-lit}}</Color>                  <!-- accent: the lit paper -->
    <Color x:Key="HighlightGlyphColor">{{gs-paper}}</Color>
    <Color x:Key="PopupBackgroundColor">{{gs-chalk}}</Color>            <!-- the chalkboard modal -->
    <Color x:Key="PopupBorderColor">{{gs-rim}}</Color>
    <Color x:Key="BackgroundToneColor">{{gs-felt}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">#00000000</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{gs-chalk-lit}}</Color>
    <Color x:Key="DataChangeNotifColor">{{gs-lamp}}</Color>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{gs-rim-lit}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{gs-void}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{gs-chalk}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{gs-paper-edge}}" />  <!-- the grey prompt disc -->
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{gs-paper-lit}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{gs-stamp}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{gs-lamp}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{gs-lamp}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{gs-felt}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{gs-desk}}" />

    <!-- Surfaces and art -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{gs-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{gs-desk}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{gs-felt}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{gs-felt}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{gs-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{gs-chalk}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the chalkboard
         panel (#2b2b2b), the darkest branded surface that is not the void. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{gs-chalk}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{gs-paper}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{gs-ink}}" />

    <!-- Selection and states: the cursor is the lit paper smudge with ink text. -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{gs-paper-lit}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{gs-paper-mid}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{gs-ink}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{gs-chalk-lit}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{gs-paper-lit}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{gs-chalk-lit}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{gs-lamp}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{gs-lamp}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{gs-stamp}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{gs-cream}}" />

    <!-- Buttons: a chalk plate with a rim; Play is the black sticker with a cream inner outline. -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{gs-cream}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{gs-paper-lit}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{gs-rim}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{gs-chalk-lit}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{gs-chalk-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{gs-void}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{gs-cream}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{gs-paper-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{gs-paper}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{gs-cream}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{gs-paper-lit}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{gs-paper-lit}}" />

    <!-- Inputs: a recessed void well with a lit rim. -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{gs-void}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{gs-rim}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{gs-smoke}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{gs-rim-lit}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{gs-smoke}}" />

    <!-- Tracks and thumbs: pip dashes for slider and progress, the pencil scroll bar (a 2px line and a ridged paper capsule). -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{gs-rim}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{gs-paper-lit}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{gs-paper}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{gs-paper-lit}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{gs-chalk-lit}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{gs-paper-lit}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{gs-paper-edge}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{gs-paper}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{gs-rim}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{gs-paper-edge}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{gs-paper}}" />

    <!-- Tabs, covers, shell items -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{gs-smoke}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{gs-cream}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{gs-paper}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{gs-paper-lit}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{gs-paper}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{gs-chalk-lit}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{gs-paper-lit}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{gs-smoke}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{gs-ink}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{gs-paper-lit}}" />

    <!-- Metadata, menus, tooltips, dialogs -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{gs-paper-mid}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{gs-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{gs-paper-lit}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{gs-rim}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{gs-cream}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{gs-rim}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{gs-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{gs-cream}}" />

    <!-- Paper: the case-file page behind the metadata pane (ink on page, dim ink for labels). -->
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{gs-paper}}" />
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{gs-paper-edge}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{gs-ink}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{gs-ink-title}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{gs-ink-dim}}" />
    <SolidColorBrush x:Key="ParchmentLinkBrush" Color="{{gs-ink}}" />

    <!-- Frames and headings -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{gs-rim}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{gs-chalk-lit}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{gs-rim-lit}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{gs-chalk-lit}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{gs-void}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{gs-cream}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{gs-paper}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{gs-lamp}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{gs-chalk-lit}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{gs-rim}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{gs-void}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{gs-felt}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{gs-chalk-lit}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{gs-rim}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{gs-chalk-lit}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{gs-void}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{gs-paper-mid}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{gs-chalk}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{gs-rim}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{gs-smoke}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{gs-void}}" />

    <!-- The swallowtail ribbon behind GroupBox, Expander and section headings, and the tape strips. -->
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{gs-paper-shade}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{gs-ink}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{gs-paper-mid}}" />
    <SolidColorBrush x:Key="StripeDeepBrush" Color="{{gs-paper-fold}}" />
</ResourceDictionary>
