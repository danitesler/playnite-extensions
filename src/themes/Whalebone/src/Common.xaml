<!--
    Whalebone: spacing, focus and the shared ink-and-bone parts. Measurements: ../RESEARCH.md (Dishonored 2 menus).
      InkPlateTemplate        idle entry plate: a torn rectangle of ink (Images/fx/ink-plate.png) filled with Background
      TornPlateTemplate       the menu cursor: a dry-brush stroke (brush-stroke.png) in Background with faint marble veins
      SelectionBarTemplate    selected list row: marble bone paper (Foreground) with frost edge lines (BorderBrush) and hooked tips
      LocalBrushStrokeTemplate  the bare cursor stroke in Background (sidebar current item, toggled top-bar cells)
      LocalKeycapTemplate     a key prompt (Esc Back): rounded dark cap, 1px rim (BorderBrush), lit top edge
      LocalValuePlateTemplate a value plate with pointed ends (3840 x 2160): Background fill, BorderBrush rim
      LocalInkSmearTemplate   the smear behind script captions and titles (ink-smear.png) in Background
      LocalHooksTemplate      frost hook tips at the top-left and bottom-right of a chosen plate, in Foreground
      GlowLineTemplate        the fracture rule: a hairline (Foreground) that cracks once, lit (BorderBrush) at the break, one shard
      GlowFrameTemplate       9-slice frost frame (frost-frame.png): bright core at the host's inset 24 with a soft bloom
      TabItemIndicatorTemplate  a short brush stroke under a current tab or view switch
      DividerTemplate         a hairline fading out to the right
      CornerMarksTemplate     thin L brackets (arm 10) for keyboard focus
      LocalSlotBracketsTemplate  the chosen campaign slot: offset left brackets, a "v" hook and one shard (cover hover)
      BrandMarkTemplate       the Whalebone medallion mark
    Sprites in Images/fx/ are white masks filled with theme brushes so ThemeModifier recolors them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Entry label inset on its plate; 32px rows with 5px vertical padding (shared rule). -->
    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <!-- Value plates: text clears the 10px pointed ends plus 6px. -->
    <Thickness x:Key="InputPadding">16,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <!-- Menu entries, as tight as the Pause menu's stacked plates. -->
    <Thickness x:Key="MenuItemPadding">14,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <!-- List rows: 12px clears the hook tip of the selected paper. -->
    <Thickness x:Key="ComboBoxItemPadding">14,7,12,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">14,7,12,7</Thickness>
    <!-- Panel body under a script caption (Statistics sheet). -->
    <Thickness x:Key="GroupBoxPadding">16,10,16,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,0</Thickness>
    <!-- Key prompt chip. -->
    <Thickness x:Key="TooltipPadding">10,5</Thickness>
    <!-- Shared form field and button height across all themes (32px). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <!-- Default banner: tall enough for the cracked-glass art band above the title. -->
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Shared FX masks so controls reuse frozen/shared brushes instead of allocating per-instance ImageBrushes. -->
    <ImageBrush x:Key="LocalInkPlateMaskBrush" ImageSource="{ThemeFile 'Images/fx/ink-plate.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalBrushStrokeMaskBrush" ImageSource="{ThemeFile 'Images/fx/brush-stroke.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalMarbleMaskBrush" ImageSource="{ThemeFile 'Images/fx/marble.png'}" TileMode="Tile" Viewport="0,0,256,96" ViewportUnits="Absolute" />
    <ImageBrush x:Key="LocalInkSmearMaskBrush" ImageSource="{ThemeFile 'Images/fx/ink-smear.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalBloomMaskBrush" ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Stretch="Fill" />
    <LinearGradientBrush x:Key="LocalTopFadeMaskBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF000000" Offset="0" />
        <GradientStop Color="#FF000000" Offset="0.8" />
        <GradientStop Color="#55000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LocalBottomFadeMaskBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#55000000" Offset="0" />
        <GradientStop Color="#FF000000" Offset="0.2" />
        <GradientStop Color="#FF000000" Offset="1" />
    </LinearGradientBrush>

    <!-- Idle entry plate: torn ink rectangle. -->
    <ControlTemplate x:Key="InkPlateTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Background}" OpacityMask="{StaticResource LocalInkPlateMaskBrush}" />
    </ControlTemplate>

    <!-- The cursor stroke as a plate: dry brush in Background, faint marble veins (SelectedSheenBrush) inside it. -->
    <ControlTemplate x:Key="TornPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" OpacityMask="{StaticResource LocalBrushStrokeMaskBrush}">
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle Fill="{DynamicResource SelectedSheenBrush}" Opacity="0.35" OpacityMask="{StaticResource LocalMarbleMaskBrush}" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalBrushStrokeTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Background}" OpacityMask="{StaticResource LocalBrushStrokeMaskBrush}" />
    </ControlTemplate>

    <!-- Selected row: marble paper, frost edge lines and hooks (Video Settings `Display Mode`, Lore list). -->
    <ControlTemplate x:Key="SelectionBarTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Foreground}" />
            <Rectangle Fill="{DynamicResource SelectedSheenBrush}" Opacity="0.5" OpacityMask="{StaticResource LocalMarbleMaskBrush}" />
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}" OpacityMask="{StaticResource LocalTopFadeMaskBrush}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}" OpacityMask="{StaticResource LocalBottomFadeMaskBrush}" />
            <Control Template="{DynamicResource LocalHooksTemplate}" Foreground="{TemplateBinding BorderBrush}" Margin="-7,-5" />
        </Grid>
    </ControlTemplate>

    <!-- Curled frost tips: one leaves the top-left corner, one the bottom-right (8x10 each). -->
    <ControlTemplate x:Key="LocalHooksTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Width="10" Height="9" Stretch="Fill"
                  Data="M10,0 C4,0 0,2.6 0.6,9 C1.6,5.2 4.6,2.2 10,2 Z" Fill="{TemplateBinding Foreground}" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="10" Height="9" Stretch="Fill"
                  Data="M0,9 C6,9 10,6.4 9.4,0 C8.4,3.8 5.4,6.8 0,7 Z" Fill="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- Key prompt cap (Esc Back): More, Edit, cover buttons, the grid side panel close. -->
    <ControlTemplate x:Key="LocalKeycapTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource BevelShadowBrush}" CornerRadius="{DynamicResource CornerRadiusXLarge}" Margin="0,1,0,-1" />
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusXLarge}" />
            <Rectangle Height="1" VerticalAlignment="Top" Margin="4,2,4,0" Fill="{DynamicResource BevelLightBrush}" Opacity="0.14" />
        </Grid>
    </ControlTemplate>

    <!-- Value plate with 10px pointed ends: Background fill, 1px BorderBrush rim. -->
    <ControlTemplate x:Key="LocalValuePlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Stretch="Fill" Data="M10,0 L0,10 L10,20 Z" Fill="{TemplateBinding Background}" />
            <Border Grid.Column="1" Background="{TemplateBinding Background}" />
            <Path Grid.Column="2" Stretch="Fill" Data="M0,0 L10,10 L0,20 Z" Fill="{TemplateBinding Background}" />
            <Path Grid.Column="0" Stretch="Fill" Margin="0.5,0,0,0" Data="M10,0 L0,10 L10,20" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
            <Border Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,1" />
            <Path Grid.Column="2" Stretch="Fill" Margin="0,0,0.5,0" Data="M0,0 L10,10 L0,20" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalInkSmearTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Background}" OpacityMask="{StaticResource LocalInkSmearMaskBrush}" />
    </ControlTemplate>

    <!-- Panel frame: 1px inner line (Foreground) with filigree corners at the top-left and bottom-right. -->
    <ControlTemplate x:Key="FramedPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" Margin="4" />
            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Width="22" Height="22" Stroke="{DynamicResource SectionHeaderBrush}" StrokeThickness="1.2"
                  Data="M1,21 V1 H21 M4,12 C4,7 7,4 12,4" />
            <Ellipse HorizontalAlignment="Left" VerticalAlignment="Top" Width="2.6" Height="2.6" Margin="10.7,2.7,0,0" Fill="{DynamicResource SectionHeaderBrush}" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="22" Height="22" Stroke="{DynamicResource SectionHeaderBrush}" StrokeThickness="1.2"
                  Data="M21,1 V21 H1 M18,10 C18,15 15,18 10,18" />
            <Ellipse HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="2.6" Height="2.6" Margin="0,0,10.7,2.7" Fill="{DynamicResource SectionHeaderBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Fracture rule: the hairline (Foreground) steps up 3px at a crack, the break is lit (BorderBrush) and sheds one shard. -->
    <ControlTemplate x:Key="GlowLineTemplate" TargetType="Control">
        <Grid Height="16" IsHitTestVisible="False" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="62*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Top" Margin="0,9,0,0" Fill="{TemplateBinding Foreground}" />
            <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Top" Margin="0,9,0,0" HorizontalAlignment="Right" Width="140" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Path Grid.Column="1" Data="M0,9.5 L16,6.5" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
            <Path Grid.Column="1" Data="M4,9 L13,2.5 L10.5,11 Z" Fill="{TemplateBinding BorderBrush}" />
            <Path Grid.Column="1" Data="M10.5,11 L13,2.5 L14,9 Z" Fill="{DynamicResource SelectedSheenBrush}" />
            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Top" Margin="0,6,0,0" Fill="{TemplateBinding Foreground}" />
            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left" Width="90" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- 9-slice frost frame using Images/fx/frost-frame.png; the host bleeds 24px via a negative Margin. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frost-frame.png'}" Viewbox="0,0,32,32" ViewboxUnits="Absolute" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frost-frame.png'}" Viewbox="32,0,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frost-frame.png'}" Viewbox="64,0,32,32" ViewboxUnits="Absolute" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frost-frame.png'}" Viewbox="0,32,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frost-frame.png'}" Viewbox="32,32,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frost-frame.png'}" Viewbox="64,32,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frost-frame.png'}" Viewbox="0,64,32,32" ViewboxUnits="Absolute" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frost-frame.png'}" Viewbox="32,64,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frost-frame.png'}" Viewbox="64,64,32,32" ViewboxUnits="Absolute" /></Rectangle.OpacityMask></Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- The chosen campaign slot's marks (Foreground): offset L brackets on the left corners, a "v" hook under the
         bottom centre and one glass shard off the top-right corner. -->
    <ControlTemplate x:Key="LocalSlotBracketsTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,14 L0,0 14,0 14,1.5 1.5,1.5 1.5,14Z" Fill="{TemplateBinding Foreground}" />
            <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,0 L1.5,0 1.5,12.5 14,12.5 14,14 0,14Z" Fill="{TemplateBinding Foreground}" />
            <Path HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-7" Data="M0,0 L7,6 L14,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Data="M0,7 L11,0 L6,12 Z" Fill="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- Current tab / view switch: a short dry-brush stroke along the foot. -->
    <ControlTemplate x:Key="TabItemIndicatorTemplate" TargetType="Control">
        <Rectangle Height="4" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalBrushStrokeMaskBrush}" />
    </ControlTemplate>

    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Rectangle Height="1" VerticalAlignment="Center" IsHitTestVisible="False" Fill="{TemplateBinding Foreground}">
            <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF000000" Offset="0" />
                    <GradientStop Color="#66000000" Offset="0.7" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Thin L brackets, arm 10, 1.5px (the campaign slot's corner brackets). -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,10 L0,0 10,0 10,1.5 1.5,1.5 1.5,10Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L10,0 10,10 8.5,10 8.5,1.5 0,1.5Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L1.5,0 1.5,8.5 10,8.5 10,10 0,10Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M8.5,0 L10,0 10,10 0,10 0,8.5 8.5,8.5Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource IconMainMenu}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Script section caption (Display Mode, General, Economy). -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource NoteFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
