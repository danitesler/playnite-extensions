<!--
    Whalebone: ContextMenu and the shared Dishonored 2 Dunwall ink panel (LocalMenuPanelTemplate).
    Levers: 30px rows; Dunwall ink well (PopupBackgroundBrush) with 1px pale rim, inner FramedPlateTemplate
    filigree corners (top-left and bottom-right) and faint top wine-ink wash; SelectionBarTemplate marble-paper
    highlight with curled frost hooks sliding in 6px (130ms) and deep ink text; fracture hairline group break
    stepping up 2px with a frost crack and bone shard; LocalKeycapTemplate Cinzel keycaps flipping dark on bone;
    Exit row blood-red plate with chalk ink (5.65:1); bone diamond check mark. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="{DynamicResource PopupBorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Rectangle VerticalAlignment="Top" Height="28" Margin="1,1,1,0"
                       Fill="{DynamicResource HeadingMarkerBrush}" Opacity="0.22">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Control Template="{DynamicResource FramedPlateTemplate}"
                     Foreground="{DynamicResource FrameInnerBrush}"
                     Focusable="False" IsHitTestVisible="False" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="5,4,5,4">
                            <ItemsPresenter Margin="7,5,7,5" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
