<!--
    Whalebone: RadioButton. An 18px ink ring medallion with a pale rim; checked = a bone disc inside a frost ring with a
    faint frost halo. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <DockPanel Background="Transparent">
                        <Grid Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Rectangle x:Name="Halo" Margin="-8" Visibility="Collapsed" Opacity="0.3" Fill="{DynamicResource FocusHaloBrush}" IsHitTestVisible="False">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Stretch="Fill" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Ellipse x:Name="Socket" Fill="{DynamicResource CheckBoxCheckMarkBkBrush}" Stroke="{DynamicResource CheckBoxBorderBrush}" StrokeThickness="1" />
                            <Ellipse x:Name="Core" Width="10" Height="10" Fill="{DynamicResource SelectedBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Socket" Property="Stroke" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Socket" Property="Stroke" Value="{DynamicResource SelectedBorderBrush}" />
                            <Setter TargetName="Core" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
