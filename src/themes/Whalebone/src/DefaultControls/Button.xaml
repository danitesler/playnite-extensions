<!--
    Whalebone: Button. An entry on its torn ink plate (InkPlateTemplate) in Cinzel caps; hover lifts a pewter plate,
    press darkens it and dips the label 1px (0.12s in / 0.24s out, CubicEase). Default buttons (IsDefault, Accept /
    Save) are the menu cursor: the bone dry-brush stroke (TornPlateTemplate) with ink caps and a frost bloom; hover
    repaints it frost. Width == 41 preserves ThemeModifier's 32x32 scaled icons. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FontFamily" Value="{DynamicResource UIFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Rectangle x:Name="DefaultBloom" Margin="-26,-14" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                                   Fill="{DynamicResource PrimaryButtonGlowBrush}" OpacityMask="{DynamicResource LocalBloomMaskBrush}" />
                        <Control x:Name="Plate" Template="{DynamicResource InkPlateTemplate}" Background="{TemplateBinding Background}" Margin="-2,0" Focusable="False" />
                        <Control x:Name="HoverPlate" Template="{DynamicResource InkPlateTemplate}" Background="{DynamicResource ButtonHoverBackgroundBrush}" Margin="-2,0"
                                 Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" />
                        <Control x:Name="PressedPlate" Template="{DynamicResource InkPlateTemplate}" Background="{DynamicResource ButtonPressedBackgroundBrush}" Margin="-2,0"
                                 Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" />
                        <Control x:Name="DefaultPlate" Template="{DynamicResource TornPlateTemplate}" Background="{TemplateBinding Background}" Margin="-10,-3"
                                 Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" />
                        <Control x:Name="DefaultHoverPlate" Template="{DynamicResource LocalBrushStrokeTemplate}" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Margin="-10,-3"
                                 Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="ContentShift" Y="0" />
                            </ContentPresenter.RenderTransform>
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="DefaultBloom" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DefaultBloom" Property="Opacity" Value="0.12" />
                            <Setter TargetName="DefaultPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DefaultHoverPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Plate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="DefaultHoverPlate" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="DefaultBloom" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.26" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="DefaultHoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="DefaultBloom" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.28" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.07" />
                                        <DoubleAnimation Storyboard.TargetName="ContentShift" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.07" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="ContentShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ButtonPressedForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Key prompt (Dishonored 2's `Esc Back` cap) for the game page's More / Edit: a rounded ink cap with a pale rim and
         a lit top edge; hover frosts the rim and lifts a pewter fill (0.12s in / 0.24s out), press darkens it. -->
    <Style x:Key="LocalKeycapButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalKeycapTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Focusable="False" />
                        <Control x:Name="HoverCap" Template="{DynamicResource LocalKeycapTemplate}" Background="{DynamicResource SecondaryButtonHoverBackgroundBrush}"
                                 BorderBrush="{DynamicResource FrameHoverBrush}" Opacity="0" Focusable="False" />
                        <Border x:Name="PressedCap" Background="{DynamicResource SecondaryButtonPressedBackgroundBrush}" CornerRadius="{DynamicResource CornerRadiusXLarge}"
                                Margin="1" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="KeyDip" Y="0" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverCap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverCap" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedCap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="KeyDip" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedCap" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="KeyDip" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
