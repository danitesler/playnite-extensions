<!--
    Whalebone: GroupBox as a Statistics sheet: an ink card inside a 1px inner line with filigree corners
    (FramedPlateTemplate), its header in pen script on a black ink smear. Content-sized, no fixed widths, the smear sizes
    to the header, so Statistics cards wrap cleanly. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{DynamicResource ExpanderBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Control Template="{DynamicResource FramedPlateTemplate}" Foreground="{DynamicResource FrameInnerBrush}" Focusable="False" />
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" MinHeight="34" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                <Grid HorizontalAlignment="Left" Margin="12,8,14,2">
                                    <Control Template="{DynamicResource LocalInkSmearTemplate}" Background="{DynamicResource HeadingMarkerAltBrush}"
                                             Margin="-10,0,-36,-2" Opacity="0.9" Focusable="False" />
                                    <ContentPresenter Margin="0,0,0,2" ContentSource="Header" VerticalAlignment="Center"
                                                      TextElement.FontFamily="{DynamicResource NoteFontFamily}"
                                                      TextElement.FontSize="18"
                                                      TextElement.Foreground="{DynamicResource HeadingForegroundBrush}" />
                                </Grid>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
