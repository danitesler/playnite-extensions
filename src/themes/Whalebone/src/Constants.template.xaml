<!--
    Whalebone: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared vocabulary (scripts/data/theme-keys.json); each placeholder names the wb token that plays
    the key's role. Theme XAML reads brushes only, never Color keys.
    Ink and slate surfaces; the chosen thing is bone paper lit by frost (selection, toggles, Play); teal marks what is
    new or active (filter mark, links); whale-oil amber is kept for the running game only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Zilla Slab body and italic labels, Cinzel flared caps for titles and buttons, Marck Script for
         captions, tooltips and the empty page. All three bundled in src/Typography (OFL). -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Zilla Slab, {{text:wb-font-body|Zilla Slab}}, Georgia</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Cinzel, {{text:wb-font-heading|Cinzel}}, Georgia</FontFamily>
    <FontFamily x:Key="UIFontFamily">./Typography/#Cinzel, {{text:wb-font-heading|Cinzel}}, Georgia</FontFamily>
    <FontFamily x:Key="NoteFontFamily">./Typography/#Marck Script, {{text:wb-font-script|Marck Script}}, Georgia</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:wb-font-mono|Consolas}}</FontFamily>

    <!-- Usable metadata content width; applied inside the pane's horizontal padding and border. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: torn brush plates carry the look, so control corners stay nearly square. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:wb-radius|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:wb-radius-sm|1}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:wb-radius-lg|3}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:wb-radius-xl|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{wb-chalk}}</Color>
    <Color x:Key="TextColorDarker">{{wb-ash}}</Color>
    <Color x:Key="TextColorDark">{{wb-ink-text}}</Color>
    <Color x:Key="MainColor">{{wb-ink}}</Color>
    <Color x:Key="MainColorDark">{{wb-slate-hi}}</Color>
    <Color x:Key="HoverColor">{{wb-pewter}}</Color>
    <Color x:Key="GlyphColor">{{wb-bone}}</Color>
    <Color x:Key="HighlightGlyphColor">{{wb-frost-blue}}</Color>
    <Color x:Key="PopupBackgroundColor">{{wb-ink}}</Color>
    <Color x:Key="PopupBorderColor">{{wb-rim-dim}}</Color>
    <Color x:Key="BackgroundToneColor">{{wb-slate-hi}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{wb-line}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{wb-line}}</Color>
    <Color x:Key="DataChangeNotifColor">{{wb-teal-hi}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{wb-line}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{wb-ink}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{wb-ink}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{wb-ink}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <!-- Running game: whale-oil amber (#e39a43), never used by Play (bone), selection (bone/frost), hover (pewter) or the filter mark (teal). -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{wb-oil}}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{wb-teal}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{wb-blood-hi}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{wb-frost-blue}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{wb-bone-shade}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{wb-ink}}" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{wb-slate}}" />
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{wb-pitch}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{wb-slate}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{wb-ink}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{wb-slate}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{wb-pitch}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{wb-slate}}" />
    <!-- Banner darkening: wb-slate, the cold slate of the overlays, the darkest branded surface (the game has no art tint of its own). -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{wb-slate}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{wb-ink}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{wb-bone}}" />

    <!-- Selection: bone paper, frost edge, ink text -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{wb-bone}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{wb-frost}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{wb-frost}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{wb-ink-text}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{wb-bone-shade}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{wb-pewter}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{wb-bone}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{wb-pewter}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{wb-frost}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{wb-frost-blue}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{wb-blood}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{wb-chalk}}" />

    <!-- Buttons: ink plates; Play and default = bone stroke -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{wb-chalk}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{wb-chalk}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{wb-bone}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{wb-rim}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{wb-pewter}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{wb-pewter-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{wb-bone}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{wb-frost}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{wb-frost}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{wb-bone-shade}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{wb-ink-text}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{wb-frost}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{wb-ink}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{wb-rim}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{wb-pewter}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{wb-pewter-hi}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{wb-bone}}" />

    <!-- Inputs: violet value plates -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{wb-violet}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{wb-violet-hi}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{wb-rim-dim}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{wb-bone-shade}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{wb-rim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{wb-frost-blue}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{wb-frost-blue}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{wb-ash}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{wb-bone}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{wb-frost}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{wb-frost}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{wb-violet}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{wb-bone}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{wb-pewter-hi}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{wb-bone-shade}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{wb-ink}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{wb-pewter-hi}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{wb-bone-shade}}" />

    <!-- Tabs, covers, top bar, sidebar -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{wb-ash}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{wb-chalk}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{wb-bone}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{wb-frost}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{wb-bone}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{wb-pewter}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{wb-bone}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{wb-ash}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{wb-ink-text}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{wb-bone}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{wb-violet}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{wb-chalk}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{wb-violet-hi}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{wb-line}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{wb-chalk}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{wb-rim-dim}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{wb-pitch}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{wb-chalk}}" />

    <!-- Frames, captions and decoration -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{wb-rim-dim}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{wb-line}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{wb-frost}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{wb-line}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{wb-pitch}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{wb-chalk}}" />
    <!-- The crimson ink smear behind the game title and dialog titles. -->
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{wb-wine}}" />
    <!-- The black ink smear behind script section captions. -->
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{wb-ink}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{wb-line}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{wb-bone-shade}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{wb-ash}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{wb-line}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{wb-frost-blue}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{wb-line}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{wb-violet}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{wb-violet-hi}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{wb-bone}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{wb-pitch}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{wb-teal}}" />
</ResourceDictionary>
