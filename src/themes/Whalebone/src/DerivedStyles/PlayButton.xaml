<!--
    Whalebone: PlayButton (the menu cursor as the hero) and RunningActionIndicator.
    Plate: the bone dry-brush stroke (TornPlateTemplate, bleeding 10px left/right and 3px top/bottom) inside a frost
    frame of two hairlines with hooked tips (Dishonored 2's chosen entry), ink Cinzel caps and the arrowhead play glyph.
    Hover (0.2s in / 0.36s out, CubicEase): a frost bloom fades in, a second wet stroke repaints the plate from the left
    (ScaleX 0 to 1), three glass shards slide out from the right end 50 ms apart. Press: the plate drops to bone-shade in
    90 ms, the shards snap back, the label dips 1px.
    Launching / Running: the plate fills whale-oil amber (RunningIndicatorBrush) under a pitch scrim (RunningBreath: 0.55
    launching, breathing 0.48 to 0.62 running) with a chalk label (5:1 or better); launching sweeps an amber band across
    the stroke (RunningScan, 1.15s over a 1.65s loop) while a foot line fills and three amber shards light in turn;
    running breathes on a 3.2s cycle. Cancel shows only on Running + button hover (RelativeSource Self).
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Over the Play / context action cell: copies the plate's stroke and frame in the running colour. -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Control x:Name="RunningWash" Template="{DynamicResource LocalBrushStrokeTemplate}" Background="{DynamicResource RunningIndicatorBrush}"
                                 Margin="-10,-3" Opacity="0.14" Focusable="False" IsTabStop="False" />
                        <Control x:Name="RunningScan" Template="{DynamicResource LocalBrushStrokeTemplate}" Visibility="Collapsed" Margin="-10,-3"
                                 Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.4" Focusable="False">
                            <Control.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                    <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                </LinearGradientBrush>
                            </Control.OpacityMask>
                        </Control>
                        <!-- RunningFrame: the plate's own frost frame (hairlines + hooks), redrawn in amber. -->
                        <Grid x:Name="RunningFrame" Margin="-10,-7">
                            <Rectangle Height="1" VerticalAlignment="Top" Margin="6,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                            <Rectangle Height="1" VerticalAlignment="Bottom" Margin="6,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                            <Rectangle Height="1" VerticalAlignment="Top" Margin="6,1,6,0" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.7" />
                            <Rectangle Height="1" VerticalAlignment="Bottom" Margin="6,0,6,1" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.7" />
                            <Control Template="{DynamicResource LocalHooksTemplate}" Foreground="{DynamicResource RunningIndicatorBrush}" Margin="-1,0" Focusable="False" />
                        </Grid>
                        <Grid Height="2" Margin="18,0,46,5" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource TextBrush}" Opacity="0.25" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource TextBrush}" Opacity="0.9" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <!-- The mark: three whale-oil glass shards in the reserved 34px right strip. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Polygon x:Name="RunningShard1" Points="3.5,0 7,12 0,12" Fill="{DynamicResource TextBrush}" />
                            <Polygon x:Name="RunningShard2" Points="3.5,0 7,12 0,12" Margin="2,0,0,0" Fill="{DynamicResource TextBrush}" />
                            <Polygon x:Name="RunningShard3" Points="3.5,0 7,12 0,12" Margin="2,0,0,0" Fill="{DynamicResource TextBrush}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningShard1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningShard2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.02" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningShard3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.02" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningShard1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningShard2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningShard3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="26,0,26,0" />
        <Setter Property="FontFamily" Value="{DynamicResource UIFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent">
                        <!-- Frost bloom behind the plate, hover only. -->
                        <Rectangle x:Name="Bloom" Margin="-40,-26" Opacity="0" IsHitTestVisible="False" Fill="{DynamicResource PrimaryButtonGlowBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Stretch="Fill" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <!-- The plate: the bone cursor stroke with faint veins. -->
                        <Control x:Name="PlayFill" Template="{DynamicResource TornPlateTemplate}" Background="{TemplateBinding Background}"
                                 Margin="-10,-3" Focusable="False" IsHitTestVisible="False" />
                        <Control x:Name="RunningBreath" Template="{DynamicResource LocalBrushStrokeTemplate}" Focusable="False" IsTabStop="False" Margin="-10,-3"
                                 IsHitTestVisible="False" Background="{DynamicResource ScrimBrush}" Opacity="0" />
                        <Control x:Name="RunningScan" Template="{DynamicResource LocalBrushStrokeTemplate}" Focusable="False" IsTabStop="False" Margin="-10,-3"
                                 IsHitTestVisible="False" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.75">
                            <Control.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                    <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                </LinearGradientBrush>
                            </Control.OpacityMask>
                        </Control>
                        <Control x:Name="RunningHoverDim" Template="{DynamicResource LocalBrushStrokeTemplate}" Focusable="False" IsTabStop="False" Margin="-10,-3"
                                 IsHitTestVisible="False" Background="{DynamicResource ScrimBrush}" Opacity="0" />
                        <!-- Hover: a wet frost stroke repaints the plate from the left. -->
                        <Control x:Name="HoverPlate" Template="{DynamicResource LocalBrushStrokeTemplate}" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                 Margin="-4,1" Opacity="0" IsHitTestVisible="False" Focusable="False" RenderTransformOrigin="0,0.5">
                            <Control.RenderTransform>
                                <ScaleTransform x:Name="HoverWipe" ScaleX="0" />
                            </Control.RenderTransform>
                        </Control>
                        <Control x:Name="PressedPlate" Template="{DynamicResource LocalBrushStrokeTemplate}" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                 Margin="-10,-3" Opacity="0" IsHitTestVisible="False" Focusable="False" />
                        <!-- The frost frame: two hairlines with hooked tips. -->
                        <Grid x:Name="Frame" Margin="-10,-7" IsHitTestVisible="False" Opacity="0.85">
                            <Rectangle Height="1" VerticalAlignment="Top" Margin="6,0" Fill="{DynamicResource PrimaryButtonBorderBrush}" />
                            <Rectangle Height="1" VerticalAlignment="Bottom" Margin="6,0" Fill="{DynamicResource PrimaryButtonBorderBrush}" />
                            <Control Template="{DynamicResource LocalHooksTemplate}" Foreground="{DynamicResource PrimaryButtonBorderBrush}" Margin="-1,0" Focusable="False" />
                        </Grid>
                        <!-- Glass shards leaving the right end on hover (a size-less Canvas: no layout). -->
                        <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0" IsHitTestVisible="False">
                            <Path x:Name="Shard1" Canvas.Left="-4" Canvas.Top="-20" Data="M0,12 L16,2 L9,20 Z" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0">
                                <Path.RenderTransform><TranslateTransform x:Name="Shard1Shift" X="-8" /></Path.RenderTransform>
                            </Path>
                            <Path x:Name="Shard2" Canvas.Left="14" Canvas.Top="4" Data="M0,4 L12,0 L4,11 Z" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0">
                                <Path.RenderTransform><TranslateTransform x:Name="Shard2Shift" X="-8" /></Path.RenderTransform>
                            </Path>
                            <Path x:Name="Shard3" Canvas.Left="4" Canvas.Top="24" Data="M0,0 L9,5 L-1,8 Z" Fill="{DynamicResource SelectedSheenBrush}" Opacity="0">
                                <Path.RenderTransform><TranslateTransform x:Name="Shard3Shift" X="-8" /></Path.RenderTransform>
                            </Path>
                        </Canvas>
                        <Border x:Name="PlayRoom" Margin="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="LabelShift" Y="0" />
                                </StackPanel.RenderTransform>
                                <Viewbox x:Name="PlayGlyph" Width="13" Height="13" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{DynamicResource IconPlay}" Fill="{TemplateBinding Foreground}" />
                                    </Canvas>
                                </Viewbox>
                                <ContentPresenter x:Name="PlayContent" VerticalAlignment="Center" RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Frame" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.55" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Frame" Property="Visibility" Value="Hidden" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.48" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.62" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.48" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- RunningMarkRoom left="0" right="34": reserved strip for the three shards inside RunningActionIndicator. -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,34,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,34,0" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" From="0" To="0.22" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverWipe" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Shard1" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Shard1Shift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Shard2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.05" To="0.85" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Shard2Shift" Storyboard.TargetProperty="X" BeginTime="0:0:0.05" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Shard3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.1" To="0.7" Duration="0:0:0.2" />
