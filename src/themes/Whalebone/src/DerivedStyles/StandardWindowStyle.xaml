<!--
    Whalebone: dialog windows (Settings, Add-ons, game editor). 44px pitch title band (CaptionHeight 44 = content
    offset): the Whalebone medallion with its ring of frost ticks, the title in pen script on a crimson ink smear
    (Dishonored 2's help-panel titles), 46x44 caption buttons, and the fracture rule along the band's foot.
    PART_TextTitle sits in a Collapsed parent so Playnite cannot draw bare text over the band; Settings AutomationId sets
    LOCSettingsLabel. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid ClipToBounds="True">
                                <Grid Height="44" VerticalAlignment="Top" ClipToBounds="True">
                                    <Border Background="{DynamicResource WindowTitleBackgroundBrush}" />
                                    <!-- Medallion badge: ink disc, rim, the mark in bone, a ring of frost ticks. -->
                                    <Grid Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
                                        <Path Stroke="{DynamicResource FocusHaloBrush}" StrokeThickness="1" Opacity="0.8"
                                              Data="M20,0.5 V3.5 M33.8,6.2 L31.6,8.4 M39.5,20 H36.5 M33.8,33.8 L31.6,31.6 M20,39.5 V36.5 M6.2,33.8 L8.4,31.6 M0.5,20 H3.5 M6.2,6.2 L8.4,8.4" />
                                        <Ellipse Width="28" Height="28" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1" />
                                        <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource MainMenuButtonForegroundBrush}" Width="18" Height="18" />
                                    </Grid>
                                    <Border Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="{TemplateBinding Title}" x:Name="PART_TextTitle" Width="0" Height="0" Opacity="0" Foreground="Transparent" />
                                    </Border>
                                    <!-- Script title on a crimson smear; the smear's negative margins never widen a small dialog. -->
                                    <Grid Margin="62,0,150,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Control Template="{DynamicResource LocalInkSmearTemplate}" Background="{DynamicResource HeadingMarkerBrush}"
                                                 Margin="-12,2,-44,-2" Focusable="False" />
                                        <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{DynamicResource NoteFontFamily}" FontSize="22"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                   Style="{DynamicResource BaseTextBlockStyle}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter Margin="0,44,0,0" />
                                <Control Template="{DynamicResource GlowLineTemplate}" Foreground="{DynamicResource NormalBorderBrush}" BorderBrush="{DynamicResource FrameHoverBrush}"
                                         Height="16" VerticalAlignment="Top" Margin="0,35,0,0" Focusable="False" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
