<!--
    Whalebone: SearchBox. A violet value plate with pointed ends and a pale rim (Video Settings value plates), the
    magnifier persistent outside PART_SeachIcon, the clear button inside a transparent hit Border. Focus turns the rim
    frost and lifts a soft frost bloom behind the plate. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Rectangle x:Name="Marks" Margin="-14,-10" Opacity="0" Fill="{DynamicResource FocusHaloBrush}" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Stretch="Fill" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Control x:Name="Field" Template="{DynamicResource LocalValuePlateTemplate}" Background="{DynamicResource InputBackgroundBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" Focusable="False" IsHitTestVisible="False" />
                        <Grid>
                            <ContentControl x:Name="Glyph" Focusable="False" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{DynamicResource GlyphBrush}" Margin="16,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" />
                            <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                            <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     Padding="40,0,32,0" VerticalContentAlignment="Center" />
                            <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                            Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,16,0" Cursor="Hand"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ContentControl.Template>
                                    <ControlTemplate TargetType="ContentControl">
                                        <Border Background="Transparent">
                                            <ContentPresenter ContentSource="Content" />
                                        </Border>
                                    </ControlTemplate>
                                </ContentControl.Template>
                            </ContentControl>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Marks" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Marks" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
