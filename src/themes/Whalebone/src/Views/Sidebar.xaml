<!--
    Whalebone: left rail, 44px pitch ink closed by a hairline. The main menu is a medallion (Dishonored 2's tab icons):
    a 32px ink disc with a rim holding the bone Whalebone mark; on hover a ring of frost ticks and a soft frost bloom
    fade in (the current tab medallion). Window art mode turns the rail background transparent.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="56" Margin="0,0,0,4"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Rectangle x:Name="SealBloom" Width="56" Height="44" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0"
                                                   Fill="{DynamicResource FocusHaloBrush}" IsHitTestVisible="False">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Stretch="Fill" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <Path x:Name="SealTicks" Width="40" Height="40" VerticalAlignment="Top" Margin="0,4,0,0" Opacity="0" IsHitTestVisible="False"
                                              Stroke="{DynamicResource FrameHoverBrush}" StrokeThickness="1" Stretch="None"
                                              Data="M20,0.5 V3.5 M33.8,6.2 L31.6,8.4 M39.5,20 H36.5 M33.8,33.8 L31.6,31.6 M20,39.5 V36.5 M6.2,33.8 L8.4,31.6 M0.5,20 H3.5 M6.2,6.2 L8.4,8.4" />
                                        <Ellipse x:Name="Seal" Width="32" Height="32" VerticalAlignment="Top" Margin="0,8,0,0" SnapsToDevicePixels="True"
                                                 Fill="{DynamicResource MainMenuButtonBackgroundBrush}" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1" />
                                        <Viewbox x:Name="MenuMarkBox" Width="20" Height="20" VerticalAlignment="Top" Margin="0,14,0,0" IsHitTestVisible="False">
                                            <Canvas Width="24" Height="24">
                                                <Path x:Name="MenuMark" Data="{DynamicResource IconMainMenu}" Fill="{DynamicResource MainMenuButtonForegroundBrush}" />
                                            </Canvas>
                                        </Viewbox>
                                        <Rectangle x:Name="SealOrnament" Width="22" Height="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                   Fill="{DynamicResource NormalBorderBrush}" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                            <Border x:Name="EdgeRule" Width="1" HorizontalAlignment="Right" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                    Background="Transparent" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="1,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Fill" Value="{DynamicResource SelectedHoverBrush}" TargetName="MenuMark" />
                            <Setter Property="Stroke" Value="{DynamicResource FrameHoverBrush}" TargetName="Seal" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SealBloom" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SealTicks" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SealBloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.36" />
                                        <DoubleAnimation Storyboard.TargetName="SealTicks" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.36" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                            <Setter Property="BorderThickness" Value="0,0,1,0" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SealOrnament" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Margin" Value="0,6,0,0" TargetName="Seal" />
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="SealBloom" />
                            <Setter Property="Margin" Value="0,2,0,0" TargetName="SealTicks" />
                            <Setter Property="Margin" Value="0,12,0,0" TargetName="MenuMarkBox" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SealOrnament" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Margin" Value="0,6,0,0" TargetName="Seal" />
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="SealBloom" />
                            <Setter Property="Margin" Value="0,2,0,0" TargetName="SealTicks" />
                            <Setter Property="Margin" Value="0,12,0,0" TargetName="MenuMarkBox" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
