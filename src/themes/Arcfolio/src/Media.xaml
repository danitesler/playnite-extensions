    <Geometry x:Key="IconWindowMaximize">M4.5,4.5 H19.5 V19.5 H4.5 Z M6.2,6.2 V17.8 H17.8 V6.2 Z</Geometry>
    <Geometry x:Key="IconWindowRestore">M7.5,4 H20 V16.5 H18.3 V5.7 H7.5 Z M4,7.5 H16.5 V20 H4 Z M5.7,9.2 V18.3 H14.8 V9.2 Z</Geometry>
    <Geometry x:Key="IconWindowClose">M5.2,3.8 L12,10.6 L18.8,3.8 L20.2,5.2 L13.4,12 L20.2,18.8 L18.8,20.2 L12,13.4 L5.2,20.2 L3.8,18.8 L10.6,12 L3.8,5.2 Z</Geometry>
    <!-- Sharp Metaphor triangle pointers (02_settings) -->
    <Geometry x:Key="IconDropDown">M5.5,8.5 L18.5,8.5 L12,16.2 Z</Geometry>
    <Geometry x:Key="IconSubmenu">M8.5,5.5 L16.5,12 L8.5,18.5 Z</Geometry>
    <!-- Crisp angular brush check mark -->
    <Geometry x:Key="IconCheck">M3.5,12.4 L5.1,10.8 L9.6,15.3 L18.9,5.4 L20.5,7 L9.6,18.6 Z</Geometry>
    <!-- Crisp editorial + / quill Edit / Remove / 3-Diamond Options -->
    <Geometry x:Key="IconAdd">M11,4 H13 V11 H20 V13 H13 V20 H11 V13 H4 V11 H11 Z</Geometry>
    <Geometry x:Key="IconEdit">M3.5,20.5 L4.8,14.8 L15.9,3.7 L20.3,8.1 L9.2,19.2 Z M6.4,15.6 L5.7,18.3 L8.4,17.6 L16.2,9.8 L14.2,7.8 Z M15.4,6.6 L17.4,8.6 L18.2,7.8 L16.2,5.8 Z</Geometry>
