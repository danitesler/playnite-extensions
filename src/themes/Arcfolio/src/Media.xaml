<!--
    Arcfolio: Media.xaml
    Bespoke Renaissance / architectural drafting Geometry icons (24x24 design grid,
    sharp architectural joints, compass diamond & quill-slash silhouettes) + 24 bare
    styled menu item PNG icons generated by scripts/render-menu-icons.mjs from art/menu-icons.json.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Uniformly scaling icon templates fitting smallest hosts cleanly -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox Width="14" Height="14" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileTemplate">
        <Viewbox Width="22" Height="22" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileSolidTemplate">
        <Viewbox Width="24" Height="24" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Bespoke Arcfolio UI Icons (24x24 filled architectural silhouettes) -->
    <!-- Drafting lens magnifier with diagonal quill handle -->
    <Geometry x:Key="IconSearch">M10.5,3 A7.5,7.5 0 1,0 10.5,18 A7.5,7.5 0 1,0 10.5,3 Z M10.5,5 A5.5,5.5 0 1,1 10.5,16 A5.5,5.5 0 1,1 10.5,5 Z M15.3,16.7 L16.7,15.3 L21.8,20.4 L20.4,21.8 Z</Geometry>
    <!-- Crisp architectural cross slash -->
    <Geometry x:Key="IconClear">M5.2,3.8 L12,10.6 L18.8,3.8 L20.2,5.2 L13.4,12 L20.2,18.8 L18.8,20.2 L12,13.4 L5.2,20.2 L3.8,18.8 L10.6,12 L3.8,5.2 Z</Geometry>
    <!-- Calibrated astrolabe slider bars with rotated diamonds -->
    <Geometry x:Key="IconViewSettings">M2,6.2 H6.6 V7.8 H2 Z M11.4,6.2 H22 V7.8 H11.4 Z M9,3.8 L12.2,7 L9,10.2 L5.8,7 Z M2,16.2 H12.6 V17.8 H2 Z M17.4,16.2 H22 V17.8 H17.4 Z M15,13.8 L18.2,17 L15,20.2 L11.8,17 Z</Geometry>
    <!-- Ribbon folio bookmark with diamond notch -->
    <Geometry x:Key="IconFilterPresets">M5,2.5 H19 V21.5 L12,17 L5,21.5 Z M7,4.5 V18.1 L12,14.8 L17,18.1 V4.5 Z M12,7.2 L14.4,9.6 L12,12 L9.6,9.6 Z</Geometry>
    <!-- Stacked manuscript index lines led by diamonds -->
    <Geometry x:Key="IconGroup">M5,4.2 L7.2,6.4 L5,8.6 L2.8,6.4 Z M9.5,5.5 H21 V7.3 H9.5 Z M5,10.2 L7.2,12.4 L5,14.6 L2.8,12.4 Z M9.5,11.5 H18.5 V13.3 H9.5 Z M5,16.2 L7.2,18.4 L5,20.6 L2.8,18.4 Z M9.5,17.5 H21 V19.3 H9.5 Z</Geometry>
    <!-- Ranked folio bars + vertical arrow -->
    <Geometry x:Key="IconSort">M3,5.2 H13.5 V7 H3 Z M3,11.1 H10.5 V12.9 H3 Z M3,17 H7.8 V18.8 H3 Z M16.6,4.5 H18.4 V16.4 L20.8,14 L22,15.2 L17.5,19.7 L13,15.2 L14.2,14 L16.6,16.4 Z</Geometry>
    <!-- Split editorial folio details view -->
