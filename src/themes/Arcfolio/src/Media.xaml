    <!-- Sharp dart Play arrow -->
    <Geometry x:Key="IconPlay">M5.5,3.5 L20.5,12 L5.5,20.5 L8.6,12 Z</Geometry>
    <!-- Diamond Info emblem -->
    <Geometry x:Key="IconInfo">M12,2.2 L21.8,12 L12,21.8 L2.2,12 Z M12,4.8 L4.8,12 L12,19.2 L19.2,12 Z M11,10.6 H13 V16.4 H11 Z M12,6.8 L13.3,8.1 L12,9.4 L10.7,8.1 Z</Geometry>
