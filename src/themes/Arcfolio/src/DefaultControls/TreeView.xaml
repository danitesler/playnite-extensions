<!--
    Arcfolio: DefaultControls/TreeView.xaml
    Settings & Add-ons section navigation (mirroring 02_settings.png & screenshot-settings.png):
    - Bare 28px rows in Georgia body font (no idle border/plate)
    - Opacity-animated hover wash (ListItemHoverBrush)
    - Selected row ignites Metaphor's Verdigris Cyan-Teal gouache brushstroke (LocalBrushBarTemplate)
      with a 2px bright cyan/chalk left edge bar, chalk baseline hairline, triangle pointer, and white label
    - WindowSettings (Width=252) & WindowExtensions (Width=280) reserve the vertical scroll lane (Visible)
      so expanding nodes never causes horizontal reflow; closed on the right by the distressed chalk spine.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LocalExpandCollapseToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LocalChalkDimBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="16" Height="16" Background="Transparent">
                        <ContentControl x:Name="ExpGlyph" Width="10" Height="10"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Content="{DynamicResource IconSubmenu}"
                                        ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ExpGlyph" Property="Content" Value="{DynamicResource IconDropDown}" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalTealBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ParchmentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LocalTreeViewSeparatorStyle" TargetType="Separator">
        <Setter Property="Tag" Value="TreeSeparator" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="8,2,10,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Grid VerticalAlignment="Center" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Width="5" Height="5" Stretch="Fill" Margin="0,0,6,0"
                              Data="M2.5,0 L5,2.5 L2.5,5 L0,2.5 Z"
                              Stroke="{DynamicResource LocalChalkDimBrush}" StrokeThickness="1" Fill="Transparent" />
                        <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Grid x:Name="Bd" MinHeight="28" Margin="0,1,4,0" Background="Transparent" SnapsToDevicePixels="True">
                            <!-- Hover soft teal wash (opacity animated, zero idle box) -->
                            <Border x:Name="HoverPlate" Background="{DynamicResource ListItemHoverBrush}"
                                    Opacity="0" IsHitTestVisible="False" />

                            <!-- Selected Verdigris Cyan-Teal gouache brushstroke + chalk baseline + 2px left bar -->
                            <Grid x:Name="SelectedPlate" Opacity="0" IsHitTestVisible="False">
                                <Control Margin="-2,-1,-2,-1" Template="{DynamicResource LocalBrushBarTemplate}"
                                         Background="{DynamicResource SelectedBrush}"
                                         Focusable="False" IsTabStop="False" />
                                <Control Height="2.5" Margin="14,0,10,2" VerticalAlignment="Bottom" Opacity="0.90"
                                         Template="{DynamicResource LocalHairlineHTemplate}"
                                         Foreground="{DynamicResource ParchmentBrush}"
                                         Focusable="False" IsTabStop="False" />
                            </Grid>

                            <Rectangle x:Name="SelectedBar" Width="2" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Fill="{DynamicResource ParchmentBrush}" Opacity="0" IsHitTestVisible="False" />

                            <!-- Row content: fixed 16px expander lane (Hidden on leaves for clean label alignment) + label -->
                            <Grid Margin="10,4,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Grid.Column="0" Width="16" Height="16"
                                              Style="{StaticResource LocalExpandCollapseToggleStyle}"
                                              IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press" />
                                <!-- Sharp Metaphor triangle pointer appearing on selected section -->
                                <Path x:Name="SelectedPointer" Grid.Column="1" Width="6" Height="8" Margin="0,0,5,0"
                                      VerticalAlignment="Center" Stretch="Fill" Opacity="0" IsHitTestVisible="False"
                                      Data="M0,0 L6,4 L0,8 Z" Fill="{DynamicResource ParchmentBrush}" />
                                <ContentPresenter x:Name="PART_Header" Grid.Column="2" ContentSource="Header"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="188"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Grid>

                        <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ParchmentBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="TreeHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"
                                                         To="0.62" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="TreeHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.20" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="HoverPlate" Property="Opacity" Value="0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeSelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedPointer" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeSelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedPointer" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Header.Tag, RelativeSource={RelativeSource Self}}" Value="TreeSeparator">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,8,6,8" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="TreeScroll" Focusable="False" Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      CanContentScroll="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                        <!-- Distressed chalk vertical spine closing Settings / Add-ons nav rail -->
                        <Control x:Name="DialogSpine" Width="6" HorizontalAlignment="Right" Margin="0,0,-2,0"
                                 Visibility="Collapsed" Opacity="0.82" IsHitTestVisible="False"
                                 Focusable="False" IsTabStop="False"
                                 Template="{DynamicResource LocalSpineVTemplate}"
                                 Foreground="{DynamicResource LocalChalkLineBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding (AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowSettings">
                            <Setter TargetName="DialogSpine" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding (AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowExtensions">
                            <Setter TargetName="DialogSpine" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="Separator" BasedOn="{StaticResource LocalTreeViewSeparatorStyle}" />
        </Style.Resources>
        <Style.Triggers>
            <DataTrigger Binding="{Binding (AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowSettings">
                <Setter Property="Width" Value="252" />
                <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
            <DataTrigger Binding="{Binding (AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowExtensions">
                <Setter Property="Width" Value="280" />
                <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
