<!--
    Arcfolio: DefaultControls/GroupBox.xaml
    Content-sized architectural editorial card (no child reports width >= 200px so Statistics view
    wraps sections cleanly side-by-side). Header led by a rotated cyan-teal drafting diamond.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Header band with rotated diamond + Cinzel caption + thin bottom rule -->
                            <Border Grid.Row="0" Padding="12,8,12,7"
                                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="7" Height="7" Stretch="Fill" Margin="0,0,8,0" VerticalAlignment="Center"
                                          Data="M3.5,0 L7,3.5 L3.5,7 L0,3.5 Z"
                                          Fill="{DynamicResource LocalTealBrightBrush}" IsHitTestVisible="False" />
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                      TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                      TextElement.FontSize="13" TextElement.FontWeight="Bold"
                                                      TextElement.Foreground="{DynamicResource HeadingForegroundBrush}" />
                                </StackPanel>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
