<!--
    Arcfolio: DefaultControls/ProgressBar.xaml
    Metaphor: ReFantazio 13_status PARAMETERS progress bar:
    MinHeight="8" and Height="{TemplateBinding Height}" so dialogs stay 8px while TopPanel PART_ProgressGlobal renders 12px.
    Dark recessed obsidian track with chalk-white-to-cyan-teal horizontal gauge fill.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid MinHeight="8" Height="{TemplateBinding Height}" SnapsToDevicePixels="True">
                        <Border x:Name="PaperSwatch" Background="{DynamicResource ParchmentBrush}" Visibility="Collapsed" />
                        <Border x:Name="FillSwatch" Background="{TemplateBinding Foreground}" Visibility="Collapsed" />
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="1">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{Binding Background.Color, ElementName=PaperSwatch}" Offset="0" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=FillSwatch}" Offset="0.82" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
