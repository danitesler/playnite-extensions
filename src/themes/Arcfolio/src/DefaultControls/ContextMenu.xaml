<!--
    Arcfolio: DefaultControls/ContextMenu.xaml
    Unified Metaphor: ReFantazio painted popup panel (LocalArcfolioMenuBoardTemplate), shared by
    ContextMenu, Menu submenus, TopPanelMenu, ComboBox popups, GameMenu, GameGroupMenu, and TrayContextMenu.
    Panel signature: deep obsidian-petrol board with calm impasto grain (canvas-wash.png),
    3px distressed chalk-white painted left spine (spine-line-v.png), 2px Carmine-to-Teal top ink seam,
    and subtle top-right architectural drafting compass arc watermark.
    UseLayoutRounding="True" keeps 16px bare menu PNG icons crisp at 125%/175% DPI scaling.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalArcfolioMenuBoardTemplate" TargetType="{x:Type Control}">
        <Border Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="{DynamicResource PopupBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid ClipToBounds="True">
                <Border x:Name="MenuCarmineSwatch" Background="{DynamicResource PrimaryButtonBackgroundBrush}" Visibility="Collapsed" />
                <Border x:Name="MenuTealSwatch" Background="{DynamicResource LocalTealBrightBrush}" Visibility="Collapsed" />

                <!-- Calm painterly impasto tooth -->
                <Rectangle Fill="{DynamicResource LocalTealBrightBrush}" Opacity="0.06"
                           OpacityMask="{DynamicResource LocalCanvasWashMask}" />

                <!-- Subtle architectural compass watermark in top-right corner (Canvas = zero desired width) -->
                <Canvas>
                    <Rectangle Canvas.Right="-26" Canvas.Top="-26" Width="136" Height="136" Opacity="0.14"
                               Fill="{DynamicResource LocalChalkLineBrush}"
                               OpacityMask="{DynamicResource LocalDraftingArcsMask}" />
                </Canvas>

                <!-- 2px Carmine-to-Teal top ink seam -->
                <Rectangle Height="2" VerticalAlignment="Top">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{Binding Background.Color, ElementName=MenuCarmineSwatch}" Offset="0" />
                            <GradientStop Color="{Binding Background.Color, ElementName=MenuTealSwatch}" Offset="0.58" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 3px distressed chalk-white painted left spine -->
                <Control Width="5" HorizontalAlignment="Left" Margin="1,2,0,2" Opacity="0.82"
                         Template="{DynamicResource LocalSpineVTemplate}"
                         Foreground="{DynamicResource LocalChalkLineBrush}"
                         Focusable="False" IsTabStop="False" />
            </Grid>
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="224" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Control Template="{DynamicResource LocalArcfolioMenuBoardTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ScrollViewer Margin="8,6,4,6" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
