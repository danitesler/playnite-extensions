<!--
    Arcfolio: DefaultControls/Menu.xaml
    Metaphor: ReFantazio unified menu rows & separators (docs/themes/menus.md):
    - Panel: LocalArcfolioMenuBoardTemplate (30px rows, obsidian-petrol impasto, 3px chalk left spine, 2px carmine-to-teal top seam)
    - Highlight: Verdigris Cyan-Teal gouache brushstroke (LocalBrushBarTemplate) sweeps in from -8px (120ms CubicEase)
      with crisp chalk baseline rule & stark chalk triangle pointer (▸); white serif label nudges 2px right
    - Group break: 10px break with 1px slate hairline split by a diagonal architectural slash (/) + rotated hollow diamond
    - Shortcuts: Georgia labels inside architectural square brackets [ F4 ] (07_load), brightening to chalk-ivory on highlight
    - Submenu mark: crisp chalk triangle pointer on right edge; held teal wash when IsSubmenuOpen="True"
    - Marked rows: Alt+Q Exit rests in Carmine text/[ Alt+Q ] and sweeps a Carmine Rose-Crimson gouache brushstroke with white ink (>=5.49:1);
      checked rows show a Stark Chalk-Ivory square plate with a pitch-ink diamond tick.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group break (10px height): diagonal slash + rotated hollow diamond opening a 1px hairline -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="6,0,6,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Diagonal quill slash -->
                        <Rectangle Grid.Column="0" Width="1.2" Height="8" Margin="4,0,4,0" VerticalAlignment="Center"
                                   Fill="{DynamicResource LocalChalkLineBrush}" Opacity="0.72" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="26" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <!-- Hollow rotated diamond -->
                        <Path Grid.Column="1" Width="5" Height="5" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Fill"
                              Data="M2.5,0 L5,2.5 L2.5,5 L0,2.5 Z"
                              Stroke="{DynamicResource LocalTealBrightBrush}" StrokeThickness="1" Fill="Transparent" />
                        <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                                   Fill="{DynamicResource MenuSeparatorBrush}" Opacity="0.75" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain menu row (30px height) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- Sweeping Verdigris Cyan-Teal gouache brushstroke highlight (Collapsed at rest) -->
            <Grid x:Name="HighlightBrush" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HighlightSlide" X="-8" />
                </Grid.RenderTransform>
                <Control Margin="-2,0,-2,0" Template="{DynamicResource LocalBrushBarTemplate}"
                         Background="{DynamicResource MenuItemHoverBrush}" Focusable="False" IsTabStop="False" />
                <Control Height="2" Margin="6,0,8,2" VerticalAlignment="Bottom" Opacity="0.90"
                         Template="{DynamicResource LocalHairlineHTemplate}"
                         Foreground="{DynamicResource ParchmentBrush}" Focusable="False" IsTabStop="False" />
            </Grid>

            <!-- Carmine Rose-Crimson gouache brushstroke for Alt+Q Exit highlight (Collapsed at rest) -->
            <Grid x:Name="DangerBrushPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="DangerSlide" X="-8" />
                </Grid.RenderTransform>
                <Control Margin="-2,0,-2,0" Template="{DynamicResource LocalBrushBarTemplate}"
                         Background="{DynamicResource DangerBrush}" Focusable="False" IsTabStop="False" />
                <Control Height="2" Margin="6,0,8,2" VerticalAlignment="Bottom" Opacity="0.92"
                         Template="{DynamicResource LocalHairlineHTemplate}"
                         Foreground="{DynamicResource ParchmentBrush}" Focusable="False" IsTabStop="False" />
            </Grid>

            <!-- Columns: pointer (8) | fixed 26px icon lane | plain * label | shared shortcut column -->
            <Grid Margin="4,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                </Grid.ColumnDefinitions>

                <!-- Sharp chalk triangle pointer (slides in on highlight) -->
                <Path x:Name="RowPointer" Grid.Column="0" Width="5" Height="7" VerticalAlignment="Center" HorizontalAlignment="Left"
                      Stretch="Fill" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                      Data="M0,0 L5,3.5 L0,7 Z" Fill="{DynamicResource ParchmentBrush}" />

                <!-- Fixed 16x16 icon slot (or checked Stark Chalk-Ivory square when IsCheckable/IsChecked) -->
                <Grid Grid.Column="1" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ContentPresenter x:Name="Icon" Width="16" Height="16" ContentSource="Icon"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                    <Border x:Name="CheckPlate" Visibility="Collapsed" Width="14" Height="14"
                            Background="{DynamicResource ParchmentBrush}"
                            BorderBrush="{DynamicResource ParchmentBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Width="8" Height="8" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M4,0 L8,4 L4,8 L0,4 Z" Fill="{DynamicResource ParchmentTextBrush}" />
                    </Border>
                </Grid>

                <!-- Label (plain * column so shortcuts always lock to the right edge) -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="2" ContentSource="Header"
                                  RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,0,10,0"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Architectural bracketed shortcut [ F4 ] (07_load) -->
                <StackPanel x:Name="ShortcutHost" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock x:Name="ShortcutOpen" Text="[" FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource LocalChalkDimBrush}" Margin="0,0,2,0" />
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextBrushDarker}" />
                    <TextBlock x:Name="ShortcutClose" Text="]" FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource LocalChalkDimBrush}" Margin="2,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckPlate" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- Exit (Alt+Q) marked in Carmine at rest -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                <Setter TargetName="ShortcutOpen" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutClose" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Trigger>
            <!-- Normal row highlight -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource ParchmentBrush}" />
                <Setter TargetName="ShortcutOpen" Property="Foreground" Value="{DynamicResource ParchmentBrush}" />
                <Setter TargetName="ShortcutClose" Property="Foreground" Value="{DynamicResource ParchmentBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard Name="MenuRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightBrush" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowPointer" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightBrush" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="HighlightSlide" Storyboard.TargetProperty="X" From="-8" To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RowPointer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Name="MenuRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="RowPointer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightBrush" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowPointer" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <!-- Exit (Alt+Q) highlighted: swaps to Carmine Rose-Crimson brushstroke with pure white text (>= 5.49:1) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutOpen" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutClose" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="HighlightBrush" Property="Visibility" Value="Collapsed" />
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="MenuExitIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerBrushPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerBrushPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="DangerSlide" Storyboard.TargetProperty="X" From="-8" To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="MenuExitOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="DangerBrushPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerBrushPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Submenu header row (30px height, right-edge chalk triangle + held open wash + shared board popup) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- Held open state plate (setter only, never flickers when moving into submenu) -->
            <Border x:Name="OpenPlate" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="{DynamicResource ListItemHoverBrush}"
                    BorderBrush="{DynamicResource LocalTealBrightBrush}" BorderThickness="2,0,0,0" />

            <!-- Sweeping cyan-teal brushstroke on highlight -->
            <Grid x:Name="HighlightBrush" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HighlightSlide" X="-8" />
                </Grid.RenderTransform>
                <Control Margin="-2,0,-2,0" Template="{DynamicResource LocalBrushBarTemplate}"
                         Background="{DynamicResource MenuItemHoverBrush}" Focusable="False" IsTabStop="False" />
                <Control Height="2" Margin="6,0,8,2" VerticalAlignment="Bottom" Opacity="0.90"
                         Template="{DynamicResource LocalHairlineHTemplate}"
                         Foreground="{DynamicResource ParchmentBrush}" Focusable="False" IsTabStop="False" />
            </Grid>

            <Grid Margin="4,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <Path x:Name="RowPointer" Grid.Column="0" Width="5" Height="7" VerticalAlignment="Center" HorizontalAlignment="Left"
                      Stretch="Fill" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                      Data="M0,0 L5,3.5 L0,7 Z" Fill="{DynamicResource ParchmentBrush}" />

                <ContentPresenter x:Name="Icon" Grid.Column="1" Width="16" Height="16" ContentSource="Icon"
                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                <ContentPresenter x:Name="HeaderHost" Grid.Column="2" ContentSource="Header"
                                  RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,0,10,0"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Sharp submenu triangle mark on right edge -->
                <Path x:Name="SubmenuMark" Grid.Column="3" Width="6" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Stretch="Fill" Data="M0,0 L6,4 L0,8 Z" Fill="{DynamicResource TextBrushDarker}" />
            </Grid>

            <Popup x:Name="Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-6"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Grid MinWidth="216" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Control Template="{DynamicResource LocalArcfolioMenuBoardTemplate}"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    <ScrollViewer Margin="8,6,4,6" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="SubmenuMark" Property="Fill" Value="{DynamicResource ParchmentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ParchmentBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource ParchmentBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="SubmenuMark" Property="Fill" Value="{DynamicResource ParchmentBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard Name="SubHdrIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightBrush" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowPointer" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightBrush" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="HighlightSlide" Storyboard.TargetProperty="X" From="-8" To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RowPointer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Name="SubHdrOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="RowPointer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightBrush" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowPointer" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
