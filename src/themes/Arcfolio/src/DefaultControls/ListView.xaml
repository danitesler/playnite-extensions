<!--
    Arcfolio: DefaultControls/ListView.xaml
    Implicit ListViewItem style only (list headers and scroll viewer remain Playnite's).
    Wears Arcfolio's Cyan-Teal brushstroke selection and Royal Quest Gold RunningIndicator
    with RowRoom (0,0,48,0), RunningMarkPlate, RunningScan, RunningFill, and 3 stepping Quest Rank diamonds.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ListViewItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource PanelSeparatorBrush}" Opacity="0.7" IsHitTestVisible="False" />

                        <Border x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource ListItemHoverBrush}" />

                        <Grid x:Name="SelectedPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Control Margin="-2,0,-2,0" Template="{DynamicResource LocalBrushBarTemplate}"
                                     Background="{DynamicResource ListItemSelectedBrush}" Focusable="False" IsTabStop="False" />
                            <Control Height="2" Margin="6,0,8,1" VerticalAlignment="Bottom" Opacity="0.88"
                                     Template="{DynamicResource LocalHairlineHTemplate}"
                                     Foreground="{DynamicResource ParchmentBrush}" Focusable="False" IsTabStop="False" />
                        </Grid>

                        <!-- Running / Launching Indicator (ABOVE selection & hover) -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.88" IsHitTestVisible="False">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.16" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.42">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.22">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid x:Name="RunningFrame">
                                <Border BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                                <Border Margin="2" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1" Opacity="0.72" />
                            </Grid>
                            <Border x:Name="RunningMarkPlate" Width="48" HorizontalAlignment="Right" Margin="0,2,2,2"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.35" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid Height="2" Margin="4,0,48,3" VerticalAlignment="Bottom">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.30" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalGoldBrightBrush}" Opacity="0.96"
                                           RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Path x:Name="LvDia1" Width="7" Height="7" Stretch="Fill" Data="M3.5,0 L7,3.5 L3.5,7 L0,3.5 Z"
                                      Fill="{DynamicResource LocalGoldBrightBrush}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="0.8" Opacity="0.45" />
                                <Path x:Name="LvDia2" Width="7" Height="7" Margin="3,0,0,0" Stretch="Fill" Data="M3.5,0 L7,3.5 L3.5,7 L0,3.5 Z"
                                      Fill="{DynamicResource LocalGoldBrightBrush}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="0.8" Opacity="0.45" />
                                <Path x:Name="LvDia3" Width="7" Height="7" Margin="3,0,0,0" Stretch="Fill" Data="M3.5,0 L7,3.5 L3.5,7 L0,3.5 Z"
                                      Fill="{DynamicResource LocalGoldBrightBrush}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="0.8" Opacity="0.45" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="RowRoom" Padding="0,0,0,0">
                            <GridViewRowPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverPlate" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectedPlate" Property="Opacity" Value="1" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,48,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:1.6">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LvDia1" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LvDia2" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0.35" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.98" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LvDia3" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.24" Value="0.35" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.12" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,48,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3.0">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LvDia1" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LvDia2" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LvDia3" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
