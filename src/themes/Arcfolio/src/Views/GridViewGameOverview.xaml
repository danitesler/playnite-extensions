                                            <Style TargetType="Grid">
                                                    <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                            <Setter Property="Height" Value="0" />
                                                        </DataTrigger>
                                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border x:Name="HeroCanvasSwatch" Background="{DynamicResource GameOverviewBackgroundBrush}" Visibility="Collapsed" />
                                        <Grid OpacityMask="{DynamicResource LocalBannerDissolveMask}">
                                            <Grid.CacheMode>
                                                <BitmapCache />
                                            </Grid.CacheMode>
                                            <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                            <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                            <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                            <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#14081113" Offset="0" />
                                                        <GradientStop Color="#7A102224" Offset="0.62" />
                                                        <GradientStop Color="{Binding Background.Color, ElementName=HeroCanvasSwatch}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                        <!-- Faint architectural astrolabe compass arcs floating in upper right -->
                                        <Canvas IsHitTestVisible="False">
                                            <Rectangle Canvas.Right="24" Canvas.Top="-36" Width="400" Height="400" Opacity="0.20"
                                                       Fill="{DynamicResource LocalChalkLineBrush}"
                                                       OpacityMask="{DynamicResource LocalDraftingArcsMask}" />
                                        </Canvas>
                                    </Grid>
                                    <StackPanel Panel.ZIndex="2" Margin="22,0,22,24">
