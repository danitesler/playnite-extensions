                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <ScrollViewer CanContentScroll="False" x:Name="PART_ScrollViewHost"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
