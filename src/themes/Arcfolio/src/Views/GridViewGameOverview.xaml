                                                        Template="{Binding Template, ElementName=SidePanelCloseButton}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="{Binding Tag, ElementName=SidePanelCloseButton, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Visible` : `Collapsed`'}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.RenderTransform>
                                                        <TranslateTransform Y="{Binding ContentVerticalOffset, ElementName=PART_ScrollViewHost}" />
                                                    </Button.RenderTransform>
                                                </Button>
                                                <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0"
                                                      Width="48" Height="48"
                                                      Visibility="{Binding Visibility, ElementName=PART_ImageIcon}">
                                                    <!-- Fine cardinal drafting crosshair ticks -->
                                                    <Rectangle Width="1" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Fill="{DynamicResource LocalChalkLineBrush}" Opacity="0.55" IsHitTestVisible="False" />
                                                    <Rectangle Height="1" Width="54" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Fill="{DynamicResource LocalChalkLineBrush}" Opacity="0.55" IsHitTestVisible="False" />
                                                    <Border Width="46" Height="46" CornerRadius="23"
                                                            Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                                            BorderBrush="{DynamicResource ParchmentBrush}" BorderThickness="1.5" Padding="4"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image x:Name="PART_ImageIcon" MaxWidth="34" MaxHeight="34" Stretch="Uniform" />
                                                    </Border>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}"
                                                               FontSize="24" FontWeight="Bold"
                                                               Foreground="{DynamicResource ParchmentBrush}" TextWrapping="Wrap" />
                                                    <Control Height="5" Margin="0,5,0,0" HorizontalAlignment="Stretch" MaxWidth="460"
                                                             Template="{DynamicResource LocalHairlineHTemplate}"
                                                             Foreground="{DynamicResource LocalChalkLineBrush}" Opacity="0.86"
                                                             Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                        <Control.Style>
                                                            <Style TargetType="Control">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Control.Style>
                                                    </Control>
                                                </StackPanel>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Grid MinWidth="176" Height="44">
                                                    <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                    <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                                    <Control Style="{DynamicResource RunningActionIndicator}" />
                                                </Grid>
                                                <Button x:Name="PART_ButtonMoreActions" Style="{DynamicResource SecondaryButton}"
                                                        Width="40" Height="40" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                                    <ContentControl Focusable="False" Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                                <Button x:Name="PART_ButtonEditGame" Style="{DynamicResource SecondaryButton}"
                                                        Width="40" Height="40" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource LOCEditGame}">
                                                    <ContentControl Focusable="False" Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Margin="0,20,0,0" x:Name="GridOverviewBody">

