<!--
    Arcfolio: Views/Sidebar.xaml
    44px compact obsidian-petrol rail closed on its inner edge by Metaphor's signature distressed
    chalk-white painted vertical spine (LocalSpineVTemplate), crowned by the animated Astrolabe-Brush
    main menu tile (LocalArcfolioMenuMarkTemplate) with a 2px Carmine foot line, and grounded at
    its foot by a hollow cyan-teal drafting diamond.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <!-- Subtle impasto tooth along rail -->
                            <Rectangle x:Name="RailWash" IsHitTestVisible="False" Opacity="0.06"
                                       Fill="{DynamicResource LocalTealBrightBrush}"
                                       OpacityMask="{DynamicResource LocalCanvasWashMask}" />

                            <DockPanel x:Name="DockContentHolder">
                                <!-- Main Menu Button (44x50) with animated Astrolabe-Brush mark -->
                                <Border x:Name="PART_ElemMainMenu" Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                        Width="44" Height="50" Margin="0,0,0,4"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Control x:Name="MenuMarkBox"
                                                 Template="{DynamicResource LocalArcfolioMenuMarkTemplate}"
                                                 Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                 Focusable="False" IsTabStop="False"
                                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                 Margin="0,0,3,2" />
                                        <Rectangle x:Name="MenuCarmineFoot" Height="2" Margin="6,0,9,0" VerticalAlignment="Bottom"
                                                   Fill="{DynamicResource PrimaryButtonBackgroundBrush}" IsHitTestVisible="False" />
                                        <Rectangle x:Name="MenuRule" Height="1" VerticalAlignment="Bottom"
                                                   Fill="{DynamicResource NormalBorderBrush}" Opacity="0.65" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>

                                <!-- Subtle Renaissance drafting diamond foot emblem (hidden on Top/Bottom rail) -->
                                <StackPanel x:Name="RailFootEmblem" DockPanel.Dock="Bottom" Margin="0,6,3,12"
                                            HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <Path Width="9" Height="9" Stretch="Fill" HorizontalAlignment="Center"
                                          Data="M4.5,0 L9,4.5 L4.5,9 L0,4.5 Z"
                                          Stroke="{DynamicResource LocalTealBrightBrush}" StrokeThickness="1.3" Fill="Transparent" />
                                </StackPanel>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>

                            <!-- Distressed chalk-white painted vertical spine closing the rail inner edge -->
                            <Control x:Name="ChalkSpineEdge" Width="6" HorizontalAlignment="Right" Margin="0,0,-2,0"
                                     IsHitTestVisible="False" Focusable="False" IsTabStop="False" Opacity="0.82"
                                     Template="{DynamicResource LocalSpineVTemplate}"
                                     Foreground="{DynamicResource LocalChalkLineBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Background" Value="Transparent" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailWash" />
                            <Setter Property="Opacity" Value="0.32" TargetName="ChalkSpineEdge" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="ChalkSpineEdge" />
                            <Setter Property="Margin" Value="-2,0,0,0" TargetName="ChalkSpineEdge" />
                            <Setter Property="Margin" Value="3,0,0,2" TargetName="MenuMarkBox" />
                            <Setter Property="Margin" Value="9,0,6,0" TargetName="MenuCarmineFoot" />
                            <Setter Property="Margin" Value="3,6,0,12" TargetName="RailFootEmblem" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,136,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ChalkSpineEdge" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootEmblem" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ChalkSpineEdge" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootEmblem" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
