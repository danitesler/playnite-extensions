<!--
    Arcfolio: Views/FilterPanelView.xaml
    Compact 28px obsidian-petrol filter panel with diamond-rule divider and 28x28 preset controls.
    Turns transparent when ShowBackgroundImageOnWindow is True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="FilterPanelCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="14,2,14,8" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="{StaticResource False}">
                <Setter Property="Opacity" Value="0.74" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Margin" Value="14,10,14,5" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource False}">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelFilterSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="14,0,14,0" />
        <Setter Property="ShowImage" Value="False" />
    </Style>

    <Style x:Key="FilterPanelFilterSelectionBox" TargetType="FilterSelectionBox" BasedOn="{StaticResource {x:Type FilterSelectionBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="14,0,14,0" />
    </Style>

    <Style x:Key="FilterPanelFilterEnumSelectionBox" TargetType="FilterEnumSelectionBox" BasedOn="{StaticResource {x:Type FilterEnumSelectionBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="14,0,14,0" />
    </Style>

    <Style x:Key="FilterPanelFilterStringSelectionBox" TargetType="FilterStringSelectionBox" BasedOn="{StaticResource {x:Type FilterStringSelectionBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="14,0,14,0" />
    </Style>

    <Style x:Key="FilterPresetButtonAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="3,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>

    <Style TargetType="{x:Type FilterPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPanel}">
                    <Border BorderBrush="{DynamicResource NormalBorderBrush}" d:DesignWidth="220">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings FilterPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <DockPanel Background="Transparent">
                                <DockPanel Margin="14,12,14,8" DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                                            Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                            Style="{StaticResource SimpleButton}"
                                            Name="PART_ButtonClose">
                                        <ContentPresenter Width="14" Height="14"
                                                          Content="{DynamicResource IconClear}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                    <Button DockPanel.Dock="Left" Content="{StaticResource LOCClearFilters}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Height="28" MinHeight="0" Padding="10,0"
                                            Style="{StaticResource SimpleButton}"
                                            Name="PART_ButtonClear" />
                                </DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="14,0,14,10">
                                    <Button Width="28" MinWidth="28" MaxWidth="28" Padding="0" Height="28" MinHeight="0" MaxHeight="28"
                                            x:Name="PART_ButtonDeleteFilter" Style="{DynamicResource FilterPresetButtonAction}">
                                        <ContentPresenter Width="14" Height="14"
                                                          Content="{DynamicResource IconRemove}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                    <Button Width="28" MinWidth="28" MaxWidth="28" Padding="0" Height="28" MinHeight="0" MaxHeight="28"
                                            x:Name="PART_ButtonRenameFilter" Style="{DynamicResource FilterPresetButtonAction}">
                                        <ContentPresenter Width="14" Height="14"
                                                          Content="{DynamicResource IconEdit}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                    <Button Width="28" MinWidth="28" MaxWidth="28" Padding="0" Height="28" MinHeight="0" MaxHeight="28"
                                            x:Name="PART_ButtonSaveFilter" Style="{DynamicResource FilterPresetButtonAction}">
                                        <ContentPresenter Width="14" Height="14"
                                                          Content="{DynamicResource IconFilterPresets}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                    <ComboBox Height="28" MinHeight="0" x:Name="PART_ComboFilterPresets"
                                              DockPanel.Dock="Left" VerticalAlignment="Center" />
                                </DockPanel>
                                <!-- Rotated diamond + hairline divider -->
                                <Grid DockPanel.Dock="Top" Margin="14,0,14,6" Height="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="6" Height="6" Stretch="Fill" VerticalAlignment="Center" Margin="0,0,7,0"
                                          Data="M3,0 L6,3 L3,6 L0,3 Z"
                                          Stroke="{DynamicResource LocalTealBrightBrush}" StrokeThickness="1" Fill="Transparent" />
                                    <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}" />
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                              DockPanel.Dock="Top" Padding="0,0,0,16">
                                    <StackPanel x:Name="PART_PanelItemsHost" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
