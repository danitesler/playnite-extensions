<!--
    Arcfolio: Common.xaml
    Shared spacing (ControlHeight=32), FocusVisual, shared procedural white-mask FX brushes
    (src/Images/fx/*.png), animated Astrolabe-Brush main menu mark (LocalArcfolioMenuMarkTemplate),
    painterly impasto canvas overlay, section headings, empty game page, and Steam Screenshots skeleton.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing & sizing (all form fields and buttons align to ControlHeight = 32) -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">4,6</Thickness>
    <Thickness x:Key="MenuItemPadding">10,0</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4,6</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,0</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12</Thickness>
    <Thickness x:Key="TooltipPadding">12,8</Thickness>

    <!-- Shared procedural FX white-mask brushes (generated by art/sprites.py, seed=1970) -->
    <ImageBrush x:Key="LocalBrushCtaMask" ImageSource="{ThemeFile 'Images/fx/brush-cta.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalBrushBarMask" ImageSource="{ThemeFile 'Images/fx/brush-bar.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalSpineVMask" ImageSource="{ThemeFile 'Images/fx/spine-line-v.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalHairlineHMask" ImageSource="{ThemeFile 'Images/fx/hairline-h.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalInkSplashMask" ImageSource="{ThemeFile 'Images/fx/ink-splash.png'}" Stretch="Uniform" />
    <ImageBrush x:Key="LocalDraftingArcsMask" ImageSource="{ThemeFile 'Images/fx/drafting-arcs.png'}" Stretch="Uniform" />
    <ImageBrush x:Key="LocalCanvasWashMask" ImageSource="{ThemeFile 'Images/fx/canvas-wash.png'}" TileMode="Tile" Viewport="0,0,512,512" ViewportUnits="Absolute" />
    <ImageBrush x:Key="LocalPaperTornMask" ImageSource="{ThemeFile 'Images/fx/paper-torn.png'}" TileMode="Tile" Viewport="0,0,256,14" ViewportUnits="Absolute" />
    <ImageBrush x:Key="LocalBannerDissolveMask" ImageSource="{ThemeFile 'Images/fx/banner-dissolve.png'}" Stretch="Fill" />

    <!-- Keyboard focus frame -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="1.5" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Reusable distressed chalk vertical spine & horizontal rule templates -->
    <ControlTemplate x:Key="LocalSpineVTemplate" TargetType="{x:Type Control}">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalSpineVMask}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalHairlineHTemplate" TargetType="{x:Type Control}">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalHairlineHMask}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Reusable gouache brushstroke plates -->
    <ControlTemplate x:Key="LocalBrushBarTemplate" TargetType="{x:Type Control}">
        <Rectangle Fill="{TemplateBinding Background}" OpacityMask="{DynamicResource LocalBrushBarMask}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalBrushCtaTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False">
            <!-- Solid opaque core lying strictly inside brush-cta.png's alpha=255 interior (x=12%..80%, y=21%..79%).
                 Completely invisible behind the full mask in Playnite; preserves solid pigment in headless tests where ThemeFile is null. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12*" />
                    <ColumnDefinition Width="68*" />
                    <ColumnDefinition Width="20*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="21*" />
                    <RowDefinition Height="58*" />
                    <RowDefinition Height="21*" />
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Background}" />
            </Grid>
            <Rectangle Fill="{TemplateBinding Background}" OpacityMask="{DynamicResource LocalBrushCtaMask}" />
        </Grid>
    </ControlTemplate>

    <!-- Calm painterly impasto + burgundy right-wash backdrop for Library & Dialog canvases (hidden under window art) -->
    <Style x:Key="LocalArcfolioBackdropOverlay" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid ClipToBounds="True" IsHitTestVisible="False">
                        <Border x:Name="SwatchTeal" Background="{DynamicResource LocalTealSubtleBrush}" Visibility="Collapsed" />
                        <Border x:Name="SwatchBurgundy" Background="{DynamicResource LocalBurgundyDeepBrush}" Visibility="Collapsed" />
                        <!-- Subtle verdigris-to-burgundy painted wash -->
                        <Rectangle Opacity="0.42">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.85">
                                    <GradientStop Color="{Binding Background.Color, ElementName=SwatchTeal}" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="0.52" />
                                    <GradientStop Color="{Binding Background.Color, ElementName=SwatchBurgundy}" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Diagonal gouache impasto tooth -->
                        <Rectangle Fill="{DynamicResource LocalTealBrightBrush}" Opacity="0.065"
                                   OpacityMask="{DynamicResource LocalCanvasWashMask}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Section heading style (Cinzel uppercase with diamond lead) -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>

    <!-- Static Arcfolio Brand Mark (used in Settings title band & empty game state) -->
    <ControlTemplate x:Key="LocalArcfolioBrandMarkTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="64" Height="64">
                <Path Data="M 16.5,11.2 A 25,25 0 0 1 54.8,21.8" Stroke="{DynamicResource ParchmentBrush}" StrokeThickness="2.8" />
                <Path Data="M 55.6,37.5 A 25,25 0 0 1 11.4,45.6" Stroke="{DynamicResource ParchmentBrush}" StrokeThickness="2.8" />
                <Path Data="M 8.2,35.8 A 25,25 0 0 1 11.8,17.5" Stroke="{DynamicResource LocalTealBrightBrush}" StrokeThickness="2.4" />
                <Ellipse Canvas.Left="16.5" Canvas.Top="16.5" Width="31" Height="31"
                         Stroke="{DynamicResource LocalTealBrightBrush}" StrokeThickness="2" />
                <Path Data="M 32,5 V 12 M 32,52 V 59 M 5,32 H 12 M 52,32 H 59" Stroke="{DynamicResource ParchmentBrush}" StrokeThickness="2.2" />
                <Path Data="M 15.5,55.5 L 44.5,9.5 L 48.2,11.8 L 19.2,57.8 Z" Fill="{DynamicResource ParchmentBrush}" />
                <Path Data="M 32,22 L 36,28 L 42,32 L 36,36 L 32,42 L 28,36 L 22,32 L 28,28 Z" Fill="{DynamicResource PrimaryButtonBackgroundBrush}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!--
        Arcfolio Animated Main Menu Mark (docs/themes/menu-mark.md):
        Shared by Sidebar.xaml and TopPanel.xaml on PART_ElemMainMenu.
        Motif: Broken astrolabe compass rings + diagonal quill slash + 4-point Renaissance diamond star.
        - Rest: calm chalk outer arcs, cyan-teal calibrated inner ring, diagonal slash, carmine diamond core.
        - Hover (IsMouseOver on Control): outer ring rotates +45 deg, diagonal slash extends slightly & brightens,
          hover rim diamond illuminates (animates OuterRingAngle, HoverSlashScale, HoverDiamondOpacity).
        - Open (ContextMenu.IsOpen on ancestor Border): inner calibrated ring turns -90 deg and gently breathes
          in scale/opacity while menu is open (animates OpenInnerAngle, OpenCoreScale, OpenCoreOpacity).
        Hover and Open target strictly disjoint elements so they compose smoothly without fighting.
    -->
    <ControlTemplate x:Key="LocalArcfolioMenuMarkTemplate" TargetType="{x:Type Control}">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Viewbox Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="64" Height="64">
                    <!-- Hover-animated outer broken astrolabe ring & cardinal ticks (CenterX/Y=32 in 64x64 canvas; no RenderTransformOrigin double-pivot) -->
                    <Canvas Width="64" Height="64">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="OuterRingAngle" Angle="0" CenterX="32" CenterY="32" />
                        </Canvas.RenderTransform>
                        <Path Data="M 16.5,11.2 A 25,25 0 0 1 54.8,21.8" Stroke="{DynamicResource ParchmentBrush}" StrokeThickness="2.8" />
                        <Path Data="M 55.6,37.5 A 25,25 0 0 1 11.4,45.6" Stroke="{DynamicResource ParchmentBrush}" StrokeThickness="2.8" />
                        <Path Data="M 8.2,35.8 A 25,25 0 0 1 11.8,17.5" Stroke="{DynamicResource LocalTealBrightBrush}" StrokeThickness="2.5" />
                        <Path Data="M 32,4.5 V 12.5 M 32,51.5 V 59.5 M 4.5,32 H 12.5 M 51.5,32 H 59.5"
                              Stroke="{DynamicResource ParchmentBrush}" StrokeThickness="2.3" />
                    </Canvas>

                    <!-- Open-animated inner calibrated ring + 4 diagonal menu ticks -->
                    <Canvas x:Name="OpenInnerGroup" Width="64" Height="64" Opacity="0.92">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="OpenInnerAngle" Angle="0" CenterX="32" CenterY="32" />
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="16.5" Canvas.Top="16.5" Width="31" Height="31"
                                 Stroke="{DynamicResource LocalTealBrightBrush}" StrokeThickness="2.2" />
                        <Path Data="M 19,19 L 23,23 M 45,19 L 41,23 M 19,45 L 23,41 M 45,45 L 41,41"
                              Stroke="{DynamicResource LocalTealGlowBrush}" StrokeThickness="2" />
                    </Canvas>

                    <!-- Hover-animated diagonal quill slash -->
                    <Path x:Name="HoverSlash" Data="M 15.5,55.5 L 44.5,9.5 L 48.2,11.8 L 19.2,57.8 Z"
                          Fill="{DynamicResource ParchmentBrush}">
                        <Path.RenderTransform>
                            <ScaleTransform x:Name="HoverSlashScale" ScaleX="1" ScaleY="1" CenterX="32" CenterY="32" />
                        </Path.RenderTransform>
                    </Path>

                    <!-- Center Carmine Renaissance diamond star (always legible) -->
                    <Path Data="M 32,21.5 L 36.2,27.8 L 42.5,32 L 36.2,36.2 L 32,42.5 L 27.8,36.2 L 21.5,32 L 27.8,27.8 Z"
                          Fill="{DynamicResource PrimaryButtonBackgroundBrush}" />

                    <!-- Hover flare highlight over diamond core -->
                    <Path x:Name="HoverCoreHighlight" Opacity="0"
                          Data="M 32,23.5 L 35.2,28.8 L 40.5,32 L 35.2,35.2 L 32,40.5 L 28.8,35.2 L 23.5,32 L 28.8,28.8 Z"
                          Fill="{DynamicResource PrimaryButtonGlowBrush}" />

                    <!-- Open-state pulsing ivory inner jewel (distinct element for Open state) -->
                    <Path x:Name="OpenJewel" Opacity="0"
                          Data="M 32,25.5 L 34.8,29.2 L 38.5,32 L 34.8,34.8 L 32,38.5 L 29.2,34.8 L 25.5,32 L 29.2,29.2 Z"
                          Fill="{DynamicResource ParchmentBrush}">
                        <Path.RenderTransform>
                            <ScaleTransform x:Name="OpenJewelScale" ScaleX="0.2" ScaleY="0.2" CenterX="32" CenterY="32" />
                        </Path.RenderTransform>
                    </Path>
                </Canvas>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuMarkHoverIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OuterRingAngle" Storyboard.TargetProperty="Angle"
                                             To="45" Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HoverSlashScale" Storyboard.TargetProperty="ScaleX"
                                             To="1.06" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="HoverSlashScale" Storyboard.TargetProperty="ScaleY"
                                             To="1.06" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="HoverCoreHighlight" Storyboard.TargetProperty="Opacity"
                                             To="0.95" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuMarkHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="OuterRingAngle" Storyboard.TargetProperty="Angle"
                                             To="0" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HoverSlashScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.20" />
                            <DoubleAnimation Storyboard.TargetName="HoverSlashScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.20" />
                            <DoubleAnimation Storyboard.TargetName="HoverCoreHighlight" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.20" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="MenuMarkOpenIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OpenInnerAngle" Storyboard.TargetProperty="Angle"
                                             To="-90" Duration="0:0:0.32">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="OpenJewelScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="OpenJewelScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OpenJewel" Storyboard.TargetProperty="Opacity"
                                                           Duration="0:0:2.6" RepeatBehavior="Forever">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.65" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OpenInnerGroup" Storyboard.TargetProperty="Opacity"
                                                           Duration="0:0:2.6" RepeatBehavior="Forever">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.72" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard x:Name="MenuMarkOpenOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="OpenInnerAngle" Storyboard.TargetProperty="Angle"
                                             To="0" Duration="0:0:0.24" />
                            <DoubleAnimation Storyboard.TargetName="OpenJewelScale" Storyboard.TargetProperty="ScaleX"
                                             To="0.2" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="OpenJewelScale" Storyboard.TargetProperty="ScaleY"
                                             To="0.2" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="OpenJewel" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="OpenInnerGroup" Storyboard.TargetProperty="Opacity"
                                             To="0.92" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Steam Screenshots loading skeleton (16:9 framed canvas + 4 thumbs with gentle opacity pulse) -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" Opacity="0.65" IsHitTestVisible="False">
            <Border Height="190" Background="{DynamicResource ExpanderBackgroundBrush}"
                    BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1">
                <Grid ClipToBounds="True">
                    <Rectangle Width="220" Height="220" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"
                               Fill="{DynamicResource LocalChalkLineBrush}" Opacity="0.12"
                               OpacityMask="{DynamicResource LocalDraftingArcsMask}" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                            Background="{DynamicResource NormalBrush}" Width="156" Height="16" Opacity="0.55" />
                </Grid>
            </Border>
            <UniformGrid Columns="4" Margin="0,6,0,0" Height="46">
                <Border Margin="0,0,6,0" Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" />
                <Border Margin="0,0,6,0" Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" />
                <Border Margin="0,0,6,0" Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" />
                <Border Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" />
            </UniformGrid>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="Visibility" Value="Visible">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="0.42" To="0.82" Duration="0:0:1.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Designed Empty Game State (LOCErrorNoGameSelected): 06_modal teal-to-rose ink splash + astrolabe compass -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="{x:Type Control}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <Grid Width="132" Height="132" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Border x:Name="EmptyTealSwatch" Background="{DynamicResource LocalTealBrightBrush}" Visibility="Collapsed" />
                    <Border x:Name="EmptyCarmineSwatch" Background="{DynamicResource PrimaryButtonBackgroundBrush}" Visibility="Collapsed" />
                    <!-- Teal-to-rose SYSTEM modal ink splash behind mark -->
                    <Rectangle x:Name="EmptySplash" Opacity="0.44" OpacityMask="{DynamicResource LocalInkSplashMask}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{Binding Background.Color, ElementName=EmptyTealSwatch}" Offset="0.15" />
                                <GradientStop Color="{Binding Background.Color, ElementName=EmptyCarmineSwatch}" Offset="0.88" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- Architectural compass arcs -->
                    <Rectangle x:Name="EmptyArcs" Fill="{DynamicResource LocalChalkLineBrush}" Opacity="0.28"
                               OpacityMask="{DynamicResource LocalDraftingArcsMask}" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform x:Name="EmptyArcRotate" Angle="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- Centered Arcfolio Brand Mark -->
                    <Control Width="54" Height="54" Template="{DynamicResource LocalArcfolioBrandMarkTemplate}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
                </Grid>

                <!-- Distressed chalk horizontal hairline -->
                <Control Height="5" Width="220" HorizontalAlignment="Center" Margin="0,0,0,12"
                         Template="{DynamicResource LocalHairlineHTemplate}"
                         Foreground="{DynamicResource LocalChalkLineBrush}" Opacity="0.82"
                         Focusable="False" IsTabStop="False" />

                <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                           FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                           Foreground="{DynamicResource TextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Visibility" Value="Visible">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyIdleBreath">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="EmptySplash" Storyboard.TargetProperty="Opacity"
                                             From="0.34" To="0.54" Duration="0:0:3.2" />
                            <DoubleAnimation Storyboard.TargetName="EmptyArcRotate" Storyboard.TargetProperty="Angle"
                                             From="-6" To="6" Duration="0:0:6.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyIdleBreath" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>
