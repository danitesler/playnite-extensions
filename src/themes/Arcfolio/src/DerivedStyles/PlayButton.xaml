<!--
    Arcfolio: DerivedStyles/PlayButton.xaml
    Hero Focal Piece (01_title LOAD GAME / 06_modal Yes / screenshot-details.png):
    - PlayButton: Expressive Carmine Rose-Crimson gouache brushstroke (LocalBrushCtaTemplate) sliced by
      a crisp chalk baseline (LocalHairlineHTemplate), chalk ▸ pointer (hidden on Tag="ContextAction"),
      and bold Cinzel uppercase text.
      Hover flares vivid Carmine + sweeps in the 24-deg diagonal chalk quill-slash (06_modal Yes).
      Pressed snaps into deep blood-carmine ink compression.
    - Running & Launching: solid Royal Quest Gold (RunningIndicatorBrush) brushstroke plate with Pitch Ink
      (LocalGoldInkBrush, >5.5:1 contrast at every frame) darkened gently by RunningBreath, swept by
      RunningScan while launching. Hovering while IsRunning (RelativeSource Self, never TemplatedParent)
      dims the gold plate via ScrimBrush (0.22) and swaps the label to Cancel (LOCCancelLabel, Pitch Ink)
      with PlayContent Hidden so the button never resizes. PlayRoom reserves 0,0,46,0 for the Quest Rank diamonds.
    - RunningActionIndicator: overlay laid over the Play/ContextAction cell with RunningFrame, faint
      RunningWash (0.12), golden RunningFill foot rule, and 3 stepping Quest Rank diamonds (◇ ◆ ◇).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="MinWidth" Value="176" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="24,0,26,0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Base Carmine (or Royal Quest Gold while running/launching) gouache brushstroke plate -->
                        <Control x:Name="PlayFill" Margin="-10,-5,-16,-5"
                                 Template="{DynamicResource LocalBrushCtaTemplate}"
                                 Background="{TemplateBinding Background}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />

                        <!-- Running/Launching breath scrim (in exact brushstroke shape, gentle alpha preserves >5.5:1 ink contrast on gold) -->
                        <Control x:Name="RunningBreath" Margin="-10,-5,-16,-5" Visibility="Collapsed" Opacity="0"
                                 Template="{DynamicResource LocalBrushCtaTemplate}"
                                 Background="{DynamicResource ScrimBrush}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />

                        <!-- Launching progress sweep across the brushstroke shape -->
                        <Control x:Name="RunningScan" Margin="-10,-5,-16,-5" Visibility="Collapsed" Opacity="0.65"
                                 Template="{DynamicResource LocalBrushCtaTemplate}"
                                 Background="{DynamicResource LocalGoldBrightBrush}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                            <Control.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.22">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                    <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                </LinearGradientBrush>
                            </Control.OpacityMask>
                        </Control>

                        <!-- Idle Hover flare layer wrapped in IdleHoverHost so Launching/Running instantly hides it even mid-exit-fade -->
                        <Grid x:Name="IdleHoverHost" IsHitTestVisible="False">
                            <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                <Control Margin="-12,-6,-18,-6" Template="{DynamicResource LocalBrushCtaTemplate}"
                                         Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                         Focusable="False" IsTabStop="False" />
                                <!-- Signature 24-deg diagonal chalk quill-slash on hover (06_modal Yes) -->
                                <Rectangle x:Name="HoverSlash" Width="2.5" Height="54" HorizontalAlignment="Left" Margin="14,0,0,0"
                                           Fill="{DynamicResource ParchmentBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform Angle="24" />
                                            <TranslateTransform x:Name="HoverSlashShift" X="-6" />
                                        </TransformGroup>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Grid>

                        <!-- Separate Pressed ink-stamp layer -->
                        <Control x:Name="PressedLayer" Margin="-8,-4,-14,-4" Visibility="Collapsed" Opacity="0"
                                 Template="{DynamicResource LocalBrushCtaTemplate}"
                                 Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />

                        <!-- Running + Self-Hover dim scrim (darker shade of Royal Quest Gold, strictly below CancelLabel) -->
                        <Control x:Name="RunningHoverDim" Margin="-10,-5,-16,-5" Visibility="Collapsed" Opacity="0"
                                 Template="{DynamicResource LocalBrushCtaTemplate}"
                                 Background="{DynamicResource ScrimBrush}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />

                        <!-- Crisp chalk horizontal baseline rule cutting beneath Play (01_title / 06_modal) -->
                        <Control x:Name="BaseChalkRule" Height="3" Margin="4,0,2,5" VerticalAlignment="Bottom"
                                 Template="{DynamicResource LocalHairlineHTemplate}"
                                 Foreground="{DynamicResource ParchmentBrush}" Opacity="0.88"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />

                        <!-- PlayContent wrapped in PlayRoom so right-edge Quest Rank diamonds never touch text -->
                        <Border x:Name="PlayRoom" Padding="0,0,0,0">
                            <StackPanel x:Name="PlayContent" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}">
                                <Path x:Name="PlayPointer" Width="7" Height="10" Margin="0,0,9,0" VerticalAlignment="Center"
                                      Stretch="Fill" Data="M0,0 L7,5 L0,10 Z"
                                      Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>

                        <!-- Cancel label shown ONLY while IsRunning AND this button itself is hovered -->
                        <TextBlock x:Name="CancelLabel" Visibility="Collapsed" Opacity="1"
                                   Text="{DynamicResource LOCCancelLabel}"
                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource LocalGoldInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hide Play-only pointer on ContextAction (Install / Launching / Running) -->
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayPointer" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Idle Hover (suppressed during launching/running) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverSlashShift" Storyboard.TargetProperty="X" From="-8" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <!-- Separate Pressed state -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedLayer" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressedLayer" Property="Opacity" Value="0.88" />
                        </Trigger>

                        <!-- RunningMarkRoom left="0" right="46" -->
                        <!-- Launching state: solid Royal Quest Gold plate + Pitch Ink label + sweeping scan -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalGoldInkBrush}" />
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BaseChalkRule" Property="Foreground" Value="{DynamicResource LocalGoldInkBrush}" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,46,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,46,0" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayLaunchingAnim">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:1.6">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity"
                                                         From="0.06" To="0.14" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayLaunchingAnim" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Running state: solid Royal Quest Gold plate + calm breathing scrim + Pitch Ink label -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalGoldInkBrush}" />
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BaseChalkRule" Property="Foreground" Value="{DynamicResource LocalGoldInkBrush}" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,46,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,46,0" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayRunningBreath">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3.0">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.06" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.18" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.06" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayRunningBreath" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Running + Self-Hover ONLY: Cancel over scrim-darkened Royal Quest Gold (PlayContent Hidden so size stays fixed) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningHoverDim" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="CancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" From="0" To="0.22" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Action Button (More / Edit): 40x40 dark architectural plate inverting to Stark Chalk-Ivory on hover -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ParchmentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <Border x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource SecondaryButtonHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource ParchmentBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Rectangle x:Name="FootLine" Height="2" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource LocalChalkLineBrush}" IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ParchmentTextBrush}" />
                            <Setter TargetName="FootLine" Property="Fill" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="SecIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="SecOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverPlate" Property="Background" Value="{DynamicResource SecondaryButtonPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RunningActionIndicator overlay placed over the game page Play/ContextAction cell -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.92" IsHitTestVisible="False">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5" Margin="-2,0,-2,0" />
                        <!-- Golden foot progress rule -->
                        <Grid Height="2" Margin="6,0,46,2" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource LocalGoldInkBrush}" Opacity="0.30" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalGoldInkBrush}" Opacity="0.92" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <!-- Three stepping Quest Rank diamonds (12_quest ◇ ◆ ◇) at right edge clear of label -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Path x:Name="ActDia1" Width="8" Height="8" Stretch="Fill"
                                  Data="M4,0 L8,4 L4,8 L0,4 Z"
                                  Fill="{DynamicResource LocalGoldInkBrush}" Stroke="{DynamicResource ParchmentBrush}" StrokeThickness="0.7" Opacity="0.45" />
                            <Path x:Name="ActDia2" Width="8" Height="8" Margin="3,0,0,0" Stretch="Fill"
                                  Data="M4,0 L8,4 L4,8 L0,4 Z"
                                  Fill="{DynamicResource LocalGoldInkBrush}" Stroke="{DynamicResource ParchmentBrush}" StrokeThickness="0.7" Opacity="0.45" />
                            <Path x:Name="ActDia3" Width="8" Height="8" Margin="3,0,0,0" Stretch="Fill"
                                  Data="M4,0 L8,4 L4,8 L0,4 Z"
                                  Fill="{DynamicResource LocalGoldInkBrush}" Stroke="{DynamicResource ParchmentBrush}" StrokeThickness="0.7" Opacity="0.45" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:1.6">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDia1" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDia2" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0.35" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.98" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDia3" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.24" Value="0.35" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.12" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3.0">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDia1" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDia2" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDia3" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
