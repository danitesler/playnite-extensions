<!--
    Arcfolio: DerivedStyles/StandardWindowStyle.xaml
    44px deep ink-obsidian title band echoing Metaphor's SYSTEM modal & SETTINGS header:
    - Teal-to-rose ink splatter (ink-splash.png) + diagonal chalk quill slash + right drafting compass arcs
    - Original Arcfolio Astrolabe-Brush brand mark + Cinzel Bold PART_TextTitle (WindowSettings sets LOCSettingsLabel)
    - Distressed chalk horizontal closing rule (LocalHairlineHTemplate)
    - CaptionHeight="44" matches ContentPresenter Margin="0,44,0,0"
    - WindowDesignStyle defined standalone (never BasedOn StandardWindowStyle to avoid Window vs WindowBase seal crash)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Calm painterly impasto canvas wash behind dialog body -->
                                <Control Margin="0,44,0,0" Style="{DynamicResource LocalArcfolioBackdropOverlay}" />

                                <!-- Dialog content offset exactly by CaptionHeight (44px) -->
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px Title Band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}"
                                      ClipToBounds="True">
                                    <!-- Collapsed color swatches for live ThemeModifier gradient stops -->
                                    <Border x:Name="TitleTealSwatch" Background="{DynamicResource LocalTealBrightBrush}" Visibility="Collapsed" />
                                    <Border x:Name="TitleCarmineSwatch" Background="{DynamicResource PrimaryButtonBackgroundBrush}" Visibility="Collapsed" />

                                    <!-- Signature vector/mask graphics inside a zero-desired-size Canvas so narrow dialogs size to content -->
                                    <Canvas IsHitTestVisible="False">
                                        <!-- Teal-to-rose SYSTEM modal ink splash (06_modal) -->
                                        <Rectangle Canvas.Left="-14" Canvas.Top="-34" Width="156" Height="116" Opacity="0.46"
                                                   OpacityMask="{DynamicResource LocalInkSplashMask}">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{Binding Background.Color, ElementName=TitleTealSwatch}" Offset="0.18" />
                                                    <GradientStop Color="{Binding Background.Color, ElementName=TitleCarmineSwatch}" Offset="0.88" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <!-- Architectural drafting compass arcs peeking from upper right -->
                                        <Rectangle Canvas.Left="240" Canvas.Top="-72" Width="220" Height="220" Opacity="0.18"
                                                   Fill="{DynamicResource LocalChalkLineBrush}"
                                                   OpacityMask="{DynamicResource LocalDraftingArcsMask}" />
                                    </Canvas>

                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0" IsHitTestVisible="False">
                                            <Control Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Template="{DynamicResource LocalArcfolioBrandMarkTemplate}"
                                                     Focusable="False" IsTabStop="False" />
                                            <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="17" FontWeight="Bold"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <!-- Diagonal chalk quill slash accent beside title -->
                                            <Rectangle Width="1.5" Height="28" Margin="14,0,0,0" VerticalAlignment="Center"
                                                       Fill="{DynamicResource LocalChalkLineBrush}" Opacity="0.55"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <Rectangle.RenderTransform>
                                                    <RotateTransform Angle="26" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Distressed chalk horizontal closing rule -->
                                    <Control Height="4" VerticalAlignment="Bottom" Margin="0,0,0,-1"
                                             Template="{DynamicResource LocalHairlineHTemplate}"
                                             Foreground="{DynamicResource LocalChalkLineBrush}" Opacity="0.80"
                                             IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standalone WindowDesignStyle (TargetType="Window" — must never use BasedOn StandardWindowStyle) -->
    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>

</ResourceDictionary>
