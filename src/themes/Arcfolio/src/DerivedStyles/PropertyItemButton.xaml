<!--
    Arcfolio: DerivedStyles/PropertyItemButton.xaml
    - Text links (Developers, Series, Links, Library): crisp Verdigris Cyan-Teal serif links brightening to chalk-ivory on hover.
    - Chips (Tag="Chip" on Platform, Genres, Categories, Features, Tags): Stark Chalk-Ivory paper slips (#F4F1EA)
      with bold Pitch Ink (#11181A) serif labels echoing 10_equipment Effect & 12_quest Search/Hunt badges;
      hover flips smoothly to Verdigris Cyan-Teal (#117E86) with crisp white text. Uses ControlCornerRadius (never CornerRadiusFull).
    - TextBlockGameScore: Stark Chalk-Ivory NO.01-style numeric plaques (07_load / 10_equipment) with
      emerald/gold/carmine rating foot tick.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Padding" Value="0,1" />
        <Setter Property="Margin" Value="0,0,8,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Content" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ParchmentBrush}" />
            </Trigger>
            <!-- Metadata chips (Tag="Chip" on owning ItemsControl): Stark Chalk-Ivory slips -->
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="Background" Value="{DynamicResource PropertyItemBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ParchmentEdgeBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="Margin" Value="0,0,5,5" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- NO.01-style score plaques with high-contrast rating fill -->
    <Style x:Key="TextBlockGameScore" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="7,2,7,2" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ParchmentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ParchmentTextBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Positive}">
                <Setter Property="Background" Value="{DynamicResource PositiveRatingBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ParchmentTextBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Mixed}">
                <Setter Property="Background" Value="{DynamicResource MixedRatingBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ParchmentTextBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Negative}">
                <Setter Property="Background" Value="{DynamicResource NegativeRatingBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
