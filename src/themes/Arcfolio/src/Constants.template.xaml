<!--
    Arcfolio: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Unofficial community theme inspired by Metaphor: ReFantazio's painted Renaissance manuscript,
    architectural drafting compass, chalk-ivory paper slip, and gouache brushstroke UI.

    Typography:
      - Body & lists: Georgia (Windows native; mapped to Gelasio OFL in previews)
      - Display headings & Play CTA: Cinzel Regular/Bold (OFL-1.1, bundled in src/Typography/)
      - Monospace: Consolas (Windows native; mapped to Cascadia Mono in previews)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">Georgia, Palatino Linotype, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Cinzel, Cinzel, Georgia</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width & position (ThemeModifier-editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape: razor-crisp architectural editorial plates contrasted with organic gouache brush masks -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:af-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:af-radius-none}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:af-radius-md}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:af-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:af-radius-full}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{af-text}}</Color>
    <Color x:Key="TextColorDarker">{{af-text-muted}}</Color>
    <Color x:Key="TextColorDark">{{af-text-on-accent}}</Color>
    <Color x:Key="MainColor">{{af-control}}</Color>
    <Color x:Key="MainColorDark">{{af-surface}}</Color>
    <Color x:Key="HoverColor">{{af-teal-subtle}}</Color>
    <Color x:Key="GlyphColor">{{af-teal}}</Color>
    <Color x:Key="HighlightGlyphColor">{{af-teal-bright}}</Color>
    <Color x:Key="PopupBackgroundColor">{{af-shell-rail}}</Color>
    <Color x:Key="PopupBorderColor">{{af-border-strong}}</Color>
    <Color x:Key="BackgroundToneColor">{{af-surface-deep}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{af-separator}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{af-border}}</Color>
    <Color x:Key="DataChangeNotifColor">{{af-emerald}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{af-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{af-control}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{af-well}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{af-emerald}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{af-carmine}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{af-gold}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{af-amber}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{af-surface-deep}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{af-canvas}}" />

    <!-- Shell surfaces -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{af-shell-rail}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{af-shell-top}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{af-canvas}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{af-well}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{af-surface-deep}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{af-ink-void}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{af-border}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{af-ink-void}}" />

    <!-- Game page -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{af-banner-tint}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{af-canvas}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{af-teal}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{af-teal-hover}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{af-teal-bright}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{af-text-on-accent}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{af-teal-subtle}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{af-teal}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{af-teal}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{af-gold}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{af-teal-bright}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{af-carmine}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{af-text-on-accent}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{af-text}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{af-text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{af-control-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{af-control-pressed}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{af-border-strong}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{af-carmine}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{af-carmine-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{af-carmine-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{af-carmine-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{af-text-on-accent}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{af-carmine-glow}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{af-surface-deep}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{af-border-strong}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{af-paper-edge}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{af-paper}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{af-well}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{af-surface-deep}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{af-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{af-border-strong}}" />
    <SolidColorBrush x:Key="InputUnderlineBrush" Color="{{af-chalk-dim}}" />
    <SolidColorBrush x:Key="InputHoverUnderlineBrush" Color="{{af-teal-bright}}" />

    <!-- Controls & Paper Slips -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{af-border-strong}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{af-well}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{af-teal-bright}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{af-teal-bright}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{af-teal-bright}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{af-well}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{af-teal-bright}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{af-border-strong}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{af-border-strong}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{af-teal-bright}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{af-text-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{af-carmine}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{af-shell-top}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{af-teal-bright}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{af-teal-subtle}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{af-text-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{af-paper-ink}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{af-paper-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{af-teal}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{af-border-strong}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{af-paper-ink}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{af-paper-edge}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{af-ink-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{af-border}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{af-ink-void}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{af-teal-bright}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{af-text-muted}}" />

    <!-- Stark Chalk-Ivory Paper Slips (02_settings, 03_inventory, 07_load, 10_equipment, 11_memorandum) -->
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{af-paper}}" />
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{af-paper-edge}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{af-paper-ink}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{af-paper-muted}}" />
    <SolidColorBrush x:Key="ParchmentLinkBrush" Color="{{af-paper-link}}" />

    <!-- Theme-only Arcfolio decorative brushes (Local* prefix per theme-keys.json) -->
    <SolidColorBrush x:Key="LocalChalkLineBrush" Color="{{af-chalk-line}}" />
    <SolidColorBrush x:Key="LocalChalkDimBrush" Color="{{af-chalk-dim}}" />
    <SolidColorBrush x:Key="LocalBurgundyWashBrush" Color="{{af-burgundy-wash}}" />
    <SolidColorBrush x:Key="LocalBurgundyDeepBrush" Color="{{af-burgundy-deep}}" />
    <SolidColorBrush x:Key="LocalTealBrightBrush" Color="{{af-teal-bright}}" />
    <SolidColorBrush x:Key="LocalTealGlowBrush" Color="{{af-teal-glow}}" />
    <SolidColorBrush x:Key="LocalTealWashBrush" Color="{{af-teal-wash}}" />
    <SolidColorBrush x:Key="LocalTealSubtleBrush" Color="{{af-teal-subtle}}" />
    <SolidColorBrush x:Key="LocalCarmineDimBrush" Color="{{af-carmine-dim}}" />
    <SolidColorBrush x:Key="LocalGoldBrightBrush" Color="{{af-gold-bright}}" />
    <SolidColorBrush x:Key="LocalGoldDeepBrush" Color="{{af-gold-deep}}" />
    <SolidColorBrush x:Key="LocalGoldInkBrush" Color="{{af-gold-ink}}" />
    <SolidColorBrush x:Key="LocalSubtleTextBrush" Color="{{af-text-subtle}}" />
</ResourceDictionary>
