<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Baylight 27 shared pieces, drawn from macOS 27 Dark (RESEARCH.md, BRIEF.md). No DropShadowEffect: soft shadows and the
        Siri halo are white-mask sprites (art/sprites.py) coloured through OpacityMask.
          LocalSilkRailTemplate    the desktop picture as the edge-to-edge rail sees it (right-hand folds, tall slice)
          LocalSilkDesktopTemplate the whole desktop picture (empty page)
          LocalGlassTemplate       a glass plate: Background fill, the bright-top rim, ControlCornerRadius
          LocalGlassCircleTemplate the same plate as a circle (fixed 1:1 hosts only)
          DividerTemplate          a 1px inset hairline (separator)
          BrandMarkTemplate        the Baylight 27 mark (squircle, sun, two swells), Foreground fill
          LocalBaylightMenuMarkTemplate  the animated main menu mark
          LocalEmptyDockTemplate   the empty game page: a small desktop with an idle Dock
        Hosts are plain Controls behind the content (IsHitTestVisible False).
    -->

    <!-- Desktop picture behind tinted glass. Masked images sit in a BitmapCache wrapper. -->
    <ControlTemplate x:Key="LocalSilkRailTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Grid.CacheMode><BitmapCache EnableClearType="False" SnapsToDevicePixels="True" /></Grid.CacheMode>
            <Rectangle Fill="{DynamicResource LocalSilkBaseBrush}" />
            <Rectangle Fill="{DynamicResource LocalSilkShadeBrush}" Opacity="0.8">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/silk-shade.png'}" Viewbox="0.5,0,0.5,1" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Top" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Fill="{DynamicResource LocalSilkLightBrush}" Opacity="0.75">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/silk-light.png'}" Viewbox="0.5,0,0.5,1" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Top" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalSilkDesktopTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Grid.CacheMode><BitmapCache EnableClearType="False" SnapsToDevicePixels="True" /></Grid.CacheMode>
            <Rectangle Fill="{DynamicResource LocalSilkBaseBrush}" />
            <Rectangle Fill="{DynamicResource LocalSilkShadeBrush}" Opacity="0.78">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/silk-shade.png'}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Fill="{DynamicResource LocalSilkLightBrush}" Opacity="0.8">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/silk-light.png'}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Liquid Glass plate: translucent fill (Background), a rim bright along the top and faint below. -->
    <ControlTemplate x:Key="LocalGlassTemplate" TargetType="Control">
        <Border IsHitTestVisible="False" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LocalGlassRimBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True" />
    </ControlTemplate>
    <ControlTemplate x:Key="LocalGlassCircleTemplate" TargetType="Control">
        <Border IsHitTestVisible="False" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LocalGlassRimBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusFull}" SnapsToDevicePixels="True" />
    </ControlTemplate>

    <!-- Group break where one is drawn as a line: a 1px separator hairline. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Border IsHitTestVisible="False" Height="1" Background="{DynamicResource WindowPanelSeparatorBrush}" SnapsToDevicePixels="True" />
    </ControlTemplate>

    <!-- The brand mark: a continuous-corner squircle holding a sun over two swells. Foreground fill. -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox IsHitTestVisible="False" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource LocalMarkGeometry}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Section headings: Title 3, SF Display's semibold, label colour. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>

    <!-- Keyboard focus: the macOS focus ring, the accent 3px wide just outside the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" IsHitTestVisible="False" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="3" CornerRadius="15" Opacity="0.6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing (macOS large controls scaled to Playnite's 14px body): 28px menu rows, 32px fields and buttons. -->
    <Thickness x:Key="ButtonPadding">16,5,16,5</Thickness> <!-- Push button: 32px with ControlHeight -->
    <Thickness x:Key="InputPadding">11,5,11,5</Thickness> <!-- Text field: 32px with ControlHeight -->
    <Thickness x:Key="MenuPadding">5</Thickness> <!-- Menu: 5px inset inside the 14px-radius panel -->
    <Thickness x:Key="MenuItemPadding">9,4,10,4</Thickness> <!-- Menu row: 28px, highlight inset 0 in the 5px panel inset -->
    <Thickness x:Key="ComboBoxDropDownPadding">5</Thickness> <!-- Popup button list inset -->
    <Thickness x:Key="ComboBoxItemPadding">9,4,10,4</Thickness> <!-- Popup button row, as a menu row -->
    <Thickness x:Key="ListBoxItemPadding">10,5,10,5</Thickness> <!-- Table row -->
    <Thickness x:Key="GroupBoxPadding">14,8,14,10</Thickness> <!-- Grouped section body -->
    <Thickness x:Key="GroupBoxHeaderMargin">2,0,0,6</Thickness> <!-- Section header over its card -->
    <Thickness x:Key="TooltipPadding">9,5,9,6</Thickness> <!-- Help tag -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double> <!-- Toolbar and sidebar glyphs -->
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner
         art, under the progressive blur and the window fade. Off while Playnite draws the art behind the window (the banner collapses). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the metadata content on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Both views start on the right. Center and Stretch flow above media. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the metadata content in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, so the real carousel replaces it without the page jumping. Rounded like the page's media; the
         tiles are the host's Foreground at low opacity and pulse while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="40" Background="{TemplateBinding Foreground}" Opacity="0.12" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="24" Background="{TemplateBinding Foreground}" Opacity="0.12" />
                    <Border Grid.Column="2" CornerRadius="24" Background="{TemplateBinding Foreground}" Opacity="0.12" />
                    <Border Grid.Column="4" CornerRadius="24" Background="{TemplateBinding Foreground}" Opacity="0.12" />
                    <Border Grid.Column="6" CornerRadius="24" Background="{TemplateBinding Foreground}" Opacity="0.12" />
                    <Border Grid.Column="8" CornerRadius="24" Background="{TemplateBinding Foreground}" Opacity="0.12" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.5" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- More / Edit: glass circles (the window toolbar's icon buttons). Hover lifts the glass (brighter fill, 1.05, spring);
         pressed it squashes (0.93) and fills brighter. Background = rest fill, Foreground = glyph. Fixed 1:1 hosts only. -->
    <Style x:Key="LocalGameActionSocket" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{DynamicResource LocalGlassBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Lift" />
                        </Grid.RenderTransform>
                        <Border x:Name="Plate" IsHitTestVisible="False" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LocalGlassRimBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusFull}" />
                        <Border x:Name="HoverFill" IsHitTestVisible="False" Opacity="0" Background="{DynamicResource LocalGlassBrush}" CornerRadius="{DynamicResource CornerRadiusFull}" />
                        <ContentPresenter x:Name="Content" IsHitTestVisible="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ActionHoverIn"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ActionHoverOut"><Storyboard>
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource LocalGlassPressedBrush}" />
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.93" ScaleY="0.93" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LocalGameActionEditSocket" TargetType="{x:Type Button}" BasedOn="{StaticResource LocalGameActionSocket}" />

    <!-- Empty game page: a small desktop (the Golden Gate picture behind tinted glass, 22px corners) with an idle Dock along
         its foot. The middle tile is the Baylight 27 mark; it bounces every few seconds like a launching app, and two tiles
         carry the running dot. 360x220. The bounce runs only while the host is visible and is removed on exit. -->
    <ControlTemplate x:Key="LocalEmptyDockTemplate" TargetType="{x:Type Control}">
        <Grid Width="360" Height="220" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border CornerRadius="{DynamicResource CornerRadiusXLarge}" ClipToBounds="True">
                <Border.OpacityMask>
                    <VisualBrush Stretch="None">
                        <VisualBrush.Visual>
                            <Border Width="360" Height="220" Background="Black" CornerRadius="{DynamicResource CornerRadiusXLarge}" />
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
                <Grid>
                    <Control Template="{DynamicResource LocalSilkDesktopTemplate}" Focusable="False" IsTabStop="False" />
                    <Rectangle Fill="{DynamicResource ShellBackgroundBrush}" Opacity="0.35" />
                </Grid>
            </Border>
            <Border CornerRadius="{DynamicResource CornerRadiusXLarge}" BorderBrush="{DynamicResource LocalGlassRimBrush}" BorderThickness="1" />
            <!-- The Dock: a glass shelf with five tiles. -->
            <Border Width="300" Height="70" VerticalAlignment="Bottom" Margin="0,0,0,14" CornerRadius="{DynamicResource CornerRadiusXLarge}"
                    Background="{DynamicResource LocalGlassHoverBrush}" BorderBrush="{DynamicResource LocalGlassRimBrush}" BorderThickness="1">
                <Canvas Width="298" Height="68">
                    <Border Canvas.Left="15" Canvas.Top="9" Width="46" Height="46" CornerRadius="11" Background="{DynamicResource LocalBlueBrush}">
                        <ContentControl Width="20" Height="20" Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource LocalWhiteBrush}" Focusable="False" IsTabStop="False" />
                    </Border>
                    <Ellipse Canvas.Left="36" Canvas.Top="59" Width="4" Height="4" Fill="{DynamicResource LocalLabelBrush}" />
                    <Border Canvas.Left="70" Canvas.Top="9" Width="46" Height="46" CornerRadius="11" Background="{DynamicResource LocalOrangeBrush}">
                        <ContentControl Width="20" Height="20" Content="{DynamicResource IconLibrary}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource LocalWhiteBrush}" Focusable="False" IsTabStop="False" />
                    </Border>
                    <Grid Canvas.Left="125" Canvas.Top="9" Width="46" Height="46" RenderTransformOrigin="0.5,1">
                        <Grid.RenderTransform><TranslateTransform x:Name="Hop" /></Grid.RenderTransform>
                        <Border CornerRadius="11" Background="{DynamicResource LocalWindowDeepBrush}" BorderBrush="{DynamicResource LocalGlassRimBrush}" BorderThickness="1" />
                        <Control Width="30" Height="30" Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource LocalYellowBrush}" Focusable="False" IsTabStop="False" />
                    </Grid>
                    <Ellipse Canvas.Left="146" Canvas.Top="59" Width="4" Height="4" Fill="{DynamicResource LocalLabelBrush}" />
                    <Border Canvas.Left="180" Canvas.Top="9" Width="46" Height="46" CornerRadius="11" Background="{DynamicResource LocalGreenDeepBrush}">
                        <ContentControl Width="20" Height="20" Content="{DynamicResource IconStatistics}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource LocalWhiteBrush}" Focusable="False" IsTabStop="False" />
                    </Border>
                    <Border Canvas.Left="235" Canvas.Top="9" Width="46" Height="46" CornerRadius="11" Background="{DynamicResource LocalIndigoBrush}">
                        <ContentControl Width="20" Height="20" Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource LocalWhiteBrush}" Focusable="False" IsTabStop="False" />
                    </Border>
                </Canvas>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="DockHop">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hop" Storyboard.TargetProperty="Y" Duration="0:0:3.4">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="-16"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="0"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.68" Value="-9"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.88" Value="0"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:3.4" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="DockHop" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): the Baylight 27 squircle with a sun behind two swells.
         Hover: sunrise. The sun (a full disc clipped at the waterline) climbs 1.6px and the swells ripple in opposite
         directions, then settle. Open (ContextMenu.IsOpen of the nearest Border): the sun climbs further on its own
         transform, turns gold (systemYellow) and a thin ring breathes around it until the menu closes. Hover animates
         HoverLift and the swells; open animates OpenLift, SunGold and Ring: never the same element. -->
    <ControlTemplate x:Key="LocalBaylightMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="False">
            <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="24" Height="24">
                    <!-- The breathing ring (open only), centred on the risen sun. -->
                    <Ellipse x:Name="Ring" Canvas.Left="5.6" Canvas.Top="4.4" Width="12.8" Height="12.8" Stroke="{DynamicResource LocalYellowBrush}" StrokeThickness="0.9"
                             Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="RingScale" ScaleX="0.85" ScaleY="0.85" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Path Data="{DynamicResource LocalMarkRingGeometry}" Fill="{TemplateBinding Foreground}" />
                    <!-- The sun: a full disc in a canvas clipped at the waterline, so climbing reveals more of it. -->
                    <Canvas Width="24" Height="24">
                        <Canvas.Clip><RectangleGeometry Rect="0,0,24,13.5" /></Canvas.Clip>
                        <Canvas Width="24" Height="24">
                            <Canvas.RenderTransform><TranslateTransform x:Name="OpenLift" /></Canvas.RenderTransform>
                            <Canvas Width="24" Height="24">
                                <Canvas.RenderTransform><TranslateTransform x:Name="HoverLift" /></Canvas.RenderTransform>
                                <Ellipse Canvas.Left="7.8" Canvas.Top="9.2" Width="8.4" Height="8.4" Fill="{TemplateBinding Foreground}" />
                                <Ellipse x:Name="SunGold" Canvas.Left="7.8" Canvas.Top="9.2" Width="8.4" Height="8.4" Fill="{DynamicResource LocalYellowBrush}" Opacity="0" />
                            </Canvas>
                        </Canvas>
                    </Canvas>
                    <Path Data="{DynamicResource LocalMarkSwell1Geometry}" Fill="{TemplateBinding Foreground}">
                        <Path.RenderTransform><TranslateTransform x:Name="Swell1" /></Path.RenderTransform>
                    </Path>
                    <Path Data="{DynamicResource LocalMarkSwell2Geometry}" Fill="{TemplateBinding Foreground}">
                        <Path.RenderTransform><TranslateTransform x:Name="Swell2" /></Path.RenderTransform>
                    </Path>
                </Canvas>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLift" Storyboard.TargetProperty="Y" To="-1.6" Duration="0:0:0.36"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Swell1" Storyboard.TargetProperty="X">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="1.1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-0.6"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.44" Value="0"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Swell2" Storyboard.TargetProperty="X" BeginTime="0:0:0.06">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="-1.1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0.6"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.44" Value="0"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Swell1" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Swell2" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OpenLift" Storyboard.TargetProperty="Y" To="-1.4" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SunGold" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" From="0.25" To="0.65" BeginTime="0:0:0.1" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" From="0.86" To="1.04" BeginTime="0:0:0.1" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
