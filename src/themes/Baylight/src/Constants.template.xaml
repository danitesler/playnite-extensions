<!--
    Baylight 27: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json); macOS 27's names stay in tokens.css and each
    placeholder names the token that plays the key's role (AGENTS.md, Tokens). Theme XAML reads brushes only.
    Glass fills are translucent white over whatever sits behind them (Liquid Glass); everything that carries a white
    label uses a deepened face (blue-deep, red-deep) so the label reads at 4.5:1.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: SF Pro's roles on Segoe UI Variable (Text for body, Display for titles), Segoe UI on Windows 10. -->
    <sys:Double x:Key="FontSizeSmall">{{px:size-caption}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:size-body}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:size-lead}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:size-title}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:size-display}}</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-text|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-display|Segoe UI}}</FontFamily>

    <!-- Usable metadata content width; applied inside each grouped section's padding. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape: 12px controls (near-capsule at 32px, macOS large controls), 6px tags and small plates, 14px menus and grouped
         sections, 22px large cards. Hairline borders. -->
    <Thickness x:Key="PopupBorderThickness">{{px:stroke-hair}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:stroke-hair}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:stroke-hair}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:corner-control}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:corner-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:corner-large}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:corner-xlarge}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{label}}</Color>
    <Color x:Key="TextColorDarker">{{label-secondary}}</Color>
    <Color x:Key="TextColorDark">{{white}}</Color>
    <Color x:Key="MainColor">{{control}}</Color>
    <Color x:Key="MainColorDark">{{section}}</Color>
    <Color x:Key="HoverColor">{{control-hover}}</Color>
    <Color x:Key="GlyphColor">{{blue}}</Color>
    <Color x:Key="HighlightGlyphColor">{{blue/35}}</Color>
    <Color x:Key="PopupBackgroundColor">{{menu}}</Color>
    <Color x:Key="PopupBorderColor">{{separator-strong}}</Color>
    <Color x:Key="BackgroundToneColor">{{section}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{window-deep}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{separator}}</Color>
    <Color x:Key="DataChangeNotifColor">{{red}}</Color>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <!-- Banner darkening color: the deepest shadow fold of the Golden Gate desktop picture, so a darker banner sinks into
         the wallpaper's own brown instead of grey. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{silk-umber-deep}}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{separator-strong}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{menu}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{control}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{control}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{section}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{window}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->
    <!-- Shell: the window is one surface; the rail is the desktop picture under ShellBackgroundBrush at 62% (the tint). -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{window-deep}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{window}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{window}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{window}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{glass}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{glass-hover}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{label}}" />
    <!-- Selection: the focused table / menu highlight (deepened systemBlue, white label 5:1). -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{blue-deep}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{blue-deep-lit}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{green}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{glass}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{blue-deep}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{blue-deep}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{red-deep}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{control-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{control-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{blue-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{blue-deep-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{blue-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{blue-deep}}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{glass}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{separator-strong}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{label-tertiary}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{separator-strong}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{label-tertiary}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{separator-strong}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{blue-lit}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{separator}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{label-tertiary}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{label-secondary}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{glass}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{label-tertiary}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{label-secondary}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{separator-strong}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{glass}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{glass-rim}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{glass-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{blue-wash}}" />
    <!-- Popups and text -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{separator-strong}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{window}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{label}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{glass-rim}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{glass-rim}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{control}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{glass-rim}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{label-secondary}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{separator-strong}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{label-tertiary}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{separator}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{label}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{separator}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{glass-rim}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{glass-rim-low}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{separator}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{glass-sheen}}" />
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{window}}" />
    <SolidColorBrush x:Key="TextOutlineBrush" Color="{{window-deep}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{separator}}" />

    <!-- Theme-only (Local prefix = no ThemeModifier entry): window steps, labels, glass, the system hues, the traffic lights,
         the Siri glow and the desktop picture. -->
    <SolidColorBrush x:Key="LocalWindowBrush" Color="{{window}}" />
    <SolidColorBrush x:Key="LocalWindowDeepBrush" Color="{{window-deep}}" />
    <SolidColorBrush x:Key="LocalSectionBrush" Color="{{section}}" />
    <SolidColorBrush x:Key="LocalSectionRaisedBrush" Color="{{section-raised}}" />
    <SolidColorBrush x:Key="LocalControlBrush" Color="{{control}}" />
    <SolidColorBrush x:Key="LocalControlHoverBrush" Color="{{control-hover}}" />
    <SolidColorBrush x:Key="LocalControlPressedBrush" Color="{{control-pressed}}" />
    <SolidColorBrush x:Key="LocalMenuBrush" Color="{{menu}}" />
    <SolidColorBrush x:Key="LocalSeparatorBrush" Color="{{separator}}" />
    <SolidColorBrush x:Key="LocalSeparatorStrongBrush" Color="{{separator-strong}}" />
    <SolidColorBrush x:Key="LocalLabelBrush" Color="{{label}}" />
    <SolidColorBrush x:Key="LocalLabelSecondaryBrush" Color="{{label-secondary}}" />
    <SolidColorBrush x:Key="LocalLabelTertiaryBrush" Color="{{label-tertiary}}" />
    <SolidColorBrush x:Key="LocalWhiteBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="LocalInkBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="LocalGlassBrush" Color="{{glass}}" />
    <SolidColorBrush x:Key="LocalGlassHoverBrush" Color="{{glass-hover}}" />
    <SolidColorBrush x:Key="LocalGlassPressedBrush" Color="{{glass-pressed}}" />
    <SolidColorBrush x:Key="LocalGlassTintBrush" Color="{{glass-tint}}" />
    <SolidColorBrush x:Key="LocalShadeBrush" Color="{{shade}}" />
    <!-- The glass rim: bright along the upper edge, faint along the lower one (refraction catching the light). -->
    <LinearGradientBrush x:Key="LocalGlassRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{glass-rim}}" Offset="0" />
        <GradientStop Color="{{glass-rim-low}}" Offset="0.45" />
        <GradientStop Color="{{glass-rim-low}}" Offset="1" />
    </LinearGradientBrush>
    <!-- The specular sheen across the upper half of a glass plate. -->
    <LinearGradientBrush x:Key="LocalGlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{glass-sheen}}" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.55" />
    </LinearGradientBrush>
    <!-- Play's plate: deepened blue, lifted at the top. -->
    <LinearGradientBrush x:Key="LocalPlayPlateBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{blue-deep-lit}}" Offset="0" />
        <GradientStop Color="{{blue-deep}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LocalBlueBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="LocalBlueLitBrush" Color="{{blue-lit}}" />
    <SolidColorBrush x:Key="LocalBlueWashBrush" Color="{{blue-wash}}" />
    <SolidColorBrush x:Key="LocalRedBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="LocalRedLitBrush" Color="{{red-lit}}" />
    <SolidColorBrush x:Key="LocalGreenBrush" Color="{{green}}" />
    <SolidColorBrush x:Key="LocalGreenDeepBrush" Color="{{green-deep}}" />
    <SolidColorBrush x:Key="LocalGreenWashBrush" Color="{{green/12}}" />
    <SolidColorBrush x:Key="LocalGreenHaloBrush" Color="{{green/22}}" />
    <SolidColorBrush x:Key="LocalOrangeBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="LocalYellowBrush" Color="{{yellow}}" />
    <SolidColorBrush x:Key="LocalPurpleBrush" Color="{{purple}}" />
    <SolidColorBrush x:Key="LocalPinkBrush" Color="{{pink}}" />
    <SolidColorBrush x:Key="LocalTealBrush" Color="{{teal}}" />
    <SolidColorBrush x:Key="LocalIndigoBrush" Color="{{indigo}}" />
    <SolidColorBrush x:Key="LocalGrayBrush" Color="{{gray}}" />
    <!-- Traffic lights. -->
    <SolidColorBrush x:Key="LocalLightCloseBrush" Color="{{tl-close}}" />
    <SolidColorBrush x:Key="LocalLightCloseRimBrush" Color="{{tl-close-rim}}" />
    <SolidColorBrush x:Key="LocalLightCloseInkBrush" Color="{{tl-close-ink}}" />
    <SolidColorBrush x:Key="LocalLightMinBrush" Color="{{tl-min}}" />
    <SolidColorBrush x:Key="LocalLightMinRimBrush" Color="{{tl-min-rim}}" />
    <SolidColorBrush x:Key="LocalLightMinInkBrush" Color="{{tl-min-ink}}" />
    <SolidColorBrush x:Key="LocalLightZoomBrush" Color="{{tl-zoom}}" />
    <SolidColorBrush x:Key="LocalLightZoomRimBrush" Color="{{tl-zoom-rim}}" />
    <SolidColorBrush x:Key="LocalLightZoomInkBrush" Color="{{tl-zoom-ink}}" />
    <SolidColorBrush x:Key="LocalLightIdleBrush" Color="{{tl-idle}}" />
    <!-- Siri glow: orange, pink, purple, blue, teal, around the rim of the Play plate (the RelativeTransform turns). -->
    <LinearGradientBrush x:Key="LocalSiriBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{{orange}}" Offset="0" />
        <GradientStop Color="{{pink}}" Offset="0.28" />
        <GradientStop Color="{{purple}}" Offset="0.5" />
        <GradientStop Color="{{blue}}" Offset="0.72" />
        <GradientStop Color="{{teal}}" Offset="1" />
    </LinearGradientBrush>
    <!-- The same five colours running the other way: crossfaded against LocalSiriBrush so the rim's colours flow. -->
    <LinearGradientBrush x:Key="LocalSiriFlowBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{{teal}}" Offset="0" />
        <GradientStop Color="{{blue}}" Offset="0.28" />
        <GradientStop Color="{{purple}}" Offset="0.5" />
        <GradientStop Color="{{pink}}" Offset="0.72" />
        <GradientStop Color="{{orange}}" Offset="1" />
    </LinearGradientBrush>
    <!-- The desktop picture: base gradient (bronze, umber, slate), lit ridges (gold to mist), shadow troughs (deep umber). -->
    <LinearGradientBrush x:Key="LocalSilkBaseBrush" StartPoint="0.3,0" EndPoint="0.7,1">
        <GradientStop Color="{{silk-bronze}}" Offset="0" />
        <GradientStop Color="{{silk-umber}}" Offset="0.48" />
        <GradientStop Color="{{silk-slate}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LocalSilkLightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{silk-gold}}" Offset="0" />
        <GradientStop Color="{{silk-mist}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LocalSilkShadeBrush" Color="{{silk-umber-deep}}" />
</ResourceDictionary>
