<!--
    Baylight 27: SearchBox, the Spotlight capsule of the macOS 27 toolbar. A glass field (InputBackgroundBrush, the bright-top
    glass rim, ControlCornerRadius) that brightens on hover; keyboard focus draws the accent focus ring just outside it.
    The magnifier lives outside PART_SeachIcon so it stays while typing: secondary label when empty, GlyphBrush when focused
    or filled. The clear button (xmark.circle.fill) keeps a transparent hit area around the glyph.
    Keeps PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid x:Name="Field" Background="Transparent">
                        <Border x:Name="Plate" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource LocalGlassRimBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                        <Border x:Name="HoverFill" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource LocalGlassBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="FocusRim" Opacity="0" Margin="-3" IsHitTestVisible="False" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="3"
                                CornerRadius="15" />
                        <ContentControl x:Name="Glyph" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" Focusable="False" IsTabStop="False"
                                        Width="15" Height="15" Foreground="{DynamicResource GlyphBrush}" Margin="11,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" />
                        <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                        <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                 Padding="34,0,30,0" VerticalContentAlignment="Center" />
                        <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,5,0" Cursor="Hand"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ContentControl.Template>
                                <ControlTemplate TargetType="ContentControl">
                                    <Border Background="Transparent" Padding="6,4">
                                        <ContentPresenter ContentSource="Content" />
                                    </Border>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverFill" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- Keep the magnifier visible while Playnite hides its placeholder: secondary label when empty, GlyphBrush when filled or
                             focused (SearchGlyphRegressionTests pins both colours to TextBrushDarker and GlyphBrush). -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRim" Property="Opacity" Value="0.6" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
