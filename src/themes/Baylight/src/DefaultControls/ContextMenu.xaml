<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu,
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is one macOS 27 menu. Levers (docs/themes/menus.md):
    - Panel: LocalMenuBoardTemplate, the dark vibrant menu (PopupBackgroundBrush) with 14px corners, a 1px outer edge in the
      window's shade and a 1px inner glass rim bright along the top (two stacked Borders, no DropShadowEffect), 5px inside.
      It fades in and settles 3px over 100ms from ControlTemplate triggers (here on IsOpen; the submenu, ComboBox and
      multi-select popups do the same on their own open flag).
    - Highlight: LocalMenuPillTemplate, the accent selection pill (MenuItemHoverBrush, 8px corners) filling the row inside
      the panel's 5px inset; it snaps in (60ms) and fades out, animated in Menu.xaml and ComboBox.xaml.
    - Icons: LocalMenuCheckTemplate (a bare checkmark in the icon column: checked rows, the chosen ComboBox item) and
      LocalMenuArrowTemplate (the submenu chevron at the right edge). Both take the row's Foreground, so they turn white on
      the highlight.
    Shared by Menu.xaml, ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml.
    Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The panel: shade edge, menu body, glass rim. Rows start 6px inside every edge (1px edge + 5px padding). -->
    <ControlTemplate x:Key="LocalMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource LocalShadeBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusLarge}" />
            <Border Margin="1" BorderBrush="{DynamicResource LocalGlassRimBrush}" BorderThickness="1" CornerRadius="13" />
        </Grid>
    </ControlTemplate>
    <!-- The highlight pill: Background = fill, 8px corners. -->
    <ControlTemplate x:Key="LocalMenuPillTemplate" TargetType="{x:Type Control}">
        <Border IsHitTestVisible="False" SnapsToDevicePixels="True" Background="{TemplateBinding Background}" CornerRadius="8" />
    </ControlTemplate>
    <!-- Checked row and chosen ComboBox item: a bare checkmark in the host's Foreground (the macOS menu check). -->
    <ControlTemplate x:Key="LocalMenuCheckTemplate" TargetType="{x:Type Control}">
        <ContentControl Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                        Foreground="{TemplateBinding Foreground}" Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconTemplate}" />
    </ControlTemplate>
    <!-- Submenu mark: the chevron.right glyph, 10px, in the host's Foreground. -->
    <ControlTemplate x:Key="LocalMenuArrowTemplate" TargetType="{x:Type Control}">
        <ContentControl Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                        Foreground="{TemplateBinding Foreground}" Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconTemplate}" />
    </ControlTemplate>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="232" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="MenuRise" />
                        </Grid.RenderTransform>
                        <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuRiseIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MenuPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="MenuRise" Storyboard.TargetProperty="Y" From="-3" To="0" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="MenuRiseIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
