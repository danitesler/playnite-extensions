<!--
    Baylight 27: ProgressBar, the macOS linear progress indicator. A thin track (ProgressBarTrackBrush, at most 6px tall and
    centred in taller hosts such as the 12px global bar) with the accent fill (ProgressBarForegroundBrush); corners are half
    the bar (3px). A host that sets a Transparent Background (the sidebar items' PART_ProgressStatus) gets a bare track.
    Indeterminate: a third-width accent segment sliding across, as on the Mac.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" MaxHeight="6" Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" MaxHeight="6" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        <Border x:Name="IndeterminateBar" MaxHeight="6" Visibility="Collapsed" Background="{TemplateBinding Foreground}" CornerRadius="3">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-0.33" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="0" />
                                    <GradientStop Color="Black" Offset="0.33" />
                                    <GradientStop Color="Transparent" Offset="0.33" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="IndeterminateBar" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateSlide">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateBar"
                                                         Storyboard.TargetProperty="(Border.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.33" To="1" Duration="0:0:1.6">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="IndeterminateSlide" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
