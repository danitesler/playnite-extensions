<!--
    Baylight 27: Button, the macOS 27 push button in Liquid Glass. A control-grey face (ButtonBackgroundBrush) with the glass
    rim (bright along the top) and a faint specular sheen over its upper half, label in the body font. Hover brightens the
    face; pressed squashes the glass (1.03 x 0.94, spring back on release) and darkens it. The default button (Save, OK) is
    accent filled with white text, as on the Mac. ControlCornerRadius (12) reads as a near-capsule at 32px.
    Keeps Default's Width == 41 trigger for ThemeModifier's icon buttons (32x32 by layout scaling).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" /> <!-- fixed-width buttons (ThemeModifier icon buttons) keep their glyph unclipped; auto-width ones get the padding below -->
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Squash" />
                        </Grid.RenderTransform>
                        <Border x:Name="Face" IsHitTestVisible="False" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="HoverFace" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource ButtonHoverBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Sheen" IsHitTestVisible="False" Background="{DynamicResource LocalGlassSheenBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.6" />
                        <Border x:Name="Rim" IsHitTestVisible="False" BorderBrush="{DynamicResource LocalGlassRimBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <ContentPresenter x:Name="Content" IsHitTestVisible="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ButtonHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverFace" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ButtonHoverOut">
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverFace" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverFace" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                            <Setter TargetName="HoverFace" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ButtonPressIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squash" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.09" />
                                        <DoubleAnimation Storyboard.TargetName="Squash" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ButtonPressOut">
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Squash" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.36">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Squash" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.36">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="HoverFace" Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HoverFace" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <!-- ThemeModifier icon buttons: the plugin sets Width=41 on them (editor and constants tabs).
                 Render at 32x32 via uniform 32/41 layout scaling, including glyphs and decoration; auto-width buttons keep ButtonPadding. -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Width" Value="NaN">
                <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
