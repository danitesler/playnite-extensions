                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="13" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Column="2" x:Name="PART_TextPlayTime" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                            </Grid>
                                                                        </Border>
<Border x:Name="PART_ElemLastPlayed" Padding="14,6" Background="{DynamicResource LocalSectionBrush}" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
