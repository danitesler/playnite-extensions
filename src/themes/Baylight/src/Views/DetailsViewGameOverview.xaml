                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid Height="34" Margin="0" IsHitTestVisible="False">
                                                                    <Border Height="12" VerticalAlignment="Top" CornerRadius="0,0,12,12" Background="{DynamicResource LocalSectionBrush}" />
                                                                    <Border Height="12" VerticalAlignment="Bottom" CornerRadius="12,12,0,0" Background="{DynamicResource LocalSectionBrush}" />
                                                                </Grid>
</Border>
<Border x:Name="PART_ElemCompletionStatus" Padding="14,6" Background="{DynamicResource LocalSectionBrush}" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger></Style.Triggers></Style></Border.Style>
