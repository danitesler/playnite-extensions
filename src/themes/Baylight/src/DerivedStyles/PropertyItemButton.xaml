<!--
    Baylight 27: PropertyItemButton. A value is a plain link in the accent (LinkBrush) that underlines on hover, as in a macOS
    inspector. In a chip list (the owning ItemsControl has Tag Chip) it is a Finder tag: a 24px capsule-ish chip
    (ControlCornerRadius, control-grey fill, glass rim) led by an 8px tag dot coloured like Finder's tag colours by the list it
    belongs to: platforms grey, genres orange, categories green, features purple, tags blue. Hover brightens the chip and turns
    the label white; press darkens it. Static setters only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Value" FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                               TextAlignment="Right"
                               TextWrapping="Wrap" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="TextDecorations" Value="Underline" TargetName="Value" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SliderHoverForegroundBrush}" />
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Plate" MinHeight="24" Background="Transparent" SnapsToDevicePixels="True">
                                <Border x:Name="ChipFace" IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource LocalControlBrush}"
                                        BorderBrush="{DynamicResource LocalGlassRimBrush}" BorderThickness="1" />
                                <StackPanel Orientation="Horizontal" Margin="8,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Ellipse x:Name="TagDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource LocalBlueBrush}" />
                                    <TextBlock x:Name="ChipText" FontSize="{TemplateBinding FontSize}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Name, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="PART_ItemsPlatforms">
                                    <Setter Property="Fill" Value="{DynamicResource LocalGrayBrush}" TargetName="TagDot" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Name, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="PART_ItemsGenres">
                                    <Setter Property="Fill" Value="{DynamicResource LocalOrangeBrush}" TargetName="TagDot" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Name, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="PART_ItemsCategories">
                                    <Setter Property="Fill" Value="{DynamicResource LocalGreenBrush}" TargetName="TagDot" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Name, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="PART_ItemsFeatures">
                                    <Setter Property="Fill" Value="{DynamicResource LocalPurpleBrush}" TargetName="TagDot" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource LocalControlHoverBrush}" TargetName="ChipFace" />
                                    <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" TargetName="ChipText" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource LocalControlPressedBrush}" TargetName="ChipFace" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
