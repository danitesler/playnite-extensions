<!--
    Overlay on Playnite Default/DerivedStyles/MainWindowStyle.xaml (the main window only).
    Playnite's template with the caption buttons drawn as macOS traffic lights on the right of the 52px toolbar
    (Views/TopPanel.xaml keeps 92px clear): 12px dots on a 20px pitch, Windows order (minimize yellow, zoom green, close
    red), a hairline rim in each dot's deeper shade. Hovering any of the three reveals all three glyphs at once (minus,
    zoom triangles / restore triangles, xmark) in the dots' dark inks; the dots turn grey while the window is inactive.
    MainMenuButton (only when the sidebar is hidden): the Baylight 27 mark on a glass plate that brightens on hover.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Playnite gives the buttons the Marlett codes 0 (minimize), 1 (maximize), 2 (restore) and r (close) as Content. -->
    <Style x:Key="MainWindowButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Light" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Fill="{DynamicResource LocalLightMinBrush}" Stroke="{DynamicResource LocalLightMinRimBrush}" StrokeThickness="0.5" SnapsToDevicePixels="False" />
                        <Ellipse x:Name="Press" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource LocalShadeBrush}"
                                 Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Glyph" Width="8" Height="8" Opacity="0" IsHitTestVisible="False"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource LocalLightMinInkBrush}"
                                          Content="{DynamicResource IconWindowMinimize}"
                                          ContentTemplate="{DynamicResource IconTemplate}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Fill" Value="{DynamicResource LocalLightZoomBrush}" TargetName="Light" />
                            <Setter Property="Stroke" Value="{DynamicResource LocalLightZoomRimBrush}" TargetName="Light" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource LocalLightZoomInkBrush}" TargetName="Glyph" />
                            <Setter Property="Content" Value="{DynamicResource IconWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Fill" Value="{DynamicResource LocalLightZoomBrush}" TargetName="Light" />
                            <Setter Property="Stroke" Value="{DynamicResource LocalLightZoomRimBrush}" TargetName="Light" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource LocalLightZoomInkBrush}" TargetName="Glyph" />
                            <Setter Property="Content" Value="{DynamicResource IconWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="r">
                            <Setter Property="Fill" Value="{DynamicResource LocalLightCloseBrush}" TargetName="Light" />
                            <Setter Property="Stroke" Value="{DynamicResource LocalLightCloseRimBrush}" TargetName="Light" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource LocalLightCloseInkBrush}" TargetName="Glyph" />
                            <Setter Property="Content" Value="{DynamicResource IconWindowClose}" TargetName="Glyph" />
                        </Trigger>
                        <!-- Inactive window: grey dots (hovering still shows the colour). -->
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter Property="Fill" Value="{DynamicResource LocalLightIdleBrush}" TargetName="Light" />
                            <Setter Property="Stroke" Value="{DynamicResource LocalLightIdleBrush}" TargetName="Light" />
                        </DataTrigger>
                        <!-- Hovering the cluster reveals every glyph together. -->
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="GlyphsIn"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                </Storyboard></BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard x:Name="GlyphsOut"><Storyboard>
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                </Storyboard></BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True" />
                                <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="r" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Fill" Value="{DynamicResource LocalLightCloseBrush}" TargetName="Light" />
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="Press" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MainWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="25" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <ContentPresenter Margin="0,0,0,0" />
                                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                        <TextBlock Text="{TemplateBinding Title}" DockPanel.Dock="Left" Margin="10,3,0,0" VerticalAlignment="Center"
                                                   Opacity="0.75" Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,6,14,0" Background="Transparent">
                                            <Button Style="{StaticResource MainWindowButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{StaticResource MainWindowButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{StaticResource MainWindowButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
<Style x:Key="MainMenuButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Plate" Width="34" Height="34" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0"
                                Background="{DynamicResource LocalGlassHoverBrush}" BorderBrush="{DynamicResource LocalGlassRimBrush}" BorderThickness="1" />
                        <Control x:Name="Mark" Template="{DynamicResource BrandMarkTemplate}" Width="24" Height="24" Foreground="{TemplateBinding Foreground}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="Plate" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource LocalGlassPressedBrush}" TargetName="Plate" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
<Style x:Key="TopPanelSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Height" Value="32" />
    </Style>
</ResourceDictionary>
