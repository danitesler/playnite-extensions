<!--
    Baylight 27: cover tiles as icons in the macOS Dock. Structure: Playnite Default 10.60 (GridViewItemStyle).
    Brushes: GridViewItemHoverBorderBrush (the glass edge on a magnified cover), GridViewItemSelectedBorderBrush (the focus ring),
    LocalWindowDeepBrush (the soft lift shadow, through the lift-shadow.png mask) and RunningIndicatorBrush (systemGreen).
    The cover has 10px corners (GridViewItemTemplate clips art, background and scrims to them); the corners stay clear.
    Hover, animated both ways and from ControlTemplate.Triggers only: Dock magnification. The cover grows to 1.07 and rises 4px on
    a spring (360ms, BackEase 0.3) while a soft shadow fades in under it and a 1px glass edge lights its rim.
    Selected, on its own layer: the macOS focus ring, the accent 3px wide with 2px of air around the cover, settling in from 4%
    larger (200ms). Everything moves inside the item; its own hit area (ItemGrid) never moves.
    Running game (docs/themes/reference.md), the Dock: RunningIndicator sits last in the cover, inset 4px so the focus ring keeps
    the outer edge. It holds a green band inside the edge, a 2px green frame, a 2px capsule foot line that fills as a progress bar,
    and a small dark glass tape at the foot carrying the Dock's app indicator (a green dot). Launching: a green band sweeps the
    cover (1.6s loop) while the foot fills and the dot bounces like a launching app. Running: the frame breathes 0.7 to 1 over
    3.2s and the dot rests and breathes. Hover and selection never touch it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <!-- ItemGrid never moves: its transparent background keeps the pointer over the item while the cover magnifies. -->
                    <Grid x:Name="ItemGrid" Margin="{Settings ItemSpacingMargin}" Background="Transparent">
                        <!-- The soft lift shadow under a magnified cover. -->
                        <Rectangle x:Name="LiftShadow" Opacity="0" Margin="-10,-2,-10,-14" IsHitTestVisible="False" Fill="{DynamicResource LocalWindowDeepBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/lift-shadow.png'}" Stretch="Fill" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <!-- Selected: the focus ring, 2px of air around the cover. -->
                        <Border x:Name="FocusRing" Visibility="Collapsed" Opacity="0" Margin="-5" IsHitTestVisible="False" CornerRadius="15" BorderThickness="3"
                                BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RingScale" />
                            </Border.RenderTransform>
                        </Border>
                        <Grid x:Name="Card" RenderTransformOrigin="0.5,0.75">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="Magnify" />
                                    <TranslateTransform x:Name="MagnifyLift" Y="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="Panel" CornerRadius="10" Background="{DynamicResource GridItemBackgroundBrush}">
                                <Grid>
                                    <ContentPresenter x:Name="CoverPresenter" />
                                    <!-- Hover: the glass edge, 1px. -->
                                    <Border x:Name="HoverFrame" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" BorderThickness="1" CornerRadius="10"
                                            BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                                    <!-- Selected: a hairline keyline inside the art so the ring reads against bright covers. -->
                                    <Border x:Name="SelectionBorder" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" BorderThickness="1" CornerRadius="10"
                                            BorderBrush="{DynamicResource LocalShadeBrush}" />
                                </Grid>
                            </Border>
                            <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                <Border x:Name="RunningWash" CornerRadius="6" BorderThickness="8" BorderBrush="{DynamicResource RunningIndicatorBrush}" Opacity="0.18" />
                                <Border x:Name="RunningScan" Visibility="Collapsed" CornerRadius="6" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.32">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Border x:Name="RunningFrame" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource RunningIndicatorBrush}" />
                                <Grid x:Name="RunningFoot" Height="2" Margin="12,0,12,6" VerticalAlignment="Bottom">
                                    <Border CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                    <Border x:Name="RunningFill" CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <!-- The tape: a small dark glass pill at the foot with the Dock's app indicator. -->
                                <Border Width="40" Height="22" Margin="0,0,0,12" HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="11"
                                        Background="{DynamicResource LocalGlassTintBrush}" BorderBrush="{DynamicResource LocalGlassRimBrush}" BorderThickness="1">
                                    <Grid x:Name="RunningDot" Width="12" Height="12" VerticalAlignment="Bottom" Margin="0,0,0,3" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="RunningDotHop" />
                                        </Grid.RenderTransform>
                                        <Ellipse Fill="{DynamicResource LocalGreenHaloBrush}" />
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource RunningIndicatorBrush}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Dock magnification, selected or not. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="HoverExit" />
                                <BeginStoryboard Name="HoverEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="LiftShadow" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="Magnify" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.36">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Magnify" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.36">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="MagnifyLift" Storyboard.TargetProperty="Y" To="-4" Duration="0:0:0.36">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="HoverExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="LiftShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="Magnify" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Magnify" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="MagnifyLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility" Duration="0:0:0.2">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="HoverEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Selected: the focus ring settles in. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="SelectExit" />
                                <BeginStoryboard Name="SelectEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" From="1.04" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" From="1.04" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="SelectExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Visibility" Duration="0:0:0.14">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Visibility" Duration="0:0:0.14">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="SelectEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="Panel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The Dock bounce: the dot hops twice (6px, then 3px) as the band crosses, then rests. -->
                                <BeginStoryboard Name="RunningDotLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDotHop" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="-6"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.44" Value="0"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.62" Value="-3"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                                <RemoveStoryboard BeginStoryboardName="RunningDotLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the launch has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The dot at rest breathes with the frame (3.2s). -->
                                <BeginStoryboard Name="RunningDotRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.6" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                                <RemoveStoryboard BeginStoryboardName="RunningDotRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
