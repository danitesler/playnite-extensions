<!--
    Baylight 27: StandardWindowStyle. Every dialog and the Settings window as a macOS 27 window: a 44px unified title band in the
    window colour (HeaderBandBrush) closed by a 1px separator. The traffic lights sit on the band's left in the Mac order
    (close, minimize, zoom: WindowBarButton.xaml), and the title is centred over the whole band: the Baylight 27 mark (16px)
    beside the window name in SF Display's semibold stand-in (HeadingFontFamily, 15px). CaptionHeight 44 equals the content's
    top margin. PART_TextTitle stays inside a collapsed parent: Playnite sets its Text and it must never draw by itself.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource HeaderBandBrush}" ClipToBounds="True">
                                    <!-- The band's closing rule: a 1px separator. -->
                                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource LocalSeparatorBrush}" IsHitTestVisible="False" />
                                    <!-- The title, centred over the whole band (behind the caption buttons, never hit-testable). -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="84,0,84,1" IsHitTestVisible="False">
                                        <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0"
                                                 VerticalAlignment="Center" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                        <Grid VerticalAlignment="Center">
                                            <!-- The title lives here only as Playnite's text holder (hidden in a collapsed parent); the visible copy reads its Text. -->
                                            <Border Visibility="Collapsed" Width="0" Height="0" Opacity="0">
                                                <TextBlock Text="{TemplateBinding Title}" Foreground="Transparent" x:Name="PART_TextTitle" />
                                            </Border>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" MaxWidth="420" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                        </Grid>
                                    </StackPanel>
                                    <!-- Traffic lights, Mac order, on the left. -->
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Margin="12,0,0,0" Background="Transparent">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                    </StackPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
