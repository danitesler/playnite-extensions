<!--
    Baylight 27: dialog caption buttons (StandardWindowStyle) as macOS traffic lights. Each is a 20x44 cell (the band's height,
    top-aligned) holding a 12px dot with a hairline rim in its deeper shade: close red, minimize yellow, zoom green, in the
    Mac order on the band's left. Hovering any of the three reveals all three glyphs (xmark, minus, zoom / restore triangles)
    in the dots' dark inks; pressed darkens the dot; an inactive window greys the dots. Playnite passes the Marlett codes
    0 / 1 / 2 / r as Content; triggers swap them for the theme's glyphs and colours.
    The main window's own caption buttons (MainWindowButton) are defined in MainWindowStyle.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WindowBarButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="False">
                        <Ellipse x:Name="Light" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Fill="{DynamicResource LocalLightMinBrush}" Stroke="{DynamicResource LocalLightMinRimBrush}" StrokeThickness="0.5" />
                        <Ellipse x:Name="Press" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource LocalShadeBrush}"
                                 Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Glyph" Width="8" Height="8" Opacity="0" IsHitTestVisible="False"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource LocalLightMinInkBrush}"
                                          Content="{DynamicResource IconWindowMinimize}"
                                          ContentTemplate="{DynamicResource IconTemplate}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Fill" Value="{DynamicResource LocalLightZoomBrush}" TargetName="Light" />
                            <Setter Property="Stroke" Value="{DynamicResource LocalLightZoomRimBrush}" TargetName="Light" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource LocalLightZoomInkBrush}" TargetName="Glyph" />
                            <Setter Property="Content" Value="{DynamicResource IconWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Fill" Value="{DynamicResource LocalLightZoomBrush}" TargetName="Light" />
                            <Setter Property="Stroke" Value="{DynamicResource LocalLightZoomRimBrush}" TargetName="Light" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource LocalLightZoomInkBrush}" TargetName="Glyph" />
                            <Setter Property="Content" Value="{DynamicResource IconWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="r">
                            <Setter Property="Fill" Value="{DynamicResource LocalLightCloseBrush}" TargetName="Light" />
                            <Setter Property="Stroke" Value="{DynamicResource LocalLightCloseRimBrush}" TargetName="Light" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource LocalLightCloseInkBrush}" TargetName="Glyph" />
                            <Setter Property="Content" Value="{DynamicResource IconWindowClose}" TargetName="Glyph" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter Property="Fill" Value="{DynamicResource LocalLightIdleBrush}" TargetName="Light" />
                            <Setter Property="Stroke" Value="{DynamicResource LocalLightIdleBrush}" TargetName="Light" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="GlyphsIn"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                </Storyboard></BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard x:Name="GlyphsOut"><Storyboard>
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                </Storyboard></BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="Press" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
