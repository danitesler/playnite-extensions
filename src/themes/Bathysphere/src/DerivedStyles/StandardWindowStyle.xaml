<!--
    Bathysphere: StandardWindowStyle (Settings, Add-ons, Game Editor, dialogs).
    44px abyssal Art Deco title band (CaptionHeight=44 matches ContentPresenter top margin 0,44,0,0):
    - Subtle Deco fan texture across the band + ghosted Rapture Art Deco skyscraper skyline watermark in a Canvas
      (zero desired width so compact dialogs stay content-sized).
    - Bathysphere Lighthouse-Porthole brand badge, tall Pathway Gothic One uppercase title (WindowSettings trigger sets
      LOCSettingsLabel; real PART_TextTitle sits safely inside a Visibility="Collapsed" parent so no stray text appears).
    - Stepped double brass closing rule & 46x44 WindowBarButton caption buttons.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" ClipToBounds="True">
                                    <Border Background="{DynamicResource WindowTitleBackgroundBrush}" />
                                    <Control Template="{DynamicResource LocalVellumGrainTemplate}"
                                             Foreground="{DynamicResource GlyphBrush}" Opacity="0.045"
                                             Focusable="False" IsHitTestVisible="False" />
                                    <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource DangerBrush}" Opacity="0.72" IsHitTestVisible="False" />

                                    <!-- Ghosted Columbia 1912 Exposition skyline (domed rotunda, arched pavilion, spires & dirigible) in a zero-size Canvas -->
                                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,460,40"
                                            Width="0" Height="0" IsHitTestVisible="False">
                                        <Path Fill="{DynamicResource GlyphBrush}" Opacity="0.10"
                                              Data="M0,40 L0,28 L16,28 L20,16 L24,28 L34,28 L34,40 Z M48,40 L48,26 C48,14 60,8 72,8 C84,8 96,14 96,26 L96,40 Z M70,2 L74,2 L73,9 L71,9 Z M112,40 L112,24 L118,24 L118,18 L124,18 L124,24 L132,24 L132,18 L138,18 L138,24 L144,24 L144,40 Z M162,40 L162,22 L174,10 L180,2 L186,10 L198,22 L198,40 Z M214,40 L214,27 C214,20 226,16 238,16 C250,16 262,20 262,27 L262,40 Z M208,11 C214,7 232,7 240,11 C232,15 214,15 208,11 Z M219,14 L229,14 L227,17 L221,17 Z" />
                                    </Canvas>

                                    <!-- Stepped double brass closing rule -->
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />
                                    <Rectangle Height="1" Margin="14,0,146,2" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" Opacity="0.48" IsHitTestVisible="False" />

                                    <!-- PART_TextTitle inside a Collapsed parent so Playnite never draws stray bare text over the band -->
                                    <Border Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="{TemplateBinding Title}" x:Name="PART_TextTitle" Width="0" Height="0" Opacity="0" Foreground="Transparent" />
                                    </Border>

                                    <DockPanel Margin="14,0,146,0" LastChildFill="False" IsHitTestVisible="False">
                                        <Control DockPanel.Dock="Left" Template="{DynamicResource BrandMarkTemplate}"
                                                 Foreground="{DynamicResource GlyphBrush}" Width="22" Height="22"
                                                 VerticalAlignment="Center" Focusable="False" />
                                        <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Text, ElementName=PART_TextTitle, Converter={StaticResource StringToUpperCaseConverter}}"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}" />
                                        <Path DockPanel.Dock="Left" Width="6" Height="6" Margin="10,1,0,0" Stretch="Fill" VerticalAlignment="Center"
                                              Data="M 3,0 L 6,3 L 3,6 L 0,3 Z" Fill="{DynamicResource GlyphBrush}" Opacity="0.72" />
                                    </DockPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
