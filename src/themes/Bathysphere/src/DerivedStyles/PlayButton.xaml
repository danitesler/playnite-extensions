<!--
    Bathysphere: Hero PlayButton and RunningActionIndicator.
    - PlayButton: BioShock 1 pointed-hexagonal 45-degree burnished imperial brass plaque (LocalHexPlateTemplate,
      PrimaryButtonBackgroundBrush #C99A36) with abyssal dark ink (#0A1214, 7.4:1), brushed-silver vertex dome rivets,
      and 9-slice brass bloom (GlowFrameTemplate). Hover (160ms) brightens to gleaming brass, flares bloom, and sweeps
      a diagonal Deco light glint across the hexagonal face; Press (80ms) settles to burnished bronze.
    - Tag="ContextAction" collapses PlayGlyph so LAUNCHING / RUNNING / INSTALL wear the exact same hexagonal plate.
    - LAUNCHING / RUNNING: switches to EVE / Salts Electric Cobalt (RunningIndicatorBrush #1A69CC) with crisp ivory-white
      ink (LocalEveForegroundBrush #F7FAFF), darkened by RunningBreath (ScrimBrush) for >= 7:1 worst-frame contrast.
      Launching sweeps an angled EVE surge band + 12-segment Salts foot meter (LocalSaltsSegmentMaskBrush) + 3 rising
      EVE bubbles; Running breathes calmly (3.2s) and reveals Cancel ONLY on Self IsMouseOver (never TemplatedParent).
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.92" IsHitTestVisible="False" SnapsToDevicePixels="False">
                        <Control x:Name="RunningWash" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="{DynamicResource RunningIndicatorBrush}" BorderBrush="Transparent" Foreground="Transparent"
                                 Opacity="0.14" Focusable="False" />
                        <Control x:Name="RunningFrame" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="Transparent" BorderBrush="{DynamicResource RunningIndicatorBrush}" Foreground="{DynamicResource LocalEveLitBrush}"
                                 Focusable="False" />

                        <!-- BioShock Infinite 12-segment Salts foot meter -->
                        <Grid Height="3" Margin="18,0,18,4" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.34" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalEveLitBrush}" RenderTransformOrigin="0,0.5"
                                       OpacityMask="{DynamicResource LocalSaltsSegmentMaskBrush}">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <!-- 3 staggered rising EVE vial bubbles inside reserved right strip -->
                        <Grid Width="20" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                            <Ellipse x:Name="RunningMote1" Width="4.5" Height="4.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                     Fill="{DynamicResource LocalEveLitBrush}" Stroke="{DynamicResource LocalEveForegroundBrush}" StrokeThickness="0.6" Opacity="0.45">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Mote1Y" Y="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="RunningMote2" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{DynamicResource LocalEveLitBrush}" Stroke="{DynamicResource LocalEveForegroundBrush}" StrokeThickness="0.7" Opacity="0.6">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Mote2Y" Y="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="RunningMote3" Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,7"
                                     Fill="{DynamicResource LocalEveForegroundBrush}" Opacity="0.45">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Mote3Y" Y="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.98" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="0.98" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote1Y" Storyboard.TargetProperty="Y" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="-5" KeySpline="0.2,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote2Y" Storyboard.TargetProperty="Y" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.38" Value="-5" KeySpline="0.2,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote3Y" Storyboard.TargetProperty="Y" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.48" Value="-4" KeySpline="0.2,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.28" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote1Y" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote2Y" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="2" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="-2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote3Y" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-2" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.3" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="28,4" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="MinWidth" Value="156" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="False">
                        <!-- 3-slice pointed-hexagonal optical aura bloom (hugs all 6 hexagonal edges naturally) -->
                        <Control x:Name="Bloom" Template="{DynamicResource LocalHexBloomTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                 Margin="-24,-24" Opacity="0.22" IsHitTestVisible="False" Focusable="False" />

                        <!-- Base pointed-hexagonal burnished imperial brass plaque (BS1 active bar geometry) -->
                        <Control x:Name="BasePlate" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                 Foreground="{DynamicResource BevelShadowBrush}"
                                 IsHitTestVisible="False" Focusable="False" />

                        <!-- Top brass specular sheen -->
                        <Border x:Name="TopSpecular" Margin="14,3,14,0" Height="2" VerticalAlignment="Top"
                                Background="{DynamicResource BevelLightBrush}" Opacity="0.42" IsHitTestVisible="False" />

                        <!-- Scrim darkening for Launching / Running contrast over EVE Cobalt -->
                        <Control x:Name="RunningBreath" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent" Foreground="Transparent"
                                 Opacity="0" IsHitTestVisible="False" Focusable="False" />

                        <!-- Launching diagonal EVE cobalt surge band (exact hexagonal plate shape) -->
                        <Grid x:Name="RunningScan" Visibility="Collapsed" Opacity="0.36" IsHitTestVisible="False">
                            <Grid.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.32">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                    <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                </LinearGradientBrush>
                            </Grid.OpacityMask>
                            <Control Template="{DynamicResource LocalHexPlateTemplate}" Background="{DynamicResource LocalEveLitBrush}"
                                     BorderBrush="Transparent" Foreground="Transparent" Focusable="False" />
                        </Grid>

                        <!-- Non-animated wrapper so Launching/Running collapse idle hover instantly with zero fade-out ghost -->
                        <Grid x:Name="IdleHoverHost" IsHitTestVisible="False">
                            <!-- Hover gleaming brass surge plate (Collapsed at rest) -->
                            <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                <Control Template="{DynamicResource LocalHexPlateTemplate}"
                                         Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                         BorderBrush="{DynamicResource LocalGoldHotBrush}"
                                         Foreground="{DynamicResource BevelShadowBrush}" Focusable="False" />
                                <!-- Animated diagonal gilded Art Deco light glint -->
                                <Grid Opacity="0.52">
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                                            <GradientStop x:Name="SheenA" Color="#00000000" Offset="-0.35" />
                                            <GradientStop x:Name="SheenB" Color="#FF000000" Offset="-0.15" />
                                            <GradientStop x:Name="SheenC" Color="#00000000" Offset="0.05" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <Control Template="{DynamicResource LocalHexPlateTemplate}" Background="{DynamicResource LocalGoldHotBrush}"
                                             BorderBrush="Transparent" Foreground="Transparent" Focusable="False" />
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Pressed bronze plate (Collapsed at rest) -->
                        <Control x:Name="PressLayer" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                 BorderBrush="{DynamicResource NormalBorderBrush}"
                                 Foreground="{DynamicResource BevelShadowBrush}"
                                 Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False" />

                        <!-- Brushed-silver vertex dome rivets (BioShock 1 riveted brass bar signature) -->
                        <Grid x:Name="BrassRivets" IsHitTestVisible="False">
                            <Ellipse Width="5.5" Height="5.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                     Fill="{DynamicResource LocalSteelBrush}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="0.9" />
                            <Ellipse Width="5.5" Height="5.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                     Fill="{DynamicResource LocalSteelBrush}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="0.9" />
                        </Grid>

                        <!-- Running + hover Cancel darkening scrim (below label) -->
                        <Control x:Name="RunningHoverDim" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent" Foreground="Transparent"
                                 Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False" />

                        <!-- Content & Cancel label inside PlayRoom -->
                        <Border x:Name="PlayRoom" Padding="0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                <StackPanel x:Name="PlayContent" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentControl x:Name="PlayGlyph" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"
                                                    Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}"
                                                    Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock x:Name="PlayLabel"
                                               Text="{TemplateBinding Content, Converter={StaticResource StringToUpperCaseConverter}}"
                                               FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                               Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                           Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                           FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Game.IsInstalled}" Value="False">
                            <Setter TargetName="PlayGlyph" Property="Content" Value="{DynamicResource IconDownload}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TopSpecular" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BrassRivets" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.46" To="0.52" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TopSpecular" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BrassRivets" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.42" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.22" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: ONLY while RUNNING button itself is hovered (RelativeSource Self, never TemplatedParent). -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RunningHoverDim" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.44" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <!-- Idle Play hover: gleaming brass + 9-slice bloom + diagonal Deco glint sweep -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SheenA" Storyboard.TargetProperty="Offset" From="-0.35" To="1.05" Duration="0:0:0.42">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SheenB" Storyboard.TargetProperty="Offset" From="-0.15" To="1.25" Duration="0:0:0.42">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SheenC" Storyboard.TargetProperty="Offset" From="0.05" To="1.45" Duration="0:0:0.42">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.26" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.24" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayPressIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- RunningMarkRoom left="0" right="36": reserve right strip for the 3 EVE bubbles clear of hexagonal tip -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,36,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,36,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,0,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalEveLitBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalEveForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalEveLitBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalEveForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
