<!--
    Bathysphere: DetailsViewItemStyle (details game list rows).
    - Installed games in ivory (TextBrush); uninstalled muted cream (TextBrushDarker).
    - Hover (IsMouseOver): smooth 120ms brass-tinted ocean wash + sliding gold hairline tick (X: -4 -> 0) + +2px label nudge.
    - Click/Selection (IsSelected): smooth 170ms deep Atlantic teal plate framed by antique gold top/bottom hairlines,
      springing left stepped gold chevron bar (ScaleY: 0.3 -> 1), and a quick golden confirmation glint sweep.
    - RowHoverAction: right-edge Play / Install icon button (transparent bg, 14px -> 17px grow, hidden & collapsed on
      IsLaunching / IsRunning, RowHoverRoom 0,0,38,0 right padding on hover).
    - Running / Launching: EVE / Salts Electric Cobalt (RunningIndicatorBrush #1A69CC) 2px frame with dark keyline,
      angled cobalt RunningScan (1.65s), 12-segment Salts foot bar (LocalSaltsSegmentMaskBrush), and 3 rising EVE bubbles
      inside a 36px reserved RowRoom strip with RunningMarkPlate backing.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid>
                        <Grid>
                            <!-- Hover plate & sliding left gold hairline tick (Collapsed at rest) -->
                            <Grid x:Name="HoverRectangle" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                <Border Background="{DynamicResource ListItemHoverBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                                <Rectangle x:Name="HoverTick" Width="2" Margin="0,4" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="HoverTickShift" X="-4" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>

                            <!-- Selected Atlantic teal plate + gold top/bottom rules + springing Art Deco chevron bar + confirmation glint -->
                            <Grid x:Name="SelectedRectangle" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                <Border Background="{DynamicResource ListItemSelectedBrush}" BorderBrush="{DynamicResource LocalGoldMutedBrush}"
                                        BorderThickness="0,1,0,1" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                                <Border x:Name="SelectGlint" Background="{DynamicResource SelectedSheenBrush}" Opacity="0.28">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="SelGlintA" Color="#00000000" Offset="-0.3" />
                                            <GradientStop x:Name="SelGlintB" Color="#FF000000" Offset="-0.15" />
                                            <GradientStop x:Name="SelGlintC" Color="#00000000" Offset="0" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Grid x:Name="SelectedBar" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="SelBarScale" ScaleY="0.3" />
                                    </Grid.RenderTransform>
                                    <Rectangle Width="3" Margin="0,2" Fill="{DynamicResource GlyphBrush}" />
                                    <Path Width="5" Height="8" Margin="3,0,0,0" Stretch="Fill" VerticalAlignment="Center"
                                          Data="M 0,0 L 5,4 L 0,8 Z" Fill="{DynamicResource GlyphBrush}" />
                                </Grid>
                            </Grid>

                            <!-- Running / Launching EVE Cobalt indicator (above hover & selection, below content) -->
                            <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.9" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.18"
                                        CornerRadius="{DynamicResource CornerRadiusSmall}" />
                                <Border x:Name="RunningMarkPlate" Visibility="Visible" Width="36" HorizontalAlignment="Right" Margin="2"
                                        Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.36">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#FF000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource LocalEveLitBrush}" Opacity="0.46"
                                        CornerRadius="{DynamicResource CornerRadiusSmall}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.14">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <!-- 12-segment Salts foot line -->
                                <Grid Height="2" Margin="5,0,5,3" VerticalAlignment="Bottom">
                                    <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.32" />
                                    <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalEveLitBrush}" RenderTransformOrigin="0,0.5"
                                               OpacityMask="{DynamicResource LocalSaltsSegmentMaskBrush}">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                                <!-- 2px EVE cobalt frame with dark inner keyline -->
                                <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2"
                                        CornerRadius="{DynamicResource CornerRadiusSmall}">
                                    <Border BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1" Opacity="0.72" />
                                </Border>
                                <!-- 3 staggered rising EVE bubbles in reserved 36px strip -->
                                <Grid Width="22" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,1">
                                    <Ellipse x:Name="RunningMote1" Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                             Fill="{DynamicResource LocalEveLitBrush}" Stroke="{DynamicResource LocalEveForegroundBrush}" StrokeThickness="0.6" Opacity="0.45">
                                        <Ellipse.RenderTransform><TranslateTransform x:Name="Mote1Y" Y="0" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="RunningMote2" Width="5.5" Height="5.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="{DynamicResource LocalEveLitBrush}" Stroke="{DynamicResource LocalEveForegroundBrush}" StrokeThickness="0.7" Opacity="0.6">
                                        <Ellipse.RenderTransform><TranslateTransform x:Name="Mote2Y" Y="0" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="RunningMote3" Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                             Fill="{DynamicResource LocalEveForegroundBrush}" Opacity="0.45">
                                        <Ellipse.RenderTransform><TranslateTransform x:Name="Mote3Y" Y="0" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Grid>

                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                <Border x:Name="RowRoom">
                                    <Grid ClipToBounds="True">
                                        <Border x:Name="RowHoverRoom">
                                            <ContentPresenter>
                                                <ContentPresenter.RenderTransform>
                                                    <TranslateTransform x:Name="ContentShift" X="0" />
                                                </ContentPresenter.RenderTransform>
                                            </ContentPresenter>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>

                        <!-- RowHoverAction: play (installed) or install (not installed) button on row's right edge while hovered; hidden during launching/running -->
                        <Button x:Name="RowHoverPlay" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCPlayGame}"
                                Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <ContentControl Focusable="False" Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}" />
                                        </Viewbox>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                            <Setter TargetName="Glyph" Property="Width" Value="17" />
                                            <Setter TargetName="Glyph" Property="Height" Value="17" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="RowHoverInstall" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCInstallGame}"
                                Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <ContentControl Focusable="False" Content="{DynamicResource IconDownload}" ContentTemplate="{DynamicResource IconTemplate}" />
                                        </Viewbox>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                            <Setter TargetName="Glyph" Property="Width" Value="17" />
                                            <Setter TargetName="Glyph" Property="Height" Value="17" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="HoverExit" />
                                <BeginStoryboard Name="HoverEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverTickShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ContentShift" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="HoverExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="HoverTickShift" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ContentShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="Visibility" Duration="0:0:0.18">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="HoverEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverRectangle" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="SelectExit" />
                                <BeginStoryboard Name="SelectEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedRectangle" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedRectangle" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelBarScale" Storyboard.TargetProperty="ScaleY" From="0.3" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelGlintA" Storyboard.TargetProperty="Offset" From="-0.3" To="1.05" Duration="0:0:0.28" />
                                        <DoubleAnimation Storyboard.TargetName="SelGlintB" Storyboard.TargetProperty="Offset" From="-0.15" To="1.2" Duration="0:0:0.28" />
                                        <DoubleAnimation Storyboard.TargetName="SelGlintC" Storyboard.TargetProperty="Offset" From="0" To="1.35" Duration="0:0:0.28" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="SelectExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedRectangle" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SelBarScale" Storyboard.TargetProperty="ScaleY" To="0.3" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedRectangle" Storyboard.TargetProperty="Visibility" Duration="0:0:0.16">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="SelectEnter" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Launching EVE sweep + 12-segment Salts foot + 3 rising EVE bubbles -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RowHoverPlay" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RowHoverInstall" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,36,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote1Y" Storyboard.TargetProperty="Y" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="-4" KeySpline="0.2,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote2Y" Storyboard.TargetProperty="Y" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.38" Value="-4" KeySpline="0.2,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote3Y" Storyboard.TargetProperty="Y" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.48" Value="-3" KeySpline="0.2,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.28" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Running calm idle breath + steady 12-segment Salts bar + gently drifting bubbles -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RowHoverPlay" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RowHoverInstall" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,36,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote1Y" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-2.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote2Y" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="-2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote3Y" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-1.5" KeySpline="0.4,0 0.6,1" />
