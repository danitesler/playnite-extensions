<!--
    Bathysphere: left compact 44px abyssal Rapture rail (ShellBackgroundBrush) closed by a double brass/bronze edge rule.
    PART_ElemMainMenu holds the original Bathysphere Porthole & Lighthouse mark (IconMainMenu) with a brass bloom on hover.
    ShowBackgroundImageOnWindow=True turns the rail and menu backing transparent over window background art.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                        Width="44" Height="52" Margin="0,0,0,4"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                <Control Template="{DynamicResource LocalBathysphereMenuMarkTemplate}" Focusable="False" IsTabStop="False" Foreground="{DynamicResource MainMenuButtonForegroundBrush}" />
                <Border x:Name="MenuDivider" Height="1" VerticalAlignment="Bottom"
                        Background="{DynamicResource WindowPanelSeparatorBrush}" IsHitTestVisible="False" />
                <Border x:Name="MenuAccentLine" Height="1" Margin="6,0,6,2" VerticalAlignment="Bottom"
                        Background="{DynamicResource LocalGoldMutedBrush}" Opacity="0.5" IsHitTestVisible="False" />
            </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                            <Border x:Name="InnerEdgeRule" Width="1" Margin="0,0,2,0" HorizontalAlignment="Right" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                    Background="{DynamicResource LocalBronzeDarkBrush}" Opacity="0.7" />
                            <Border x:Name="EdgeRule" Width="1" HorizontalAlignment="Right" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                    Background="{DynamicResource WindowPanelSeparatorBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Background" Value="Transparent" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="InnerEdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="InnerEdgeRule" />
                            <Setter Property="Margin" Value="2,0,0,0" TargetName="InnerEdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuDivider" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuAccentLine" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="InnerEdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuDivider" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuAccentLine" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="InnerEdgeRule" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
