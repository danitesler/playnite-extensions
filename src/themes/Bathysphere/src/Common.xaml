<!--
    Bathysphere: spacing, focus visuals, shared FX white-mask brushes, and Art Deco / Beaux-Arts chrome templates.
    All FX masks are frozen shared resources so controls avoid per-instance brush allocations.
    No template exposes desired width >= 200 so Statistics cards remain compact.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">12,5</Thickness>
    <Thickness x:Key="ListBoxItemPadding">12,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,0</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Shared 32px form field & button height (filter sidebar uses 28px). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Shared deterministic white-mask FX brushes (recolored dynamically through ThemeModifier) -->
    <ImageBrush x:Key="LocalDecoFanMaskBrush" ImageSource="{ThemeFile 'Images/fx/deco-fan.png'}" TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalVellumGrainMaskBrush" ImageSource="{ThemeFile 'Images/fx/vellum-grain.png'}" TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalWaterCausticMaskBrush" ImageSource="{ThemeFile 'Images/fx/water-caustic.png'}" TileMode="Tile" Viewport="0,0,256,128" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalSunburstMaskBrush" ImageSource="{ThemeFile 'Images/fx/sunburst-rays.png'}" Stretch="Uniform" />

    <!-- BioShock Infinite 12-segment Salts bar opacity mask (9px lit cell + 3px dark divider, seamless tile) -->
    <DrawingBrush x:Key="LocalSaltsSegmentMaskBrush" TileMode="Tile" Viewport="0,0,12,8" ViewportUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,12,8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,9,8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 9-slice brass / EVE halo bloom (Images/fx/bloom.png 128x128, 32px slices drawn at 14px). Host Foreground = glow color. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,0,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="32,0,64,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="96,0,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,32,32,64" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="32,32,64,64" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="96,32,32,64" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,96,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="32,96,64,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="96,96,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- 3-slice pointed-hexagonal soft optical bloom (Images/fx/hex-bloom.png 256x90, 48px pointed caps + 160px center).
         Wraps PlayButton naturally around all 6 hexagonal edges with zero rectangular corners. Host Foreground = glow color. -->
    <ControlTemplate x:Key="LocalHexBloomTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/hex-bloom.png'}" Viewbox="0,0,48,90" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/hex-bloom.png'}" Viewbox="48,0,160,90" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/hex-bloom.png'}" Viewbox="208,0,48,90" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- BioShock 1 pointed-hexagonal 45-degree brass plaque (12px pointed caps, crisp at any width).
         Host Background = fill, BorderBrush = outer gold rim, Foreground = inner dark hairline (or Transparent). -->
    <ControlTemplate x:Key="LocalHexPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 12,0 L 12,24 L 0,12 Z" />
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Background}" Margin="-0.5,0" />
            <Path Grid.Column="2" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 0,0 L 12,12 L 0,24 Z" />

            <!-- Outer gold rim -->
            <Path Grid.Column="0" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.4" Data="M 12,0 L 0,12 L 12,24" />
            <Border Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1.4,0,1.4" />
            <Path Grid.Column="2" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.4" Data="M 0,0 L 12,12 L 0,24" />

            <!-- Recessed inner keyline -->
            <Path Grid.Column="0" Stretch="Fill" Margin="2,2,0,2" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity="0.7" Data="M 10,0 L 0,10 L 10,20" />
            <Border Grid.Column="1" Margin="0,2" BorderBrush="{TemplateBinding Foreground}" BorderThickness="0,1,0,1" Opacity="0.7" />
            <Path Grid.Column="2" Stretch="Fill" Margin="0,2,2,2" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity="0.7" Data="M 0,0 L 10,10 L 0,20" />
        </Grid>
    </ControlTemplate>

    <!-- Compact pointed-hexagonal bar (8px pointed caps) for 30px menu / ComboBox highlight rows -->
    <ControlTemplate x:Key="LocalMenuHexPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 8,0 L 8,24 L 0,12 Z" />
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Background}" Margin="-0.5,0" />
            <Path Grid.Column="2" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 0,0 L 8,12 L 0,24 Z" />
            <Path Grid.Column="0" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.1" Data="M 8,0 L 0,12 L 8,24" />
            <Border Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1.1,0,1.1" />
            <Path Grid.Column="2" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.1" Data="M 0,0 L 8,12 L 0,24" />
        </Grid>
    </ControlTemplate>

    <!-- Octagonal chamfered brass bezel plate (5px corner chamfers). Host Background = fill, BorderBrush = edge. -->
    <ControlTemplate x:Key="ChamferTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
            </Grid.RowDefinitions>
            <Path Grid.Row="0" Grid.Column="0" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 5,0 L 5,5 L 0,5 Z" />
            <Border Grid.Row="0" Grid.Column="1" Background="{TemplateBinding Background}" />
            <Path Grid.Row="0" Grid.Column="2" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 0,0 L 5,5 L 0,5 Z" />
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="{TemplateBinding Background}" />
            <Path Grid.Row="2" Grid.Column="0" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 0,0 L 5,0 L 5,5 Z" />
            <Border Grid.Row="2" Grid.Column="1" Background="{TemplateBinding Background}" />
            <Path Grid.Row="2" Grid.Column="2" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 0,0 L 5,0 L 0,5 Z" />

            <Path Grid.Row="0" Grid.Column="0" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" Data="M 0,5 L 5,0" />
            <Border Grid.Row="0" Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1.2,0,0" />
            <Path Grid.Row="0" Grid.Column="2" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" Data="M 0,0 L 5,5" />
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2,0,0,0" />
            <Border Grid.Row="1" Grid.Column="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1.2,0" />
            <Path Grid.Row="2" Grid.Column="0" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" Data="M 0,0 L 5,5" />
            <Border Grid.Row="2" Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1.2" />
            <Path Grid.Row="2" Grid.Column="2" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" Data="M 0,5 L 5,0" />
        </Grid>
    </ControlTemplate>

    <!-- Art Deco scalloped sunburst fan texture overlay (Host Foreground + Opacity). -->
    <ControlTemplate x:Key="LocalDecoFanTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" OpacityMask="{StaticResource LocalDecoFanMaskBrush}" />
    </ControlTemplate>

    <!-- 1912 Columbia vellum cotton-rag paper texture overlay (Host Foreground + Opacity). -->
    <ControlTemplate x:Key="LocalVellumGrainTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" OpacityMask="{StaticResource LocalVellumGrainMaskBrush}" />
    </ControlTemplate>

    <!-- Submerged Atlantic water caustic shimmer overlay (Host Foreground + Opacity). -->
    <ControlTemplate x:Key="LocalWaterCausticTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" OpacityMask="{StaticResource LocalWaterCausticMaskBrush}" />
    </ControlTemplate>

    <!-- Radial Art Deco 16-ray lighthouse beacon sunburst (Host Foreground + Opacity). -->
    <ControlTemplate x:Key="LocalSunburstTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" OpacityMask="{StaticResource LocalSunburstMaskBrush}" />
    </ControlTemplate>

    <!-- Columbia 1912 Beaux-Arts divider rule centered around a gilded diamond clasp with crimson ruby pip (no fixed width >= 200). -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="9" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <Rectangle Height="1" Fill="{TemplateBinding BorderBrush}" />
                <Rectangle Height="1" Margin="18,1,0,0" Fill="{TemplateBinding Foreground}" Opacity="0.35" />
            </StackPanel>
            <Grid Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                <Path Width="13" Height="8" Stretch="Fill"
                      Data="M 6.5,0 L 13,4 L 6.5,8 L 0,4 Z"
                      Fill="{TemplateBinding Foreground}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="0.8" />
                <Path Width="5" Height="4" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 2.5,0 L 5,2 L 2.5,4 L 0,2 Z"
                      Fill="{DynamicResource DangerBrush}" />
            </Grid>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Rectangle Height="1" Fill="{TemplateBinding BorderBrush}" />
                <Rectangle Height="1" Margin="0,1,18,0" Fill="{TemplateBinding Foreground}" Opacity="0.35" />
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <!-- Art Deco stepped L-brackets at all four corners (focus visuals, hovered covers, Deco panels). -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,12 L0,0 12,0 12,2 4,2 4,4 2,4 2,12Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L12,0 12,12 10,12 10,4 8,4 8,2 0,2Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L2,0 2,8 4,8 4,10 12,10 12,12 0,12Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M10,0 L12,0 12,12 0,12 0,10 8,10 8,8 10,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <!-- Brushed-silver Deco corner rivets over a panel border (no desired width >= 200). -->
    <ControlTemplate x:Key="RivetsTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Ellipse Width="4" Height="4" Margin="4,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource LocalSteelBrush}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="0.7" />
            <Ellipse Width="4" Height="4" Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource LocalSteelBrush}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="0.7" />
            <Ellipse Width="4" Height="4" Margin="4,0,0,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource LocalSteelBrush}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="0.7" />
            <Ellipse Width="4" Height="4" Margin="0,0,4,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource LocalSteelBrush}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="0.7" />
        </Grid>
    </ControlTemplate>

    <!-- Original Bathysphere Art Deco Porthole & Lighthouse mark. -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource IconMainMenu}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBoxFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Steam Screenshots loading placeholder: breathes calmly while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel x:Name="Root" IsHitTestVisible="False" Opacity="0.4">
            <Border Background="{TemplateBinding Foreground}" Opacity="0.3" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{TemplateBinding Foreground}" Opacity="0.3" CornerRadius="{DynamicResource CornerRadiusSmall}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Grid.Column="2" Background="{TemplateBinding Foreground}" Opacity="0.3" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Grid.Column="4" Background="{TemplateBinding Foreground}" Opacity="0.3" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Grid.Column="6" Background="{TemplateBinding Foreground}" Opacity="0.3" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Grid.Column="8" Background="{TemplateBinding Foreground}" Opacity="0.3" CornerRadius="{DynamicResource CornerRadiusSmall}" />
            </Grid>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Breathe">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0.45" To="0.95" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Breathe" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- EmptyGameTemplate: riveted brass Bathysphere porthole framing the breathing Lighthouse beacon & LOCErrorNoGameSelected. -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource FrameBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusLarge}" Padding="26,28,26,24">
                <Grid>
                    <!-- Subtle Columbia cotton-rag vellum grain & crimson bunting cap -->
                    <Control Template="{DynamicResource LocalVellumGrainTemplate}" Margin="-25,-27,-25,-23"
                             Foreground="{DynamicResource GlyphBrush}" Opacity="0.045" Focusable="False" />
                    <Rectangle Height="3" Margin="-25,-27,-25,0" VerticalAlignment="Top"
                               Fill="{DynamicResource DangerBrush}" Opacity="0.82" IsHitTestVisible="False" />
                    <Control Template="{DynamicResource CornerMarksTemplate}" Margin="-22,-22,-22,-20"
                             Foreground="{DynamicResource GlyphBrush}" Opacity="0.65" Focusable="False" />

                    <StackPanel HorizontalAlignment="Center">
                        <!-- Riveted circular Bathysphere Porthole + breathing 16-ray sunburst -->
                        <Grid Width="124" Height="124" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Control x:Name="BeaconBurst" Template="{DynamicResource LocalSunburstTemplate}"
                                     Foreground="{DynamicResource GlyphBrush}" Opacity="0.34" Focusable="False" />
                            <Ellipse Width="96" Height="96" Fill="{DynamicResource InputBackgroundBrush}"
                                     Stroke="{DynamicResource FrameBrush}" StrokeThickness="2" />
                            <Ellipse Width="86" Height="86" Stroke="{DynamicResource LocalGoldMutedBrush}" StrokeThickness="1" Opacity="0.6" />
                            <!-- Cardinal brass rivets on porthole ring -->
                            <Ellipse Width="5" Height="5" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0" Fill="{DynamicResource LocalSteelBrush}" />
                            <Ellipse Width="5" Height="5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Fill="{DynamicResource LocalSteelBrush}" />
                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" Fill="{DynamicResource LocalSteelBrush}" />
                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" Fill="{DynamicResource LocalSteelBrush}" />
                            <Control x:Name="BeaconMark" Template="{DynamicResource BrandMarkTemplate}"
                                     Width="54" Height="54" Foreground="{DynamicResource GlyphBrush}" Opacity="0.88" Focusable="False" />
                        </Grid>

                        <Control Template="{DynamicResource DividerTemplate}" Width="180" Margin="0,0,0,12"
                                 Foreground="{DynamicResource GlyphBrush}" BorderBrush="{DynamicResource FrameBrush}" Focusable="False" />

                        <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                   FontFamily="{DynamicResource HeadingFontFamily}"
                                   FontSize="{DynamicResource FontSizeLarger}"
                                   Foreground="{DynamicResource HeadingForegroundBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="PortholeBreathe">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="BeaconBurst" Storyboard.TargetProperty="Opacity" From="0.22" To="0.58" Duration="0:0:1.8">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BeaconMark" Storyboard.TargetProperty="Opacity" From="0.72" To="1.0" Duration="0:0:1.8">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="PortholeBreathe" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
