<!--
    Bathysphere: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys follow Playnite's palette keys and scripts/data/theme-keys.json; theme-only decorative resources use Local*.
    Theme XAML reads brushes only, never Color keys. No double braces in comments.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Pathway Gothic One (tall Art Deco display, OFL), Jost (Futura geometric body, OFL),
         and Cinzel Bold (Columbia engraved score badges, OFL), all bundled in src/Typography. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">36</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Jost, {{text:bs-font-body|Jost}}, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Pathway Gothic One, {{text:bs-font-display|Pathway Gothic One}}, Arial Narrow, Segoe UI</FontFamily>
    <FontFamily x:Key="PosterFontFamily">./Typography/#Cinzel, {{text:bs-font-poster|Cinzel}}, Georgia</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width (applied inside Columbia vellum dossier padding & brass frame). -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape: crisp architectural Art Deco corners; hero & menu highlight bars use 45-degree hexagonal plates. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:bs-radius-md|3}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:bs-radius-sm|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:bs-radius-lg|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:bs-radius-xl|6}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{bs-ivory}}</Color>
    <Color x:Key="TextColorDarker">{{bs-ivory-dim}}</Color>
    <Color x:Key="TextColorDark">{{bs-ink-dark}}</Color>
    <Color x:Key="MainColor">{{bs-panel-alt}}</Color>
    <Color x:Key="MainColorDark">{{bs-panel}}</Color>
    <Color x:Key="HoverColor">{{bs-panel-hover}}</Color>
    <Color x:Key="GlyphColor">{{bs-gold}}</Color>
    <Color x:Key="HighlightGlyphColor">{{bs-teal-sel}}</Color>
    <Color x:Key="PopupBackgroundColor">{{bs-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{bs-brass}}</Color>
    <Color x:Key="BackgroundToneColor">{{bs-panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{bs-grid-well}}</Color>
    <Color x:Key="PanelSeparatorColor">{{bs-bronze}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{bs-bronze}}</Color>
    <Color x:Key="DataChangeNotifColor">{{bs-hack}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{bs-bronze}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{bs-panel}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{bs-panel-alt}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{bs-well}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{bs-hack}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{bs-crimson-lit}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{bs-mixed}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{bs-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{bs-deep}}" />

    <!-- Shell & submerged Rapture surfaces -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{bs-abyss}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{bs-deep}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{bs-abyss}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{bs-deep}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{bs-scrim}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{bs-abyss}}" />
    <!-- Banner darkening color: abyssal Atlantic lacquer (#081113) casts hero art into submerged Rapture noir. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{bs-abyss}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{bs-abyss}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{bs-well}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{bs-panel}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{bs-bronze}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{bs-bronze}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{bs-scrim}}" />

    <!-- States & Selection (Deep Atlantic Teal selection; EVE/Salts Cobalt strictly reserved for Running/Launching) -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{bs-teal-sel}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{bs-teal-sel-hover}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{bs-ivory-gold}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{bs-gold-hot}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{bs-teal-wash}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{bs-teal-sel}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{bs-teal-sel}}" />
    <!-- EVE / Salts Electric Cobalt: distinct hue reserved strictly for launching and running games. -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{bs-eve}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{bs-gold-hot}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{bs-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{bs-crimson-fg}}" />

    <!-- Buttons (Burnished Imperial Brass Play CTA; dark oceanic steel secondary buttons) -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{bs-ivory}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{bs-ivory-gold}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{bs-ivory-dim}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{bs-bronze}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{bs-panel-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{bs-panel-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{bs-brass}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{bs-gold-hot}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{bs-brass-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{bs-brass-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{bs-ink-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{bs-panel-alt}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{bs-bronze}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{bs-panel-hover}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{bs-panel-press}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{bs-teal-sel}}" />

    <!-- Inputs & Form Controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{bs-well}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{bs-panel}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{bs-bronze}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{bs-gold-muted}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{bs-bronze}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{bs-teal-sel-hover}}" />

    <!-- Tracks, Thumbs, Tabs, Covers & Shell Controls -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{bs-well}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{bs-brass}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{bs-gold-hot}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{bs-well}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{bs-progress}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{bs-bronze}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{bs-well}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{bs-bronze}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{bs-ivory-dim}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{bs-ivory}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{bs-gold-muted}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{bs-abyss}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{bs-gold-hot}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{bs-brass}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{bs-panel-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{bs-teal-sel}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{bs-ivory-dim}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{bs-gold-hot}}" />

    <!-- Metadata Chips, Tooltips, Frames & Dialog Chrome -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{bs-chip-bg}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{bs-chip-fg}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{bs-chip-hover}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{bs-bronze}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{bs-ivory}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{bs-brass}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{bs-abyss}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{bs-ivory-gold}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{bs-ivory-gold}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{bs-bronze}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{bs-brass}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{bs-bronze-dark}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{bs-gold}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{bs-bronze}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{bs-gold-hot}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{bs-bronze-dark}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{bs-slate-pill}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{bs-ivory-gold}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{bs-link}}" />

    <!-- Columbia 1912 Vellum Metadata Dossier -->
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{bs-vellum}}" />
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{bs-vellum-edge}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{bs-ink}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{bs-vellum-title}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{bs-umber}}" />
    <SolidColorBrush x:Key="ParchmentLinkBrush" Color="{{bs-vellum-link}}" />

    <!-- Theme-only decorative brass, steel rivet, Columbia plaque & EVE lit accents -->
    <SolidColorBrush x:Key="LocalGoldHotBrush" Color="{{bs-gold-hot}}" />
    <SolidColorBrush x:Key="LocalGoldMutedBrush" Color="{{bs-gold-muted}}" />
    <SolidColorBrush x:Key="LocalBronzeDarkBrush" Color="{{bs-bronze-dark}}" />
    <SolidColorBrush x:Key="LocalSteelBrush" Color="{{bs-steel}}" />
    <SolidColorBrush x:Key="LocalSteelDarkBrush" Color="{{bs-steel-dark}}" />
    <SolidColorBrush x:Key="LocalSlatePillDarkBrush" Color="{{bs-slate-pill-dark}}" />
    <SolidColorBrush x:Key="LocalEveLitBrush" Color="{{bs-eve-lit}}" />
    <SolidColorBrush x:Key="LocalEveForegroundBrush" Color="{{bs-eve-fg}}" />
    <SolidColorBrush x:Key="LocalHackDarkBrush" Color="{{bs-hack-dark}}" />
    <SolidColorBrush x:Key="LocalCrimsonLitBrush" Color="{{bs-crimson-lit}}" />
</ResourceDictionary>
