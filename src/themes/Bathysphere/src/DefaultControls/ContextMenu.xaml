<!--
    Bathysphere: Overlay on Playnite Default/DefaultControls/ContextMenu.xaml.
    Every popup menu (hamburger menu via TopPanelMenu, top bar dropdowns, game/group/tray menus, text box menus,
    ComboBox lists, and multi-select boxes) shares LocalMenuBoardTemplate:
    - Panel: submerged Rapture verdigris-lacquer board (#112126) textured with subtle Art Deco scalloped brass fans (5%),
      framed by a burnished brass outer rim, dark bronze inner keyline, and stepped Art Deco L-brackets at all 4 corners.
    - Rows, pointed-hexagonal highlight, brass-bracketed shortcuts, 3-ray sunburst break, and crimson Alt+Q Exit: Menu.xaml.
    Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}" />
            <Border Margin="2" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" Opacity="0.85" />
            <Control Template="{DynamicResource LocalVellumGrainTemplate}" Margin="2"
                     Foreground="{DynamicResource GlyphBrush}" Opacity="0.045" Focusable="False" IsTabStop="False" />
            <!-- 1912 Columbia crimson bunting top cap ribbon -->
            <Rectangle Height="3" Margin="3,2,3,0" VerticalAlignment="Top"
                       Fill="{DynamicResource DangerBrush}" Opacity="0.88" IsHitTestVisible="False" />
            <!-- Beaux-Arts brass corner brackets & pewter rivets -->
            <Control Template="{DynamicResource CornerMarksTemplate}" Margin="1"
                     Foreground="{DynamicResource GlyphBrush}" Opacity="0.72" Focusable="False" IsTabStop="False" />
            <Control Template="{DynamicResource RivetsTemplate}" Margin="3,5,3,3"
                     Focusable="False" IsTabStop="False" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="224" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,7,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="4,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
