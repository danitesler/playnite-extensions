<!--
    Bathysphere: TreeView (Settings & Add-ons section list, Filter/Explorer trees).
    - Dialog casing: WindowSettings (Width=250) and WindowExtensions (Width=280) set VerticalScrollBarVisibility=Visible
      and HorizontalScrollBarVisibility=Disabled so expanding nodes never shifts layout.
    - Rows: minimal bare 28px lines in normal body font (Jost, no idle plates/borders, no heading face or caps).
    - States (three opacity-animated layers): soft ocean wash hover (120ms/200ms), held deep Atlantic teal selection +
      2px antique gold left bar with stepped chevron pointer + brighter ivory-gold label (180ms).
    - Non-selectable Separator tagging preserved. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
        <Style.Resources>
            <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
                <Setter Property="Tag" Value="BathysphereNavDivider" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </Style.Resources>
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Border x:Name="Case" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <Grid>
                            <Border x:Name="NavCasing" Visibility="Collapsed"
                                    Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}"
                                    BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="Scroller" Focusable="False" Padding="4,6,4,6"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="DialogNav">
                            <Setter TargetName="NavCasing" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Scroller" Property="Padding" Value="6,8,4,8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowSettings">
                <Setter Property="Width" Value="250" />
                <Setter Property="Tag" Value="DialogNav" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowExtensions">
                <Setter Property="Width" Value="280" />
                <Setter Property="Tag" Value="DialogNav" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Padding" Value="10,4,12,4" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Grid x:Name="Row" MinHeight="28" Background="Transparent" Margin="0,0,0,1" SnapsToDevicePixels="True">
                            <Border x:Name="HoverPlate" Background="{DynamicResource ListItemHoverBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="SelectedPlate" Background="{DynamicResource ListItemSelectedBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                            <Grid x:Name="SelectedBar" HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False">
                                <Rectangle Width="2" Margin="0,3" Fill="{DynamicResource GlyphBrush}" />
                                <Path Width="4" Height="6" Margin="2,0,0,0" Stretch="Fill" VerticalAlignment="Center"
                                      Data="M 0,0 L 4,3 L 0,6 Z" Fill="{DynamicResource GlyphBrush}" />
                            </Grid>
                            <Border x:Name="SelectionBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <ToggleButton x:Name="Expander" ClickMode="Press" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                                  Foreground="{DynamicResource LocalGoldMutedBrush}"
                                                  IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Style>
                                            <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseStyle}">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                            <Grid Background="Transparent">
                                                                <Path x:Name="Arrow" Data="M3,2.5 L9.5,7 L3,11.5 Z" Width="14" Height="14" Stretch="None"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                                                      Fill="{TemplateBinding Foreground}">
                                                                    <Path.RenderTransform>
                                                                        <RotateTransform x:Name="ArrowRotation" Angle="0" />
                                                                    </Path.RenderTransform>
                                                                </Path>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Trigger.EnterActions>
                                                                        <BeginStoryboard x:Name="ExpOpen">
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="ArrowRotation" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.12" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.EnterActions>
                                                                    <Trigger.ExitActions>
                                                                        <BeginStoryboard x:Name="ExpClose">
                                                                            <Storyboard FillBehavior="Stop">
                                                                                <DoubleAnimation Storyboard.TargetName="ArrowRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.12" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.ExitActions>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" Height="Auto" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="MaxWidth" Value="192" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemsHost" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="Visibility" Value="Hidden" TargetName="Expander" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="Row">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Expander" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="Expander" Property="Foreground" Value="{DynamicResource LocalGoldHotBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeSelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeSelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Header.Tag, RelativeSource={RelativeSource Self}}" Value="BathysphereNavDivider">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="IsSelected" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <ContentPresenter ContentSource="Header" Margin="10,4,12,4" IsHitTestVisible="False" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
