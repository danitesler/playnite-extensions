<!--
    Bathysphere: ProgressBar (BioShock 1/2 brushed-silver capped glass vial tube).
    Takes its height from Height with MinHeight=8 so dialogs use 8px and PART_ProgressGlobal uses 12px.
    Uses ProgressBarForegroundBrush (deep Rapture emerald lacquer) so overlaid ivory progress text stays >= 5.4:1.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid Height="{TemplateBinding Height}" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" />
                        <Border Margin="4,1" CornerRadius="1" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="1">
                                    <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource BevelLightBrush}" Opacity="0.22" IsHitTestVisible="False" />
                                </Border>
                                <Grid x:Name="IndeterminateHost" Visibility="Collapsed" ClipToBounds="True" IsHitTestVisible="False">
                                    <Rectangle x:Name="IndeterminateBand" Width="96" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="0.5" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="IndetShift" X="-96" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </Border>
                        <!-- Brushed-silver glass vial end caps (BS1/BS2 Health & EVE tubes) -->
                        <Border Width="4" HorizontalAlignment="Left" Background="{DynamicResource LocalSteelBrush}"
                                BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="0,0,1,0" CornerRadius="1,0,0,1" IsHitTestVisible="False" />
                        <Border Width="4" HorizontalAlignment="Right" Background="{DynamicResource LocalSteelBrush}"
                                BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1,0,0,0" CornerRadius="0,1,1,0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateHost" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndetLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndetShift" Storyboard.TargetProperty="X" From="-96" To="360" Duration="0:0:1.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="IndetLoop" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
