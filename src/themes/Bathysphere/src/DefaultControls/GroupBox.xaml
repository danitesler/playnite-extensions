<!--
    Bathysphere: GroupBox. Content-sized stepped Art Deco card so Playnite Statistics sections wrap cleanly side-by-side.
    Never uses fixed widths >= 200 or wide Paths inside the template. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <Control Template="{DynamicResource CornerMarksTemplate}" Margin="1"
                                     Foreground="{DynamicResource LocalGoldMutedBrush}" Opacity="0.55" Focusable="False" IsHitTestVisible="False" />
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="14,8,14,7" BorderBrush="{DynamicResource LocalBronzeDarkBrush}"
                                        BorderThickness="0,0,0,1" Background="{DynamicResource ShellBackgroundBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="7" Height="7" Margin="0,0,8,0" Stretch="Fill" VerticalAlignment="Center"
                                              Data="M 3.5,0 L 7,3.5 L 3.5,7 L 0,3.5 Z" Fill="{DynamicResource GlyphBrush}" />
                                        <TextBlock Style="{DynamicResource HeadingTextBlock}">
                                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
