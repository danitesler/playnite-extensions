<!--
    Overlay on Playnite Default/DefaultControls/Menu.xaml. Every popup menu (hamburger menu, top bar dropdowns, game and
    group menus, tray) is a client dropdown list in the three-line frame of ContextMenu.xaml (LocalMenuFrameTemplate).
    Icons are Playnite's menu icons (16px PNGs from art/menu_icons.py). MenuItem.SeparatorStyleKey has its own group break.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="4,3,4,3" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Height="1" Opacity="0.35"
                            SnapsToDevicePixels="true" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group break in every menu: the frame's lines in miniature, an engraved rule (a black line over a metal line)
         from the label edge to the right edge, 8px tall. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="8" Margin="34,0,8,0" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center">
                            <Rectangle Height="1" Fill="{DynamicResource FrameInnerBrush}" />
                            <Rectangle Height="1" Fill="{DynamicResource FrameBrush}" Opacity="0.75" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TopLevelHeader -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border">
            <Grid>
                <Border x:Name="HoverBorder" Background="{DynamicResource MenuItemHoverBrush}" Visibility="Collapsed"
                        CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <TextBlock VerticalAlignment="Center" Padding="5" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                    <Border SnapsToDevicePixels="True" BorderBrush="{DynamicResource PopupBorderBrush}"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            BorderThickness="{DynamicResource PopupBorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Border BorderThickness="0"
                                Padding="{DynamicResource MenuPadding}">
                            <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="HoverBorder" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- TopLevelItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" BorderBrush="{DynamicResource PopupBorderBrush}"
                Background="{DynamicResource PopupBackgroundBrush}"
                BorderThickness="{DynamicResource PopupBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>

    <!--
        Rows of every popup menu, compact: 28px on the tooltip backdrop.
        - Row: a fixed 28px icon column whose 20px item slot (sunken band, metal rim, 2px corners) holds the icon; the
          label in the normal font colour (gold); shortcuts on a small charcoal dropdown plate (lit top line) in gold.
          A checked row is a checked slot: gold glow inside a gold line with the gold tick.
        - Highlight (pointer or keyboard): the client's mouse highlight, an additive gold glow, fades in (0.12s) between
          two gold hairlines that draw in from the left edge (0.18s) and fade out to the right; the label, shortcut and
          arrow switch to the highlight font colour (white) and the slot rim lights gold. Out over 0.25s.
        - Exit (gesture Alt+Q) is the one marked row: its highlight is the red panel-button face in its gray bezel
          (white label, no glow lines).
        - Submenu headers: the gold triangle at the right edge, white while open, with the glow held at 60 percent (no
          animation) so moving into the submenu never flickers; submenus open in the same frame.
        Recipe: docs/themes/menus.md.
    -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="28" Background="Transparent" SnapsToDevicePixels="True">
            <Grid x:Name="MenuGlow" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="MenuGlowFill" Background="{DynamicResource MenuItemHoverBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}"
                        BorderThickness="0" CornerRadius="2" />
                <Grid x:Name="MenuGlowLines" RenderTransformOrigin="0,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="MenuLineScale" ScaleX="0" />
                    </Grid.RenderTransform>
                    <Grid.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#CC000000" Offset="0.45" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.OpacityMask>
                    <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource SelectedBorderBrush}" />
                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource SelectedBorderBrush}" />
                </Grid>
            </Grid>
            <Grid Margin="6,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconSlot" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="0" CornerRadius="2">
                    <ContentPresenter x:Name="Icon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Icon" />
                </Border>
                <Border x:Name="GlyphPanel" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                        Background="{DynamicResource ListItemSelectedBrush}" BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1" CornerRadius="2">
                    <ContentPresenter Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource GlyphBrush}"
                                      Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconTemplate}" />
                </Border>
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource GlyphBrush}" TextTrimming="CharacterEllipsis">
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <Border x:Name="MenuPlate" Grid.Column="2" Height="18" Margin="14,0,0,0" Padding="5,0" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Background="{DynamicResource SecondaryButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1" CornerRadius="2">
                    <Grid>
                        <Border Height="1" Margin="-4,0" VerticalAlignment="Top" Background="{DynamicResource BevelLightBrush}" Opacity="0.7" />
                        <TextBlock x:Name="GestureText" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="IconSlot" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="IconSlot" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuPlate" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuPlate" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" TargetName="MenuGlowFill" />
                <Setter Property="BorderThickness" Value="1" TargetName="MenuGlowFill" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuGlowLines" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="GestureText" />
                <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" TargetName="IconSlot" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuGlow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="MenuLineScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuGlow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetName="MenuLineScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="28" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Glow held at 60 percent while the submenu is open (no animation, so moving into the submenu never flickers) -->
            <Border x:Name="MenuHeld" Visibility="Collapsed" Background="{DynamicResource MenuItemHoverBrush}" Opacity="0.6"
                    CornerRadius="2" IsHitTestVisible="False" />
            <Grid x:Name="MenuGlow" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource MenuItemHoverBrush}" CornerRadius="2" />
                <Grid RenderTransformOrigin="0,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="MenuLineScale" ScaleX="0" />
                    </Grid.RenderTransform>
                    <Grid.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#CC000000" Offset="0.45" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.OpacityMask>
                    <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource SelectedBorderBrush}" />
                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource SelectedBorderBrush}" />
                </Grid>
            </Grid>
            <Grid Margin="6,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconSlot" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="0" CornerRadius="2">
                    <ContentPresenter x:Name="Icon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Icon" />
                </Border>
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource GlyphBrush}" TextTrimming="CharacterEllipsis">
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <ContentPresenter x:Name="MenuArrow" Grid.Column="3" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource GlyphBrush}"
                                  Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconTemplate}" />
            </Grid>
            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                   HorizontalOffset="6" VerticalOffset="-7" Focusable="False" AllowsTransparency="True">
                <Grid MinWidth="200" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalMenuFrameTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="3,7,3,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" Margin="3,0"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="IconSlot" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Visibility" Value="Visible" TargetName="MenuHeld" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuArrow" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuArrow" />
                <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" TargetName="IconSlot" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuGlow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="MenuLineScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuGlow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetName="MenuLineScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="true" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
