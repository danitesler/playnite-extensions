<!--
    Overlay on Playnite Default/DefaultControls/Button.xaml.
    The client's panel button: a deep red face that darkens into its rim on every side, inside a 1px gray bezel
    inside a black line; gold label with a one pixel shadow. Hover lights the face and turns the label white
    (the button's highlight font), pressed pushes the face in and moves the label one pixel, disabled goes gray.
    Brushes: ButtonBackgroundBrush, ButtonHoverBackgroundBrush, ButtonPressedBackgroundBrush, ButtonBorderBrush,
    ButtonForegroundBrush, ButtonHoverForegroundBrush, BevelShadowBrush, TextShadowBrush.
    The disabled look replaces BaseStyle's dimming (Opacity back to 1): the gray face is the disabled look.
    SecondaryButton is the charcoal plate of the step arrows and dropdowns, used for icon buttons.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" /> <!-- fixed-width buttons (ThemeModifier icon buttons) keep their glyph unclipped; auto-width ones get the padding below -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <!-- black line outside the bezel -->
                        <Border Background="{DynamicResource BevelShadowBrush}" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Border" Margin="1" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}">
                            <Grid>
                                <!-- the face darkens into its rim on the left and right as well -->
                                <Rectangle x:Name="ShadeLeft" Width="6" HorizontalAlignment="Left" IsHitTestVisible="False"
                                           Fill="{DynamicResource TextShadowBrush}">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#B0000000" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Rectangle x:Name="ShadeRight" Width="6" HorizontalAlignment="Right" IsHitTestVisible="False"
                                           Fill="{DynamicResource TextShadowBrush}">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                            <GradientStop Color="#B0000000" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="0" Opacity="0.9" RenderingBias="Performance" />
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform" TargetName="Content">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ShadeLeft" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ShadeRight" />
                            <Setter Property="Effect" Value="{x:Null}" TargetName="Content" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <!-- ThemeModifier icon buttons: the plugin sets Width=41 on them (editor and constants tabs).
                 Render at 32x32 via uniform 32/41 layout scaling, including glyphs and decoration; auto-width buttons keep ButtonPadding. -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Width" Value="NaN">
                <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- SecondaryButton: More and Edit on the game page, and any other icon button. The charcoal plate of the
         client's step arrows: lit along the top, a gray rim inside a black line, gold glyph. Hover lightens the
         plate and whitens the glyph; pressed pushes it in. -->
    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Border Background="{DynamicResource BevelShadowBrush}" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Plate" Margin="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" />
                        <Rectangle x:Name="Lit" Height="1" Margin="3,2,3,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                   Fill="{DynamicResource BevelLightBrush}" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource SecondaryButtonHoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource SecondaryButtonPressedBackgroundBrush}" />
                            <Setter TargetName="Lit" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value><TranslateTransform X="1" Y="1" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
                            <Setter TargetName="Plate" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Lit" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
