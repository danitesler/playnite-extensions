<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is a client dropdown in the theme's three-line frame: the tooltip backdrop
    (PopupBackgroundBrush, near black with a violet cast) inside a black line, the metal line (FrameBrush) and a black
    line again, radius 5, with the warm title strip's sheen as a 3px band under the top edge. LocalMenuFrameTemplate is
    shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml. Nothing rises
    above the frame; rows start 7px below its top. Rows, highlight and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuFrameTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource FrameInnerBrush}" CornerRadius="5" />
            <Border Margin="1" Background="{DynamicResource FrameBrush}" CornerRadius="4" />
            <Border Margin="2" Background="{DynamicResource FrameInnerBrush}" CornerRadius="3" />
            <Border Margin="3" Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="2" />
            <!-- Title strip sheen under the top edge -->
            <Border Height="3" Margin="3,3,3,0" VerticalAlignment="Top" Background="{DynamicResource TopPanelBackgroundBrush}" Opacity="0.8"
                    CornerRadius="2,2,0,0" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuFrameTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="3,7,3,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="3,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
