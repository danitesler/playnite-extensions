<!--
    Questlog: TreeView (the Settings section list, the add-on tree, the filter trees), drawn as the category list of
    a client options panel. 30px rows in the body face.
      - Entries are gold at rest (GameFontNormal), no plate.
      - An entry that has children is a category header: white label on a sunken black band with a faint line above
        and a lit line below it.
      - Hover: a faint gold glow (ListItemHoverBrush), white label, the gold underline at 45 percent.
      - Selected: the gold glow, strongest in the middle and fading to both ends (ListItemSelectedBrush), closed by a
        bright gold hairline above and below it (SelectedBorderBrush, faded at the ends), white label.
    Children indent 14px with no guide line. Dialog trees get a fixed width (Settings 250, Add-ons 280) and a reserved
    scroll lane; the filter and explorer trees keep their host sizing. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
        <Style.Resources>
            <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
                <Setter Property="Tag" Value="QuestlogNavigationDivider" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </Style.Resources>
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer Focusable="False" Padding="0,6"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowSettings">
                <Setter Property="Width" Value="250" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowExtensions">
                <Setter Property="Width" Value="280" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Padding" Value="10,0,12,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Grid x:Name="SelectionBorder" Background="Transparent" MinHeight="30">
                            <!-- Category band (entries with children), hover glow, selected glow and the gold hairlines are
                                 separate layers so hover never looks selected. -->
                            <Grid x:Name="Band" Margin="0,1,0,1" Visibility="Collapsed" IsHitTestVisible="False">
                                <Border Background="{DynamicResource NormalBrushDark}" />
                                <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Opacity="0.3" />
                                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelLightBrush}" Opacity="0.75" />
                            </Grid>
                            <Border x:Name="HoverPlate" Margin="0,1,0,1" Background="{DynamicResource ListItemHoverBrush}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="SelectedPlate" Margin="0,1,0,1" Background="{DynamicResource ListItemSelectedBrush}" Opacity="0" IsHitTestVisible="False" />
                            <Rectangle x:Name="MarkerTop" Height="1" Margin="0,1,0,0" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"
                                       Fill="{DynamicResource SelectedBorderBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#B0000000" Offset="0.4" />
                                        <GradientStop Color="#00000000" Offset="0.95" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle x:Name="Marker" Height="1" Margin="0,0,0,1" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False"
                                       Fill="{DynamicResource SelectedBorderBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.4" />
                                        <GradientStop Color="#00000000" Offset="0.95" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <DockPanel Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                <ToggleButton x:Name="Expander" ClickMode="Press" DockPanel.Dock="Left" Width="14" Height="16" Margin="0,0,6,0"
                                              IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Style>
                                        <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseStyle}">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                        <Grid Background="Transparent">
                                                            <ContentControl x:Name="Collapsed" Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                            Foreground="{TemplateBinding Foreground}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <ContentControl x:Name="Expanded" Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                            Foreground="{TemplateBinding Foreground}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" TargetName="Expanded" />
                                                                <Setter Property="Visibility" Value="Collapsed" TargetName="Collapsed" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" DockPanel.Dock="Left" VerticalAlignment="Center" RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="190"
                                                       FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DockPanel>
                        </Grid>
                        <Border x:Name="ItemsHost" Margin="14,0,0,0">
                            <ItemsPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemsHost" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="Visibility" Value="Hidden" TargetName="Expander" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Band" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="SelectionBorder">
                            <Setter Property="Opacity" Value="1" TargetName="HoverPlate" />
                            <Setter Property="Opacity" Value="0.45" TargetName="Marker" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Opacity" Value="0" TargetName="HoverPlate" />
                            <Setter Property="Opacity" Value="1" TargetName="SelectedPlate" />
                            <Setter Property="Opacity" Value="1" TargetName="MarkerTop" />
                            <Setter Property="Opacity" Value="1" TargetName="Marker" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Expander" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- TreeView wraps Separator objects in TreeViewItem containers; suppress interaction on that container too. -->
            <DataTrigger Binding="{Binding Header.Tag, RelativeSource={RelativeSource Self}}" Value="QuestlogNavigationDivider">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="IsSelected" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                            <ContentPresenter ContentSource="Header" Margin="16,4,16,4" IsHitTestVisible="False" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
