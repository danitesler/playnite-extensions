<!--
    Overlay on Playnite Default/DefaultControls/TextBox.xaml.
    The client edit box: a near-black field with a single gray edge. Hover lightens the edge; keyboard focus turns it gold
    (IsKeyboardFocusWithin). BareTextBox is the chromeless text box for hosts that draw their own field.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LocalEditBoxFieldTemplate: the classic chat edit box's metal end caps. A 5px bevelled metal cap closes each end of
        the field (lit inner edge, dark outer edge) with a 2px gold stud in its middle. Hover: the studs brighten. Keyboard
        focus: the studs light full gold and a soft gold glow rises from the foot of the box (a 7px gradient, 0.2s), the
        way the active edit box lights. State is read from the nearest Control above; no desired size.
    -->
    <ControlTemplate x:Key="LocalEditBoxFieldTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle x:Name="Glow" Height="7" VerticalAlignment="Bottom" Margin="6,0,6,1" Fill="{DynamicResource FocusBrush}" Opacity="0">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Offset="0" Color="#55FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Border Width="5" HorizontalAlignment="Left" Margin="1" Background="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource TextBrushDarker}" Opacity="0.85" />
            <Border Width="5" HorizontalAlignment="Right" Margin="1" Background="{DynamicResource NormalBorderBrush}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource TextBrushDarker}" Opacity="0.85" />
            <Rectangle x:Name="StudL" Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2.5,0,0,0" Fill="{DynamicResource GlyphBrush}" Opacity="0.55" />
            <Rectangle x:Name="StudR" Width="2" Height="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2.5,0" Fill="{DynamicResource GlyphBrush}" Opacity="0.55" />
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <Setter TargetName="StudL" Property="Opacity" Value="0.85" />
                <Setter TargetName="StudR" Property="Opacity" Value="0.85" />
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="StudL" Property="Opacity" Value="1" />
                <Setter TargetName="StudR" Property="Opacity" Value="1" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="GlowIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="GlowIn" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource HighlightGlyphBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <Control x:Name="FieldOverlay" Template="{DynamicResource LocalEditBoxFieldTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Border" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless text box for hosts that draw their own chrome. -->
    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource HighlightGlyphBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost" Background="{TemplateBinding Background}"
                                  VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                  HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
