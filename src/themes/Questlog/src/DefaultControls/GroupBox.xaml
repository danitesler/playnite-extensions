<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml.
    An options block: a content-sized card on the sunken charcoal bed inside a hairline. The title is a category
    header, white on a black band closed by a lit line. No fixed widths and nothing wider than the content, so the
    Statistics sections stay compact cards. Spacing: GroupBoxPadding, GroupBoxHeaderPadding, GroupBoxHeaderFontSize.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Border Background="{DynamicResource NormalBrushDark}" CornerRadius="2,2,0,0" />
                                <Rectangle Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                           Fill="{DynamicResource BevelLightBrush}" Opacity="0.75" />
                                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="{DynamicResource GroupBoxHeaderFontSize}"
                                           Margin="{DynamicResource GroupBoxHeaderPadding}">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </TextBlock>
                            </Grid>
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                              Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
