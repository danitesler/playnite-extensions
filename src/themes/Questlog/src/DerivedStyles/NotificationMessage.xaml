<!--
    Overlay on Playnite Default/DerivedStyles/NotificationMessage.xaml.
    A message in the tracker column: dark glass in a bronze line that lights gold under the pointer, white text,
    the red close plate of the window buttons.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="NotificationMessage" TargetType="Button">
        <Setter Property="Command" Value="{Binding ActivateCommand}" />
        <Setter Property="Margin" Value="10,8,10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{DynamicResource ExpanderBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{DynamicResource WindowBarButton}" Content="r"
                                    VerticalAlignment="Top" Margin="4,6,6,0"
                                    Command="{Binding CloseCommand}" />
                            <TextBlock Text="{Binding Text}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Margin="8,6,0,6" TextWrapping="Wrap"
                                       MinHeight="38" DockPanel.Dock="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Frame" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
