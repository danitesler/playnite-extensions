<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml.
    The panel button (DefaultControls/Button.xaml) one step brighter, with larger text: the quest accept button.
    Client behaviour it follows (Gethe/wow-ui-source, classic_era): UIPanelButtonHighlightTexture is an ADD blended gold
    glow that lights the whole face under the pointer, the pressed face is UI-Panel-Button-Down with the text pushed one
    pixel, and the autocast shine (AutoCastTemplates.lua) runs 16 sparkles round the border of a button.
    Hover, animated both ways (nothing on the animated parts is set by a trigger, so nothing snaps):
      in  0.2s ease-out: the hovered leather (PrimaryButtonHoverBackgroundBrush) fades over the face, the gold wash
          (HoverBrush) and the inner glow (slot-glow.png, the additive highlight) light the face, a soft bloom
          (GlowFrameTemplate at -32) rises, and the sparkles (shine-h.png / shine-v.png) fade in and run clockwise
          round the border while the pointer stays: one 96px tile per loop, 2.6 to 3.6s a side.
      out 0.3s ease-in-out: everything fades back; the endless runs are replaced by short glides and every exit
          animation has FillBehavior Stop, so no clock outlives the fade.
    Pressed fades in the dark Down leather (its own layer, so leaving while pressed strands nothing) and pushes the text
    1px. Brushes only (PrimaryButton*, ButtonPressedBackgroundBrush, HoverBrush, GlyphBrush); no DropShadowEffect on
    the plate (the text keeps the 1px ink shadow of every button), no BitmapCache, no OpacityMask on anything behind.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Control x:Name="Bloom" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource GlyphBrush}"
                                 Margin="-32" Opacity="0" Visibility="Hidden" IsHitTestVisible="False" />
                        <Border x:Name="Plate" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="HoverPlate" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Margin="1"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="Wash" Background="{DynamicResource HoverBrush}" Margin="1"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                        <Rectangle x:Name="Hilite" Fill="{DynamicResource GlyphBrush}" Margin="1" Opacity="0" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/slot-glow.png'}" Stretch="Fill" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Border x:Name="PressPlate" Background="{DynamicResource ButtonPressedBackgroundBrush}" Margin="1"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="0" Opacity="0.9" RenderingBias="Performance" />
                            </ContentPresenter.Effect>
                        </ContentPresenter>

                        <!-- Autocast shine: four edge strips, each a 96px sparkle tile on a wide rectangle in a Canvas
                             (no layout clip) inside a clipped band, moved one tile per loop. Clockwise: top runs right,
                             right runs down, bottom runs left, left runs up. -->
                        <Grid x:Name="Shine" Margin="-5" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                            <Grid Height="12" VerticalAlignment="Top" ClipToBounds="True">
                                <Canvas>
                                    <Rectangle Width="720" Height="12" Fill="{DynamicResource GlyphBrush}">
                                        <Rectangle.RenderTransform><TranslateTransform x:Name="ShineTop" X="-96" /></Rectangle.RenderTransform>
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{ThemeFile 'Images/fx/shine-h.png'}" TileMode="Tile" Stretch="Fill" Viewport="0,0,96,12" ViewportUnits="Absolute" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Canvas>
                            </Grid>
                            <Grid Height="12" VerticalAlignment="Bottom" ClipToBounds="True">
                                <Canvas>
                                    <Rectangle Width="720" Height="12" Fill="{DynamicResource GlyphBrush}">
                                        <Rectangle.RenderTransform><TranslateTransform x:Name="ShineBottom" X="0" /></Rectangle.RenderTransform>
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{ThemeFile 'Images/fx/shine-h.png'}" TileMode="Tile" Stretch="Fill" Viewport="40,0,96,12" ViewportUnits="Absolute" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Canvas>
                            </Grid>
                            <Grid Width="12" HorizontalAlignment="Left" ClipToBounds="True">
                                <Canvas>
                                    <Rectangle Width="12" Height="480" Fill="{DynamicResource GlyphBrush}">
                                        <Rectangle.RenderTransform><TranslateTransform x:Name="ShineLeft" Y="0" /></Rectangle.RenderTransform>
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{ThemeFile 'Images/fx/shine-v.png'}" TileMode="Tile" Stretch="Fill" Viewport="0,20,12,96" ViewportUnits="Absolute" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Canvas>
                            </Grid>
                            <Grid Width="12" HorizontalAlignment="Right" ClipToBounds="True">
                                <Canvas>
                                    <Rectangle Width="12" Height="480" Fill="{DynamicResource GlyphBrush}">
                                        <Rectangle.RenderTransform><TranslateTransform x:Name="ShineRight" Y="-96" /></Rectangle.RenderTransform>
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{ThemeFile 'Images/fx/shine-v.png'}" TileMode="Tile" Stretch="Fill" Viewport="0,60,12,96" ViewportUnits="Absolute" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Hilite" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Shine" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="ShineTop" Storyboard.TargetProperty="X" From="-96" To="0" Duration="0:0:2.6" />
                                        <DoubleAnimation Storyboard.TargetName="ShineRight" Storyboard.TargetProperty="Y" From="-96" To="0" Duration="0:0:3.4" />
                                        <DoubleAnimation Storyboard.TargetName="ShineBottom" Storyboard.TargetProperty="X" From="0" To="-96" Duration="0:0:2.8" />
                                        <DoubleAnimation Storyboard.TargetName="ShineLeft" Storyboard.TargetProperty="Y" From="0" To="-96" Duration="0:0:3.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Hilite" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Shine" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <!-- Replace the endless runs with short glides (default SnapshotAndReplace). -->
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShineTop" Storyboard.TargetProperty="X" By="24" Duration="0:0:0.3" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShineRight" Storyboard.TargetProperty="Y" By="24" Duration="0:0:0.3" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShineBottom" Storyboard.TargetProperty="X" By="-24" Duration="0:0:0.3" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShineLeft" Storyboard.TargetProperty="Y" By="-24" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value><TranslateTransform X="1" Y="1" /></Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource NormalBrush}" />
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                            <Setter TargetName="Content" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
