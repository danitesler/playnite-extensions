<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml.
    The big panel button of the login and character screens (Login, Accept, Enter World): the brighter red face
    (PrimaryButtonBackgroundBrush) darkening into its rim, in the gray bezel inside a black line, with a gold label
    in the body face one size up and a one pixel shadow.
    Hover: the lit face fades in over 0.15s, a soft gold bloom (GlowFrameTemplate in PrimaryButtonGlowBrush) rises
    round the button and the label turns white, the client's highlight font; both fade back over 0.3s. Pressed: the
    pushed-in face on its own layer and the label moved 1px. Brushes only, so ThemeModifier recolors every layer.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages (Playnite shows RUNNING or
        LAUNCHING there). A channeling bar along the plate's foot: channel green in a black slot with a metal edge and a white
        spark. While running it ebbs and refills (3.2s); while launching it is a cast, filling from empty in 0.8s.
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching). Never hit-testable.
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.12" />
                        <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.3">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.9" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                    <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border Height="5" Margin="8,0,8,2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" CornerRadius="1"
                                Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1">
                            <Grid Margin="1" RenderTransformOrigin="0,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="RunningCast" ScaleX="1" />
                                </Grid.RenderTransform>
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" />
                                <Rectangle Width="3" HorizontalAlignment="Right" Fill="{DynamicResource TextBrush}" Opacity="0.75" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.55,0 0.9,0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0" KeySpline="0.55,0 0.9,0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.002" KeySpline="0.55,0 0.9,0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.002" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningCast" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.55,0 0.9,0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningCast" Storyboard.TargetProperty="ScaleX" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Control x:Name="Bloom" Margin="-32" Opacity="0" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                 Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                 Template="{DynamicResource GlowFrameTemplate}" />
                        <Border Background="{DynamicResource BevelShadowBrush}" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Plate" Margin="1" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" /><Border x:Name="RunningBreath" Margin="1" Background="{DynamicResource ShellBackgroundBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="RunningScan" Margin="1" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0.5" IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.9" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningHoverDim" Margin="1" Background="{DynamicResource ShellBackgroundBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="HoverPlate" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Margin="2"
                                CornerRadius="1" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="PressPlate" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Margin="2"
                                CornerRadius="1" Opacity="0" IsHitTestVisible="False" />
                        <!-- the face darkens into its rim on the left and right -->
                        <Rectangle Width="8" Margin="2,2,0,2" HorizontalAlignment="Left" IsHitTestVisible="False"
                                   Fill="{DynamicResource TextShadowBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#B0000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle Width="8" Margin="0,2,2,2" HorizontalAlignment="Right" IsHitTestVisible="False"
                                   Fill="{DynamicResource TextShadowBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                    <GradientStop Color="#B0000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <ContentPresenter x:Name="PlayContent" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="0" Opacity="0.9" RenderingBias="Performance" />
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter Property="Opacity" Value="0.08" TargetName="RunningBreath" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.55,0 0.9,0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0" KeySpline="0.55,0 0.9,0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.002" KeySpline="0.55,0 0.9,0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.002" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.05" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.14" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.05" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" From="0" To="0.18" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PlayContent" Property="RenderTransform">
                                <Setter.Value><TranslateTransform X="1" Y="1" /></Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Plate" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
        
            <!-- LAUNCHING and RUNNING come last, so the plate stays the running colour under the pointer. -->
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
