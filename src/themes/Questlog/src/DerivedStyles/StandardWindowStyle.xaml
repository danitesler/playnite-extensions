<!--
    Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml (dialogs).
    A client frame: the thin metal line (FrameBrush) between two black lines, and a 36px title strip across the top
    (WindowTitleBackgroundBrush, the warm dark bar) closed by a black, a metal and a black line. The title sits in
    the middle of the strip in gold, in the body face, between two gold diamonds with a short fading rule each:
    the signature graphic, drawn from vectors in theme brushes. The caption buttons are the red plates of
    WindowBarButton. PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource FrameThickness}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="36" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource FrameInnerBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Border BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1">
                                <Border BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid VerticalAlignment="Top" Height="36" ClipToBounds="True">
                                            <Border Background="{DynamicResource WindowTitleBackgroundBrush}" IsHitTestVisible="False" />
                                            <!-- Closing rule: black, metal, black. -->
                                            <Rectangle Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{DynamicResource FrameInnerBrush}" />
                                            <Rectangle Height="1" Margin="0,0,0,1" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{DynamicResource FrameBrush}" />
                                            <!-- Title between two diamonds, each with a rule fading away from it. -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3"
                                                        IsHitTestVisible="False">
                                                <Rectangle Width="32" Height="1" VerticalAlignment="Center" Fill="{DynamicResource SelectedBorderBrush}">
                                                    <Rectangle.OpacityMask>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#00000000" Offset="0" />
                                                            <GradientStop Color="#C0000000" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                                <Path Data="M4,0 L8,4 4,8 0,4 Z" Width="8" Height="8" Margin="5,0,10,0" VerticalAlignment="Center"
                                                      Fill="{DynamicResource WindowTitleForegroundBrush}" />
                                                <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                           Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                                <Path Data="M4,0 L8,4 4,8 0,4 Z" Width="8" Height="8" Margin="10,0,5,0" VerticalAlignment="Center"
                                                      Fill="{DynamicResource WindowTitleForegroundBrush}" />
                                                <Rectangle Width="32" Height="1" VerticalAlignment="Center" Fill="{DynamicResource SelectedBorderBrush}">
                                                    <Rectangle.OpacityMask>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#C0000000" Offset="0" />
                                                            <GradientStop Color="#00000000" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,5,6,0">
                                                <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                                <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                                <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                            </StackPanel>
                                        </Grid>
                                        <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                        <ContentPresenter Margin="0,36,0,0" />
                                    </Grid>
                                </Border>
                            </Border>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the strip shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
