<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    Component sizes come from the client's own templates (UIPanelButtonTemplate 21px, InputBoxTemplate 20px,
    UIDropDownMenuTemplate, GameTooltip insets of 5px), scaled up a step for a desktop window.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Popups: the tooltip backdrop (near black, a violet cast) inside a single metal line. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: a thin gold line just inside the control edge. WPF shows FocusVisualStyle for the keyboard only. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="1" Margin="3" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource CornerRadiusSmall}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: the ring goes around the box, outside its edge. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="1" Margin="-3" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource CornerRadiusSmall}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing, keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">14,5,14,5</Thickness> <!-- UIPanelButtonTemplate: 21px face, text 14px in from the caps (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">8,5,8,5</Thickness> <!-- InputBoxTemplate: 20px field, text 8px in (height now set by ControlHeight) -->
    <Thickness x:Key="MenuPadding">5</Thickness> <!-- Tooltip and dropdown backdrops inset their content by 5px -->
    <Thickness x:Key="MenuItemPadding">10,4,10,4</Thickness> <!-- UIDropDownMenuButton: 16px rows, text 10px in -->
    <Thickness x:Key="ComboBoxDropDownPadding">5</Thickness> <!-- Dropdown list backdrop inset -->
    <Thickness x:Key="ComboBoxItemPadding">8,4,8,4</Thickness> <!-- Dropdown list rows -->
    <Thickness x:Key="ListBoxItemPadding">8,4,8,4</Thickness> <!-- Quest log rows: 16px tall at 1024 -->
    <Thickness x:Key="GroupBoxPadding">12</Thickness> <!-- Options frame inner margin -->
    <Thickness x:Key="GroupBoxHeaderPadding">12,5,12,6</Thickness> <!-- The title band of an options frame -->
    <sys:Double x:Key="GroupBoxHeaderFontSize">15</sys:Double> <!-- A category header: the body size, white on the band -->
    <Thickness x:Key="TooltipPadding">10,8,10,8</Thickness> <!-- GameTooltip: 5px backdrop inset plus 5px of air -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">20</sys:Double> <!-- Micro menu buttons carry 20px glyphs -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, so the real carousel replaces it without the page jumping. Each Viewbox scales a fixed 1600px
         layout to the width its column gives it (height is unbounded in a vertical stack). The tiles are the host's
         Foreground at low opacity; the whole thing pulses while visible. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the plugin's ContentControl, visible while that control has no height. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="16"
                        Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- GlowFrameTemplate: a soft gold bloom round a plate (glow-frame.png, 96px, 32px corners), drawn in the host's Foreground, no desired size. The host sits at -32 around the plate. Used by the Play bloom and the hovered cover. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,0,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="32,0,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="64,0,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,32,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="32,32,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="64,32,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,64,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="32,64,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="64,64,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- menu-mark begin LocalQuestlogMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a quest scroll, two rollers around a parchment with text lines. Hover (IsMouseOver): the scroll unfurls (the lower roller drops 3px, the parchment grows 1.375 and a third line appears, BackEase 0.22s). Open (ContextMenu.IsOpen of the nearest Border): the scroll dims to 22 percent and a gold quest exclamation mark pops in and bobs 2px (0.5s, auto-reversed) until the menu closes; exits restore every property. -->
    <ControlTemplate x:Key="LocalQuestlogMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Canvas x:Name="Scroll" Width="18" Height="18" Opacity="1">
                    <Rectangle Canvas.Left="2" Canvas.Top="1.5" Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{TemplateBinding Foreground}" />
                    <Rectangle x:Name="Body" Canvas.Left="4" Canvas.Top="4" Width="10" Height="8" RenderTransformOrigin="0.5,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2">
                        <Rectangle.RenderTransform><ScaleTransform x:Name="BodyS" ScaleX="1" ScaleY="1" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Canvas.Left="6" Canvas.Top="6.5" Width="6" Height="1" Fill="{TemplateBinding Foreground}" Opacity="0.7" />
                    <Rectangle Canvas.Left="6" Canvas.Top="9" Width="4" Height="1" Fill="{TemplateBinding Foreground}" Opacity="0.7" />
                    <Rectangle x:Name="Line3" Canvas.Left="6" Canvas.Top="11.5" Width="5" Height="1" Fill="{TemplateBinding Foreground}" Opacity="0" />
                    <Rectangle x:Name="Roll" Canvas.Left="2" Canvas.Top="11.5" Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{TemplateBinding Foreground}">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="RollT" X="0" Y="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
                <Canvas x:Name="Excl" Width="18" Height="18" RenderTransformOrigin="0.5,0.5" Opacity="0">
                    <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="ExclS" ScaleX="0.2" ScaleY="0.2" /><TranslateTransform x:Name="ExclT" X="0" Y="0" /></TransformGroup></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="7.7" Canvas.Top="2.5" Width="2.6" Height="8" RadiusX="1.3" RadiusY="1.3" Fill="{DynamicResource GlyphBrush}" />
                    <Ellipse Canvas.Left="7.5" Canvas.Top="12.5" Width="3" Height="3" Fill="{DynamicResource GlyphBrush}" />
                </Canvas>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="BodyS" Storyboard.TargetProperty="ScaleY" To="1.375" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RollT" Storyboard.TargetProperty="Y" To="3" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Line3" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.200" BeginTime="0:0:0.100"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BodyS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RollT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Line3" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.160" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Scroll" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ExclS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.250"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ExclS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.250"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Excl" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.150"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ExclT" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.500" BeginTime="0:0:0.250" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Scroll" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ExclS" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.200" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ExclS" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.200" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Excl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.120" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ExclT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.400" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalQuestlogMenuMarkTemplate -->
</ResourceDictionary>
