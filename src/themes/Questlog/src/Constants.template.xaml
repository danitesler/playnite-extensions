<!--
    Questlog: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    The tokens keep the names of what they were measured from (frame metal, charcoal panels, plates, the red panel
    button, the gold selection glow); here each placeholder names the token that plays the key's role.
    1. Playnite's palette keys: every view and control the theme does not restyle reads them, and ThemeModifier edits
       them. Gold (GameFontNormal) is the accent, white (GameFontHighlight) the text, the tooltip backdrop the popup.
    2. Shared keys. Gradients are used where the art is a gradient (button faces, plates, the title strip, knobs,
       the selection glow); they stay plain LinearGradientBrush entries, with no brush pointing at another brush.
    Theme XAML reads brushes only, never Color keys.

    Placeholder syntax: docs/themes/reference.md. Keep double braces out of comments here: the build renders
    them too.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): the client sets its UI at 13px and its large headings at 16 and 20. -->
    <sys:Double x:Key="FontSizeSmall">13</sys:Double>
    <sys:Double x:Key="FontSize">15</sys:Double>
    <sys:Double x:Key="FontSizeLarge">17</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">31</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:FONT_FAMILY|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:FONT_FAMILY_MONO|Consolas}}</FontFamily>
    <!-- Game title and panel headings use a readable serif with broad character support. -->
    <FontFamily x:Key="HeadingFontFamily">Georgia, Palatino Linotype, Segoe UI</FontFamily>

    <!-- Shape (Playnite keys) -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:RADIUS_MEDIUM}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">6</Thickness>

    <!-- Radius scale (shared) and the frame line width -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:RADIUS_SMALL}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:RADIUS_LARGE}}</CornerRadius>
    <Thickness x:Key="FrameThickness">{{px:FRAME_WIDTH}}</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{HIGHLIGHT_FONT_COLOR}}</Color>                  <!-- values and body text: GameFontHighlight -->
    <Color x:Key="TextColorDarker">{{POOR_GRAY_COLOR}}</Color>                 <!-- secondary text: poor quality gray -->
    <Color x:Key="TextColorDark">{{QUEST_FONT_COLOR}}</Color>                  <!-- ink on gold and paper fills -->
    <Color x:Key="MainColor">{{PLATE}}</Color>                                 <!-- control surface: the charcoal plate -->
    <Color x:Key="MainColorDark">{{PANEL_BAND}}</Color>                        <!-- darker surface: sunken bands -->
    <Color x:Key="HoverColor">{{NORMAL_FONT_COLOR/14}}</Color>                 <!-- the gold mouse highlight -->
    <Color x:Key="GlyphColor">{{NORMAL_FONT_COLOR}}</Color>                    <!-- accent: GameFontNormal gold -->
    <Color x:Key="HighlightGlyphColor">{{NORMAL_FONT_COLOR/60}}</Color>
    <Color x:Key="PopupBackgroundColor">{{TOOLTIP_BACKDROP}}</Color>           <!-- menus, dropdowns, tooltips -->
    <Color x:Key="PopupBorderColor">{{TOOLTIP_BORDER}}</Color>
    <Color x:Key="BackgroundToneColor">{{PANEL_BG}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{SLOT_FILL}}</Color>               <!-- the dark bed behind covers and icon slots -->
    <Color x:Key="PanelSeparatorColor">{{PANEL_RULE}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{PANEL_RULE}}</Color>
    <Color x:Key="DataChangeNotifColor">{{NEW_FLAG_COLOR}}</Color>             <!-- the blue of the NEW flag: reads against gold glyphs -->

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{FIELD_BORDER}}" />               <!-- control edge: the gray line of an edit box -->
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{TOOLTIP_BACKDROP}}" />
    <LinearGradientBrush x:Key="ButtonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">      <!-- the panel button face: red, darkening into its rim top and bottom -->
        <GradientStop Color="{{BUTTON_RED_RIM}}" Offset="0" />
        <GradientStop Color="{{BUTTON_RED_DEEP}}" Offset="0.1" />
        <GradientStop Color="{{BUTTON_RED}}" Offset="0.3" />
        <GradientStop Color="{{BUTTON_RED}}" Offset="0.62" />
        <GradientStop Color="{{BUTTON_RED_DEEP}}" Offset="0.86" />
        <GradientStop Color="{{BUTTON_RED_SHADE}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{CHECK_BED}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{UNCOMMON_GREEN_COLOR}}" />    <!-- green item quality -->
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{RED_FONT_COLOR}}" />          <!-- GameFontRed -->
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{NORMAL_FONT_COLOR}}" />          <!-- yellow: the even-level quest color -->

    <SolidColorBrush x:Key="WarningBrush" Color="{{RED_FONT_COLOR}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{PANEL_BAND/55}}" />       <!-- group boxes and cards: a sunken charcoal bed -->
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{PANEL_BG}}" />              <!-- the panel body -->

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell: the rail is a sunken band, the top bar the warm title strip of a frame, the library the deep panel -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{PANEL_BAND}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the theme's
         own ShellBackground color, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{PANEL_BAND}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{PANEL_BG_DEEP}}" />
    <LinearGradientBrush x:Key="TopPanelBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{TITLE_BAR_EDGE}}" Offset="0" />
        <GradientStop Color="{{TITLE_BAR}}" Offset="0.5" />
        <GradientStop Color="{{TITLE_BAR_SHADE}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{FRAME_METAL}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{FIELD_BACKGROUND}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{NORMAL_FONT_COLOR}}" />
    <LinearGradientBrush x:Key="WindowTitleBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{TITLE_BAR_EDGE}}" Offset="0" />
        <GradientStop Color="{{TITLE_BAR}}" Offset="0.5" />
        <GradientStop Color="{{TITLE_BAR_SHADE}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{NORMAL_FONT_COLOR}}" />

    <!-- States: the gold glow under the current entry is strongest in the middle and fades toward both ends -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{NORMAL_FONT_COLOR/22}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{SELECT_LINE}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{HIGHLIGHT_FONT_COLOR}}" />
    <LinearGradientBrush x:Key="ListItemHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{{NORMAL_FONT_COLOR/3}}" Offset="0" />
        <GradientStop Color="{{NORMAL_FONT_COLOR/11}}" Offset="0.45" />
        <GradientStop Color="{{NORMAL_FONT_COLOR/0}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ListItemSelectedBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{{NORMAL_FONT_COLOR/6}}" Offset="0" />
        <GradientStop Color="{{NORMAL_FONT_COLOR/24}}" Offset="0.45" />
        <GradientStop Color="{{NORMAL_FONT_COLOR/2}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenuItemHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{{NORMAL_FONT_COLOR/10}}" Offset="0" />
        <GradientStop Color="{{NORMAL_FONT_COLOR/26}}" Offset="0.45" />
        <GradientStop Color="{{NORMAL_FONT_COLOR/6}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FocusBrush" Color="{{NORMAL_FONT_COLOR}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{NORMAL_FONT_COLOR/35}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{BUTTON_RED_HOVER}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{HIGHLIGHT_FONT_COLOR}}" />

    <!-- Buttons: the red face sits in a gray bezel inside a black line; gold text -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{NORMAL_FONT_COLOR}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{HIGHLIGHT_FONT_COLOR}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{BUTTON_BEZEL}}" />
    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush" StartPoint="0,0" EndPoint="0,1">      <!-- the face lit under the pointer -->
        <GradientStop Color="{{BUTTON_RED_SHADE}}" Offset="0" />
        <GradientStop Color="{{BUTTON_RED}}" Offset="0.1" />
        <GradientStop Color="{{BUTTON_RED_HOVER}}" Offset="0.36" />
        <GradientStop Color="{{BUTTON_RED_LIT}}" Offset="0.66" />
        <GradientStop Color="{{BUTTON_RED_DEEP}}" Offset="0.9" />
        <GradientStop Color="{{BUTTON_RED_SHADE}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonPressedBackgroundBrush" StartPoint="0,0" EndPoint="0,1">    <!-- pushed in: dark at the top -->
        <GradientStop Color="{{BUTTON_RED_RIM}}" Offset="0" />
        <GradientStop Color="{{BUTTON_RED_SHADE}}" Offset="0.22" />
        <GradientStop Color="{{BUTTON_RED_DEEP}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">    <!-- Play: the brighter face of the login and accept buttons -->
        <GradientStop Color="{{BUTTON_RED_SHADE}}" Offset="0" />
        <GradientStop Color="{{BUTTON_RED}}" Offset="0.1" />
        <GradientStop Color="{{BUTTON_RED_LIT}}" Offset="0.32" />
        <GradientStop Color="{{BUTTON_RED_LIT}}" Offset="0.62" />
        <GradientStop Color="{{BUTTON_RED_DEEP}}" Offset="0.88" />
        <GradientStop Color="{{BUTTON_RED_SHADE}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonHoverBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{BUTTON_RED_DEEP}}" Offset="0" />
        <GradientStop Color="{{BUTTON_RED_LIT}}" Offset="0.1" />
        <GradientStop Color="{{BUTTON_RED_HOVER}}" Offset="0.36" />
        <GradientStop Color="{{BUTTON_RED_HOVER}}" Offset="0.6" />
        <GradientStop Color="{{BUTTON_RED}}" Offset="0.9" />
        <GradientStop Color="{{BUTTON_RED_SHADE}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonPressedBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{BUTTON_RED_RIM}}" Offset="0" />
        <GradientStop Color="{{BUTTON_RED_SHADE}}" Offset="0.22" />
        <GradientStop Color="{{BUTTON_RED_DEEP}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{BUTTON_BEZEL}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{NORMAL_FONT_COLOR}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{NORMAL_FONT_COLOR}}" />

    <!-- Plates (More, Edit, dropdowns, step arrows, top bar and rail buttons): charcoal, lit along the top -->
    <LinearGradientBrush x:Key="SecondaryButtonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{PLATE_TOP}}" Offset="0" />
        <GradientStop Color="{{PLATE}}" Offset="0.5" />
        <GradientStop Color="{{PLATE_BOTTOM}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{PLATE_RIM}}" />
    <LinearGradientBrush x:Key="SecondaryButtonHoverBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{PLATE_HOVER_TOP}}" Offset="0" />
        <GradientStop Color="{{PLATE_HOVER}}" Offset="0.5" />
        <GradientStop Color="{{PLATE_HOVER_BOTTOM}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SecondaryButtonPressedBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{PLATE_EDGE}}" Offset="0" />
        <GradientStop Color="{{PLATE_BOTTOM}}" Offset="0.3" />
        <GradientStop Color="{{PLATE}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{PANEL_BAND}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{PLATE_HIGHLIGHT}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{PLATE_EDGE}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{QUEST_FONT_COLOR}}" />

    <!-- Inputs: near-black field, gray edge -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{FIELD_BACKGROUND}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{FIELD_BORDER}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{FIELD_BORDER_HOVER}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{CHECK_EDGE}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{CHECK_EDGE_HOVER}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{SLIDER_GROOVE}}" />
    <LinearGradientBrush x:Key="SliderThumbBackgroundBrush" StartPoint="0,0" EndPoint="0,1">     <!-- the gray gem that rides the groove -->
        <GradientStop Color="{{KNOB_LIGHT}}" Offset="0" />
        <GradientStop Color="{{KNOB}}" Offset="0.3" />
        <GradientStop Color="{{KNOB_DARK}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{NORMAL_FONT_COLOR}}" />
    <LinearGradientBrush x:Key="ProgressBarForegroundBrush" StartPoint="0,0" EndPoint="0,1">     <!-- the casting bar -->
        <GradientStop Color="{{CASTING_BAR_HIGHLIGHT}}" Offset="0" />
        <GradientStop Color="{{CASTING_BAR_COLOR}}" Offset="0.45" />
        <GradientStop Color="{{CASTING_BAR_SHADOW}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{FIELD_BACKGROUND}}" />
    <LinearGradientBrush x:Key="ScrollBarThumbBrush" StartPoint="0,0" EndPoint="1,0">            <!-- the scroll knob: warm gray, lit on one side -->
        <GradientStop Color="{{SCROLL_KNOB_LIGHT}}" Offset="0" />
        <GradientStop Color="{{SCROLL_KNOB}}" Offset="0.22" />
        <GradientStop Color="{{SCROLL_KNOB_DARK}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{SCROLL_KNOB_HOVER}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{PANEL_BAND/45}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{SCROLL_KNOB}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{SCROLL_KNOB_LIGHT}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{SELECT_LINE}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{PLATE_HOVER}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{NORMAL_FONT_COLOR/20}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{NORMAL_FONT_COLOR}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{HIGHLIGHT_FONT_COLOR}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{SELECT_LINE}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{PANEL_BAND}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{SLOT_FILL}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{PANEL_RULE_BRIGHT}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{TOOLTIP_BORDER_SHADE}}" />

    <!-- Frames: the metal line round windows and panels, the black line inside it, the bevel of slots and bands -->
    <LinearGradientBrush x:Key="FrameBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{{FRAME_METAL_LIGHT}}" Offset="0" />
        <GradientStop Color="{{FRAME_METAL}}" Offset="0.5" />
        <GradientStop Color="{{FRAME_METAL_LIGHT}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{FRAME_INK}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{FRAME_METAL_DARK}}" />
    <LinearGradientBrush x:Key="SlotBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{{SLOT_EDGE_LIGHT}}" Offset="0" />
        <GradientStop Color="{{SLOT_EDGE}}" Offset="0.5" />
        <GradientStop Color="{{SLOT_EDGE_DARK}}" Offset="1" />
    </LinearGradientBrush>

    <!-- Paper: the notes block reads as a letter -->
    <LinearGradientBrush x:Key="ParchmentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{PARCHMENT_HIGHLIGHT}}" Offset="0" />
        <GradientStop Color="{{PARCHMENT}}" Offset="0.55" />
        <GradientStop Color="{{PARCHMENT_SHADE}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{PARCHMENT_EDGE}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{ITEM_TEXT_FONT_COLOR}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{QUEST_FONT_COLOR}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{QUEST_SMALL_FONT_COLOR}}" />

    <!-- Running game: GREEN_FONT_COLOR, the channel green of the casting bar; gold is selection and labels, blue the filter mark, the cast amber the progress bar. -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{RUNNING_GOLD_COLOR}}" />
</ResourceDictionary>
