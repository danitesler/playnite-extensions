<!--
    Overlay on Playnite Default/Views/TopPanel.xaml.
    The top bar is the title strip of a client frame: a 48px warm dark band (TopPanelBackgroundBrush) closed by a
    black, a metal and a black line. The search is an edit box with a magnifier; Playnite's view controls, the
    filter and notification toggles are gold glyphs that take a charcoal plate under the pointer and a gold-lined
    black slot while on (CustomControls/TopPanelItem.xaml). Notifications are a letter with a red count, the way the
    client shows new mail. The global progress bar is the casting bar. The right 116px stay clear for the window
    buttons. TopPanelMenu, the toggles and the icon templates keep Playnite's keys. All PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" TextElement.Foreground="{DynamicResource MixedRatingBrush}" Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <!-- Looked up from code for the main menu; the dropdown list of DefaultControls/ContextMenu.xaml. -->
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <!-- The filter glyph: a gold-lined black slot while the panel is open. -->
    <!-- Filter active: a small diamond in the notification accent (DataChangeNotifBrush) on the icon's top-right corner, no text. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusSmall}" Padding="4,0,4,0" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Content="{DynamicResource IconFilter}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <Path x:Name="TextFilter" Visibility="Collapsed" IsHitTestVisible="False" Margin="-5,-16,-4,0" VerticalAlignment="Center" Width="9" Height="9" Stretch="Fill" Data="M5,0 L10,5 5,10 0,5 Z" Fill="{DynamicResource DataChangeNotifBrush}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ToggleButtonCheckedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A letter and the red count of new mail; hidden when there is nothing to read. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusSmall}" SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Content="{DynamicResource IconNotifications}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <Border MinWidth="16" Height="16" Margin="0,-9,-9,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource DangerBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{DynamicResource CornerRadiusLarge}">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource DangerForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,3,0" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ToggleButtonCheckedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The top bar search: the SearchBox of CustomControls/SearchBox.xaml on the field fill of the shell. -->
    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Width" Value="280" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Grid Height="48">
                        <Border Background="{DynamicResource TopPanelBackgroundBrush}" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <!-- Closing rule: black, metal, black. -->
                        <Rectangle Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{DynamicResource FrameInnerBrush}" />
                        <Rectangle Height="1" Margin="0,0,0,1" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{DynamicResource TopPanelSeparatorBrush}" />
                        <DockPanel Margin="0,0,116,3">
                            <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource MainMenuButton}"
                                    DockPanel.Dock="Left" Margin="6,0,4,0" VerticalAlignment="Center">
                                <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch" Style="{StaticResource TopPanelSearchBox}"
                                       Margin="10,0,6,0"
                                       WindowChrome.IsHitTestVisibleInChrome="True" DockPanel.Dock="Left" HorizontalAlignment="Left" />

                            <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}"
                                      DockPanel.Dock="Left" />

                            <!-- Keep sorting first even though Playnite inserts it after view settings and grouping. -->
                            <Grid x:Name="PART_PanelMainItems" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="{x:Type TopPanelItem}" BasedOn="{StaticResource {x:Type TopPanelItem}}">
                                        <Style.Triggers>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSortSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="0" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSearchButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="1" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGeneralViewSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="2" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelFilterPresetsSelectionTemplate}">
                                                <Setter Property="Grid.Column" Value="3" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGroupSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="4" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchDetailsViewTemplate}">
                                                <Setter Property="Grid.Column" Value="6" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchGridViewTemplate}">
                                                <Setter Property="Grid.Column" Value="7" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchListViewTemplate}">
                                                <Setter Property="Grid.Column" Value="8" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelUpdateButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="9" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="10" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelViewSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="11" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelExplorerSwitchTemplate}">
                                                <Setter Property="Grid.Column" Value="12" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Grid.Column" Value="5" />
                                    </Style>
                                </Grid.Resources>
                            </Grid>







                            <CheckBox x:Name="PART_ToggleNotifications"
                                      Style="{DynamicResource TopPanelNotificationsToggle}"
                                      DockPanel.Dock="Left" />

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="14,0,14,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <Grid VerticalAlignment="Center" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="600" MinWidth="60" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <ProgressBar Name="PART_ProgressGlobal" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Name="PART_TextProgressText"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Style="{DynamicResource BaseTextBlockStyle}" Margin="5,0,5,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect ShadowDepth="1" BlurRadius="0" Opacity="0.9" RenderingBias="Performance" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>

                                <Button Name="PART_ButtonProgressCancel" Grid.Column="1"
                                        Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Margin="6,0,0,0" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
