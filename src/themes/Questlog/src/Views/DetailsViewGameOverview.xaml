<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml: the game details as a quest log page.
    Playnite's arrangement is kept (background art as a banner at the top, GameBannerHeight, the cover and title over it, the action buttons, the
    quest text on the left, the property list on the right); every PART_ name is Playnite's.
      - The title is set the way the client sets a zone name: gold, large, with a one pixel shadow. The cover and the
        icon sit in item slots (bevelled bronze edge in a black line, on the dark bed behind icons).
      - The property list is an item tooltip: the tooltip navy inside its light 2px edge, labels in gold
        (GameFontNormal), values in white, links white until the pointer turns them gold, scores in the item quality
        colors (green, gold, red). Every metadata field Playnite can show is in it, in six groups split by space
        (a group goes away with its last visible field); tags are small item slots.
      - The description and the notes are the quest text: ink (ParchmentTextBrush) on a paper page with a tooth
        (Images/parchment.png) and darkened rim, inside the gold and bronze frame. The description is drawn by
        DescriptionView.html, which uses the same inks.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1280"
                                  d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid>
<!-- Banner: the game's background art as a band at the top. Tinted at the top, darkened toward the title by a page-colored scrim, faded into the page. GameBannerHeight sets the height; 0 turns it off. -->
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
    <Grid.Style>
        <Style TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Grid.Style>
    <Grid.CacheMode>
        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
    </Grid.CacheMode>
    <Grid.OpacityMask>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#A6000000" Offset="0" />
            <GradientStop Color="Black" Offset="0.25" /><GradientStop Color="#EB000000" Offset="0.35" /><GradientStop Color="#C7000000" Offset="0.48" /><GradientStop Color="#99000000" Offset="0.6" /><GradientStop Color="#66000000" Offset="0.72" /><GradientStop Color="#38000000" Offset="0.83" /><GradientStop Color="#14000000" Offset="0.93" />
            <GradientStop Color="Transparent" Offset="1" />
        </LinearGradientBrush>
    </Grid.OpacityMask>
    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
               HorizontalAlignment="Center" VerticalAlignment="Center">
        <FadeImage.OpacityMask>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Black" Offset="0" />
                <GradientStop Color="#99000000" Offset="0.45" />
                <GradientStop Color="#33000000" Offset="0.68" />
                <GradientStop Color="Transparent" Offset="0.85" />
            </LinearGradientBrush>
        </FadeImage.OpacityMask>
    </FadeImage>
    <Border Background="{DynamicResource ContentBackgroundBrush}">
        <Border.OpacityMask>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Transparent" Offset="0.1" />
                <GradientStop Color="#A6000000" Offset="0.4" />
                <GradientStop Color="#CC000000" Offset="0.7" />
                <GradientStop Color="#E6000000" Offset="1" />
            </LinearGradientBrush>
        </Border.OpacityMask>
    </Border>
</Grid>
<Grid>
                            

                            <Grid HorizontalAlignment="Stretch" Margin="20,0,37,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
<!-- Room above the title so it sits low on the banner; gone when the banner is off or the game has no art. -->
<Border Grid.Row="0" IsHitTestVisible="False">
    <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 100 / 320'}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                    <Setter Property="Height" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
</Border>

                                <!-- Title, icon, cover and the action buttons -->
                                <DockPanel Margin="0,24,0,20" MaxWidth="1024" Grid.Row="1"
                                           Background="Transparent">
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Bottom" SnapsToDevicePixels="True"
                                            Visibility="{Binding Visibility, ElementName=PART_ImageCover}"
                                            BorderThickness="0">
                                        <Border BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1"
                                                Background="{DynamicResource GridItemBackgroundBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <Image Name="PART_ImageCover"
                                                   Height="{Settings GameDetailsCoverHeight}"
                                                   StretchDirection="Both" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                        </Border>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom" DockPanel.Dock="Left">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center" SnapsToDevicePixels="True"
                                                    Visibility="{Binding Visibility, ElementName=PART_ImageIcon}"
                                                    BorderThickness="0">
                                                <Border BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1"
                                                        Background="{DynamicResource GridItemBackgroundBrush}"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                                    <Image Name="PART_ImageIcon" MaxHeight="48" MaxWidth="48"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="Fant" />
                                                </Border>
                                            </Border>
                                            <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource FontFamily}"
                                                       DockPanel.Dock="Left"
                                                       FontSize="{DynamicResource FontSizeLargest}" Margin="0,0,10,0" TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource GlyphBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="2" BlurRadius="0" Opacity="1" RenderingBias="Performance" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </DockPanel>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button Name="PART_ButtonPlayAction"
                                                    Width="150" Height="40" Style="{DynamicResource PlayButton}" />
                                            <Button Name="PART_ButtonContextAction"
                                                    Width="150" Height="40" />
                                            <Button Name="PART_ButtonMoreActions"
                                                    Content="{DynamicResource LOCMoreAction}"
                                                    Width="150" Height="40" Margin="10,0,0,0" />
                                            <Button x:Name="PART_ButtonEditGame"
                                                    Margin="10,0,0,0" Width="40" Height="40" Padding="0" Focusable="False">
                                                <Button.Content>
                                                    <ContentPresenter Width="20" Height="20"
                                                                      Content="{DynamicResource IconEdit}"
                                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                                </Button.Content>
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <DockPanel MaxWidth="1024" Grid.Row="2">
                                    <!-- The property list: an item tooltip -->
                                    <Border DockPanel.Dock="Right" Width="{DynamicResource GameDetailsPaneWidth}"
                                            Margin="20,0,0,20" VerticalAlignment="Top" SnapsToDevicePixels="True"
                                            Background="{DynamicResource TooltipBackgroundBrush}"
                                            BorderBrush="{DynamicResource PopupBorderBrush}"
                                            BorderThickness="{DynamicResource PopupBorderThickness}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <Border BorderThickness="0"
                                                Padding="{DynamicResource TooltipPadding}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCGameDetails}" Margin="0,0,0,8"
                                                           FontSize="{DynamicResource FontSizeLarge}"
                                                           Style="{DynamicResource BaseTextBlockStyle}" />

                                                <StackPanel>
                                                    <StackPanel Margin="0,-6,0,-20">
                                                        <Border x:Name="MetaProgress" Margin="0,0,0,14">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCompletionStatus" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <Button Grid.Column="1" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPlayTime" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextPlayTime" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemLastPlayed" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextLastActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemRecentActivity" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAdded" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" Margin="0,0,0,14">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCommunityScore" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemCriticScore" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemUserScore" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCUserScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout" Margin="0,0,0,14">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemDevelopers" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDevelopersLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsDevelopers" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPublishers" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCPublishersLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsPublishers" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemReleaseDate" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <Button Grid.Column="1" x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemSeries" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCSeriesLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsSeries" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAgeRating" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsAgeRatings" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemRegion" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRegionLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsRegions" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaTags" Margin="0,0,0,14">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemPlatform" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCPlatformsTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,0,0,-5">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemGenres" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGenresLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,0,0,-5">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemCategories" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCategoriesLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,0,0,-5">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemFeatures" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,0,0,-5">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemTags" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCTagsLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsTags" Tag="Chip" Margin="0,0,0,-5">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaLibrary" Margin="0,0,0,14">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemLibrary" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <Button Grid.Column="1" x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemSource" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCSourceLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <Button Grid.Column="1" x:Name="PART_ButtonSource" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemVersion" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCVersionLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <Button Grid.Column="1" x:Name="PART_ButtonVersion" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemInstallSize" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextInstallSize" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemInstallDirectory" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <Button Grid.Column="1" x:Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaLinks" Margin="0,0,0,14">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemLinks" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCLinksLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsLinks" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Border>

                                    <!-- The quest text: screenshots, description and notes on paper -->
                                    <Border Margin="0,0,0,20" VerticalAlignment="Top" SnapsToDevicePixels="True"
                                            BorderBrush="{DynamicResource FrameBrush}"
                                            BorderThickness="{DynamicResource FrameThickness}"
                                            CornerRadius="{DynamicResource CornerRadiusLarge}">
                                        <Border BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="0"
                                                Background="{DynamicResource ParchmentBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <Grid>
                                                <Border IsHitTestVisible="False" Opacity="0.9">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{ThemeFile 'Images/parchment.png'}"
                                                                    TileMode="Tile" Stretch="Fill"
                                                                    ViewportUnits="Absolute" Viewport="0,0,256,256" />
                                                    </Border.Background>
                                                </Border>
                                                <Border IsHitTestVisible="False" Background="{DynamicResource ParchmentEdgeBrush}">
                                                    <Border.CacheMode>
                                                        <BitmapCache />
                                                    </Border.CacheMode>
                                                    <Border.OpacityMask>
                                                        <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
                                                            <GradientStop Color="Transparent" Offset="0.55" />
                                                            <GradientStop Color="#A0000000" Offset="1" />
                                                        </RadialGradientBrush>
                                                    </Border.OpacityMask>
                                                </Border>
                                                <StackPanel Margin="26,18,26,24">
                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library or Steam source games in that gap; give up after 12s so a game without screenshots does not keep an empty block. When the plugin is not installed or is disabled the binding fails, FallbackValue=PluginUnavailable matches neither True nor False, and no skeleton shows. -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                            <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <MultiDataTrigger.EnterActions>
                                                                            <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                                <Storyboard>
                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </MultiDataTrigger.EnterActions>
                                                                        <MultiDataTrigger.ExitActions>
                                                                            <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                                        </MultiDataTrigger.ExitActions>
                                                                    </MultiDataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                            <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <MultiDataTrigger.EnterActions>
                                                                            <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                                <Storyboard>
                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </MultiDataTrigger.EnterActions>
                                                                        <MultiDataTrigger.ExitActions>
                                                                            <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                                        </MultiDataTrigger.ExitActions>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <StackPanel Margin="0,0,0,20">
                                                            <Grid Margin="0,0,0,6">
                                                                <TextBlock Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}"
                                                                           Margin="1,1,0,0" Opacity="0.65"
                                                                           FontSize="{DynamicResource FontSizeLarger}"
                                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                                           Foreground="{DynamicResource ParchmentLabelBrush}" />
                                                                <TextBlock Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}"
                                                                           FontSize="{DynamicResource FontSizeLarger}"
                                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                                           Foreground="{DynamicResource ParchmentTitleBrush}" />
                                                            </Grid>
                                                            <Grid Margin="0,6,0,6">
                                                                <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                                <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource ParchmentTextBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                                    <Control.Style>
                                                                        <Style TargetType="Control">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Control.Style>
                                                                </Control>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Name="PART_ElemDescription">
                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}"
                                                                       Margin="1,1,0,0" Opacity="0.65"
                                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                                       Foreground="{DynamicResource ParchmentLabelBrush}" />
                                                            <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}"
                                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                                       Foreground="{DynamicResource ParchmentTitleBrush}" />
                                                        </Grid>
                                                        <HtmlTextView Name="PART_HtmlDescription"
                                                                      Margin="0,5,0,5"
                                                                      HtmlFontSize="{DynamicResource FontSizeLarge}"
                                                                      HtmlFontFamily="{DynamicResource FontFamily}"
                                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                      pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                    </StackPanel>

                                                    <StackPanel Name="PART_ElemNotes" Margin="0,12,0,0">
                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="{DynamicResource LOCNotesLabel}"
                                                                       Margin="1,1,0,0" Opacity="0.65"
                                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                                       Foreground="{DynamicResource ParchmentLabelBrush}" />
                                                            <TextBlock Text="{DynamicResource LOCNotesLabel}"
                                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                                       Foreground="{DynamicResource ParchmentTitleBrush}" />
                                                        </Grid>
                                                        <TextBox Name="PART_TextNotes" IsReadOnly="True"
                                                                 Style="{DynamicResource BareTextBox}"
                                                                 Foreground="{DynamicResource ParchmentTextBrush}"
                                                                 CaretBrush="{DynamicResource ParchmentTextBrush}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                 Margin="0,5,0,5" Padding="0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </DockPanel>
                            </Grid>
                        </Grid>
</Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>