<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml: the game page of the details view.
    Playnite's arrangement is kept (background art as a banner, GameBannerHeight; the cover and title over it; the
    action buttons; text on the left, details on the right); every PART_ name is Playnite's.
      - Title: gold capitals (HeadingFontFamily) with a two pixel shadow. Icon and cover sit in item slots.
      - Actions: Play is the big red panel button (DerivedStyles/PlayButton.xaml); More and Edit are 40x40 charcoal
        plates with gold glyphs (SecondaryButton), each with a tooltip.
      - Left: Steam screenshots and the description in one info panel, the client's tooltip frame (near-black
        backdrop inside a metal line with a black line inside it), gold headings, white text drawn by
        DescriptionView.html. The notes are a letter under it: ink on tiled paper.
      - Right: the details panel, the same frame: gold captions, white values, scores in the item quality colors,
        tags as small slots. Every metadata field, in the six shared groups, split by space; a group goes away
        with its last visible field.
      - No game selected: an empty slot with the quest mark under a slow gold glow.
    Generated by art/overview.py; change the page there.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <Grid x:Name="PageRoot">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- Visibility is set here on purpose: the inherited DetailsScrollViewer style collapses the host on a null
                             DataContext, which would hide the empty state too. -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Visible"
                                      Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible"
                                      d:DesignWidth="1280"
                                      d:DesignHeight="1280"
                                      d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                      x:Name="PART_ScrollViewHost">
                            <Grid>
                                <!-- No game selected: an empty item slot holding the quest mark, under a slow gold glow, and Playnite's own line.
                                     Centred in the visible area. The glow loops only while this shows, on Opacity (a plain property). -->
                                <Grid x:Name="EmptyState" VerticalAlignment="Top" Height="{Binding ViewportHeight, ElementName=PART_ScrollViewHost}">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                                            <Rectangle Margin="-44" IsHitTestVisible="False" Fill="{DynamicResource GlyphBrush}">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-spot.png'}" Stretch="Fill" />
                                                </Rectangle.OpacityMask>
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Opacity" Value="0.22" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="EmptyGlowPulse">
                                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.14" To="0.42" Duration="0:0:2.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <SineEase EasingMode="EaseInOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="EmptyGlowPulse" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                            <Border Background="{DynamicResource GridItemBackgroundBrush}"
                                                    BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="2"
                                                    CornerRadius="{DynamicResource CornerRadiusLarge}" />
                                            <Border Margin="3" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                                            <ContentPresenter Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource GlyphBrush}"
                                                              Content="{DynamicResource IconUpdate}"
                                                              ContentTemplate="{DynamicResource IconTemplate}" />
                                        </Grid>
                                        <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" Margin="0,22,0,0"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                                   FontSize="{DynamicResource FontSizeLarge}"
                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                   Foreground="{DynamicResource GlyphBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="GameContent">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <!-- Banner: the game's background art as a band at the top, GameBannerHeight high (0 turns it off). No OpacityMask
                                         here: masked art repainted in part behind the animated Play button leaves dark seams on scaled displays. A plain
                                         black scrim darkens it toward the title and a second gradient fades it into the page color, read from PageRoot. -->
                                    <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                        <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                        <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#59000000" Offset="0" />
                                                    <GradientStop Color="#1F000000" Offset="0.22" />
                                                    <GradientStop Color="#8C000000" Offset="0.6" />
                                                    <GradientStop Color="#B3000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0.38" />
                                                    <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                    <Grid HorizontalAlignment="Stretch" Margin="20,0,37,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <!-- Room above the title so it sits low on the banner; scales with the banner, gone when it is off or the game has no art. -->
                                        <Border Grid.Row="0" IsHitTestVisible="False" x:Name="DetailsBannerSpacer" MinHeight="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 100 / 320'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="0" />
                                                        </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="0" />
</DataTrigger>
</Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <!-- Title, icon, cover and the action buttons -->
                                        <DockPanel Margin="0,24,0,20" MaxWidth="1024" Grid.Row="1" Background="Transparent">
                                            <Border DockPanel.Dock="Right" VerticalAlignment="Bottom" SnapsToDevicePixels="True"
                                                    Visibility="{Binding Visibility, ElementName=PART_ImageCover}"
                                                    BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1"
                                                    Background="{DynamicResource GridItemBackgroundBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <Image Name="PART_ImageCover" Height="{Settings GameDetailsCoverHeight}" StretchDirection="Both" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Bottom" DockPanel.Dock="Left">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center" SnapsToDevicePixels="True"
                                                            Visibility="{Binding Visibility, ElementName=PART_ImageIcon}"
                                                            BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1"
                                                            Background="{DynamicResource GridItemBackgroundBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                                        <Image Name="PART_ImageIcon" MaxHeight="48" MaxWidth="48" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                                    </Border>
                                                    <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}"
                                                               FontWeight="SemiBold" FontSize="{DynamicResource FontSizeLargest}"
                                                               TextWrapping="Wrap" DockPanel.Dock="Left" Margin="0,0,10,0"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource GlyphBrush}">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect ShadowDepth="2" BlurRadius="0" Opacity="1" RenderingBias="Performance" />
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                </DockPanel>
                                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Orientation="Horizontal" Margin="0,18,0,0">
                                                    <Button Name="PART_ButtonPlayAction"
                                                            Width="150" Height="40" Style="{DynamicResource PlayButton}" />
                                                    <Button Name="PART_ButtonContextAction"
                                                            Width="150" Height="40" />
                                                    <Button Name="PART_ButtonMoreActions"
                                                            Width="40" Height="40" Padding="0" Margin="10,0,0,0"
                                                            Style="{DynamicResource SecondaryButton}"
                                                            ToolTip="{DynamicResource LOCMoreAction}">
                                                        <ContentPresenter Width="20" Height="20"
                                                                          Content="{DynamicResource IconOptions}"
                                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                                    </Button>
                                                    <Button x:Name="PART_ButtonEditGame"
                                                            Width="40" Height="40" Padding="0" Margin="10,0,0,0" Focusable="False"
                                                            Style="{DynamicResource SecondaryButton}"
                                                            ToolTip="{DynamicResource LOCEditGame}">
                                                        <ContentPresenter Width="20" Height="20"
                                                                          Content="{DynamicResource IconEdit}"
                                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                        <Grid MaxWidth="1024" Grid.Row="2" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 20 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataViewport" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="20,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<Border Margin="0,0,0,20" VerticalAlignment="Top" SnapsToDevicePixels="True"
                                                    Background="{DynamicResource TooltipBackgroundBrush}"
                                                    BorderBrush="{DynamicResource PopupBorderBrush}"
                                                    BorderThickness="{DynamicResource PopupBorderThickness}"
                                                    CornerRadius="{DynamicResource CornerRadiusLarge}" HorizontalAlignment="Stretch">
                                                <Border BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" Padding="14,12,14,14"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                                    <StackPanel x:Name="DetailsMetadataViewport" Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                        <TextBlock FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" Text="{DynamicResource LOCGameDetails}" FontSize="{DynamicResource FontSizeLarger}"
                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" />
                                                        <Rectangle Height="1" Margin="0,6,0,10" IsHitTestVisible="False" Opacity="0.3" Fill="{DynamicResource PopupBorderBrush}" />
                                                        <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-6,0,-20" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-6,-24,-20" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                            <Border x:Name="MetaProgress"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Setter Property="Margin" Value="0,0,0,14" /><Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,0,24,14" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Grid x:Name="PART_ElemCompletionStatus" Margin="0,6,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="132" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                        <Button Grid.Column="1" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemPlayTime" Margin="0,6,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="132" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                        <TextBlock Grid.Column="1" x:Name="PART_TextPlayTime" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemLastPlayed" Margin="0,6,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="132" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                        <TextBlock Grid.Column="1" x:Name="PART_TextLastActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemRecentActivity" Margin="0,6,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="132" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                        <TextBlock Grid.Column="1" x:Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemAdded" Margin="0,6,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="132" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                        <TextBlock Grid.Column="1" x:Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaScores"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Setter Property="Margin" Value="0,0,0,14" /><Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,0,24,14" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Grid x:Name="PART_ElemCommunityScore" Margin="0,6,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="132" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                        <TextBlock Grid.Column="1" x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemCriticScore" Margin="0,6,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="132" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                        <TextBlock Grid.Column="1" x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemUserScore" Margin="0,6,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="132" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCUserScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                        <TextBlock Grid.Column="1" x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaAbout"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Setter Property="Margin" Value="0,0,0,14" /><Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,0,24,14" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Grid x:Name="PART_ElemDevelopers" Margin="0,6,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="132" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCDevelopersLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                        <ItemsControl Grid.Column="1" x:Name="PART_ItemsDevelopers" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemPublishers" Margin="0,6,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="132" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCPublishersLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                                        <ItemsControl Grid.Column="1" x:Name="PART_ItemsPublishers" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemReleaseDate" Margin="0,6,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="132" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
