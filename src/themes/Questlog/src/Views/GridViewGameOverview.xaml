<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml: the side panel of the grid view, set like the details
    view (Views/DetailsViewGameOverview.xaml): the title in gold over an item slot icon, Steam screenshots, the
    description and notes as quest text on paper, and the properties as an item tooltip on the right (every metadata field, in six groups). The close
    button is the red plate of the window buttons.
    Every PART_ name is Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border Padding="16,0,16,0" BorderThickness="0"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Grid>

<DockPanel>

                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                       Margin="0,20,0,0" DockPanel.Dock="Top"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DockPanel DockPanel.Dock="Top">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <ScrollViewer DockPanel.Dock="Top" HorizontalAlignment="Stretch"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                              x:Name="PART_ScrollViewHost">
<!-- The header scrolls with the page (not pinned above it). -->
<Grid>
<!-- Banner: the game's background art as a band at the top. Tinted at the top, darkened toward the title by a page-colored scrim, faded into the page. GameBannerHeight sets the height; 0 turns it off. -->
<Grid x:Name="HeroClip" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" Margin="0,8,0,0" IsHitTestVisible="False">
<Grid.Style>
        <Style TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Grid.Style>
<Grid.OpacityMask><VisualBrush Visual="{Binding ElementName=HeroClipShape}" /></Grid.OpacityMask>
<Border x:Name="HeroClipShape" CornerRadius="{DynamicResource CornerRadiusLarge}" Background="{DynamicResource ContentBackgroundBrush}" />
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
    <Grid.Style>
        <Style TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Grid.Style>
    <Grid.CacheMode>
        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
    </Grid.CacheMode>
    <Grid.OpacityMask>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#A6000000" Offset="0" />
            <GradientStop Color="Black" Offset="0.25" /><GradientStop Color="#EB000000" Offset="0.35" /><GradientStop Color="#C7000000" Offset="0.48" /><GradientStop Color="#99000000" Offset="0.6" /><GradientStop Color="#66000000" Offset="0.72" /><GradientStop Color="#38000000" Offset="0.83" /><GradientStop Color="#14000000" Offset="0.93" />
            <GradientStop Color="Transparent" Offset="1" />
        </LinearGradientBrush>
    </Grid.OpacityMask>
    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
               HorizontalAlignment="Center" VerticalAlignment="Center">
        <FadeImage.OpacityMask>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Black" Offset="0" />
                <GradientStop Color="#99000000" Offset="0.45" />
                <GradientStop Color="#33000000" Offset="0.68" />
                <GradientStop Color="Transparent" Offset="0.85" />
            </LinearGradientBrush>
        </FadeImage.OpacityMask>
    </FadeImage>
    <Border Background="{DynamicResource ContentBackgroundBrush}">
        <Border.OpacityMask>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Transparent" Offset="0.1" />
                <GradientStop Color="#A6000000" Offset="0.4" />
                <GradientStop Color="#CC000000" Offset="0.7" />
                <GradientStop Color="#E6000000" Offset="1" />
            </LinearGradientBrush>
        </Border.OpacityMask>
    </Border>
</Grid>
</Grid>
<StackPanel Margin="20,0,20,0">
<!-- Room above the title so it sits low on the banner; gone when the banner is off or the game has no art. -->
<Border DockPanel.Dock="Top" IsHitTestVisible="False">
    <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 84 / 320'}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                    <Setter Property="Height" Value="52" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
</Border>
<DockPanel DockPanel.Dock="Top">
                                    <Border DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" SnapsToDevicePixels="True"
                                            Visibility="{Binding Visibility, ElementName=PART_ImageIcon}"
                                            BorderThickness="0">
                                        <Border BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1"
                                                Background="{DynamicResource GridItemBackgroundBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <Image Name="PART_ImageIcon" MaxHeight="32" MaxWidth="32"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                        </Border>
                                    </Border>
                                    <TextBlock Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLarger}"
                                               TextWrapping="Wrap" DockPanel.Dock="Left"
                                               VerticalAlignment="Center" Foreground="{DynamicResource GlyphBrush}">
                                        <TextBlock.Effect>
                                            <DropShadowEffect ShadowDepth="2" BlurRadius="0" Opacity="1" RenderingBias="Performance" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </DockPanel>

                                <Grid DockPanel.Dock="Top" Margin="0,12,0,20" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="150" />
                                        <ColumnDefinition Width="*" MaxWidth="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Name="PART_ButtonPlayAction" Grid.Column="0"
                                            Height="40" Style="{DynamicResource PlayButton}" />
                                    <Button Name="PART_ButtonContextAction"
                                            Height="40" Grid.Column="0" />
                                    <Button Name="PART_ButtonMoreActions"
                                            Content="{DynamicResource LOCMoreAction}"
                                            Height="40" Grid.Column="1" Margin="12,0,0,0" />
                                    <Button x:Name="PART_ButtonEditGame" Grid.Column="2"
                                            Margin="12,0,0,0" Width="40" Height="40" Padding="0" Focusable="False">
                                        <Button.Content>
                                            <ContentPresenter Width="20" Height="20"
                                                              Content="{DynamicResource IconEdit}"
                                                              ContentTemplate="{DynamicResource IconTemplate}" />
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                
                                    <Grid VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The property list: an item tooltip, to the right of the quest text. -->
                                        <Border Grid.Column="2" Width="{DynamicResource GridDetailsPaneWidth}" Margin="0,0,0,16" VerticalAlignment="Top" SnapsToDevicePixels="True"
                                                Background="{DynamicResource TooltipBackgroundBrush}"
                                                BorderBrush="{DynamicResource PopupBorderBrush}"
                                                BorderThickness="{DynamicResource PopupBorderThickness}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <Border BorderThickness="0"
                                                    Padding="{DynamicResource TooltipPadding}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource LOCGameDetails}" Margin="0,0,0,8"
                                                               FontSize="{DynamicResource FontSizeLarge}"
                                                               Style="{DynamicResource BaseTextBlockStyle}" />

                                                    <StackPanel>
                                                        <StackPanel Margin="0,-6,0,-20">
                                                            <Border x:Name="MetaProgress" Margin="0,0,0,14">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemCompletionStatus" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemPlayTime" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <TextBlock x:Name="PART_TextPlayTime" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemLastPlayed" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <TextBlock x:Name="PART_TextLastActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemRecentActivity" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <TextBlock x:Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemAdded" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <TextBlock x:Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaScores" Margin="0,0,0,14">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemCommunityScore" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <TextBlock x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemCriticScore" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <TextBlock x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemUserScore" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCUserScore}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <TextBlock x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaAbout" Margin="0,0,0,14">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemDevelopers" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCDevelopersLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <ItemsControl x:Name="PART_ItemsDevelopers" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemPublishers" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCPublishersLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <ItemsControl x:Name="PART_ItemsPublishers" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemReleaseDate" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemSeries" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCSeriesLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <ItemsControl x:Name="PART_ItemsSeries" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemAgeRating" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <ItemsControl x:Name="PART_ItemsAgeRatings" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemRegion" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCRegionLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <ItemsControl x:Name="PART_ItemsRegions" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaTags" Margin="0,0,0,14">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemPlatform" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCPlatformsTitle}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,2,0,-5">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemGenres" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCGenresLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,2,0,-5">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemCategories" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCCategoriesLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <ItemsControl x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,2,0,-5">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemFeatures" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <ItemsControl x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,2,0,-5">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemTags" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCTagsLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <ItemsControl x:Name="PART_ItemsTags" Tag="Chip" Margin="0,2,0,-5">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaLibrary" Margin="0,0,0,14">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemLibrary" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemSource" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCSourceLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <Button x:Name="PART_ButtonSource" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemVersion" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCVersionLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <Button x:Name="PART_ButtonVersion" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemInstallSize" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <TextBlock x:Name="PART_TextInstallSize" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemInstallDirectory" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <Button x:Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaLinks" Margin="0,0,0,14">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemLinks" Margin="0,6,0,6">
                                                                        <TextBlock Text="{DynamicResource LOCLinksLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,3" />
                                                                        <ItemsControl x:Name="PART_ItemsLinks" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Border>

                                        <!-- The quest text: screenshots, description and notes on paper. -->
                                        <Border Grid.Column="0" Margin="0,0,0,16" VerticalAlignment="Top" SnapsToDevicePixels="True"
                                                BorderBrush="{DynamicResource FrameBrush}"
                                                BorderThickness="{DynamicResource FrameThickness}"
                                                CornerRadius="{DynamicResource CornerRadiusLarge}">
                                            <Border BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="0"
                                                    Background="{DynamicResource ParchmentBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <Grid>
                                                    <Border IsHitTestVisible="False" Opacity="0.9">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{ThemeFile 'Images/parchment.png'}"
                                                                        TileMode="Tile" Stretch="Fill"
                                                                        ViewportUnits="Absolute" Viewport="0,0,256,256" />
                                                        </Border.Background>
                                                    </Border>
                                                    <Border IsHitTestVisible="False" Background="{DynamicResource ParchmentEdgeBrush}">
                                                        <Border.CacheMode>
                                                            <BitmapCache />
                                                        </Border.CacheMode>
                                                        <Border.OpacityMask>
                                                            <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
                                                                <GradientStop Color="Transparent" Offset="0.55" />
                                                                <GradientStop Color="#A0000000" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Border.OpacityMask>
                                                    </Border>
                                                    <StackPanel Margin="20,16,20,20">
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library or Steam source games in that gap; give up after 12s so a game without screenshots does not keep an empty block. When the plugin is not installed or is disabled the binding fails, FallbackValue=PluginUnavailable matches neither True nor False, and no skeleton shows. -->
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                                <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <MultiDataTrigger.EnterActions>
                                                                                <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                                    <Storyboard>
                                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                                        </ObjectAnimationUsingKeyFrames>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </MultiDataTrigger.EnterActions>
                                                                            <MultiDataTrigger.ExitActions>
                                                                                <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                                            </MultiDataTrigger.ExitActions>
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                                <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <MultiDataTrigger.EnterActions>
                                                                                <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                                    <Storyboard>
                                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                                        </ObjectAnimationUsingKeyFrames>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </MultiDataTrigger.EnterActions>
                                                                            <MultiDataTrigger.ExitActions>
                                                                                <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                                            </MultiDataTrigger.ExitActions>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <StackPanel Margin="0,0,0,16">
                                                                <Grid Margin="0,0,0,6">
                                                                    <TextBlock Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}"
                                                                               Margin="1,1,0,0" Opacity="0.65"
                                                                               FontSize="{DynamicResource FontSizeLarge}"
                                                                               Style="{DynamicResource BaseTextBlockStyle}"
                                                                               Foreground="{DynamicResource ParchmentLabelBrush}" />
                                                                    <TextBlock Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}"
                                                                               FontSize="{DynamicResource FontSizeLarge}"
                                                                               Style="{DynamicResource BaseTextBlockStyle}"
                                                                               Foreground="{DynamicResource ParchmentTitleBrush}" />
                                                                </Grid>
                                                                <Grid Margin="0,6,0,6">
                                                                    <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                                    <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource ParchmentTextBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                                        <Control.Style>
                                                                            <Style TargetType="Control">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Control.Style>
                                                                    </Control>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>

                                                        <StackPanel Name="PART_ElemDescription">
                                                            <Grid Margin="0,0,0,6">
                                                                <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}"
                                                                           Margin="1,1,0,0" Opacity="0.65"
                                                                           FontSize="{DynamicResource FontSizeLarge}"
                                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                                           Foreground="{DynamicResource ParchmentLabelBrush}" />
                                                                <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}"
                                                                           FontSize="{DynamicResource FontSizeLarge}"
                                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                                           Foreground="{DynamicResource ParchmentTitleBrush}" />
                                                            </Grid>
                                                            <HtmlTextView Name="PART_HtmlDescription"
                                                                          Margin="0,5,0,5"
                                                                          HtmlFontSize="{DynamicResource FontSizeLarge}"
                                                                          HtmlFontFamily="{DynamicResource FontFamily}"
                                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                          pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                        </StackPanel>

                                                        <StackPanel Name="PART_ElemNotes" Margin="0,16,0,0">
                                                            <Grid Margin="0,0,0,6">
                                                                <TextBlock Text="{DynamicResource LOCNotesLabel}"
                                                                           Margin="1,1,0,0" Opacity="0.65"
                                                                           FontSize="{DynamicResource FontSizeLarge}"
                                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                                           Foreground="{DynamicResource ParchmentLabelBrush}" />
                                                                <TextBlock Text="{DynamicResource LOCNotesLabel}"
                                                                           FontSize="{DynamicResource FontSizeLarge}"
                                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                                           Foreground="{DynamicResource ParchmentTitleBrush}" />
                                                            </Grid>
                                                            <TextBox Name="PART_TextNotes" IsReadOnly="True"
                                                                     Style="{DynamicResource BareTextBox}"
                                                                     Foreground="{DynamicResource ParchmentTextBrush}"
                                                                     CaretBrush="{DynamicResource ParchmentTextBrush}"
                                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                                     Margin="0,5,0,0" Padding="0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </StackPanel>
</Grid>
</ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,36,0" Width="36" Height="36"
                                Focusable="False" Cursor="Hand"
                                Foreground="{DynamicResource TextBrush}" Background="{DynamicResource ButtonBackgroundBrush}"
                                Command="{MainViewModel CloseGameSideBarCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource NormalBorderBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <ContentPresenter Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Content="{DynamicResource IconWindowClose}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DangerBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
</Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>