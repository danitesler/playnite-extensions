<!--
    Overlay on Playnite Default/Views/ExplorerPanel.xaml: a plain strip of dark glass, as the filter panel
    (Views/FilterPanelView.xaml), with the red close plate. PART_* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type ExplorerPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ExplorerPanel}">
                    <Border BorderThickness="0"
                            d:DesignWidth="200"
                            d:DesignHeight="400">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Background="{TemplateBinding Background}">
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True"
                                       Margin="5,8,5,8">
                                <Button Content="r" Style="{DynamicResource WindowBarButton}"
                                        DockPanel.Dock="Right" Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Name="PART_ButtonClose" />
                                <ComboBox Name="PART_SelectFields" MaxDropDownHeight="Auto"
                                          DockPanel.Dock="Left" Margin="0,0,8,0" />
                            </DockPanel>
                            <ListBox Name="PART_SelectItems"
                                     DockPanel.Dock="Top" Margin="5,0,5,8"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            </ListBox>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
