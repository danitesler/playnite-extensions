<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml.
    A plain options block: no frame and no rule under the title. The title is gold (GameFontNormalLarge) and the body
    sits on the dark fill. Spacing: GroupBoxPadding, GroupBoxHeaderPadding, GroupBoxHeaderFontSize.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}"
                                   Foreground="{DynamicResource GlyphBrush}"
                                   FontSize="{DynamicResource GroupBoxHeaderFontSize}"
                                   Margin="{DynamicResource GroupBoxHeaderPadding}">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </TextBlock>
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                          Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
