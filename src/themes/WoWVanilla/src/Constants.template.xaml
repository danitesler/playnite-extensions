<!--
    WoW Vanilla: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    The tokens keep the names the Vanilla client uses (gold labels, white values, quest ink, item quality colors);
    here each placeholder names the token that plays the key's role.
    1. Playnite's palette keys: every view and control the theme does not restyle reads them, and ThemeModifier edits
       them. Gold (GameFontNormal) is the accent, white (GameFontHighlight) the text, the tooltip navy the popup.
    2. Shared keys. Gradients are used where the art is a gradient (buttons, frame ring, bars, page); they stay
       plain LinearGradientBrush entries, with no brush pointing at another brush.
    Theme XAML reads brushes only, never Color keys.

    Placeholder syntax: .cursor/rules/playnite-themes.mdc. Keep double braces out of comments here: the build renders
    them too.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): the client sets its UI at 13px and its large headings at 16 and 20. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">28</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:FONT_FAMILY|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:FONT_FAMILY_MONO|Consolas}}</FontFamily>

    <!-- Shape (Playnite keys). Tooltips and menus carry a 2px edge like the tooltip border art. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:RADIUS_MEDIUM}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">6</Thickness>

    <!-- Radius scale (shared) and the frame ring width -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:RADIUS_SMALL}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:RADIUS_LARGE}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:RADIUS_XLARGE}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:RADIUS_FULL}}</CornerRadius>
    <Thickness x:Key="FrameThickness">{{px:FRAME_WIDTH}}</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{HIGHLIGHT_FONT_COLOR}}</Color>                  <!-- values and body text: GameFontHighlight -->
    <Color x:Key="TextColorDarker">{{POOR_GRAY_COLOR}}</Color>                 <!-- secondary text: poor quality gray -->
    <Color x:Key="TextColorDark">{{QUEST_FONT_COLOR}}</Color>                  <!-- ink on gold fills -->
    <Color x:Key="MainColor">{{PANEL_FILL}}</Color>                            <!-- control surface -->
    <Color x:Key="MainColorDark">{{DIALOG_BG_DARK}}</Color>                    <!-- darker surface -->
    <Color x:Key="HoverColor">{{NORMAL_FONT_COLOR/28}}</Color>                 <!-- the gold mouse highlight, additive in the client -->
    <Color x:Key="GlyphColor">{{NORMAL_FONT_COLOR}}</Color>                    <!-- accent: GameFontNormal gold -->
    <Color x:Key="HighlightGlyphColor">{{NORMAL_FONT_COLOR/60}}</Color>
    <Color x:Key="PopupBackgroundColor">{{TOOLTIP_DEFAULT_BACKGROUND_COLOR}}</Color>  <!-- menus, dropdowns, tooltips -->
    <Color x:Key="PopupBorderColor">{{TEXTURE_TOOLTIP_BORDER}}</Color>
    <Color x:Key="BackgroundToneColor">{{PANEL_FILL}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{SLOT_FILL_BOTTOM}}</Color>        <!-- the dark bed behind covers and icon slots -->
    <Color x:Key="PanelSeparatorColor">{{FRAME_BRONZE}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{FRAME_BRONZE}}</Color>
    <Color x:Key="DataChangeNotifColor">{{LEGENDARY_ORANGE_COLOR}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{FIELD_BORDER}}" />               <!-- control edge: the tan of Common-Input-Border -->
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{TOOLTIP_DEFAULT_BACKGROUND_COLOR}}" />
    <LinearGradientBrush x:Key="ButtonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">      <!-- UI-Panel-Button-Up: lit top, dark red body -->
        <GradientStop Color="{{BUTTON_RED_HIGHLIGHT}}" Offset="0" />
        <GradientStop Color="{{BUTTON_RED}}" Offset="0.45" />
        <GradientStop Color="{{BUTTON_RED_SHADOW}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{SLOT_FILL_BOTTOM}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{UNCOMMON_GREEN_COLOR}}" />    <!-- green item quality -->
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{RED_FONT_COLOR}}" />          <!-- GameFontRed -->
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{NORMAL_FONT_COLOR}}" />          <!-- yellow: the even-level quest color -->

    <SolidColorBrush x:Key="WarningBrush" Color="{{RED_FONT_COLOR}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{DIALOG_BG_DARK/55}}" />   <!-- group boxes: dark glass inside a bronze line -->
    <LinearGradientBrush x:Key="WindowBackgourndBrush" StartPoint="0,0" EndPoint="0,1">   <!-- UI-DialogBox-Background -->
        <GradientStop Color="{{DIALOG_BG_TOP}}" Offset="0" />
        <GradientStop Color="{{DIALOG_BG_BOTTOM}}" Offset="1" />
    </LinearGradientBrush>

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell: the sidebar and the top bar are the stone of the main menu bar -->
    <LinearGradientBrush x:Key="ShellBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{{STONE_LIGHT}}" Offset="0" />
        <GradientStop Color="{{STONE_DARK}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TopPanelBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{STONE_LIGHT}}" Offset="0" />
        <GradientStop Color="{{STONE_DARK}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContentBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{DIALOG_BG_TOP}}" Offset="0" />
        <GradientStop Color="{{DIALOG_BG_DARK}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{FIELD_BACKGROUND}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{NORMAL_FONT_COLOR}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{NORMAL_FONT_COLOR/45}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{NORMAL_FONT_COLOR/55}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{HIGHLIGHT_FONT_COLOR}}" />
    <LinearGradientBrush x:Key="ListItemHoverBrush" StartPoint="0,0" EndPoint="1,0">      <!-- UI-QuestLogTitleHighlight: gold, fading to the right -->
        <GradientStop Color="{{NORMAL_FONT_COLOR/30}}" Offset="0" />
        <GradientStop Color="{{NORMAL_FONT_COLOR/6}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ListItemSelectedBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{{NORMAL_FONT_COLOR/52}}" Offset="0" />
        <GradientStop Color="{{NORMAL_FONT_COLOR/14}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenuItemHoverBrush" StartPoint="0,0" EndPoint="1,0">      <!-- UI-Common-MouseHilight -->
        <GradientStop Color="{{NORMAL_FONT_COLOR/42}}" Offset="0" />
        <GradientStop Color="{{NORMAL_FONT_COLOR/12}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FocusBrush" Color="{{NORMAL_FONT_COLOR}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{NORMAL_FONT_COLOR/35}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{BUTTON_HOVER_TOP}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{HIGHLIGHT_FONT_COLOR}}" />

    <!-- Buttons: red leather with a gold edge and gold text -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{NORMAL_FONT_COLOR}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{BUTTON_EDGE}}" />
    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush" StartPoint="0,0" EndPoint="0,1">      <!-- UI-Panel-Button-Highlight lifts the whole face -->
        <GradientStop Color="{{BUTTON_HOVER_TOP}}" Offset="0" />
        <GradientStop Color="{{BUTTON_HOVER_MID}}" Offset="0.45" />
        <GradientStop Color="{{BUTTON_HOVER_BOTTOM}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonPressedBackgroundBrush" StartPoint="0,0" EndPoint="0,1">    <!-- UI-Panel-Button-Down -->
        <GradientStop Color="{{BUTTON_RED_SHADOW}}" Offset="0" />
        <GradientStop Color="{{BUTTON_RED_PRESSED}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">    <!-- Play: the same leather, lit a step brighter -->
        <GradientStop Color="{{BUTTON_HOVER_MID}}" Offset="0" />
        <GradientStop Color="{{BUTTON_RED}}" Offset="0.5" />
        <GradientStop Color="{{BUTTON_RED_SHADOW}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonHoverBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{BUTTON_HOVER_TOP}}" Offset="0" />
        <GradientStop Color="{{BUTTON_HOVER_MID}}" Offset="0.5" />
        <GradientStop Color="{{BUTTON_RED}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{HIGHLIGHT_FONT_COLOR}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{BUTTON_RED_PRESSED}}" />

    <!-- Inputs: near-black field, tan edge -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{FIELD_BACKGROUND}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{DIALOG_BG_DARK}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{FIELD_BORDER}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{FIELD_BORDER_HOVER}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{FRAME_GOLD}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{FRAME_HIGHLIGHT}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{FIELD_BACKGROUND}}" />
    <LinearGradientBrush x:Key="SliderThumbBackgroundBrush" StartPoint="0,0" EndPoint="1,0">     <!-- UI-Slider-Button: a beige plate -->
        <GradientStop Color="{{KNOB_LIGHT}}" Offset="0" />
        <GradientStop Color="{{KNOB}}" Offset="0.5" />
        <GradientStop Color="{{KNOB_DARK}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{NORMAL_FONT_COLOR}}" />
    <LinearGradientBrush x:Key="ProgressBarForegroundBrush" StartPoint="0,0" EndPoint="0,1">     <!-- the casting bar -->
        <GradientStop Color="{{CASTING_BAR_HIGHLIGHT}}" Offset="0" />
        <GradientStop Color="{{CASTING_BAR_COLOR}}" Offset="0.45" />
        <GradientStop Color="{{CASTING_BAR_SHADOW}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{FIELD_BACKGROUND}}" />
    <LinearGradientBrush x:Key="ScrollBarThumbBrush" StartPoint="0,0" EndPoint="1,0">            <!-- UI-ScrollBar-Knob -->
        <GradientStop Color="{{KNOB_LIGHT}}" Offset="0" />
        <GradientStop Color="{{KNOB}}" Offset="0.5" />
        <GradientStop Color="{{KNOB_DARK}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{KNOB_LIGHT}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{FIELD_BACKGROUND}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{KNOB}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{KNOB_LIGHT}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{NORMAL_FONT_COLOR}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{FRAME_GOLD}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{FRAME_GOLD}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{NORMAL_FONT_COLOR/22}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{NORMAL_FONT_COLOR/40}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{FRAME_BRONZE}}" />

    <!-- Frames: the gold and bronze ring of dialogs and panels, the bevel of icon slots -->
    <LinearGradientBrush x:Key="FrameBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{{FRAME_HIGHLIGHT}}" Offset="0" />
        <GradientStop Color="{{FRAME_GOLD}}" Offset="0.3" />
        <GradientStop Color="{{FRAME_BRONZE}}" Offset="0.62" />
        <GradientStop Color="{{FRAME_GOLD}}" Offset="0.88" />
        <GradientStop Color="{{FRAME_HIGHLIGHT}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{FRAME_SHADOW}}" />
    <LinearGradientBrush x:Key="SlotBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{{SLOT_EDGE_LIGHT}}" Offset="0" />
        <GradientStop Color="{{SLOT_EDGE}}" Offset="0.5" />
        <GradientStop Color="{{SLOT_EDGE_DARK}}" Offset="1" />
    </LinearGradientBrush>

    <!-- Paper: quest text pages -->
    <LinearGradientBrush x:Key="ParchmentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{PARCHMENT_HIGHLIGHT}}" Offset="0" />
        <GradientStop Color="{{PARCHMENT}}" Offset="0.55" />
        <GradientStop Color="{{PARCHMENT_SHADE}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{PARCHMENT_EDGE}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{ITEM_TEXT_FONT_COLOR}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{QUEST_FONT_COLOR}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{QUEST_SMALL_FONT_COLOR}}" />
    <SolidColorBrush x:Key="ParchmentLinkBrush" Color="{{PARCHMENT_LINK}}" />
</ResourceDictionary>
