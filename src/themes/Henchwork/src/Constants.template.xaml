<!--
    Henchwork: Constants.xaml template (Evil Genius 2: World Domination-inspired lair management console).
    scripts/build-theme.ps1 renders tokens.css placeholders into Constants.xaml.
    Blueprint-navy war room, slate console panels, mustard pictogram tiles, cream dossier paper, green go-plates,
    orange quit tiles, purple scheme plates (running), red alert badges (filter mark) and lime odometer digits.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Barlow Condensed (OFL, bundled in src/Typography/) for display and body; Consolas for odometer digits -->
    <sys:Double x:Key="FontSizeSmall">13</sys:Double>
    <sys:Double x:Key="FontSize">15</sys:Double>
    <sys:Double x:Key="FontSizeLarge">17</sys:Double>
    <sys:Double x:Key="FontSizeLarger">22</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow Condensed, Barlow Condensed, Bahnschrift SemiCondensed, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Barlow Condensed, Barlow Condensed, Bahnschrift SemiBold Condensed, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Game page metadata pane defaults (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">1</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">3</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{hw-text}}</Color>
    <Color x:Key="TextColorDarker">{{hw-text-muted}}</Color>
    <Color x:Key="TextColorDark">{{hw-text-ink}}</Color>
    <Color x:Key="MainColor">{{hw-slate}}</Color>
    <Color x:Key="MainColorDark">{{hw-hud}}</Color>
    <Color x:Key="HoverColor">{{hw-slate-hi}}</Color>
    <Color x:Key="GlyphColor">{{hw-mustard}}</Color>
    <Color x:Key="HighlightGlyphColor">{{hw-mustard-wash}}</Color>
    <Color x:Key="PopupBackgroundColor">{{hw-slate}}</Color>
    <Color x:Key="PopupBorderColor">{{hw-ink}}</Color>
    <Color x:Key="BackgroundToneColor">{{hw-blueprint}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{hw-ink}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{hw-slate-line}}</Color>
    <Color x:Key="DataChangeNotifColor">{{hw-badge}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{hw-slate-line}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{hw-ink}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{hw-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{hw-slate-line}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{hw-slate-hi}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{hw-ink}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{hw-rating-pos}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{hw-rating-neg}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{hw-rating-mix}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{hw-orange-text}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{hw-page}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{hw-page}}" />

    <!-- Shell, Chrome & Game Page Brushes -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{hw-hud}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{hw-hud}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{hw-page}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{hw-page}}" />
    <!-- Blueprint navy brand tint for banner darkening (no alpha) -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{hw-banner-tint}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{hw-blueprint}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{hw-text-ink}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{hw-ink}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{hw-blueprint}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{hw-ink}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{hw-hud}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{hw-text}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="StripeAltBrush" Color="{{hw-orange}}" />
    <SolidColorBrush x:Key="StripeDeepBrush" Color="{{hw-purple}}" />
    <SolidColorBrush x:Key="StripeAccentBrush" Color="{{hw-green}}" />
    <SolidColorBrush x:Key="LocalGreenBrush" Color="{{hw-green}}" />
    <SolidColorBrush x:Key="LocalMustardBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="LocalCreamBrush" Color="{{hw-cream}}" />
    <SolidColorBrush x:Key="LocalOrangeBrush" Color="{{hw-orange}}" />
    <SolidColorBrush x:Key="LocalPurpleBrush" Color="{{hw-purple}}" />
    <SolidColorBrush x:Key="LocalInkBrush" Color="{{hw-ink}}" />
    <SolidColorBrush x:Key="LocalMustardHiBrush" Color="{{hw-mustard-hi}}" />
    <SolidColorBrush x:Key="LocalSlateLineBrush" Color="{{hw-slate-line}}" />
    <SolidColorBrush x:Key="LocalLilacBrush" Color="{{hw-lilac}}" />
    <SolidColorBrush x:Key="LocalOrangeTextBrush" Color="{{hw-orange-text}}" />
    <SolidColorBrush x:Key="LocalDimTextBrush" Color="{{hw-text-dim}}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{{hw-slate-hi}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{hw-slate-line}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{hw-text}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{hw-slate}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{hw-slate-hi}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{hw-slate-line}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{hw-purple}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{hw-mustard-tape}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{hw-mustard-deep}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{hw-orange}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{hw-text-ink}}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{hw-text}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{hw-text}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{hw-text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{hw-slate-line}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{hw-slate-press}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{hw-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{hw-mustard-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{hw-mustard-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{hw-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{hw-text-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{hw-mustard-tape}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{hw-slate-hi}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{hw-ink}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{hw-slate-line}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{hw-slate-press}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{hw-cream}}" />

    <!-- Input & Control Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{hw-ink}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{hw-blueprint}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{hw-slate-line}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{hw-mustard-deep}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{hw-slate-line}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{hw-mustard-hi}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{hw-ink}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{hw-ink}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{hw-mustard-hi}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{hw-lime}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{hw-ink}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{hw-mustard-deep}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{hw-hud}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{hw-mustard-deep}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{hw-text-ink}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{hw-text-ink}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{hw-steel}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{hw-mustard-hi}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{hw-hud}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{hw-cream}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{hw-slate-hi}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{hw-cream}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{hw-cream}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{hw-steel}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{hw-text-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{hw-mustard}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{hw-mustard}}" />
    <!-- Henchwork plates and surfaces (theme-only) -->
    <SolidColorBrush x:Key="LocalMustardTapeBrush" Color="{{hw-mustard-tape}}" />
    <SolidColorBrush x:Key="LocalMustardDeepBrush" Color="{{hw-mustard-deep}}" />
    <SolidColorBrush x:Key="LocalHudBrush" Color="{{hw-hud}}" />
    <SolidColorBrush x:Key="LocalSlateBrush" Color="{{hw-slate}}" />
    <SolidColorBrush x:Key="LocalSlateHiBrush" Color="{{hw-slate-hi}}" />
    <SolidColorBrush x:Key="LocalBlueprintBrush" Color="{{hw-blueprint}}" />
    <SolidColorBrush x:Key="LocalGridLineBrush" Color="{{hw-grid}}" />
    <SolidColorBrush x:Key="LocalSteelBrush" Color="{{hw-steel}}" />
    <SolidColorBrush x:Key="LocalPaperBrush" Color="{{hw-paper}}" />
    <SolidColorBrush x:Key="LocalPaperShadeBrush" Color="{{hw-paper-shade}}" />
    <SolidColorBrush x:Key="LocalPurpleDeepBrush" Color="{{hw-purple-deep}}" />
    <SolidColorBrush x:Key="LocalLimeBrush" Color="{{hw-lime}}" />
    <SolidColorBrush x:Key="LocalGreenHiBrush" Color="{{hw-green-hi}}" />
    <SolidColorBrush x:Key="LocalGreenDeepBrush" Color="{{hw-green-deep}}" />
    <SolidColorBrush x:Key="LocalGreenWashBrush" Color="{{hw-green-wash}}" />
    <SolidColorBrush x:Key="LocalOrangeHiBrush" Color="{{hw-orange-hi}}" />
    <SolidColorBrush x:Key="LocalOrangeDeepBrush" Color="{{hw-orange-deep}}" />
    <SolidColorBrush x:Key="LocalBadgeBrush" Color="{{hw-badge}}" />
    <SolidColorBrush x:Key="LocalInkTextBrush" Color="{{hw-text-ink}}" />
</ResourceDictionary>
