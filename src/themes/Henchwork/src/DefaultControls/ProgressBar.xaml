<!--
    Henchwork: DefaultControls/ProgressBar.xaml.
    Odometer gauge: recessed ink track with a slate-line rim, lit lime fill with a faint green-deep hatch (the HUD's
    resource digits). MinHeight="8" with Height="{TemplateBinding Height}" so dialogs stay 8px and TopPanel's
    PART_ProgressGlobal renders at 12px. Small fixed radii (2/1), never CornerRadiusFull.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid Height="{TemplateBinding Height}" MinHeight="8">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" />
                        <Border Margin="2" CornerRadius="1" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}" />
                                <Rectangle HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=PART_Indicator}"
                                           Fill="{DynamicResource LocalGreenDeepBrush}" Opacity="0.35"
                                           OpacityMask="{DynamicResource LocalHatchTightMaskBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
