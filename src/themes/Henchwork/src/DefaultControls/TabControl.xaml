<!--
    Henchwork: DefaultControls/TabControl.xaml.
    Overview tab plates (Overview / Money / Minions): flat mustard plates with bold ink headers sitting 3px low; the
    selected tab rises into a steel plate with a slate + ink inset frame, the way the open tab lifts in the source.
    TabItem keeps TextBrush; every header colour goes on the HeaderText TextBlock via TargetName (game edit dialog).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid Margin="0,0,4,0" SnapsToDevicePixels="True">
                        <Border x:Name="TabPlate" CornerRadius="2,2,0,0" Margin="0,3,0,0"
                                Background="{DynamicResource LocalMustardBrush}" Padding="14,5,14,5">
                            <Grid>
                                <Border x:Name="InsetFrame" Margin="-11,-2,-11,-5" BorderThickness="2" CornerRadius="1,1,0,0"
                                        BorderBrush="{DynamicResource LocalSlateBrush}" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Border BorderThickness="1,1,1,0" BorderBrush="{DynamicResource LocalInkBrush}" />
                                </Border>
                                <TextBlock x:Name="HeaderText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontWeight="Bold" Foreground="{DynamicResource TabItemForegroundBrush}">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabPlate" Property="Background" Value="{DynamicResource TabItemHoverIndicatorBrush}" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabPlate" Property="Background" Value="{DynamicResource TabItemIndicatorBrush}" />
                            <Setter TargetName="TabPlate" Property="Margin" Value="0" />
                            <Setter TargetName="TabPlate" Property="Padding" Value="14,7,14,6" />
                            <Setter TargetName="InsetFrame" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel" Grid.Row="0" Panel.ZIndex="1"
                                  IsItemsHost="True" Background="Transparent" Margin="0,0,0,0" />
                        <Rectangle Grid.Row="1" Fill="{DynamicResource LocalInkBrush}" IsHitTestVisible="False" />
                        <Border x:Name="Border" Grid.Row="2"
                                Background="{DynamicResource WindowBackgourndBrush}"
                                BorderBrush="{DynamicResource LocalInkBrush}" BorderThickness="2,0,2,2"
                                CornerRadius="0,0,2,2" Padding="10">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
