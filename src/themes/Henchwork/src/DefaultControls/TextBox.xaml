<!--
    Henchwork: DefaultControls/TextBox.xaml.
    32px (ControlHeight) recessed ink well with a 1px slate-line rim; hover warms the rim to mustard-deep and
    focus lights it mustard tape. Padding is applied once (PART_ContentHost only).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LocalLairFieldTemplate: a lair console readout drawn by hand. The well's edge is the sketch layer's wobbly ink
        stroke (LocalSketchFrameTemplate) in slate, and a strip of torn mustard tape pins its top-left corner. Hover: the
        strokes turn the deep mustard. Keyboard focus: they go full mustard and the field pops onto a hard 3px offset in
        deep mustard (bottom and right, the way covers and the Play slab sit on their ink plates). State is read from the
        nearest Control above; no desired size (the offset and strokes reach outside the box).
    -->
    <ControlTemplate x:Key="LocalLairFieldTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False">
            <Rectangle x:Name="OffsetB" Height="3" VerticalAlignment="Bottom" Margin="3,0,-3,-3" Fill="{DynamicResource FocusHaloBrush}" Visibility="Collapsed" />
            <Rectangle x:Name="OffsetR" Width="3" HorizontalAlignment="Right" Margin="0,3,-3,-3" Fill="{DynamicResource FocusHaloBrush}" Visibility="Collapsed" />
            <Control x:Name="Ink" Template="{DynamicResource LocalSketchFrameTemplate}" Foreground="{DynamicResource LocalSlateLineBrush}"
                     Focusable="False" IsTabStop="False" Opacity="0.9" />
            <Rectangle x:Name="Tape" Width="20" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,-3,0,0"
                       Fill="{DynamicResource GlyphBrush}" OpacityMask="{DynamicResource LocalTapeTornMaskBrush}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="-6" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <Setter TargetName="Ink" Property="Foreground" Value="{DynamicResource FocusHaloBrush}" />
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Ink" Property="Foreground" Value="{DynamicResource FocusBrush}" />
                <Setter TargetName="Ink" Property="Opacity" Value="1" />
                <Setter TargetName="OffsetB" Property="Visibility" Value="Visible" />
                <Setter TargetName="OffsetR" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="CaretBrush" Value="{DynamicResource LocalMustardBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <Control x:Name="FieldOverlay" Template="{DynamicResource LocalLairFieldTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource LocalMustardBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Stretch" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
