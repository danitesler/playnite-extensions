<!--
    Henchwork: DefaultControls/ContextMenu.xaml.
    Signature menu panel (LocalLairMenuBoardTemplate) shared by ContextMenu, TopPanelMenu, submenus and ComboBox
    lists: a slate console board with a 2px ink edge sitting on a hard ink offset with a hatched tail, crowned by a 4px strip
    in the five overview tab colours (mustard, green, orange, purple, steel), worn with grunge paint, outlined
    by wobbly hand-inked strokes and dropping a pencil-hatched comic shadow. Zero DropShadowEffect.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared lair console board -->
    <ControlTemplate x:Key="LocalLairMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Control Template="{DynamicResource LocalHatchShadowTemplate}" Foreground="{DynamicResource LocalInkBrush}"
                     Margin="0" Focusable="False" IsTabStop="False" />
            <Border Margin="0,0,8,8" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="2"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <Grid>
                <Rectangle Fill="{DynamicResource LocalSlateHiBrush}" Opacity="0.45" OpacityMask="{DynamicResource LocalGrungeMaskBrush}" />
                <Grid Height="4" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="{DynamicResource LocalMustardBrush}" />
                    <Rectangle Grid.Column="1" Fill="{DynamicResource LocalGreenBrush}" />
                    <Rectangle Grid.Column="2" Fill="{DynamicResource LocalOrangeBrush}" />
                    <Rectangle Grid.Column="3" Fill="{DynamicResource LocalPurpleBrush}" />
                    <Rectangle Grid.Column="4" Fill="{DynamicResource LocalSteelBrush}" />
                </Grid>
                </Grid>
            </Border>
            <Control Margin="0,0,8,8" Template="{DynamicResource LocalSketchFrameTemplate}" Foreground="{DynamicResource LocalInkBrush}"
                     Focusable="False" IsTabStop="False" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="MinWidth" Value="224" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalLairMenuBoardTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ScrollViewer Margin="6,10,14,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle"
                                            Grid.IsSharedSizeScope="True" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
