<!--
    Henchwork: DefaultControls/CheckBox.xaml.
    20x20 recessed ink square with a slate-line rim (the options-menu tick box). Checked fills mustard, sits on a
    2px hard ink offset, and the ink tick stamps in with a BackEase overshoot. Indeterminate shows a mustard bar.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                            <Border x:Name="BoxShadow" Margin="2,2,-2,-2" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Background="{DynamicResource LocalInkBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                            <Border x:Name="Box" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Background="{DynamicResource CheckBoxCheckMarkBkBrush}"
                                    BorderBrush="{DynamicResource CheckBoxBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Border x:Name="CheckedFill" Margin="-1" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                            Background="{DynamicResource LocalMustardBrush}"
                                            Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                    <ContentControl x:Name="CheckMark" Width="13" Height="13"
                                                    Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                    Foreground="{DynamicResource LocalInkTextBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                        <ContentControl.RenderTransform>
                                            <ScaleTransform x:Name="CheckStamp" ScaleX="1" ScaleY="1" />
                                        </ContentControl.RenderTransform>
                                    </ContentControl>
                                    <Border x:Name="IndetMark" Width="10" Height="3" CornerRadius="1.5"
                                            Background="{DynamicResource LocalMustardBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="Collapsed" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="Left" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource LocalInkBrush}" />
                            <Setter TargetName="BoxShadow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CheckIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckedFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="CheckedFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                                        <DoubleAnimation Storyboard.TargetName="CheckStamp" Storyboard.TargetProperty="ScaleX" From="1.5" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CheckStamp" Storyboard.TargetProperty="ScaleY" From="1.5" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CheckOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="CheckedFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.11" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckedFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.11" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedFill" Property="Background" Value="{DynamicResource CheckBoxCheckedHoverBackgroundBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource LocalMustardBrush}" />
                            <Setter TargetName="IndetMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
