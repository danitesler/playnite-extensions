<!--
    Henchwork: DerivedStyles/StandardWindowStyle.xaml (Settings, Add-ons, game editor, every Playnite dialog).
    44px war-room title band (CaptionHeight=44, ContentPresenter Margin="0,44,0,0"): HUD navy with a faint blueprint
    grid and worn paint, the vault-eye on a mustard pictogram tile with a hard ink offset, the window title printed on a skewed
    mustard tape label (ink bold), WindowBarButton caption keys on the right and a 2px ink rule closing the band.
    WindowDesignStyle is defined standalone (never BasedOn StandardWindowStyle).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource LocalInkBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Faint war-map contours and worn paint behind every dialog page -->
                                <Grid Margin="0,44,0,0" IsHitTestVisible="False" ClipToBounds="True">
                                    <Rectangle Fill="{DynamicResource LocalGridLineBrush}" OpacityMask="{DynamicResource LocalMapContoursMaskBrush}" />
                                    <Rectangle Fill="{DynamicResource LocalInkBrush}" Opacity="0.3" OpacityMask="{DynamicResource LocalGrungeMaskBrush}" />
                                </Grid>
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px war-room title band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}"
                                      ClipToBounds="True" SnapsToDevicePixels="True">
                                    <Rectangle Fill="{DynamicResource LocalSlateLineBrush}" Opacity="0.35" IsHitTestVisible="False"
                                               OpacityMask="{DynamicResource LocalBlueprintGridSmallMaskBrush}" />
                                    <Rectangle Fill="{DynamicResource LocalSlateBrush}" Opacity="0.5" IsHitTestVisible="False"
                                               OpacityMask="{DynamicResource LocalGrungeMaskBrush}" />
                                    <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource LocalInkBrush}" IsHitTestVisible="False" />
                                    <Rectangle Height="6" VerticalAlignment="Bottom" Margin="0,0,0,-2" Fill="{DynamicResource LocalInkBrush}" IsHitTestVisible="False"
                                               OpacityMask="{DynamicResource LocalSketchHMaskBrush}" />

                                    <DockPanel LastChildFill="True" Height="42" VerticalAlignment="Top">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>

                                        <!-- Vault-eye on a mustard pictogram tile -->
                                        <Control DockPanel.Dock="Left" Width="28" Height="28" Margin="10,0,12,0" VerticalAlignment="Center"
                                                 Template="{DynamicResource BrandTileTemplate}" IsHitTestVisible="False" />

                                        <!-- Title printed on a skewed mustard tape -->
                                        <Grid DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0"
                                              RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="-2" />
                                            </Grid.RenderTransform>
                                            <Border Margin="0,3,0,-3" Background="{DynamicResource LocalMustardDeepBrush}" OpacityMask="{DynamicResource LocalTapeTornMaskBrush}" />
                                            <Border Background="{DynamicResource LocalMustardTapeBrush}" OpacityMask="{DynamicResource LocalTapeTornMaskBrush}" />
                                            <Border Background="{DynamicResource LocalMustardDeepBrush}" Opacity="0.35" OpacityMask="{DynamicResource LocalGrungeSmallMaskBrush}" />
                                            <Border Padding="14,2,16,2">
                                                <TextBlock x:Name="PART_TextTitle"
                                                           Text="{TemplateBinding Title}"
                                                           FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                                           FontSize="17"
                                                           Foreground="{DynamicResource LocalInkTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </Grid>
                                        <Border />
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter Property="Text" Value="{DynamicResource LOCSettingsLabel}" TargetName="PART_TextTitle" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
