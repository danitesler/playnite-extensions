<!--
    Henchwork: DerivedStyles/PropertyItemButton.xaml.
    Metadata values live on the cream dossier card: a plain link is ink text that turns scheme purple and underlined
    on hover; inside a Tag="Chip" list it becomes a steel tab plate (ink bold text, 2px slate-line foot, small
    radius) that fills mustard on hover.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource LocalInkTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="LinkText" Foreground="{TemplateBinding Foreground}"
                               TextWrapping="Wrap" VerticalAlignment="Center">
                        <ContentPresenter />
                    </TextBlock>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LocalPurpleBrush}" />
                            <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ChipPlate" Background="{DynamicResource PropertyItemBackgroundBrush}"
                                    BorderBrush="{DynamicResource LocalSlateLineBrush}" BorderThickness="0,0,0,2"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Height="22" SnapsToDevicePixels="True">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="ChipHoverFill" Background="{DynamicResource PropertyItemHoverBackgroundBrush}"
                                            Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                    <ContentPresenter Margin="8,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipPlate" Property="BorderBrush" Value="{DynamicResource LocalMustardDeepBrush}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="ChipHoverIn">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipHoverFill" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="ChipHoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard x:Name="ChipHoverOut">
                                            <Storyboard FillBehavior="Stop">
                                                <DoubleAnimation Storyboard.TargetName="ChipHoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipHoverFill" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
