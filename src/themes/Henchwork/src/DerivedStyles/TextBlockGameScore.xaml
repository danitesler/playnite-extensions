<!--
    Henchwork: DerivedStyles/TextBlockGameScore.xaml.
    HUD odometer digits: Consolas numerals on the dark counter strip. Positive scores light lime (the resource
    counter digits), mixed mustard, negative text-safe orange, none muted. The game pages lay a dim "000" counter
    behind each score so the unused leading slots read as unlit odometer zeros; the score's own HUD background
    covers the slots it uses.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TextBlockGameScore" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource MonospaceFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="0,2,7,2" />
        <Setter Property="Foreground" Value="{DynamicResource LocalLimeBrush}" />
        <Setter Property="Background" Value="{DynamicResource LocalHudBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreGroup.Positive}">
                <Setter Property="Foreground" Value="{DynamicResource LocalLimeBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreGroup.Negative}">
                <Setter Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreGroup.Mixed}">
                <Setter Property="Foreground" Value="{DynamicResource MixedRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreGroup.None}">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
