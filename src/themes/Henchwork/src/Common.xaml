<!--
    Henchwork: Common.xaml. Spacing keys, white-mask FX brushes (art/sprites.py) and shared lair-console templates:
    BrandMarkTemplate (vault-eye), BrandTileTemplate (mark on a mustard pictogram tile with a hard ink offset),
    DividerTemplate (event-log diamond + dotted rule), TapeLabelTemplate (skewed mustard tape), EmptyGameTemplate
    (tilted loading poster with concentric rings), SteamScreenshotsSkeletonTemplate, HeadingTextBlock,
    LocalNotesTextBox and SecondaryButton (square slate key on an ink plate).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <Thickness x:Key="ButtonPadding">14,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">6,10,6,6</Thickness>
    <Thickness x:Key="MenuItemPadding">8,4</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">6,10,6,6</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,4</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,5</Thickness>
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>

    <!-- White-mask FX (art/sprites.py), tinted through Fill/Background so ThemeModifier recolours them -->
    <ImageBrush x:Key="LocalHatchMaskBrush" ImageSource="{ThemeFile 'Images/fx/hatch.png'}"
                TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalHatchTightMaskBrush" ImageSource="{ThemeFile 'Images/fx/hatch.png'}"
                TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBlueprintGridMaskBrush" ImageSource="{ThemeFile 'Images/fx/blueprint-grid.png'}"
                TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBlueprintGridSmallMaskBrush" ImageSource="{ThemeFile 'Images/fx/blueprint-grid.png'}"
                TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalRingsMaskBrush" ImageSource="{ThemeFile 'Images/fx/rings.png'}" Stretch="Uniform" />
    <ImageBrush x:Key="LocalPaperFibreMaskBrush" ImageSource="{ThemeFile 'Images/fx/paper-fibre.png'}"
                TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill" />

    <!-- Sketch layer (art/sprites.py): grunge paint, pencil hatching, wobbly ink strokes, torn tape, stamp, marker, map contours -->
    <ImageBrush x:Key="LocalGrungeMaskBrush" ImageSource="{ThemeFile 'Images/fx/grunge.png'}"
                TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGrungeSmallMaskBrush" ImageSource="{ThemeFile 'Images/fx/grunge.png'}"
                TileMode="Tile" Viewport="0,0,96,96" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalPencilHatchMaskBrush" ImageSource="{ThemeFile 'Images/fx/hatch-pencil.png'}"
                TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalSketchHMaskBrush" ImageSource="{ThemeFile 'Images/fx/sketch-h.png'}"
                TileMode="Tile" Viewport="0,0,256,6" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalSketchVMaskBrush" ImageSource="{ThemeFile 'Images/fx/sketch-v.png'}"
                TileMode="Tile" Viewport="0,0,6,256" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalTapeTornMaskBrush" ImageSource="{ThemeFile 'Images/fx/tape-torn.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalStampMaskBrush" ImageSource="{ThemeFile 'Images/fx/stamp.png'}" Stretch="Uniform" />
    <ImageBrush x:Key="LocalMarkerMaskBrush" ImageSource="{ThemeFile 'Images/fx/marker.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalMapContoursMaskBrush" ImageSource="{ThemeFile 'Images/fx/map-contours.png'}"
                TileMode="Tile" Viewport="0,0,512,512" ViewportUnits="Absolute" Stretch="Fill" />

    <!-- Hand-inked outline: four wobbly strokes in the Foreground brush drawn just over the host's edges.
         Rectangles only, so it reports no desired size (safe inside GroupBox cards). -->
    <ControlTemplate x:Key="LocalSketchFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="False">
            <Rectangle Height="6" VerticalAlignment="Top" Margin="-2,-3,-2,0" Fill="{TemplateBinding Foreground}"
                       OpacityMask="{DynamicResource LocalSketchHMaskBrush}" />
            <Rectangle Height="6" VerticalAlignment="Bottom" Margin="-3,0,-1,-3" Fill="{TemplateBinding Foreground}"
                       OpacityMask="{DynamicResource LocalSketchHMaskBrush}" />
            <Rectangle Width="6" HorizontalAlignment="Left" Margin="-3,-2,0,-2" Fill="{TemplateBinding Foreground}"
                       OpacityMask="{DynamicResource LocalSketchVMaskBrush}" />
            <Rectangle Width="6" HorizontalAlignment="Right" Margin="0,-1,-3,-3" Fill="{TemplateBinding Foreground}"
                       OpacityMask="{DynamicResource LocalSketchVMaskBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Comic drop shadow: a solid 3px offset in the Foreground brush plus a slate pencil-hatched tail (reads on navy). Place it before the plate it shadows
         with Margin = the hatch reach (for example 0,0,-8,-8 for an 8px tail). -->
    <ControlTemplate x:Key="LocalHatchShadowTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Border Margin="5,5,0,0" Background="{DynamicResource LocalSlateLineBrush}"
                    OpacityMask="{DynamicResource LocalPencilHatchMaskBrush}" />
            <Border Margin="3,3,5,5" Background="{TemplateBinding Foreground}" CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Grid>
    </ControlTemplate>

    <!-- Vault-eye mark geometry (also art/mark.svg) -->
    <Geometry x:Key="LocalMarkGeometry">F0 M12,1.5 A10.5,10.5 0 1 1 12,22.5 A10.5,10.5 0 0 1 12,1.5 Z M12,4 A8,8 0 1 0 12,20 A8,8 0 0 0 12,4 Z M12,6.5 A5.5,5.5 0 1 1 12,17.5 A5.5,5.5 0 0 1 12,6.5 Z M12,8.8 A1.7,1.7 0 0 0 11.1,11.95 L10.5,16 H13.5 L12.9,11.95 A1.7,1.7 0 0 0 12,8.8 Z</Geometry>

    <!-- Popup Border -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: 2px mustard tape outline -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Brand mark: vault-eye glyph in the Foreground brush -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path Fill="{TemplateBinding Foreground}" Data="{StaticResource LocalMarkGeometry}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Brand tile: the mark in ink on a mustard pictogram tile sitting on a 2px hard ink offset -->
    <ControlTemplate x:Key="BrandTileTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Margin="2,2,-2,-2" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource LocalInkBrush}" />
            <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource LocalMustardBrush}" />
            <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource LocalMustardDeepBrush}" Opacity="0.4"
                    OpacityMask="{DynamicResource LocalGrungeSmallMaskBrush}" />
            <Border>
                <Viewbox Margin="4" Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{DynamicResource LocalInkTextBrush}" Data="{StaticResource LocalMarkGeometry}" />
                    </Canvas>
                </Viewbox>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Event-log divider: mustard diamond bullet leading a dotted slate rule -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="10" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource LocalMustardBrush}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="45" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Grid.Column="1" Height="2" VerticalAlignment="Center" Margin="2,0,0,0"
                       Stroke="{DynamicResource LocalSlateLineBrush}" StrokeThickness="2" StrokeDashArray="1 1.5" />
        </Grid>
    </ControlTemplate>

    <!-- Skewed mustard tape label: Tag = text. Used for section heads and the banner pin. -->
    <ControlTemplate x:Key="TapeLabelTemplate" TargetType="Control">
        <Grid HorizontalAlignment="Left" IsHitTestVisible="False" SnapsToDevicePixels="True" RenderTransformOrigin="0,0.5">
            <Grid.RenderTransform>
                <RotateTransform Angle="-1.5" />
            </Grid.RenderTransform>
            <Border Margin="0,2,0,-2" Background="{DynamicResource LocalMustardDeepBrush}" OpacityMask="{DynamicResource LocalTapeTornMaskBrush}" />
            <Border Background="{DynamicResource LocalMustardTapeBrush}" OpacityMask="{DynamicResource LocalTapeTornMaskBrush}" />
            <Border Background="{DynamicResource LocalMustardDeepBrush}" Opacity="0.35"
                    OpacityMask="{DynamicResource LocalGrungeSmallMaskBrush}" />
            <Border Padding="12,2,14,2">
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                           FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LocalInkTextBrush}"
                           TextOptions.TextFormattingMode="Display" />
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Empty game page: tilted loading poster (cream border, orange rings, vault-eye centre) -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <StackPanel>
                <Grid Width="248" Height="176" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="-3" />
                    </Grid.RenderTransform>
                    <Control Margin="0,0,-12,-12" Template="{StaticResource LocalHatchShadowTemplate}"
                             Foreground="{DynamicResource LocalInkBrush}" Focusable="False" IsTabStop="False" />
                    <Border Background="{DynamicResource LocalPaperBrush}" CornerRadius="2" Padding="8">
                        <Grid ClipToBounds="True" Background="{DynamicResource LocalOrangeBrush}">
                            <Rectangle Fill="{DynamicResource LocalOrangeDeepBrush}" Opacity="0.85"
                                       OpacityMask="{DynamicResource LocalRingsMaskBrush}" Margin="-40" />
                            <Grid x:Name="PosterRings" Width="112" Height="112" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PosterRingsScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <Ellipse Stroke="{DynamicResource LocalPaperBrush}" StrokeThickness="6" Opacity="0.9" />
                            </Grid>
                            <Rectangle Fill="{DynamicResource LocalInkBrush}" Opacity="0.22"
                                       OpacityMask="{DynamicResource LocalGrungeMaskBrush}" />
                            <Border Width="62" Height="62" CornerRadius="31" Background="{DynamicResource LocalPaperBrush}">
                                <Control Width="40" Height="40" Template="{StaticResource BrandMarkTemplate}"
                                         Foreground="{DynamicResource LocalInkTextBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                    <Control Template="{StaticResource LocalSketchFrameTemplate}" Foreground="{DynamicResource LocalInkBrush}"
                             Focusable="False" IsTabStop="False" />
                </Grid>
                <Control Template="{StaticResource TapeLabelTemplate}" Tag="{DynamicResource LOCErrorNoGameSelected}"
                         HorizontalAlignment="Center" Margin="0,26,0,0" />
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="EmptyPosterIdle">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PosterRingsScale" Storyboard.TargetProperty="ScaleX">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.5" KeySpline="0.2,0 0.4,1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PosterRingsScale" Storyboard.TargetProperty="ScaleY">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.5" KeySpline="0.2,0 0.4,1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PosterRings" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" KeySpline="0.2,0 0.4,1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0.9" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyPosterIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SteamScreenshots loading skeleton: slate frames on hard ink offsets, faint blueprint grid -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid Height="196" Margin="0,0,3,10">
                <Border Margin="3,3,-3,-3" Background="{DynamicResource LocalInkBrush}" CornerRadius="2" />
                <Border Background="{DynamicResource NormalBrush}" CornerRadius="2">
                    <Grid ClipToBounds="True">
                        <Rectangle Fill="{DynamicResource LocalSlateLineBrush}" Opacity="0.35"
                                   OpacityMask="{DynamicResource LocalBlueprintGridMaskBrush}" />
                        <Control Template="{StaticResource BrandMarkTemplate}" Width="36" Height="36"
                                 Foreground="{DynamicResource LocalSlateLineBrush}" />
                    </Grid>
                </Border>
            </Grid>
            <UniformGrid Columns="4">
                <Border Height="48" Margin="0,0,6,0" CornerRadius="2" Background="{DynamicResource NormalBrush}" Opacity="0.85" />
                <Border Height="48" Margin="0,0,6,0" CornerRadius="2" Background="{DynamicResource NormalBrush}" Opacity="0.7" />
                <Border Height="48" Margin="0,0,6,0" CornerRadius="2" Background="{DynamicResource NormalBrush}" Opacity="0.85" />
                <Border Height="48" CornerRadius="2" Background="{DynamicResource NormalBrush}" Opacity="0.7" />
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- Game page section heading: condensed bold caps in mustard -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Read-only notes: slate panel with an ink edge -->
    <Style x:Key="LocalNotesTextBox" TargetType="TextBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalInkBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Game page secondary action: 36x36 slate key on a hard ink plate; hover lifts it to mustard -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="InkPlate" Margin="0,2,0,-2" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource LocalInkBrush}" IsHitTestVisible="False" />
                        <Grid x:Name="KeyPress">
                        <Grid x:Name="Key">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="KeyShift" Y="0" />
                            </Grid.RenderTransform>
                            <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border x:Name="HoverFill" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource LocalMustardBrush}"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LocalInkTextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecBtnHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="KeyShift" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecBtnHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="KeyShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="KeyPress" Property="Margin" Value="0,3,0,-3" />
                            <Setter TargetName="HoverFill" Property="Background" Value="{DynamicResource LocalMustardDeepBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
