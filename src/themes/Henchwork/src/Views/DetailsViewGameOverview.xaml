<!--
    Henchwork: Views/DetailsViewGameOverview.xaml (generated by art/gen-overviews.mjs).
    - Hero banner (GameBannerHeight=300, spacer x * 224 / 300 floor 18) with GameBannerDarken + 50% floor, darkened
      toward a hard 4px ink rule with a mustard tape (vault-eye) pinned across it.
    - Header: game icon on an ink-offset HUD plate, bold condensed title, green go-slab PlayButton +
      RunningActionIndicator, equal 40x40 icon-only SecondaryButton More and Edit.
    - Body: SteamScreenshotsGameScope + tape-labelled Description / Notes beside the ring-bound dossier
      (GameDetailsPaneWidth=300 usable width, GameDetailsPanePosition Left / Center / Stretch / Right via
      scripts/game-page-breakpoints.mjs). Scores are odometers with dim zeros.
    - Empty state: tilted loading poster (EmptyGameTemplate) over a blueprint grid, centred in ViewportHeight
      (PART_ScrollViewHost Visible).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="DetailsViewGameOverview">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DetailsViewGameOverview">
                    <ScrollViewer x:Name="PART_ScrollViewHost" Visibility="Visible" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                        <Grid x:Name="PageRoot" UseLayoutRounding="True">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid IsHitTestVisible="False" ClipToBounds="True">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle Fill="{DynamicResource LocalGridLineBrush}" Opacity="0.4" OpacityMask="{DynamicResource LocalBlueprintGridMaskBrush}" />
                                <Rectangle Fill="{DynamicResource LocalBlueprintBrush}" Opacity="0.5" OpacityMask="{DynamicResource LocalGrungeMaskBrush}" />
                            </Grid>
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                            <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                                <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                    <Setter Property="Height" Value="0" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00070B10" Offset="0.25" />
                                            <GradientStop Color="#C8070B10" Offset="0.86" />
                                            <GradientStop Color="#E6070B10" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#99070B10" Offset="0" />
                                            <GradientStop Color="#00070B10" Offset="0.55" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <!-- Pencil-hatched shading across the lower banner -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3*" />
                                        <RowDefinition Height="2*" />
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="{DynamicResource LocalInkBrush}" Opacity="0.45"
                                               OpacityMask="{DynamicResource LocalPencilHatchMaskBrush}" />
                                </Grid>
                                <Rectangle Height="4" VerticalAlignment="Bottom" Fill="{DynamicResource LocalInkBrush}" />
                                <Rectangle Height="6" VerticalAlignment="Bottom" Margin="0,0,0,-3" Fill="{DynamicResource LocalInkBrush}"
                                           OpacityMask="{DynamicResource LocalSketchHMaskBrush}" />
                                <Grid Width="64" Height="24" Margin="0,0,26,-8" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="-3" />
                                    </Grid.RenderTransform>
                                    <Border Margin="0,3,0,-3" Background="{DynamicResource LocalMustardDeepBrush}" OpacityMask="{DynamicResource LocalTapeTornMaskBrush}" />
                                    <Border Background="{DynamicResource LocalMustardTapeBrush}" OpacityMask="{DynamicResource LocalTapeTornMaskBrush}" />
                                    <Border Background="{DynamicResource LocalMustardDeepBrush}" Opacity="0.35" OpacityMask="{DynamicResource LocalGrungeSmallMaskBrush}" />
                                    <Border>
                                        <Control Width="16" Height="16" Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource LocalInkTextBrush}" />
                                    </Border>
                                </Grid>
                            </Grid>
                            <StackPanel Margin="26,0,26,28">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border x:Name="DetailsBannerSpacer" MinHeight="18" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 224 / 300'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="18" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
                                                    <Setter Property="Height" Value="18" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel Margin="0,8,0,14">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,4,0">
                                        <Grid MinWidth="170" Height="40">
                                            <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                            <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                            <Control Style="{DynamicResource RunningActionIndicator}" />
                                        </Grid>
                                        <Button x:Name="PART_ButtonMoreActions" Width="40" Height="40" Padding="0" Style="{DynamicResource SecondaryButton}" Margin="12,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                            <ContentControl Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                        <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0" ToolTip="{DynamicResource LOCEditGame}">
                                            <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0"
                                              Visibility="{Binding Visibility, ElementName=PART_ImageIcon}">
                                            <Control Margin="0,0,-8,-8" Template="{DynamicResource LocalHatchShadowTemplate}" Foreground="{DynamicResource LocalInkBrush}"
                                                     Focusable="False" IsTabStop="False" />
                                            <Border CornerRadius="{DynamicResource ControlCornerRadius}" Padding="2"
                                                    Background="{DynamicResource LocalHudBrush}" BorderBrush="{DynamicResource LocalInkBrush}" BorderThickness="2">
                                                <Image x:Name="PART_ImageIcon" MaxWidth="44" MaxHeight="44" />
                                            </Border>
                                        </Grid>
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Rectangle Height="13" VerticalAlignment="Bottom" Margin="-4,0,-12,-9" Fill="{DynamicResource LocalMustardBrush}" Opacity="0.85"
                                                       OpacityMask="{DynamicResource LocalMarkerMaskBrush}" IsHitTestVisible="False" />
                                            <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="40"
                                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap">
<TextBlock.Effect><DropShadowEffect Color="#F3F0DC" ShadowDepth="1.2" Direction="0" BlurRadius="0" Opacity="1" /></TextBlock.Effect></TextBlock>
                                        </Grid>
                                    </DockPanel>
                                </DockPanel>
                                <Grid Margin="0,14,0,0" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 18 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="18,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,18,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
<Grid Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                        <Grid VerticalAlignment="Top" Margin="8,0,10,10" SnapsToDevicePixels="True">
                                            <Control Margin="0,0,-10,-10" Template="{DynamicResource LocalHatchShadowTemplate}" Foreground="{DynamicResource LocalInkBrush}"
                                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                            <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource LocalPaperBrush}"
                                                    TextElement.Foreground="{DynamicResource LocalInkTextBrush}">
                                                <Grid>
                                                    <Rectangle Fill="{DynamicResource LocalPaperShadeBrush}" Opacity="0.7" IsHitTestVisible="False"
                                                               OpacityMask="{DynamicResource LocalPaperFibreMaskBrush}" />
                                                    <Rectangle Fill="{DynamicResource LocalPaperShadeBrush}" Opacity="0.6" IsHitTestVisible="False"
                                                               OpacityMask="{DynamicResource LocalGrungeMaskBrush}" />
                                                    <!-- Faded rubber stamp in the top-right corner -->
                                                    <Rectangle Width="96" Height="96" Margin="0,-10,-8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                               Fill="{DynamicResource LocalPurpleBrush}" Opacity="0.2" IsHitTestVisible="False"
                                                               OpacityMask="{DynamicResource LocalStampMaskBrush}" RenderTransformOrigin="0.5,0.5">
                                                        <Rectangle.RenderTransform>
                                                            <RotateTransform Angle="-14" />
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                    <Border Padding="30,12,14,12">
                                                        <StackPanel Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch" x:Name="DetailsMetadataContent">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                            <Grid ClipToBounds="True" x:Name="DetailsMetadataViewport">
                                                                <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-23,0,-4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-23,-24,-4" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Margin" Value="0,-4,0,-4" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-4,-24,-4" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Margin" Value="0,-4,0,-4" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-4,-24,-4" /></MultiDataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                                    <Border x:Name="MetaProgress" Padding="0"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,10,0,0" /><Style.Triggers><MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid Height="5" Margin="0,0,-14,8" IsHitTestVisible="False">
                                                                                <Rectangle Fill="{DynamicResource LocalPurpleBrush}" />
                                                                                <Rectangle Width="8" Height="8" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                           Fill="{DynamicResource LocalOrangeBrush}" RenderTransformOrigin="0.5,0.5">
                                                                                    <Rectangle.RenderTransform>
                                                                                        <RotateTransform Angle="45" />
                                                                                    </Rectangle.RenderTransform>
                                                                                </Rectangle>
                                                                            </Grid>
</Border>
<Border x:Name="PART_ElemCompletionStatus" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="2*" />
                                                                                        <ColumnDefinition Width="12" />
                                                                                        <ColumnDefinition Width="3*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LocalPurpleBrush}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                                                    <Button Grid.Column="2" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PropertyItemButton}" />
                                                                                </Grid>
                                                                            </Border>
<Border x:Name="PART_ElemPlayTime" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="2*" />
                                                                                        <ColumnDefinition Width="12" />
                                                                                        <ColumnDefinition Width="3*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LocalPurpleBrush}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource LocalInkTextBrush}" />
                                                                                </Grid>
                                                                            </Border>
<Border x:Name="PART_ElemLastPlayed" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="2*" />
                                                                                        <ColumnDefinition Width="12" />
                                                                                        <ColumnDefinition Width="3*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LocalPurpleBrush}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource LocalInkTextBrush}" />
                                                                                </Grid>
                                                                            </Border>
<Border x:Name="PART_ElemRecentActivity" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="2*" />
                                                                                        <ColumnDefinition Width="12" />
                                                                                        <ColumnDefinition Width="3*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LocalPurpleBrush}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource LocalInkTextBrush}" />
                                                                                </Grid>
                                                                            </Border>
<Border x:Name="PART_ElemAdded" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="2*" />
                                                                                        <ColumnDefinition Width="12" />
                                                                                        <ColumnDefinition Width="3*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LocalPurpleBrush}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource LocalInkTextBrush}" />
                                                                                </Grid>
                                                                            </Border>
<Border x:Name="MetaScores" Padding="0"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,10,0,0" /><Style.Triggers><MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid Height="5" Margin="0,0,-14,8" IsHitTestVisible="False">
                                                                                <Rectangle Fill="{DynamicResource LocalPurpleBrush}" />
                                                                                <Rectangle Width="8" Height="8" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                           Fill="{DynamicResource LocalOrangeBrush}" RenderTransformOrigin="0.5,0.5">
                                                                                    <Rectangle.RenderTransform>
                                                                                        <RotateTransform Angle="45" />
                                                                                    </Rectangle.RenderTransform>
                                                                                </Rectangle>
