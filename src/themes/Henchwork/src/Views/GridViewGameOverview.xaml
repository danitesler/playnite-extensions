                                                                                            <TextBlock Grid.Column="2" x:Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource LocalInkTextBrush}" />
                                                                                        </Grid>
                                                                                    </Border>
<Border x:Name="PART_ElemRecentActivity" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                        <Grid>
