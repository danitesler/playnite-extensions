<!--
    Henchwork: Views/GridViewGameOverview.xaml (generated by art/gen-overviews.mjs).
    - Hero banner (GameBannerHeight=300, spacer x * 214 / 300 floor 14) with GameBannerDarken + 50% floor, closed by
      the ink rule and mustard tape.
    - CloseGameSideBarCommand: custom 28x28 Quit key (slate-hi plate on an ink offset, hover fades in the orange Quit
      tile); inline left of the icon when GameBannerHeight < 120 or ShowBackgroundImageOnWindow=True, corner 12,12 otherwise.
    - Actions under the title: green go-slab PlayButton + RunningActionIndicator + equal 40x40 SecondaryButton More and Edit.
    - Ring-bound dossier (GridDetailsPaneWidth=300 usable width, 2*:3* columns, GameDetailsPanePosition).
    - Empty state: tilted loading poster over a blueprint grid, centred in ViewportHeight when Game is null.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="GridViewGameOverview">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewGameOverview">
                    <Border BorderBrush="{DynamicResource LocalInkBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="2,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left"><Setter Property="BorderThickness" Value="0,0,2,0" /></DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False"><Setter Property="BorderThickness" Value="0" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <ScrollViewer CanContentScroll="False" x:Name="PART_ScrollViewHost" Visibility="Visible" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                                <Grid x:Name="PageRoot" UseLayoutRounding="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid IsHitTestVisible="False" ClipToBounds="True">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Rectangle Fill="{DynamicResource LocalGridLineBrush}" Opacity="0.6" OpacityMask="{DynamicResource LocalMapContoursMaskBrush}" />
                                        <Rectangle Fill="{DynamicResource LocalBlueprintBrush}" Opacity="0.5" OpacityMask="{DynamicResource LocalGrungeMaskBrush}" />
                                    </Grid>
                                    <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                    <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                            <Setter Property="Height" Value="0" />
                                                        </DataTrigger>
                                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                        <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                        <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                        <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#000B1016" Offset="0.25" />
                                                    <GradientStop Color="#C80B1016" Offset="0.86" />
                                                    <GradientStop Color="#E60B1016" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#990B1016" Offset="0" />
                                                    <GradientStop Color="#000B1016" Offset="0.55" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <!-- Pencil-hatched shading across the lower banner -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="3*" />
                                                <RowDefinition Height="2*" />
                                            </Grid.RowDefinitions>
                                            <Rectangle Grid.Row="1" Fill="{DynamicResource LocalInkBrush}" Opacity="0.45"
                                                       OpacityMask="{DynamicResource LocalPencilHatchMaskBrush}" />
                                        </Grid>
                                        <Rectangle Height="4" VerticalAlignment="Bottom" Fill="{DynamicResource LocalInkBrush}" />
                                        <Rectangle Height="6" VerticalAlignment="Bottom" Margin="0,0,0,-3" Fill="{DynamicResource LocalInkBrush}"
                                                   OpacityMask="{DynamicResource LocalSketchHMaskBrush}" />
                                        <Grid Width="64" Height="24" Margin="0,0,26,-8" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="-3" />
                                            </Grid.RenderTransform>
                                            <Border Margin="0,3,0,-3" Background="{DynamicResource LocalMustardDeepBrush}" OpacityMask="{DynamicResource LocalTapeTornMaskBrush}" />
                                            <Border Background="{DynamicResource LocalMustardTapeBrush}" OpacityMask="{DynamicResource LocalTapeTornMaskBrush}" />
                                            <Border Background="{DynamicResource LocalMustardDeepBrush}" Opacity="0.35" OpacityMask="{DynamicResource LocalGrungeSmallMaskBrush}" />
                                            <Border>
                                                <Control Width="16" Height="16" Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource LocalInkTextBrush}" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    <StackPanel Panel.ZIndex="2" Margin="22,0,22,26">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border x:Name="GridBannerSpacer" MinHeight="14" IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 214 / 300'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="14" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
                                                            <Setter Property="Height" Value="14" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Panel.ZIndex="2" Margin="0,8,0,14">
                                            <DockPanel Panel.ZIndex="2">
                                                <Button x:Name="InlineSidePanelCloseButton" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Margin="0,0,10,0" Width="28" Height="28" Padding="0" Focusable="False" Cursor="Hand"
                                                        ToolTip="{DynamicResource LOCCloseLabel}" Command="{MainViewModel CloseGameSideBarCommand}"
                                                        Template="{Binding Template, ElementName=SidePanelCloseButton}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="{Binding Tag, ElementName=SidePanelCloseButton, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Visible` : `Collapsed`'}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.RenderTransform>
                                                        <TranslateTransform Y="{Binding ContentVerticalOffset, ElementName=PART_ScrollViewHost}" />
                                                    </Button.RenderTransform>
                                                </Button>
                                                <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0"
                                                      Visibility="{Binding Visibility, ElementName=PART_ImageIcon}">
                                                    <Control Margin="0,0,-8,-8" Template="{DynamicResource LocalHatchShadowTemplate}" Foreground="{DynamicResource LocalInkBrush}"
                                                             Focusable="False" IsTabStop="False" />
                                                    <Border CornerRadius="{DynamicResource ControlCornerRadius}" Padding="2"
                                                            Background="{DynamicResource LocalHudBrush}" BorderBrush="{DynamicResource LocalInkBrush}" BorderThickness="2">
                                                        <Image x:Name="PART_ImageIcon" MaxWidth="42" MaxHeight="42" />
                                                    </Border>
                                                </Grid>
                                                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Rectangle Height="13" VerticalAlignment="Bottom" Margin="-4,0,-12,-9" Fill="{DynamicResource LocalMustardBrush}" Opacity="0.85"
                                                               OpacityMask="{DynamicResource LocalMarkerMaskBrush}" IsHitTestVisible="False" />
                                                    <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                               FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLargest}"
                                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Grid MinWidth="170" Height="40">
                                                    <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                    <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                                    <Control Style="{DynamicResource RunningActionIndicator}" />
                                                </Grid>
                                                <Button x:Name="PART_ButtonMoreActions" Width="40" Height="40" Padding="0" Style="{DynamicResource SecondaryButton}" Margin="12,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                                    <ContentControl Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                                <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0" ToolTip="{DynamicResource LOCEditGame}">
                                                    <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Margin="0,14,0,0" x:Name="GridOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 18 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="GridMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="GridMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="18,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,18,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
<Grid Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                                <Grid VerticalAlignment="Top" Margin="8,0,10,10" SnapsToDevicePixels="True">
                                                    <Control Margin="0,0,-10,-10" Template="{DynamicResource LocalHatchShadowTemplate}" Foreground="{DynamicResource LocalInkBrush}"
                                                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                                    <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource LocalPaperBrush}"
                                                            TextElement.Foreground="{DynamicResource LocalInkTextBrush}">
                                                        <Grid>
                                                            <Rectangle Fill="{DynamicResource LocalPaperShadeBrush}" Opacity="0.7" IsHitTestVisible="False"
                                                                       OpacityMask="{DynamicResource LocalPaperFibreMaskBrush}" />
                                                            <Rectangle Fill="{DynamicResource LocalPaperShadeBrush}" Opacity="0.6" IsHitTestVisible="False"
                                                                       OpacityMask="{DynamicResource LocalGrungeMaskBrush}" />
                                                            <!-- Faded rubber stamp in the top-right corner -->
                                                            <Rectangle Width="96" Height="96" Margin="0,-10,-8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                       Fill="{DynamicResource LocalPurpleBrush}" Opacity="0.2" IsHitTestVisible="False"
                                                                       OpacityMask="{DynamicResource LocalStampMaskBrush}" RenderTransformOrigin="0.5,0.5">
                                                                <Rectangle.RenderTransform>
                                                                    <RotateTransform Angle="-14" />
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                            <Border Padding="30,12,14,12">
                                                                <StackPanel Tag="{DynamicResource GridDetailsPaneWidth}" HorizontalAlignment="Stretch" x:Name="GridMetadataContent">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GridDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GridDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Center"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Stretch"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                                    <Grid ClipToBounds="True" x:Name="GridMetadataViewport">
                                                                        <WrapPanel x:Name="GridMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-23,0,-4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-23,-24,-4" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Center"><Setter Property="Margin" Value="0,-4,0,-4" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Center" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-4,-24,-4" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Stretch"><Setter Property="Margin" Value="0,-4,0,-4" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Stretch" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-4,-24,-4" /></MultiDataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                                            <Border x:Name="MetaProgress" Padding="0"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,10,0,0" /><Style.Triggers><MultiDataTrigger>
                                                                                                <MultiDataTrigger.Conditions>
                                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                                </MultiDataTrigger.Conditions>
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid Height="5" Margin="0,0,-14,8" IsHitTestVisible="False">
                                                                                        <Rectangle Fill="{DynamicResource LocalPurpleBrush}" />
                                                                                        <Rectangle Width="8" Height="8" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                                   Fill="{DynamicResource LocalOrangeBrush}" RenderTransformOrigin="0.5,0.5">
                                                                                            <Rectangle.RenderTransform>
                                                                                                <RotateTransform Angle="45" />
                                                                                            </Rectangle.RenderTransform>
                                                                                        </Rectangle>
                                                                                    </Grid>
</Border>
<Border x:Name="PART_ElemCompletionStatus" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="2*" />
                                                                                                <ColumnDefinition Width="12" />
                                                                                                <ColumnDefinition Width="3*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LocalPurpleBrush}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                                                            <Button Grid.Column="2" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PropertyItemButton}" />
                                                                                        </Grid>
                                                                                    </Border>
<Border x:Name="PART_ElemPlayTime" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="2*" />
                                                                                                <ColumnDefinition Width="12" />
                                                                                                <ColumnDefinition Width="3*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Text="{DynamicResource LOCTimePlayed}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource LocalPurpleBrush}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                                                            <TextBlock Grid.Column="2" x:Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource LocalInkTextBrush}" />
                                                                                        </Grid>
                                                                                    </Border>
<Border x:Name="PART_ElemLastPlayed" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                        <Grid>
