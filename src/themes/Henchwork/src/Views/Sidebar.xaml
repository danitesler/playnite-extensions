<!--
    Henchwork: Views/Sidebar.xaml.
    44px HUD-navy rail closed by a 2px ink edge (the war-room tray). The main menu is the vault-eye on a 30px
    mustard pictogram tile with a hard ink offset; it pops (BackEase) on hover. Items below are pictogram tiles
    (CustomControls/SidebarItem.xaml). Turns transparent when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}"
                            BorderBrush="{DynamicResource LocalInkBrush}" BorderThickness="0,0,2,0"
                            Margin="{TemplateBinding Padding}">
                        <Grid>
                        <!-- Worn paint on the HUD tray -->
                        <Rectangle x:Name="TrayGrunge" Fill="{DynamicResource LocalSlateBrush}" Opacity="0.55"
                                   OpacityMask="{DynamicResource LocalGrungeMaskBrush}" IsHitTestVisible="False" />
                        <DockPanel x:Name="DockContentHolder">
                            <StackPanel x:Name="TopGroup" DockPanel.Dock="Top" Orientation="Vertical">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="42" Height="44" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Control x:Name="MenuTile" Width="30" Height="30"
                                             Template="{DynamicResource BrandTileTemplate}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Control.RenderTransform>
                                            <ScaleTransform x:Name="MenuTileScale" ScaleX="1" ScaleY="1" />
                                        </Control.RenderTransform>
                                    </Control>
                                </Border>
                                <Rectangle x:Name="TopSeparator" Width="24" Height="2" Margin="0,0,0,4"
                                           Fill="{DynamicResource LocalSlateBrush}" IsHitTestVisible="False" />
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                        <!-- Hand-inked tray edge -->
                        <Rectangle x:Name="RoughEdge" Width="6" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                   Fill="{DynamicResource LocalInkBrush}" OpacityMask="{DynamicResource LocalSketchVMaskBrush}"
                                   IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="BorderBrush" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TopSeparator" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TrayGrunge" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RoughEdge" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MenuTileScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="MenuTileScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="MenuHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="MenuTileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="MenuTileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="BorderThickness" Value="2,0,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="RoughEdge" />
                            <Setter Property="Margin" Value="-4,0,0,0" TargetName="RoughEdge" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="BorderThickness" Value="0,0,0,2" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RoughEdge" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="TopGroup" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="TopGroup" />
                            <Setter Property="Width" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="42" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Width" Value="2" TargetName="TopSeparator" />
                            <Setter Property="Height" Value="24" TargetName="TopSeparator" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="TopSeparator" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,136,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="BorderThickness" Value="0,2,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RoughEdge" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="TopGroup" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="TopGroup" />
                            <Setter Property="Width" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="42" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Width" Value="2" TargetName="TopSeparator" />
                            <Setter Property="Height" Value="24" TargetName="TopSeparator" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="TopSeparator" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
