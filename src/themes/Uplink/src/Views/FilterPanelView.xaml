<!--
    Overlay on Playnite Default/Views/FilterPanelView.xaml.
    The filter panel on the panel layer (TopPanelBackgroundBrush) with a 1px on its inner edge: field captions in the
    heading sans, 16px around the panel and 16px between fields. The preset buttons use this theme's
    add, edit and remove icons. The parts, and the keyed styles Playnite applies from code, keep their keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FilterPanelCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="16,4,16,8" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="{StaticResource False}">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Margin" Value="16,16,16,6" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource False}">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelFilterSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Margin" Value="16,0,16,0" />
        <Setter Property="ShowImage" Value="False" />
    </Style>

    <Style x:Key="FilterPanelFilterSelectionBox" TargetType="FilterSelectionBox" BasedOn="{StaticResource {x:Type FilterSelectionBox}}">
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <Style x:Key="FilterPanelFilterEnumSelectionBox" TargetType="FilterEnumSelectionBox" BasedOn="{StaticResource {x:Type FilterEnumSelectionBox}}">
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <Style x:Key="FilterPanelFilterStringSelectionBox" TargetType="FilterStringSelectionBox" BasedOn="{StaticResource {x:Type FilterStringSelectionBox}}">
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <Style x:Key="FilterPresetButtonAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>

    <Style TargetType="{x:Type FilterPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPanel}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            Background="{DynamicResource TopPanelBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings FilterPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <DockPanel Margin="16,12,12,8" DockPanel.Dock="Top">
                                <Button Content="r" FontFamily="Marlett"
                                        Style="{StaticResource SimpleButton}"
                                        DockPanel.Dock="Right" VerticalAlignment="Center"
                                        Name="PART_ButtonClose" />
                                <Button DockPanel.Dock="Left" Content="{StaticResource LOCClearFilters}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Style="{StaticResource SimpleButton}"
                                        Name="PART_ButtonClear" />
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,0,16,8">
                                <Button x:Name="PART_ButtonDeleteFilter"
                                        Style="{DynamicResource FilterPresetButtonAction}">
                                    <ContentControl Width="16" Height="16" Focusable="False" Content="{DynamicResource IconRemove}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button x:Name="PART_ButtonRenameFilter"
                                        Style="{DynamicResource FilterPresetButtonAction}">
                                    <ContentControl Width="16" Height="16" Focusable="False" Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button x:Name="PART_ButtonSaveFilter"
                                        Style="{DynamicResource FilterPresetButtonAction}">
                                    <ContentControl Width="16" Height="16" Focusable="False" Content="{DynamicResource IconAdd}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <ComboBox x:Name="PART_ComboFilterPresets"
                                          DockPanel.Dock="Left" VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          DockPanel.Dock="Top" Padding="0,0,0,16">
                                <StackPanel x:Name="PART_PanelItemsHost" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
