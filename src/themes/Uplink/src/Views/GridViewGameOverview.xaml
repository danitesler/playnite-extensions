<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml.
    The game info panel beside the cover grid: the same short background band as the details page (290px, tinted and scrimmed, faded
    into the panel), then the entry-screen header (title in the heading sans, light blue divider, action buttons), then
    two columns: Steam screenshots, description and notes on the left, Game details on the right (every metadata field in one pane of six groups split by 1pxs, each group hidden with its fields), each under a
    small-caps heading and a divider. The panel is on the panel layer with a 1px on the side facing the grid. Every PART_ name is Playnite's; the pane lays the fields out itself.
    HtmlForeground and LinkForeground are Color-typed properties of HtmlTextView,
    so they read Color keys (the build check allows exactly these two attributes).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border x:Name="PageRoot" Padding="20,0,20,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                           >
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource TopPanelBackgroundBrush}" />
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Same short background band as the details page. Hidden when the game has no art. -->
                            
                        <DockPanel>

                            <DockPanel DockPanel.Dock="Top">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <ScrollViewer CanContentScroll="False" DockPanel.Dock="Top" HorizontalAlignment="Stretch"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"
                                              x:Name="PART_ScrollViewHost">
<!-- The header scrolls with the page (not pinned above it). -->
<Grid>
<Grid x:Name="HeroClip" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" Margin="0,8,0,0" IsHitTestVisible="False">
<Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <!-- No OpacityMask on the banner: masked art repainted in part (behind the animated Play button) left dark
                                     seams on scaled displays. A veil and a plain gradient to the page color fade it toward the title instead. -->
                                <Border Background="{DynamicResource TopPanelBackgroundBrush}" Opacity="0.35" />
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.12" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.9" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
</Grid>
<StackPanel Margin="20,0,20,0">
<Border DockPanel.Dock="Top"  IsHitTestVisible="False" MinHeight="20" x:Name="GridBannerSpacer">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 84 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="20" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="20" />
</DataTrigger>
</Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <DockPanel Panel.ZIndex="2" DockPanel.Dock="Top" Margin="0,0,0,0">
                                    <Button x:Name="InlineSidePanelCloseButton" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" Width="28" Height="28" Padding="0"
                                        Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}" Command="{MainViewModel CloseGameSideBarCommand}"
                                        Template="{Binding Template, ElementName=SidePanelCloseButton}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="{Binding Tag, ElementName=SidePanelCloseButton, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Visible` : `Collapsed`'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                            <Button.RenderTransform>
                                                <TranslateTransform Y="{Binding ContentVerticalOffset, ElementName=PART_ScrollViewHost}" />
                                            </Button.RenderTransform>
                                    </Button>
                                    <Image Name="PART_ImageIcon" DockPanel.Dock="Left" MaxHeight="32" MaxWidth="32"
                                           RenderOptions.BitmapScalingMode="Fant" Margin="0,0,12,0" />
                                    <TextBlock Name="PART_TextDisplayName"
                                               FontFamily="{DynamicResource HeadingFontFamily}"
                                               FontSize="{DynamicResource FontSizeLargest}"
                                               Typography.Capitals="AllSmallCaps"
                                               TextWrapping="Wrap" DockPanel.Dock="Left"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                </DockPanel>

                                <Grid DockPanel.Dock="Top" Margin="0,16,0,24" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Name="PART_ButtonPlayAction" Grid.Column="0"
                                            Height="40" Style="{DynamicResource PlayButton}" />
                                    <Button Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}"
                                            Height="40" Grid.Column="0" />
                                    <Control Grid.Column="0" Height="40" Style="{DynamicResource RunningActionIndicator}" />
                                    <Button Name="PART_ButtonMoreActions"
                                            Width="40" Height="40" Padding="0" Grid.Column="1" Margin="10,0,0,0"
                                            ToolTip="{DynamicResource LOCMoreAction}">
                                        <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                        Content="{DynamicResource IconOptions}"
                                                        ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                    <Button x:Name="PART_ButtonEditGame" Grid.Column="2"
                                            Margin="10,0,8,0" Height="40" Width="40" Padding="0" Focusable="False"
                                            ToolTip="{DynamicResource LOCEditGame}">
                                        <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                        Content="{DynamicResource IconEdit}"
                                                        ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                </Grid>

                                
                                    <Grid VerticalAlignment="Top" x:Name="GridOverviewBody">
<Grid.Tag>
    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400">
        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Tag" ElementName="GridMetadataContent" />
    </MultiBinding>
</Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>


                                        <Grid x:Name="GridMetadataColumn" VerticalAlignment="Top">
<Grid.Style><Style TargetType="Grid">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="Margin" Value="24,0,0,0" />
    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </DataTrigger></Style.Triggers>
</Style></Grid.Style>
<StackPanel Margin="0,0,0,24" VerticalAlignment="Top" Tag="{DynamicResource GridDetailsPaneWidth}" x:Name="GridMetadataContent" HorizontalAlignment="Stretch">
<StackPanel.Style>
    <Style TargetType="StackPanel">
        <Setter Property="Width" Value="{DynamicResource GridDetailsPaneWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource GridDetailsPaneWidth}" /><Style.Triggers>
            <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /></DataTrigger>
        <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers>
    </Style>
</StackPanel.Style>
                                            <TextBlock Text="{DynamicResource LOCGameDetails}" Margin="0,4,0,0"
                                                       Style="{DynamicResource HeadingTextBlock}" />
                                            <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />

                                            <Border ClipToBounds="True" x:Name="GridMetadataViewport">
                                                <WrapPanel x:Name="GridMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-33,0,-8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-33,-24,-8" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                    <Border x:Name="MetaProgress" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <Button Grid.Column="2" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextPlayTime" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextLastActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaScores" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCUserScore}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaAbout" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCDevelopersLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsDevelopers" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCPublishersLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsPublishers" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <Button Grid.Column="2" x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCSeriesLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsSeries" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsAgeRatings" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemRegion" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCRegionLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsRegions" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaTags" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
