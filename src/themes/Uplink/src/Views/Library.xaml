<!--
    Overlay on Playnite Default/Views/Library.xaml.
    The top bar (TopPanel) sits on its own strip; everything below it is the library layer (ContentBackgroundBrush).
    The game's background art is feathered into that layer: dimmed by a veil in the layer's own brush, then faded out
    toward the left edge and the bottom, so the art reads as atmosphere behind the list, like the menu scenes.
    The fades are plain gradient rectangles to the layer color, not OpacityMasks: masked art repainted in part behind
    animated covers left dark boxes on scaled displays. PART_ImageBackground and the PART_View* names are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TopPanel Grid.Row="0" />

                        <Border Grid.Row="1" x:Name="LibraryRoot" Background="{DynamicResource ContentBackgroundBrush}">
                            <Grid>
                                <Grid IsHitTestVisible="False">
                                    <FadeImage x:Name="PART_ImageBackground" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    <Border Background="{DynamicResource ContentBackgroundBrush}" Opacity="0.55" />
                                    <!-- No OpacityMask on library art: animated covers above it would leave dark boxes on scaled displays
                                         (reference.md). Plain gradients to the layer color fade it out toward the left edge and the bottom. -->
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="{Binding Background.Color, ElementName=LibraryRoot}" />
                                                <GradientStop Offset="0.25" Color="#00000000" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0.45" Color="#00000000" />
                                                <GradientStop Offset="0.95" Color="{Binding Background.Color, ElementName=LibraryRoot}" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>

                                <DockPanel>
                                    <FilterPanel x:Name="PART_FilterPanel"
                                                 DockPanel.Dock="{Settings FilterPanelPosition}"
                                                 Width="{Settings FilterPanelWitdh}"
                                                 Visibility="{Settings FilterPanelVisible}" />

                                    <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                                   DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                                   Width="{Settings ExplorerPanelWitdh}" />

                                    <Grid DockPanel.Dock="Left">
                                        <LibraryDetailsView x:Name="PART_ViewDetails" />
                                        <LibraryGridView x:Name="PART_ViewGrid" />
                                        <LibraryListView x:Name="PART_ViewList" />
                                    </Grid>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
