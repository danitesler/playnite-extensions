<!--
    Overlay on Playnite Default/Views/Library.xaml.
    The top bar (TopPanel) sits on its own strip; everything below it is the library layer (ContentBackgroundBrush).
    The game's background art is feathered into that layer: faded out toward the left edge and the bottom, then
    dimmed by a veil in the layer's own brush, so the art reads as atmosphere behind the list, like the menu scenes.
    Both masks sit inside a bitmap cache: they are composited once per image change, not on every frame the game
    list scrolls over them. PART_ImageBackground and the PART_View* names are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TopPanel Grid.Row="0" />

                        <Border Grid.Row="1" Background="{DynamicResource ContentBackgroundBrush}">
                            <Grid>
                                <Grid IsHitTestVisible="False">
                                    <Grid.CacheMode>
                                        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                    </Grid.CacheMode>
                                    <Grid>
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#00000000" />
                                                <GradientStop Offset="0.25" Color="#FF000000" />
                                                <GradientStop Offset="1" Color="#FF000000" />
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>
                                        <Grid>
                                            <Grid.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#FF000000" />
                                                    <GradientStop Offset="0.45" Color="#FF000000" />
                                                    <GradientStop Offset="0.95" Color="#00000000" />
                                                </LinearGradientBrush>
                                            </Grid.OpacityMask>
                                            <FadeImage x:Name="PART_ImageBackground" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                        </Grid>
                                    </Grid>
                                    <Border Background="{DynamicResource ContentBackgroundBrush}" Opacity="0.55" />
                                </Grid>

                                <DockPanel>
                                    <FilterPanel x:Name="PART_FilterPanel"
                                                 DockPanel.Dock="{Settings FilterPanelPosition}"
                                                 Width="{Settings FilterPanelWitdh}"
                                                 Visibility="{Settings FilterPanelVisible}" />

                                    <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                                   DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                                   Width="{Settings ExplorerPanelWitdh}" />

                                    <Grid DockPanel.Dock="Left">
                                        <LibraryDetailsView x:Name="PART_ViewDetails" />
                                        <LibraryGridView x:Name="PART_ViewGrid" />
                                        <LibraryListView x:Name="PART_ViewList" />
                                    </Grid>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
