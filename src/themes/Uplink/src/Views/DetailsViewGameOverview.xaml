<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml.
    The game info screen of the Details view, laid out like an entry screen of the StarCraft II menus. Header: the title in the
    heading sans over a lit line, then the action buttons, with the cover
    on the right inside a 1px frame and four lit corner ticks. The background art is a short band at the
    top (340px, a fraction of a full-width image) and fades behind the header. Below, two columns split by a 1px: the
    Steam screenshots, description and notes on the left, and Game details on the right ("database entry": every metadata
    field Playnite can show in one pane of six groups split by 1pxs, small-caps captions, ink values, tags as 1px
    plates, values that filter turn light blue on hover; a group goes away with its last visible field).
    Every PART_ name is Playnite's; the pane lays the fields out itself. HtmlForeground and LinkForeground are Color-typed
    properties of HtmlTextView, so they read Color keys (the build check allows exactly these two attributes).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid>
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.CacheMode>
                                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                </Grid.CacheMode>
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#A6000000" Offset="0" />
                                        <GradientStop Color="Black" Offset="0.3" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- Scrim: page color, clear at the top, darker toward the title so any art stays readable. -->
                                <Border Background="{DynamicResource ContentBackgroundBrush}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="Transparent" Offset="0.1" />
                                            <GradientStop Color="#A6000000" Offset="0.4" />
                                            <GradientStop Color="#CC000000" Offset="0.7" />
                                            <GradientStop Color="#E6000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
<Grid>
                            <!-- Background art, a short band. Cached, cropped, faded at the bottom, dimmed by a veil. -->
                            

                            <Grid HorizontalAlignment="Stretch" Margin="24,0,41,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- A short strip of art above the title. Collapses with the hero when the game has no background. -->
                                <Border Grid.Row="0"  IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 100 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <DockPanel Margin="0,24,0,28" MaxWidth="1024" Grid.Row="1"
                                           Background="Transparent">
                                    <!-- Cover: 1px frame, lit corner ticks; the whole frame is hidden while the game has no cover. -->
                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="28,0,6,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageCover}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                                Background="{DynamicResource GridItemBackgroundBrush}">
                                            <Image Name="PART_ImageCover"
                                                   Height="{Settings GameDetailsCoverHeight}"
                                                   StretchDirection="Both" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                        </Border>
                                        <Control Margin="-5" Focusable="False" IsHitTestVisible="False"
                                                 Template="{DynamicResource CornerMarksTemplate}"
                                                 Foreground="{DynamicResource GlyphBrush}" />
                                    </Grid>

                                    <StackPanel VerticalAlignment="Bottom" DockPanel.Dock="Left">
                                        <DockPanel>
                                            <Image Name="PART_ImageIcon" MaxHeight="40" MaxWidth="40"
                                                   DockPanel.Dock="Left" Margin="0,0,14,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock Name="PART_TextDisplayName"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       DockPanel.Dock="Left"
                                                       FontSize="{DynamicResource FontSizeLargest}"
                                                       Typography.Capitals="AllSmallCaps"
                                                       Margin="0,0,10,0" TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button Name="PART_ButtonPlayAction"
                                                    Width="180" Height="40" Style="{DynamicResource PlayButton}" />
                                            <Button Name="PART_ButtonContextAction"
                                                    Width="150" Height="40" />
                                            <Button Name="PART_ButtonMoreActions"
                                                    Width="40" Height="40" Padding="0" Margin="10,0,0,0"
                                                    ToolTip="{DynamicResource LOCMoreAction}">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconOptions}"
                                                                ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame"
                                                    Margin="10,0,0,0" Height="40" Width="40" Padding="0" Focusable="False"
                                                    ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}"
                                                                ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <DockPanel MaxWidth="1024" Grid.Row="2">
                                    <StackPanel DockPanel.Dock="Right" Width="{DynamicResource GameDetailsPaneWidth}"
                                                Margin="28,0,0,0">
                                        <TextBlock Text="{DynamicResource LOCGameDetails}" Margin="0,4,0,0"
                                                   Style="{DynamicResource HeadingTextBlock}" />
                                        <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />

                                        <StackPanel Margin="0,0,0,10">
                                            <Border ClipToBounds="True">
                                                <StackPanel Margin="0,-33,0,-8">
                                                    <Border x:Name="MetaProgress" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <Button Grid.Column="1" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextPlayTime" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextLastActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaScores" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCUserScore}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaAbout" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCDevelopersLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <ItemsControl Grid.Column="1" x:Name="PART_ItemsDevelopers" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCPublishersLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <ItemsControl Grid.Column="1" x:Name="PART_ItemsPublishers" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <Button Grid.Column="1" x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCSeriesLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <ItemsControl Grid.Column="1" x:Name="PART_ItemsSeries" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <ItemsControl Grid.Column="1" x:Name="PART_ItemsAgeRatings" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemRegion" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCRegionLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <ItemsControl Grid.Column="1" x:Name="PART_ItemsRegions" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaTags" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemPlatform" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCPlatformsTitle}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <ItemsControl Grid.Column="1" x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,0,0,-6">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemGenres" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGenresLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <ItemsControl Grid.Column="1" x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,0,0,-6">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemCategories" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCategoriesLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <ItemsControl Grid.Column="1" x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,0,0,-6">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemFeatures" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <ItemsControl Grid.Column="1" x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,0,0,-6">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemTags" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCTagsLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <ItemsControl Grid.Column="1" x:Name="PART_ItemsTags" Tag="Chip" Margin="0,0,0,-6">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaLibrary" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemLibrary" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <Button Grid.Column="1" x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemSource" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCSourceLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <Button Grid.Column="1" x:Name="PART_ButtonSource" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemVersion" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCVersionLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <Button Grid.Column="1" x:Name="PART_ButtonVersion" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemInstallSize" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextInstallSize" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemInstallDirectory" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <Button Grid.Column="1" x:Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaLinks" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemLinks" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCLinksLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <ItemsControl Grid.Column="1" x:Name="PART_ItemsLinks" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,1,0"
                                            Margin="2,0,0,0" Padding="0,0,24,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library or Steam source games in that gap; give up after 12s so a game without screenshots does not keep an empty block. When the plugin is not installed or is disabled the binding fails, FallbackValue=PluginUnavailable matches neither True nor False, and no skeleton shows. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                    <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                    <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <StackPanel Margin="0,0,0,28">
                                                    <TextBlock Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" Margin="0,4,0,0"
                                                               Style="{DynamicResource HeadingTextBlock}" />
                                                    <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />
                                                    <Grid Margin="0,5,0,5">
                                                        <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                        <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                            <Control.Style>
                                                                <Style TargetType="Control">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Control.Style>
                                                        </Control>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Name="PART_ElemDescription" Margin="0,0,0,20">
                                                <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Margin="0,4,0,0"
                                                           Style="{DynamicResource HeadingTextBlock}" />
                                                <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />
                                                <HtmlTextView Name="PART_HtmlDescription"
                                                              Margin="0,5,0,5"
                                                              HtmlFontSize="{DynamicResource FontSize}"
                                                              HtmlFontFamily="{DynamicResource FontFamily}"
                                                              HtmlForeground="{DynamicResource TextColor}"
                                                              LinkForeground="{DynamicResource GlyphColor}"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                              pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                            </StackPanel>

                                            <StackPanel Name="PART_ElemNotes">
                                                <TextBlock Text="{DynamicResource LOCNotesLabel}" Margin="0,4,0,0"
                                                           Style="{DynamicResource HeadingTextBlock}" />
                                                <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />
                                                <TextBox Name="PART_TextNotes" IsReadOnly="True"
                                                         BorderThickness="0" Background="Transparent"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         Margin="-1,5,-1,5" Padding="0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </Grid>
                        </Grid>
</Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>