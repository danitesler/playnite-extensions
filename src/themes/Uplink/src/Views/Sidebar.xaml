<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    The navigation bar of the StarCraft II menus (ScreenNavigationSC2.SC2Layout), turned on its side. Left (Playnite's
    default and the intended layout, like the other themes here) and right make a 44px rail: the bar gradient
    (ShellBackgroundBrush lit by a faint FrameInnerBrush glow toward the library), a 1px line on that edge, the home
    button boxed at the start (48px tall, so its line meets the sub navigation strip's) and icon-only items (SidebarItem.xaml). Top and bottom make the game's horizontal bar:
    56px, the items as uppercase tabs split by short dividers, 146px kept clear for the caption buttons.
    Views/MainWindow.xaml docks the bar with Playnite's Sidebar position.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Home button: a 56px plate with a divider on its right, like the StarCraft II menus' home button at the start of the bar.
         The glyph lights up with a blue glow under the pointer. Also used by Views/TopPanel.xaml. -->
    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid x:Name="Root" Background="{DynamicResource ShellBackgroundBrush}">
                        <!-- The bar gradient ([UI] #090f16 to #121d2b): the glow blue at 10% rising toward the bottom edge (toward the
                             library edge on a rail). -->
                        <Rectangle x:Name="Shade" Fill="{DynamicResource FrameInnerBrush}" Opacity="0.1" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle x:Name="ShadeTop" Fill="{DynamicResource FrameInnerBrush}" Opacity="0.1" IsHitTestVisible="False"
                                   Visibility="Collapsed">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Border x:Name="BorderContentHolder"
                                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,1,0">
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                        Width="44" Height="48" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
                                    <ContentPresenter Width="22" Height="22"
                                                      Content="{DynamicResource IconMainMenu}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Border>

                                <ScrollViewer x:Name="ScrollSidebarItems" DockPanel.Dock="Top"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="True">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Margin" Value="0,36,0,0" TargetName="PART_ElemMainMenu" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Shade" />
                            <Setter Property="Visibility" Value="Visible" TargetName="ShadeTop" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="BorderContentHolder" />
                            <Setter Property="BorderThickness" Value="0,0,1,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Width" Value="56" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="56" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,146,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Shade" />
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="BorderThickness" Value="0,0,1,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Width" Value="56" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
