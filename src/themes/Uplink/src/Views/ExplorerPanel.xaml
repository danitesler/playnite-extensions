<!--
    Overlay on Playnite Default/Views/ExplorerPanel.xaml.
    The explorer panel on the panel layer (TopPanelBackgroundBrush) with a 1px on its inner edge, 16px header padding
    and the list inset 12px. PART_SelectFields, PART_SelectItems and PART_ButtonClose are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ExplorerPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ExplorerPanel}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            Background="{DynamicResource TopPanelBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ExplorerPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="16,12,12,8">
                                <Button Content="r" FontFamily="Marlett"
                                        Style="{StaticResource SimpleButton}"
                                        DockPanel.Dock="Right" Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Name="PART_ButtonClose" />
                                <ComboBox Name="PART_SelectFields" MaxDropDownHeight="Auto"
                                          DockPanel.Dock="Left" />
                            </DockPanel>
                            <ListBox Name="PART_SelectItems"
                                     DockPanel.Dock="Top" Margin="12,0,12,12"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
