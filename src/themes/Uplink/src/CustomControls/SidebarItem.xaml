<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    A navigation button of the StarCraft II menus (BattlenetTopNavButtonTemplate, font style BattlenetTopNav):
    - Top or bottom bar: icon plus the title in uppercase heading type, 56px tall, 20px either side, a short 1px
      divider on the right. Text in TextBrushDarker at rest ([FS] 8dbfea tab color); under the pointer and when
      current it turns white (SelectedForegroundBrush) over a blue glow rising from the bar's edge (FrameInnerBrush,
      [FS] highlightglowcolor 0078ff). The current item adds the lit beam (TabItemIndicatorBrush) along that edge,
      fading out at both ends, and a faint frame (SelectedBrush) inside the cell.
    - Left or right rail: icon only, 56x48, the beam on the edge facing the library; the title is the tooltip.
    Library and Statistics get this theme's icons (IconLibrary, IconStatistics); add-on items keep their own icon,
    scaled into the 16px box. PART_ProgressStatus is a 2px bar along the edge facing the library.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="48" />
        <Setter Property="ToolTip" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="{TemplateBinding Background}">
                        <!-- Blue glow rising from the edge that faces the library: hover at half strength, full when current. -->
                        <Rectangle x:Name="Glow" Fill="{DynamicResource FrameInnerBrush}" Opacity="0" IsHitTestVisible="False"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.OpacityMask>
                                <RadialGradientBrush Center="1,0.5" GradientOrigin="1,0.5" RadiusX="0.9" RadiusY="0.7">
                                    <GradientStop Color="#B0000000" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle x:Name="GlowBar" Fill="{DynamicResource FrameInnerBrush}" Opacity="0" IsHitTestVisible="False"
                                   Visibility="Collapsed">
                            <Rectangle.OpacityMask>
                                <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.6" RadiusY="1">
                                    <GradientStop Color="#B0000000" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>

                        <StackPanel x:Name="Label" Orientation="Horizontal" Margin="20,0,20,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid x:Name="IconHost" Width="16" Height="16" VerticalAlignment="Center">
                                <Viewbox x:Name="ItemIcon">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Viewbox>
                                <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                ContentTemplate="{DynamicResource IconTemplate}" />
                            </Grid>
                            <TextBlock x:Name="Title" Visibility="Collapsed" Margin="10,1,0,0" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="15" FontWeight="SemiBold"
                                       Text="{Binding Title, Converter={StaticResource StringToUpperCaseConverter}}" />
                        </StackPanel>

                        <!-- The lit beam on the current item: bright in the middle, fading out toward both ends. -->
                        <Rectangle x:Name="Beam" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                   Fill="{DynamicResource TabItemIndicatorBrush}" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="0.5" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle x:Name="BeamBar" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource TabItemIndicatorBrush}" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="0.5" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>

                        <!-- Divider between tabs on a bar (the StarCraft II menus' ButtonDivider): 1px, inset from both edges. -->
                        <Rectangle x:Name="Divider" Width="1" Margin="0,14,0,14" HorizontalAlignment="Right"
                                   Fill="{DynamicResource PanelSeparatorBrush}" Visibility="Collapsed" IsHitTestVisible="False" />

                        <ProgressBar x:Name="PART_ProgressStatus" Width="2" HorizontalAlignment="Right"
                                     BorderThickness="0" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.45" TargetName="Glow" />
                            <Setter Property="Opacity" Value="0.45" TargetName="GlowBar" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="Glow" />
                            <Setter Property="Opacity" Value="1" TargetName="GlowBar" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Beam" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="Beam" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="PART_ProgressStatus" />
                            <Setter Property="RenderTransform" TargetName="Glow">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="-1" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Visible" TargetName="Title" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Divider" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glow" />
                            <Setter Property="Visibility" Value="Visible" TargetName="GlowBar" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Beam" />
                            <Setter Property="Width" Value="{x:Static sys:Double.NaN}" TargetName="PART_ProgressStatus" />
                            <Setter Property="Height" Value="2" TargetName="PART_ProgressStatus" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="PART_ProgressStatus" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="PART_ProgressStatus" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Visible" TargetName="Title" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Divider" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glow" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Beam" />
                            <Setter Property="Width" Value="{x:Static sys:Double.NaN}" TargetName="PART_ProgressStatus" />
                            <Setter Property="Height" Value="2" TargetName="PART_ProgressStatus" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="PART_ProgressStatus" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="PART_ProgressStatus" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Selected}" Value="True" />
                                <Condition Binding="{Settings SidebarPosition}" Value="Top" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BeamBar" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Selected}" Value="True" />
                                <Condition Binding="{Settings SidebarPosition}" Value="Bottom" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BeamBar" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="BeamBar" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="56" />
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="56" />
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
