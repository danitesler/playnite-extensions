<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    The inset field of DefaultControls/TextBox.xaml with a 20px 1px search icon before the text and a clear icon
    after it; the edge is brighter blue on hover and light blue with keyboard focus. Playnite's code hides PART_SeachIcon while
    the box has focus or text, so it carries the "Search" placeholder. ShowImage="False" (filter panel fields) drops the
    icon. PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon are Playnite's parts (all three must exist).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Chrome" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <ContentControl x:Name="Glyph" Margin="10,0,0,0" Focusable="False" IsTabStop="False"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                            Foreground="{DynamicResource TextBrushDarker}"
                                            ContentTemplate="{DynamicResource SearchTextIconTemplate}" />
                            <TextBlock x:Name="PART_SeachIcon" Margin="36,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Foreground="{DynamicResource TextBrushDarker}"
                                       Text="{DynamicResource LOCSearchLabel}" />
                            <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                     Padding="34,0,34,0" />
                            <ContentControl x:Name="PART_ClearTextIcon" Margin="0,0,8,0" Focusable="False" IsTabStop="False"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextBrushDarker}"
                                            ContentTemplate="{DynamicResource ClearTextIconTemplate}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Chrome" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Chrome" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glyph" />
                            <Setter Property="Padding" Value="10,0,34,0" TargetName="PART_TextInpuText" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
