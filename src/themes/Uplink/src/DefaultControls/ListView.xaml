<!--
    Overlay on Playnite Default/DefaultControls/ListView.xaml (the row only; the list, its column headers and the header
    scroll viewer are Playnite's). Library list view rows: Default's hover fill, the theme's own selected fill, plus the running game's
    hexagon pip on the far edge (same motif and motion as DetailsViewItemStyle), above both fills.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,1,0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Grid>
                        <Rectangle x:Name="HoverRectangle" Visibility="Collapsed" Fill="{DynamicResource HoverBrush}" />
                        <Rectangle x:Name="SelectedRectangle" Visibility="Collapsed" Fill="{DynamicResource ListItemSelectedBrush}" />
                        <!-- Running game: a hexagon pip in Terran green on the far edge (selection owns the near-edge blue bar), over a faint wash. Its core breathes over 3s while running; the ring blinks twice every 0.8s while launching (warping in). -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Rectangle x:Name="RunningWash" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.15" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.4">
                                <Border.OpacityMask>
                                    <RadialGradientBrush Center="1,0.5" GradientOrigin="1,0.5" RadiusX="1.0" RadiusY="1.0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.35" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </RadialGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2">
                                <Border BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1" Opacity="0.7" />
                            </Border>
                            <Grid Height="3" Margin="8,0,30,3" VerticalAlignment="Bottom" RenderOptions.EdgeMode="Aliased">
                                <Grid.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,7,3" ViewportUnits="Absolute" Viewbox="0,0,7,3" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#FF000000">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,5,3" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Grid.OpacityMask>
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Viewbox Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0">
                                <Canvas Width="12" Height="12">
                                    <Path x:Name="HexRing" RenderTransformOrigin="0.5,0.5" Data="M6,0 L11.2,3 L11.2,9 L6,12 L0.8,9 L0.8,3 Z" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="1.4" StrokeLineJoin="Miter" Opacity="0.8" ><Path.RenderTransform><RotateTransform x:Name="RunningHexSpin" /></Path.RenderTransform></Path>
                                    <Path x:Name="HexCore" Data="M6,3.2 L8.4,4.6 L8.4,7.4 L6,8.8 L3.6,7.4 L3.6,4.6 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.4" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <GridViewRowPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Stretch" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Selector.IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedRectangle" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="HoverRectangle" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1.15" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1.152" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.152" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningHexSpin" Storyboard.TargetProperty="Angle" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="60" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="60" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HexCore" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HexRing" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.8" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.8" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HexCore" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HexRing" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.6" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Selector.IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
