    <Geometry x:Key="IconListView">M4 6 H6 M4 12 H6 M4 18 H6 M9 6 H20 M9 12 H20 M9 18 H20</Geometry>
    <Geometry x:Key="IconUpdate">M12 4 V15 M7 10 L12 15 L17 10 M4.5 19.5 H19.5</Geometry>
    <Geometry x:Key="IconExplorer">M3.5 12 A8.5 8.5 0 1 1 20.5 12 A8.5 8.5 0 1 1 3.5 12 Z M12 12 L17.5 6.5 M12 3.5 V6.5 M12 17.5 V20.5 M3.5 12 H6.5 M17.5 12 H20.5</Geometry>
    <Geometry x:Key="IconRandom">M6 3.5 H18 L20.5 6 V18 L18 20.5 H6 L3.5 18 V6 Z M8.5 8 H10 V9.5 H8.5 Z M14 14.5 H15.5 V16 H14 Z M11.25 11.25 H12.75 V12.75 H11.25 Z</Geometry>
    <Geometry x:Key="IconViewRandom">M3.5 7.5 H8 L16 16.5 H20.5 M18 14 L20.5 16.5 L18 19 M3.5 16.5 H8 L10.5 13.7 M13.5 10.3 L16 7.5 H20.5 M18 5 L20.5 7.5 L18 10</Geometry>
    <Geometry x:Key="IconFilter">M3.5 5 H20.5 L14 12.5 V19.5 L10 17.5 V12.5 Z</Geometry>
    <Geometry x:Key="IconNotifications">M6.5 16 V10 L9 6.5 H15 L17.5 10 V16 L19.5 18 H4.5 Z M10 20.5 H14</Geometry>
    <Geometry x:Key="IconMainMenu">M12 3 L20 7.5 V16.5 L12 21 L4 16.5 V7.5 Z M12 8 L16 10.25 V13.75 L12 16 L8 13.75 V10.25 Z</Geometry>
    <Geometry x:Key="IconLibrary">M4.5 4.5 H8.5 V19.5 H4.5 Z M10.5 4.5 H14.5 V19.5 H10.5 Z M16.3 5.2 L19.9 4.4 L21.6 18.9 L18 19.7 Z</Geometry>
    <Geometry x:Key="IconStatistics">M3.5 20 H20.5 M6 17 V12 M10 17 V7 M14 17 V10 M18 17 V4.5</Geometry>
    <Geometry x:Key="IconWindowMinimize">M6 12 H18</Geometry>
    <Geometry x:Key="IconWindowMaximize">M6.5 6.5 H17.5 V17.5 H6.5 Z</Geometry>
    <Geometry x:Key="IconWindowRestore">M9 9 V5.5 H18.5 V15 H15 M5.5 9 H15 V18.5 H5.5 Z</Geometry>
    <Geometry x:Key="IconWindowClose">M6 6 L18 18 M18 6 L6 18</Geometry>
    <Geometry x:Key="IconDropDown">M6.5 9.5 L12 15 L17.5 9.5</Geometry>
    <Geometry x:Key="IconSubmenu">M9.5 6.5 L15 12 L9.5 17.5</Geometry>
    <Geometry x:Key="IconCheck">M5.5 12.5 L10 17 L18.5 7.5</Geometry>
    <Geometry x:Key="IconAdd">M12 5 V19 M5 12 H19</Geometry>
    <Geometry x:Key="IconEdit">M4.5 19.5 L5.5 15 L15.5 5 L19 8.5 L9 18.5 Z M13 7.5 L16.5 11</Geometry>
    <Geometry x:Key="IconOptions">M10.24 5.43 L10.67 3.1 L13.33 3.1 L13.76 5.43 L15.4 6.11 L17.35 4.77 L19.23 6.65 L17.89 8.6 L18.57 10.24 L20.9 10.67 L20.9 13.33 L18.57 13.76 L17.89 15.4 L19.23 17.35 L17.35 19.23 L15.4 17.89 L13.76 18.57 L13.33 20.9 L10.67 20.9 L10.24 18.57 L8.6 17.89 L6.65 19.23 L4.77 17.35 L6.11 15.4 L5.43 13.76 L3.1 13.33 L3.1 10.67 L5.43 10.24 L6.11 8.6 L4.77 6.65 L6.65 4.77 L8.6 6.11 Z M14.77 13.6 L12 15.2 L9.23 13.6 L9.23 10.4 L12 8.8 L14.77 10.4 Z</Geometry>
    <Geometry x:Key="IconRemove">M5 7 H19 M9.5 7 V4.5 H14.5 V7 M6.5 7 L7.5 20 H16.5 L17.5 7 M10 10.5 V16.5 M14 10.5 V16.5</Geometry>

    <!-- Content = one of the geometries above, drawn as a stroke in the inherited foreground. The host sets the size. -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" StrokeThickness="1.5"
                      StrokeLineJoin="Miter" StrokeMiterLimit="4" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" StrokeThickness="2"
                      StrokeLineJoin="Miter" StrokeMiterLimit="4" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource IconSearch}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource IconClear}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <sys:String x:Key="FullscreenModeIcon">Images/Icons/fullscreen.png</sys:String>
    <sys:String x:Key="AddGameIcon">Images/Icons/add.png</sys:String>
