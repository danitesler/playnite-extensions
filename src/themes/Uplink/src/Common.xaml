<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    The StarCraft II menus are built from a few marks: plates with cut corners and a blue edge, a lit line (beam) under
    whatever is current with a blue glow behind it, short 45-degree ticks at the corners of a frame, and uppercase
    headings in an extended sans. ChamferTemplate, CornerMarksTemplate and DividerTemplate are those marks as reusable
    pieces, each drawn from brushes of the Control that hosts it, so a brush key recolors them; HeadingTextBlock is the
    caption style above a block.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- A plate with its four corners cut at 45 degrees (6px), filled with the host's Background and edged 1px with its
         BorderBrush. Host: a Control stretched behind the content, hit testing off. -->
    <ControlTemplate x:Key="ChamferTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
                <RowDefinition Height="6" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Background}" />
            <Path Grid.Row="0" Grid.Column="0" Data="M6,0 L6,6 L0,6 Z" Fill="{TemplateBinding Background}" />
            <Path Grid.Row="0" Grid.Column="2" Data="M0,0 L6,6 L0,6 Z" Fill="{TemplateBinding Background}" />
            <Path Grid.Row="2" Grid.Column="0" Data="M0,0 L6,0 L6,6 Z" Fill="{TemplateBinding Background}" />
            <Path Grid.Row="2" Grid.Column="2" Data="M0,0 L6,0 L0,6 Z" Fill="{TemplateBinding Background}" />

            <Rectangle Grid.Row="0" Grid.Column="1" Height="1" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Grid.Row="2" Grid.Column="1" Height="1" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Grid.Row="1" Grid.Column="0" Width="1" HorizontalAlignment="Left" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Width="1" HorizontalAlignment="Right" Fill="{TemplateBinding BorderBrush}" />
            <Path Grid.Row="0" Grid.Column="0" Data="M0.5,6 L6,0.5" StrokeThickness="1" Stroke="{TemplateBinding BorderBrush}" />
            <Path Grid.Row="0" Grid.Column="2" Data="M0,0.5 L5.5,6" StrokeThickness="1" Stroke="{TemplateBinding BorderBrush}" />
            <Path Grid.Row="2" Grid.Column="0" Data="M0.5,0 L6,5.5" StrokeThickness="1" Stroke="{TemplateBinding BorderBrush}" />
            <Path Grid.Row="2" Grid.Column="2" Data="M0,5.5 L5.5,0" StrokeThickness="1" Stroke="{TemplateBinding BorderBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- The corners of a lit frame: at each corner a 45-degree tick (6px) with a 10px stub along both edges, 1.5px wide,
         in the host's Foreground. Host: a Control with Foreground set and hit testing off, stretched over the item it
         marks (hover, selection, keyboard focus). -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Data="M16,0.75 L6.75,0.75 L0.75,6.75 L0.75,16" StrokeThickness="1.5" Stroke="{TemplateBinding Foreground}" />
            <Path Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Data="M0,0.75 L9.25,0.75 L15.25,6.75 L15.25,16" StrokeThickness="1.5" Stroke="{TemplateBinding Foreground}" />
            <Path Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Data="M15.25,0 L15.25,9.25 L9.25,15.25 L0,15.25" StrokeThickness="1.5" Stroke="{TemplateBinding Foreground}" />
            <Path Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  Data="M0.75,0 L0.75,9.25 L6.75,15.25 L16,15.25" StrokeThickness="1.5" Stroke="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- A lit line: a bright 2px segment at the left end, then a 1px line that fades out to the right, like the beam
         under a current navigation button. Host: a Control with Foreground set; it is 3px tall and as wide as its parent. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="{x:Type Control}">
        <Grid Height="3" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0.6">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="28" Height="3" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- Caption above a block of properties, a description or notes: the extended heading sans, semibold, in the light
         blue of the StarCraft II menus' labels ([FS] GlueLabel). Small caps where the font has them; shown as typed otherwise. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <!-- Keyboard focus (WPF shows it for the keyboard only): the lit corner ticks, just outside the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Margin="-3" IsHitTestVisible="False" Focusable="False"
                             Template="{DynamicResource CornerMarksTemplate}"
                             Foreground="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing: roomy like the StarCraft II menus (34 to 38px controls, 8px rhythm). -->
    <Thickness x:Key="ButtonPadding">20,9,20,9</Thickness> <!-- Button: 36px tall, uppercase label in the heading sans -->
    <Thickness x:Key="InputPadding">10,7,10,7</Thickness> <!-- Text box, password box, dropdown: 34px -->
    <Thickness x:Key="MenuPadding">4</Thickness> <!-- Menu and context menu surface -->
    <Thickness x:Key="MenuItemPadding">14,8,14,8</Thickness> <!-- Menu item: 34px -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness> <!-- Dropdown surface -->
    <Thickness x:Key="ComboBoxItemPadding">12,7,12,7</Thickness> <!-- Dropdown item -->
    <Thickness x:Key="ListBoxItemPadding">12,7,12,7</Thickness> <!-- List box item -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness> <!-- Group box body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness> <!-- Gap under the group box header -->
    <Thickness x:Key="TooltipPadding">12,7,12,8</Thickness> <!-- Tooltip -->
    <sys:Double x:Key="IconSize">20</sys:Double> <!-- Top bar and sidebar icons -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">280</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, so the real carousel replaces it without the page jumping. Each Viewbox scales a fixed 1600px
         layout to the width its column gives it (height is unbounded in a vertical stack). The tiles are the host's
         Foreground at low opacity; the whole thing pulses while visible. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the plugin's ContentControl, visible while that control has no height. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="0"
                        Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
