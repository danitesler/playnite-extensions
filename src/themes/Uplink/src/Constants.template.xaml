<!--
    Uplink: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from tokens.css and
    writes the result to the build as Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo: Playnite's
    palette keys, then shared keys for roles Playnite has none for. Each placeholder names the token that plays the
    role (cyan is the accent, glow the lit blue behind current items, text the ink, void to hull the surfaces), so the
    values live in tokens.css and here only. Theme XAML reads the brushes (never the Color keys), so ThemeModifier
    edits reach every control.

    Layering, deepest first: void (window), deck (library), hull (top bar, panels), plate (buttons), popup (menus).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). HeadingFontFamily is a shared key: navigation, titles and section headings. -->
    <sys:Double x:Key="FontSizeSmall">{{px:size-caption}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:size-body}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:size-lead}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:size-title}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:size-display}}</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Segoe UI}}</FontFamily>

    <!-- Shape (Playnite keys): 1px strokes, square corners; the chamfers are drawn by the templates. -->
    <Thickness x:Key="PopupBorderThickness">{{px:stroke-hair}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:stroke-hair}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:stroke-hair}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:corner-none}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor (selection, checked, links) is the StarCraft II menus' light blue; TextColorDark is the dark ink the StarCraft II menus put on
        a lit tab. HoverColor is a translucent blue veil so one value works on every surface. PopupBorderColor is
        flattened onto the popup surface because WPF popups are layered windows.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{text}}</Color>
    <Color x:Key="TextColorDarker">{{text-soft}}</Color>
    <Color x:Key="TextColorDark">{{on-bright}}</Color>
    <Color x:Key="MainColor">{{hull}}</Color>
    <Color x:Key="MainColorDark">{{deck}}</Color>
    <Color x:Key="HoverColor">{{veil-strong}}</Color>
    <Color x:Key="GlyphColor">{{cyan}}</Color>
    <Color x:Key="HighlightGlyphColor">{{glow-haze}}</Color>
    <Color x:Key="PopupBackgroundColor">{{popup}}</Color>
    <Color x:Key="PopupBorderColor">{{line-blue}}</Color>
    <Color x:Key="BackgroundToneColor">{{hull}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{plate/60}}</Color>   <!-- the slot behind each cover -->
    <Color x:Key="PanelSeparatorColor">{{line}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{line}}</Color>
    <Color x:Key="DataChangeNotifColor">{{gold}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{line-blue}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{popup}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{red-light}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{orange}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{red-light}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{hull}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{void}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell: the navigation bar (top panel) is the lightest band, the library sits in deep space below it -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{nav-top}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{deck}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{hull}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{void/70}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{void/90}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{text-nav}}" />

    <!-- States: a lit blue wash fills the current row, the light blue marks it -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{glow-wash}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{glow-haze}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{veil}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{glow-wash}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{veil-strong}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{beam}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{glow}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{white}}" />

    <!-- Buttons: a dark blue plate with a blue frame; Play and the default button are the lit blue plate -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{text-button}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{line-blue}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{plate-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{glow-haze}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{cta}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{cta-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{cta-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{glow-wash}}" />

    <!-- Inputs: a dark inset with the blue frame, brighter on hover, the beam on focus -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{void/70}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{line-blue-hover}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{line-blue-hover}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{cyan}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{line-blue}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{beam}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{beam}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{line-blue}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{veil}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{line-blue}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{beam}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{edge-glow}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{cyan}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{veil-strong}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{glow-wash}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{text-soft}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{plate-hover}}" />

    <!-- Frames: the lit edge of the portrait frame, used around covers and the current navigation button -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{edge-glow}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{glow}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{line-blue}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{line}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{text}}" />
</ResourceDictionary>
