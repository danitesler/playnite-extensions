<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml.
    A cover as the portrait frame of the StarCraft II menus: at rest a 1px blue slot edge (SlotBorderBrush).
    Selected (static, setters): a 2px frame in the portrait frame's glow blue (FrameBrush), the glow along the edges and
    the lit corner ticks in the beam color.
    Hover is animated both ways, on its own layers (no setters on animated parts, so nothing snaps). The menus fade a
    hover frame in over 0.4s and back out over 0.4s (RESEARCH.md -> Motion), so:
      in  0.4s ease in-out: the light blue edge and the blue glow creeping in from the cover edges (FrameInnerBrush,
          strongest at the bottom) fade in; the lit corner ticks fade in and close around the cover from 8% outside
          (0.3s ease-out); while hovered the glow breathes on the selected-tab loop (1.2s each way).
      out 0.4s: everything fades back; exit animations use FillBehavior Stop so no clock outlives the fade.
    The ticks sit 4px outside the cover, in the gutter that ItemSpacingMargin and the list's padding leave. Library art
    behind the grid has no OpacityMask (reference.md -> masked art behind animated controls); the glow's own mask is the
    effect layer itself.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <ContentPresenter />
                        <!-- Selected: static -->
                        <Rectangle x:Name="SelectGlow" Fill="{DynamicResource FrameInnerBrush}" Opacity="0.7" IsHitTestVisible="False" Visibility="Collapsed">
                            <Rectangle.OpacityMask>
                                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.3" RadiusX="0.75" RadiusY="0.75">
                                    <GradientStop Color="Transparent" Offset="0.55" />
                                    <GradientStop Color="#A0000000" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <!-- Hover: animated (the Pulse wrapper carries the breathing loop, the glow carries the fade) -->
                        <Grid x:Name="Pulse" IsHitTestVisible="False">
                            <Rectangle x:Name="HoverGlow" Fill="{DynamicResource FrameInnerBrush}" Opacity="0" Visibility="Hidden">
                                <Rectangle.OpacityMask>
                                    <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.3" RadiusX="0.75" RadiusY="0.75">
                                        <GradientStop Color="Transparent" Offset="0.55" />
                                        <GradientStop Color="#A0000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                        <Border x:Name="SelectionBorder" BorderThickness="1" Margin="-1" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource SlotBorderBrush}" />
                        <Border x:Name="HoverBorder" BorderThickness="1" Margin="-1" IsHitTestVisible="False" Opacity="0"
                                BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                        <Control x:Name="Marks" Margin="-4" Focusable="False" IsHitTestVisible="False" Visibility="Collapsed"
                                 Template="{DynamicResource CornerMarksTemplate}"
                                 Foreground="{DynamicResource FocusBrush}" />
                        <Control x:Name="HoverMarks" Margin="-4" Focusable="False" IsHitTestVisible="False" Opacity="0" Visibility="Hidden"
                                 Template="{DynamicResource CornerMarksTemplate}" RenderTransformOrigin="0.5,0.5"
                                 Foreground="{DynamicResource GridViewItemHoverBorderBrush}">
                            <Control.RenderTransform>
                                <ScaleTransform x:Name="HoverMarksScale" ScaleX="1" ScaleY="1" />
                            </Control.RenderTransform>
                        </Control>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="HoverMarksScale" Storyboard.TargetProperty="ScaleX" From="1.08" To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverMarksScale" Storyboard.TargetProperty="ScaleY" From="1.08" To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True" BeginTime="0:0:0.4">
                                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From="1" To="0.65" Duration="0:0:1.2">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.4" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.4" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" TargetName="SelectionBorder" />
                            <Setter Property="BorderThickness" Value="2" TargetName="SelectionBorder" />
                            <Setter Property="Margin" Value="-2" TargetName="SelectionBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectGlow" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Marks" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
