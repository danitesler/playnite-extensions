<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml.
    A cover as the portrait frame of the StarCraft II menus: at rest a 1px blue slot edge (SlotBorderBrush). Under the
    pointer the edge turns light blue, a blue glow creeps in from the edges of the cover (FrameInnerBrush, strongest at
    the bottom) and the lit corner ticks close around it. The current game keeps a 2px frame in the portrait frame's
    glow blue (FrameBrush) with the ticks in the beam color. The ticks sit 4px outside the cover, in the gutter that
    ItemSpacingMargin and the list's padding leave.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <ContentPresenter />
                        <Rectangle x:Name="Glow" Fill="{DynamicResource FrameInnerBrush}" Opacity="0" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.3" RadiusX="0.75" RadiusY="0.75">
                                    <GradientStop Color="Transparent" Offset="0.55" />
                                    <GradientStop Color="#A0000000" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Border x:Name="SelectionBorder" BorderThickness="1" Margin="-1" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource SlotBorderBrush}" />
                        <Control x:Name="Marks" Margin="-4" Focusable="False" IsHitTestVisible="False" Visibility="Collapsed"
                                 Template="{DynamicResource CornerMarksTemplate}"
                                 Foreground="{DynamicResource GridViewItemHoverBorderBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemHoverBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Opacity" Value="1" TargetName="Glow" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Marks" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" TargetName="SelectionBorder" />
                            <Setter Property="BorderThickness" Value="2" TargetName="SelectionBorder" />
                            <Setter Property="Margin" Value="-2" TargetName="SelectionBorder" />
                            <Setter Property="Opacity" Value="0.7" TargetName="Glow" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Marks" />
                            <Setter Property="Foreground" Value="{DynamicResource FocusBrush}" TargetName="Marks" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
