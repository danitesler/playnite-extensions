<!--
    Uplink: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    The glue menus' navigation bar turned into a 40px band: the navigation gradient lifted by a blue glow from its lower
    edge, the title on a sub navigation plate (the game's four cut corners, ChamferTemplate) with the lit beam under it
    fading out at both ends, as under the current navigation button, and a status tick ruler plus the hex mark ghosted
    into the right end. A blue panel edge closes the band. Caption buttons are the 44x40 WindowBarButton icons, so the
    caption and the content offset are 40 (Default: 25). PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="40" VerticalAlignment="Top" Background="{DynamicResource ShellBackgroundBrush}" ClipToBounds="True">
                                    <!-- Blue glow rising from the band's lower edge (the navigation bar's lighter bottom). -->
                                    <Rectangle IsHitTestVisible="False" Fill="{DynamicResource FrameInnerBrush}" Opacity="0.35">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="Transparent" Offset="0.3" />
                                                <GradientStop Color="#55000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <!-- Hex mark and status ticks, in a Canvas so they add no desired width. -->
                                    <Canvas IsHitTestVisible="False">
                                        <ContentControl Canvas.Right="150" Canvas.Top="-24" Width="88" Height="88" Opacity="0.07"
                                                        Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource TextBrush}" />
                                        <Path Canvas.Right="252" Canvas.Top="15" Data="M0,0 H132" Stroke="{DynamicResource NormalBorderBrush}"
                                              StrokeThickness="8" StrokeDashArray="0.125 0.625" />
                                    </Canvas>
                                    <Rectangle Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{DynamicResource NormalBorderBrush}" />
                                    <DockPanel LastChildFill="False">
                                        <!-- The title on a sub navigation plate with the lit beam under it. -->
                                        <Grid DockPanel.Dock="Left" Margin="14,6,0,6">
                                            <Control Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource SelectedBrush}"
                                                     BorderBrush="{DynamicResource FrameBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                            <TextBlock Text="{TemplateBinding Title}" Margin="20,0,20,0" VerticalAlignment="Center" MaxWidth="440"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                                       Foreground="{DynamicResource SelectedForegroundBrush}" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                            <Rectangle Height="2" Margin="-8,0,-8,-6" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                                       Fill="{DynamicResource TabItemIndicatorBrush}">
                                                <Rectangle.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="Transparent" Offset="0" />
                                                        <GradientStop Color="Black" Offset="0.2" />
                                                        <GradientStop Color="Black" Offset="0.8" />
                                                        <GradientStop Color="Transparent" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,2,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,40,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the plate shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
