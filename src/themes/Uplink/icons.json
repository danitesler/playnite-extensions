{
    "_comment": "Menu icons this theme ships. Sources: icons/*.svg, written by art/icons.py (original artwork). Rendered on Windows by .\\scripts\\render-icons.ps1 -Extension uplink, or anywhere with Chromium by node art/render-png.mjs. Colors are the text-soft, red-light and cyan tokens (src/tokens.css); re-run after changing them. Media.xaml maps Playnite's *Icon keys to these files.",
    "jobs": [
        {
            "svgDir": "icons",
            "format": "Png",
            "outDir": "src/Images/Icons",
            "size": 48,
            "color": "#8dbfea",
            "icons": [
                "fullscreen", "add", "sync", "info", "settings", "addons", "play", "install", "links", "folder",
                "database", "desktop-shortcut", "star", "eye-closed", "eye", "sun", "edit", "random", "book",
                "archive", "history"
            ]
        },
        {
            "svgDir": "icons",
            "format": "Png",
            "outDir": "src/Images/Icons",
            "size": 48,
            "color": "#ffaaaa",
            "suffix": "-danger",
            "icons": [ "exit", "remove" ]
        },
        {
            "svgDir": "icons",
            "format": "Png",
            "outDir": "src/Images/Icons",
            "size": 48,
            "color": "#5cdeff",
            "icons": [ "star-fill" ]
        }
    ]
}
