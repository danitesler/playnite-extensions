<!--
    Umbralune: Views/Sidebar.xaml.
    44px abyssal sapphire rail closed by a sapphire-gold hairline and crescent foot motif,
    crowned by the animated Umbran Crescent Watch main-menu button (LocalUmbraluneMenuMarkTemplate).
    Turns transparent under ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}"
                            BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,1,0"
                            Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <!-- Subtle vertical sapphire nebula & upper antique-gold edge gleam -->
                            <Grid x:Name="RailDecor" IsHitTestVisible="False">
                                <Control Template="{DynamicResource LocalNebulaTemplate}"
                                         Foreground="{DynamicResource ButtonPressedBackgroundBrush}" Opacity="0.16" />
                                <Rectangle Width="1" Height="130" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,0,0"
                                           Fill="{DynamicResource GiltDimBrush}" Opacity="0.55">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF000000" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>

                            <DockPanel x:Name="DockContentHolder">
                                <!-- 44x50 Main Menu Button hosting LocalUmbraluneMenuMarkTemplate -->
                                <Border x:Name="PART_ElemMainMenu" DockPanel.Dock="Top"
                                        Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                        BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,0,1"
                                        Width="44" Height="50" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Border x:Name="MenuHoverWash" Background="{DynamicResource ListItemHoverBrush}"
                                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                        <Rectangle x:Name="MenuBottomBeam" Height="2" Margin="6,0,6,0" VerticalAlignment="Bottom"
                                                   Fill="{DynamicResource GlyphBrush}" Opacity="0.82" IsHitTestVisible="False" />
                                        <Control x:Name="MenuMark"
                                                 Template="{DynamicResource LocalUmbraluneMenuMarkTemplate}"
                                                 Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                 Focusable="False" IsTabStop="False" />
                                    </Grid>
                                </Border>

                                <!-- Crescent-moon foot colophon -->
                                <StackPanel x:Name="RailFootColophon" DockPanel.Dock="Bottom" Margin="0,6,0,12"
                                            HorizontalAlignment="Center" IsHitTestVisible="False" Opacity="0.68">
                                    <Rectangle Width="1" Height="26" HorizontalAlignment="Center" Fill="{DynamicResource GiltDimBrush}">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Path Width="12" Height="12" Margin="0,6,0,0" Stretch="Uniform"
                                          Fill="{DynamicResource GiltDimBrush}"
                                          Data="M9.5,2 A6,6 0 1 0 9.5,14 A4.6,4.6 0 1 1 9.5,2 Z" />
                                </StackPanel>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True" Margin="0,6,0,0"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="BorderThickness" Value="0" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailDecor" />
                            <Setter Property="Background" Value="Transparent" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootColophon" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverWash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverWash" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="MenuHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverWash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverWash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Padding" Value="0,25,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootColophon" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,136,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootColophon" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
