<!--
    Umbralune: Views/DetailsViewGameOverview.xaml (generated by art/build-overviews.mjs).
    Nocturnal Umbran Sapphire game page:
    - Full-bleed hero art melting across a cyan-flared Umbran Horizon seam (LocalFlareBeamTemplate) with GameBannerDarken + 50% floor.
    - Hero Solar Halo Gold Play CTA + RunningActionIndicator + equal square icon-only More & Edit buttons.
    - Chapter V Midnight-Sapphire & Gold Filigree Tarot Metadata Dossier (300px usable width, vertical gold filigree lace,
      4 corner studs, violet-amethyst HARD rune ribbons collapsing cleanly in Center/Stretch).
    - Designed Umbran Watch EmptyGameTemplate with PART_ScrollViewHost explicitly Visibility="Visible".
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <Grid x:Name="PageRoot" SnapsToDevicePixels="True"
                          d:DesignWidth="1050" d:DesignHeight="820"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- Ambient astral nebula + centered Umbran Watch watermark (collapsed under window art) -->
                        <Grid x:Name="PageAtmosphere" ClipToBounds="True" IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Control Template="{DynamicResource LocalNebulaTemplate}"
                                     Foreground="{DynamicResource ButtonPressedBackgroundBrush}" Opacity="0.14" />
                            <Control Width="460" Height="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Template="{DynamicResource LocalWatchWatermarkTemplate}"
                                     Foreground="{DynamicResource GlyphBrush}" Opacity="0.065" />
                        </Grid>

                        <ScrollViewer x:Name="PART_ScrollViewHost" Visibility="Visible"
                                      CanContentScroll="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                            <Grid>
                                <!-- Hero Art Layer -->
                                <Grid x:Name="HeroArt" VerticalAlignment="Top" ClipToBounds="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                                <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                    <Setter Property="Height" Value="0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                    <Setter Property="Height" Value="0" />
                                                </DataTrigger>
                                                    <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                    <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <!-- Seamless Midnight Sapphire bottom fade -->
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#1406112A" Offset="0" />
                                                <GradientStop Color="#6606112A" Offset="0.55" />
                                                <GradientStop Color="#FF06112A" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>

                                <!-- Selected Game Content Stack -->
                                <StackPanel x:Name="GameContent" Panel.ZIndex="2" Margin="24,0,24,28">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border x:Name="BannerSpacer" MinHeight="20" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 168 / 320'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                        <Setter Property="Height" Value="20" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
                                                        <Setter Property="Height" Value="20" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Header Band (Panel.ZIndex=2 on StackPanel & DockPanel keeps inline close button clickable while scrolling) -->
                                    <StackPanel x:Name="HeaderBlock" Panel.ZIndex="2" Margin="0,0,0,18">
                                        <DockPanel Panel.ZIndex="2" Margin="0,0,0,14">
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left"
                                                   MaxWidth="44" MaxHeight="44" Margin="0,0,14,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="Fant" Stretch="Uniform" />

                                            <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="{DynamicResource FontSizeLargest}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap" />
                                        </DockPanel>

                                        <!-- Hero Action Bar: Solar Halo Play + RunningActionIndicator + More & Edit squares -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Margin="0,0,10,0">
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" Tag="ContextAction" />
                                                <Control Style="{DynamicResource RunningActionIndicator}" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Style="{DynamicResource SecondaryButton}"
                                                    Width="38" Height="38" MinWidth="38" MinHeight="38" Margin="0,0,8,0"
                                                    ToolTip="{DynamicResource LOCMoreAction}">
                                                <ContentControl Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Style="{DynamicResource SecondaryButton}"
                                                    Width="38" Height="38" MinWidth="38" MinHeight="38"
                                                    ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Cover art (shown only when Playnite's ShowCoverImage setting enables it) -->
                                    <Image x:Name="PART_ImageCover" MaxHeight="240" HorizontalAlignment="Left"
                                           Margin="0,0,0,16" RenderOptions.BitmapScalingMode="Fant" />

                                    <!-- Responsive Body: Main Column (Screenshots + Notes + Description) | Tarot Metadata Dossier -->
                                    <Grid x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
<Border x:Name="MetaPane" VerticalAlignment="Top"
                                                Background="{DynamicResource TopPanelBackgroundBrush}"
                                                BorderBrush="{DynamicResource GiltDimBrush}" BorderThickness="1"
                                                CornerRadius="{DynamicResource ControlCornerRadius}" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                            <Grid>
                                                <!-- Inner hairline frame -->
                                                <Border Margin="4" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                                                        BorderThickness="1" CornerRadius="2" IsHitTestVisible="False" />
                                                <!-- Vertical antique-gold filigree lace strip on right margin -->
                                                <Control Width="12" HorizontalAlignment="Right" Margin="0,10,3,10"
                                                         Template="{DynamicResource LocalFiligreeLaceTemplate}"
                                                         Foreground="{DynamicResource GiltDimBrush}" Opacity="0.42" IsHitTestVisible="False" />
                                                <!-- Four Tarot Corner Gold Diamond Studs -->
                                                <Polygon Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                         Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource GiltBrush}" IsHitTestVisible="False" />
                                                <Polygon Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                         Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource GiltBrush}" IsHitTestVisible="False" />
                                                <Polygon Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                                         Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource GiltBrush}" IsHitTestVisible="False" />
                                                <Polygon Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                                         Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource GiltBrush}" IsHitTestVisible="False" />

                                                <StackPanel Margin="14,12,20,14" Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch" x:Name="DetailsMetadataContent">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                    <!-- Tarot Crest Header -->
                                                    <Grid Margin="0,0,0,8" IsHitTestVisible="False">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center" Fill="{DynamicResource GiltDimBrush}" Opacity="0.7" />
                                                        <TextBlock Grid.Column="1" Text="UMBRAN ARCHIVE" Margin="8,0"
                                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="14" FontWeight="Bold"
                                                                   Foreground="{DynamicResource HeadingForegroundBrush}" VerticalAlignment="Center" />
                                                        <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{DynamicResource GiltDimBrush}" Opacity="0.7" />
                                                    </Grid>

                                                    <Border x:Name="DetailsMetadataViewport">
                                                        <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,0,-24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Margin" Value="0,-5,0,-5" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-5,-24,-5" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Margin" Value="0,-5,0,-5" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-5,-24,-5" /></MultiDataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                            <Border x:Name="MetaProgress" Padding="0"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,2,0,0" /><Style.Triggers><MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid Height="22" Margin="0,0,0,7" IsHitTestVisible="False">
                                                                        <Border Background="{DynamicResource HeaderBandBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="0,1">
                                                                            <Border.OpacityMask>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                    <GradientStop Color="#00000000" Offset="0" />
                                                                                    <GradientStop Color="#FF000000" Offset="0.16" />
                                                                                    <GradientStop Color="#FF000000" Offset="0.84" />
                                                                                    <GradientStop Color="#00000000" Offset="1" />
                                                                                </LinearGradientBrush>
                                                                            </Border.OpacityMask>
                                                                        </Border>
                                                                        <Control Template="{DynamicResource LocalRuneBandTemplate}" Foreground="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.34" />
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Polygon Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0" Points="2.5,0 5,2.5 2.5,5 0,2.5" Fill="{DynamicResource GiltDimBrush}" />
                                                                            <TextBlock Text="PLAY RECORD" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="12.5" FontWeight="Bold"
                                                                                       Foreground="{DynamicResource HeaderBandForegroundBrush}" VerticalAlignment="Center" />
                                                                            <Polygon Width="5" Height="5" VerticalAlignment="Center" Margin="7,0,0,0" Points="2.5,0 5,2.5 2.5,5 0,2.5" Fill="{DynamicResource GiltDimBrush}" />
                                                                        </StackPanel>
                                                                    </Grid>
</Border>
<Grid x:Name="PART_ElemCompletionStatus" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,5,0,5" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,5,24,5" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="110" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,10,0" />
                                                                        <Button Grid.Column="1" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PropertyItemButton}" />
                                                                    </Grid>
<Grid x:Name="PART_ElemPlayTime" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,5,0,5" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,5,24,5" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="110" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,10,0" />
                                                                        <TextBlock Grid.Column="1" x:Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                    </Grid>
<Grid x:Name="PART_ElemLastPlayed" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,5,0,5" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,5,24,5" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="110" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,10,0" />
                                                                        <TextBlock Grid.Column="1" x:Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                    </Grid>
<Grid x:Name="PART_ElemRecentActivity" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,5,0,5" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,5,24,5" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="110" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,10,0" />
                                                                        <TextBlock Grid.Column="1" x:Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                    </Grid>
<Grid x:Name="PART_ElemAdded" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,5,0,5" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,5,24,5" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="110" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCDateAddedLabel}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,10,0" />
                                                                        <TextBlock Grid.Column="1" x:Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                    </Grid>
<Border x:Name="MetaScores" Padding="0"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,8,0,0" /><Style.Triggers><MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid Height="22" Margin="0,0,0,7" IsHitTestVisible="False">
                                                                        <Border Background="{DynamicResource HeaderBandBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="0,1">
                                                                            <Border.OpacityMask>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                    <GradientStop Color="#00000000" Offset="0" />
                                                                                    <GradientStop Color="#FF000000" Offset="0.16" />
                                                                                    <GradientStop Color="#FF000000" Offset="0.84" />
                                                                                    <GradientStop Color="#00000000" Offset="1" />
                                                                                </LinearGradientBrush>
                                                                            </Border.OpacityMask>
                                                                        </Border>
                                                                        <Control Template="{DynamicResource LocalRuneBandTemplate}" Foreground="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.34" />
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
