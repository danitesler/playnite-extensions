<!--
    Umbralune: DerivedStyles/PlayButton.xaml.
    Hero Focal Piece 1 — Solar Halo Gold Play Slab (Bayonetta 2 Title Screen "2" flare):
    - Rest: sculpted Solar Halo Gold plate (PrimaryButtonBackgroundBrush) with engraved inner hairline,
      diagonal satin sheen (LocalGoldSheenTemplate), paired antique-gold diamond end-notches, and Cinzel Decorative ink.
    - Hover: smooth 160ms golden-bright lift + horizontal Moon-Cyan optical flare (LocalFlareBeamTemplate) slicing the top bevel
      + cyan diamond end-sparks; separate PressedPlate layer on press.
    - Launching / Running: solid Witch-Time Amethyst (RunningIndicatorBrush) darkened by RunningBreath scrim (Starlight text >=6:1),
      diagonal RunningScan sweep during launch, PlayRoom right padding (48px) reserving clean space for the 3 pulsing Magic Orbs
      in RunningActionIndicator; Cancel label on IsRunning + IsMouseOver(Self) hiding PlayContent via Visibility=Hidden.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinWidth" Value="168" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="24,0,24,0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Main Plate -->
                        <Border x:Name="PlayFill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <!-- Diagonal satin metallic polish -->
                                <Control x:Name="PlaySheen" Template="{DynamicResource LocalGoldSheenTemplate}"
                                         Foreground="{DynamicResource TextBrush}" Opacity="0.34" IsHitTestVisible="False" />

                                <!-- Animated Idle Hover Layer wrapped in IdleHoverHost (collapsed while launching/running) -->
                                <Grid x:Name="IdleHoverHost" IsHitTestVisible="False">
                                    <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                        <Border Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                                        <Control Template="{DynamicResource LocalGoldSheenTemplate}"
                                                 Foreground="{DynamicResource TextBrush}" Opacity="0.46" />
                                    </Grid>
                                </Grid>

                                <!-- Separate Pressed Layer -->
                                <Border x:Name="PressedPlate" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" IsHitTestVisible="False" />

                                <!-- Running / Launching Darkening Scrim (keeps Starlight label >= 5:1) -->
                                <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}"
                                        Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

                                <!-- Launching Diagonal Witch-Time Amethyst Scan Sweep -->
                                <Border x:Name="RunningScan" Visibility="Collapsed"
                                        Background="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.46" IsHitTestVisible="False">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.32">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>

                                <!-- Running + Hover Dim Layer (below label, shown only with Cancel) -->
                                <Border x:Name="RunningHoverDim" Background="{DynamicResource DangerBrush}"
                                        Opacity="0" IsHitTestVisible="False" />

                                <!-- Engraved inner hairline frame -->
                                <Border Margin="3" BorderBrush="{DynamicResource ScrimBrush}"
                                        BorderThickness="1" CornerRadius="2" Opacity="0.28" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <!-- Hovered Horizontal Moon-Cyan Optical Star-Flare along top bevel (wrapped in IdleFlareHost) -->
                        <Grid x:Name="IdleFlareHost" IsHitTestVisible="False">
                            <Control x:Name="HoverFlare" Height="16" VerticalAlignment="Top" Margin="-10,-7,-10,0"
                                     Template="{DynamicResource LocalFlareBeamTemplate}"
                                     Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                     Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        </Grid>

                        <!-- Paired Left & Right Crescent-Filigree Diamond End-Notches -->
                        <Polygon x:Name="NotchL" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="-4,0,0,0" Points="4,0 8,4 4,8 0,4"
                                 Fill="{DynamicResource GiltDimBrush}" Stroke="{DynamicResource ShellBackgroundBrush}" StrokeThickness="1.2"
                                 IsHitTestVisible="False" />
                        <Polygon x:Name="NotchR" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,0,-4,0" Points="4,0 8,4 4,8 0,4"
                                 Fill="{DynamicResource GiltDimBrush}" Stroke="{DynamicResource ShellBackgroundBrush}" StrokeThickness="1.2"
                                 IsHitTestVisible="False" />

                        <!-- Label & Cancel Layer with RunningMarkRoom reservation -->
                        <Grid Margin="{TemplateBinding Padding}">
                            <Border x:Name="PlayRoom" Padding="0">
                                <ContentPresenter x:Name="PlayContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DangerForegroundBrush}"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                            <Setter TargetName="NotchL" Property="Fill" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                            <Setter TargetName="NotchR" Property="Fill" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFlare" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="HoverFlare" Storyboard.TargetProperty="Opacity" To="0.96" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="HoverFlare" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFlare" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!-- RunningMarkRoom left="0" right="46" -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PlayFill" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource LaunchingIndicatorBrush}" />
                            <Setter TargetName="NotchL" Property="Fill" Value="{DynamicResource LaunchingIndicatorBrush}" />
                            <Setter TargetName="NotchR" Property="Fill" Value="{DynamicResource LaunchingIndicatorBrush}" />
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleFlareHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,46,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,46,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.48" To="0.58" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PlayFill" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource LaunchingIndicatorBrush}" />
                            <Setter TargetName="NotchL" Property="Fill" Value="{DynamicResource LaunchingIndicatorBrush}" />
                            <Setter TargetName="NotchR" Property="Fill" Value="{DynamicResource LaunchingIndicatorBrush}" />
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleFlareHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,46,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,46,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.22" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.22" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING + HOVER (RelativeSource Self, NEVER TemplatedParent) -> Cancel -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="CancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="CancelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary Action Button (More & Edit equal squares next to Play) -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- RunningActionIndicator Overlay placed over Play / ContextAction cell in both Game Overviews -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="1" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" CornerRadius="{DynamicResource ControlCornerRadius}"
                                BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5" />
                        <!-- Foot fill bar 4px above bottom -->
                        <Grid Height="2" Margin="10,0,10,4" VerticalAlignment="Bottom">
                            <Border CornerRadius="1" Background="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.3" />
                            <Border x:Name="RunningFill" CornerRadius="1" Background="{DynamicResource TextBrush}"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <!-- 3 Socketed Amethyst Magic Orbs (right end of plate, inside PlayRoom 46px strip) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Background="{DynamicResource ShellBackgroundBrush}"
                                BorderBrush="{DynamicResource LaunchingIndicatorBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="4,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="BtnOrb1" Width="6" Height="6" Margin="0,0,3,0"
                                         Fill="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.65" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="BtnOrb1S" ScaleX="0.85" ScaleY="0.85" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="BtnOrb2" Width="6" Height="6" Margin="0,0,3,0"
                                         Fill="{DynamicResource TextBrush}" Opacity="0.95" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="BtnOrb2S" ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="BtnOrb3" Width="6" Height="6"
                                         Fill="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.72" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="BtnOrb3S" ScaleX="0.85" ScaleY="0.85" /></Ellipse.RenderTransform>
                                </Ellipse>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.58" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnOrb1S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.85" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.28" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnOrb2S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.85" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.28" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.48" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnOrb3S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.85" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1.28" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.56" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.74" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.74" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnOrb1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnOrb2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnOrb3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
