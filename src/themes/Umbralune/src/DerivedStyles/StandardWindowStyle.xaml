<!--
    Umbralune: DerivedStyles/StandardWindowStyle.xaml.
    Bayonetta 2 OPTIONS-inspired dialog & Settings chrome (docs/themes/settings-screens.md):
    - 44px title band (WindowChrome CaptionHeight=44 == ContentPresenter top margin 44).
    - Signature Umbran Crescent Watch mark + Cinzel Decorative title + OPTIONS cyan optical flare underline +
      ghosted Umbran Watch graphic on right (inside Canvas in ClipToBounds Grid so small dialogs stay content-sized).
    - Subtle midnight-sapphire nebula mist & centered Umbran Watch watermark in dialog body.
    - WindowSettings trigger sets PART_TextTitle.Text to LOCSettingsLabel.
    - WindowDesignStyle defined standalone (never BasedOn StandardWindowStyle).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource NormalBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Dialog body atmospheric nebula + centered Umbran Watch watermark (zero desired size) -->
                                <Grid Margin="0,44,0,0" ClipToBounds="True" IsHitTestVisible="False">
                                    <Control Template="{DynamicResource LocalNebulaTemplate}"
                                             Foreground="{DynamicResource ButtonPressedBackgroundBrush}" Opacity="0.16" />
                                    <Canvas>
                                        <Control Canvas.Left="240" Canvas.Top="70" Width="420" Height="420"
                                                 Template="{DynamicResource LocalWatchWatermarkTemplate}"
                                                 Foreground="{DynamicResource GlyphBrush}" Opacity="0.08" />
                                    </Canvas>
                                </Grid>

                                <!-- 44px Title Band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}" ClipToBounds="True">
                                    <!-- Signature right-hand ghosted watch graphic inside Canvas (no desired width) -->
                                    <Canvas IsHitTestVisible="False">
                                        <Control Canvas.Right="92" Canvas.Top="-42" Width="128" Height="128"
                                                 Template="{DynamicResource LocalWatchWatermarkTemplate}"
                                                 Foreground="{DynamicResource GlyphBrush}" Opacity="0.14" />
                                        <Control Canvas.Left="12" Canvas.Top="8" Width="240" Height="28"
                                                 Template="{DynamicResource LocalRuneBandTemplate}"
                                                 Foreground="{DynamicResource GlyphBrush}" Opacity="0.28" />
                                        <Control Canvas.Left="0" Canvas.Top="32" Width="320" Height="14"
                                                 Template="{DynamicResource LocalFlareBeamTemplate}"
                                                 Foreground="{DynamicResource BeamBrush}" Opacity="0.88" />
                                    </Canvas>

                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource NormalBorderBrush}" IsHitTestVisible="False" />

                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0" IsHitTestVisible="False">
                                            <Control Width="22" Height="22" Margin="0,0,10,0"
                                                     Template="{DynamicResource BrandMarkTemplate}"
                                                     Foreground="{DynamicResource HighlightGlyphBrush}" />
                                            <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>

                                <!-- Content Presenter offset by exact CaptionHeight (44) -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_ButtonMaximize" Property="Content" Value="2" />
                            <Setter TargetName="WindowBorder" Property="Padding" Value="8" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter TargetName="WindowBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standalone WindowDesignStyle (never BasedOn StandardWindowStyle) -->
    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
</ResourceDictionary>
