<!--
    Umbralune: DerivedStyles/GridViewItemStyle.xaml.
    Chapter V Umbran Tarot cover frame:
    - Animated hover: smooth 1.022 lift + glowing Electric Moon-Cyan perimeter frame + 4 antique-gold corner diamonds.
    - Animated selection: Solar Halo Gold filigree bezel + subtle inner glow + top/bottom gold diamond crests.
    - Witch-Time Amethyst RunningIndicator inset 4px inside selection: diagonal amethyst RunningScan + bottom dark
      sapphire tape holding RunningFill and 3 pulsing Magic Orbs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Border x:Name="BaseFrame" Background="{DynamicResource GridItemBackgroundBrush}"
                                BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter />
                        </Border>

                        <!-- Animated Hover Frame: Electric Moon-Cyan rim + 4 antique-gold corner diamonds -->
                        <Grid x:Name="HoverFrame" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                    BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" BorderThickness="2" />
                            <Polygon Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2"
                                     Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource HighlightGlyphBrush}" />
                            <Polygon Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-2"
                                     Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource HighlightGlyphBrush}" />
                            <Polygon Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-2"
                                     Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource HighlightGlyphBrush}" />
                            <Polygon Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-2"
                                     Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource HighlightGlyphBrush}" />
                        </Grid>

                        <!-- Animated Selected Frame: Solar Halo Gold Tarot Filigree Bezel -->
                        <Grid x:Name="SelectedFrame" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                    BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" BorderThickness="2.5" />
                            <Polygon Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-4,0,0"
                                     Points="4,0 8,4 4,8 0,4" Fill="{DynamicResource GiltHotBrush}"
                                     Stroke="{DynamicResource ShellBackgroundBrush}" StrokeThickness="1" />
                            <Polygon Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                                     Points="4,0 8,4 4,8 0,4" Fill="{DynamicResource GiltHotBrush}"
                                     Stroke="{DynamicResource ShellBackgroundBrush}" StrokeThickness="1" />
                        </Grid>

                        <!-- Witch-Time Amethyst Running / Launching Indicator (inset 4px inside selection) -->
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="1" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.18" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Background="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.34">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningFrame" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                            <!-- Bottom 18px dark sapphire Witch-Time tape holding RunningFill and 3 Magic Orbs -->
                            <Border Height="18" VerticalAlignment="Bottom" Margin="2" CornerRadius="2"
                                    Background="{DynamicResource ShellBackgroundBrush}" Opacity="0.9">
                                <Grid Margin="6,0">
                                    <Grid Height="2" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                        <Border CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                                        <Border x:Name="RunningFill" CornerRadius="1" Background="{DynamicResource LaunchingIndicatorBrush}"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2">
                                        <Ellipse x:Name="CovOrb1" Width="6" Height="6" Margin="0,0,4,0"
                                                 Fill="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.65" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform><ScaleTransform x:Name="CovOrb1S" ScaleX="0.85" ScaleY="0.85" /></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse x:Name="CovOrb2" Width="6" Height="6" Margin="0,0,4,0"
                                                 Fill="{DynamicResource TextBrush}" Opacity="0.95" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform><ScaleTransform x:Name="CovOrb2S" ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse x:Name="CovOrb3" Width="6" Height="6"
                                                 Fill="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.72" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform><ScaleTransform x:Name="CovOrb3S" ScaleX="0.85" ScaleY="0.85" /></Ellipse.RenderTransform>
                                        </Ellipse>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Panel.ZIndex" Value="5" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CovHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.022" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.022" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CovHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="6" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CovSelIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CovSelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.58" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovOrb1S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.85" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovOrb2S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.85" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.48" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovOrb3S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.85" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.56" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.74" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.74" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovOrb1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovOrb2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovOrb3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
