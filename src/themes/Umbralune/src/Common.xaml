<!--
    Umbralune: Common.xaml — Shared spacing, sizing, focus visual, brand templates,
    animated Umbran Crescent Watch main-menu mark (LocalUmbraluneMenuMarkTemplate),
    and white-mask FX sprite helpers.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Spacing & Layout Scale -->
    <!-- Form field & button height: 32px standard across Playnite controls -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <!-- Standard icon glyph size inside toolbar, rail and menus -->
    <sys:Double x:Key="IconSize">16</sys:Double>
    <!-- Game page hero banner height (ThemeModifier editable) -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Game page banner darkening slider (0 = off, >0 starts at 50% floor) -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Control padding scale: 5px vertical keeps 32px height with 1px borders -->
    <Thickness x:Key="ButtonPadding">14,5,14,5</Thickness>
    <Thickness x:Key="InputPadding">10,5,10,5</Thickness>
    <Thickness x:Key="MenuPadding">4,6,4,6</Thickness>
    <Thickness x:Key="MenuItemPadding">8,4,10,4</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4,5,4,5</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,4,10,4</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,5,10,5</Thickness>
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>
    <Thickness x:Key="TooltipPadding">10,6,10,6</Thickness>

    <!-- Shared Base Styles -->
    <Style x:Key="BaseStyle" TargetType="{x:Type Control}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="BaseTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style x:Key="PopupBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource FocusBrush}"
                            BorderThickness="1.5"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Margin="-2"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Reusable White-Mask FX Templates (src/Images/fx/*.png) -->
    <ControlTemplate x:Key="LocalNebulaTemplate" TargetType="{x:Type Control}">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/nebula-smoke.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalWatchWatermarkTemplate" TargetType="{x:Type Control}">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/watch-watermark.png'}" Stretch="Uniform" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalRuneBandTemplate" TargetType="{x:Type Control}">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/rune-band.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalFlareBeamTemplate" TargetType="{x:Type Control}">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/flare-beam.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalFiligreeLaceTemplate" TargetType="{x:Type Control}">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/filigree-border.png'}"
                            TileMode="Tile" Viewport="0,0,12,64" ViewportUnits="Absolute" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalGoldSheenTemplate" TargetType="{x:Type Control}">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/gold-sheen.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalClimaxSweepTemplate" TargetType="{x:Type Control}">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/climax-sweep.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Tapered Sapphire-Gold Divider centered on an antique-gold Umbran diamond crest -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="{x:Type Control}">
        <Grid Height="10" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0.65">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Path Grid.Column="1" Width="7" Height="7" Margin="6,0" VerticalAlignment="Center"
                  Stretch="Fill" Fill="{DynamicResource GiltDimBrush}"
                  Data="M3.5,0 L7,3.5 L3.5,7 L0,3.5 Z" />
            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0.65">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Static Brand Mark Template (Settings Title Band & Empty Game Page) -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="64" Height="64">
                <Ellipse Canvas.Left="9" Canvas.Top="8" Width="48" Height="48"
                         Stroke="{DynamicResource GlyphBrush}" StrokeThickness="2.2" StrokeDashArray="10 3" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M38,8 A24,24 0 1 0 38,56 A18.2,18.2 0 1 1 38,8 Z" />
                <Ellipse Canvas.Left="22" Canvas.Top="20" Width="24" Height="24"
                         Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.6" />
                <Path Fill="{DynamicResource GiltBrush}"
                      Data="M34,15 L37.8,28.2 L48,32 L37.8,35.8 L34,49 L30.2,35.8 L20,32 L30.2,28.2 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!--
        Animated Main Menu Mark (LocalUmbraluneMenuMarkTemplate — shared by Sidebar.xaml and TopPanel.xaml).
        Motif: Umbran Crescent Watch (outer clockwork ring, moon-cyan crescent, antique-gold 4-point star needle).
        - Rest: calm nested sapphire crescent watch with gold star-needle.
        - Hover (IsMouseOver on Control): outer clockwork ring rotates 45deg and gold star-needle flashes brighter (separate elements).
        - Open (ContextMenu.IsOpen on ancestor Border): Witch-Time amethyst core halo blooms and breathes (2.4s loop)
          while four cardinal amethyst-cyan diamond pips expand outward; ExitActions stop & reset every animated property.
    -->
    <ControlTemplate x:Key="LocalUmbraluneMenuMarkTemplate" TargetType="{x:Type Control}">
        <Grid Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Viewbox Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="64" Height="64">
                    <!-- Open-state layer: Witch-Time amethyst core halo & cardinal diamond pips (never touched by hover) -->
                    <Ellipse x:Name="OpenHalo" Canvas.Left="10" Canvas.Top="10" Width="44" Height="44"
                             Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.OpacityMask>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.OpacityMask>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="OpenHaloScale" ScaleX="0.2" ScaleY="0.2" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Canvas x:Name="OpenOrbit" Width="64" Height="64" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="OpenOrbitScale" ScaleX="0.2" ScaleY="0.2" />
                                <RotateTransform x:Name="OpenOrbitRot" Angle="0" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Path Fill="{DynamicResource LaunchingIndicatorBrush}"
                              Data="M34,2 L37,5 L34,8 L31,5 Z M34,56 L37,59 L34,62 L31,59 Z M56,29 L59,32 L56,35 L53,32 Z M5,29 L8,32 L5,35 L2,32 Z" />
                    </Canvas>

                    <!-- Hover-state layer: Outer clockwork watch ring (rotates on hover) -->
                    <Canvas x:Name="WatchRing" Width="64" Height="64" RenderTransformOrigin="0.52,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="WatchRingRot" Angle="0" />
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="9" Canvas.Top="8" Width="48" Height="48"
                                 Stroke="{DynamicResource GlyphBrush}" StrokeThickness="2.4" StrokeDashArray="8 3" />
                        <Path Fill="{DynamicResource GiltDimBrush}"
                              Data="M32,4 H34 V9 H32 Z M32,55 H34 V60 H32 Z M54,31 H59 V33 H54 Z" />
                    </Canvas>

                    <!-- Static-framed Umbran Crescent Moon -->
                    <Path x:Name="CrescentMoon" Fill="{DynamicResource HighlightGlyphBrush}"
                          Data="M37,9 A23,23 0 1 0 37,55 A17.6,17.6 0 1 1 37,9 Z" />

                    <!-- Hover-state layer: Gold 4-point star-needle (scales slightly & brightens on hover) -->
                    <Path x:Name="StarNeedle" Fill="{DynamicResource GiltBrush}"
                          RenderTransformOrigin="0.5,0.5"
                          Data="M34,15 L37.8,28.2 L48,32 L37.8,35.8 L34,49 L30.2,35.8 L20,32 L30.2,28.2 Z">
                        <Path.RenderTransform>
                            <ScaleTransform x:Name="StarScale" ScaleX="1" ScaleY="1" />
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="StarGlint" Fill="{DynamicResource GiltHotBrush}" Opacity="0"
                          Data="M34,18 L36.6,29.4 L45,32 L36.6,34.6 L34,46 L31.4,34.6 L23,32 L31.4,29.4 Z" />
                </Canvas>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <!-- Hover: smooth 240ms clockwork ring turn + star glint -->
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuMarkHoverIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="WatchRingRot" Storyboard.TargetProperty="Angle"
                                             To="45" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction>
                                    <PowerEase Power="3" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StarScale" Storyboard.TargetProperty="ScaleX"
                                             To="1.14" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="StarScale" Storyboard.TargetProperty="ScaleY"
                                             To="1.14" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="StarGlint" Storyboard.TargetProperty="Opacity"
                                             To="0.95" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuMarkHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="WatchRingRot" Storyboard.TargetProperty="Angle"
                                             To="0" Duration="0:0:0.24" />
                            <DoubleAnimation Storyboard.TargetName="StarScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="StarScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="StarGlint" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Menu Open: Witch-Time amethyst halo breath + orbiting diamond pips -->
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="MenuMarkOpenIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OpenHaloScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.24" />
                            <DoubleAnimation Storyboard.TargetName="OpenHaloScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.24" />
                            <DoubleAnimation Storyboard.TargetName="OpenOrbitScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction>
                                    <PowerEase Power="3" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="OpenOrbitScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction>
                                    <PowerEase Power="3" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="OpenOrbit" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.22" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OpenHalo" Storyboard.TargetProperty="Opacity"
                                                           RepeatBehavior="Forever">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.85" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.45" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="OpenOrbitRot" Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:8" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard x:Name="MenuMarkOpenOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="OpenHalo" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="OpenHaloScale" Storyboard.TargetProperty="ScaleX"
                                             To="0.2" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="OpenHaloScale" Storyboard.TargetProperty="ScaleY"
                                             To="0.2" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="OpenOrbit" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="OpenOrbitScale" Storyboard.TargetProperty="ScaleX"
                                             To="0.2" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="OpenOrbitScale" Storyboard.TargetProperty="ScaleY"
                                             To="0.2" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="OpenOrbitRot" Storyboard.TargetProperty="Angle"
                                             To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Empty Game Page Sanctuary Template (used by DetailsViewGameOverview & GridViewGameOverview) -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="{x:Type Control}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="136" Height="136" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Control Template="{DynamicResource LocalWatchWatermarkTemplate}"
                             Foreground="{DynamicResource GlyphBrush}" Opacity="0.22" />
                    <Control Width="64" Height="64" Template="{DynamicResource BrandMarkTemplate}"
                             Foreground="{DynamicResource HighlightGlyphBrush}" />
                </Grid>
                <Control Width="180" Height="14" HorizontalAlignment="Center" Margin="0,0,0,12"
                         Template="{DynamicResource LocalFlareBeamTemplate}"
                         Foreground="{DynamicResource BeamBrush}" Opacity="0.72" />
                <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                           FontFamily="{DynamicResource HeadingFontFamily}"
                           FontSize="{DynamicResource FontSizeLarger}"
                           Foreground="{DynamicResource HeadingForegroundBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="Select a chronicle from your library"
                           FontFamily="{DynamicResource FontFamily}"
                           FontSize="{DynamicResource FontSize}"
                           Foreground="{DynamicResource TextBrushDarker}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
