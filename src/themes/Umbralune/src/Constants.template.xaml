<!--
    Umbralune: Constants.xaml template (Bayonetta 2-inspired nocturnal Umbran sanctuary).
    scripts/build-theme.ps1 renders this template with src/tokens.css into Constants.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (bundled SIL OFL faces in src/Typography/) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">36</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Jost, {{text:umb-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Cinzel Decorative, {{text:umb-font-display|Georgia}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:umb-font-mono|Consolas}}</FontFamily>

    <!-- Usable metadata content width and position -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape & Radii -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:umb-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">{{px:umb-radius-md}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:umb-radius-lg}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{umb-ink}}</Color>
    <Color x:Key="TextColorDarker">{{umb-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{umb-ink-dark}}</Color>
    <Color x:Key="MainColor">{{umb-indigo}}</Color>
    <Color x:Key="MainColorDark">{{umb-sanctuary}}</Color>
    <Color x:Key="HoverColor">{{umb-royal}}</Color>
    <Color x:Key="GlyphColor">{{umb-cyan}}</Color>
    <Color x:Key="HighlightGlyphColor">{{umb-cyan-bright}}</Color>
    <Color x:Key="PopupBackgroundColor">{{umb-sanctuary}}</Color>
    <Color x:Key="PopupBorderColor">{{umb-rim}}</Color>
    <Color x:Key="BackgroundToneColor">{{umb-indigo}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">#00000000</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{umb-rim-soft}}</Color>
    <Color x:Key="DataChangeNotifColor">{{umb-ruby-pip}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{umb-rim}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{umb-sanctuary}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{umb-indigo}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{umb-abyss}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{umb-mint}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{umb-ruby-pip}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{umb-gold}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{umb-gold}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{umb-sanctuary}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{umb-night}}" />

    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{umb-abyss}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{umb-night}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{umb-sanctuary}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{umb-abyss}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{umb-night}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{umb-rim-soft}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{umb-sanctuary}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{umb-cyan-bright}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{umb-abyss}}" />

    <!-- Game page -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{umb-night}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{umb-night}}" />
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{umb-gold-bright}}" />

    <!-- States -->
    <SolidColorBrush x:Key="BeamBrush" Color="{{umb-cyan-bright}}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{{umb-cyan-beam}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{umb-cyan-wash}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{umb-cyan-bright}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{umb-ink}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{umb-cyan-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{umb-cyan-wash}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{umb-cyan-beam}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{umb-amethyst}}" />
    <SolidColorBrush x:Key="LaunchingIndicatorBrush" Color="{{umb-amethyst-bright}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{umb-cyan-bright}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{umb-ruby}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFFFFFF" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{umb-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{umb-royal}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{umb-sapphire}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{umb-rim}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{umb-gold}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{umb-gold-bright}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{umb-gold-bright}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{umb-gold-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{umb-ink-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{umb-cyan-bright}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{umb-indigo}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{umb-rim}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{umb-royal}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{umb-sapphire}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{umb-cyan-wash}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{umb-abyss}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{umb-night}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{umb-rim}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{umb-cyan}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{umb-rim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{umb-cyan}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{umb-cyan-bright}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{umb-gold-rail}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{umb-chrome}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{umb-cyan-bright}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{umb-mint}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{umb-abyss}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{umb-rim}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{umb-cyan}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{umb-abyss}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{umb-rim}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{umb-cyan}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{umb-ink-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{umb-ink}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{umb-cyan-bright}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{umb-abyss}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{umb-cyan-bright}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{umb-gold}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{umb-royal}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{umb-indigo}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{umb-ink-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{umb-cyan-bright}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{umb-cyan-wash}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{umb-indigo}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{umb-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{umb-cyan-wash}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{umb-cyan}}" />

    <!-- Popups, Frames & Typography Accents -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{umb-rim-soft}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{umb-ink}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{umb-gold-rim}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{umb-sanctuary}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{umb-ink}}" />
    <SolidColorBrush x:Key="GiltBrush" Color="{{umb-gold}}" />
    <SolidColorBrush x:Key="GiltHotBrush" Color="{{umb-gold-bright}}" />
    <SolidColorBrush x:Key="GiltDimBrush" Color="{{umb-gold-rim}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{umb-ribbon-violet}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{umb-ink}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{umb-gold-bright}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{umb-cyan-bright}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{umb-rim}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{umb-rim}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{umb-ribbon-edge}}" />
</ResourceDictionary>
