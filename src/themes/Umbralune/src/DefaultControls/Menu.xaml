<!--
    Umbralune: DefaultControls/Menu.xaml.
    Unified Bayonetta 2-inspired popup menu rows (30px height):
    - Highlight: feathered Electric Moon-Cyan OPTIONS rune beam (LocalRuneBandTemplate) fades in (120ms) while
      a 7px rotated ice-cyan diamond cursor glides in from left and Starlight label nudges 2px right.
    - Group break: fading sapphire hairline centered on a 6px antique-gold rotated diamond crest (10px tall).
    - Shortcuts: circular/pill silver-rimmed console-badge chips (options.png (A)/(B) feel), lighting cyan on highlight.
    - Submenu mark: faceted diamond-chevron lighting cyan when open with held sapphire plate.
    - Marked rows: Alt+Q Exit rests ruby and highlights in a luminous Gates-of-Hell Ruby rune beam (>5.3:1);
      checked rows show a faceted cyan diamond gem inside a gold-rimmed square socket.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group Break Separator (10px tall: fading sapphire hairline + centered antique-gold diamond crest) -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="8,0,8,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center" Fill="{DynamicResource MenuSeparatorBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Polygon Grid.Column="1" Width="6" Height="6" Margin="6,0" VerticalAlignment="Center"
                                 Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource GiltDimBrush}" />
                        <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{DynamicResource MenuSeparatorBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain Submenu Row (30px height, fixed 26px icon col, plain * label col, shared shortcut col) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="Root" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated Moon-Cyan OPTIONS Rune-Beam Highlight -->
            <Grid x:Name="HoverBeam" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border CornerRadius="{DynamicResource CornerRadiusSmall}" Background="{DynamicResource MenuItemHoverBrush}">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#D8000000" Offset="0.72" />
                            <GradientStop Color="#55000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <Control Template="{DynamicResource LocalRuneBandTemplate}"
                         Foreground="{DynamicResource HighlightGlyphBrush}" Opacity="0.42" />
                <Rectangle Width="2.5" HorizontalAlignment="Left" Margin="0,3" Fill="{DynamicResource HighlightGlyphBrush}" />
            </Grid>

            <!-- Exit Danger Rune-Beam Highlight (Alt+Q) -->
            <Grid x:Name="ExitBeam" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border CornerRadius="{DynamicResource CornerRadiusSmall}" Background="{DynamicResource DangerBrush}" />
                <Control Template="{DynamicResource LocalRuneBandTemplate}"
                         Foreground="{DynamicResource DangerForegroundBrush}" Opacity="0.22" />
                <Rectangle Width="2.5" HorizontalAlignment="Left" Margin="0,3" Fill="{DynamicResource DangerForegroundBrush}" />
            </Grid>

            <!-- Sliding Ice-Cyan Diamond Cursor (left rail) -->
            <Polygon x:Name="CursorPip" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="3,0,0,0" Points="3,0 6,3 3,6 0,3"
                     Fill="{DynamicResource HighlightGlyphBrush}" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Polygon.RenderTransform>
                    <TranslateTransform x:Name="CursorShift" X="-6" />
                </Polygon.RenderTransform>
            </Polygon>

            <Grid Margin="10,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut" />
                </Grid.ColumnDefinitions>

                <!-- Fixed 26px Icon / Check Socket -->
                <Grid Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource TextBrush}" />
                    <!-- Checked Row Socket: antique-gold rimmed square + faceted cyan diamond gem -->
                    <Border x:Name="CheckMark" Visibility="Collapsed" Width="14" Height="14"
                            Background="{DynamicResource ListItemSelectedBrush}"
                            BorderBrush="{DynamicResource GiltBrush}" BorderThickness="1"
                            CornerRadius="2">
                        <Polygon Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Points="3.5,0 7,3.5 3.5,7 0,3.5" Fill="{DynamicResource HighlightGlyphBrush}" />
                    </Border>
                </Grid>

                <!-- Plain * Label Column (trims cleanly, shifts 2px right on highlight) -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </Grid.RenderTransform>
                    <ContentPresenter x:Name="HeaderHost" ContentSource="Header" RecognizesAccessKey="True"
                                      VerticalAlignment="Center">
                        <ContentPresenter.Resources>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </Grid>

                <!-- Console-Badge Pill Shortcut Chip (right edge) -->
                <Border x:Name="ShortcutBadge" Grid.Column="2" VerticalAlignment="Center"
                        Background="{DynamicResource ShellBackgroundBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                        CornerRadius="9" Padding="6,1" Margin="6,0,0,0">
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontSize="11" Foreground="{DynamicResource TextBrushDarker}"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutBadge" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutBadge" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!-- Standard Highlight -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="ShortcutBadge" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="ItemHiIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBeam" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverBeam" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="CursorShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="ItemHiOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverBeam" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="CursorShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBeam" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Exit (Alt+Q) Resting Danger Treatment -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" />
                <Setter TargetName="ShortcutBadge" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" />
            </Trigger>

            <!-- Exit (Alt+Q) Highlighted Danger Plate (>5.3:1 contrast) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                    <Condition Property="IsHighlighted" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HoverBeam" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ExitBeam" Property="Visibility" Value="Visible" />
                <Setter TargetName="ExitBeam" Property="Opacity" Value="1" />
                <Setter TargetName="CursorPip" Property="Fill" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutBadge" Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
                <Setter TargetName="ShortcutBadge" Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Submenu Header Row (30px height, held plate when open, faceted diamond-chevron) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="Root" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held Plate while Submenu is Open (prevents flicker) -->
            <Grid x:Name="OpenPlate" Visibility="Collapsed" IsHitTestVisible="False">
                <Border CornerRadius="{DynamicResource CornerRadiusSmall}" Background="{DynamicResource ListItemSelectedBrush}" />
                <Rectangle Width="2.5" HorizontalAlignment="Left" Margin="0,3" Fill="{DynamicResource GlyphBrush}" />
            </Grid>

            <!-- Animated Moon-Cyan Rune-Beam Highlight -->
            <Grid x:Name="HoverBeam" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border CornerRadius="{DynamicResource CornerRadiusSmall}" Background="{DynamicResource MenuItemHoverBrush}">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#D8000000" Offset="0.72" />
                            <GradientStop Color="#55000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <Control Template="{DynamicResource LocalRuneBandTemplate}"
                         Foreground="{DynamicResource HighlightGlyphBrush}" Opacity="0.42" />
                <Rectangle Width="2.5" HorizontalAlignment="Left" Margin="0,3" Fill="{DynamicResource HighlightGlyphBrush}" />
            </Grid>

            <Polygon x:Name="CursorPip" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="3,0,0,0" Points="3,0 6,3 3,6 0,3"
                     Fill="{DynamicResource HighlightGlyphBrush}" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Polygon.RenderTransform>
                    <TranslateTransform x:Name="CursorShift" X="-6" />
                </Polygon.RenderTransform>
            </Polygon>

            <Grid Margin="10,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource TextBrush}" />

                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </Grid.RenderTransform>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center">
                        <ContentPresenter.Resources>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </Grid>

                <ContentControl x:Name="SubArrow" Grid.Column="2" Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource GiltDimBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>

            <!-- Nested Submenu Popup sharing LocalUmbraluneMenuBoardTemplate -->
            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-7"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade">
                <Grid Margin="0,4,0,0" MinWidth="210" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalUmbraluneMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Margin="5,7,5,6" CanContentScroll="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="HdrHiIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBeam" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverBeam" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="CursorShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="HdrHiOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverBeam" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="CursorShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBeam" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Menu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
</ResourceDictionary>
