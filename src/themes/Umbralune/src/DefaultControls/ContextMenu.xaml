<!--
    Umbralune: DefaultControls/ContextMenu.xaml.
    Unified Umbran Sanctuary popup board (LocalUmbraluneMenuBoardTemplate) shared by ContextMenu,
    TopPanelMenu, submenus, and ComboBox dropdown lists.
    Levers: midnight-sapphire board with faint nebula wash, royal-sapphire rim, inset antique-gold corner ticks,
    crowned by a 2px electric-cyan optical flare seam and centered gold diamond pip. UseLayoutRounding=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Popup Board Template (Menus, Submenus, ComboBox Lists) -->
    <ControlTemplate x:Key="LocalUmbraluneMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False">
            <!-- Hard dark rim + Midnight Sapphire board -->
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    SnapsToDevicePixels="True">
                <Grid ClipToBounds="True">
                    <!-- Faint astral nebula wash -->
                    <Control Template="{DynamicResource LocalNebulaTemplate}"
                             Foreground="{DynamicResource ButtonPressedBackgroundBrush}" Opacity="0.22" />
                    <!-- Subtle inner gold-tinted hairline -->
                    <Border Margin="3" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0.65" />
                    <!-- Crown: 2px electric-cyan optical flare seam along top -->
                    <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" Opacity="0.85">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#22000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="0.5" />
                                <GradientStop Color="#22000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Control Height="10" VerticalAlignment="Top" Margin="6,-3,6,0"
                             Template="{DynamicResource LocalFlareBeamTemplate}"
                             Foreground="{DynamicResource BeamBrush}" Opacity="0.72" />
                    <!-- Antique-gold corner diamond ticks -->
                    <Polygon Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                             Points="2,0 4,2 2,4 0,2" Fill="{DynamicResource GiltDimBrush}" />
                    <Polygon Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                             Points="2,0 4,2 2,4 0,2" Fill="{DynamicResource GiltDimBrush}" />
                    <Polygon Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                             Points="2,0 4,2 2,4 0,2" Fill="{DynamicResource GiltDimBrush}" />
                    <Polygon Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                             Points="2,0 4,2 2,4 0,2" Fill="{DynamicResource GiltDimBrush}" />
                </Grid>
            </Border>
            <!-- Centered antique-gold diamond crown pip straddling the top edge -->
            <Polygon Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0"
                     Points="3.5,0 7,3.5 3.5,7 0,3.5"
                     Fill="{DynamicResource GiltBrush}"
                     Stroke="{DynamicResource ShellBackgroundBrush}" StrokeThickness="0.8" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource MenuPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid Margin="0,4,0,0" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalUmbraluneMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="5,7,5,6" CanContentScroll="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
