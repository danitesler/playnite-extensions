<!--
    Umbralune: DefaultControls/ProgressBar.xaml.
    Combat HUD Mint-Jade HP bar (hud.png): dark sapphire chrome groove, Mint-Jade fill, electric cyan tip spark.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="1.5">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4">
                                    <Grid>
                                        <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource TextBrush}" Opacity="0.32" />
                                        <Polygon Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 Margin="0,0,-1,0" Points="3,0 6,3 3,6 0,3"
                                                 Fill="{DynamicResource HighlightGlyphBrush}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
