<!--
    Umbralune: DefaultControls/Slider.xaml.
    Bayonetta 2 OPTIONS Signature Slider (options.png):
    - Grooved antique bronze-gold metallic track (SliderTrackBrush) with Solar Gold filled range.
    - Tall vertical faceted Silver-Chrome Diamond Thumb (14x22) inset with a glowing sapphire-cyan gem.
    - Required ShowBackgroundImageOnWindow=True ThemeModifier disable triggers on GameBannerHeight & GameBannerDarken.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SliderRangeButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Height="6" CornerRadius="3,0,0,3" Background="{DynamicResource GiltBrush}"
                            VerticalAlignment="Center" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LocalUmbraluneSliderTrackButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Height="16" Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Faceted Silver-Chrome Diamond Thumb with Glowing Sapphire Gem (options.png) -->
    <Style x:Key="SliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Width="14" Height="22" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Outer beveled silver-chrome diamond -->
                        <Polygon x:Name="OuterDia" Points="7,0 14,11 7,22 0,11"
                                 Fill="{DynamicResource SliderThumbBackgroundBrush}"
                                 Stroke="{DynamicResource ShellBackgroundBrush}" StrokeThickness="1.1" />
                        <!-- Dark sapphire bezel -->
                        <Polygon Points="7,3 11.4,11 7,19 2.6,11"
                                 Fill="{DynamicResource TopPanelBackgroundBrush}" />
                        <!-- Faceted sapphire-cyan gem core -->
                        <Polygon x:Name="GemCore" Points="7,5.2 9.8,11 7,16.8 4.2,11"
                                 Fill="{DynamicResource GlyphBrush}" />
                        <!-- Specular facet glint -->
                        <Polygon Points="7,6.2 8.4,10.5 7,11.6 5.6,10.5"
                                 Fill="{DynamicResource TextBrush}" Opacity="0.72" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterDia" Property="Stroke" Value="{DynamicResource SliderThumbHoverBorderBrush}" />
                            <Setter TargetName="GemCore" Property="Fill" Value="{DynamicResource HighlightGlyphBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="OuterDia" Property="Stroke" Value="{DynamicResource GiltHotBrush}" />
                            <Setter TargetName="GemCore" Property="Fill" Value="{DynamicResource GiltHotBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <!-- Antique bronze-gold grooved metallic rail -->
                        <Border Height="6" CornerRadius="3"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource SliderTrackBrush}"
                                BorderThickness="1" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{DynamicResource SliderRangeButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource LocalUmbraluneSliderTrackButton}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{DynamicResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Window background contract: grey out ThemeModifier banner sliders while window background art is enabled -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerHeight" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerDarken" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
