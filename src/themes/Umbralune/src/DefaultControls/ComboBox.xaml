<!--
    Umbralune: DefaultControls/ComboBox.xaml.
    Closed dropdown wears LocalUmbraluneFieldTemplate + dedicated 28px sapphire-chrome right cap separated by an
    antique-gold hairline with Bayonetta 2's faceted diamond-chevron (turns cyan on hover, flips gold when open).
    ContentSite & PART_EditableTextBox reserve 38px right margin (28px cap + 10px left inset).
    Active state triggers ONLY on IsDropDownOpen=True (and IsEditable+IsKeyboardFocusWithin), never unconditional focus.
    PART_Popup hosts LocalUmbraluneMenuBoardTemplate; ComboBoxItem uses the 30px cyan rune-beam highlight + diamond check.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalUmbraluneComboToggle" TargetType="{x:Type ToggleButton}">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="CapBorder" Width="28" HorizontalAlignment="Right"
                    Background="{DynamicResource NormalBrush}"
                    BorderBrush="{DynamicResource GiltDimBrush}" BorderThickness="1,0,0,0"
                    CornerRadius="0,3,3,0">
                <ContentControl x:Name="ArrowGlyph" Content="{DynamicResource IconDropDown}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource GlyphBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <ContentControl.RenderTransform>
                        <RotateTransform x:Name="ArrowRot" Angle="0" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CapBorder" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter TargetName="ArrowGlyph" Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CapBorder" Property="Background" Value="{DynamicResource ListItemSelectedBrush}" />
                <Setter TargetName="CapBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                <Setter TargetName="ArrowGlyph" Property="Foreground" Value="{DynamicResource GiltHotBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="ComboArrowOpen">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ArrowRot" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="ComboArrowClose">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="ArrowRot" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxItemPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid Height="30" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Animated Moon-Cyan Rune-Beam Highlight (pointer & keyboard IsHighlighted) -->
                        <Grid x:Name="HoverBeam" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border CornerRadius="{DynamicResource CornerRadiusSmall}" Background="{DynamicResource MenuItemHoverBrush}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#D0000000" Offset="0.75" />
                                        <GradientStop Color="#55000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Control Template="{DynamicResource LocalRuneBandTemplate}"
                                     Foreground="{DynamicResource HighlightGlyphBrush}" Opacity="0.38" />
                            <Rectangle Width="2.5" HorizontalAlignment="Left" Margin="0,3" Fill="{DynamicResource HighlightGlyphBrush}" />
                        </Grid>

                        <Grid Margin="10,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <!-- Chosen-item faceted cyan diamond check (stays visible on IsSelected) -->
                            <Polygon x:Name="SelectedDia" Grid.Column="1" Width="7" Height="7"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Points="3.5,0 7,3.5 3.5,7 0,3.5"
                                     Fill="{DynamicResource HighlightGlyphBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedDia" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CbiHiIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBeam" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverBeam" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CbiHiOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverBeam" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBeam" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              Template="{StaticResource LocalUmbraluneComboToggle}"
                                              Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                <!-- Right margin = 28px cap + 10px left inset = 38px so values never glue to arrow -->
                                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="10,0,38,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <TextBox x:Name="PART_EditableTextBox" Style="{DynamicResource BareTextBox}"
                                         MinHeight="0" Margin="10,0,38,0"
                                         Visibility="Hidden" Focusable="True"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"
                                         VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <Control x:Name="FieldOverlay" Template="{DynamicResource LocalUmbraluneFieldTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2"
                               IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Slide">
                            <Grid x:Name="DropDown" SnapsToDevicePixels="True" Margin="0,4,0,0"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Control Template="{DynamicResource LocalUmbraluneMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                                <ScrollViewer Margin="5,7,5,6" CanContentScroll="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <!-- Active state ONLY while open or editable+focused (never stuck after closing) -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
