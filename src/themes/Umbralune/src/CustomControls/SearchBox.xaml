<!--
    Umbralune: CustomControls/SearchBox.xaml.
    Recessed abyssal-sapphire search well with paired antique-gold diamond edge ticks and cyan optical focus flare.
    Persistent magnifier Glyph outside PART_SeachIcon; full-hit transparent Border template on PART_ClearTextIcon.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Field" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="{DynamicResource ControlBorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <Rectangle x:Name="FocusFlare" Height="2" VerticalAlignment="Bottom" Margin="8,0,8,0"
                                           Fill="{DynamicResource BeamBrush}" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#FF000000" Offset="0.32" />
                                            <GradientStop Color="#FF000000" Offset="0.68" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <ContentControl x:Name="Glyph" Focusable="False" Content="{DynamicResource IconSearch}"
                                                ContentTemplate="{DynamicResource IconTemplate}"
                                                Foreground="{DynamicResource GlyphBrush}" Margin="10,0,0,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                IsHitTestVisible="False" Panel.ZIndex="1" />
                                <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                                <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                         Padding="32,0,28,0" VerticalContentAlignment="Center" />
                                <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}"
                                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,4,0" Cursor="Hand"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ContentControl.Template>
                                        <ControlTemplate TargetType="ContentControl">
                                            <Border Background="Transparent" Padding="4">
                                                <ContentPresenter ContentSource="Content" />
                                            </Border>
                                        </ControlTemplate>
                                    </ContentControl.Template>
                                </ContentControl>
                            </Grid>
                        </Border>
                        <!-- Paired antique-gold diamond edge ticks -->
                        <Polygon x:Name="TickL" Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="-2,0,0,0" Points="2.5,0 5,2.5 2.5,5 0,2.5"
                                 Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                        <Polygon x:Name="TickR" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,0,-2,0" Points="2.5,0 5,2.5 2.5,5 0,2.5"
                                 Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                            <Setter TargetName="TickL" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="TickR" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="TickL" Property="Fill" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="TickR" Property="Fill" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="FocusFlare" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusFlare" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TextInpuText" Property="Padding" Value="10,0,28,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
