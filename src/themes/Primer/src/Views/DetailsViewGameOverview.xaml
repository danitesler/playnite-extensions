<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details mode, right pane).
    GitHub's repository page. Header: icon (24px) and name at fontSize 20 semibold on the left; on the right Edit as an
    IconButton (32px, octicon pencil), More as a default Button with triangle-down, Play (or Install) as the green
    primary Button. A 1px borderColor-default rule under it, then Primer's Layout: the main column holds the README Box
    (GroupBox: Box-header "Description", 16px body) and a Notes Box; the 296px sidebar on the right is one BorderGrid
    with a 16px semibold heading and every metadata field Playnite can show, each a 12px semibold fgColor-muted label
    over its value (as the sidebar of an issue lists Assignees and Labels), in six sections split by 1px rules:
    progress (completion status, time played, last played, recent activity, added), scores, about (developers,
    publishers, release date, series, age rating, region), tags (platforms, genres, categories, features, tags, as
    topic tags), library (library, source, version, install size, install folder) and links. A section whose fields
    are all hidden takes no space, and neither does its rule. Values are Links (PropertyItemButton).
    No background art and no cover: GitHub pages are flat. Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}">
                        <Grid>
<!-- Banner: the game's background art as a band at the top. Tinted at the top, darkened toward the title by a page-colored scrim, faded into the page. GameBannerHeight sets the height; 0 turns it off. -->
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
    <Grid.Style>
        <Style TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Grid.Style>
    <Grid.CacheMode>
        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
    </Grid.CacheMode>
    <Grid.OpacityMask>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#A6000000" Offset="0" />
            <GradientStop Color="Black" Offset="0.3" />
            <GradientStop Color="Transparent" Offset="1" />
        </LinearGradientBrush>
    </Grid.OpacityMask>
    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
    <Border Background="{DynamicResource WindowBackgourndBrush}">
        <Border.OpacityMask>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Transparent" Offset="0.1" />
                <GradientStop Color="#A6000000" Offset="0.4" />
                <GradientStop Color="#CC000000" Offset="0.7" />
                <GradientStop Color="#E6000000" Offset="1" />
            </LinearGradientBrush>
        </Border.OpacityMask>
    </Border>
</Grid>
<Grid>

<Grid Margin="24,24,41,32" MaxWidth="1280">
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Repository header -->
                            <StackPanel Grid.Row="0">
<!-- Room above the title so it sits low on the banner; gone when the banner is off or the game has no art. -->
<Border  IsHitTestVisible="False">
    <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 100 / 320'}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                    <Setter Property="Height" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
</Border>
<DockPanel Margin="0,0,0,16">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Grid>
                                        <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                        <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                    </Grid>
                                    <Button x:Name="PART_ButtonMoreActions" Width="32" Height="32" Padding="0" Margin="8,0,0,0"
                                            ToolTip="{DynamicResource LOCMoreAction}">
                                        <ContentPresenter Width="16" Height="16"
                                                          Content="{DynamicResource IconOptions}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                    <Button x:Name="PART_ButtonEditGame" Width="32" Height="32" Padding="0" Margin="8,0,0,0" Focusable="False"
                                            ToolTip="{DynamicResource LOCEditGame}">
                                        <ContentPresenter Width="16" Height="16"
                                                          Content="{DynamicResource IconEdit}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                </StackPanel>
                                <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                            </DockPanel>
</StackPanel>

                            <Border Grid.Row="1" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,1,0,0"
                                    Padding="0,24,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="240" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Main column: README and Notes Boxes -->
                                    <StackPanel Grid.Column="0">
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library or Steam source games in that gap; give up after 12s so a game without screenshots does not keep an empty block. When the plugin is not installed or is disabled the binding fails, FallbackValue=PluginUnavailable matches neither True nor False, and no skeleton shows. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <GroupBox Header="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}">
                                                <Grid>
                                                    <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                    <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                        <Control.Style>
                                                            <Style TargetType="Control">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Control.Style>
                                                    </Control>
                                                </Grid>
                                            </GroupBox>
                                        </Grid>
                                        <GroupBox x:Name="PART_ElemDescription" Margin="0,24,0,0" Header="{DynamicResource LOCGameDescriptionTitle}">
                                            <HtmlTextView x:Name="PART_HtmlDescription"
                                                          TextElement.Foreground="{DynamicResource TextBrush}"
                                                          Tag="{DynamicResource GlyphBrush}"
                                                          HtmlFontSize="{DynamicResource FontSize}"
                                                          HtmlFontFamily="{DynamicResource FontFamily}"
                                                          HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                          LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                        </GroupBox>
                                        <GroupBox x:Name="PART_ElemNotes" Header="{DynamicResource LOCNotesLabel}" Margin="0,24,0,0">
                                            <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                     Background="{DynamicResource ControlBackgroundBrush}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" />
                                        </GroupBox>
                                    </StackPanel>

                                    <!-- Sidebar: BorderGrid -->
                                    <StackPanel Grid.Column="2" Width="{DynamicResource GameDetailsPaneWidth}">
                                        <TextBlock Text="{DynamicResource LOCGameDetails}" FontSize="{DynamicResource FontSizeLarge}"
                                                   FontWeight="SemiBold" Margin="0,0,0,8" />

                                        <Border ClipToBounds="True">
                                            <StackPanel Margin="0,-41,0,-8">
                                                <Border x:Name="MetaProgress" Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <TextBlock x:Name="PART_TextPlayTime" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <TextBlock x:Name="PART_TextLastActivity" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <TextBlock x:Name="PART_TextRecentActivity" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCDateAddedLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <TextBlock x:Name="PART_TextAdded" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaScores" Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCCommunityScore}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <TextBlock x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCCriticScore}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <TextBlock x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCUserScore}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <TextBlock x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaAbout" Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCDevelopersLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <ItemsControl x:Name="PART_ItemsDevelopers" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCPublishersLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <ItemsControl x:Name="PART_ItemsPublishers" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCSeriesLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <ItemsControl x:Name="PART_ItemsSeries" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <ItemsControl x:Name="PART_ItemsAgeRatings" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemRegion" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCRegionLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <ItemsControl x:Name="PART_ItemsRegions" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaTags" Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel x:Name="PART_ElemPlatform" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCPlatformsTitle}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,0,0,-4">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemGenres" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCGenresLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,0,0,-4">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemCategories" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCCategoriesLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <ItemsControl x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,0,0,-4">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemFeatures" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCFeaturesLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <ItemsControl x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,0,0,-4">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemTags" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCTagsLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <ItemsControl x:Name="PART_ItemsTags" Tag="Chip" Margin="0,0,0,-4">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaLibrary" Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel x:Name="PART_ElemLibrary" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCGameProviderTitle}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemSource" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCSourceLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <Button x:Name="PART_ButtonSource" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemVersion" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCVersionLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <Button x:Name="PART_ButtonVersion" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemInstallSize" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <TextBlock x:Name="PART_TextInstallSize" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemInstallDirectory" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <Button x:Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaLinks" Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel x:Name="PART_ElemLinks" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCLinksLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                            <ItemsControl x:Name="PART_ItemsLinks" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
</Grid>
</Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>