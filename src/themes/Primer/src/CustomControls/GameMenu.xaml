<!--
    Overlay on Playnite Default/CustomControls/GameMenu.xaml. Game right-click menu: the Primer ActionMenu of
    DefaultControls/ContextMenu.xaml, which Playnite loads earlier, so the StaticResource resolves to it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GameMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />
</ResourceDictionary>
