<!--
    Visorline: dialog windows (Settings, game editor, add-ons), drawn as the source's OPTIONS screen. A 44px near-black band (CaptionHeight 44 =
    the content offset) over a faint honeycomb: the theme's mark sits at the left, the title follows in the display face between two
    angle brackets (the source's "checkpoint reached" notice), the mark is ghosted at 7% into the right end, and the ruler rule closes the
    band. One hairline frames the window. Caption buttons are the 46x44 WindowBarButton. The Settings window has no Title, so a trigger
    names it. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" ClipToBounds="True">
                                    <Border Background="{DynamicResource WindowTitleBackgroundBrush}" />
                                    <Rectangle IsHitTestVisible="False" Fill="{DynamicResource GlyphBrush}" Opacity="0.08">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/hex.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,24,42" ViewportUnits="Absolute" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <!-- The theme's mark, ghosted into the band's right end, left of the caption buttons. In a Canvas: no desired size. -->
                                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0" IsHitTestVisible="False">
                                        <Viewbox Canvas.Left="-236" Canvas.Top="-14" Width="72" Height="72" Opacity="0.07">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{DynamicResource IconMainMenu}" Fill="{DynamicResource WindowTitleForegroundBrush}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Canvas>
                                    <!-- The theme's mark opens every screen title. -->
                            <ContentControl Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource HeadingMarkerBrush}"
                                            Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,2" Focusable="False" IsHitTestVisible="False" />
                                    <!-- PART_TextTitle keeps the real title (Playnite and the Settings trigger set it); the band shows an uppercase copy.
                                         Playnite makes this element visible once a window has a Title, and unstyled it draws bare text over the band's
                                         top-left corner. So it lives in a Collapsed parent (a collapsed parent hides it whatever its own Visibility)
                                         and is also zero-sized and transparent. -->
                                    <Border Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="{TemplateBinding Title}" x:Name="PART_TextTitle" Width="0" Height="0" Opacity="0" Foreground="Transparent" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="52,0,150,2" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="&#8249;" Margin="0,0,10,2" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLarger}"
                                           Foreground="{DynamicResource HeadingMarkerBrush}" Style="{DynamicResource BaseTextBlockStyle}" />
                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle, Converter={StaticResource StringToUpperCaseConverter}}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLarger}"
                                           Foreground="{DynamicResource WindowTitleForegroundBrush}" Style="{DynamicResource BaseTextBlockStyle}" />
                                <TextBlock Text="&#8250;" Margin="10,0,0,2" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLarger}"
                                           Foreground="{DynamicResource HeadingMarkerBrush}" Style="{DynamicResource BaseTextBlockStyle}" />
                            </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                                <!-- The closing rule: the ruler rule, its hairline on the band's bottom edge. -->
                                <Control x:Name="BandFlare" Template="{DynamicResource RulerLineTemplate}" Foreground="{DynamicResource TopPanelRuleStartBrush}" BorderBrush="{DynamicResource TopPanelRuleEndBrush}"
                                         Height="16" VerticalAlignment="Top" Margin="0,36,0,0" Focusable="False" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
