<!--
Visorline: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
Keys are the shared vocabulary (scripts/data/theme-keys.json); each placeholder names the vs token that plays
the key's role. Token-to-key table: ../AGENTS.md. Theme XAML reads brushes only, never Color keys.
Shape: plates are square or cut at 45 degrees. Selection is a grey-green band between two lit rules, never a filled accent.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: squared condensed caps for titles and labels (Rajdhani Bold, bundled), DIN-style body (Bahnschrift, ships with Windows). -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:vs-font-body|Bahnschrift}}, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Rajdhani, {{text:vs-font-display|Rajdhani}}, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:vs-radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{vs-mint}}</Color>
    <Color x:Key="TextColorDarker">{{vs-label}}</Color>
    <Color x:Key="TextColorDark">{{vs-ink}}</Color>
    <Color x:Key="MainColor">{{vs-pit}}</Color>
    <Color x:Key="MainColorDark">{{vs-panel}}</Color>
    <Color x:Key="HoverColor">{{vs-plate-lit}}</Color>
    <Color x:Key="GlyphColor">{{vs-rule}}</Color>
    <Color x:Key="HighlightGlyphColor">{{vs-hud}}</Color>
    <Color x:Key="PopupBackgroundColor">{{vs-pit}}</Color>
    <Color x:Key="PopupBorderColor">{{vs-edge-lit}}</Color>
    <Color x:Key="BackgroundToneColor">{{vs-panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{vs-edge}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{vs-edge}}</Color>
    <Color x:Key="DataChangeNotifColor">{{vs-star}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{vs-edge-lit}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{vs-slab}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{vs-pit}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{vs-alert}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{vs-star}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{vs-star}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{vs-pit}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{vs-panel}}" />

    <!-- Surfaces and art -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{vs-panel}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{vs-panel}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{vs-deep}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the teal-black the source's menus fade to,
so a darker banner keeps the menu's green cast instead of plain black. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{vs-deep}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{vs-slab}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{vs-hud}}" />

    <!-- Selection and states -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{vs-band}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{vs-hud}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{vs-plate}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{vs-band}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{vs-plate-lit}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{vs-hud}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{vs-alert}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{vs-hud}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{vs-mint}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{vs-hud}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{vs-edge-lit}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{vs-slab-lit}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{vs-band}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{vs-slab}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{vs-slab-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{vs-band}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{vs-hud}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{vs-band}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{vs-edge-lit}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{vs-edge-lit}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{vs-rule}}" />

    <!-- Tracks and thumbs -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{vs-edge-lit}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{vs-hud}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{vs-hud}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{vs-edge}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{vs-edge-lit}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{vs-edge-lit}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{vs-rule}}" />

    <!-- Tabs, covers, shell items -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{vs-label}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{vs-hud}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{vs-hud}}" />
    <!-- Running game: the neon yellow of the source's star marker, the only warm color beside the mint, so it never reads as selection or hover. -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{vs-star}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{vs-plate-lit}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{vs-band}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{vs-label}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{vs-hud}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{vs-rule}}" />

    <!-- Metadata, menus, tooltips, dialogs -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{vs-pit}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{vs-mint}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{vs-plate-lit}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{vs-edge}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{vs-mint}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{vs-hud}}" />

    <!-- Frames and headings -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{vs-edge-lit}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{vs-edge}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{vs-edge}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{vs-hud}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{vs-edge-lit}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{vs-edge-lit}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{vs-pit}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{vs-hud}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{vs-edge-lit}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{vs-band-dim}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{vs-slab}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{vs-edge-lit}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{vs-rule}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{vs-star}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{vs-void}}" />
</ResourceDictionary>
