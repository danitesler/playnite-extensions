<!--
    Visorline: spacing, focus and the shared motifs. Measurements: ../RESEARCH.md.
    ChamferTemplate       a plate cut at 45 degrees at both ends: fill + one hairline rim (the source's dropdown and BACK plates)
    ChamferLeftTemplate   the same cut on the left end only (text fields)
    ArrowTemplate         a plate whose left end points like an arrow (ComboBox)
    FramedPlateTemplate   a card frame: one hairline with an angled bracket on two opposite corners
    RivetsTemplate        kept empty: the source's plates carry no studs
    BandTemplate          the selection: a grained grey-green band between two lit rules
    BracketFrameTemplate  four angled corner brackets, for hover layers that animate
    RulerLineTemplate     a panel's rule: a hairline that fades at both ends with ruler ticks hanging under it
    BloomTemplate         soft bloom behind a plate or a lit label
    DividerTemplate       the hex bullet that opens a heading, then a rule
    CornerMarksTemplate   small angled corner marks (keyboard focus)
    Sprites are white masks filled with theme brushes, so ThemeModifier edits reach them. None of these report a
    desired width of their own (Statistics cards stay compact).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Option rows: caps labels sit 14px inside a plate; plates are 32px tall (the source's rows hold text about 18px inside). -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">12,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,7</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,0</Thickness>
    <Thickness x:Key="TooltipPadding">10,5</Thickness>

    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- A plate cut 7px at every corner. Background = the fill, BorderBrush = the 1px rim. Seven pieces per end keep the cut
         exactly 7px at any height or width: two triangles, a strip, and the rim's two diagonals and hairlines. -->
    <ControlTemplate x:Key="ChamferTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Margin="7,0" Fill="{TemplateBinding Background}" />
            <Rectangle Width="7" Margin="0,7" HorizontalAlignment="Left" Fill="{TemplateBinding Background}" />
            <Rectangle Width="7" Margin="0,7" HorizontalAlignment="Right" Fill="{TemplateBinding Background}" />
            <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M7,0 L7,7 L0,7Z" Fill="{TemplateBinding Background}" />
            <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,0 L7,0 L7,7Z" Fill="{TemplateBinding Background}" />
            <Path Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Data="M0,0 L0,7 L7,7Z" Fill="{TemplateBinding Background}" />
            <Path Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M0,0 L7,0 L0,7Z" Fill="{TemplateBinding Background}" />
            <Rectangle Height="1" Margin="7,0" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Height="1" Margin="7,0" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Width="1" Margin="0,7" HorizontalAlignment="Left" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Width="1" Margin="0,7" HorizontalAlignment="Right" Fill="{TemplateBinding BorderBrush}" />
            <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,7.5 L7.5,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
            <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,-0.5 L7.5,7" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
            <Path Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Data="M-0.5,0 L7,7.5" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
            <Path Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M-0.5,7 L7,-0.5" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
        </Grid>
    </ControlTemplate>

    <!-- The same cut on the left end only: text fields (the right end stays square so a clear button can sit flush). -->
    <ControlTemplate x:Key="ChamferLeftTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Margin="7,0,0,0" Fill="{TemplateBinding Background}" />
            <Rectangle Width="7" Margin="0,7" HorizontalAlignment="Left" Fill="{TemplateBinding Background}" />
            <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M7,0 L7,7 L0,7Z" Fill="{TemplateBinding Background}" />
            <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,0 L7,0 L7,7Z" Fill="{TemplateBinding Background}" />
            <Rectangle Height="1" Margin="7,0,0,0" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Height="1" Margin="7,0,0,0" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Width="1" Margin="0,7" HorizontalAlignment="Left" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{TemplateBinding BorderBrush}" />
            <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,7.5 L7.5,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
            <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,-0.5 L7.5,7" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
        </Grid>
    </ControlTemplate>

    <!-- A plate with an arrow-shaped left end (the source's dropdown plates). The 14px point stretches with the height. -->
    <ControlTemplate x:Key="ArrowTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Data="M14,0 L0,16 L14,32Z" Stretch="Fill" Fill="{TemplateBinding Background}" />
            <Path Data="M14,0.5 L0.5,16 L14,31.5" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Right" Fill="{TemplateBinding BorderBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- The source's plates carry no studs. The key stays so files that reference it keep loading. -->
    <ControlTemplate x:Key="RivetsTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Card frame. Foreground = the hairline. Overlay it on a panel; it draws no fill. An angled bracket sits on the
         top-left and bottom-right corners, brighter than the line, as the HUD's cards do. -->
    <ControlTemplate x:Key="FramedPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" />
            <Path Width="20" Height="7" Margin="-1,-1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,7 L7,0 L20,0" Stroke="{DynamicResource FrameHoverBrush}" StrokeThickness="1" />
            <Path Width="20" Height="7" Margin="0,0,-1,-1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M0,7 L13,7 L20,0" Stroke="{DynamicResource FrameHoverBrush}" StrokeThickness="1" />
        </Grid>
    </ControlTemplate>

    <!-- The selection. Foreground = the band, BorderBrush = the lit rule. The band darkens toward its foot, a grain tile
         sits on it and a lit rule closes it above (full) and below (55%), as the source's current row. -->
    <ControlTemplate x:Key="BandTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Foreground}" />
            <Rectangle Fill="{DynamicResource BevelShadowBrush}" Opacity="0.35">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Fill="{DynamicResource HeadingForegroundBrush}" Opacity="0.11">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/grain.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,128,128" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}" Opacity="0.55" />
        </Grid>
    </ControlTemplate>

    <!-- Four angled corner brackets, arm 34, 1px. Foreground = the bracket colour. The host sets the bleed with a margin
         (-4 puts the corner 4px outside the plate); hover layers fade and nudge it. -->
    <ControlTemplate x:Key="BracketFrameTemplate" TargetType="Control">
        <Grid Margin="-4" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Width="34" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,10 L10,0 L34,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
            <Path Width="34" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Data="M0,0 L24,0 L34,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
            <Path Width="34" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,0 L10,10 L34,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
            <Path Width="34" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M0,10 L24,10 L34,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
        </Grid>
    </ControlTemplate>

    <!-- Ruler rule, 16px tall: host it with a negative vertical margin so only the hairline takes room.
         Foreground = the hairline, BorderBrush = the ticks that hang under it. Both fade out at the ends. -->
    <ControlTemplate x:Key="RulerLineTemplate" TargetType="Control">
        <Grid Height="16" IsHitTestVisible="False" ClipToBounds="True" SnapsToDevicePixels="True">
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.12" />
                        <GradientStop Color="#FF000000" Offset="0.88" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="8" Margin="0,8,0,0" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}" Opacity="0.55">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/ruler-h.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,40,8" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Bloom. The host decides its own bleed with a negative margin. -->
    <ControlTemplate x:Key="BloomTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- The hex bullet the source's honeycomb gives every heading, then a rule for the rest of the row. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" VerticalAlignment="Center" Height="12" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Width="8" Height="9" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" Data="M4,0 L8,2.25 L8,6.75 L4,9 L0,6.75 L0,2.25Z" />
            <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{DynamicResource HeadingRuleBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Angled corner marks, arm 10, 1px (keyboard focus). -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Width="14" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,6 L6,0 L14,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
            <Path Width="14" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Data="M0,0 L8,0 L14,6" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
            <Path Width="14" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,0 L6,6 L14,6" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
            <Path Width="14" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M0,6 L8,6 L14,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Keyboard focus: angled corner marks 3px outside the control. -->
    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
