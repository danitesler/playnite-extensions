<!--
    Visorline: left rail, 44px of near black over a faint honeycomb, closed on its inner edge by the HUD's rule (a 1px line that burns mint at the
    top and cools down the rail) with a ruler of ticks beside it. The main menu is the theme's mark in a hex cell, 32px, a short hairline
    under it. Hover lights the cell and fades a bloom in behind it. With the sidebar at the top or bottom the rule and ruler drop away.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource TopPanelBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <Rectangle IsHitTestVisible="False" Fill="{DynamicResource GlyphBrush}" Opacity="0.05">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/hex.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,24,42" ViewportUnits="Absolute" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="62" Margin="0,0,0,2"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Control x:Name="SealBloom" Template="{DynamicResource BloomTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                                 Width="44" Height="44" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0" Focusable="False" />
                                        <Path x:Name="Seal" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" Width="32" Height="34" VerticalAlignment="Top" Margin="0,7,0,0"
                                      Data="M16,0 L32,8.5 L32,25.5 L16,34 L0,25.5 L0,8.5Z" SnapsToDevicePixels="True" />
                                        <ContentControl x:Name="MenuMark" Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource MainMenuButtonForegroundBrush}" Focusable="False"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" />
                                        <Path x:Name="SealOrnament" Width="24" Height="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Fill="{DynamicResource NormalBorderBrush}"
                                              Data="M0,0 L24,0 24,1 0,1Z" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                            <Border x:Name="EdgeRule" Width="1" HorizontalAlignment="Right" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                Background="{DynamicResource FrameBrush}" />
                        <Rectangle x:Name="EdgeLit" Width="1" HorizontalAlignment="Right" IsHitTestVisible="False" Fill="{DynamicResource GlyphBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="0.45" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle x:Name="EdgeTicks" Width="8" Margin="0,0,1,0" HorizontalAlignment="Right" IsHitTestVisible="False" Fill="{DynamicResource FrameBrush}" Opacity="0.45">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/ruler-v.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,8,40" ViewportUnits="Absolute" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" TargetName="MenuMark" />
                    <Setter Property="Fill" Value="{DynamicResource ButtonHoverBackgroundBrush}" TargetName="Seal" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SealBloom" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SealBloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeTicks" />
                    <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeLit" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SealOrnament" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                    <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeLit" />
                    <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeTicks" />
                            <Setter Property="Margin" Value="0,6,0,0" TargetName="Seal" />
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="SealBloom" />
                            <Setter Property="Margin" Value="0,14,0,0" TargetName="MenuMark" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SealOrnament" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                    <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeLit" />
                    <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeTicks" />
                            <Setter Property="Margin" Value="0,6,0,0" TargetName="Seal" />
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="SealBloom" />
                            <Setter Property="Margin" Value="0,14,0,0" TargetName="MenuMark" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
