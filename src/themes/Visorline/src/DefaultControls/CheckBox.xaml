<!--
    Visorline: CheckBox. A hex cell, the source's honeycomb unit: 18px, near-black fill, hairline edge. On, the cell lights (lit slab, mint edge)
    and a check stamps in (120ms). Hover brightens the edge. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <DockPanel Background="Transparent">
                        <Grid Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Box" Data="M9,0.5 L17.5,5 L17.5,13 L9,17.5 L0.5,13 L0.5,5Z" Fill="{DynamicResource CheckBoxCheckMarkBkBrush}" Stroke="{DynamicResource CheckBoxBorderBrush}" StrokeThickness="1" />
                            <Grid x:Name="Cap" Opacity="0">
                                <Path Data="M9,0.5 L17.5,5 L17.5,13 L9,17.5 L0.5,13 L0.5,5Z" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" />
                                <ContentControl Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                Foreground="{DynamicResource HeadingForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                            </Grid>
                            <Rectangle x:Name="Dash" Width="8" Height="2" Fill="{DynamicResource TextBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Stroke" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Cap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Cap" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
