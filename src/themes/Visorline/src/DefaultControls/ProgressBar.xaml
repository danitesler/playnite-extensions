<!--
    Visorline: ProgressBar. The HUD's ENERGY bar: bare 10px cells (8 lit, 2 gap, seg.png), the cells up to the value in the mint rule over
    the dim cells of the track; no frame, no marker. Indeterminate sweeps the Default hiders over the fill, dimmed to the same cells.
    The mask tile is as tall as its image, but the cells have no vertical gap, so any bar height stays solid. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Rectangle Name="PART_Track" Fill="{TemplateBinding Background}">
                            <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/seg.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,10,12" ViewportUnits="Absolute" />
                                </Rectangle.OpacityMask>
                        </Rectangle>
                        <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                            <Grid>
                                <Rectangle Fill="{TemplateBinding Foreground}">
                                    <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/seg.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,10,12" ViewportUnits="Absolute" />
                                </Rectangle.OpacityMask>
                                </Rectangle>
                                <Grid x:Name="Animation" Visibility="Hidden">
                                    <Rectangle Fill="{TemplateBinding Background}" Margin="0,0,50,0">
                                        <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/seg.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,10,12" ViewportUnits="Absolute" />
                                </Rectangle.OpacityMask>
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="HiderPreTransform" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Fill="{TemplateBinding Background}" RenderTransformOrigin="1, 0" Margin="50,0,0,0">
                                        <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/seg.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,10,12" ViewportUnits="Absolute" />
                                </Rectangle.OpacityMask>
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="HiderPostTransform" ScaleX="1" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </Decorator>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Animation" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="HiderPreTransform" Storyboard.TargetProperty="(ScaleTransform.ScaleX)" To="1" Duration="0:00:2" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="HiderPostTransform" Storyboard.TargetProperty="(ScaleTransform.ScaleX)" To="0" Duration="0:00:2" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
