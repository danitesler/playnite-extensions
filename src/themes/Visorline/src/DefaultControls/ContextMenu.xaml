<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu,
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is Crysis 2's Nano Visor tactical panel: green-black pit (PopupBackgroundBrush)
    over a faint honeycomb mesh (hex.png), FramedPlateTemplate 1px edge with two diagonal corner brackets, and a top
    compass ruler strip (RulerLineTemplate) with a neon-yellow diamond marker (LocalMenuPanelTemplate, shared by
    ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml).
    Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" />
            <!-- Faint Nano Visor honeycomb mesh -->
            <Rectangle Margin="1" Fill="{DynamicResource GlyphBrush}" Opacity="0.05">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/hex.png'}" TileMode="Tile"
                                Viewport="0,0,24,42" ViewportUnits="Absolute" Stretch="None" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <!-- Compass ruler strip along the top edge with a neon-yellow diamond marker -->
            <Control Template="{DynamicResource RulerLineTemplate}" Margin="16,-3,16,0" VerticalAlignment="Top"
                     Foreground="{DynamicResource GlyphBrush}" BorderBrush="{DynamicResource GlyphBrush}"
                     Opacity="0.65" Focusable="False" IsTabStop="False" />
            <Path Width="6" Height="6" Margin="0,3,48,0" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Data="M 3,0 L 6,3 L 3,6 L 0,3 Z" Fill="{DynamicResource HeadingMarkerAltBrush}" />
            <Control Template="{DynamicResource FramedPlateTemplate}"
                     Foreground="{DynamicResource PopupBorderBrush}" Focusable="False" IsTabStop="False" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,10,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="4,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
