<!--
    Visorline: ComboBox. Keeps Crysis 2's arrow-cut dropdown plate. The popup wears Visorline's Nano Visor tactical
    panel (LocalMenuPanelTemplate, ContextMenu.xaml) and 30px rows matching Menu.xaml (grained BandTemplate + 3px mint
    bar + sliding angle bracket on IsHighlighted, flat-top hex cell with mint check on IsSelected).
    Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Control x:Name="Border" Template="{DynamicResource ArrowTemplate}" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{TemplateBinding BorderBrush}" Focusable="False" />
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <DockPanel LastChildFill="False" Background="Transparent">
                                        <ToggleButton x:Name="FilterGroupIndicator" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                      Margin="0,0,-5,0" Background="Transparent" BorderThickness="0" Padding="0" Width="30" Height="28" VerticalAlignment="Center" Visibility="Collapsed"
                                                      IsHitTestVisible="False" Focusable="False" IsChecked="True"
                                                      Style="{DynamicResource ExpanderDownHeaderStyle}" />
                                        <Grid x:Name="FilterOriginalArrow" DockPanel.Dock="Right" Width="24" Height="24" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <ContentControl x:Name="Arrow" Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                            Foreground="{DynamicResource TextBrushDarker}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                                        </Grid>
                                    </DockPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType={x:Type FilterPanel}}, FallbackValue=False}" Value="True">
                                            <Setter TargetName="FilterOriginalArrow" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="FilterGroupIndicator" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border Margin="12,0,36,0" IsHitTestVisible="False">
                            <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.FontFamily="{DynamicResource HeadingFontFamily}" TextElement.FontWeight="Bold" TextElement.FontSize="15"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        </Border>
                        <TextBox MinHeight="0" x:Name="PART_EditableTextBox" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 Margin="0,0,36,0" Focusable="True" BorderThickness="0" Background="Transparent" Style="{DynamicResource BareTextBox}" Padding="{DynamicResource InputPadding}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" Foreground="{DynamicResource TextBrush}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               VerticalOffset="2" Focusable="False" AllowsTransparency="True">
                            <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                                <ScrollViewer Margin="0,10,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Name="ItemsPresenter" Margin="4,0" KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Border" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Border" />
                        </MultiTrigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="ContentSite" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid x:Name="ListRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid x:Name="ListHover" Margin="0,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                            <Control Template="{DynamicResource BandTemplate}"
                                     Foreground="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource SelectedBorderBrush}"
                                     Focusable="False" IsTabStop="False" />
                            <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}" />
                        </Grid>
                        <Path x:Name="ListCursor" Width="5" Height="8" Margin="6,0,0,0" Stretch="Fill"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Data="M 0,0 L 5,4 L 0,8" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1.5"
                              Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                            <Path.RenderTransform>
                                <TranslateTransform x:Name="ListCursorShift" X="-4" />
                            </Path.RenderTransform>
                        </Path>
                        <Grid Margin="16,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="ListCheck" Width="15" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                                <Path Stretch="Fill" Data="M 4,0 L 11,0 L 15,6.5 L 11,13 L 4,13 L 0,6.5 Z"
                                      Fill="{DynamicResource InputBackgroundBrush}" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" />
                                <ContentControl Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="{DynamicResource FocusBrush}"
                                                Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}" Focusable="False" />
                            </Grid>
                            <ContentPresenter x:Name="ListLabel" Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="ListCheck" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ListHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListCursor" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ListCursor" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="ListCursorShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ListHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListCursor" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ListCursor" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ListCursorShift" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" TargetName="ListRow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
