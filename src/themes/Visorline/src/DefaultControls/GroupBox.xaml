<!--
    Visorline: GroupBox as one of the source's cards: near-black body inside a single hairline with angled corner brackets, headed by
    the hex bullet and the title in the display face over a ruler rule (hairline fading at both ends, ticks hanging under it).
    Content-sized, no fixed widths: the rule has no desired width and the bullet is 8px, so Statistics sections stay compact cards.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{DynamicResource ExpanderBackgroundBrush}" Padding="1">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" MinHeight="34" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                    <DockPanel Margin="14,8,14,7" LastChildFill="True">
                                        <Path DockPanel.Dock="Left" Width="8" Height="9" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource HeadingMarkerBrush}" Data="M4,0 L8,2.25 L8,6.75 L4,9 L0,6.75 L0,2.25Z" />
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                          TextElement.FontFamily="{DynamicResource HeadingFontFamily}" TextElement.FontWeight="Bold" TextElement.FontSize="15"
                                                          TextElement.Foreground="{DynamicResource HeadingForegroundBrush}">
                                            <ContentPresenter.Resources>
                                                <DataTemplate DataType="{x:Type sys:String}">
                                                    <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                                </DataTemplate>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </DockPanel>
                                    <Control Template="{DynamicResource RulerLineTemplate}" Foreground="{DynamicResource HeadingRuleBrush}" BorderBrush="{DynamicResource FrameBrush}" Margin="14,0,14,-8" VerticalAlignment="Bottom" Focusable="False" />
                                </Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                        <Control Template="{DynamicResource FramedPlateTemplate}" Foreground="{DynamicResource FrameBrush}" Focusable="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
