<!--
    Canister: DerivedStyles/PlayButton.xaml.
    HERO MOMENT: Golden Marker Masking-Tape & Dual-Chromatic Comic CTA + Leo Cobalt RunningActionIndicator.
    - Idle Play: Golden Marker (#F7DC28) plate with 1.5px dark ink rim, subtle crepe tape texture (tape-strip.png),
      resting +-2px Tag Crimson (top-left) and Acid Mutagen (bottom-right) chromatic fringes, circular Mutagen play disc,
      and Anton uppercase italic ink label.
    - Hover: lifts -1.5px (BackEase), flares chromatic fringes out to +-3.5px, sweeps diagonal ooze-glint.png sheen.
    - Press: punches cleanly down into Tape Fold Gold (#DFB517).
    - Tag="ContextAction" hides Play-only glyphs (PlayDisc).
    - IsLaunching / IsRunning: switches slab fill to solid Leo Cobalt (#165DC4, >=5.85:1 bare, 7.4-10.8:1 under RunningBreath),
      collapses idle hover & chromatic fringes, reserves PlayRoom (0,0,34,0) for 3 staggered comic speed stars, sweeps
      angled comic-slash RunningScan while launching, and shows LOCCancelLabel + RunningHoverDim strictly on
      IsRunning + RelativeSource Self IsMouseOver while keeping PlayContent Visibility="Hidden".
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinWidth" Value="158" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0,20,0" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="BtnLiftY" Y="0" />
                        </Grid.RenderTransform>

                        <!-- Dual Chromatic Offset Outer Fringes (Tag Crimson top-left, Acid Mutagen bottom-right) -->
                        <Border x:Name="FringeCrimson" Background="{DynamicResource DangerBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="RedOff" X="-2" Y="-2" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="FringeMutagen" Background="{DynamicResource PrimaryButtonGlowBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="GreenOff" X="2" Y="2" />
                            </Border.RenderTransform>
                        </Border>

                        <!-- Main Golden Marker Masking-Tape Plate -->
                        <Border x:Name="PlayFill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <!-- Subtle crepe masking-tape texture -->
                                <Rectangle x:Name="TapeGrain" Fill="{DynamicResource GiltDimBrush}" Opacity="0.22"
                                           OpacityMask="{DynamicResource LocalTapeStripMask}" IsHitTestVisible="False" />

                                <!-- Idle Play hover layer (collapsed while launching/running) -->
                                <Border x:Name="HoverPlate" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Sweeping diagonal comic highlight slash (ooze-glint.png) -->
                                <Rectangle x:Name="HoverGlint" Fill="{DynamicResource TextBrush}"
                                           OpacityMask="{DynamicResource LocalOozeGlintMask}"
                                           Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="GlintX" X="-120" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>

                                <!-- Separate Pressed layer -->
                                <Border x:Name="PressedPlate" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- RunningBreath scrim (darkens solid Leo Cobalt plate for >=7.4:1 Chalk White legibility) -->
                                <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}"
                                        CornerRadius="{DynamicResource CornerRadiusSmall}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- RunningScan angled comic-slash comet across the button slab while launching -->
                                <Border x:Name="RunningScan" Visibility="Collapsed"
                                        Background="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.68"
                                        IsHitTestVisible="False">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>

                                <!-- RunningHoverDim scrim shown strictly with Cancel on RUNNING + button Self hover -->
                                <Border x:Name="RunningHoverDim" Background="{DynamicResource ScrimBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- RunningMarkRoom left="0" right="34" -->
                                <Border x:Name="PlayRoom" Padding="0">
                                    <StackPanel x:Name="PlayContent" Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Circular Mutagen Green (A)-style Play Disc -->
                                        <Border x:Name="PlayDisc" Width="20" Height="20" Margin="0,0,8,0"
                                                CornerRadius="{DynamicResource CornerRadiusFull}"
                                                Background="{DynamicResource GlyphBrush}"
                                                BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="1.5"
                                                VerticalAlignment="Center" IsHitTestVisible="False">
                                            <ContentControl Width="9" Height="9" Margin="1.5,0,0,0"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Focusable="False" IsHitTestVisible="False"
                                                            Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{DynamicResource PrimaryButtonForegroundBrush}" />
                                        </Border>
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                    </StackPanel>
                                </Border>

                                <!-- Cancel label: visible ONLY when IsRunning=True AND button Self IsMouseOver=True -->
                                <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                           FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                           FontStyle="{TemplateBinding FontStyle}" Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayDisc" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Idle Play Hover (suppressed when IsLaunching/IsRunning) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlint" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="BtnLiftY" Storyboard.TargetProperty="Y" To="-1.5" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RedOff" Storyboard.TargetProperty="X" To="-3.5" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="RedOff" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="GreenOff" Storyboard.TargetProperty="X" To="3.5" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="GreenOff" Storyboard.TargetProperty="Y" To="3" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="HoverGlint" Storyboard.TargetProperty="Opacity" From="0" To="0.42" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="GlintX" Storyboard.TargetProperty="X" From="-130" To="140" Duration="0:0:0.38">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverGlint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="BtnLiftY" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="RedOff" Storyboard.TargetProperty="X" To="-2" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="RedOff" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="GreenOff" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="GreenOff" Storyboard.TargetProperty="Y" To="2" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlint" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <!-- Pressed layer -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayPressIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- RunningMarkRoom left="0" right="34" -->
                        <!-- LAUNCHING: Leo Cobalt slab + angled comic-slash comet sweep -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="FringeCrimson" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FringeMutagen" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TapeGrain" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverGlint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,34,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:1.6">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="LaunchingScrimIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.28" To="0.46" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                                <RemoveStoryboard BeginStoryboardName="LaunchingScrimIn" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING: Calm breathing Leo Cobalt slab -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="FringeCrimson" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FringeMutagen" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TapeGrain" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverGlint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,34,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3.2">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.22" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.40" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.22" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING + Button Self Hover: show LOCCancelLabel + RunningHoverDim; PlayContent stays Hidden (no resize) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningHoverDim" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" From="0" To="0.34" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="RunningCancelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LaunchingIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LaunchingIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- RunningActionIndicator: overlay laid over the Play / ContextAction cell on both game pages -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />

                        <!-- Segmented 3-cell ooze-vial charge foot bar -->
                        <Grid Height="2" VerticalAlignment="Bottom" Margin="5,0,5,4">
                            <Rectangle Fill="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.30" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource LaunchingIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="FillScaleX" ScaleX="0" />
                                </Rectangle.RenderTransform>
                                <Rectangle.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,14,2" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#FF000000">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,11,2" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>

                        <!-- 3 staggered 4-point comic speed stars at right edge (inside reserved 34px PlayRoom) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path x:Name="Star1" Width="7" Height="7" Margin="0,0,2,0" Stretch="Uniform"
                                  Fill="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.7"
                                  Data="M6,0 L7.6,4.4 L12,6 L7.6,7.6 L6,12 L4.4,7.6 L0,6 L4.4,4.4 Z">
                                <Path.RenderTransform><TranslateTransform x:Name="Star1Y" Y="0" /></Path.RenderTransform>
                            </Path>
                            <Path x:Name="Star2" Width="7" Height="7" Margin="0,0,2,0" Stretch="Uniform"
                                  Fill="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.7"
                                  Data="M6,0 L7.6,4.4 L12,6 L7.6,7.6 L6,12 L4.4,7.6 L0,6 L4.4,4.4 Z">
                                <Path.RenderTransform><TranslateTransform x:Name="Star2Y" Y="0" /></Path.RenderTransform>
                            </Path>
                            <Path x:Name="Star3" Width="7" Height="7" Stretch="Uniform"
                                  Fill="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.7"
                                  Data="M6,0 L7.6,4.4 L12,6 L7.6,7.6 L6,12 L4.4,7.6 L0,6 L4.4,4.4 Z">
                                <Path.RenderTransform><TranslateTransform x:Name="Star3Y" Y="0" /></Path.RenderTransform>
                            </Path>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:1.6">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star1Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="-3.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.30" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star2Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="-3.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.40" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star3Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="-3.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.50" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3.2">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
