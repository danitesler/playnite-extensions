<!--
    Canister: DerivedStyles/PropertyItemButton.xaml.
    Metadata values inside the pinned torn spiral-notebook flyer (ParchmentBrush #F1EDE2):
    - Default link: Cobalt ballpoint ink (#124C99) with crisp underline; hover lights a Golden Marker highlighter strip behind it.
    - Tag="Chip" (ItemsControl ancestor): Inked Kraft-Paper Sticker Tag (#E4DFD0 fill, 1.5px dark marker ink rim,
      3.5px deep mutagen left bar, Patrick Hand ink text, ControlCornerRadius=3); hover pops -1.5px (BackEase) into
      Golden Marker Yellow (#F7DC28) with a Tag Crimson offset shadow & left bar.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,1,8,1" />
        <Setter Property="Foreground" Value="{DynamicResource ParchmentLinkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Ballpoint Ink Link -->
                        <Grid x:Name="LinkLayer">
                            <Border x:Name="LinkHighlight" Background="{DynamicResource PropertyItemHoverBackgroundBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Margin="-3,0"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            <TextBlock x:Name="LinkText"
                                       Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                                       TextWrapping="Wrap" TextDecorations="Underline" IsHitTestVisible="False" />
                        </Grid>

                        <!-- Inked Kraft-Paper Sticker Chip (Tag="Chip") -->
                        <Grid x:Name="ChipLayer" Visibility="Collapsed" MinHeight="22" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ChipLiftY" Y="0" />
                            </Grid.RenderTransform>

                            <!-- Hover crimson offset comic shadow -->
                            <Border x:Name="ChipShadow" Background="{DynamicResource DangerBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Visibility="Collapsed" Opacity="0">
                                <Border.RenderTransform>
                                    <TranslateTransform X="2" Y="2" />
                                </Border.RenderTransform>
                            </Border>

                            <Border x:Name="ChipPlate" Background="{DynamicResource PropertyItemBackgroundBrush}"
                                    BorderBrush="{DynamicResource ParchmentTextBrush}" BorderThickness="1.5"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="ChipHoverFill" Background="{DynamicResource PropertyItemHoverBackgroundBrush}"
                                            Visibility="Collapsed" Opacity="0" />
                                    <Rectangle x:Name="ChipTick" Width="3.5" HorizontalAlignment="Left"
                                               Fill="{DynamicResource LocalOozeDeepBrush}" />
                                    <TextBlock Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                               FontFamily="{DynamicResource NoteFontFamily}" FontSize="13"
                                               Foreground="{DynamicResource PropertyItemForegroundBrush}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,1,8,1" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                            <Setter TargetName="ChipLayer" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LinkLayer" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LinkText" Property="Foreground" Value="{DynamicResource ParchmentTextBrush}" />
                            <Setter TargetName="ChipTick" Property="Fill" Value="{DynamicResource DangerBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PropHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LinkHighlight" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipShadow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="LinkHighlight" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="ChipHoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="ChipShadow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="ChipLiftY" Storyboard.TargetProperty="Y" To="-1.5" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PropHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="LinkHighlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="ChipHoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="ChipShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="ChipLiftY" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LinkHighlight" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipShadow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="LinkText" Property="Foreground" Value="{DynamicResource ParchmentLabelBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="Margin" Value="0,2,5,2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
