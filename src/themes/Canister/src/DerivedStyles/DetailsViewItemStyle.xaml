<!--
    Canister: DerivedStyles/DetailsViewItemStyle.xaml.
    Calm #0D0F12 sewer-chalk rows with smooth animated hover (charcoal wash + sliding Acid Mutagen pointer),
    animated click/selection (comic callout plate with sketchy white hairlines, springing dual Acid Mutagen + Tag Crimson
    left rail, and Golden Marker text), RowHoverAction transparent Play/Install buttons + RowHoverRoom (0,0,38,0),
    and Leo Cobalt Blue RunningIndicator (angled comic-slash scan, segmented ooze-vial foot bar, 3 comic speed stars,
    RowRoom 0,0,34,0 + RunningMarkPlate).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- RowHoverAction: transparent 26x26 Play/Install button bound to row Foreground -->
    <Style x:Key="LocalRowHoverBtnStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <ContentControl Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{TemplateBinding Foreground}" Focusable="False" />
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            <Setter TargetName="Glyph" Property="Width" Value="17" />
                            <Setter TargetName="Glyph" Property="Height" Value="17" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="9,5,10,5" />
        <Setter Property="Margin" Value="0,1.5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent" MinHeight="34" SnapsToDevicePixels="True">
                        <!-- Hover Layer (collapsed at rest) -->
                        <Border x:Name="HoverPlate" Background="{DynamicResource ListItemHoverBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Path x:Name="HoverPtr" Width="6" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="3,0,0,0" Stretch="Uniform" Fill="{DynamicResource GlyphBrush}"
                              Data="M0,0 L8,5 L0,10 Z" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Path.RenderTransform>
                                <TranslateTransform x:Name="HoverPtrX" X="-5" />
                            </Path.RenderTransform>
                        </Path>

                        <!-- Selected Layer: comic callout plate + dual Mutagen/Crimson left bar -->
                        <Border x:Name="SelectedPlate" Background="{DynamicResource ListItemSelectedBrush}"
                                BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="0,1.5,0,1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="SelectedBar" Width="3.5" HorizontalAlignment="Left"
                                Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="SelBarY" ScaleY="0.15" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="SelectedCrimson" Width="1.5" Margin="3.5,3,0,3" HorizontalAlignment="Left"
                                Background="{DynamicResource DangerBrush}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                        <!-- Row Content wrapped in RowRoom (running) & RowHoverRoom (hover action) -->
                        <Border x:Name="RowRoom" Padding="0">
                            <Border x:Name="RowHoverRoom" Padding="0">
                                <Border x:Name="LabelShift" Padding="{TemplateBinding Padding}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="RowTextX" X="0" />
                                    </Border.RenderTransform>
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </Border>
                        </Border>

                        <!-- RowHoverAction: Play (installed) / Install (not installed) on right edge -->
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button x:Name="RowHoverPlay" Content="{DynamicResource IconPlay}"
                                    Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LocalRowHoverBtnStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                    <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                    <Condition Binding="{Binding IsRunning}" Value="False" />
                                                    <Condition Binding="{Binding IsLaunching}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="RowHoverInstall" Content="{DynamicResource IconDownload}"
                                    Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LocalRowHoverBtnStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                    <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                    <Condition Binding="{Binding IsRunning}" Value="False" />
                                                    <Condition Binding="{Binding IsLaunching}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- RunningIndicator (above selection & hover layers, Leo Cobalt #165DC4) -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.18"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border x:Name="RunningScan" Visibility="Collapsed"
                                    Background="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.4"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />

                            <!-- RunningMarkPlate strip behind the 3 comic speed stars -->
                            <Border x:Name="RunningMarkPlate" Width="34" HorizontalAlignment="Right"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34"
                                    CornerRadius="0,3,3,0">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.4" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>

                            <!-- Segmented foot line -->
                            <Grid Height="2" VerticalAlignment="Bottom" Margin="3,0,3,2">
                                <Rectangle Fill="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource LaunchingIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="FillScaleX" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                    <Rectangle.OpacityMask>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,14,2" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="#FF000000">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,11,2" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>

                            <!-- 3 staggered comic speed stars at far right -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Path x:Name="Star1" Width="7" Height="7" Margin="0,0,2,0" Stretch="Uniform"
                                      Fill="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.7"
                                      Data="M6,0 L7.6,4.4 L12,6 L7.6,7.6 L6,12 L4.4,7.6 L0,6 L4.4,4.4 Z">
                                    <Path.RenderTransform><TranslateTransform x:Name="Star1Y" Y="0" /></Path.RenderTransform>
                                </Path>
                                <Path x:Name="Star2" Width="7" Height="7" Margin="0,0,2,0" Stretch="Uniform"
                                      Fill="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.7"
                                      Data="M6,0 L7.6,4.4 L12,6 L7.6,7.6 L6,12 L4.4,7.6 L0,6 L4.4,4.4 Z">
                                    <Path.RenderTransform><TranslateTransform x:Name="Star2Y" Y="0" /></Path.RenderTransform>
                                </Path>
                                <Path x:Name="Star3" Width="7" Height="7" Stretch="Uniform"
                                      Fill="{DynamicResource LaunchingIndicatorBrush}" Opacity="0.7"
                                      Data="M6,0 L7.6,4.4 L12,6 L7.6,7.6 L6,12 L4.4,7.6 L0,6 L4.4,4.4 Z">
                                    <Path.RenderTransform><TranslateTransform x:Name="Star3Y" Y="0" /></Path.RenderTransform>
                                </Path>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPtr" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPtr" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPtrX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RowTextX" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPtr" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPtrX" Storyboard.TargetProperty="X" To="-5" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="RowTextX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPtr" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="HoverPtr" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowSelectIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedCrimson" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedCrimson" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SelBarY" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowSelectOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedCrimson" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedCrimson" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- LAUNCHING -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:1.6">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star1Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="-3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.30" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star2Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="-3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.40" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star3Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="-3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.50" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3.2">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star1" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star2" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star3" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard x:Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
