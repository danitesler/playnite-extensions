<!--
    Canister: DerivedStyles/TextBlockGameScore.xaml.
    Graffiti rank stamp plaques (Anton display inside dark ink stamp with Mutagen/Amber/Crimson rating edge).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="TextBlockGameScore" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="Background" Value="{DynamicResource ParchmentTextBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Positive}">
                <Setter Property="Background" Value="{DynamicResource ParchmentTextBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PositiveRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Mixed}">
                <Setter Property="Background" Value="{DynamicResource ParchmentTextBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MixedRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Negative}">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.None}">
                <Setter Property="Background" Value="{DynamicResource PropertyItemBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ParchmentLabelBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
