<!--
    Canister: DerivedStyles/StandardWindowStyle.xaml.
    44px alley-asphalt Settings & Dialog Title Band (CaptionHeight=44 == ContentPresenter top Margin=44).
    Carries a torn Vermilion painted masking-tape plaque (tape-strip.png) holding the Canister Brand Mark
    and Anton uppercase title (WindowSettings trigger sets LOCSettingsLabel), subtle aerosol splatter mist
    clipped inside a Canvas so small dialogs remain content-sized, and a dual chromatic closing rule.
    WindowDesignStyle is defined standalone (never BasedOn StandardWindowStyle).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource FrameBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Sketchbook crosshatch + corner halftone doodle behind dialog content (zero desired size) -->
                                <Grid Margin="0,44,0,0" ClipToBounds="True" IsHitTestVisible="False">
                                    <Rectangle Fill="{DynamicResource FrameBrush}" Opacity="0.065"
                                               OpacityMask="{DynamicResource LocalSketchHatchMask}" />
                                    <Canvas>
                                        <Rectangle Width="320" Height="240" Canvas.Right="0" Canvas.Bottom="0"
                                                   Fill="{DynamicResource GlyphBrush}" Opacity="0.11"
                                                   OpacityMask="{DynamicResource LocalHalftoneDoodleMask}" />
                                    </Canvas>
                                </Grid>

                                <!-- Dialog content offset equals CaptionHeight (44px) -->
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px Alley-Asphalt Title Band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}">
                                    <!-- Ghosted aerosol spray mist clipped in Canvas (zero desired width) -->
                                    <Grid ClipToBounds="True" IsHitTestVisible="False">
                                        <Canvas>
                                            <Rectangle Width="220" Height="116" Canvas.Right="110" Canvas.Top="-36"
                                                       Fill="{DynamicResource GlyphBrush}" Opacity="0.14"
                                                       OpacityMask="{DynamicResource LocalSplatterCloudMask}" />
                                        </Canvas>
                                    </Grid>

                                    <!-- Left Vermilion Painted Masking-Tape Plaque carrying Canister Brand Mark + Title -->
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Height="30" Margin="14,0,148,0" IsHitTestVisible="False">
                                        <Rectangle Fill="{DynamicResource HeaderBandBrush}"
                                                   OpacityMask="{DynamicResource LocalTapeStripMask}" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,20,0">
                                            <Control Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Template="{DynamicResource LocalBrandMarkTemplate}"
                                                     Foreground="{DynamicResource WindowTitleForegroundBrush}" />
                                            <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Caption buttons (46x44) -->
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Panel.ZIndex="3">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>

                                    <!-- 2px closing rule with Vermilion->Mutagen lead streak (brush + OpacityMask for ThemeModifier) -->
                                    <Grid Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <Rectangle Fill="{DynamicResource NormalBorderBrush}" />
                                        <Rectangle Width="150" HorizontalAlignment="Left" Fill="{DynamicResource DataChangeNotifBrush}">
                                            <Rectangle.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#FF000000" Offset="0" />
                                                    <GradientStop Color="#00000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <Rectangle Width="160" HorizontalAlignment="Left" Margin="90,0,0,0" Fill="{DynamicResource GlyphBrush}">
                                            <Rectangle.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#00000000" Offset="0" />
                                                    <GradientStop Color="#FF000000" Offset="0.45" />
                                                    <GradientStop Color="#00000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standalone WindowDesignStyle (never BasedOn StandardWindowStyle) -->
    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
