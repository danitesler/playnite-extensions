<!--
    Canister: Views/Sidebar.xaml.
    44px alley-asphalt vertical rail closed by a 1.5px chalk seam with Acid Mutagen->Golden Marker accent streak,
    crowned by a 44x50 Main Menu Canister Emblem tile with a Vermilion tape foot collar and Mutagen left edge bar,
    and grounded at the foot by 4 subtle identity color beads. Turns transparent when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,1.5,0"
                            Margin="{TemplateBinding Padding}">
                        <Grid>
                            <!-- Flat cn-pitch like the Settings section list, with the same margin doodles (0.11) -->
                            <Rectangle x:Name="RailSketch" Fill="{DynamicResource FrameBrush}" Opacity="0.11"
                                       OpacityMask="{DynamicResource LocalSidepanelSketchMask}" IsHitTestVisible="False" />
                            <!-- Ragged hand-inked vertical marker seam along rail edge -->
                            <Rectangle x:Name="RailSketchEdge" Width="10" HorizontalAlignment="Right" Margin="0,50,-5,0"
                                       Fill="{DynamicResource FrameBrush}" Opacity="0.42"
                                       OpacityMask="{DynamicResource LocalSketchEdgeVMask}" IsHitTestVisible="False" />

                            <!-- Upper Acid Mutagen edge streak along right seam (brush + OpacityMask) -->
                            <Rectangle x:Name="RailStreak" Width="2" Height="110" Margin="0,50,-1.5,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                                       Fill="{DynamicResource GlyphBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>

                            <DockPanel x:Name="DockContentHolder">
                                <!-- 44x50 Main Menu Emblem Tile with Mutagen left bar & Vermilion tape foot -->
                                <Border x:Name="PART_ElemMainMenu" DockPanel.Dock="Top"
                                        Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                        BorderBrush="{DynamicResource HeaderBandBrush}" BorderThickness="0,0,0,2"
                                        Width="44" Height="50" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Border x:Name="MenuHoverFill" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                        <Rectangle x:Name="MenuLeftBar" Width="3" HorizontalAlignment="Left"
                                                   Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                                        <!-- Manhole mark (LocalCanisterMenuMarkTemplate): lid lifts on hover, slides off for peeking eyes while open -->
                                        <Control x:Name="MenuMark" Padding="10,12"
                                                 Template="{DynamicResource LocalCanisterMenuMarkTemplate}"
                                                 Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                 Focusable="False" IsTabStop="False" />
                                    </Grid>
                                </Border>

                                <!-- Subtle 4-identity corner beads at rail foot -->
                                <StackPanel x:Name="RailFootBeads" DockPanel.Dock="Bottom"
                                            HorizontalAlignment="Center" Margin="0,8,0,12" IsHitTestVisible="False">
                                    <Ellipse Width="6" Height="6" Margin="0,0,0,5" Fill="{DynamicResource RunningIndicatorBrush}" />
                                    <Ellipse Width="6" Height="6" Margin="0,0,0,5" Fill="{DynamicResource DangerBrush}" />
                                    <Ellipse Width="6" Height="6" Margin="0,0,0,5" Fill="{DynamicResource LocalTagPurpleBrush}" />
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource HeaderBandBrush}" />
                                </StackPanel>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True" Margin="0,6,0,0"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="BorderThickness" Value="0" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailSketch" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailSketchEdge" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailStreak" />
                            <Setter Property="Background" Value="Transparent" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuLeftBar" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootBeads" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter TargetName="MenuMark" Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="MenuHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.17" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.17" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="BorderThickness" Value="1.5,0,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="RailStreak" />
                            <Setter Property="Margin" Value="-1.5,50,0,0" TargetName="RailStreak" />
                            <Setter Property="Padding" Value="0,25,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="BorderThickness" Value="0,0,0,1.5" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailStreak" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootBeads" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,138,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="BorderThickness" Value="0,1.5,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailStreak" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootBeads" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
