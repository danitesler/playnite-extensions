                                            <!-- Unlabelled Golden Marker masking-tape strip pinning top of flyer to wall -->
                                            <Rectangle Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Height="22" Margin="34,0,26,0"
