<!--
    Canister: Common.xaml.
    Shared spacing (ControlHeight=32, vertical paddings 4 for 1.5px ink borders), focus visual,
    shared white-mask FX ImageBrushes, BrandMarkTemplate (Cracked Mutagen Canister),
    DividerTemplate (dashed red conspiracy string + 4-point comic star), SteamScreenshotsSkeletonTemplate,
    and EmptyGameTemplate (comic-shard sticker card with dual chromatic fringes & aerosol mist).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Form field height & shared spacing -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Padding keys (vertical=4 with 1.5px ink borders so 32px ControlHeight rules every field) -->
    <Thickness x:Key="ButtonPadding">14,4,14,4</Thickness>
    <Thickness x:Key="InputPadding">8,4,8,4</Thickness>
    <Thickness x:Key="MenuPadding">4,6,4,6</Thickness>
    <Thickness x:Key="MenuItemPadding">8,0,10,0</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4,6,4,6</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,0,10,0</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6,10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">12,3,14,3</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">14</sys:Double>
    <Thickness x:Key="TooltipPadding">10,6,10,6</Thickness>

    <!-- Shared White-Mask FX OpacityMask Brushes (recolored via DynamicResource Fill brushes) -->
    <ImageBrush x:Key="LocalTapeStripMask" ImageSource="{ThemeFile 'Images/fx/tape-strip.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalSplatterCloudMask" ImageSource="{ThemeFile 'Images/fx/splatter-cloud.png'}" Stretch="Uniform" />
    <ImageBrush x:Key="LocalChalkGrainMask" ImageSource="{ThemeFile 'Images/fx/chalk-grain.png'}" TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute" Stretch="None" />
    <ImageBrush x:Key="LocalTornBottomMask" ImageSource="{ThemeFile 'Images/fx/torn-bottom.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalNotebookLinesMask" ImageSource="{ThemeFile 'Images/fx/notebook-lines.png'}" TileMode="Tile" Viewport="0,0,256,128" ViewportUnits="Absolute" Stretch="None" />
    <ImageBrush x:Key="LocalOozeGlintMask" ImageSource="{ThemeFile 'Images/fx/ooze-glint.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalSpiralHolesMask" ImageSource="{ThemeFile 'Images/fx/spiral-holes.png'}" TileMode="Tile" Viewport="0,0,24,256" ViewportUnits="Absolute" Stretch="None" />
    <ImageBrush x:Key="LocalSketchHatchMask" ImageSource="{ThemeFile 'Images/fx/sketch-hatch.png'}" TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute" Stretch="None" />
    <ImageBrush x:Key="LocalSidepanelSketchMask" ImageSource="{ThemeFile 'Images/fx/sidepanel-sketch.png'}" TileMode="Tile" Viewport="0,0,192,512" ViewportUnits="Absolute" Stretch="None" />
    <ImageBrush x:Key="LocalHalftoneDoodleMask" ImageSource="{ThemeFile 'Images/fx/halftone-doodle.png'}" Stretch="Uniform" />
    <ImageBrush x:Key="LocalSketchEdgeVMask" ImageSource="{ThemeFile 'Images/fx/sketch-edge-v.png'}" TileMode="Tile" Viewport="0,0,12,256" ViewportUnits="Absolute" Stretch="None" />

    <!-- PopupBorder fallback style -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- FocusVisual (crisp Acid Mutagen Green comic focus outline) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="1.5" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LocalNotesTextBox: read-only dark comic note block for Game Page Notes -->
    <Style x:Key="LocalNotesTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Original Brand Mark: Cracked Mutagen / Aerosol Canister (zero franchise logos) -->
    <ControlTemplate x:Key="LocalBrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="100" Height="100">
                <Canvas RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="-14" CenterX="50" CenterY="50" />
                    </Canvas.RenderTransform>
                    <Path Fill="{TemplateBinding Foreground}" Data="M37,11 L63,11 L66,18 L34,18 Z" />
                    <Border Canvas.Left="44" Canvas.Top="4" Width="12" Height="6" CornerRadius="1.5" Background="{TemplateBinding Foreground}" />
                    <Path Fill="{TemplateBinding Foreground}" Data="M30,21 L70,21 L70,44 L58,39 L49,49 L41,42 L30,48 Z" />
                    <Path Fill="{TemplateBinding Foreground}" Data="M30,57 L41,51 L50,58 L59,48 L70,53 L70,79 L30,79 Z" />
                    <Path Fill="{TemplateBinding Foreground}" Data="M33,82 L67,82 L64,90 L36,90 Z" />
                </Canvas>
                <Path Fill="{TemplateBinding Foreground}" Data="M80,26 C84,32 85,37 81,39 C77,41 74,37 76,32 Z" />
                <Ellipse Canvas.Left="83.6" Canvas.Top="42.6" Width="6.8" Height="6.8" Fill="{TemplateBinding Foreground}" />
                <Path Fill="{TemplateBinding Foreground}" Data="M16,58 C20,54 24,55 24,59 C24,63 19,65 15,63 Z" />
                <Ellipse Canvas.Left="11.2" Canvas.Top="43.2" Width="5.6" Height="5.6" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Main menu mark: a sewer manhole lid (ring + three grate slots) over a Mutagen-lit hole, drawn in the host's Foreground.
         Hover: the lid pops up and tilts, showing a crescent of Mutagen glow underneath (BackEase, reverses on exit).
         Open (ContextMenu.IsOpen on the nearest Border, PART_ElemMainMenu): the lid slides off down to the right and a masked pair of
         eyes rises in the hole (Vermilion band) and blinks every 3s until the menu closes.
         Hover and open never animate the same element or property; each exit covers everything its enter animates.
         The host's Padding sets the drawing size (24px in the rail, 18px in the top bar). -->
    <ControlTemplate x:Key="LocalCanisterMenuMarkTemplate" TargetType="Control">
        <Grid Background="Transparent">
            <Viewbox Margin="{TemplateBinding Padding}" Stretch="Uniform" IsHitTestVisible="False">
                <Canvas Width="24" Height="24">
                    <Ellipse Canvas.Left="3.4" Canvas.Top="3.4" Width="17.2" Height="17.2" Fill="{DynamicResource GlyphBrush}" />
                    <Canvas x:Name="Peek" Width="24" Height="24" Opacity="0">
                        <Canvas.RenderTransform><TranslateTransform x:Name="PeekRise" Y="3" /></Canvas.RenderTransform>
                        <Path Data="M4.2,9.6 H19.8 L20.2,14.6 H3.8 Z" Fill="{DynamicResource HeaderBandBrush}" />
                        <Canvas>
                            <Canvas.RenderTransform><ScaleTransform x:Name="EyesBlink" CenterY="12.1" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                            <Path Data="M6.2,12.1 C6.6,10.4 9.6,10.2 10.6,11.4 C10.2,13.4 7.2,13.8 6.2,12.1 Z M17.8,12.1 C17.4,10.4 14.4,10.2 13.4,11.4 C13.8,13.4 16.8,13.8 17.8,12.1 Z"
                                  Fill="{DynamicResource TextBrush}" />
                            <Path Data="M8.6,11 H9.9 V12.6 H8.6 Z M14.1,11 H15.4 V12.6 H14.1 Z" Fill="{DynamicResource ShellBackgroundBrush}" />
                        </Canvas>
                    </Canvas>
                    <Canvas Width="24" Height="24">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="LidSlideTurn" CenterX="12" CenterY="12" Angle="0" />
                                <TranslateTransform x:Name="LidSlide" X="0" Y="0" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Canvas Width="24" Height="24">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="LidTilt" CenterX="12" CenterY="12" Angle="0" />
                                    <TranslateTransform x:Name="LidLift" X="0" Y="0" />
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Ellipse Canvas.Left="2.6" Canvas.Top="2.6" Width="18.8" Height="18.8"
                                     Fill="{DynamicResource ShellBackgroundBrush}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" />
                            <Path Data="M7.5,7.6 H16.5 V9.6 H7.5 Z M6,11 H18 V13 H6 Z M7.5,14.4 H16.5 V16.4 H7.5 Z" Fill="{TemplateBinding Foreground}" />
                        </Canvas>
                    </Canvas>
                </Canvas>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LidLift" Storyboard.TargetProperty="Y" To="-3.6" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LidLift" Storyboard.TargetProperty="X" To="1" Duration="0:0:0.26" />
                            <DoubleAnimation Storyboard.TargetName="LidTilt" Storyboard.TargetProperty="Angle" To="-12" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LidLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LidLift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LidTilt" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LidSlide" Storyboard.TargetProperty="X" To="7" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LidSlide" Storyboard.TargetProperty="Y" To="10" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LidSlideTurn" Storyboard.TargetProperty="Angle" To="35" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Peek" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.12" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="PeekRise" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.12" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyesBlink" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.5" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:2.7" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:2.78" Value="0.1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:2.88" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LidSlide" Storyboard.TargetProperty="X" To="0" BeginTime="0:0:0.06" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LidSlide" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.06" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LidSlideTurn" Storyboard.TargetProperty="Angle" To="0" BeginTime="0:0:0.06" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Peek" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PeekRise" Storyboard.TargetProperty="Y" To="3" Duration="0:0:0.12" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="EyesBlink" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.05" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- DividerTemplate: Dashed crimson conspiracy string centered on a 4-point comic star (<=10px, content-safe) -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="10" IsHitTestVisible="False" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Height="1.5" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.65">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,8,2" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="{DynamicResource MenuSeparatorBrush}">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,5,2" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Path Grid.Column="1" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center"
                  Fill="{DynamicResource GlyphBrush}"
                  Data="M6,0 L7.6,4.4 L12,6 L7.6,7.6 L6,12 L4.4,7.6 L0,6 L4.4,4.4 Z" />
            <Rectangle Grid.Column="2" Height="1.5" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.65">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,8,2" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="{DynamicResource MenuSeparatorBrush}">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,5,2" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- SteamScreenshotsSkeletonTemplate: Pulsing comic-framed 16:9 + 5-thumb placeholder -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False">
            <Border x:Name="SkelMain" Height="164" Margin="0,0,0,8"
                    Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource SlotBorderBrush}"
                    BorderThickness="1.5" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.55" />
            <UniformGrid Columns="5" Height="42">
                <Border Margin="0,0,6,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" CornerRadius="2" Opacity="0.45" />
                <Border Margin="0,0,6,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" CornerRadius="2" Opacity="0.45" />
                <Border Margin="0,0,6,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" CornerRadius="2" Opacity="0.45" />
                <Border Margin="0,0,6,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" CornerRadius="2" Opacity="0.45" />
                <Border Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" CornerRadius="2" Opacity="0.45" />
            </UniformGrid>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkelPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkelMain" Storyboard.TargetProperty="Opacity" From="0.35" To="0.7" Duration="0:0:1.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkelPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- EmptyGameTemplate: Pinned comic-shard sticker card with aerosol mist & Cracked Canister mark -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <!-- Aerosol spray splatter halo -->
            <Rectangle x:Name="EmptySplatter" Width="320" Height="210"
                       Fill="{DynamicResource GlyphBrush}" OpacityMask="{DynamicResource LocalSplatterCloudMask}"
                       Opacity="0.16" IsHitTestVisible="False" />

            <!-- Dual Chromatic Offset Fringes -->
            <Border Background="{DynamicResource DangerBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform X="-3.5" Y="-3" />
                </Border.RenderTransform>
            </Border>
            <Border Background="{DynamicResource GlyphBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform X="3.5" Y="3" />
                </Border.RenderTransform>
            </Border>

            <!-- Main dark comic card -->
            <Border Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource FrameBrush}"
                    BorderThickness="1.5" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="32,26,32,24" MinWidth="280">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Top Vermilion Masking Tape Strip -->
                    <Rectangle Width="120" Height="10" Margin="0,-16,0,14"
                               Fill="{DynamicResource HeaderBandBrush}"
                               OpacityMask="{DynamicResource LocalTapeStripMask}"
                               IsHitTestVisible="False" />

                    <Control Width="64" Height="64" Margin="0,0,0,14" HorizontalAlignment="Center"
                             Foreground="{DynamicResource GlyphBrush}"
                             Template="{DynamicResource LocalBrandMarkTemplate}"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" />

                    <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                               FontFamily="{DynamicResource HeadingFontFamily}"
                               FontSize="{DynamicResource FontSizeLarger}"
                               Foreground="{DynamicResource HeadingForegroundBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" />

                    <Control Margin="20,12,20,0" Template="{DynamicResource DividerTemplate}"
                             Focusable="False" IsTabStop="False" />
                </StackPanel>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyMistPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="EmptySplatter" Storyboard.TargetProperty="Opacity"
                                             From="0.12" To="0.24" Duration="0:0:2.6">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyMistPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
