<!--
    Canister: Media.xaml.
    Bespoke hand-inked chunky comic-silhouette Icon<Role> StreamGeometries authored for Canister,
    paired with IconTemplate / IconSmallTemplate and Playnite's 22 icofont menu icons
    (declared without local Foreground so Menu.xaml TextElement.Foreground recolors them cleanly).
-->
<ResourceDictionary xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="IconTemplate">
        <Viewbox MaxWidth="{DynamicResource IconSize}" MaxHeight="{DynamicResource IconSize}" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" IsHitTestVisible="False">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                  Width="24" Height="24" Stretch="Uniform" SnapsToDevicePixels="False" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox MaxWidth="12" MaxHeight="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" IsHitTestVisible="False">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                  Width="24" Height="24" Stretch="Uniform" SnapsToDevicePixels="False" />
        </Viewbox>
    </DataTemplate>

