<!--
    Canister: CustomControls/SearchBox.xaml.
    Hand-inked alley-tag search well with 6% sketch-hatch tooth, 3px Acid Mutagen left marker tab,
    persistent magnifier outside PART_SeachIcon, and full transparent hit-test Border on PART_ClearTextIcon.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="FocusShadow" Background="{DynamicResource GlyphBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform X="2" Y="2" /></Border.RenderTransform>
                        </Border>
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <Rectangle Fill="{DynamicResource FrameBrush}" Opacity="0.06"
                                           OpacityMask="{DynamicResource LocalSketchHatchMask}" IsHitTestVisible="False" />
                                <!-- 3px left marker edge bar -->
                                <Rectangle x:Name="SearchMarker" Width="3" HorizontalAlignment="Left"
                                           Fill="{DynamicResource NormalBorderBrush}" IsHitTestVisible="False" />

                                <Grid Margin="10,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="PART_SeachIcon" Width="0" Height="0" Opacity="0" IsHitTestVisible="False" />

                                    <ContentControl x:Name="Glyph" Grid.Column="0" Width="14" Height="14"
                                                    Margin="0,0,7,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                    Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}"
                                                    Foreground="{DynamicResource GlyphBrush}" />

                                    <TextBox x:Name="PART_TextInpuText" Grid.Column="1"
                                             Style="{DynamicResource BareTextBox}"
                                             Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Foreground="{TemplateBinding Foreground}"
                                             CaretBrush="{DynamicResource GlyphBrush}"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center" />

                                    <ContentControl x:Name="PART_ClearTextIcon" Grid.Column="2" Cursor="Hand"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Foreground="{DynamicResource TextBrushDarker}">
                                        <ContentControl.Template>
                                            <ControlTemplate TargetType="ContentControl">
                                                <Border Background="Transparent" Width="24" Height="24" SnapsToDevicePixels="True">
                                                    <ContentControl Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    IsHitTestVisible="False"
                                                                    Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                    Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                            </ControlTemplate>
                                        </ContentControl.Template>
                                    </ContentControl>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
                            <Setter TargetName="SearchMarker" Property="Fill" Value="{DynamicResource GiltBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="SearchMarker" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="FocusShadow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Text.Length, ElementName=PART_TextInpuText, FallbackValue=0}" Value="0">
                            <Setter TargetName="PART_ClearTextIcon" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="False" />
                                <Condition Property="Text" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" SourceName="PART_ClearTextIcon" Value="True">
                            <Setter TargetName="PART_ClearTextIcon" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
