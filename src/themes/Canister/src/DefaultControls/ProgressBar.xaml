<!--
    Canister: DefaultControls/ProgressBar.xaml.
    Tapered combat HP swoosh bar (Crimson -> Vermilion -> Marker Yellow -> Acid Mutagen Green) with crisp white
    comic top highlight streak. Keeps MinHeight=8 with Height={TemplateBinding Height} so TopPanel PART_ProgressGlobal
    renders 12px while dialogs remain 8px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid Height="{TemplateBinding Height}" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1"
                                        Background="{DynamicResource LocalHealthSwooshBrush}">
                                    <Rectangle Height="2" VerticalAlignment="Top" Margin="0,1,0,0"
                                               Fill="{DynamicResource TextBrush}" Opacity="0.38" IsHitTestVisible="False" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
