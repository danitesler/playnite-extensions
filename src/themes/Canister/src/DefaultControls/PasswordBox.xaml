<!--
    Canister: DefaultControls/PasswordBox.xaml.
    32px hand-inked comic notebook password well (Padding applied once; explicit Hidden scrollbars on PART_ContentHost).
    Matches TextBox.xaml with 6% sketch-hatch tooth, 3px left marker tab, and dual chromatic focus fringes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="11,4,8,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="FocusRed" Background="{DynamicResource DangerBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform X="-1.5" Y="-1.5" /></Border.RenderTransform>
                        </Border>
                        <Border x:Name="FocusGreen" Background="{DynamicResource GlyphBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform X="1.5" Y="1.5" /></Border.RenderTransform>
                        </Border>
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <Rectangle Fill="{DynamicResource FrameBrush}" Opacity="0.06"
                                           OpacityMask="{DynamicResource LocalSketchHatchMask}" IsHitTestVisible="False" />
                                <Rectangle x:Name="MarkerTab" Width="3" HorizontalAlignment="Left"
                                           Fill="{DynamicResource NormalBorderBrush}" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
                            <Setter TargetName="MarkerTab" Property="Fill" Value="{DynamicResource GiltBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="MarkerTab" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="FocusRed" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusGreen" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
