<!--
    Canister: DefaultControls/TreeView.xaml.
    Settings & Add-ons section navigation (docs/themes/settings-screens.md):
    - Minimal bare 28px rows in calm Barlow body font (no idle box/border, no heading caps).
    - Separate named layers (HoverPlate, SelectedPlate, SelectedBar) animated on Opacity:
      idle TextBrushDarker -> hover soft charcoal wash + TextBrush (0.12s in / 0.2s out) ->
      selected Mutagen-ink wash + 2.5px Acid Mutagen left bar + Golden Marker text.
    - WindowSettings (Width=252) & WindowExtensions (Width=276) triggers reserve ScrollViewer.VerticalScrollBarVisibility=Visible
      and disable horizontal scroll so expanding nodes never jumps the layout.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LocalTreeExpanderToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" Width="14" Height="14">
                        <ContentControl x:Name="Arrow" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{DynamicResource GlyphBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="Content" Value="{DynamicResource IconDropDown}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Grid x:Name="Bd" MinHeight="28" Margin="0,0.5" Background="Transparent">
                            <Border x:Name="HoverPlate" Background="{DynamicResource ListItemHoverBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="SelectedPlate" Background="{DynamicResource SelectedBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="SelectedBar" Width="2.5" Margin="0,3,0,3" HorizontalAlignment="Left"
                                    Background="{DynamicResource GlyphBrush}" Opacity="0" IsHitTestVisible="False" />

                            <Grid Margin="10,3,8,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="Expander" Grid.Column="0" Width="14" Height="14"
                                              Style="{StaticResource LocalTreeExpanderToggle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press" VerticalAlignment="Center" />

                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="MaxWidth" Value="192" />
                                        </Style>
                                        <Style TargetType="Separator">
                                            <Setter Property="Tag" Value="TreeSeparator" />
                                            <Setter Property="Height" Value="1" />
                                            <Setter Property="Margin" Value="0,4" />
                                            <Setter Property="Background" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Grid>

                        <ItemsPresenter x:Name="ItemsHost" Margin="18,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" SourceName="Bd" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0.58" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeSelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeSelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding Header.Tag, RelativeSource={RelativeSource Self}, FallbackValue=''}" Value="TreeSeparator">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter TargetName="Bd" Property="MinHeight" Value="10" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,8,2,8" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- Side-panel sketchy doodle/crosshatch wash & ragged marker seam in Settings/Add-ons nav -->
                            <Rectangle x:Name="NavSketch" Fill="{DynamicResource FrameBrush}" Opacity="0.11"
                                       OpacityMask="{DynamicResource LocalSidepanelSketchMask}" Visibility="Collapsed" IsHitTestVisible="False" />
                            <Rectangle x:Name="NavEdge" Width="10" HorizontalAlignment="Right" Margin="0,0,-5,0"
                                       Fill="{DynamicResource FrameBrush}" Opacity="0.38"
                                       OpacityMask="{DynamicResource LocalSketchEdgeVMask}" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding (AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowSettings">
                            <Setter TargetName="NavSketch" Property="Visibility" Value="Visible" />
                            <Setter TargetName="NavEdge" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding (AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowExtensions">
                            <Setter TargetName="NavSketch" Property="Visibility" Value="Visible" />
                            <Setter TargetName="NavEdge" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding (AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowSettings">
                <Setter Property="Width" Value="252" />
                <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1.5,0" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
            <DataTrigger Binding="{Binding (AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowExtensions">
                <Setter Property="Width" Value="276" />
                <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1.5,0" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
