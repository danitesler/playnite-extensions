<!--
    Canister: DefaultControls/Slider.xaml.
    Mutagen Ooze Vial glass tube filled with Acid Mutagen fluid, flanked by comic < > inline chevrons,
    with a circular Golden Marker cap thumb. Disables ThemeModifier GameBannerHeight & GameBannerDarken
    sliders when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SliderRangeButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Height="6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid x:Name="ThumbRoot" Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Ellipse x:Name="Halo" Margin="-2" Fill="{DynamicResource FocusHaloBrush}"
                                 Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Ellipse x:Name="Cap" Fill="{DynamicResource SliderThumbBackgroundBrush}"
                                 Stroke="{DynamicResource FrameBrush}" StrokeThickness="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cap" Property="Stroke" Value="{DynamicResource SliderThumbHoverBorderBrush}" />
                            <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Cap" Property="Stroke" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="ThumbRoot" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Inline comic < > option chevrons echoing Title Screen 1/53 -->
                        <Path x:Name="LeftWedge" Grid.Column="0" Width="6" Height="8" Margin="0,0,7,0"
                              Stretch="Uniform" VerticalAlignment="Center" Fill="{DynamicResource GiltBrush}"
                              Data="M6,0 L0,4 L6,8 Z" IsHitTestVisible="False" />

                        <Grid Grid.Column="1" VerticalAlignment="Center" Height="22">
                            <!-- Sunken glass vial track (half-thickness radius 4 on 8px height) -->
                            <Border Height="8" Background="{DynamicResource SliderTrackBrush}"
                                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                                    CornerRadius="4" VerticalAlignment="Center" IsHitTestVisible="False" />

                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{DynamicResource SliderRangeButton}"
                                                  Background="{TemplateBinding Foreground}"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{DynamicResource SliderRangeButton}"
                                                  Background="Transparent"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <Path x:Name="RightWedge" Grid.Column="2" Width="6" Height="8" Margin="7,0,0,0"
                              Stretch="Uniform" VerticalAlignment="Center" Fill="{DynamicResource GiltBrush}"
                              Data="M0,0 L6,4 L0,8 Z" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SliderHoverForegroundBrush}" />
                            <Setter TargetName="LeftWedge" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="RightWedge" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Disable ThemeModifier banner height & darken sliders while ShowBackgroundImageOnWindow is True -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerHeight" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerDarken" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
