<!--
    Canister: DefaultControls/GroupBox.xaml.
    Content-sized dark comic panel card crowned by a compact Golden Marker masking-tape header strip.
    Zero fixed widths or wide paths >=200px so Playnite's Statistics view wraps GroupBoxes cleanly.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                                    BorderThickness="0,0,0,1" Padding="10,7,10,7">
                                <Grid HorizontalAlignment="Left">
                                    <Rectangle Fill="{DynamicResource PrimaryButtonBackgroundBrush}"
                                               OpacityMask="{DynamicResource LocalTapeStripMask}"
                                               IsHitTestVisible="False" />
                                    <ContentPresenter ContentSource="Header" Margin="12,2,14,2"
                                                      TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                      TextElement.FontSize="{DynamicResource GroupBoxHeaderFontSize}"
                                                      TextElement.Foreground="{DynamicResource PrimaryButtonForegroundBrush}" />
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
