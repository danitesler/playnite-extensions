<!--
    Canister: DefaultControls/RadioButton.xaml.
    TMNT: Mutants Unleashed Skill-Tree Circular Node radio (20x20 hand-inked double ring with Crimson offset crescent
    and Golden Marker 4-point comic star core snapping in via BackEase).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource CheckBoxCheckMarkBkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,1,9,1">
                            <!-- Tag Crimson chromatic offset crescent when checked -->
                            <Ellipse x:Name="CheckOffset" Fill="{DynamicResource DangerBrush}" Visibility="Collapsed" IsHitTestVisible="False">
                                <Ellipse.RenderTransform><TranslateTransform X="1.5" Y="1.5" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- Sketchy outer & inner double-ink rings -->
                            <Ellipse x:Name="OuterRing" Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.6" />
                            <Ellipse Margin="2.5" Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="0.8" IsHitTestVisible="False" />
                            <!-- 4-point Golden Marker comic star core -->
                            <Path x:Name="CoreStar" Width="11" Height="11" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="{DynamicResource GiltBrush}" RenderTransformOrigin="0.5,0.5"
                                  Data="M6,0 L7.8,4.2 L12,6 L7.8,7.8 L6,12 L4.2,7.8 L0,6 L4.2,4.2 Z"
                                  Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="DotScale" ScaleX="0.2" ScaleY="0.2" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>

                        <ContentPresenter Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterRing" Property="Stroke" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OuterRing" Property="Stroke" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="CheckOffset" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RadIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CoreStar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="CoreStar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RadOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="CoreStar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.13" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CoreStar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.13" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
