<!--
    Canister: DefaultControls/TabControl.xaml.
    Street-sign & masking-tape tabs. Keeps Foreground="{DynamicResource TextBrush}" on TabItem (never overridden on
    TabItem itself so edit-dialog tab page labels stay legible); sets idle/hover/selected header colors on HeaderText
    via TargetName. Selected tab locks a bold Golden Marker bottom tape bar.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="14,7,14,7" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="HoverPlate" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                CornerRadius="3,3,0,0" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="SelPlate" Background="{DynamicResource SelectedBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1,1,1,0"
                                CornerRadius="3,3,0,0" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Rectangle x:Name="ActiveBar" Height="3" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource TabItemIndicatorBrush}"
                                   RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="TabBarX" ScaleX="0.2" />
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!-- TextBlock wrapping ContentSource=Header (required for Playnite edit-dialog headers) -->
                        <TextBlock x:Name="HeaderText" Margin="{TemplateBinding Padding}"
                                   Foreground="{DynamicResource TabItemForegroundBrush}"
                                   FontFamily="{DynamicResource FontFamily}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TabHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TabHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="SelPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TabSelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TabBarX" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="TabSelIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,10,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource TabControlHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,0,1.5">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="4,0,4,0" />
                        </Border>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
