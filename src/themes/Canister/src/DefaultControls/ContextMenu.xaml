<!--
    Canister: DefaultControls/ContextMenu.xaml.
    Unified popup panel (LocalCanisterMenuBoardTemplate) reused by ContextMenu, Menu submenus, TopPanelMenu, and ComboBox:
    - Panel: Dark aerosol-zine board (#191D22) with 5% chalk-grain.png, 1.5px sketchy white perimeter rim,
      dual Tag Crimson (-2.5px TL) & Acid Mutagen (+2.5px BR) chromatic offset fringes, crowned by a 7px
      Vermilion painted masking-tape strip (tape-strip.png) and centered crimson pushpin rising 3px above the board.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalCanisterMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid Margin="3,4,3,3" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Dual Tag Crimson + Acid Mutagen chromatic offset fringes -->
            <Border Background="{DynamicResource DangerBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border.RenderTransform><TranslateTransform X="-2.5" Y="-2" /></Border.RenderTransform>
            </Border>
            <Border Background="{DynamicResource GlyphBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border.RenderTransform><TranslateTransform X="2.5" Y="2" /></Border.RenderTransform>
            </Border>

            <!-- Main aerosol-zine board -->
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="{DynamicResource PopupBorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <Grid ClipToBounds="True">
                    <Rectangle Fill="{DynamicResource FrameBrush}" Opacity="0.05"
                               OpacityMask="{DynamicResource LocalChalkGrainMask}" />
                    <!-- Top 7px Vermilion painted masking-tape strip -->
                    <Rectangle Height="7" VerticalAlignment="Top" Margin="6,0,6,0"
                               Fill="{DynamicResource HeaderBandBrush}"
                               OpacityMask="{DynamicResource LocalTapeStripMask}" />
                </Grid>
            </Border>

            <!-- Centered crimson pushpin cap rising 3px above the top edge -->
            <Grid Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0">
                <Ellipse Fill="{DynamicResource DangerBrush}" Stroke="{DynamicResource PrimaryButtonBorderBrush}" StrokeThickness="1.2" />
                <Ellipse Width="3" Height="3" Margin="2,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Fill="{DynamicResource TextBrush}" Opacity="0.7" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="MinWidth" Value="212" />
        <Setter Property="Padding" Value="{DynamicResource MenuPadding}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid Grid.IsSharedSizeScope="True" MinWidth="{TemplateBinding MinWidth}">
                        <Control Template="{DynamicResource LocalCanisterMenuBoardTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ScrollViewer CanContentScroll="True" Margin="7,12,7,7"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
