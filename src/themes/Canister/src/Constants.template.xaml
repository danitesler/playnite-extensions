<!--
    Canister: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Unofficial dark theme inspired by Teenage Mutant Ninja Turtles: Mutants Unleashed (2024).
    Static SIL OFL TTFs bundled in src/Typography/: Anton, Barlow (Regular/Medium/SemiBold/Bold), Patrick Hand.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite & shared keys; bundled static OFL TTFs in src/Typography/) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">30</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow, {{text:cn-font-body|Barlow}}, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Anton, {{text:cn-font-heading|Anton}}, Impact, Segoe UI</FontFamily>
    <FontFamily x:Key="NoteFontFamily">./Typography/#Patrick Hand, {{text:cn-font-note|Patrick Hand}}, Segoe Print, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:cn-font-mono|Consolas}}</FontFamily>

    <!-- Usable metadata content width (300px inside the torn spiral-notebook flyer frame) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape (Playnite keys & radius scale) -->
    <Thickness x:Key="PopupBorderThickness">1.5</Thickness>
    <Thickness x:Key="ControlBorderThickness">1.5</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:cn-radius-xs|2}}</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">{{px:cn-radius-sm|3}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:cn-radius-md|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:cn-radius-lg|6}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:cn-radius-full|999}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{cn-text}}</Color>
    <Color x:Key="TextColorDarker">{{cn-text-muted}}</Color>
    <Color x:Key="TextColorDark">{{cn-text-dark}}</Color>
    <Color x:Key="MainColor">{{cn-ink-raised}}</Color>
    <Color x:Key="MainColorDark">{{cn-ink-panel}}</Color>
    <Color x:Key="HoverColor">{{cn-ink-hover}}</Color>
    <Color x:Key="GlyphColor">{{cn-ooze}}</Color>
    <Color x:Key="HighlightGlyphColor">{{cn-ooze-highlight}}</Color>
    <Color x:Key="PopupBackgroundColor">{{cn-ink-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{cn-chalk-bright}}</Color>
    <Color x:Key="BackgroundToneColor">{{cn-asphalt}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{cn-chalk-border}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{cn-chalk-border}}</Color>
    <Color x:Key="DataChangeNotifColor">{{cn-tape-orange}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{cn-chalk-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{cn-ink-sunk}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{cn-ink-raised}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{cn-ink-sunk}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{cn-rating-positive}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{cn-rating-negative}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{cn-rating-mixed}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{cn-tape-orange}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{cn-ink-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{cn-ink-panel}}" />

    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{cn-asphalt}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{cn-asphalt}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{cn-void}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{cn-ink-panel}}" />
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{cn-banner-tint}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{cn-scrim}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{cn-ink-sunk}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{cn-ink-panel}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{cn-chalk-border}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{cn-ooze}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{cn-marker-yellow}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{cn-ink-panel}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{cn-ooze}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{cn-ooze-wash}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{cn-ooze-wash-hover}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{cn-chalk-bright}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{cn-marker-yellow}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{cn-ink-raised}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{cn-ooze-wash}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{cn-ooze-wash}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{cn-turtle-blue}}" />
    <SolidColorBrush x:Key="LaunchingIndicatorBrush" Color="{{cn-turtle-blue-bright}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{cn-ooze}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{cn-ooze-highlight}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{cn-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{cn-text}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{cn-text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{cn-ink-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{cn-ink-pressed}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{cn-chalk-border}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{cn-marker-yellow}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{cn-marker-yellow-bright}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{cn-marker-gold}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{cn-text-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{cn-text-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{cn-ooze}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{cn-ink-raised}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{cn-chalk-bright}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{cn-ink-hover}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{cn-ink-pressed}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{cn-ooze-wash}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{cn-ink-sunk}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{cn-ink-panel}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{cn-chalk-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{cn-chalk-border-hover}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{cn-chalk-bright}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{cn-ooze}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{cn-ink-sunk}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{cn-marker-yellow}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{cn-ooze}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{cn-ooze-bright}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{cn-ooze}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{cn-ink-sunk}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{cn-chalk-border}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{cn-ooze}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{cn-ink-sunk}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{cn-chalk-border}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{cn-ooze}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{cn-text-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{cn-text}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{cn-marker-yellow}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{cn-ooze}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{cn-asphalt}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{cn-chalk-bright}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{cn-ooze}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{cn-ink-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{cn-ink-raised}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{cn-text-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{cn-marker-yellow}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{cn-ooze}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{cn-ooze}}" />

    <!-- Torn Spiral-Notebook Flyer Metadata Dossier (Paper) -->
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{cn-paper}}" />
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{cn-paper-rule}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{cn-paper-ink}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{cn-paper-ink}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{cn-paper-muted}}" />
    <SolidColorBrush x:Key="ParchmentLinkBrush" Color="{{cn-paper-link}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{cn-paper-chip}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{cn-paper-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{cn-marker-yellow}}" />

    <!-- Popups, Frames & Typography accents -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{cn-crimson}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{cn-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{cn-chalk-bright}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{cn-asphalt}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{cn-text-dark}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{cn-chalk-bright}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{cn-chalk-border}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{cn-tape-orange}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{cn-text-dark}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{cn-marker-yellow}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{cn-tape-orange}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{cn-marker-yellow}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{cn-marker-yellow}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{cn-tape-orange}}" />
    <SolidColorBrush x:Key="StripeAltBrush" Color="{{cn-marker-yellow}}" />
    <SolidColorBrush x:Key="StripeAccentBrush" Color="{{cn-ooze}}" />
    <SolidColorBrush x:Key="StripeDeepBrush" Color="{{cn-crimson}}" />
    <SolidColorBrush x:Key="GiltBrush" Color="{{cn-marker-yellow}}" />
    <SolidColorBrush x:Key="GiltHotBrush" Color="{{cn-marker-yellow-bright}}" />
    <SolidColorBrush x:Key="GiltDimBrush" Color="{{cn-marker-gold}}" />

    <!-- Theme-only Local brushes for HP Swoosh & 4-identity accents -->
    <SolidColorBrush x:Key="LocalTagPurpleBrush" Color="{{cn-tag-purple}}" />
    <SolidColorBrush x:Key="LocalStreetGreenBrush" Color="{{cn-street-green}}" />
    <SolidColorBrush x:Key="LocalOozeDeepBrush" Color="{{cn-ooze-deep}}" />
    <SolidColorBrush x:Key="LocalCrimsonDeepBrush" Color="{{cn-crimson-deep}}" />
    <LinearGradientBrush x:Key="LocalHealthSwooshBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{{cn-crimson}}" Offset="0" />
        <GradientStop Color="{{cn-tape-orange}}" Offset="0.34" />
        <GradientStop Color="{{cn-marker-yellow}}" Offset="0.68" />
        <GradientStop Color="{{cn-ooze}}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
