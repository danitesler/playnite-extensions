<!-- Overlay on Playnite Default/Common.xaml: only restyled keys live here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Popover content: bg.panel, rounded l3. Chakra lifts it with shadow lg; a 1px border edge stands in for it. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    </Style>

    <!-- focusVisibleRing="outside": 2px solid colorPalette.focusRing outline, 2px offset. WPF shows FocusVisualStyle
         for keyboard focus only, like :focus-visible. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource CornerRadiusLarge}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Recipe spacing at size md (Chakra's default size), keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">16,5,16,5</Thickness> <!-- button md: h-10, px-4, 1px transparent border (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">12,5,12,5</Thickness> <!-- input / select trigger md: h-10, px-3, inside a 1px border (height now set by ControlHeight) -->
    <Thickness x:Key="MenuPadding">6</Thickness> <!-- menu content md: p-1.5 -->
    <Thickness x:Key="MenuItemPadding">8,6,8,6</Thickness> <!-- menu item md: px-2 py-1.5 -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness> <!-- select content md: p-1 -->
    <Thickness x:Key="ComboBoxItemPadding">8,6,8,6</Thickness> <!-- select item md: px-2 py-1.5 -->
    <Thickness x:Key="ListBoxItemPadding">8,6,8,6</Thickness> <!-- listbox item: px-2 py-1.5 -->
    <Thickness x:Key="GroupBoxPadding">24</Thickness> <!-- card md: card-padding = spacing.6 -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,24</Thickness> <!-- card body padding under the header -->
    <sys:Double x:Key="GroupBoxHeaderFontSize">18</sys:Double> <!-- card md title: textStyle lg -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">20</sys:Double> <!-- button md _icon: size 5 -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->
    <Thickness x:Key="TooltipPadding">10,4,10,4</Thickness> <!-- tooltip content: px-2.5 py-1 -->

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, so the real carousel replaces it without the page jumping. Each Viewbox scales a fixed 1600px
         layout to the width its column gives it (height is unbounded in a vertical stack). The tiles are the host's
         Foreground at low opacity; the whole thing pulses while visible. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the plugin's ContentControl, visible while that control has no height. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="16"
                        Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- menu-mark begin LocalChakramMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a chakram, a flat throwing ring with four blades and a hub hole. Hover (IsMouseOver): the blades flare out to 1.18 (BackEase, 0.2s). Open (ContextMenu.IsOpen of the nearest Border): the ring spins slowly (360 degrees per 6s, linear) while a hub core pops in; the exit storyboard stops the spin and restores every property. -->
    <ControlTemplate x:Key="LocalChakramMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Ellipse Canvas.Left="2.2" Canvas.Top="2.2" Width="17.6" Height="17.6" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" />
                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="6" Height="6" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" />
                <Canvas x:Name="Spin" Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><RotateTransform x:Name="SpinTurn" Angle="0" /></Canvas.RenderTransform>
                    <Canvas x:Name="Flare" Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><ScaleTransform x:Name="FlareScale" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                        <Path Data="M11,-0.6 L13.4,3.2 L8.6,3.2Z" Fill="{TemplateBinding Foreground}" />
                        <Path Data="M11,22.6 L13.4,18.8 L8.6,18.8Z" Fill="{TemplateBinding Foreground}" />
                        <Path Data="M-0.6,11 L3.2,8.6 L3.2,13.4Z" Fill="{TemplateBinding Foreground}" />
                        <Path Data="M22.6,11 L18.8,8.6 L18.8,13.4Z" Fill="{TemplateBinding Foreground}" />
                    </Canvas>
                </Canvas>
                <Ellipse x:Name="Core" Canvas.Left="9.5" Canvas.Top="9.5" Width="3" Height="3" RenderTransformOrigin="0.5,0.5" Fill="{TemplateBinding Foreground}" Opacity="0">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="CoreScale" ScaleX="0.2" ScaleY="0.2" /></Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="FlareScale" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="FlareScale" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FlareScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FlareScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.160" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SpinTurn" Storyboard.TargetProperty="Angle" To="360" Duration="0:0:6.000" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.250"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.250"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Core" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SpinTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.300" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.200" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.200" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Core" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.160" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalChakramMenuMarkTemplate -->
</ResourceDictionary>
