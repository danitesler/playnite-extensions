<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml (grid mode, side panel).
    The Chakra dashboard stacked for a narrow column (16px gutters): the cover clipped to radius l3 (max 280px),
    the name as a Heading xl (bold) with the icon, the actions (solid Play or Install filling the width, subtle More,
    subtle IconButton Edit), then two columns as in the details view: Description and Notes on the left, a 280px Details column on the right.
    Details is one Card (bg.panel, radius l3, p-4) with a vertical DataList (label in fg.muted over the value) that
    holds every metadata field Playnite can show, in six groups separated by a border-colored Separator: progress
    (completion status, time played, last played, recent activity, added), scores, about (developers, publishers,
    release date, series, age rating, region), tags (platforms, genres, categories, features, tags, as Badges),
    library (library, source, version, install size, install folder) and links. A group whose fields are all hidden
    takes no space, and neither does its Separator.
    Description and notes sit under Heading lg titles.
    The panel edge follows Playnite's panel settings. Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
<Grid>
<!-- Empty state (no game selected), Chakra EmptyState: an indicator icon (fg.subtle, 36px = textStyle 4xl, no tile) over a semibold lg title, centered in the visible area. It fades in over 200ms (duration moderate) when it appears; no loop (RemoveStoryboard on exit). -->
<Grid VerticalAlignment="Stretch">
<Grid.Style>
<Style TargetType="Grid">
<Setter Property="Visibility" Value="Collapsed" />
<Style.Triggers>
<DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
<Setter Property="Visibility" Value="Visible" />
</DataTrigger>
</Style.Triggers>
</Style>
</Grid.Style>
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,24">
<StackPanel.Style>
    <Style TargetType="StackPanel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyFadeIn">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="1" KeySpline="0.42,0,0.58,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyFadeIn" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</StackPanel.Style>
