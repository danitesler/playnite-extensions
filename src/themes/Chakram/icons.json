{
    "_comment": "Icons this theme ships, rendered by .\\scripts\\render-icons.ps1 -Extension chakram. Paths are relative to this folder. Colors are Chakra's fg.muted (gray.400) and fg.error (red.400); re-run after changing them in src/tokens.css.",
    "jobs": [
        {
            "_comment": "Menu icons: Media.xaml maps Playnite's *Icon keys to these files.",
            "pack": "lucide",
            "format": "Png",
            "outDir": "src/Images/Lucide",
            "size": 48,
            "color": "#a1a1aa",
            "icons": [
                "maximize", "plus", "refresh-cw", "info", "settings", "plug", "play", "download", "link", "folder",
                "database", "monitor-down", "star", "star-off", "eye-off", "eye", "sun", "pencil", "dices",
                "book-open", "archive", "rotate-ccw"
            ]
        },
        {
            "pack": "lucide",
            "format": "Png",
            "outDir": "src/Images/Lucide",
            "size": 48,
            "color": "#f87171",
            "suffix": "-danger",
            "icons": [ "log-out", "trash" ]
        }
    ]
}
