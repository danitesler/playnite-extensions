<!--
    Chakra-inspired: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from
    tokens.css (Chakra's CSS variables) and writes the result to the build as Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo: Playnite's
    palette keys, then shared keys for roles Playnite has none for. Each placeholder names the Chakra variable that plays
    the role (colors.bg.panel is chakra-colors-bg-panel, the virtual colorPalette.solid is
    chakra-colors-color-palette-solid, opacity modifiers keep Chakra's /NN), so Chakra's names live in tokens.css and
    here only. Theme XAML reads the brushes (never the Color keys), so ThemeModifier edits reach every control.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): textStyle xs / sm / md ... Chakra's fonts.body is Inter with a system fallback,
         which is Segoe UI on Windows; Inter is not bundled. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys). ControlCornerRadius is the medium step of the radius scale (radii.l2). -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:chakra-radii-l2}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale: semantic radii l1 (xs), l3 (md), full -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:chakra-radii-l1}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:chakra-radii-l3}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor = colorPalette.solid and TextColorDark = colorPalette.contrast: Playnite always pairs those two
        (selected rows, play button). HoverBrush is the gray ghost hover (gray.subtle).
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{chakra-colors-fg}}</Color>
    <Color x:Key="TextColorDarker">{{chakra-colors-fg-muted}}</Color>
    <Color x:Key="TextColorDark">{{chakra-colors-color-palette-contrast}}</Color>
    <Color x:Key="MainColor">{{chakra-colors-gray-subtle}}</Color>
    <Color x:Key="MainColorDark">{{chakra-colors-bg-panel}}</Color>
    <Color x:Key="HoverColor">{{chakra-colors-bg-emphasized}}</Color>
    <Color x:Key="GlyphColor">{{chakra-colors-color-palette-solid}}</Color>
    <Color x:Key="HighlightGlyphColor">{{chakra-colors-color-palette-solid/50}}</Color>
    <Color x:Key="PopupBackgroundColor">{{chakra-colors-bg-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{chakra-colors-border}}</Color>
    <Color x:Key="BackgroundToneColor">{{chakra-colors-bg-panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>     <!-- no frame around covers -->
    <Color x:Key="PanelSeparatorColor">#00000000</Color>         <!-- no lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{chakra-colors-border}}</Color>
    <Color x:Key="DataChangeNotifColor">{{chakra-colors-fg-warning}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{chakra-colors-border-emphasized}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{{chakra-colors-gray-subtle}}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{chakra-colors-bg-inverted}}" />   <!-- Tooltip bg.inverted -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{chakra-colors-gray-subtle}}" />    <!-- button subtle -->
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="Transparent" />                              <!-- Checkbox solid: no fill until checked -->
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{chakra-colors-fg-success}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{chakra-colors-fg-error}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{chakra-colors-fg-warning}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{chakra-colors-fg-error}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{chakra-colors-bg-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{chakra-colors-bg}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- States: teal subtle selection, bg.emphasized/60 highlight in collections -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{chakra-colors-color-palette-subtle}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{chakra-colors-color-palette-fg}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{chakra-colors-bg-emphasized/60}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{chakra-colors-bg-muted}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{chakra-colors-bg-emphasized/60}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{chakra-colors-color-palette-focus-ring}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{chakra-colors-color-palette-focus-ring/50}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{chakra-colors-red-solid}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{chakra-colors-red-contrast}}" />

    <!-- Buttons: button subtle / outline (gray palette), solid (colorPalette) -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{chakra-colors-gray-fg}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{chakra-colors-gray-muted}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{chakra-colors-gray-muted}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{chakra-colors-gray-muted}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{chakra-colors-color-palette-solid/90}}" />

    <!-- Inputs: input subtle -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{chakra-colors-bg-muted}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{chakra-colors-bg-emphasized/72}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{chakra-colors-bg}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{chakra-colors-bg-muted}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{chakra-colors-gray-solid}}" />      <!-- drawn at 25%, 50% on hover -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{chakra-colors-gray-solid}}" />      <!-- drawn at 10% -->
    <SolidColorBrush x:Key="ThumbBrush" Color="{{chakra-colors-gray-solid}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{chakra-colors-border-emphasized}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{chakra-colors-bg-emphasized/60}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{chakra-colors-bg-emphasized}}" />
    <!-- Badge / Tag "subtle" in the brand palette: colorPalette.subtle fill, colorPalette.fg text, colorPalette.muted on hover -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{chakra-colors-color-palette-subtle}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{chakra-colors-color-palette-fg}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{chakra-colors-color-palette-muted}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{chakra-colors-bg-muted}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{chakra-colors-fg-inverted}}" />
</ResourceDictionary>
