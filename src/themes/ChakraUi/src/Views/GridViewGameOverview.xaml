<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml (grid mode, side panel).
    The Chakra dashboard stacked for a narrow column (16px gutters): the cover clipped to radius l3 (max 280px),
    the name as a Heading xl (bold) with the icon, the actions (solid Play or Install filling the width, subtle More,
    subtle IconButton Edit), then two columns as in the details view: Description and Notes on the left, a 280px Details column on the right.
    Details is one Card (bg.panel, radius l3, p-4) with a vertical DataList (label in fg.muted over the value) that
    holds every metadata field Playnite can show, in six groups separated by a border-colored Separator: progress
    (completion status, time played, last played, recent activity, added), scores, about (developers, publishers,
    release date, series, age rating, region), tags (platforms, genres, categories, features, tags, as Badges),
    library (library, source, version, install size, install folder) and links. A group whose fields are all hidden
    takes no space, and neither does its Separator.
    Description and notes sit under Heading lg titles.
    The panel edge follows Playnite's panel settings. Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
<Grid>
                        <DockPanel>
                            <DockPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DockPanel.Resources>


                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCErrorNoGameSelected}"
                                       Margin="16,24,16,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrushDarker}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <Grid>
<!-- Banner: the game's background art as a band at the top. Tinted at the top, darkened toward the title by a page-colored scrim, faded into the page. GameBannerHeight sets the height; 0 turns it off. -->
<Grid x:Name="HeroClip" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" Margin="8,8,8,0" IsHitTestVisible="False">
<Grid.Style>
        <Style TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Grid.Style>
<Grid.OpacityMask><VisualBrush Visual="{Binding ElementName=HeroClipShape}" /></Grid.OpacityMask>
<Border x:Name="HeroClipShape" CornerRadius="{DynamicResource CornerRadiusLarge}" Background="{DynamicResource WindowBackgourndBrush}" />
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
    <Grid.Style>
        <Style TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Grid.Style>
    <Grid.CacheMode>
        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
    </Grid.CacheMode>
    <Grid.OpacityMask>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#A6000000" Offset="0" />
            <GradientStop Color="Black" Offset="0.3" />
            <GradientStop Color="Transparent" Offset="1" />
        </LinearGradientBrush>
    </Grid.OpacityMask>
    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
    <Border Background="{DynamicResource WindowBackgourndBrush}">
        <Border.OpacityMask>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Transparent" Offset="0.1" />
                <GradientStop Color="#A6000000" Offset="0.4" />
                <GradientStop Color="#CC000000" Offset="0.7" />
                <GradientStop Color="#E6000000" Offset="1" />
            </LinearGradientBrush>
        </Border.OpacityMask>
    </Border>
</Grid>
</Grid>
<Grid>

<StackPanel Margin="28,0,28,32">
                                        <!-- Room above the title so it sits low on the banner; gone when the banner is off or the game has no art. -->
<Border  IsHitTestVisible="False">
    <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 84 / 320'}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                    <Setter Property="Height" Value="52" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
</Border>
<DockPanel Margin="0,4,0,0">
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeLarger}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>
<Grid HorizontalAlignment="Center" Margin="0,16,0,16">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source, ElementName=PART_ImageCover}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.CacheMode>
                                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                            </Grid.CacheMode>
                                            <Grid>
                                                <Grid.OpacityMask>
                                                    <VisualBrush Visual="{Binding ElementName=CoverShape}" />
                                                </Grid.OpacityMask>
                                                <Border x:Name="CoverShape" CornerRadius="{DynamicResource CornerRadiusLarge}" Background="{DynamicResource ExpanderBackgroundBrush}" />
                                                <Image x:Name="PART_ImageCover" Stretch="Uniform" StretchDirection="Both" MaxHeight="280"
                                                       RenderOptions.BitmapScalingMode="Fant" />
                                            </Grid>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Margin="8,0,0,0" Content="{DynamicResource LOCMoreAction}" />
                                            <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Focusable="False" Margin="8,0,0,0">
                                                <ContentPresenter Width="20" Height="20"
                                                                  Content="{DynamicResource IconEdit}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>

                                        <Grid x:Name="OverviewLayoutGrid" Margin="0,24,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel x:Name="DescriptionPanel" Grid.Column="0">
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library or Steam source games in that gap; give up after 12s so a game without screenshots does not keep an empty block. When the plugin is not installed or is disabled the binding fails, FallbackValue=PluginUnavailable matches neither True nor False, and no skeleton shows. -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                        <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                            <Storyboard>
                                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                        <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                            <Storyboard>
                                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <GroupBox Header="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}">
                                                        <Grid>
                                                            <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                            <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                                <Control.Style>
                                                                    <Style TargetType="Control">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Control.Style>
                                                            </Control>
                                                        </Grid>
                                                    </GroupBox>
                                                </Grid>
                                                <StackPanel x:Name="PART_ElemDescription" Margin="0,24,0,0">
                                                    <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" FontSize="{DynamicResource GroupBoxHeaderFontSize}"
                                                               FontWeight="SemiBold" Margin="0,0,0,12" />
                                                    <HtmlTextView x:Name="PART_HtmlDescription"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"
                                                                  Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </StackPanel>
                                                <StackPanel x:Name="PART_ElemNotes" Margin="0,24,0,0">
                                                    <TextBlock Text="{DynamicResource LOCNotesLabel}" FontSize="{DynamicResource GroupBoxHeaderFontSize}"
                                                               FontWeight="SemiBold" Margin="0,0,0,12" />
                                                    <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                             Background="{DynamicResource ControlBackgroundBrush}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel x:Name="DetailsPanel" Grid.Column="1" Width="{DynamicResource GridDetailsPaneWidth}" Margin="24,0,0,0" VerticalAlignment="Top">

                                                <GroupBox Header="{DynamicResource LOCGameDetails}">
                                                    <Border ClipToBounds="True">
                                                        <StackPanel Margin="0,-33,0,-8">
                                                            <Border x:Name="MetaProgress" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCCompletionStatus}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCTimePlayed}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <TextBlock x:Name="PART_TextPlayTime" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCLastPlayed}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <TextBlock x:Name="PART_TextLastActivity" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <TextBlock x:Name="PART_TextRecentActivity" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <TextBlock x:Name="PART_TextAdded" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaScores" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCCommunityScore}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <TextBlock x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" FontWeight="SemiBold" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCCriticScore}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <TextBlock x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" FontWeight="SemiBold" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCUserScore}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <TextBlock x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" FontWeight="SemiBold" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaAbout" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCDevelopersLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <ItemsControl x:Name="PART_ItemsDevelopers" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCPublishersLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <ItemsControl x:Name="PART_ItemsPublishers" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCSeriesLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <ItemsControl x:Name="PART_ItemsSeries" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <ItemsControl x:Name="PART_ItemsAgeRatings" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemRegion" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCRegionLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <ItemsControl x:Name="PART_ItemsRegions" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaTags" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemPlatform" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCPlatformsTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,2,0,-8">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemGenres" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCGenresLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,2,0,-8">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemCategories" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCCategoriesLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <ItemsControl x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,2,0,-8">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemFeatures" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <ItemsControl x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,2,0,-8">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemTags" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCTagsLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <ItemsControl x:Name="PART_ItemsTags" Tag="Chip" Margin="0,2,0,-8">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaLibrary" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemLibrary" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemSource" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCSourceLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <Button x:Name="PART_ButtonSource" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemVersion" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCVersionLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <Button x:Name="PART_ButtonVersion" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemInstallSize" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <TextBlock x:Name="PART_TextInstallSize" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemInstallDirectory" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <Button x:Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaLinks" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemLinks" Margin="0,8,0,8">
                                                                        <TextBlock Text="{DynamicResource LOCLinksLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                        <ItemsControl x:Name="PART_ItemsLinks" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </GroupBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
</Grid>
</Grid>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,40,0" Width="36" Height="36"
                                Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}"
                                Foreground="{DynamicResource TextBrush}" Background="{DynamicResource ButtonBackgroundBrush}"
                                Command="{MainViewModel CloseGameSideBarCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource NormalBorderBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <ContentPresenter Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Content="{DynamicResource IconWindowClose}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DangerBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
</Grid>
</Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
