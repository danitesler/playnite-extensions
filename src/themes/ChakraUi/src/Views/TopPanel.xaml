<!--
    Overlay on Playnite Default/Views/TopPanel.xaml.
    Chakra top bar: 64px (h-16), px-6, no border, on the one surface. Playnite's view controls sit in a single
    SegmentGroup on the left (bg.muted track, rounded l3, 40px segments; the checked segment is the bg.emphasized
    indicator); search is an Input in the "subtle" variant (bg.muted, no visible border, h-10, 320px) on the right,
    next to ghost IconButtons for filters and notifications that switch to the teal "subtle" variant when active.
    Icons: lucide at 20px (IconButton md). Window buttons: DerivedStyles/MainWindowStyle.xaml (reserved on the right).
    TopPanelMenu, the toggles and the icon templates keep Playnite's keys. All PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" TextElement.Foreground="{DynamicResource WarningBrush}" Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <!-- Looked up from code for the main menu; the Chakra Menu content of DefaultControls/ContextMenu.xaml. -->
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <!-- Ghost IconButton md; teal "subtle" (colorPalette.subtle / colorPalette.fg) while the panel is open or a filter applies. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="10,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" VerticalAlignment="Center" Content="{DynamicResource IconFilter}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <TextBlock x:Name="TextFilter" Text="{DynamicResource LOCFilterActiveLabel}"
                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{TemplateBinding Foreground}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ghost bell with a solid red Badge (red.solid, red.contrast, Chakra Float at top-end); hidden while there is nothing to show. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconNotifications}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <Border CornerRadius="{DynamicResource CornerRadiusSmall}" MinWidth="16" Height="16" Padding="4,0,4,0"
                                    Margin="0,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource DangerBrush}">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="{DynamicResource FontSizeSmall}"
                                           FontWeight="Medium" Foreground="{DynamicResource DangerForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- InputGroup + Input "subtle", size md: CustomControls/SearchBox.xaml already draws it; the top bar sets the size. -->
    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Width" Value="320" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <!-- Right padding: the window buttons (24px + 3 x 40px) + 16px gap. -->
                    <Border Height="64" Padding="24,0,160,0" Background="{TemplateBinding Background}">
                        <DockPanel>
                            <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource MainMenuButton}"
                                    DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center">
                                <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <!-- SegmentGroup: one bg.muted track for all of Playnite's view controls. -->
                            <Border DockPanel.Dock="Left" VerticalAlignment="Center" Padding="4"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusLarge}">
                                <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal" />
                            </Border>

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <CheckBox x:Name="PART_ToggleNotifications" DockPanel.Dock="Right"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" />

                            <CheckBox x:Name="PART_ToggleFilter" DockPanel.Dock="Right"
                                      ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" />

                            <SearchBox x:Name="PART_TextMainSearch" DockPanel.Dock="Right" Margin="16,0,0,0"
                                       Style="{StaticResource TopPanelSearchBox}"
                                       WindowChrome.IsHitTestVisibleInChrome="True" />

                            <!-- Fills the space the bar has left: the bar shrinks first, the cancel button always stays in view. -->
                            <Grid VerticalAlignment="Center" Margin="16,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="480" MinWidth="60" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Name="PART_TextProgressText" Margin="0,0,0,6"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextBrushDarker}"
                                               Style="{DynamicResource BaseTextBlockStyle}" />
                                    <ProgressBar Name="PART_ProgressGlobal" Height="8" />
                                </StackPanel>
                                <Button Name="PART_ButtonProgressCancel" Grid.Column="1"
                                        Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Margin="16,0,0,0" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
