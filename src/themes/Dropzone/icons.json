{
    "_comment": "Icons this theme ships: Material Symbols, Rounded style, filled (Apache-2.0, google/material-design-icons, symbols/web). Chunky solid glyphs with rounded ends are the closest open set to the Fortnite lobby's icons since the Chapter 5 menus; the game's own icons are Epic's and are not bundled. The Geometry job writes icons.generated.xaml (not committed): paste its entries into src/Media.xaml; the geometries in Media.xaml are shifted onto a 0..960 grid (the SVGs draw on 0,-960..960,0), so IconTemplate needs no offset. The Png jobs write the menu icons Media.xaml maps to files: white, the favorite star in the PLAY yellow, quit and remove in the danger red (src/tokens.css). Render with .\\scripts\\render-icons.ps1 -Extension dropzone (Windows). The committed files were made the same way from the same SVGs (paths shifted by a script, PNGs rasterized in Chromium) in a Linux session.",
    "jobs": [
        {
            "_comment": "Icon<Role> geometries drawn by IconTemplate.",
            "urlTemplate": "https://raw.githubusercontent.com/google/material-design-icons/{ref}/symbols/web/{name}/materialsymbolsrounded/{name}_fill1_24px.svg",
            "ref": "master",
            "format": "Geometry",
            "keyPrefix": "Icon",
            "xamlOut": "icons.generated.xaml",
            "icons": [
                "search=Search",
                "close=Clear",
                "tune=ViewSettings",
                "bookmarks=FilterPresets",
                "stacks=Group",
                "sort=Sort",
                "vertical_split=DetailsView",
                "grid_view=GridView",
                "view_list=ListView",
                "download=Update",
                "account_tree=Explorer",
                "casino=Random",
                "shuffle=ViewRandom",
                "filter_alt=Filter",
                "notifications=Notifications",
                "home=Library",
                "leaderboard=Statistics",
                "remove=WindowMinimize",
                "check_box_outline_blank=WindowMaximize",
                "filter_none=WindowRestore",
                "close=WindowClose",
                "keyboard_arrow_down=DropDown",
                "chevron_right=Submenu",
                "check=Check",
                "add=Add",
                "edit=Edit",
                "delete=Remove",
                "settings=Options",
                "play_arrow=Play",
                "info=Info",
                "download=Download",
                "menu=MainMenu"
            ]
        },
        {
            "_comment": "Menu icons: Media.xaml maps Playnite's *Icon keys to these files. 48px in white.",
            "urlTemplate": "https://raw.githubusercontent.com/google/material-design-icons/{ref}/symbols/web/{name}/materialsymbolsrounded/{name}_fill1_24px.svg",
            "ref": "master",
            "format": "Png",
            "outDir": "src/Images/Material",
            "size": 48,
            "color": "#ffffff",
            "icons": [
                "fullscreen",
                "add",
                "sync",
                "info",
                "settings",
                "extension",
                "play_arrow=play",
                "download",
                "link",
                "folder_open=folder",
                "hard_drive=storage",
                "desktop_windows=desktop",
                "visibility_off=hide",
                "visibility=unhide",
                "hdr_on=hdr",
                "edit",
                "casino=dice",
                "menu_book=manual",
                "archive=backup",
                "history=restore"
            ]
        },
        {
            "_comment": "The outlined star (add to favorites), from the unfilled file.",
            "urlTemplate": "https://raw.githubusercontent.com/google/material-design-icons/{ref}/symbols/web/{name}/materialsymbolsrounded/{name}_24px.svg",
            "ref": "master",
            "format": "Png",
            "outDir": "src/Images/Material",
            "size": 48,
            "color": "#ffffff",
            "icons": [
                "star"
            ]
        },
        {
            "_comment": "The filled star (remove from favorites), in the PLAY yellow.",
            "urlTemplate": "https://raw.githubusercontent.com/google/material-design-icons/{ref}/symbols/web/{name}/materialsymbolsrounded/{name}_fill1_24px.svg",
            "ref": "master",
            "format": "Png",
            "outDir": "src/Images/Material",
            "size": 48,
            "color": "#f7ff1a",
            "icons": [
                "star=star-fill"
            ]
        },
        {
            "_comment": "Quit and remove, in the danger red.",
            "urlTemplate": "https://raw.githubusercontent.com/google/material-design-icons/{ref}/symbols/web/{name}/materialsymbolsrounded/{name}_fill1_24px.svg",
            "ref": "master",
            "format": "Png",
            "outDir": "src/Images/Material",
            "size": 48,
            "color": "#ff4757",
            "suffix": "-danger",
            "icons": [
                "power_settings_new=power",
                "delete"
            ]
        }
    ]
}
