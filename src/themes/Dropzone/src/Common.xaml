<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    Spacing follows the Fortnite lobby screenshots each value is measured from (quoted per key). The game draws at
    1080p with 22 to 28px labels; Playnite's controls use 14px type, so paddings are the game's scaled by about 0.6.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menus and dropdowns: the island page's navy panel with a thin blue edge (the blue buttons' edge, toned down). -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: the Discover tiles' focus ring, a 2px pale-cyan edge 2px outside the control (keyboard only). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource CornerRadiusLarge}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: the same ring, 3px outside the box. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading: Discover row titles ("PEOPLE LOVE", "TRENDING"), heavy white capitals; callers pass capitals. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Component spacing, keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">16,5,16,5</Thickness>          <!-- lobby BACK / CHAT pills, 26 x 12px label insets, x0.6 (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">10,5,10,5</Thickness>           <!-- settings value bars, 36px tall (height now set by ControlHeight) -->
    <Thickness x:Key="MenuPadding">6,6,6,6</Thickness>              <!-- game menu rows sit 6px apart inside the panel -->
    <Thickness x:Key="MenuItemPadding">12,8,14,8</Thickness>        <!-- game menu rows, 17px label inset, 52px tall, x0.6 -->
    <Thickness x:Key="ComboBoxDropDownPadding">6,6,6,6</Thickness>  <!-- frame-rate list -->
    <Thickness x:Key="ComboBoxItemPadding">12,7,12,7</Thickness>    <!-- frame-rate list rows, 42px apart, x0.6 -->
    <Thickness x:Key="ListBoxItemPadding">10,7,10,7</Thickness>     <!-- settings rows -->
    <Thickness x:Key="GroupBoxPadding">0,0,0,16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>    <!-- settings section title, 24px above the first row, x0.6 -->
    <Thickness x:Key="TooltipPadding">12,8,12,8</Thickness>         <!-- "CHOOSE PRIVACY" callout, 20 x 12px insets, x0.6 -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">20</sys:Double>                    <!-- navbar grid and search icons, 32px at 1440p -->
    <sys:Double x:Key="GameBannerHeight">360</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art band on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five 16:9
         thumbnails, so the real carousel replaces it without the page jumping. Rounded 12px corners, like the
         game's Discover tiles. Each Viewbox scales a fixed 1600px layout to its column's width. The tiles are the host's Foreground
         at low opacity; the whole thing pulses while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="12"
                        Background="{TemplateBinding Foreground}" Opacity="0.14" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="2" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="4" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="6" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="8" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- menu-mark begin LocalDropzoneMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a glider parachute, a scalloped canopy on four lines over a rider. Hover (IsMouseOver): the canopy inflates (height 1.14, width 1.06, BackEase 0.28s). Open (ContextMenu.IsOpen of the nearest Border): the glider drifts gently down and up 2px either side of rest (1.6s sine, auto-reversed) and the centre panel of the canopy lights up in the accent; the exit restores every property. -->
    <ControlTemplate x:Key="LocalDropzoneMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="26" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Canvas x:Name="Drift" Width="26" Height="28">
                    <Canvas.RenderTransform><TranslateTransform x:Name="DriftT" X="0" Y="0" /></Canvas.RenderTransform>
                    <Canvas x:Name="CanopyW" Width="26" Height="28" RenderTransformOrigin="0.5,0.43">
                        <Canvas.RenderTransform><ScaleTransform x:Name="CanopyS" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                        <Path Data="M3,12 A10,9.5 0 0 1 23,12 Q20.5,10.2 18,12 Q15.5,10.2 13,12 Q10.5,10.2 8,12 Q5.5,10.2 3,12Z" Fill="{TemplateBinding Foreground}" />
                        <Path x:Name="Stripe" Data="M10,3.6 Q13,2.8 16,3.6 L14.4,11.2 Q13,10.4 11.6,11.2Z" Fill="{DynamicResource GlyphBrush}" Opacity="0" />
                    </Canvas>
                    <Path Data="M3.5,12.6 L13,23 M8,12.6 L13,23 M18,12.6 L13,23 M22.5,12.6 L13,23" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
                    <Ellipse Canvas.Left="11" Canvas.Top="22.5" Width="4" Height="4" Fill="{TemplateBinding Foreground}" />
                </Canvas>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CanopyS" Storyboard.TargetProperty="ScaleY" To="1.14" Duration="0:0:0.280"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CanopyS" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.280"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CanopyS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.224" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CanopyS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.224" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="DriftT" Storyboard.TargetProperty="Y" From="-2" To="2" Duration="0:0:1.600" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Stripe" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.250"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="DriftT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:1.280" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Stripe" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.200" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalDropzoneMenuMarkTemplate -->
</ResourceDictionary>
