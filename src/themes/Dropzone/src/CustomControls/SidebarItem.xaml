<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    On the rail: a row of the Fortnite sidebar, 64 x 56px with a 24px glyph in the sidebar blue (#33aaff). The current
    item is the game's selected tab: a blue plate (#0840a7) across the whole rail with slanted top and bottom edges and
    a white glyph; under the pointer the same plate in a white wash. Library is the home glyph (IconLibrary),
    Statistics IconStatistics; add-on items keep their own icon, scaled into the 24px box. The title is the tooltip.
    Docked at the top or bottom, views become heavy capital tabs and the current one the light grey PLAY pill.
    PART_ProgressStatus is a 3px bar along the bottom of the plate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="56" />
        <Setter Property="ToolTip" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <!-- The slanted plate: 6px rise across the rail at both ends. -->
                        <Path x:Name="Plate" Stretch="Fill" Fill="{TemplateBinding Background}"
                              Data="M0,6 L64,0 L64,50 L0,56 Z" />
                        <Grid x:Name="IconHost" Width="24" Height="24"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox x:Name="ItemIcon">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                            <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                            ContentTemplate="{DynamicResource IconTemplate}" />
                        </Grid>
                        <ProgressBar x:Name="PART_ProgressStatus" Height="3" VerticalAlignment="Bottom" Margin="10,0,10,4"
                                     BorderThickness="0" Background="Transparent" />
                        <Border x:Name="Pill" Visibility="Collapsed" Height="36" VerticalAlignment="Center" Margin="2,0,2,0"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Background}">
                            <TextBlock x:Name="Label" Margin="16,0,16,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                       FontWeight="Bold" FontStretch="Condensed"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{Binding Title, Converter={StaticResource StringToUpperCaseConverter}}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource SelectedBrush}" TargetName="Plate" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="IconHost" />
                            <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" TargetName="Pill" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" TargetName="Label" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <!-- Docked at the top or bottom: a view is a text tab over the full height of the strip. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings SidebarPosition}" Value="Top" />
                                <Condition Binding="{Binding Type}" Value="View" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Plate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="IconHost" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Pill" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings SidebarPosition}" Value="Bottom" />
                                <Condition Binding="{Binding Type}" Value="View" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Plate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="IconHost" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Pill" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Settings SidebarPosition}" Value="Top" />
                    <Condition Binding="{Binding Type}" Value="View" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="64" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Settings SidebarPosition}" Value="Bottom" />
                    <Condition Binding="{Binding Type}" Value="View" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="64" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </MultiDataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
