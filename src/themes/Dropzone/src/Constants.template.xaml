<!--
    Dropzone: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    The placeholders name the Fortnite lobby's values as sampled in tokens.css. Theme XAML reads brushes only, never
    Color keys, so ThemeModifier edits reach every control.

    The look: deep navy surfaces, white heavy capitals, a light grey pill for the current tab, blue plates for menus
    and selection, the yellow PLAY button, cyan for labels and links, rounded 8 to 12px corners.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Typography (Playnite keys). Body text is Segoe UI; headings, tabs, buttons and titles use HeadingFontFamily,
        Bahnschrift in bold capitals, in place of the game's Burbank Big Condensed (not bundled).
    -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">22</sys:Double>
    <sys:Double x:Key="FontSizeLargest">44</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Bahnschrift}}, Segoe UI</FontFamily>

    <!-- Shape (Playnite keys). ControlCornerRadius is the navbar pill and button radius. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-large}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:radius-full}}</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor is the cyan of the island page labels (links, checks, focus); TextColorDark is the near-black of
        the PLAY label, used on yellow and light fills.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{text}}</Color>
    <Color x:Key="TextColorDarker">{{text-muted}}</Color>
    <Color x:Key="TextColorDark">{{text-on-light}}</Color>
    <Color x:Key="MainColor">{{menu-bg}}</Color>
    <Color x:Key="MainColorDark">{{rail}}</Color>
    <Color x:Key="HoverColor">{{tab-hover}}</Color>
    <Color x:Key="GlyphColor">{{label-cyan}}</Color>
    <Color x:Key="HighlightGlyphColor">{{label-cyan/30}}</Color>
    <Color x:Key="PopupBackgroundColor">{{panel}}</Color>
    <Color x:Key="PopupBorderColor">{{popup-edge@panel}}</Color>
    <Color x:Key="BackgroundToneColor">{{rail}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">#00000000</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{hairline}}</Color>
    <Color x:Key="DataChangeNotifColor">{{warning}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{input-edge}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{{tab-hover}}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{screen-deep}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{pill}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{slider-track}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{success}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{danger}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{warning}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{danger}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{rail}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{screen-bg}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!--
        Shell. The sidebar rail is the game's sidebar color; the navbar is a translucent dark strip; the library sits
        straight on the page (or on the scene when background art is on).
    -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{rail}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{navbar}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{input}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{input-hover}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{icon-blue}}" />

    <!-- States: the game menu's blue plates for selection and menu hover -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{menu-item}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{blue-button-pressed}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{tab-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{menu-item}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{menu-item}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{tile-ring}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{danger}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFFFFFF" />

    <!-- Buttons: the lobby's translucent pills for every button; PLAY yellow for Play and default buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{pill-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{pill-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{play}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{play-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{play-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{text-on-light}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{play/45}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{tab-selected}}" />

    <!-- Inputs: a dark well on the page, light edge on hover -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{input}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{input-hover}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{input-edge}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{input-edge-hover}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{segment-off}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{slider-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{label-cyan}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{blue-button}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{play}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{slider-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{scroll-thumb}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{scroll-thumb-hover}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{scroll-thumb}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{scroll-thumb-hover}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{tab-hover}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{screen-deep}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{tile-hover}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{tile-ring}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{tab-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{tab-selected}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{chip}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{chip-text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{blue-button}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{hairline}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{callout-edge@screen-deep}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{menu-bg}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{text}}" />

    <!-- Lobby: the navbar's notification dot, the scene scrim, section titles, the rail's edge, the game page surface -->
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{tab-dot}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{screen-bg}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{hairline}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{panel/92}}" />
</ResourceDictionary>
