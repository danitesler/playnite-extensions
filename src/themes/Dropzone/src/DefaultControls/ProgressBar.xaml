<!--
    Overlay on Playnite Default/DefaultControls/ProgressBar.xaml.
    The lobby's level and XP bars: a solid PLAY-yellow fill on the slider track's deep navy, ends rounded 2px.
    Indeterminate: an 80px yellow segment slides across.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="Root" ClipToBounds="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Rectangle Fill="{TemplateBinding Background}" RadiusX="2" RadiusY="2" />
                        <Rectangle Name="PART_Track" />
                        <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                            <Rectangle x:Name="Fill" Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2" />
                        </Decorator>
                        <Rectangle x:Name="Runner" Visibility="Collapsed" HorizontalAlignment="Left"
                                   Width="80" RadiusX="2" RadiusY="2"
                                   Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0,0">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="RunnerShift" X="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RunnerMove">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunnerShift" Storyboard.TargetProperty="X"
                                                         From="-120" To="600" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunnerMove" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
