<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml.
    A settings section as the Fortnite settings screen draws one (DISPLAY, GRAPHICS): no card and no rule, the title in
    heavy white italic capitals in the heading face, the rows under it. Padding comes from GroupBoxPadding and the
    title spacing from GroupBoxHeaderMargin.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel Background="{TemplateBinding Background}">
                        <Border DockPanel.Dock="Top" BorderThickness="0" BorderBrush="{TemplateBinding BorderBrush}"
                                Margin="{DynamicResource GroupBoxHeaderMargin}" Padding="0">
                            <TextBlock Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeLarger}"
                                       FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                       FontStyle="Italic" FontStretch="Condensed"
                                       Foreground="{DynamicResource HeadingForegroundBrush}">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                  RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </TextBlock>
                        </Border>
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
