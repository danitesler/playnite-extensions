<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml.
    Dropzone menus: Fortnite Chapter 6 rounded navy card.
      Panel:     LocalLobbyMenuPanelTemplate — 8px rounded navy card deepening from PopupBackgroundBrush to
                 NormalBrushDark, 1px PopupBorderBrush rim, faded pale-cyan top catchlight (FocusBrush), and a
                 centered 24x3px lobby-yellow top accent pill (PrimaryButtonBackgroundBrush). Shared by ContextMenu,
                 submenu popups, ComboBox, ComboBoxList and FilterSelectionBox.
      Rows:      30px compact rows (Menu.xaml, ComboBox.xaml).
      Highlight: royal-blue plate (MenuItemHoverBrush) with upper sheen and a 1.5px pale-cyan focus ring (FocusBrush)
                 that pops in (0.97 -> 1, 110ms) with a 5px yellow lobby dot; label shifts 2px right.
      Breaks:    three centered 3px lobby-yellow dots in a 10px open gap (no rules, matching Fortnite's space-led UI).
      Shortcuts: full-pill lobby caps (ButtonBackgroundBrush); flip to the navbar's light-grey pill on highlight.
      Exit:      DangerBrush label at rest on the deeper foot; deep crimson-washed plate with DangerBrush focus ring,
                 white label and red pill on highlight.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared panel chrome for ContextMenu, submenus, ComboBox, ComboBoxList and FilterSelectionBox. -->
    <ControlTemplate x:Key="LocalLobbyMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Base rounded navy card -->
            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1" />
            <!-- Subtle vertical depth toward NormalBrushDark at the foot (keeps Exit DangerBrush >= 5:1) -->
            <Border Margin="1" CornerRadius="7" Background="{DynamicResource NormalBrushDark}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.15" />
                        <GradientStop Color="#CC000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <!-- Top pale-cyan catchlight -->
            <Rectangle Height="1" VerticalAlignment="Top" Margin="10,1,10,0"
                       Fill="{DynamicResource FocusBrush}" Opacity="0.35">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <!-- Centered Fortnite lobby-yellow top accent pill -->
            <Border Width="26" Height="3" CornerRadius="1.5"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,1,0,0"
                    Background="{DynamicResource PrimaryButtonBackgroundBrush}" Opacity="0.9" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,8,6,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalLobbyMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="{TemplateBinding Padding}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
