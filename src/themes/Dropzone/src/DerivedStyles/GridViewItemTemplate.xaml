<!--
    Dropzone: cover content (GameListItem in the grid). Structure and parts from Playnite Default 10.60: PART_PanelHost,
    PART_ImageCover, PART_ButtonPlay, PART_ButtonInfo; the empty-cover name and darken-uninstalled rules are kept.
    The tile itself is rounded by GridViewItemStyle (a mask on the whole item). Hover is the lobby's pop: the cover zooms 1 to
    1.04 (0.15s ease-out, clipped by the tile), a one-shot white flash crosses it (0 to 0.22 at 15%, gone by 0.5s, the
    Battle Pass button's 500ms flash), the navy shade (55%) fades in, and the two round buttons rise 10px and scale 0.86 to 1 with
    an overshoot, Info 60ms after Play (0.22s); leaving reverses it in 0.18s. Exit animations use FillBehavior Stop, so
    nothing stays animated. Controls are GridTileButton: round icon buttons with Material Rounded glyphs (IconPlay,
    IconDownload for games that are not installed, IconInfo), Play in the PLAY yellow.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- GridTileButton: the lobby's round icon buttons (the Chapter 5 and 6 menus use rounded small icons, not the old slanted plates).
         A 44px circle (CornerRadius 22 on a square) with a 20px Material Rounded glyph (IconPlay / IconInfo / IconDownload). Background =
         plate, Tag = hover wash, Foreground = glyph; Play overrides them with the PLAY yellow and near-black ink, Info is the translucent
         lobby pill (white 22%). Hover: the button pops to 1.1 with a BackEase overshoot (0.15s), the wash fades in and a 2px pale-cyan
         focus ring (FocusBrush, the game's tile ring) fades in. Pressed: a 0.94 squash on its own transform and a black veil.
         Leaving fades back (FillBehavior Stop). -->
    <Style x:Key="GridTileButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Tag" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid UseLayoutRounding="True" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border Background="{TemplateBinding Background}" CornerRadius="22" SnapsToDevicePixels="True" />
                        <Border x:Name="HoverPlate" Background="{TemplateBinding Tag}" CornerRadius="22" SnapsToDevicePixels="True" Opacity="0" />
                        <Border x:Name="PressPlate" Background="{DynamicResource ScrimBrush}" CornerRadius="22" SnapsToDevicePixels="True" Opacity="0" />
                        <Border x:Name="Ring" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="22" SnapsToDevicePixels="True" Opacity="0" />
                        <ContentControl Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}" Width="20" Height="20"
                                        Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="{DynamicResource GridItemBackgroundBrush}">
                        <StackPanel Name="PART_PanelHost"
                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                            <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}">
                                <Image Name="PART_ImageCover"
                                       RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                       Stretch="{Settings CoverArtStretch}">
                                    <Image.RenderTransform>
                                        <ScaleTransform x:Name="CoverZoom" ScaleX="1" ScaleY="1" />
                                    </Image.RenderTransform>
                                </Image>
                                <Border Background="{DynamicResource WindowBackgourndBrush}" Opacity="0.6" x:Name="TextGameName" Visibility="Collapsed">
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Margin="5"
                                               Style="{StaticResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- Darken uninstalled (static) and the hover shade (animated) are separate layers. -->
                                <Border Background="{DynamicResource ScrimBrush}" Opacity="0.6" x:Name="BorderUninstalled" Visibility="Collapsed" />
                                <Border Background="{DynamicResource ScrimBrush}" x:Name="BorderMouseOver" Opacity="0" />
                                <Border x:Name="Flash" Background="{DynamicResource ButtonForegroundBrush}" Opacity="0" IsHitTestVisible="False" />
                                <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="140"
                                         Name="GameControls" Visibility="Hidden">
                                    <StackPanel Orientation="Horizontal" Margin="12">
                                        <Button Name="PART_ButtonPlay" Style="{StaticResource GridTileButton}" Background="{DynamicResource PrimaryButtonBackgroundBrush}" Tag="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Foreground="{DynamicResource PrimaryButtonForegroundBrush}" Margin="0,0,6,0"
                                                Content="{DynamicResource IconPlay}" Opacity="0" RenderTransformOrigin="0.5,0.5">

                                            <Button.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="PlayScale" ScaleX="0.86" ScaleY="0.86" />
                                                    <TranslateTransform x:Name="PlayRise" Y="10" />
                                                </TransformGroup>
                                            </Button.RenderTransform>
                                        </Button>
                                        <Button Name="PART_ButtonInfo" Style="{StaticResource GridTileButton}" Margin="6,0,0,0"
                                                Content="{DynamicResource IconInfo}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="InfoScale" ScaleX="0.86" ScaleY="0.86" />
                                                    <TranslateTransform x:Name="InfoRise" Y="10" />
                                                </TransformGroup>
                                            </Button.RenderTransform>
                                        </Button>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Padding="2,5,2,5" Grid.Row="1" Grid.Column="0"
                                       Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="{DynamicResource IconDownload}" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderUninstalled" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" /></ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="PlayRise" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.06" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="InfoRise" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.06" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="InfoScale" Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.06" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="InfoScale" Storyboard.TargetProperty="ScaleY" To="1" BeginTime="0:0:0.06" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CoverZoom" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CoverZoom" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.075" Value="0.22" /><LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PlayRise" Storyboard.TargetProperty="Y" To="10" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="0.86" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="0.86" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="InfoRise" Storyboard.TargetProperty="Y" To="10" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="InfoScale" Storyboard.TargetProperty="ScaleX" To="0.86" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="InfoScale" Storyboard.TargetProperty="ScaleY" To="0.86" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CoverZoom" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CoverZoom" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Hidden}" /></ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
