<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml.
    Covers as the Fortnite Discover tiles: 12px rounded corners (the cover is masked to them, inside a bitmap cache), a
    2px pale-cyan ring at 45% under the pointer and, for the selected cover, the game's focus ring: 3px of #ceefff,
    2px off the tile, following its corners. The rings sit just outside the cover so nothing gets clipped.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Margin="{Settings ItemSpacingMargin}" x:Name="ItemGrid">
                        <Grid x:Name="Tile">
                            <Grid.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True" />
                            </Grid.CacheMode>
                            <Grid.OpacityMask>
                                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                                    <VisualBrush.Visual>
                                        <Border Background="Black" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                                Width="{Binding ActualWidth, ElementName=Tile}"
                                                Height="{Binding ActualHeight, ElementName=Tile}" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Grid.OpacityMask>
                            <Border Background="{DynamicResource GridItemBackgroundBrush}" x:Name="TileBackground" />
                            <ContentPresenter />
                        </Grid>
                        <Border x:Name="SelectionBorder" BorderThickness="2" Margin="-3" IsHitTestVisible="False"
                                CornerRadius="15" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemHoverBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="BorderThickness" Value="3" TargetName="SelectionBorder" />
                            <Setter Property="Margin" Value="-5" TargetName="SelectionBorder" />
                            <Setter Property="CornerRadius" Value="17" TargetName="SelectionBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="TileBackground" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
