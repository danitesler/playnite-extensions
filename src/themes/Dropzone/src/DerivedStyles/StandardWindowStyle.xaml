<!--
    Dropzone: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    The Fortnite settings screen's tab strip as a 44px band: the deep navy strip behind the icons, the title as the
    current navbar tab (a light grey pill, near-black heavy condensed label) followed by the lobby's three yellow
    separator dots, and the drop-zone ring (two concentric outlines) ghosted into the right end. Closed by a 2px blue
    menu edge. Caption buttons are the 40x32 WindowBarButton glyphs, so the caption and the content offset are 44 (Default: 25).
    PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>
    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource TabControlHeaderBackgroundBrush}" ClipToBounds="True">
                                    <!-- Drop-zone ring ghosted into the right end, in a Canvas so it adds no desired width. -->
                                    <Canvas IsHitTestVisible="False">
                                        <Ellipse Canvas.Right="-34" Canvas.Top="-40" Width="124" Height="124" Stroke="{DynamicResource TextBrush}" StrokeThickness="3" Opacity="0.06" />
                                        <Ellipse Canvas.Right="-8" Canvas.Top="-14" Width="72" Height="72" Stroke="{DynamicResource TextBrush}" StrokeThickness="3" Opacity="0.09" />
                                    </Canvas>
                                    <Rectangle Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{DynamicResource PopupBorderBrush}" />
                                    <DockPanel LastChildFill="False">
                                        <Border DockPanel.Dock="Left" Margin="10,0,0,0" Height="30" VerticalAlignment="Center" Padding="16,0"
                                                CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TopPanelItemCheckedBackgroundBrush}">
                                            <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold" FontStretch="Condensed" Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                        </Border>
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource PrimaryButtonBackgroundBrush}" />
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource PrimaryButtonBackgroundBrush}" Opacity="0.6" />
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryButtonBackgroundBrush}" Opacity="0.3" />
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,8,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
