<!--
    Overlay on Playnite Default/DerivedStyles/PropertyItemButton.xaml: the clickable field values of the game overview
    (a click filters the library by that value).
    Default: a link in the island page's label cyan that turns white under the pointer; 1px margins keep link and plain
    values on the same rhythm.
    Chip: when the owning ItemsControl has Tag="Chip" (platforms, genres, categories, features and tags), the island
    page's tags ("16 MAX PLAYERS", "EXPLORATION"): a blue plate slanted 10 degrees with a 1px bright blue edge, bold
    light-blue capitals that lean with it, 24px tall, 4px corners; the plate turns button blue under the pointer.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                               TextWrapping="Wrap" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Before the Chip trigger: a later trigger wins, so a hovered chip keeps its own text color. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Background" Value="{DynamicResource PropertyItemBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chip" MinHeight="24" Padding="10,3,10,3" Margin="3,0,3,0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource PropertyItemHoverBackgroundBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <SkewTransform AngleX="-10" />
                                </Border.RenderTransform>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
