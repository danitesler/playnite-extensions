<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml: the game page beside the game list.
    Built like the Fortnite island details screen (Discover, an island's page):
      - the background art is a band at the top, washed with the page navy from the left (the screen's deep blue
        panel over the scene) and from below, fading into the page;
      - the name in heavy condensed capitals of the heading face, large, over the art; the yellow PLAY plate
        (PlayButton, SELECT on that screen) at the right with the other actions as round pill buttons (Options gear
        for Playnite's More menu, edit);
      - Steam screenshots, then description and notes under heavy white section titles (the Discover row titles),
        and at the right the cover over one metadata pane on the rail navy, captions in the label cyan and bold
        ("CREATOR -", "ISLAND CODE -"), list values as the screen's slanted blue tags.
    Every PART_ element of Playnite's file is kept. HtmlTextView takes Colors: its HtmlForeground and LinkForeground
    read the Color of the brushes set on TextElement.Foreground and Tag, so ThemeModifier edits reach them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <Grid x:Name="PageRoot"
                          d:DesignWidth="1280" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"
                                      Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible">
                            <Grid>
                                <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <!-- No OpacityMask or BitmapCache on the banner: masked art repainted in part (behind the animated PLAY button) left dark seams on
                                         scaled displays. The page wash is one plain gradient from clear to the page brush, which is translucent (92%), so the
                                         art under the page still shows a little at the foot of the band, as it did. -->
                                    <Border x:Name="ScrimSwatch" Background="{DynamicResource ScrimBrush}" Visibility="Collapsed" />
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                    <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <!-- The island page wash: clear at the top, the page brush where the title starts. -->
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#00000000" Offset="0.15" />
                                                <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <!-- The island page's left panel: the page navy over the left of the art, clear by 60%. -->
                                    <Rectangle Opacity="0.85">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="{Binding Background.Color, ElementName=ScrimSwatch}" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="0.6" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                                <StackPanel Margin="32,0,32,32" MaxWidth="1400">
                                    <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                    <Border IsHitTestVisible="False" x:Name="DetailsBannerSpacer" MinHeight="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 190 / 360'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                        <Setter Property="Height" Value="8" />
                                                    </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="8" />
</DataTrigger>
</Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <!-- Header: icon and name at the left, PLAY and the other actions at the right. -->
                                    <DockPanel Margin="0,24,0,28">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="24,0,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" MinWidth="200" Height="52" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" MinWidth="200" Height="52" />
                                                <Control Style="{DynamicResource RunningActionIndicator}" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Width="52" Height="52" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                                <ContentControl Width="20" Height="20" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Width="52" Height="52" Padding="0" Margin="8,0,0,0" Focusable="False" ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Width="20" Height="20" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                        <Image x:Name="PART_ImageIcon" MaxHeight="48" MaxWidth="48" DockPanel.Dock="Left" Margin="0,0,16,0"
                                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                        <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}"
                                                   FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold" FontStretch="Condensed" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                    <Grid x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 32 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataViewport" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="32,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<StackPanel Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                            <Image MaxWidth="{DynamicResource GameDetailsPaneWidth}" x:Name="PART_ImageCover" Height="{Settings GameDetailsCoverHeight}" HorizontalAlignment="Left"
                                                   StretchDirection="Both" Stretch="Uniform" Margin="0,0,0,16"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                            <Border Background="{DynamicResource ExpanderBackgroundBrush}" Padding="16,12,16,12"
                                                    CornerRadius="{DynamicResource CornerRadiusLarge}">
                                                <Border ClipToBounds="True" x:Name="DetailsMetadataViewport" Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch">
<Border.Style><Style TargetType="Border"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-31,0,-6" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-31,-24,-6" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                        <Border x:Name="MetaProgress" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCompletionStatus" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPlayTime" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextPlayTime" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemLastPlayed" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextLastActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemRecentActivity" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAdded" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" Grid.Column="1" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCommunityScore" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemCriticScore" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemUserScore" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCUserScore}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" Grid.Column="1" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemDevelopers" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDevelopersLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsDevelopers" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPublishers" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCPublishersLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsPublishers" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemReleaseDate" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemSeries" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCSeriesLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsSeries" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAgeRating" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsAgeRatings" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemRegion" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRegionLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsRegions" Grid.Column="1" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaTags" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemPlatform" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCPlatformsTitle}" Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,2,0,-8" Grid.Column="1">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemGenres" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
