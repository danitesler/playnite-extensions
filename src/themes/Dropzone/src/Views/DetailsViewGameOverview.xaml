</Grid>
</Grid>
                                </StackPanel>
                            <!-- Empty state (no game selected): the theme's parachute mark drifting down to a drop-zone ring on the ground, and Playnite's
                                     "No game selected" in heavy condensed capitals. The parachute bobs (2.6s) and sways on its harness (3.2s), the ring breathes
                                     (1.3s); every loop lives in its element's own style and runs only while this shows. Centered in the visible area. -->
                            <Grid VerticalAlignment="Top" Height="{Binding ViewportHeight, ElementName=PART_ScrollViewHost}">
                                <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                                    <Grid Width="120" Height="120" HorizontalAlignment="Center">
                                        <Ellipse Width="96" Height="22" VerticalAlignment="Bottom" Stroke="{DynamicResource PrimaryButtonBackgroundBrush}" StrokeThickness="2">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="DropRing">
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="0.9" Duration="0:0:1.3">
                                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="DropRing" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Width="88" Height="88">
                                            <Grid.RenderTransform><TranslateTransform x:Name="EmptyFx1Xf" /></Grid.RenderTransform>
                                            <Grid RenderTransformOrigin="0.5,0">
                                                <Grid.RenderTransform><RotateTransform x:Name="EmptyFx2Xf" /></Grid.RenderTransform>
                                                <Path Data="M2 10Q2 2 12 2Q22 2 22 10L18.6 10Q16.6 7.8 14.6 10L13.3 10Q12 8.2 10.7 10L9.4 10Q7.4 7.8 5.4 10Z M3.2 11.2L4.3 10.6L10.6 16.6L10 17.4Z M20.8 11.2L19.7 10.6L13.4 16.6L14 17.4Z M11.4 11L12.6 11L12.6 16.8L11.4 16.8Z M9.6 17.6L14.4 17.6L14.4 22L9.6 22Z" Fill="{DynamicResource TextBrush}" Stretch="Uniform" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                    <ContentControl Content="{DynamicResource LOCErrorNoGameSelected}" Focusable="False" IsTabStop="False" HorizontalAlignment="Center" Margin="0,18,0,0">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}"
                                                           FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                                           FontWeight="Bold" FontStretch="Condensed" Foreground="{DynamicResource TextBrush}" />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </StackPanel>
                            </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Empty-state loops live here, on named transforms. Started from an element Style they crash Playnite: the page is built with no game yet, so the trigger fires while the transform is read-only. -->
                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="EmptyFx1Run">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="EmptyFx1Xf" Storyboard.TargetProperty="Y" From="0" To="10" Duration="0:0:2.6">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard x:Name="EmptyFx2Run">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="EmptyFx2Xf" Storyboard.TargetProperty="Angle" From="-4" To="4" Duration="0:0:3.2">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="EmptyFx1Run" />
                                <RemoveStoryboard BeginStoryboardName="EmptyFx2Run" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
