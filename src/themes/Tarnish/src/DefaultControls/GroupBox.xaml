<!--
    Tarnish: GroupBox. A status panel: the title in pale gold capitals over a hairline that fades out to the right,
    led by a diamond, then a dark panel in a dim outline. Content-sized (the rule has no desired width), so
    Statistics keeps its wrapping cards. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}">
                            <TextBlock Style="{DynamicResource HeadingTextBlock}">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header" RecognizesAccessKey="True" />
                            </TextBlock>
                            <Control Template="{DynamicResource DividerTemplate}" Focusable="False" IsTabStop="False" Margin="0,4,0,0" Foreground="{DynamicResource HeadingRuleBrush}" />
                        </StackPanel>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
