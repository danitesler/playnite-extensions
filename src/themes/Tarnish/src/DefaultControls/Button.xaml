<!--
    Tarnish: Button. The Elden Ring menu button (Key Bindings, Next, OK): a black plate in a thin outline with a faint
    second line inside, plain serif label. Hover lights it over 0.14s: the plate turns olive, the outline parchment,
    and the light streak of a prompt rises along its bottom edge; leaving fades it over 0.25s. The default button is
    the selected option. Width 41 is ThemeModifier's icon button: pinned, then scaled to 32x32.
    Tokens: ButtonBackgroundBrush (er-well), ButtonBorderBrush (er-line), ButtonForegroundBrush (er-text),
    ButtonHoverBackgroundBrush (er-select), FrameHoverBrush (er-parchment), ButtonPressedBackgroundBrush (er-select-hi),
    PrimaryButtonGlowBrush (er-gold). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Control Template="{DynamicResource FramedPlateTemplate}" Focusable="False" IsTabStop="False" Padding="7"
                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                        <Control x:Name="Lit" Template="{DynamicResource FramedPlateTemplate}" Focusable="False" IsTabStop="False" Padding="7" Opacity="0"
                                 Background="{DynamicResource ButtonHoverBackgroundBrush}" BorderBrush="{DynamicResource FrameHoverBrush}" />
                        <Control x:Name="Pressed" Template="{DynamicResource FramedPlateTemplate}" Focusable="False" IsTabStop="False" Padding="7" Opacity="0"
                                 Background="{DynamicResource ButtonPressedBackgroundBrush}" BorderBrush="{DynamicResource FrameHoverBrush}" />
                        <Control x:Name="Streak" Template="{DynamicResource GlowLineTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Opacity="0"
                                 Height="11" Margin="8,0,8,-5" VerticalAlignment="Bottom" Foreground="{DynamicResource PrimaryButtonGlowBrush}" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Streak" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Streak" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pressed" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="Width" Value="41">
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
