<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu,
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is Elden Ring's square olive-black item box: PopupBackgroundBrush in
    FramedPlateTemplate (1px dim outline and faint 3px inset inner line), topped by a fading parchment hairline
    crowned by a Sites of Grace gold light streak (GlowLineTemplate) and closed by a faint bottom hairline
    (LocalMenuPanelTemplate, shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and
    CustomControls/FilterSelectionBox.xaml). Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Control Template="{DynamicResource FramedPlateTemplate}"
                     Background="{DynamicResource PopupBackgroundBrush}"
                     BorderBrush="{DynamicResource PopupBorderBrush}"
                     Focusable="False" IsTabStop="False" />
            <!-- Fading parchment top rule crowned by a Sites of Grace gold light streak -->
            <Rectangle Height="1" Margin="8,1,8,0" VerticalAlignment="Top" Fill="{DynamicResource HeadingRuleBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="0.5" Color="Black" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Control Template="{DynamicResource GlowLineTemplate}" Width="120" Height="7" Margin="0,-2,0,0"
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                     Focusable="False" IsTabStop="False" />
            <Rectangle Height="1" Margin="16,0,16,1" VerticalAlignment="Bottom" Fill="{DynamicResource HeadingRuleBrush}" Opacity="0.55">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="0.5" Color="Black" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,7,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="5,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
