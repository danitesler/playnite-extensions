<!--
    Tarnish: spacing, focus and the shared shapes of the Elden Ring menus.
    SelectionBarTemplate is the selected option of the System menu: an olive bar whose ends fade out, between two
    hairlines that fade the same way. FramedPlateTemplate is the menu button (Key Bindings, Next, OK): a black plate
    in a 1px outline with a faint second line inside it. GlowLineTemplate is the light streak under a prompt
    ("press any button"): a hot hairline core in a flat elliptical bloom. DividerTemplate is the section rule: a
    hairline that fades toward its end, led by a small diamond. GlowFrameTemplate is the soft bloom around a lit
    slot, a 9-slice white mask (art/sprites.py). None of them has a desired size.
    Sizes: 32px fields, 16px glyphs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Option rows in the game: label inset about 18px from the bar's faded end, rows 36px apart at 1080p (30px here). -->
    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <Thickness x:Key="InputPadding">8,5</Thickness>
    <Thickness x:Key="MenuPadding">0,4</Thickness>
    <Thickness x:Key="MenuItemPadding">16,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,3</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">14,5</Thickness>
    <Thickness x:Key="ListBoxItemPadding">14,5</Thickness>
    <Thickness x:Key="GroupBoxPadding">16,12,16,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">12,6</Thickness>

    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Menu button: Background plate, a 1px BorderBrush outline and a faint second line 3px inside it. -->
    <ControlTemplate x:Key="FramedPlateTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
            <Border Margin="3" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Opacity="0.22" />
        </Grid>
    </ControlTemplate>

    <!-- Selected option: Background bar fading out over 14px on the left and 64px on the right, BorderBrush hairlines
         along its top and bottom fading the same way. -->
    <ControlTemplate x:Key="SelectionBarTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3*" MaxWidth="64" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="1" Color="#FFFFFFFF" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <Rectangle Fill="{TemplateBinding Background}" />
                <Border BorderThickness="0,1" BorderBrush="{TemplateBinding BorderBrush}" Opacity="0.45" />
            </Grid>
            <Grid Grid.Column="1">
                <Rectangle Fill="{TemplateBinding Background}" />
                <Border BorderThickness="0,1" BorderBrush="{TemplateBinding BorderBrush}" Opacity="0.45" />
            </Grid>
            <Grid Grid.Column="2">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <Rectangle Fill="{TemplateBinding Background}" />
                <Border BorderThickness="0,1" BorderBrush="{TemplateBinding BorderBrush}" Opacity="0.45" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <!-- Light streak: a flat elliptical bloom with a 1px hot core through its middle, in the host's Foreground. -->
    <ControlTemplate x:Key="GlowLineTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.55">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.35" Color="#66FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0.05" Color="#00FFFFFF" />
                        <GradientStop Offset="0.5" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.95" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Bloom around a lit slot: 9-slice of Images/fx/glow-frame.png (128px, 44px corners), in the host's Foreground.
         Hosts sit at a -28 margin around what they light. No desired size. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,84,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Corner ticks of a lit slot: four 9px hairline L marks in the host's Foreground. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}" Data="F1M0,0H9V1H1V9H0Z" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}" Data="F1M0,0H9V9H8V1H0Z" />
            <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Data="F1M0,0H1V8H9V9H0Z" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Data="F1M8,0H9V9H0V8H8Z" />
        </Grid>
    </ControlTemplate>

    <!-- Section rule: a hairline in the inherited foreground that fades out to the right, led by a 7px diamond. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="7" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Height="1" VerticalAlignment="Center" Margin="11,0,0,0" Fill="{TemplateBinding Foreground}" Opacity="0.7">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.55" Color="#99FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Path HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Data="F1M3.5,0L7,3.5L3.5,7L0,3.5Z" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
