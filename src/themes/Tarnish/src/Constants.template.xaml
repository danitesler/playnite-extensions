<!--
    Tarnish: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared vocabulary (scripts/data/theme-keys.json). Token names (er-*) live in tokens.css.
    Role map: ../AGENTS.md -> Tokens. Theme XAML reads brushes only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Type: old-style serif body (Agmena in the game, Palatino here), inscriptional capitals for titles. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">19</sys:Double>
    <sys:Double x:Key="FontSizeLargest">30</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:er-font-body|Georgia}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Cinzel, {{text:er-font-heading|Georgia}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width; applied inside the pane's padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: square everywhere; edges are hairlines that fade out toward their ends. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:er-radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Thickness x:Key="FrameThickness">1</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{er-text}}</Color>
    <Color x:Key="TextColorDarker">{{er-text-dim}}</Color>
    <Color x:Key="TextColorDark">{{er-void}}</Color>
    <Color x:Key="MainColor">{{er-select}}</Color>
    <Color x:Key="MainColorDark">{{er-panel}}</Color>
    <Color x:Key="HoverColor">{{er-hover}}</Color>
    <Color x:Key="GlyphColor">{{er-gold-pale}}</Color>
    <Color x:Key="HighlightGlyphColor">{{er-brass}}</Color>
    <Color x:Key="PopupBackgroundColor">{{er-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{er-line}}</Color>
    <Color x:Key="BackgroundToneColor">{{er-night}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{er-rule}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{er-rule}}</Color>
    <Color x:Key="DataChangeNotifColor">{{er-gold}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{er-line}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{er-night}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{er-well}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{er-well}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{er-stamina}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{er-crimson}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{er-gold}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{er-gold}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{er-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{er-night}}" />

    <!-- Shell: the void as frame and rail, the library one step up -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{er-void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{er-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{er-night}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{er-night}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{er-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{er-haze}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the theme's
         own ArtTint color, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{er-haze}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{er-hairline}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{er-rule}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{er-line}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{er-well}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{er-panel}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{er-gold-pale}}" />

    <!-- States: the selected option is an olive bar that fades out at both ends, its label a step brighter -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{er-select}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{er-select-hi}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{er-parchment}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{er-bright}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{er-hover}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{er-select}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{er-gold-pale}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{er-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{er-bright}}" />

    <!-- Headings: pale gold capitals, a brass diamond, hairline rules -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{er-gold-pale}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{er-parchment}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{er-gold}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{er-hairline}}" />

    <!-- Buttons: a black plate in a thin outline; Play is the lit olive plate with gold lettering -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{er-text}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{er-line}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{er-select}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{er-select-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{er-select}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{er-gold-pale}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{er-select-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{er-brass}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{er-gold}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{er-select}}" />

    <!-- Inputs: sunken black wells in a dim outline -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{er-well}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{er-line}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{er-parchment}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{er-hairline}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{er-parchment}}" />

    <!-- Controls: a hairline slider with a bright bar, scroll rail, tabs, menus -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{er-line}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{er-text}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{er-gold-pale}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{er-parchment}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{er-rule}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{er-line}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{er-parchment}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{er-line}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{er-parchment}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{er-text-dim}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{er-text}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{er-rule}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{er-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{er-line}}" />

    <!-- Library: covers sit in inventory slots; the selected slot is lit pale gold -->
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{er-gold-pale}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{er-parchment}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{er-rule}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{er-line}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{er-rule}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{er-parchment}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{er-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{er-select}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{er-text-dim}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{er-gold-pale}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{er-gold}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{er-panel-hi}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{er-parchment}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{er-select}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{er-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{er-gold-pale}}" />
</ResourceDictionary>
