<!--
    Tarnish: dialogs and the Settings window drawn as an Elden Ring menu screen: a 44px black title band whose left
    part is lit olive and fades out to the right, the screen title in pale gold capitals behind a framed icon
    tile holding a gold glint (the menus put an icon tile before "System", "Inventory", "Map"), and a closing
    hairline that is bright under the title and fades out to the right. 1px dim frame.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource FrameBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid VerticalAlignment="Top" Height="44" Background="{DynamicResource WindowTitleBackgroundBrush}" IsHitTestVisible="False" />
                                <Rectangle VerticalAlignment="Top" Height="44" Fill="{DynamicResource SelectedBrush}" Opacity="0.6" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#FFFFFFFF" />
                                            <GradientStop Offset="0.25" Color="#99FFFFFF" />
                                            <GradientStop Offset="0.7" Color="#00FFFFFF" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Rectangle VerticalAlignment="Top" Height="1" Margin="0,43,0,0" Fill="{DynamicResource FrameInnerBrush}" IsHitTestVisible="False" />
                                <Rectangle VerticalAlignment="Top" Height="1" Margin="0,43,0,0" Fill="{DynamicResource HeadingRuleBrush}" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#66FFFFFF" />
                                            <GradientStop Offset="0.1" Color="#FFFFFFFF" />
                                            <GradientStop Offset="0.75" Color="#00FFFFFF" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <DockPanel VerticalAlignment="Top" Height="44" LastChildFill="False">
                                    <Border DockPanel.Dock="Left" Width="26" Height="26" Margin="12,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                            BorderThickness="1" BorderBrush="{DynamicResource FrameBrush}" Background="{DynamicResource ButtonBackgroundBrush}">
                                        <Path Width="14" Height="14" Stretch="Fill" Data="{DynamicResource IconAdd}" Fill="{DynamicResource HeadingMarkerAltBrush}" />
                                    </Border>
                                    <TextBlock Text="{TemplateBinding Title}" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeLarger}"
                                               Style="{DynamicResource HeadingTextBlock}" Foreground="{DynamicResource WindowTitleForegroundBrush}" x:Name="PART_TextTitle" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </DockPanel>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
