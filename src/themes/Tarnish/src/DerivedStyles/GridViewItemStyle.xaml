<!--
    Tarnish: cover tiles, drawn as slots of the Elden Ring inventory. Selected is static: a 1px parchment frame with
    corner ticks and a gold glint on its top-right corner. Hover lights the slot: a pale gold outline fades in while
    corner ticks close in on the cover (from 9px out to 3px, 0.2s, eased) and a gold bloom rises around it, then
    breathes (1 to 0.6 and back every 2.4s) for as long as the pointer stays; leaving fades everything out over 0.3s.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}" Margin="{Settings ItemSpacingMargin}" x:Name="ItemGrid">
                        <Grid x:Name="BloomPulse" IsHitTestVisible="False">
                            <Control x:Name="HoverBloom" Template="{DynamicResource GlowFrameTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                     Margin="-28" Opacity="0" Foreground="{DynamicResource PrimaryButtonGlowBrush}" />
                        </Grid>
                        <ContentPresenter />
                        <Border x:Name="SelectionFrame" BorderThickness="1" Margin="-1" IsHitTestVisible="False" Visibility="Collapsed"
                                BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" />
                        <Control x:Name="SelectionMarks" Template="{DynamicResource CornerMarksTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                 Foreground="{DynamicResource GridViewItemSelectedBorderBrush}" Margin="-4" Visibility="Collapsed" />
                        <Path x:Name="SelectionPip" Width="13" Height="13" Margin="0,-7,-7,0" HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Fill"
                              Data="{DynamicResource IconAdd}" IsHitTestVisible="False" Visibility="Collapsed" Fill="{DynamicResource HeadingMarkerAltBrush}" />
                        <Border x:Name="HoverOutline" BorderThickness="1" Margin="-1" IsHitTestVisible="False" Opacity="0"
                                BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                        <Control x:Name="HoverMarks" Template="{DynamicResource CornerMarksTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                 Foreground="{DynamicResource GridViewItemHoverBorderBrush}" Margin="-9" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectionFrame" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectionMarks" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectionPip" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="91" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <ThicknessAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Margin" To="-3" Duration="0:0:0.2">
                                            <ThicknessAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverOutline" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="HoverBloom" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BloomPulse" Storyboard.TargetProperty="Opacity" From="1" To="0.6" BeginTime="0:0:0.3" Duration="0:0:1.2"
                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <ThicknessAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Margin" To="-9" Duration="0:0:0.25">
                                            <ThicknessAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverOutline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="HoverBloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="BloomPulse" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
