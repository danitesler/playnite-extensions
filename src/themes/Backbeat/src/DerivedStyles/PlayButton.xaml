<!--
    Backbeat: Play = the orange sticker. Slanted plate, 3px ink outline, hard ink offset, ink headline label.
    Hover, animated both ways (no setters on animated parts, so nothing snaps):
      in   0.18s: the yellow plate fades in, a jagged impact star pops out behind the button (scale 0.7 to 1, BackEase),
           speed lines fade in across the plate. While hovered the button thumps on the beat (0.46s = 130 BPM: a sharp
           1.05 hit that decays) and the speed lines crawl one 512px tile per second.
      out  0.26s: everything fades back; loops are replaced by finite glides. Exit animations use FillBehavior Stop.
    Pressed fades in its own hot-orange plate and shoves the whole sticker 2px into its shadow.
    The star is a vector Path; only the speed lines use a mask, and nothing masked sits behind this button.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages (DataContext: Playnite's
        GameDetailsViewModel, IsRunning / IsLaunching). While the game runs Playnite swaps Play for the context action
        (RUNNING): the slanted sticker (SlantPlateTemplate's -9 degree skew) is tinted green inside a 1px frame with a green foot bar, thumping on the downbeat every two bars at 130 BPM; launching thumps every beat.
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Grid RenderTransformOrigin="0.5,0.5" >
                            <Grid.RenderTransform>
                                <SkewTransform AngleX="-9" />
                            </Grid.RenderTransform>
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.22" />
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" />
                            <Grid Height="3" Margin="10,0,10,5" VerticalAlignment="Bottom">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,2" Height="12">
                                <Rectangle x:Name="RunningBar1" Width="3" Height="12" Margin="0,0,2,0" VerticalAlignment="Bottom" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningBar1Scale" ScaleY="0.35" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="RunningBar2" Width="3" Height="12" Margin="0,0,2,0" VerticalAlignment="Bottom" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningBar2Scale" ScaleY="0.35" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="RunningBar3" Width="3" Height="12" VerticalAlignment="Bottom" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningBar3Scale" ScaleY="0.35" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.8,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.83" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.83" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.91" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.33" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.91" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.99" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.41" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.95" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the scan has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Thump" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="Shove" X="0" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Grid x:Name="StarHost">
                            <Path x:Name="Star" Data="{DynamicResource IconBurst}" Stretch="Fill" Margin="-26,-24,-26,-24"
                                  Fill="{DynamicResource PrimaryButtonGlowBrush}" Stroke="{DynamicResource PrimaryButtonBorderBrush}" StrokeThickness="3"
                                  Opacity="0" Visibility="Hidden" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="StarScale" ScaleX="0.7" ScaleY="0.7" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>

                        <Control Template="{DynamicResource SlantPlateTemplate}" Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                 Foreground="{DynamicResource PanelShadowBrush}"  x:Name="PlayFill"/>
                        <Control x:Name="RunningBreath" Template="{DynamicResource SlantPlateTemplate}" Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}"
                                 Foreground="Transparent" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Opacity="0" />
                        <Control x:Name="RunningScan" Template="{DynamicResource SlantPlateTemplate}" Background="{DynamicResource RunningIndicatorBrush}" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}"
                                 Foreground="Transparent" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0.4">
                            <Control.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.352" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.35" />
                                    <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0" />
                                </LinearGradientBrush>
                            </Control.OpacityMask>
                        </Control>
                        <Control x:Name="RunningHoverDim" Template="{DynamicResource SlantPlateTemplate}" Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}"
                                 Foreground="Transparent" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Opacity="0" />
                        <Grid x:Name="HoverFx">
                            <Control x:Name="HoverPlate" Template="{DynamicResource SlantPlateTemplate}" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                     BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Foreground="Transparent" Opacity="0" />
                            <Control x:Name="PressPlate" Template="{DynamicResource SlantPlateTemplate}" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                     BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Foreground="Transparent" Opacity="0" />
                            <Grid x:Name="Speed" Margin="8,5,8,5" ClipToBounds="True" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                                <Canvas>
                                    <Rectangle Width="1200" Height="40" Fill="{DynamicResource PrimaryButtonBackgroundBrush}">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="SpeedShift" X="0" />
                                        </Rectangle.RenderTransform>
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{ThemeFile 'Images/fx/speedlines.png'}" TileMode="Tile" Stretch="Fill"
                                                        Viewport="0,0,512,40" ViewportUnits="Absolute" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Canvas>
                            </Grid>
                        </Grid>


                        <ContentPresenter x:Name="PlayContent" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StarHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.88" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.352" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.998" KeySpline="0.8,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.998" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.8,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.35" KeySpline="0.8,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StarHost" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.78" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.66" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.78" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thump" Storyboard.TargetProperty="ScaleX" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.07" Value="1.025" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thump" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.07" Value="1.025" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Star" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Star" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="StarScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="StarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Speed" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Speed" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thump" Storyboard.TargetProperty="ScaleX" Duration="0:0:0.46">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1.05" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.34" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.46" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thump" Storyboard.TargetProperty="ScaleY" Duration="0:0:0.46">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1.05" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.34" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.46" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpeedShift" Storyboard.TargetProperty="X" From="0" To="-512" Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Star" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="StarScale" Storyboard.TargetProperty="ScaleX" To="0.7" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="StarScale" Storyboard.TargetProperty="ScaleY" To="0.7" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Star" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Speed" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Speed" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Thump" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Thump" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SpeedShift" Storyboard.TargetProperty="X" By="-60" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="Shove" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="Shove" Storyboard.TargetProperty="Y" To="2" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Shove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Shove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
                    <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsRunning}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
