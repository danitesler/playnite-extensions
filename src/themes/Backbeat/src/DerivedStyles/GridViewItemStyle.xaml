<!--
    Backbeat: cover tiles. Selected, static: a 3px white line, a hard yellow offset shadow and a small yellow star sticker
    on the top-left corner. Hover, animated both ways: the cover lifts 3px up and left while its cyan shadow slides out to
    7px, a 3px cyan line fades in, and an orange impact star pops onto the top-right corner, spinning from -30 degrees with
    an overshoot. Exit runs in 0.18s with FillBehavior Stop. Everything is drawn inside the item's own spacing margin.
    Library art behind the grid has no OpacityMask. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}" Margin="{Settings ItemSpacingMargin}" x:Name="ItemGrid">
                        <Border x:Name="SelectShadow" Background="{DynamicResource SelectedBorderBrush}" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform X="6" Y="6" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="HoverShadow" Background="{DynamicResource GridViewItemHoverBorderBrush}" Margin="-3" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="HoverShadowShift" X="0" Y="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Grid>
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="Lift" X="0" Y="0" />
                            </Grid.RenderTransform>
                            <ContentPresenter />
                            <Border x:Name="SelectionBorder" BorderThickness="3" Margin="-3" IsHitTestVisible="False" />
                            <Border x:Name="HoverBorder" BorderThickness="3" Margin="-3" IsHitTestVisible="False" Opacity="0"
                                    BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                            <Path x:Name="SelectStar" Data="{DynamicResource IconBurst}" Stretch="Fill" Width="26" Height="26" Margin="-10,-10,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"
                                  Fill="{DynamicResource SelectedBorderBrush}" Stroke="{DynamicResource PanelShadowBrush}" StrokeThickness="2" />
                            <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                <Border x:Name="RunningWash" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="6" Opacity="0.18" />
                                <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.3">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.352" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.35" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="3" />
                                <Border Height="28" Margin="8" VerticalAlignment="Bottom" Background="{DynamicResource WindowBackgourndBrush}" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" Height="14">
                                            <Rectangle x:Name="RunningBar1" Width="3" Height="14" Margin="0,0,2,0" VerticalAlignment="Bottom" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform x:Name="RunningBar1Scale" ScaleY="0.35" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                            <Rectangle x:Name="RunningBar2" Width="3" Height="14" Margin="0,0,2,0" VerticalAlignment="Bottom" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform x:Name="RunningBar2Scale" ScaleY="0.35" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                            <Rectangle x:Name="RunningBar3" Width="3" Height="14" VerticalAlignment="Bottom" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform x:Name="RunningBar3Scale" ScaleY="0.35" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                        </StackPanel>
                                        <Grid Height="3" Margin="34,0,6,4" VerticalAlignment="Bottom">
                                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Path x:Name="HoverStar" Data="{DynamicResource IconBurst}" Stretch="Fill" Width="40" Height="40" Margin="0,-14,-14,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0" Visibility="Hidden"
                                  Fill="{DynamicResource PrimaryButtonBackgroundBrush}" Stroke="{DynamicResource PanelShadowBrush}" StrokeThickness="3"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="HoverStarScale" ScaleX="0.4" ScaleY="0.4" />
                                        <RotateTransform x:Name="HoverStarSpin" Angle="-30" />
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverShadow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverStar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverShadow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="HoverStar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="X" To="-3" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverShadowShift" Storyboard.TargetProperty="X" To="7" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverShadowShift" Storyboard.TargetProperty="Y" To="7" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverStarScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverStarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverStarSpin" Storyboard.TargetProperty="Angle" To="8" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverStar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Lift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverShadowShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverShadowShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverStarScale" Storyboard.TargetProperty="ScaleX" To="0.4" Duration="0:0:0.14" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverStarScale" Storyboard.TargetProperty="ScaleY" To="0.4" Duration="0:0:0.14" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverStarSpin" Storyboard.TargetProperty="Angle" To="-30" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverShadow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverStar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectShadow" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectStar" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.352" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.998" KeySpline="0.8,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.998" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.8,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.35" KeySpline="0.8,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.8,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.83" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.83" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.91" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.33" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.91" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.99" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.41" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.95" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the scan has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
