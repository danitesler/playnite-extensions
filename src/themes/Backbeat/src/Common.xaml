<!--
    Backbeat: spacing, focus and the shared comic motifs.
      SlantPlateTemplate   the slanted sticker plate behind buttons, tabs, chips and current items (9 degrees)
      AngledCardTemplate   a comic panel: tilted 1.4 degrees, ink outline, hard offset shadow, never blurred
      HalftoneTemplate     Ben-Day dots fading from the top-right corner (halftone-card.png, white mask)
      DividerTemplate      a hard rule that ends in four beat ticks
    Every template draws through no-desired-size elements, so a GroupBox stays content-sized on the Statistics page.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <Thickness x:Key="ButtonPadding">16,4</Thickness>
    <Thickness x:Key="InputPadding">8,4</Thickness>
    <Thickness x:Key="MenuPadding">0,6</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">18,14,18,18</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <ControlTemplate x:Key="SlantPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Border Background="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <SkewTransform AngleX="-9" />
                        <TranslateTransform X="3" Y="3" />
                    </TransformGroup>
                </Border.RenderTransform>
            </Border>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <SkewTransform AngleX="-9" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="AngledCardTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Border Background="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <SkewTransform AngleY="-1.4" />
                        <TranslateTransform X="6" Y="6" />
                    </TransformGroup>
                </Border.RenderTransform>
            </Border>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <SkewTransform AngleY="-1.4" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HalftoneTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/halftone-card.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" VerticalAlignment="Center" Height="14" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Rectangle Height="3" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Rectangle Width="4" Height="14" Fill="{TemplateBinding Foreground}" />
                <Rectangle Width="4" Height="8" Margin="4,0,0,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
                <Rectangle Width="4" Height="8" Margin="4,0,0,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
                <Rectangle Width="4" Height="8" Margin="4,0,0,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Keyboard focus: a dashed cyan marker line 3px outside the control. -->
    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" StrokeDashArray="2 1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
