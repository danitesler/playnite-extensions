<!--
    Backbeat: spacing, focus and the shared comic motifs.
      SlantPlateTemplate   the slanted sticker plate behind buttons, tabs, chips and current items (9 degrees)
      AngledCardTemplate   a comic panel: tilted 1.4 degrees, ink outline, hard offset shadow, never blurred
      HalftoneTemplate     Ben-Day dots fading from the top-right corner (halftone-card.png, white mask)
      DividerTemplate      a hard rule that ends in four beat ticks
    Every template draws through no-desired-size elements, so a GroupBox stays content-sized on the Statistics page.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <Thickness x:Key="ButtonPadding">16,4</Thickness>
    <Thickness x:Key="InputPadding">8,4</Thickness>
    <Thickness x:Key="MenuPadding">0,6</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">18,14,18,18</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <ControlTemplate x:Key="SlantPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Border Background="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <SkewTransform AngleX="-9" />
                        <TranslateTransform X="3" Y="3" />
                    </TransformGroup>
                </Border.RenderTransform>
            </Border>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <SkewTransform AngleX="-9" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="AngledCardTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Border Background="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <SkewTransform AngleY="-1.4" />
                        <TranslateTransform X="6" Y="6" />
                    </TransformGroup>
                </Border.RenderTransform>
            </Border>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <SkewTransform AngleY="-1.4" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HalftoneTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/halftone-card.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" VerticalAlignment="Center" Height="14" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Rectangle Height="3" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Rectangle Width="4" Height="14" Fill="{TemplateBinding Foreground}" />
                <Rectangle Width="4" Height="8" Margin="4,0,0,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
                <Rectangle Width="4" Height="8" Margin="4,0,0,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
                <Rectangle Width="4" Height="8" Margin="4,0,0,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Keyboard focus: a dashed cyan marker line 3px outside the control. -->
    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" StrokeDashArray="2 1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): the orange impact burst with a four-bar level meter cut into it
         (ink bars on a shared baseline), scaled to fit its host (40x40 in the rail, 30x30 in the top bar). Rest: the burst
         sits still, the meter at its resting heights. Hover (IsMouseOver): the bars jump to new heights in a staggered bounce
         (BackEase, 0.28s) and settle back on exit. Open (the menu's ContextMenu.IsOpen on the nearest Border, which is
         PART_ElemMainMenu): the menu is "on beat" at 100 bpm: the burst thumps (scale 1 to 1.09, 0.6s), a white beat ring
         snaps in from outside and fades every beat, and each bar dances on its own period until the menu closes. Every bar
         carries two scales (HoverK, DanceK) and the burst its own (Thump) so hover and open never animate the same
         property. -->
    <ControlTemplate x:Key="LocalBackbeatMenuMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Root" Width="40" Height="40" Background="Transparent" UseLayoutRounding="False">
                <Ellipse x:Name="BeatRing" Width="34" Height="34" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="RingScale" ScaleX="1.3" ScaleY="1.3" /></Ellipse.RenderTransform>
                </Ellipse>
                <Path Data="{DynamicResource IconBurst}" Stretch="Fill" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Path.RenderTransform><ScaleTransform x:Name="Thump" ScaleX="1" ScaleY="1" /></Path.RenderTransform>
                </Path>
                <Canvas Width="40" Height="40" IsHitTestVisible="False">
                    <Rectangle Canvas.Left="10.5" Canvas.Top="18" Width="4" Height="9" Fill="{DynamicResource MainMenuButtonForegroundBrush}" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><TransformGroup><ScaleTransform x:Name="Hover1" ScaleY="1" /><ScaleTransform x:Name="Dance1" ScaleY="1" /></TransformGroup></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Canvas.Left="16" Canvas.Top="12" Width="4" Height="15" Fill="{DynamicResource MainMenuButtonForegroundBrush}" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><TransformGroup><ScaleTransform x:Name="Hover2" ScaleY="1" /><ScaleTransform x:Name="Dance2" ScaleY="1" /></TransformGroup></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Canvas.Left="21.5" Canvas.Top="15" Width="4" Height="12" Fill="{DynamicResource MainMenuButtonForegroundBrush}" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><TransformGroup><ScaleTransform x:Name="Hover3" ScaleY="1" /><ScaleTransform x:Name="Dance3" ScaleY="1" /></TransformGroup></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Canvas.Left="27" Canvas.Top="21" Width="4" Height="6" Fill="{DynamicResource MainMenuButtonForegroundBrush}" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><TransformGroup><ScaleTransform x:Name="Hover4" ScaleY="1" /><ScaleTransform x:Name="Dance4" ScaleY="1" /></TransformGroup></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Grid>
        </Viewbox>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover1" Storyboard.TargetProperty="ScaleY" To="1.9" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Hover2" Storyboard.TargetProperty="ScaleY" To="0.55" BeginTime="0:0:0.04" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Hover3" Storyboard.TargetProperty="ScaleY" To="1.45" BeginTime="0:0:0.08" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Hover4" Storyboard.TargetProperty="ScaleY" To="2.2" BeginTime="0:0:0.12" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Hover1" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Hover2" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Hover3" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Hover4" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Thump" Storyboard.TargetProperty="ScaleX" From="1" To="1.09" Duration="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Thump" Storyboard.TargetProperty="ScaleY" From="1" To="1.09" Duration="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" From="1.3" To="0.95" Duration="0:0:0.6" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" From="1.3" To="0.95" Duration="0:0:0.6" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BeatRing" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:0.6" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="Dance1" Storyboard.TargetProperty="ScaleY" To="1.5" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Dance2" Storyboard.TargetProperty="ScaleY" To="0.5" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Dance3" Storyboard.TargetProperty="ScaleY" To="1.6" Duration="0:0:0.75" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Dance4" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Thump" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Thump" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" To="1.3" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" To="1.3" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BeatRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Dance1" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Dance2" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Dance3" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Dance4" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
