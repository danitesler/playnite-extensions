<!--
    Backbeat: GroupBox as a comic panel (AngledCardTemplate): panel purple, 3px white line, hard ink offset shadow, with a
    halftone patch in the top-right corner and the header on a yellow sticker plate. Content-sized for the Statistics
    page: the card, plate and rule have no desired width and the halftone patch is a fixed 120x66.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Control Template="{DynamicResource AngledCardTemplate}" Background="{DynamicResource ExpanderBackgroundBrush}"
                                 BorderBrush="{DynamicResource FrameBrush}" BorderThickness="3" Foreground="{DynamicResource PanelShadowBrush}" />
                        <Control Template="{DynamicResource HalftoneTemplate}" Foreground="{DynamicResource HeadingMarkerBrush}"
                                 Width="120" Height="66" Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.55" />
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <DockPanel DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                <Grid DockPanel.Dock="Left">
                                    <Control Template="{DynamicResource SlantPlateTemplate}" Background="{DynamicResource HeadingMarkerAltBrush}"
                                             BorderBrush="{DynamicResource PanelShadowBrush}" BorderThickness="2" Foreground="{DynamicResource PanelShadowBrush}" />
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="12,3,12,3"
                                                      TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                      TextElement.FontStyle="Italic"
                                                      TextElement.Foreground="{DynamicResource HeadingForegroundBrush}" />
                                </Grid>
                                <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource HeadingRuleBrush}"
                                         Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="30" />
                            </DockPanel>
                            <ContentPresenter />
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
