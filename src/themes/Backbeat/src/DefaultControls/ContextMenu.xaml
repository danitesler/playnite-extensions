<!--
    Backbeat: ContextMenu. Every menu and dropdown list (the hamburger menu, the top bar dropdowns through TopPanelMenu,
    GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select boxes) is a
    comic panel (LocalComicPanelTemplate, shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and
    CustomControls/FilterSelectionBox.xaml):
    - Panel: the night fill inside a 2px paper line, a hard orange offset shadow 5px down and right (a plate, never a
      DropShadowEffect), the top bar's three slanted print-color tabs (cyan, yellow, orange) riding the top line at the
      left, and a faint cyan halftone in the bottom-left corner. Rows sit 6px inside the line; the shadow takes 5px on the
      right and bottom, so submenus open past it.
    Rows, beat rules and stickers: Menu.xaml. Recipe: docs/themes/menus.md. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalComicPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Rectangle Margin="5,5,0,0" Fill="{DynamicResource TitleSuffixBrush}" />
            <Grid Margin="0,0,5,5">
                <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="2" />
                <Control Width="72" Height="40" Margin="2,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Template="{DynamicResource HalftoneTemplate}" Foreground="{DynamicResource HeadingMarkerBrush}" Opacity="0.22"
                         Focusable="False" IsTabStop="False" />
                <StackPanel Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
                    <Border Width="16" Height="5" Margin="0,0,3,0" Background="{DynamicResource HeadingMarkerBrush}">
                        <Border.RenderTransform><SkewTransform AngleX="-20" /></Border.RenderTransform>
                    </Border>
                    <Border Width="16" Height="5" Margin="0,0,3,0" Background="{DynamicResource GlyphBrush}">
                        <Border.RenderTransform><SkewTransform AngleX="-20" /></Border.RenderTransform>
                    </Border>
                    <Border Width="16" Height="5" Background="{DynamicResource TitleSuffixBrush}">
                        <Border.RenderTransform><SkewTransform AngleX="-20" /></Border.RenderTransform>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="225" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalComicPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="2,7,7,9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
