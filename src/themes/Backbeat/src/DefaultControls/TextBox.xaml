<!--
    Backbeat: TextBox. Ink field, 2px lilac line, white on hover, yellow with keyboard focus; yellow caret. Square, not
    slanted, so text fields stay easy to read. BareTextBox drops the chrome. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LocalBeatFieldTemplate: a comic panel field. A patch of halftone dots fades into the bottom-right corner in lilac
        at rest. Hover: the dots turn paper white. Keyboard focus: the dots turn yellow and a yellow sticker tab with an ink
        outline slaps onto the top-right corner on the beat (scale 0 to 1.2 to 1, tilted 8 degrees, 0.2s).
        State is read from the nearest Control above; no desired size.
    -->
    <ControlTemplate x:Key="LocalBeatFieldTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid Width="54" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.2" Color="#00FFFFFF" />
                        <GradientStop Offset="1" Color="#FFFFFFFF" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
            <Rectangle x:Name="Dots" Fill="{DynamicResource NormalBorderBrush}">
                <Rectangle.OpacityMask>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,5,5" ViewportUnits="Absolute" Viewbox="0,0,5,5" ViewboxUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#00000000" Geometry="M0,0 H5 V5 H0 Z" />
                                <GeometryDrawing Brush="#FF000000"><GeometryDrawing.Geometry><EllipseGeometry Center="2.5,2.5" RadiusX="1.1" RadiusY="1.1" /></GeometryDrawing.Geometry></GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            </Grid>
            <Border x:Name="Sticker" Width="18" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,8,0"
                    Background="{DynamicResource SelectedBorderBrush}" BorderBrush="{DynamicResource PanelShadowBrush}" BorderThickness="1.5"
                    RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="StickerScale" ScaleX="0" ScaleY="0" />
                        <RotateTransform Angle="8" />
                    </TransformGroup>
                </Border.RenderTransform>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <Setter TargetName="Dots" Property="Fill" Value="{DynamicResource InputHoverBorderBrush}" />
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Dots" Property="Fill" Value="{DynamicResource SelectedBorderBrush}" />
                <Setter TargetName="Sticker" Property="Opacity" Value="1" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Slap">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StickerScale" Storyboard.TargetProperty="ScaleX">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="1.2" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StickerScale" Storyboard.TargetProperty="ScaleY">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="1.2" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Slap" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="CaretBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <Control x:Name="FieldOverlay" Template="{DynamicResource LocalBeatFieldTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Border" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BareTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <!-- Its own bare template, so hosts (editable dropdown, search) do not inherit the field's signature. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
