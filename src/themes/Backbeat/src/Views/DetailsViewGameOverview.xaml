<!--
    Backbeat: game page, details view. Generated by art/gen-overviews.mjs; edit the generator, not this file.
    Skeleton (src/themes/AGENTS.md -> Game page): banner (GameBannerHeight, default 340), halftone in its top-right corner;
    spacer x * 150 / 340 (28 with no banner); headline title over a hard ink copy with the actions (Play 150x40, More and Edit
    40x40 icon squares with tooltips, always visible); a slanted white panel cut; screenshots, description and notes on the
    left and the comic-panel metadata card on the right (GameDetailsPaneWidth, 300). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="DetailsViewGameOverview">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DetailsViewGameOverview">
                    <ScrollViewer x:Name="PART_ScrollViewHost" Visibility="Visible" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                        <Grid x:Name="PageRoot" Background="{DynamicResource GameOverviewBackgroundBrush}" UseLayoutRounding="True">
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False" ClipToBounds="True">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.12" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle Width="420" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.85" Fill="{DynamicResource HeadingMarkerAltBrush}"
                                           Height="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 0.3'}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/halftone-wide.png'}" Stretch="Fill" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                            <StackPanel Margin="30,0,34,34">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border x:Name="DetailsBannerSpacer" MinHeight="18">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 150 / 340'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="18" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="18" />
</DataTrigger>
</Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel Margin="0,12,0,16">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Grid Width="150" Height="40">
                                            <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                            <Button x:Name="PART_ButtonContextAction" />
                                        </Grid>
                                        <Button x:Name="PART_ButtonMoreActions" Width="40" Height="40" Padding="0" Margin="10,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                            <ContentControl Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                        <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Margin="10,0,0,0" ToolTip="{DynamicResource LOCEditGame}">
                                            <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>
                                    <DockPanel>
                                        <Image x:Name="PART_ImageIcon" MaxWidth="40" MaxHeight="40" Margin="0,0,12,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLargest}" FontStyle="Italic" TextWrapping="Wrap" Foreground="{DynamicResource TextOutlineBrush}" Margin="3,3,0,0" IsHitTestVisible="False" />
                                            <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLargest}" FontStyle="Italic" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,3,3" />
                                        </Grid>
                                    </DockPanel>
                                </DockPanel>
                                <Path Data="M0,100 L100,0" Stretch="Fill" Height="14" Stroke="{DynamicResource FrameBrush}" StrokeThickness="3" IsHitTestVisible="False" />
                                <Grid Margin="0,16,0,0" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 28 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="28,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<Grid VerticalAlignment="Top" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                        <Control Template="{DynamicResource AngledCardTemplate}" Background="{DynamicResource ExpanderBackgroundBrush}"
                                                 BorderBrush="{DynamicResource FrameBrush}" BorderThickness="3" Foreground="{DynamicResource TitleSuffixBrush}" />
                                        <Control Template="{DynamicResource HalftoneTemplate}" Foreground="{DynamicResource HeadingMarkerBrush}"
                                                 Width="180" Height="100" Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.6" />
                                        <Border Padding="18,16,18,18">
                                            <StackPanel Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch" x:Name="DetailsMetadataContent">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Grid DockPanel.Dock="Left">
                                                        <Control Template="{DynamicResource SlantPlateTemplate}" Background="{DynamicResource TitleSuffixBrush}"
                                                                 BorderBrush="{DynamicResource PanelShadowBrush}" BorderThickness="2" Foreground="{DynamicResource PanelShadowBrush}" />
                                                        <TextBlock Text="{DynamicResource LOCGameDetails}" Style="{DynamicResource HeadingTextBlock}" Margin="12,3,12,3" />
                                                    </Grid>
                                                    <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource HeadingRuleBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <Grid ClipToBounds="True" x:Name="DetailsMetadataViewport">
