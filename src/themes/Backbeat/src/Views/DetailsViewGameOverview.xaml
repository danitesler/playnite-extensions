                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCCriticScore}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                        <Border Grid.Column="1" Margin="8,0,0,0">
                                                                            <TextBlock x:Name="PART_TextCriticScore" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                        </Border>
