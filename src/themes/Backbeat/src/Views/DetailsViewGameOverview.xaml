                                                        </Border>
                                                        <Border x:Name="MetaAbout" Padding="0,12,0,0" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
