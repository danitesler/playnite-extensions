<!--
    Backbeat: sidebar. A 44px ink rail closed by a 3px white line. Main menu on top: an orange impact star with an ink glyph.
    Items: CustomControls/SidebarItem.xaml. A halftone patch rises from the rail's foot, where no item normally sits; it is
    collapsed when the sidebar docks top or bottom. Structure and triggers: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border BorderThickness="0,0,3,0" BorderBrush="{DynamicResource FrameBrush}"
                            Background="{DynamicResource ShellBackgroundBrush}"
                            x:Name="BorderContentHolder" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <Rectangle x:Name="RailDots" Width="44" Height="150" VerticalAlignment="Bottom" HorizontalAlignment="Left" Opacity="0.7"
                                       Fill="{DynamicResource HeadingMarkerBrush}" IsHitTestVisible="False">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/halftone-rail.png'}" Stretch="Fill" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="52" Margin="0,0,0,4"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid Width="40" Height="40">
                                        <Path Data="{DynamicResource IconBurst}" Stretch="Fill" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" />
                                        <ContentControl Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="Margin" Value="0,0,0,4" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="3,0,0,0" TargetName="BorderContentHolder" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0,0,0,3" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailDots" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0,3,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailDots" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
