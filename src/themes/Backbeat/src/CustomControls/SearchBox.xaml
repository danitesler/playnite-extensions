<!--
    Backbeat: SearchBox on a slanted ink plate with a 2px lilac line, white on hover, yellow while typing. Keeps
    PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid Background="Transparent">
                        <Control x:Name="Field" Template="{DynamicResource SlantPlateTemplate}" Background="{DynamicResource InputBackgroundBrush}"
                                 BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Foreground="Transparent" />
                        <ContentControl x:Name="Glyph" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{DynamicResource GlyphBrush}" Margin="11,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" />
                            <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                        <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                 Padding="34,0,30,0" VerticalContentAlignment="Center" />
                        <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,10,0" Cursor="Hand"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ContentControl.Template>
                                <ControlTemplate TargetType="ContentControl">
                                    <Border Background="Transparent">
                                        <ContentPresenter ContentSource="Content" />
                                    </Border>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>

                        <!-- Keep the magnifier visible while Playnite hides its placeholder. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
