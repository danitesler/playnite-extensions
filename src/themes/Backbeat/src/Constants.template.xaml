<!--
    Backbeat: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json); bb-* names live in tokens.css.
    Role rule: yellow plates carry ink text only where the theme draws the text itself. Anything Playnite or an add-on
    may draw inside (menus, lists, sidebar icons, plain buttons) selects in blue, which keeps white glyphs legible.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Impact for comic headlines (ships with Windows), Segoe UI for reading. No font is bundled. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:bb-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:bb-font-heading|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width; applied inside the pane's padding and outline. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: hard corners and 2px ink lines everywhere. -->
    <Thickness x:Key="PopupBorderThickness">2</Thickness>
    <Thickness x:Key="ControlBorderThickness">2</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:bb-radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{bb-paper}}</Color>
    <Color x:Key="TextColorDarker">{{bb-lilac}}</Color>
    <Color x:Key="TextColorDark">{{bb-ink}}</Color>
    <Color x:Key="MainColor">{{bb-panel}}</Color>
    <Color x:Key="MainColorDark">{{bb-plum}}</Color>
    <Color x:Key="HoverColor">{{bb-panel-hi}}</Color>
    <Color x:Key="GlyphColor">{{bb-yellow}}</Color>
    <Color x:Key="HighlightGlyphColor">{{bb-orange}}</Color>
    <Color x:Key="PopupBackgroundColor">{{bb-night}}</Color>
    <Color x:Key="PopupBorderColor">{{bb-paper}}</Color>
    <Color x:Key="BackgroundToneColor">{{bb-night}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{bb-ink}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{bb-lilac-dim}}</Color>
    <Color x:Key="DataChangeNotifColor">{{bb-orange}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{bb-lilac-dim}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{bb-panel}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{bb-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{bb-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{bb-orange}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{bb-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{bb-night}}" />

    <!-- Shell layers -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{bb-night}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{bb-plum}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{bb-plum}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{bb-plum}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{bb-night}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the theme's
         own ArtTint color, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{bb-night}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{bb-orange}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{bb-paper}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{bb-orange}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{bb-ink}}" />
    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{bb-blue}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{bb-panel-hi}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{bb-blue}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{bb-cyan}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{bb-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{bb-paper}}" />
    <!-- Headings: ink words on sticker plates -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{bb-cyan}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{bb-lilac-dim}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{bb-orange}}" />
    <SolidColorBrush x:Key="TextOutlineBrush" Color="{{bb-ink}}" />
    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{bb-paper}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{bb-paper}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{bb-blue}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{bb-blue-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{bb-orange}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{bb-orange-hot}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{bb-cyan}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{bb-cyan}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{bb-blue}}" />
    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{bb-lilac}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{bb-paper}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{bb-paper}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{bb-cyan}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{bb-orange}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{bb-paper}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{bb-lilac-dim}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{bb-lilac-dim}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{bb-lilac}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{bb-paper}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{bb-lilac-dim}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{bb-paper}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{bb-yellow}}" />
    <!-- Library -->
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{bb-cyan}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{bb-paper}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{bb-paper}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{bb-cyan}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{bb-blue}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{bb-lilac}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{bb-paper}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{bb-yellow}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{bb-cyan}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{bb-blue}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{bb-ink}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{bb-ink}}" />
</ResourceDictionary>
