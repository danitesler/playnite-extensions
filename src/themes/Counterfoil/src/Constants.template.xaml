<!--
    Counterfoil: Constants.xaml template (Disco Elysium / FELD Playback film-transcript theme).
    scripts/build-theme.ps1 renders tokens.css placeholders into Constants.xaml.
    Deep smoked 35mm film stock, cool metallic FELD ruler rails, torn chalk-paper selection strips,
    burnt-amber darkroom light-leaks, fiery vermilion Play / Red Check reply slab with Psyche violet oil wash,
    emerald running proof, ochre-gold filter diamond, and four-skill INT/PSY/FYS/MOT register marks.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Barlow Condensed & Barlow Semi Condensed bundled in Typography/; Georgia & Consolas are Windows fonts) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">21</sys:Double>
    <sys:Double x:Key="FontSizeLargest">38</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:cf-body|Georgia}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Barlow Condensed, {{text:cf-heading|Barlow Condensed}}, Bahnschrift SemiCondensed</FontFamily>
    <FontFamily x:Key="UIFontFamily">./Typography/#Barlow Semi Condensed, {{text:cf-ui|Barlow Semi Condensed}}, Bahnschrift SemiCondensed</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:cf-mono|Consolas}}</FontFamily>

    <!-- Game page metadata pane defaults (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: razor-cut 35mm film frames; organic paper/brush silhouettes are supplied by fx opacity masks -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:cf-radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:cf-radius-sm|1}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:cf-radius-lg|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{cf-paper-bright}}</Color>
    <Color x:Key="TextColorDarker">{{cf-dim}}</Color>
    <Color x:Key="TextColorDark">{{cf-ink}}</Color>
    <Color x:Key="MainColor">{{cf-carbon}}</Color>
    <Color x:Key="MainColorDark">{{cf-panel}}</Color>
    <Color x:Key="HoverColor">{{cf-hover}}</Color>
    <Color x:Key="GlyphColor">{{cf-paper}}</Color>
    <Color x:Key="HighlightGlyphColor">{{cf-vermilion-hi}}</Color>
    <Color x:Key="PopupBackgroundColor">{{cf-carbon}}</Color>
    <Color x:Key="PopupBorderColor">{{cf-rail-dark}}</Color>
    <Color x:Key="BackgroundToneColor">{{cf-panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{cf-rule}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{cf-rule}}</Color>
    <Color x:Key="DataChangeNotifColor">{{cf-mot-ochre}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{cf-rule}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{cf-carbon}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{cf-rail}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{cf-carbon}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{cf-well}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{cf-success-hi}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{cf-fys-crimson}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{cf-int-cyan}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{cf-mot-ochre}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{cf-carbon}}" />

    <!-- Surfaces & Chrome -->
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{cf-stock}}" />
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{cf-carbon}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{cf-stock}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{cf-carbon}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{cf-stock}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{cf-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{cf-stock}}" />
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{cf-stock}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{cf-carbon}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{cf-paper}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{cf-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{cf-paper-bright}}" />

    <!-- Theme-local Disco Elysium structural & four-skill attribute accents -->
    <SolidColorBrush x:Key="LocalDarkroomAmberBrush" Color="{{cf-amber}}" />
    <SolidColorBrush x:Key="LocalDarkroomAmberDeepBrush" Color="{{cf-amber-deep}}" />
    <SolidColorBrush x:Key="LocalFilmRailBrush" Color="{{cf-rail}}" />
    <SolidColorBrush x:Key="LocalFilmRailBrightBrush" Color="{{cf-rail-bright}}" />
    <SolidColorBrush x:Key="LocalVermilionBrush" Color="{{cf-vermilion}}" />
    <SolidColorBrush x:Key="LocalIntCyanBrush" Color="{{cf-int-cyan}}" />
    <SolidColorBrush x:Key="LocalPsyVioletBrush" Color="{{cf-psy-violet}}" />
    <SolidColorBrush x:Key="LocalFysCrimsonBrush" Color="{{cf-fys-crimson}}" />
    <SolidColorBrush x:Key="LocalMotOchreBrush" Color="{{cf-mot-ochre}}" />
    <SolidColorBrush x:Key="LocalRunningHighlightBrush" Color="{{cf-success-hi}}" />
    <SolidColorBrush x:Key="LocalWellBrush" Color="{{cf-well}}" />

    <!-- Selection (Torn Chalk Paper Tape) & Dedicated Running Proof (Check Success Emerald) -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{cf-paper}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{cf-ink}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{cf-paper-dim}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{cf-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{cf-paper}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{cf-paper}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{cf-rule}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{cf-success}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{cf-psy-violet}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{cf-danger}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{cf-white}}" />

    <!-- Buttons: Smoked Film Plates; Play / Primary = Fiery Vermilion Dialogue Reply Brush Slab -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{cf-white}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{cf-paper-dim}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{cf-rail-dark}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{cf-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{cf-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{cf-vermilion}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{cf-vermilion-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{cf-vermilion-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{cf-vermilion-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{cf-white}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{cf-psy-violet}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{cf-carbon}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{cf-rail-dark}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{cf-hover}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{cf-pressed}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{cf-paper}}" />

    <!-- Inputs & Controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{cf-well}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{cf-panel}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{cf-rail-dark}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{cf-rail-bright}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{cf-rail}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{cf-rail}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{cf-vermilion-hi}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{cf-well}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{cf-vermilion}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{cf-paper}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{cf-white}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{cf-rail-dark}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{cf-rail}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{cf-paper}}" />

    <!-- Tabs, Covers, Top Bar, Sidebar, Metadata -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{cf-dim}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{cf-white}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{cf-paper}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{cf-vermilion}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{cf-void}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{cf-rail-bright}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{cf-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{cf-paper}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{cf-well}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{cf-panel}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{cf-rule}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{cf-amber}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{cf-rail-dark}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{cf-dim}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{cf-ink}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{cf-amber}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{cf-panel}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{cf-paper}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{cf-int-cyan}}" />

    <!-- Frames, Captions & Architectural Accents -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{cf-rail}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{cf-rule}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{cf-rail-dark}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{cf-void}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{cf-paper-bright}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{cf-amber}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{cf-amber-deep}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{cf-rule}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{cf-paper}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{cf-dim}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{cf-rail-bright}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{cf-void}}" />
</ResourceDictionary>
