<!--
    Counterfoil: DefaultControls/ContextMenu.xaml.
    Signature menu panel (shared across ContextMenu, TopPanelMenu, submenus, ComboBox popups & multi-select lists):
    30px rows on dark smoked film stock (#111415) with faint 35mm emulsion grain, flanked on its left edge by a 6px
    metallic FELD film-strip ruler rail (film-rail.png), topped by a 2px darkroom-amber lead rule and 1px metallic rim.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="{DynamicResource PopupBorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <!-- Subtle 35mm photographic emulsion grain -->
            <Rectangle Margin="1" Fill="{DynamicResource LocalFilmRailBrightBrush}" Opacity="0.045"
                       OpacityMask="{DynamicResource LocalFilmGrainMaskBrush}" />
            <!-- Subtle darkroom amber header wash at top of film strip -->
            <Rectangle VerticalAlignment="Top" Height="22" Margin="1,1,1,0"
                       Fill="{DynamicResource LocalDarkroomAmberBrush}" Opacity="0.16">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <!-- Top 2px darkroom-amber to silver exposure rule -->
            <Rectangle VerticalAlignment="Top" Height="2" Margin="1,1,1,0"
                       Fill="{DynamicResource LocalDarkroomAmberBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#AA000000" Offset="0.55" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <!-- Vertical 6px metallic FELD film-strip ruler rail along left edge -->
            <Control Width="6" HorizontalAlignment="Left" Margin="1,3,0,1"
                     Template="{DynamicResource LocalFilmRailTemplate}"
                     Foreground="{DynamicResource LocalFilmRailBrush}" Opacity="0.72"
                     Focusable="False" IsTabStop="False" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="216" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True" MinWidth="{TemplateBinding MinWidth}">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="8,5,4,5">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
