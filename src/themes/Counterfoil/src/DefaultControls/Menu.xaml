<!--
    Counterfoil: DefaultControls/Menu.xaml.
    Signature menu levers (docs/themes/menus.md):
    - Panel: Smoked 35mm film strip with emulsion grain, 6px left metallic FELD film-strip ruler rail & amber lead rule (LocalMenuPanelTemplate).
    - Highlight: Full-width torn photo-paper tape strip (LocalPaperTapeTemplate) slides in 5px from left (120ms CubicEase out)
      with 3px fiery vermilion left bar & 1px vermilion underline; label, icon (TargetName="Icon"), arrow & shortcut invert to jet-black ink.
    - Group break: 10px notched film-index square + hollow diamond (◇) opening a 1px metallic film hairline.
    - Shortcuts: Plain Consolas monospace right-aligned in dim film rail grey, inverting to jet-black ink on torn-paper highlight.
    - Marked rows: Checked rows draw a filled diamond (◆) inside a 14x14 hairline square frame;
      Exit (InputGestureText="Alt+Q") wears crimson text & left pip at rest, flipping to a torn DangerBrush painterly brush slab with crisp white ink.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group break (<= 12px): notched film-index square + hollow registration diamond opening a 1px hairline -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" Margin="6,0,8,0" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Rectangle Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{DynamicResource LocalFilmRailBrush}" Opacity="0.8" />
                        <Path Data="M4,1 L7,4.5 L4,8 L1,4.5 Z" Stroke="{DynamicResource LocalFilmRailBrush}" StrokeThickness="1"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0" />
                        <Rectangle Height="1" Margin="18,0,0,0" VerticalAlignment="Center"
                                   Fill="{DynamicResource MenuSeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain submenu row (30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="Root" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated torn photo-paper highlight plate -->
            <Grid x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HoverShift" X="-5" />
                </Grid.RenderTransform>
                <Control Template="{DynamicResource LocalPaperTapeTemplate}"
                         Background="{DynamicResource MenuItemHoverBrush}" Focusable="False" IsTabStop="False" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource LocalVermilionBrush}" />
                <Rectangle Height="1" VerticalAlignment="Bottom" Margin="3,0,8,0" Fill="{DynamicResource LocalVermilionBrush}" Opacity="0.85" />
            </Grid>

            <!-- Exit danger crimson rest pip + torn crimson highlight slab (exact same tape footprint so nothing peeks behind) -->
            <Rectangle x:Name="ExitRestPip" Width="2" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Visibility="Collapsed" IsHitTestVisible="False" Fill="{DynamicResource DangerBrush}" />
            <Grid x:Name="ExitPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ExitShift" X="-5" />
                </Grid.RenderTransform>
                <Control Template="{DynamicResource LocalPaperTapeTemplate}"
                         Background="{DynamicResource DangerBrush}" Focusable="False" IsTabStop="False" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource DangerForegroundBrush}" Opacity="0.85" />
            </Grid>

            <Grid Margin="6,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <!-- Fixed 26px leading icon / check column (dark slide socket pops white PNG icons on bright torn paper) -->
                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="IconSocket" Width="20" Height="20" Visibility="Collapsed" IsHitTestVisible="False"
                            Background="{DynamicResource ShellBackgroundBrush}"
                            BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                    <ContentPresenter x:Name="Icon" Width="16" Height="16" ContentSource="Icon"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource GlyphBrush}" />
                    <Grid x:Name="CheckMark" Width="14" Height="14" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border x:Name="CheckFrame" BorderBrush="{DynamicResource LocalFilmRailBrush}" BorderThickness="1"
                                Background="{DynamicResource LocalWellBrush}" />
                        <Path x:Name="CheckDiamond" Width="8" Height="8" Stretch="Fill"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M4,0 L8,4 L4,8 L0,4 Z" Fill="{DynamicResource SelectedBrush}" />
                    </Grid>
                </Grid>

                <!-- Label (plain * column so shortcuts & arrows stay right-aligned) -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" Margin="4,0,12,0"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  TextElement.FontFamily="{DynamicResource UIFontFamily}"
                                  TextElement.FontSize="{DynamicResource FontSize}"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Plain Consolas monospace shortcut -->
                <TextBlock x:Name="ShortcutText" Grid.Column="2" Margin="6,0,2,0"
                           Text="{TemplateBinding InputGestureText}"
                           FontFamily="{DynamicResource MonospaceFontFamily}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextBrushDarker}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" />
                <Setter TargetName="ExitRestPip" Property="Visibility" Value="Visible" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource NegativeRatingBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ExitRestPip" Property="Visibility" Value="Collapsed" />
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="ExitHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExitPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="ExitPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="ExitShift" Storyboard.TargetProperty="X" From="-5" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="ExitHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="ExitPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="ExitShift" Storyboard.TargetProperty="X" To="-5" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExitPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="IconSocket" Property="Visibility" Value="Visible" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="CheckFrame" Property="BorderBrush" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="CheckFrame" Property="Background" Value="Transparent" />
                <Setter TargetName="CheckDiamond" Property="Fill" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="RowHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="HoverShift" Storyboard.TargetProperty="X" From="-5" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="RowHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="HoverShift" Storyboard.TargetProperty="X" To="-5" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconSocket" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="IconSocket" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- Keep Exit's crimson styling dominant over the standard IsHighlighted trigger -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconSocket" Property="Visibility" Value="Collapsed" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Submenu header row (30px) + child Popup repeating LocalMenuPanelTemplate -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="Root" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated torn photo-paper highlight plate -->
            <Grid x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HoverShift" X="-5" />
                </Grid.RenderTransform>
                <Control Template="{DynamicResource LocalPaperTapeTemplate}"
                         Background="{DynamicResource MenuItemHoverBrush}" Focusable="False" IsTabStop="False" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource LocalVermilionBrush}" />
                <Rectangle Height="1" VerticalAlignment="Bottom" Margin="3,0,8,0" Fill="{DynamicResource LocalVermilionBrush}" Opacity="0.85" />
            </Grid>

            <!-- Held plate while submenu is open (never flickers when crossing into child popup) -->
            <Grid x:Name="OpenPlate" Visibility="Collapsed" IsHitTestVisible="False">
                <Control Template="{DynamicResource LocalPaperTapeTemplate}"
                         Background="{DynamicResource MenuItemHoverBrush}" Focusable="False" IsTabStop="False" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource LocalVermilionBrush}" />
                <Rectangle Height="1" VerticalAlignment="Bottom" Margin="3,0,8,0" Fill="{DynamicResource LocalVermilionBrush}" Opacity="0.85" />
            </Grid>

            <Grid Margin="6,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="IconSocket" Width="20" Height="20" Visibility="Collapsed" IsHitTestVisible="False"
                            Background="{DynamicResource ShellBackgroundBrush}"
                            BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                    <ContentPresenter x:Name="Icon" Width="16" Height="16" ContentSource="Icon"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource GlyphBrush}" />
                </Grid>

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" Margin="4,0,12,0"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  TextElement.FontFamily="{DynamicResource UIFontFamily}"
                                  TextElement.FontSize="{DynamicResource FontSize}"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <ContentControl x:Name="SubmenuArrow" Grid.Column="3" Width="10" Height="10"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource TextBrushDarker}" Focusable="False" IsHitTestVisible="False" />
            </Grid>

            <Popup x:Name="Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-5"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade">
                <Grid MinWidth="208" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Margin="8,5,4,5">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="IconSocket" Property="Visibility" Value="Visible" />
                <Setter TargetName="SubmenuArrow" Property="Foreground" Value="{DynamicResource LocalVermilionBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="HeaderHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="HoverShift" Storyboard.TargetProperty="X" From="-5" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="HeaderHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="HoverShift" Storyboard.TargetProperty="X" To="-5" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconSocket" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="SubmenuArrow" Property="Foreground" Value="{DynamicResource LocalVermilionBrush}" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconSocket" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UIFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
