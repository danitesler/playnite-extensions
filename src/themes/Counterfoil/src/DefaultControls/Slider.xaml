<!--
    Counterfoil: DefaultControls/Slider.xaml.
    Directly modeled on Disco Elysium's Options sliders (TEXT SIZE, GAMMA CORRECTION, VOLUME):
    crisp horizontal hairline track flanked on BOTH ends by curved parenthesis end-caps "(" and ")",
    and an open bullseye ring thumb (⊙) with fine horizontal cross-bisector ticks that illuminates on hover/drag.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SliderTrackButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderRangeButton" TargetType="RepeatButton" BasedOn="{StaticResource SliderTrackButton}" />

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Outer open FELD optical ring -->
                        <Ellipse x:Name="Ring" Width="13" Height="13"
                                 Fill="{DynamicResource ShellBackgroundBrush}"
                                 Stroke="{DynamicResource SliderThumbBackgroundBrush}" StrokeThickness="1.35" />
                        <!-- Inner center bullseye dot -->
                        <Ellipse x:Name="CenterDot" Width="4" Height="4"
                                 Fill="{DynamicResource SliderThumbBackgroundBrush}" />
                        <!-- Fine horizontal bisector hairline through the ring (Options slider detail) -->
                        <Rectangle x:Name="Bisector" Height="1" Width="16" VerticalAlignment="Center"
                                   Fill="{DynamicResource SliderThumbBackgroundBrush}" Opacity="0.7" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource SliderThumbHoverBorderBrush}" />
                            <Setter TargetName="CenterDot" Property="Fill" Value="{DynamicResource SliderThumbHoverBorderBrush}" />
                            <Setter TargetName="Bisector" Property="Fill" Value="{DynamicResource SliderThumbHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource LocalVermilionBrush}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource SelectedHoverBrush}" />
                            <Setter TargetName="CenterDot" Property="Fill" Value="{DynamicResource SelectedHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="LocalHorizontalSlider" TargetType="{x:Type Slider}">
        <Grid MinHeight="22" SnapsToDevicePixels="True">
            <!-- Left curved parenthesis end-cap "(" -->
            <Path Data="M5,1 C1,4 1,10 5,13" Stroke="{DynamicResource SliderTrackBrush}" StrokeThickness="1.2"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" IsHitTestVisible="False" />
            <!-- Right curved parenthesis end-cap ")" -->
            <Path Data="M1,1 C5,4 5,10 1,13" Stroke="{DynamicResource SliderTrackBrush}" StrokeThickness="1.2"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0" IsHitTestVisible="False" />

            <!-- Crisp thin horizontal wire track between the parentheses -->
            <Border x:Name="TrackLine" Height="1.5" Margin="6,0" VerticalAlignment="Center"
                    Background="{DynamicResource SliderTrackBrush}" IsHitTestVisible="False" />

            <Track x:Name="PART_Track" Margin="6,0">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderRangeButton}" Command="Slider.DecreaseLarge">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="RepeatButton">
                                <Grid Background="Transparent">
                                    <Rectangle Height="2" VerticalAlignment="Center" Fill="{DynamicResource SelectedBrush}" />
                                </Grid>
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SliderThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderTrackButton}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalVerticalSlider" TargetType="{x:Type Slider}">
        <Grid MinWidth="22" SnapsToDevicePixels="True">
            <Border Width="1.5" Margin="0,6" HorizontalAlignment="Center"
                    Background="{DynamicResource SliderTrackBrush}" IsHitTestVisible="False" />
            <Track x:Name="PART_Track" Margin="0,6">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderRangeButton}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SliderThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderTrackButton}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template" Value="{StaticResource LocalHorizontalSlider}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource LocalVerticalSlider}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerHeight" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerDarken" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
