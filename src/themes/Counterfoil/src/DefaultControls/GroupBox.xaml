<!-- Counterfoil: DefaultControls/GroupBox.xaml.
     Disco Elysium torn photo-paper header strip (LocalTapeTabTemplate) with jet-black condensed title + trailing film rule. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Margin" Value="0,6,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel SnapsToDevicePixels="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Control Template="{DynamicResource LocalTapeTabTemplate}"
                                         Background="{DynamicResource SelectedBrush}"
                                         Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  Margin="10,3,14,4" VerticalAlignment="Center"
                                                  TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                  TextElement.FontSize="{DynamicResource FontSizeLarge}"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.Foreground="{DynamicResource SelectedForegroundBrush}" />
                            </Grid>
                            <Control Template="{DynamicResource DividerTemplate}"
                                     Foreground="{DynamicResource LocalFilmRailBrush}" VerticalAlignment="Center"
                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        </DockPanel>
                        <Border Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
