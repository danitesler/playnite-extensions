<!-- Counterfoil: shared spacing, focus, and FELD Playback / Disco Elysium FX sprite templates.
     Every fx PNG is a white alpha mask recolored dynamically via Fill brushes + OpacityMask,
     so ThemeModifier recolors torn paper strips, painterly brush bars, film rails, emulsion grain, and darkroom leaks. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Shared component spacing -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">8,4</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,4</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,4</Thickness>
    <Thickness x:Key="GroupBoxPadding">16,12,16,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0</Thickness>
    <Thickness x:Key="TooltipPadding">10,5</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">260</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Shared ImageBrush FX opacity masks (one resource per sprite, never allocated inline per control) -->
    <ImageBrush x:Key="LocalPaperTapeMaskBrush" ImageSource="{ThemeFile 'Images/fx/paper-tape.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalTapeTabMaskBrush" ImageSource="{ThemeFile 'Images/fx/tape-tab.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalBrushBarMaskBrush" ImageSource="{ThemeFile 'Images/fx/brush-bar.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalFilmRailMaskBrush" ImageSource="{ThemeFile 'Images/fx/film-rail.png'}"
                TileMode="Tile" Viewport="0,0,18,256" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalFilmRailHMaskBrush" ImageSource="{ThemeFile 'Images/fx/film-rail-h.png'}"
                TileMode="Tile" Viewport="0,0,256,12" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalFilmGrainMaskBrush" ImageSource="{ThemeFile 'Images/fx/film-grain.png'}"
                TileMode="Tile" Viewport="0,0,192,192" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalOilWashMaskBrush" ImageSource="{ThemeFile 'Images/fx/oil-wash.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalTornFrameMaskBrush" ImageSource="{ThemeFile 'Images/fx/torn-frame.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalDarkroomLeakMaskBrush" ImageSource="{ThemeFile 'Images/fx/darkroom-leak.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalHalftoneCornerMaskBrush" ImageSource="{ThemeFile 'Images/fx/halftone-corner.png'}" Stretch="Fill" />

    <!-- Segmented 35mm sprocket tick mask for launching progress bars -->
    <DrawingBrush x:Key="LocalSprocketSegmentsMask" Viewbox="0,0,8,4" ViewboxUnits="Absolute"
                  TileMode="Tile" Viewport="0,0,8,4" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="White" Geometry="M0,0 H6 V4 H0 Z" />
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Full-width torn photo-paper tape plate (active game row, active menu row, Options active bar) -->
    <ControlTemplate x:Key="LocalPaperTapeTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}" OpacityMask="{DynamicResource LocalPaperTapeMaskBrush}" />
            <Rectangle Fill="{DynamicResource TextShadowBrush}" Opacity="0.06" OpacityMask="{DynamicResource LocalFilmGrainMaskBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Compact torn photo-paper header/tab plate (SETTINGS, INVENTORY, SCREENSHOTS, DETAILS, active view switch) -->
    <ControlTemplate x:Key="LocalTapeTabTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}" OpacityMask="{DynamicResource LocalTapeTabMaskBrush}" />
            <Rectangle Fill="{DynamicResource TextShadowBrush}" Opacity="0.05" OpacityMask="{DynamicResource LocalFilmGrainMaskBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Painterly oil-brush dialogue reply / Play / Danger slab -->
    <ControlTemplate x:Key="LocalBrushBarTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}" OpacityMask="{DynamicResource LocalBrushBarMaskBrush}" />
            <Rectangle Fill="{TemplateBinding BorderBrush}" Opacity="0.28" OpacityMask="{DynamicResource LocalOilWashMaskBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Solid brush-bar silhouette (for RunningScan / RunningBreath so masks multiply cleanly without double oil wash) -->
    <ControlTemplate x:Key="LocalBrushSilhouetteTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Background}" OpacityMask="{DynamicResource LocalBrushBarMaskBrush}" IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Vertical FELD 35mm film-strip rail (left/right edges of Sidebar, Metadata, Menus, Settings nav) -->
    <ControlTemplate x:Key="LocalFilmRailTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalFilmRailMaskBrush}" IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Horizontal FELD 35mm film-strip ruler rail (under Hero banner, Top bar foot, Character Sheet top) -->
    <ControlTemplate x:Key="LocalFilmRailHTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalFilmRailHMaskBrush}" IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Four-skill INT / PSY / FYS / MOT micro-stripe rule (Inventory & Character Sheet accent bar) -->
    <ControlTemplate x:Key="LocalAttributeBarTemplate" TargetType="Control">
        <UniformGrid Columns="4" Height="2" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{DynamicResource LocalIntCyanBrush}" Margin="0,0,2,0" />
            <Rectangle Fill="{DynamicResource LocalPsyVioletBrush}" Margin="0,0,2,0" />
            <Rectangle Fill="{DynamicResource LocalFysCrimsonBrush}" Margin="0,0,2,0" />
            <Rectangle Fill="{DynamicResource LocalMotOchreBrush}" />
        </UniformGrid>
    </ControlTemplate>

    <!-- Weathered portrait / cover card frame (Skill Cards, Game Covers, Screenshots) -->
    <ControlTemplate x:Key="LocalTornFrameTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalTornFrameMaskBrush}" IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Film-strip section divider with hollow registration diamond -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="10" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Data="M4,1 L7,5 L4,9 L1,5 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" />
            <Rectangle Height="1" Margin="12,0,0,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0.65" />
        </Grid>
    </ControlTemplate>

    <!-- Crisp photographic contact-sheet corner brackets (FocusVisual, covers, frames) -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" Opacity="0.45" />
            <Path Data="M0,10 V0 H10" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 H10 V10" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 V10 H10" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M0,10 H10 V0" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <!-- Counterfoil folded-film brand mark -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource IconMainMenu}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Subtle 35mm emulsion grain + corner halftone backdrop (hidden when window background art is enabled) -->
    <Style x:Key="LocalFilmBackdropOverlay" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Rectangle Fill="{DynamicResource LocalFilmRailBrightBrush}" Opacity="0.045"
                                   OpacityMask="{DynamicResource LocalFilmGrainMaskBrush}" />
                        <Rectangle Width="240" Height="180" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource LocalDarkroomAmberBrush}" Opacity="0.11"
                                   OpacityMask="{DynamicResource LocalHalftoneCornerMaskBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Blank FELD film frame empty state (shown when no game is selected) -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid Background="Transparent" Margin="28" SnapsToDevicePixels="True">
            <Border MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                <Grid ClipToBounds="True">
                    <Rectangle Fill="{DynamicResource LocalFilmRailBrightBrush}" Opacity="0.05"
                               OpacityMask="{DynamicResource LocalFilmGrainMaskBrush}" IsHitTestVisible="False" />
                    <Rectangle Width="180" Height="140" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Fill="{DynamicResource LocalDarkroomAmberBrush}" Opacity="0.14"
                               OpacityMask="{DynamicResource LocalHalftoneCornerMaskBrush}" IsHitTestVisible="False" />
                    <Control Width="12" HorizontalAlignment="Left" Template="{DynamicResource LocalFilmRailTemplate}"
                             Foreground="{DynamicResource LocalFilmRailBrush}" Opacity="0.7" Focusable="False" IsTabStop="False" />
                    <Control Width="12" HorizontalAlignment="Right" Template="{DynamicResource LocalFilmRailTemplate}"
                             Foreground="{DynamicResource LocalFilmRailBrush}" Opacity="0.7" Focusable="False" IsTabStop="False"
                             RenderTransformOrigin="0.5,0.5">
                        <Control.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Control.RenderTransform>
                    </Control>
                    <StackPanel Margin="36,28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="54" Height="54" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border Background="{DynamicResource LocalWellBrush}"
                                    BorderBrush="{DynamicResource LocalFilmRailBrush}" BorderThickness="1" />
                            <Control Template="{DynamicResource CornerMarksTemplate}"
                                     Foreground="{DynamicResource SelectedBrush}" Margin="-3" Focusable="False" IsTabStop="False" />
                            <Control Width="26" Height="26" Template="{DynamicResource BrandMarkTemplate}"
                                     Foreground="{DynamicResource LocalVermilionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Focusable="False" IsTabStop="False" />
                        </Grid>
                        <Control Width="120" HorizontalAlignment="Center" Margin="0,0,0,12"
                                 Template="{DynamicResource LocalAttributeBarTemplate}" Focusable="False" IsTabStop="False" />
                        <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                   FontFamily="{DynamicResource HeadingFontFamily}"
                                   FontSize="{DynamicResource FontSizeLarger}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Contact-sheet loading skeleton while SteamScreenshots populates -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Height="200" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                <Grid>
                    <Control Height="8" VerticalAlignment="Bottom" Template="{DynamicResource LocalFilmRailHTemplate}"
                             Foreground="{DynamicResource LocalFilmRailBrush}" Opacity="0.45" Focusable="False" IsTabStop="False" />
                    <Control Margin="10" Template="{DynamicResource CornerMarksTemplate}"
                             Foreground="{DynamicResource LocalFilmRailBrush}" Opacity="0.55" Focusable="False" IsTabStop="False" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65">
                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Fill="{DynamicResource LocalIntCyanBrush}" />
                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Margin="8,0,0,0" Fill="{DynamicResource LocalPsyVioletBrush}" />
                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Margin="8,0,0,0" Fill="{DynamicResource LocalFysCrimsonBrush}" />
                        <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Margin="8,0,0,0" Fill="{DynamicResource LocalMotOchreBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <UniformGrid Columns="4">
                <Border Height="48" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.85" />
                <Border Height="48" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.72" />
                <Border Height="48" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.85" />
                <Border Height="48" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.72" />
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- Read-only Notes field on Game Overview -->
    <Style x:Key="LocalNotesTextBox" TargetType="TextBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource LocalDarkroomAmberBrush}" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Condensed uppercase section/panel heading style -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-2" Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a 35mm film frame, perforations along its top and bottom edges and three transcript lines inside. Hover: the film advances one sprocket pitch (perforations slide left, eased). Open (ContextMenu.IsOpen of the nearest Border): four skill pips under the frame (psyche violet, vermilion, motorics ochre, amber) take turns lighting in a rolling check until the menu closes. -->
    <ControlTemplate x:Key="LocalCounterfoilMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="26" Height="22">
                    <Rectangle Canvas.Left="1" Canvas.Top="3" Width="24" Height="16" RadiusX="1" RadiusY="1" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" />
                    <Canvas Canvas.Left="2" Canvas.Top="0" Width="22" Height="22" ClipToBounds="True">
                        <Canvas Width="40" Height="22">
                            <Canvas.RenderTransform><TranslateTransform x:Name="Advance" X="0" /></Canvas.RenderTransform>
                            <Rectangle Canvas.Left="1" Canvas.Top="4.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="4.6" Canvas.Top="4.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="8.2" Canvas.Top="4.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="11.8" Canvas.Top="4.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="15.4" Canvas.Top="4.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="19" Canvas.Top="4.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="22.6" Canvas.Top="4.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="26.2" Canvas.Top="4.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="29.8" Canvas.Top="4.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" />
                            <Rectangle Canvas.Left="1" Canvas.Top="16.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="4.6" Canvas.Top="16.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="8.2" Canvas.Top="16.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="11.8" Canvas.Top="16.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="15.4" Canvas.Top="16.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="19" Canvas.Top="16.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="22.6" Canvas.Top="16.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="26.2" Canvas.Top="16.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="29.8" Canvas.Top="16.2" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" />
                        </Canvas>
                    </Canvas>
                    <Rectangle Canvas.Left="6" Canvas.Top="10.2" Width="14" Height="1.2" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="6" Canvas.Top="12.9" Width="10" Height="1.2" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="6" Canvas.Top="15.6" Width="13" Height="1.2" Fill="{TemplateBinding Foreground}" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Path x:Name="PipA" Data="M7,21.8 L8.6,23.4 L7,25 L5.4,23.4Z" Fill="{DynamicResource LocalPsyVioletBrush}" Opacity="0" /><Path x:Name="PipB" Data="M11,21.8 L12.6,23.4 L11,25 L9.4,23.4Z" Fill="{DynamicResource LocalVermilionBrush}" Opacity="0" /><Path x:Name="PipC" Data="M15,21.8 L16.6,23.4 L15,25 L13.4,23.4Z" Fill="{DynamicResource LocalMotOchreBrush}" Opacity="0" /><Path x:Name="PipD" Data="M19,21.8 L20.6,23.4 L19,25 L17.4,23.4Z" Fill="{DynamicResource LocalDarkroomAmberBrush}" Opacity="0" />
                </Canvas>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Advance" Storyboard.TargetProperty="X" To="-3.6" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Advance" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PipA" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PipA" Storyboard.TargetProperty="Opacity" From="0.15" To="1" BeginTime="0:0:0.3" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PipB" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PipB" Storyboard.TargetProperty="Opacity" From="0.15" To="1" BeginTime="0:0:0.7" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PipC" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PipC" Storyboard.TargetProperty="Opacity" From="0.15" To="1" BeginTime="0:0:1.1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PipD" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PipD" Storyboard.TargetProperty="Opacity" From="0.15" To="1" BeginTime="0:0:1.5" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PipA" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PipB" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PipC" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PipD" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
