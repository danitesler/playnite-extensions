<!--
    Counterfoil: DerivedStyles/TextBlockGameScore.xaml.
    Directly modeled on Disco Elysium's Character Sheet Skill Card punched square score stamp (e.g. LOGIC [4], PERCEPTION [3]):
    crisp torn-paper badge with bold monospace numeral in Positive (emerald), Mixed (INT cyan), or Negative (FYS crimson) rating.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="TextBlockGameScore" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource MonospaceFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
        <Setter Property="Padding" Value="7,1,7,1" />
        <Setter Property="Margin" Value="0,1,0,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Positive}">
                <Setter Property="Background" Value="{DynamicResource PositiveRatingBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Mixed}">
                <Setter Property="Background" Value="{DynamicResource MixedRatingBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Negative}">
                <Setter Property="Background" Value="{DynamicResource NegativeRatingBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.None}">
                <Setter Property="Background" Value="{DynamicResource NormalBrushDark}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
