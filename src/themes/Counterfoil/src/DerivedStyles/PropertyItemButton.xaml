<!--
    Counterfoil: DerivedStyles/PropertyItemButton.xaml.
    Default: underlined dialogue/thought reference link turning fiery vermilion on hover.
    Tag="Chip" (Genres, Platforms, Categories, Features, Tags): compact smoked film slip with 1px rail rim
    and a hollow skill diamond (◇), inverting cleanly to chalk photo-paper with black ink on hover.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PropertyItemButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="ChipPlate" Visibility="Collapsed"
                                Background="{DynamicResource PropertyItemBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                Padding="7,2,8,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ChipDiamond" Data="M3,0 L6,3 L3,6 L0,3 Z"
                                      Stroke="{DynamicResource LocalFilmRailBrush}" StrokeThickness="1"
                                      VerticalAlignment="Center" Margin="0,0,5,0" IsHitTestVisible="False" />
                                <ContentPresenter x:Name="ChipContent" VerticalAlignment="Center"
                                                  TextElement.FontFamily="{DynamicResource UIFontFamily}"
                                                  TextElement.FontSize="{DynamicResource FontSizeSmall}"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="LinkHost">
                            <ContentPresenter x:Name="LinkContent" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Rectangle x:Name="LinkUnderline" Height="1" Margin="0,1,0,0"
                                       Fill="{DynamicResource LocalFilmRailBrush}" Opacity="0.55" IsHitTestVisible="False" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                            <Setter TargetName="LinkHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ChipPlate" Property="Visibility" Value="Visible" />
                            <Setter Property="Margin" Value="0,0,5,5" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" />
                            <Setter TargetName="LinkUnderline" Property="Fill" Value="{DynamicResource HighlightGlyphBrush}" />
                            <Setter TargetName="LinkUnderline" Property="Opacity" Value="1" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ChipPlate" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                            <Setter TargetName="ChipPlate" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            <Setter TargetName="ChipDiamond" Property="Fill" Value="{DynamicResource LocalVermilionBrush}" />
                            <Setter TargetName="ChipDiamond" Property="Stroke" Value="{DynamicResource LocalVermilionBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
