<!--
    Counterfoil: DerivedStyles/StandardWindowStyle.xaml (Settings, Add-ons, ThemeModifier, Game Editor, every dialog).
    46px dark brushed-film title ribbon echoing Disco Elysium's SETTINGS | CONTROLS header:
    burnt-amber darkroom glow fading left-to-right, Counterfoil mark, PART_TextTitle stamped directly on a torn
    photo-paper tape strip (LocalTapeTabTemplate) with jet-black condensed text (zero stray title text),
    four-skill micro-dots, and a horizontal FELD film ruler along the bottom edge.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="46" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource LocalFilmRailBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Control Style="{DynamicResource LocalFilmBackdropOverlay}" Margin="0,46,0,0" />
                                <ContentPresenter Margin="0,46,0,0" />

                                <!-- 46px Dark Brushed-Film Title Ribbon (echoing Disco Elysium SETTINGS bar) -->
                                <Grid Height="46" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}"
                                      ClipToBounds="True" SnapsToDevicePixels="True">
                                    <!-- Warm burnt-amber darkroom light-leak fading across the left half -->
                                    <Rectangle Width="360" HorizontalAlignment="Left" IsHitTestVisible="False"
                                               Fill="{DynamicResource LocalDarkroomAmberBrush}" Opacity="0.34">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF000000" Offset="0" />
                                                <GradientStop Color="#66000000" Offset="0.55" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <!-- Subtle emulsion grain -->
                                    <Rectangle IsHitTestVisible="False" Opacity="0.05"
                                               Fill="{DynamicResource LocalFilmRailBrightBrush}"
                                               OpacityMask="{DynamicResource LocalFilmGrainMaskBrush}" />

                                    <!-- Horizontal FELD film ruler closing the title band -->
                                    <Control Height="6" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0.45"
                                             Template="{DynamicResource LocalFilmRailHTemplate}"
                                             Foreground="{DynamicResource LocalFilmRailBrush}" Focusable="False" IsTabStop="False" />
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource PanelSeparatorBrush}" IsHitTestVisible="False" />

                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,2">
                                            <!-- Folded Counterfoil emblem -->
                                            <Control Width="18" Height="18" Margin="0,0,10,0"
                                                     Template="{DynamicResource BrandMarkTemplate}"
                                                     Foreground="{DynamicResource LocalVermilionBrush}"
                                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False" />

                                            <!-- PART_TextTitle stamped directly on Disco Elysium's torn photo-paper tape strip -->
                                            <Grid VerticalAlignment="Center">
                                                <Control Template="{DynamicResource LocalTapeTabTemplate}"
                                                         Background="{DynamicResource SelectedBrush}"
                                                         Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                                <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                           VerticalAlignment="Center" Padding="12,3,16,4"
                                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                                           FontSize="{DynamicResource FontSizeLarger}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SelectedForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>

                                            <!-- Subtle INT / PSY / FYS / MOT diamond pips -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.82" IsHitTestVisible="False">
                                                <Path Data="M3,0 L6,3 L3,6 L0,3 Z" Fill="{DynamicResource LocalIntCyanBrush}" />
                                                <Path Data="M3,0 L6,3 L3,6 L0,3 Z" Margin="4,0,0,0" Fill="{DynamicResource LocalPsyVioletBrush}" />
                                                <Path Data="M3,0 L6,3 L3,6 L0,3 Z" Margin="4,0,0,0" Fill="{DynamicResource LocalFysCrimsonBrush}" />
                                                <Path Data="M3,0 L6,3 L3,6 L0,3 Z" Margin="4,0,0,0" Fill="{DynamicResource LocalMotOchreBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter Property="Text" Value="{DynamicResource LOCSettingsLabel}" TargetName="PART_TextTitle" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
