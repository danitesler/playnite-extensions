<!--
    Counterfoil: DerivedStyles/DetailsViewItemStyle.xaml.
    Disco Elysium Details-view library rows:
    - Idle: literary Georgia serif title on smoked film stock.
    - Hover: smoked gunmetal wash fades in (110ms) + fiery vermilion left register notch + subtle 2px nudge.
    - Selected: full-width torn chalk photo-paper strip (LocalPaperTapeTemplate) settles smoothly with jet-black ink,
      paired 2-dot film sprocket register marks on the left edge, and bottom hairline (echoing OPTIONS / VOICE OVER MODE).
    - RowHoverAction: transparent Play / Install glyph on right edge (hidden when launching/running), RowHoverRoom padding 0,0,38,0.
    - RunningIndicator (ABOVE selection & hover): 2px emerald frame with dark keyline, angled FELD exposure scan,
      segmented sprocket foot line, RowRoom (0,0,46,0) + RunningMarkPlate strip + twin 2d6 skill-check diamonds (◆ ◆).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="RowGrid" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Hover wash & vermilion register notch (Collapsed at rest) -->
                        <Border x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource ListItemHoverBrush}" />
                        <Rectangle x:Name="HoverNotch" Width="3" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                   Fill="{DynamicResource LocalVermilionBrush}" />

                        <!-- Selected full-width torn photo-paper tape strip + paired film sprocket register dots -->
                        <Grid x:Name="SelectedPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="SelectedShift" X="-6" />
                            </Grid.RenderTransform>
                            <Control Template="{DynamicResource LocalPaperTapeTemplate}"
                                     Background="{DynamicResource ListItemSelectedBrush}" Focusable="False" IsTabStop="False" />
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Rectangle Width="3" Height="4" Fill="{DynamicResource LocalVermilionBrush}" />
                                <Rectangle Width="3" Height="4" Margin="0,3,0,0" Fill="{DynamicResource SelectedForegroundBrush}" />
                            </StackPanel>
                            <Rectangle Height="1" VerticalAlignment="Bottom" Margin="8,0,6,0"
                                       Fill="{DynamicResource LocalVermilionBrush}" Opacity="0.7" />
                        </Grid>

                        <!-- Running / Launching Indicator (ABOVE selection & hover, BELOW content) -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.88" IsHitTestVisible="False">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.16" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.42">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.28">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <!-- 2px emerald frame with dark keyline inside so it reads over dark & bright selected paper -->
                            <Grid x:Name="RunningFrame">
                                <Border BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                                <Border Margin="2" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1" Opacity="0.78" />
                            </Grid>
                            <!-- Backing strip behind right-edge check diamonds -->
                            <Border x:Name="RunningMarkPlate" Width="46" HorizontalAlignment="Right" Margin="0,2,2,2"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.35" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <!-- Segmented 35mm sprocket foot line -->
                            <Grid Height="2" Margin="4,0,46,3" VerticalAlignment="Bottom"
                                  OpacityMask="{DynamicResource LocalSprocketSegmentsMask}">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.32" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalRunningHighlightBrush}" Opacity="0.95"
                                           RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <!-- Twin 2d6 skill-check diamonds on right edge -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Path x:Name="RunningDie1" Width="8" Height="8" Stretch="Fill"
                                      Data="M4,0 L8,4 L4,8 L0,4 Z"
                                      Fill="{DynamicResource LocalRunningHighlightBrush}"
                                      Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="0.8" />
                                <Path x:Name="RunningDie2" Width="8" Height="8" Margin="3,0,0,0" Stretch="Fill"
                                      Data="M4,0 L8,4 L4,8 L0,4 Z"
                                      Fill="{DynamicResource LocalRunningHighlightBrush}"
                                      Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="0.8" />
                            </StackPanel>
                        </Grid>

                        <!-- Content host with RowRoom (running mark clearance) & RowHoverRoom (hover action clearance) -->
                        <Border x:Name="RowRoom" Padding="0,0,0,0">
                            <Border x:Name="RowHoverRoom" Padding="0,0,0,0">
                                <ContentPresenter x:Name="RowContent" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="RowShift" X="0" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Border>

                        <!-- RowHoverAction: Play (installed) / Install (not installed), transparent at rest & hover, hidden when launching/running -->
                        <Button x:Name="RowHoverPlay" Width="26" Height="26" Margin="0,0,8,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}"
                                ToolTip="{DynamicResource LOCPlayGame}" Focusable="False" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                                        Focusable="False" IsHitTestVisible="False" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                        <Setter TargetName="Glyph" Property="Width" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Height" Value="17" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="RowHoverInstall" Width="26" Height="26" Margin="0,0,8,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}"
                                ToolTip="{DynamicResource LOCInstallGame}" Focusable="False" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl Content="{DynamicResource IconDownload}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                                        Focusable="False" IsHitTestVisible="False" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                        <Setter TargetName="Glyph" Property="Width" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Height" Value="17" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverNotch" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="HoverNotch" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="RowShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverNotch" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="RowShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverNotch" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverNotch" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowSelectedIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedShift" Storyboard.TargetProperty="X" From="-6" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowSelectedOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- RunningMarkRoom left="0" right="46" -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,46,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,0,0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.95" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.95" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDie1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDie2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.94" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.42" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,46,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,0,0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDie1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDie2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.5" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
