<!--
    Counterfoil: Views/Sidebar.xaml.
    44px compact dark smoked-film rail overlaid with Disco Elysium's vertical burnt-amber darkroom light-leak
    (darkroom-leak.png) and closed on its inner edge by a metallic 35mm FELD film-strip ruler rail (film-rail.png).
    Crowned by the folded Counterfoil main menu tile with vermilion/amber hover exposure.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <!-- Ambient vertical burnt-amber darkroom light-leak (Options / Title strip signature) -->
                            <Rectangle x:Name="AmberLeak" IsHitTestVisible="False" Opacity="0.34"
                                       Fill="{DynamicResource LocalDarkroomAmberBrush}"
                                       OpacityMask="{DynamicResource LocalDarkroomLeakMaskBrush}" />
                            <!-- Subtle 35mm emulsion grain -->
                            <Rectangle x:Name="RailGrain" IsHitTestVisible="False" Opacity="0.05"
                                       Fill="{DynamicResource LocalFilmRailBrightBrush}"
                                       OpacityMask="{DynamicResource LocalFilmGrainMaskBrush}" />

                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="50" Margin="0,0,0,4"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                <Border x:Name="MenuTile" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="4,0,0,0" SnapsToDevicePixels="True"
                        Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource LocalFilmRailBrush}" BorderThickness="1" />
                <Rectangle x:Name="MenuFootTick" Width="32" Height="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="4,30,0,0" IsHitTestVisible="False"
                           Fill="{DynamicResource LocalVermilionBrush}" />
                <Control x:Name="MenuMarkBox" Template="{DynamicResource LocalCounterfoilMenuMarkTemplate}" Focusable="False" IsTabStop="False"
                         Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                         Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,-2,0,0" />
                <Rectangle x:Name="MenuRule" Height="1" Margin="6,0,10,0" VerticalAlignment="Bottom"
                           Fill="{DynamicResource PanelSeparatorBrush}" IsHitTestVisible="False" />
            </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>

                            <!-- Metallic silver 35mm FELD film-strip rail closing the sidebar inner edge -->
                            <Control x:Name="FilmRailEdge" Width="8" HorizontalAlignment="Right" IsHitTestVisible="False"
                                     Focusable="False" IsTabStop="False" Opacity="0.58"
                                     Template="{DynamicResource LocalFilmRailTemplate}"
                                     Foreground="{DynamicResource LocalFilmRailBrush}" />
                            <Border x:Name="EdgeRule" Width="1" HorizontalAlignment="Right" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                    Background="Transparent" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="1,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="AmberLeak" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailGrain" />
                            <Setter Property="Opacity" Value="0.28" TargetName="FilmRailEdge" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                            <Setter Property="BorderThickness" Value="0,0,1,0" TargetName="EdgeRule" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="FilmRailEdge" />
                            <Setter Property="Margin" Value="8,0,0,0" TargetName="MenuTile" />
                            <Setter Property="Margin" Value="8,30,0,0" TargetName="MenuFootTick" />
                            <Setter Property="Margin" Value="11,-2,0,0" TargetName="MenuMarkBox" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,136,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="FilmRailEdge" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="AmberLeak" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="FilmRailEdge" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="AmberLeak" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
