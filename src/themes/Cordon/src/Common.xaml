<!--
    Overlay on Playnite Default/Common.xaml. Spacing, focus and the metal plate of the S.T.A.L.K.E.R. menus, measured
    on 1920x1080 captures of the Options screen and scaled by 2/3 to desktop pixels: option rows about 45px apart (30),
    value fields 24px tall (16, padded to 28 for Playnite's longer labels), tabs and buttons 36px plates (26 to 30),
    labels about 14px in from the panel's hairline (10), section headers with 12px above them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: a menu window's panel with its thin beige hairline, square -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Keyboard focus (keyboard only): a 2px LED amber outline just outside the control. The game has no focus ring;
         amber is its highlight color for the item under the cursor. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="{DynamicResource FrameThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared texture & FX masks (reused across templates to keep Settings/Add-ons fast) -->
    <ImageBrush x:Key="LocalScanlineBrush" ImageSource="{ThemeFile 'Images/scanlines.png'}"
                TileMode="Tile" Stretch="None" Viewport="0,0,256,256" ViewportUnits="Absolute" />
    <ImageBrush x:Key="LocalTabGlowMaskBrush" ImageSource="{ThemeFile 'Images/tab-glow.png'}"
                Stretch="Fill" />

    <!--
        The worn gunmetal plate of tabs, buttons and header bands: the host's Background, the brushed gunmetal & rust
        overlay (Images/rust.png, tiled at its own size so it never stretches), a soft shade toward the bottom
        (BevelShadowBrush through a gradient mask), a specular top metallic lip (BevelLightBrush), subtle 4px top corner
        bracket ticks (FrameBrush), a dark bottom seam, and a 1px edge in the host's BorderBrush.
    -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle Opacity="0.9">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{ThemeFile 'Images/rust.png'}" TileMode="Tile" Stretch="None"
                                Viewport="0,0,256,256" ViewportUnits="Absolute" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Fill="{DynamicResource BevelShadowBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#14000000" Offset="0.45" />
                        <GradientStop Color="#66000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" Margin="1,1,1,0" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Opacity="0.65" />
            <Rectangle Width="1" Margin="1,2,0,2" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" Opacity="0.28" />
            <!-- Top-left and top-right mechanical corner ticks -->
            <Rectangle Width="5" Height="1" Margin="1,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource FrameBrush}" Opacity="0.85" />
            <Rectangle Width="1" Height="4" Margin="1,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource FrameBrush}" Opacity="0.7" />
            <Rectangle Width="5" Height="1" Margin="0,1,1,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource FrameBrush}" Opacity="0.85" />
            <Rectangle Width="1" Height="4" Margin="0,1,1,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource FrameBrush}" Opacity="0.7" />
            <Rectangle Height="1" Margin="1,0,1,1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" />
            <Border BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Section heading: the cream headers of an options panel ("Other", "Interface"), title face at FontSizeLarger. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Button: a plate 30 tall (36px at 1080p), 18 inline -->
    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <!-- Text box, password box, dropdown: the value field, text 8px in, 28 tall -->
    <Thickness x:Key="InputPadding">8,5</Thickness>
    <!-- Menu on a panel: 4px around rows 28 tall -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">10,5,16,5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">2</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,4,14,4</Thickness>
    <!-- List box row: 8 inline, 26 tall, as the game's list rows -->
    <Thickness x:Key="ListBoxItemPadding">8,4</Thickness>
    <!-- Group box: an options section, a cream header with 12px above, no box -->
    <Thickness x:Key="GroupBoxPadding">0,4,0,4</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,8,0,6</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">22</sys:Double>
    <!-- Tooltip: a small panel, 8 / 5 -->
    <Thickness x:Key="TooltipPadding">8,5</Thickness>
    <!-- Glyphs at 18px -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <!-- Empty game page: the Zone's anomaly detector in a riveted steel slot. A Geiger needle jitters across a tick gauge, two detection rings ping out of the
         trefoil, three housing lamps blink at their own irregular beats, and spores drift up through the grain. Named transforms and opacities only, started from
         ControlTemplate.Triggers (never a Style trigger); the broken line closes the text as before. -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Grid Width="340" Height="220" HorizontalAlignment="Center">
                <Control Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False" Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" />
                <!-- rivets -->
                <Ellipse Width="6" Height="6" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource SlotBorderBrush}" />
                <Ellipse Width="6" Height="6" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource SlotBorderBrush}" />
                <Ellipse Width="6" Height="6" Margin="10,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource SlotBorderBrush}" />
                <Ellipse Width="6" Height="6" Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource SlotBorderBrush}" />
                <!-- detection rings from the trefoil -->
                <Grid Width="140" Height="140" Margin="0,84,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Ellipse x:Name="EmptyZoneRingA" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="EmptyZoneRingAScale" ScaleX="0.3" ScaleY="0.3" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="EmptyZoneRingB" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="EmptyZoneRingBScale" ScaleX="0.3" ScaleY="0.3" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <!-- tick gauge with the needle -->
                <Grid Width="200" Height="100" Margin="0,26,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="False">
                    <Path Data="M16,100 A84,84 0 0 1 184,100" Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="6" StrokeDashArray="0.25 1.6" Opacity="0.9" />
                    <Path Data="M16,100 A84,84 0 0 1 184,100" Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="1" Opacity="0.6" />
                    <Path Data="M150,32 A84,84 0 0 1 184,100" Stroke="{DynamicResource DangerBrush}" StrokeThickness="2" Opacity="0.7" />
                    <Canvas Width="200" Height="100">
                        <Canvas.RenderTransform><RotateTransform x:Name="EmptyZoneNeedle" Angle="-30" CenterX="100" CenterY="100" /></Canvas.RenderTransform>
                        <Rectangle Canvas.Left="99" Canvas.Top="22" Width="2" Height="78" Fill="{DynamicResource GlyphBrush}" />
                        <Ellipse Canvas.Left="95" Canvas.Top="95" Width="10" Height="10" Fill="{DynamicResource SlotBorderBrush}" />
                    </Canvas>
                </Grid>
                <ContentControl x:Name="EmptyZoneMark" Content="{DynamicResource IconLibrary}" ContentTemplate="{DynamicResource IconTemplate}" Width="40" Height="40"
                                Margin="0,134,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="{DynamicResource TextBrushDarker}" Opacity="0.55" />
                <!-- lamp housings -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Border Width="10" Height="18" Margin="0,0,10,0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" Padding="1">
                        <Rectangle x:Name="EmptyZoneLampA" Fill="{DynamicResource GlyphBrush}" Opacity="0.25" />
                    </Border>
                    <Border Width="10" Height="18" Margin="0,0,10,0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" Padding="1">
                        <Rectangle x:Name="EmptyZoneLampB" Fill="{DynamicResource GlyphBrush}" Opacity="0.25" />
                    </Border>
                    <Border Width="10" Height="18" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" Padding="1">
                        <Rectangle x:Name="EmptyZoneLampC" Fill="{DynamicResource DangerBrush}" Opacity="0.25" />
                    </Border>
                </StackPanel>
                <!-- spores -->
                <Rectangle x:Name="EmptyZoneSporeA" Width="3" Height="3" Margin="46,0,0,36" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" Opacity="0">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="EmptyZoneSporeAShift" Y="0" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="EmptyZoneSporeB" Width="2" Height="2" Margin="0,0,58,30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource TextBrushDarker}" Opacity="0">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="EmptyZoneSporeBShift" Y="0" /></Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,18,0,0"
                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource HeadingForegroundBrush}" />
            <Line X1="0" X2="170" Y1="0.5" Y2="0.5" Width="170" Height="1" Margin="0,10,0,0" HorizontalAlignment="Center" Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="1" StrokeDashArray="4 3" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyZoneIdle">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyZoneNeedle" Storyboard.TargetProperty="Angle" Duration="0:0:5" RepeatBehavior="Forever">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-34" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="-18" KeySpline="0.4,0,0.2,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="-26" KeySpline="0.4,0,0.2,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="14" KeySpline="0.4,0,0.2,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.5" Value="2" KeySpline="0.4,0,0.2,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.3" Value="40" KeySpline="0.4,0,0.2,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.8" Value="30" KeySpline="0.4,0,0.2,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:5.0" Value="-34" KeySpline="0.4,0,0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="EmptyZoneRingAScale" Storyboard.TargetProperty="ScaleX" From="0.3" To="1.25" Duration="0:0:3.4" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyZoneRingAScale" Storyboard.TargetProperty="ScaleY" From="0.3" To="1.25" Duration="0:0:3.4" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyZoneRingA" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:3.4" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="EmptyZoneRingBScale" Storyboard.TargetProperty="ScaleX" From="0.3" To="1.25" Duration="0:0:3.4" BeginTime="0:0:1.7" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyZoneRingBScale" Storyboard.TargetProperty="ScaleY" From="0.3" To="1.25" Duration="0:0:3.4" BeginTime="0:0:1.7" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyZoneRingB" Storyboard.TargetProperty="Opacity" From="0.4" To="0" Duration="0:0:3.4" BeginTime="0:0:1.7" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="EmptyZoneMark" Storyboard.TargetProperty="Opacity" From="0.4" To="0.75" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyZoneLampA" Storyboard.TargetProperty="Opacity" Duration="0:0:1.9" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:1.65" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyZoneLampB" Storyboard.TargetProperty="Opacity" Duration="0:0:2.7" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0.2" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyZoneLampC" Storyboard.TargetProperty="Opacity" Duration="0:0:3.4" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:2.3" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:2.7" Value="0.2" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyZoneSporeA" Storyboard.TargetProperty="Opacity" Duration="0:0:5" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.8" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:5" Value="0" KeySpline="0.4,0,0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="EmptyZoneSporeAShift" Storyboard.TargetProperty="Y" From="0" To="-90" Duration="0:0:5" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyZoneSporeB" Storyboard.TargetProperty="Opacity" Duration="0:0:6" BeginTime="0:0:2" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.7" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:6" Value="0" KeySpline="0.4,0,0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="EmptyZoneSporeBShift" Storyboard.TargetProperty="Y" From="0" To="-110" Duration="0:0:6" BeginTime="0:0:2" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyZoneIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- menu-mark begin LocalCordonMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a Geiger gauge, a half dial with five ticks and a needle at rest on the left. Hover (IsMouseOver): the needle swings to 36 degrees (0.22s) and jitters back and forth around 30 before settling, as the counter does near a source. Open (ContextMenu.IsOpen of the nearest Border): the red zone of the dial lights and an amber lamp below the hub crackles on an irregular 1.4s loop until the menu closes; exits restore every property. -->
    <ControlTemplate x:Key="LocalCordonMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="24" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Path Data="M2,14 A10,10 0 0 1 22,14" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" />
                <Path Data="M2.2,14 L4.7,14 M4.93,6.93 L6.7,8.7 M12,4 L12,6.5 M19.07,6.93 L17.3,8.7 M21.8,14 L19.3,14" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" />
                <Path x:Name="Zone" Data="M19.07,6.93 A10,10 0 0 1 22,14" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="2.2" Opacity="0" />
                <Rectangle x:Name="Needle" Canvas.Left="11.25" Canvas.Top="5" Width="1.5" Height="9" RenderTransformOrigin="0.5,1" Fill="{TemplateBinding Foreground}">
                    <Rectangle.RenderTransform><RotateTransform x:Name="NeedleR" Angle="-50" /></Rectangle.RenderTransform>
                </Rectangle>
                <Ellipse Canvas.Left="10" Canvas.Top="12" Width="4" Height="4" Fill="{TemplateBinding Foreground}" />
                <Ellipse x:Name="Lamp" Canvas.Left="10.8" Canvas.Top="15.4" Width="2.4" Height="2.4" Fill="{DynamicResource GlyphBrush}" Opacity="0" />
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NeedleR" Storyboard.TargetProperty="Angle"><LinearDoubleKeyFrame KeyTime="0:0:0.000" Value="-50" /><EasingDoubleKeyFrame KeyTime="0:0:0.220" Value="36"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><LinearDoubleKeyFrame KeyTime="0:0:0.290" Value="27" /><LinearDoubleKeyFrame KeyTime="0:0:0.360" Value="38" /><LinearDoubleKeyFrame KeyTime="0:0:0.440" Value="31" /></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="NeedleR" Storyboard.TargetProperty="Angle" To="-50" Duration="0:0:0.150" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lamp" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="1" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.100" Value="0.25" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.220" Value="1" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.450" Value="0.4" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.600" Value="1" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.900" Value="0.2" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.100" Value="1" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.400" Value="1" /></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="Zone" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.250"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Lamp" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.100" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Zone" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.200" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalCordonMenuMarkTemplate -->
</ResourceDictionary>
