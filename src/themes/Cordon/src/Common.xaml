<!--
    Overlay on Playnite Default/Common.xaml. Spacing, focus and the metal plate of the S.T.A.L.K.E.R. menus, measured
    on 1920x1080 captures of the Options screen and scaled by 2/3 to desktop pixels: option rows about 45px apart (30),
    value fields 24px tall (16, padded to 28 for Playnite's longer labels), tabs and buttons 36px plates (26 to 30),
    labels about 14px in from the panel's hairline (10), section headers with 12px above them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: a menu window's panel with its thin beige hairline, square -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Keyboard focus (keyboard only): a 2px LED amber outline just outside the control. The game has no focus ring;
         amber is its highlight color for the item under the cursor. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="{DynamicResource FrameThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The worn metal plate of tabs, buttons and the frame: the host's Background, the rust texture over it
        (Images/rust.png, an original procedural overlay: corrosion patches, pitting and scratches, tiled at its own
        size so it never stretches), a soft shade toward the bottom (BevelShadowBrush through a gradient mask), a lit
        top edge (BevelLightBrush), a dark bottom edge, and a 1px edge in the host's BorderBrush. Host: a Control,
        hit testing off, under the content.
    -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle Opacity="0.9">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{ThemeFile 'Images/rust.png'}" TileMode="Tile" Stretch="None"
                                Viewport="0,0,256,256" ViewportUnits="Absolute" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Fill="{DynamicResource BevelShadowBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#10000000" Offset="0.45" />
                        <GradientStop Color="#60000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" Margin="1,1,1,0" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Opacity="0.55" />
            <Rectangle Width="1" Margin="1,2,0,2" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" Opacity="0.25" />
            <Rectangle Height="1" Margin="1,0,1,1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" />
            <Border BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Section heading: the cream headers of an options panel ("Other", "Interface"), title face at FontSizeLarger. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Button: a plate 30 tall (36px at 1080p), 18 inline -->
    <Thickness x:Key="ButtonPadding">18,6</Thickness>
    <!-- Text box, password box, dropdown: the value field, text 8px in, 28 tall -->
    <Thickness x:Key="InputPadding">8,5</Thickness>
    <!-- Menu on a panel: 4px around rows 28 tall -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">10,5,16,5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">2</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,4,14,4</Thickness>
    <!-- List box row: 8 inline, 26 tall, as the game's list rows -->
    <Thickness x:Key="ListBoxItemPadding">8,4</Thickness>
    <!-- Group box: an options section, a cream header with 12px above, no box -->
    <Thickness x:Key="GroupBoxPadding">0,4,0,4</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,8,0,6</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">22</sys:Double>
    <!-- Tooltip: a small panel, 8 / 5 -->
    <Thickness x:Key="TooltipPadding">8,5</Thickness>
    <!-- Glyphs at 18px -->
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">340</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double>
</ResourceDictionary>
