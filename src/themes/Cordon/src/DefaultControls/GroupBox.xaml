<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml. An options/PDA section ("Other", "Interface",
    "Objectives"): no fill and no box, the header in the title face (HeadingFontFamily, GroupBoxHeaderFontSize 22,
    HeadingForegroundBrush warm bone-white) over S.T.A.L.K.E.R. 2's broken line with a small downward triangle notch
    (in a Canvas so it claims zero desired width on the Statistics page), then the body (GroupBoxPadding).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel Background="{TemplateBinding Background}">
                        <StackPanel x:Name="HeaderPanel" DockPanel.Dock="Top">
                            <TextBlock Style="{DynamicResource BaseTextBlockStyle}" Margin="{DynamicResource GroupBoxHeaderMargin}"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       Foreground="{DynamicResource HeadingForegroundBrush}"
                                       FontSize="{DynamicResource GroupBoxHeaderFontSize}">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                            </TextBlock>
                            <!-- The broken line + S.T.A.L.K.E.R. 2 downward triangle notch inside a zero-desired-width Canvas. -->
                            <Canvas Height="5" SnapsToDevicePixels="True">
                                <Line X1="0" X2="1" Height="1"
                                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                      Stretch="Fill" StrokeThickness="1" StrokeDashArray="8 2 3 2"
                                      SnapsToDevicePixels="True" Stroke="{DynamicResource InputBorderBrush}" />
                                <Polygon Canvas.Left="16" Canvas.Top="1" Points="0,0 8,0 4,4"
                                         Fill="{DynamicResource InputBorderBrush}" />
                            </Canvas>
                        </StackPanel>
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                          Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderPanel" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
