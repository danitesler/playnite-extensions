<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml. An options section ("Other", "Interface"): no fill and no
    box, the header in the title face (HeadingFontFamily, GroupBoxHeaderFontSize 22, HeadingForegroundBrush cream)
    over the game's broken line (ui_brokenline: a 1px dashed rule in InputBorderBrush), then the body
    (GroupBoxPadding). A group box without a header draws just the body.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel Background="{TemplateBinding Background}">
                        <StackPanel x:Name="HeaderPanel" DockPanel.Dock="Top">
                            <TextBlock Style="{DynamicResource BaseTextBlockStyle}" Margin="{DynamicResource GroupBoxHeaderMargin}"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       Foreground="{DynamicResource HeadingForegroundBrush}"
                                       FontSize="{DynamicResource GroupBoxHeaderFontSize}">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                            </TextBlock>
                            <!-- The broken line. A bare Line with Stretch=Fill reports the whole available width as its
                                 desired width, which makes every GroupBox ask for the full page and breaks content-sized
                                 layouts (the statistics page stacks the four sections full width instead of wrapping them
                                 side by side). The Canvas takes no desired size and hands the Line the width it is given,
                                 so the rule still spans the box while the box sizes to its content. -->
                            <Canvas Height="1" SnapsToDevicePixels="True">
                                <Line X1="0" X2="1" Height="1"
                                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                      Stretch="Fill" StrokeThickness="1" StrokeDashArray="8 2 3 2"
                                      SnapsToDevicePixels="True" Stroke="{DynamicResource InputBorderBrush}" />
                            </Canvas>
                        </StackPanel>
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                          Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderPanel" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
