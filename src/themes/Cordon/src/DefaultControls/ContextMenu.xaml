<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is S.T.A.L.K.E.R.: Shadow of Chernobyl's Options panel (LocalZonePanelTemplate, shared
    by ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: grainy olive-black interior (PopupBackgroundBrush + Images/grain.png) set inside a rusted metal frame
      (BevelTemplate with Images/rust.png and PopupBorderBrush hairline), topped by a 6px riveted steel header strip with
      two 3px rivets and an amber PDA status pip. Square corners, no DropShadowEffect.
    - Rows, rules and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalZonePanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <!-- Outer rusted steel frame -->
            <Control Focusable="False" IsTabStop="False"
                     Background="{DynamicResource ShellBackgroundBrush}"
                     BorderBrush="{DynamicResource PopupBorderBrush}"
                     Template="{DynamicResource BevelTemplate}" />
            <!-- Inner grainy & CRT-scanlined recessed panel interior -->
            <Border Margin="3,8,3,3" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1">
                <Grid>
                    <Rectangle Fill="{DynamicResource LocalScanlineBrush}" />
                    <Rectangle Opacity="0.35">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{ThemeFile 'Images/grain.png'}" TileMode="Tile" Stretch="None"
                                        Viewport="0,0,128,128" ViewportUnits="Absolute" />
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
            </Border>
            <!-- Top header strip rivets, 3-bar vent stamp and amber PDA status pip -->
            <Rectangle Width="3" Height="3" Margin="5,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="{DynamicResource FrameBrush}" />
            <StackPanel Width="8" Margin="12,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.55">
                <Rectangle Height="1" Margin="0,0,0,1" Fill="{DynamicResource FrameBrush}" />
                <Rectangle Height="1" Fill="{DynamicResource FrameBrush}" />
            </StackPanel>
            <Rectangle Width="3" Height="3" Margin="0,3,13,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Fill="{DynamicResource FrameBrush}" />
            <Rectangle Width="4" Height="3" Margin="0,3,5,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Fill="{DynamicResource GlyphBrush}" Opacity="0.85" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="228" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalZonePanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="5,10,5,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
