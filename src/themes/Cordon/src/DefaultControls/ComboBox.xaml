<!--
    Overlay on Playnite Default/DefaultControls/ComboBox.xaml. The option field of the Options screen ("Master",
    "Build 2232"): a near-black value field (InputBackgroundBrush) with the thin beige hairline (InputBorderBrush),
    square, InputPadding (28 tall), the value in light beige-grey, and at its right end a dim dropdown chevron.
    List: the menus' S.T.A.L.K.E.R. Options panel (LocalZonePanelTemplate, ContextMenu.xaml); ComboBoxItem rows are 28px
    like Menu.xaml with the rusted warm-brown bevel plate and square amber PDA lamp on IsHighlighted, and the square
    amber lamp checkbox on IsSelected. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Grid Background="Transparent">
                                                    <ContentPresenter x:Name="Arrow" Width="14" Height="14" Margin="0,0,8,0"
                                                                      HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                                                                      TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                      Content="{DynamicResource IconDropDown}"
                                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                                    <ToggleButton x:Name="FilterGroupIndicator" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                                  Margin="0,0,-5,0" Background="Transparent" BorderThickness="0" Padding="0" Width="30" Height="28" VerticalAlignment="Center" Visibility="Collapsed"
                                                                  IsHitTestVisible="False" Focusable="False" IsChecked="True"
                                                                  Style="{DynamicResource ExpanderDownHeaderStyle}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType={x:Type FilterPanel}}, FallbackValue=False}" Value="True">
                                                        <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="FilterGroupIndicator" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Arrow" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Arrow" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <!-- ComboBox-chevron-room: the value never runs under the chevron (14px + 8px margin = 22px, plus Padding 8 so the gap before the arrow equals the left inset). -->
                                    <Border Margin="0,0,22,0" IsHitTestVisible="False">
                                        <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                    </Border>
                                    <TextBox MinHeight="0" x:Name="PART_EditableTextBox" Style="{DynamicResource BareTextBox}" Visibility="Hidden"
                                             VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                             Margin="8,0,30,0" Focusable="True"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" />
                                </Grid>
                            </Border>
                            <Control x:Name="FieldOverlay" Template="{DynamicResource LocalLampFieldTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        </Grid>
                        <Border x:Name="Frame" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderThickness="1" BorderBrush="{DynamicResource FocusBrush}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" VerticalOffset="2" Focusable="False" AllowsTransparency="True">
                            <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Control Template="{DynamicResource LocalZonePanelTemplate}" Focusable="False" IsTabStop="False" />
                                <ScrollViewer Margin="5,10,5,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" TargetName="Border" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Frame" />
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="Frame" />
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                        </MultiTrigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="ContentSite" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid x:Name="ListRow" Height="28" Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="ListHover" Opacity="0" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                 Background="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource SlotBorderBrush}"
                                 Template="{DynamicResource BevelTemplate}" />
                        <Border x:Name="ListLamp" Width="10" Height="10" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}"
                                BorderThickness="1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle Width="6" Height="6" Fill="{DynamicResource GlyphBrush}" />
                        </Border>
                        <Grid Margin="18,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ListCheck" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="Collapsed" Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource CheckBoxBorderBrush}" BorderThickness="1">
                                <Rectangle Width="6" Height="6" Fill="{DynamicResource GlyphBrush}" />
                            </Border>
                            <ContentPresenter x:Name="ListLabel" Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="ListLabelShift" X="0" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="ListCheck" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ListHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListLamp" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="ListLamp" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="ListLabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ListHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListLamp" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ListLamp" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ListLabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" TargetName="ListRow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
