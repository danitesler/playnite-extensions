<!--
    Overlay on Playnite Default/DefaultControls/ComboBox.xaml. The option field of the Options screen ("Master",
    "Build 2232"): a near-black value field (InputBackgroundBrush) with the thin beige hairline (InputBorderBrush),
    square, InputPadding (28 tall), the value in light beige-grey, and at its right end the game's round knob with a red
    lens: a 20px steel ring (ButtonBackgroundBrush, SlotBorderBrush edge) holding a 10px lens (DangerBrush, shaded by a
    radial mask, with a small glint in TextBrush). Hover: lighter fill and edge, the ring lifts
    (ButtonHoverBackgroundBrush). Keyboard focus or open: the edge turns LED amber (FocusBrush).
    Popup: PopupBorder (panel, hairline) right under the field, ComboBoxDropDownPadding. Items (ComboBoxItem):
    ComboBoxItemPadding, transparent with beige text at rest; hover or keyboard highlight is the warm-brown bar
    (MenuItemHoverBrush, the engine's list selection bar) with cream text (SelectedForegroundBrush); the chosen item ends with an amber check.
    Structure kept from the Default template: ToggleButton, ContentSite, PART_EditableTextBox, PART_Popup.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Grid Background="Transparent">
                                                <Grid x:Name="Knob" Width="20" Height="20" Margin="0,0,4,0"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <Ellipse x:Name="Ring" Fill="{DynamicResource ButtonBackgroundBrush}"
                                                             Stroke="{DynamicResource SlotBorderBrush}" StrokeThickness="1" />
                                                    <Ellipse Margin="2,2,2,2" Stroke="{DynamicResource BevelLightBrush}" StrokeThickness="1" Opacity="0.35" />
                                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource DangerBrush}"
                                                             Stroke="{DynamicResource SlotBorderBrush}" StrokeThickness="1" />
                                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource SlotBorderBrush}">
                                                        <Ellipse.OpacityMask>
                                                            <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.4,0.35" RadiusX="0.75" RadiusY="0.75">
                                                                <GradientStop Color="#00000000" Offset="0" />
                                                                <GradientStop Color="#00000000" Offset="0.35" />
                                                                <GradientStop Color="#B0000000" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Ellipse.OpacityMask>
                                                    </Ellipse>
                                                    <Ellipse Width="3" Height="3" Margin="-3,-3,0,0" Fill="{DynamicResource TextBrush}" Opacity="0.6" />
                                                </Grid>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource ButtonHoverBackgroundBrush}" TargetName="Ring" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource ButtonHoverBackgroundBrush}" TargetName="Ring" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                <TextBox x:Name="PART_EditableTextBox" Style="{DynamicResource BareTextBox}" Visibility="Hidden"
                                         VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                         Margin="8,0,28,0" Focusable="True"
                                         IsReadOnly="{TemplateBinding IsReadOnly}" />
                            </Grid>
                        </Border>
                        <Border x:Name="Frame" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderThickness="1" BorderBrush="{DynamicResource FocusBrush}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" VerticalOffset="1" Focusable="False" AllowsTransparency="True">
                            <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Border Style="{DynamicResource PopupBorder}" Padding="{DynamicResource ComboBoxDropDownPadding}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" TargetName="Border" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Frame" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Frame" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="ContentSite" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxItemPadding}" />
        <Setter Property="Margin" Value="0,0,0,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid>
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <ContentPresenter x:Name="CheckIcon" Grid.Column="1" Visibility="Collapsed" Width="14" Height="14"
                                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource GlyphBrush}"
                                                  Content="{DynamicResource IconCheck}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="ItemBorder" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="ItemBorder" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
