<!--
    Overlay on Playnite Default/DefaultControls/RadioButton.xaml. A round indicator lamp beside the label: a 16px
    housing (InputBackgroundBrush, CheckBoxBorderBrush ring) with an 8px lamp, unlit grey (TextBrushDarker at 45%) when
    off, the amber (GlyphBrush) with a soft halo when on. Hover: the ring lightens (CheckBoxHoverBorderBrush).
    Label 10px after the lamp. Keyboard focus: FocusVisual. Lamp and housing are 1:1, so they are ellipses.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="Halo" Margin="-5" Visibility="Hidden" IsHitTestVisible="False"
                                         Fill="{DynamicResource GlyphBrush}" Opacity="0.45">
                                    <Ellipse.OpacityMask>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FF000000" Offset="0.3" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.OpacityMask>
                                </Ellipse>
                                <Ellipse x:Name="Ring" Fill="{DynamicResource InputBackgroundBrush}" Stroke="{TemplateBinding BorderBrush}"
                                         StrokeThickness="{DynamicResource EllipseBorderThickness}" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource TextBrushDarker}" Opacity="0.45" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Visibility="Hidden"
                                         Fill="{DynamicResource GlyphBrush}" />
                            </Grid>
                        </BulletDecorator.Bullet>
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter RecognizesAccessKey="True" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Dot" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Halo" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="Ring" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
