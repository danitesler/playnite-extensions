<!--
    Overlay on Playnite Default/DefaultControls/Button.xaml. The "Use" / "Cancel" plate of the S.T.A.L.K.E.R. menus:
    a worn steel plate through BevelTemplate (Common.xaml: ButtonBackgroundBrush plate 4b443f, the rust overlay, lit top
    edge, dark bottom edge, a 1px ButtonBorderBrush edge), square, the bright beige label (ButtonForegroundBrush, e3c7b2,
    the game's enabled state), ButtonPadding (30 tall). Hover: as in the game, the plate brightens
    (ButtonHoverBackgroundBrush) and the label turns dark ink (ButtonHoverForegroundBrush). Pressed: a darker plate
    (ButtonPressedBackgroundBrush), the touched label color (ButtonPressedForegroundBrush), the label 1px down.
    A default button (IsDefault, the OK of a dialog) is the lit plate of the current tab: PrimaryButton* brushes; its
    hover keeps the light label on a lighter lit plate.
    Keyboard focus: FocusVisual (amber outline). Disabled: BaseStyle opacity.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="Plate" Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False"
                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" TargetName="Plate" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" TargetName="Content" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" TargetName="Plate" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPressedForegroundBrush}" TargetName="Content" />
                            <Setter Property="RenderTransform" TargetName="Content">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" TargetName="Plate" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" TargetName="Content" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" TargetName="Plate" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- ThemeModifier icon buttons: the plugin sets Width=41 on them (editor and constants tabs).
                 Square 41x41 with a small centred glyph; fixed-width only, auto-width buttons keep ButtonPadding. -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="FontSize" Value="16" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
