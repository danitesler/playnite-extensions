<!--
    Overlay on Playnite Default/DefaultControls/Button.xaml. The "Use" / "Cancel" / Title plate of the S.T.A.L.K.E.R.
    menus: a worn gunmetal plate through BevelTemplate (Common.xaml: ButtonBackgroundBrush plate, brushed gunmetal/rust
    overlay, specular top lip, corner bracket ticks, dark bottom seam, 1px ButtonBorderBrush edge), square, the bright
    bone-beige label (ButtonForegroundBrush), ButtonPadding. Hover: as on the S.T.A.L.K.E.R. 2 Title Screen and active
    sub-tabs, the plate turns distressed bone-cream (ButtonHoverBackgroundBrush) with dark ink
    (ButtonHoverForegroundBrush) and notched chevron side-cuts. Pressed: a darker recessed plate
    (ButtonPressedBackgroundBrush), the touched label color (ButtonPressedForegroundBrush), the label 1px down.
    A default button (IsDefault, the OK/Save of a dialog) is the lit burnished plate of the current tab: PrimaryButton*
    brushes with the PDA under-bar glow. Keyboard focus: FocusVisual (amber outline).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="Plate" Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False"
                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                        <!-- S.T.A.L.K.E.R. 2 Title Screen notched chevron side-cuts on hovered bone-cream plates -->
                        <Polygon x:Name="NotchLeft" Visibility="Collapsed" IsHitTestVisible="False"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
                                 Points="0,0 4,4 0,8" Fill="{DynamicResource ButtonBorderBrush}" />
                        <Polygon x:Name="NotchRight" Visibility="Collapsed" IsHitTestVisible="False"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0"
                                 Points="4,0 0,4 4,8" Fill="{DynamicResource ButtonBorderBrush}" />
                        <Border x:Name="DefaultBar" Visibility="Collapsed" Height="2" Margin="3,0,3,1"
                                VerticalAlignment="Bottom" IsHitTestVisible="False"
                                Background="{DynamicResource TabItemIndicatorBrush}" />
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="DefaultBar" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" TargetName="Plate" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" TargetName="Content" />
                            <Setter Property="Visibility" Value="Visible" TargetName="NotchLeft" />
                            <Setter Property="Visibility" Value="Visible" TargetName="NotchRight" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" TargetName="Plate" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPressedForegroundBrush}" TargetName="Content" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="NotchLeft" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="NotchRight" />
                            <Setter Property="RenderTransform" TargetName="Content">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" TargetName="Plate" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" TargetName="Content" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="NotchLeft" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="NotchRight" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" TargetName="Plate" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <!-- ThemeModifier icon buttons: the plugin sets Width=41 on them (editor and constants tabs).
                 Render at 32x32 via uniform 32/41 layout scaling, including glyphs and decoration; auto-width buttons keep ButtonPadding. -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
