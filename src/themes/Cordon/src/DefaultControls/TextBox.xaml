<!--
    Overlay on Playnite Default/DefaultControls/TextBox.xaml. The value field of the Options screen ("Master",
    "English"): a near-black field (InputBackgroundBrush) with a thin beige hairline (InputBorderBrush), square,
    InputPadding (28 tall), light beige-grey text. Hover: InputHoverBackgroundBrush and a lighter edge
    (InputHoverBorderBrush). Keyboard focus: the edge turns LED amber (FocusBrush). Selection: GlyphBrush at 40%.
    BareTextBox: no chrome, for hosts that draw the field (search box, editable dropdown).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LocalLampFieldTemplate: a steel plate with an indicator lamp. A faint bevel light runs inside the top edge and a
        5px unlit lamp sits in the top-right corner. Hover: the lamp glows dim amber. Keyboard focus: the lamp strikes
        amber with a bloom and an amber filament along the bottom warms up with a flicker (0.6, 0.25, 1 over 0.22s).
        State is read from the nearest Control above; no desired size.
    -->
    <ControlTemplate x:Key="LocalLampFieldTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Height="1" VerticalAlignment="Top" Margin="1,1,1,0" Fill="{DynamicResource BevelLightBrush}" Opacity="0.3" />
            <Rectangle x:Name="Filament" Height="1" VerticalAlignment="Bottom" Margin="1,0,1,1" Fill="{DynamicResource FocusBrush}" Opacity="0" />
            <Rectangle x:Name="Bloom" Width="19" Height="19" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                       Fill="{DynamicResource FocusBrush}" Opacity="0">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#AAFFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Border Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                    Background="{DynamicResource PanelShadowBrush}" BorderThickness="1" BorderBrush="{DynamicResource BevelLightBrush}" />
            <Rectangle x:Name="Lamp" Width="3" Height="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                       Fill="{DynamicResource FocusBrush}" Opacity="0" />
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <Setter TargetName="Lamp" Property="Opacity" Value="0.4" />
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Strike">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lamp" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0.25" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Filament" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0.25" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.08" Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Strike" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Grid>
                            <Border x:Name="Border" BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                            </Border>
                            <Control x:Name="FieldOverlay" Template="{DynamicResource LocalLampFieldTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        </Grid>
                        <Border x:Name="Frame" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderThickness="1" BorderBrush="{DynamicResource FocusBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" TargetName="Border" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Frame" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No fill, no edge, no padding: the host (search box, editable dropdown) draws the field. -->
    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
