<!--
    Cordon: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    The S.T.A.L.K.E.R. menus: a grainy olive-black panel (panel 141210) inside a darker brown frame (frame
    12110e), worn metal plates for tabs and buttons (plate 4b443f, the current tab a warmer lit plate 775f51; under the
    cursor a plate brightens and its label turns dark ink 291b10), beige labels (text d7c3aa, quoted from the game's
    ui_mm_opt.xml), cream headings (f0d9b6), near-black value fields with a grey hairline, the engine's warm-brown list
    selection bar (5f524a at 78%), and the amber of the selected PDA tab (e7a80c) as the one accent, also the lit lamp
    of a toggle. Square plates throughout; the bevel and rivets are drawn.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). Placeholder syntax: see reference.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): labels 14 (letterica16), tabs and buttons 16 (graffiti19), section headers 20, titles 28. -->
    <sys:Double x:Key="FontSizeSmall">{{px:zone-text-sm}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:zone-text-md}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:zone-text-lg}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:zone-text-xl}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:zone-text-2xl}}</sys:Double>
    <!-- The game's condensed faces when installed (a theme cannot ship fonts, and they are GSC's); otherwise the condensed
         cut of Bahnschrift (Windows 10 and later), then Arial Narrow, then Segoe UI. -->
    <FontFamily x:Key="FontFamily">{{text:zone-font-body|Bahnschrift SemiCondensed, Arial Narrow, Tahoma}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:zone-font-title|Bahnschrift SemiCondensed, Arial Narrow, Tahoma}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys): square plates, 1px edges. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:zone-radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <CornerRadius x:Key="CornerRadiusSmall">{{px:zone-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:zone-radius}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:zone-radius}}</CornerRadius>
    <!-- Only for 1:1 elements (LED lenses, rivets); see the repo rule on CornerRadiusFull. -->
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <!-- Keyboard focus outline -->
    <Thickness x:Key="FrameThickness">2</Thickness>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor (selection, checked, links) is the PDA amber; TextColorDark is the main menu's dark ink.
        MainColor is the steel of idle plates, MainColorDark the panel interior.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{zone-text}}</Color>
    <Color x:Key="TextColorDarker">{{zone-text-dim}}</Color>
    <Color x:Key="TextColorDark">{{zone-ink}}</Color>
    <Color x:Key="MainColor">{{zone-steel}}</Color>
    <Color x:Key="MainColorDark">{{zone-panel}}</Color>
    <Color x:Key="HoverColor">{{zone-plate-hover}}</Color>
    <Color x:Key="GlyphColor">{{zone-led}}</Color>
    <Color x:Key="HighlightGlyphColor">{{zone-led/40}}</Color>
    <Color x:Key="PopupBackgroundColor">{{zone-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{zone-hairline}}</Color>
    <Color x:Key="BackgroundToneColor">{{zone-panel-deep}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{zone-rule}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{zone-rule}}</Color>
    <Color x:Key="DataChangeNotifColor">{{zone-amber}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{zone-hairline}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{zone-panel}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{zone-plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{zone-field}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{zone-good}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{zone-health}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{zone-warning}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{zone-warning}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{zone-panel-deep}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{zone-panel}}" />

    <!-- Shell: the rail and the top bar are the dark frame of a menu window (darker brown than the panel); the views are the panel inside it -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{zone-frame}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{zone-panel}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{zone-frame}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{zone-field}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{zone-field-hover}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{zone-bevel-shadow}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{zone-text}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{zone-panel}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{zone-bevel-shadow}}" />

    <!-- States: the current row is the engine's warm-brown selection bar with the bright label; focus is HUD amber -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{zone-select@zone-panel}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{zone-heading}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{zone-steel-dark}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{zone-select@zone-panel}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{zone-select@zone-panel}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{zone-amber}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{zone-lens}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{zone-text-bright}}" />

    <!-- Buttons: worn steel plates with the bright beige label (e); under the cursor the plate brightens and the label
         turns dark ink (h); pressed shows the touched color (t). Play is the lit plate with a lamp beside its label. -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{zone-text-bright}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{zone-ink}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{zone-text-touched}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{zone-plate-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{zone-plate-pressed}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{zone-bevel-shadow}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{zone-plate-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{zone-plate-lit-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{zone-plate-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{zone-heading}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{zone-led}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{zone-plate-lit}}" />

    <!-- Plates: bevel, grime and rivets -->
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{zone-bevel-light}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{zone-bevel-shadow}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{zone-rivet}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{zone-hairline}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{zone-bevel-shadow}}" />

    <!-- Inputs: the near-black value field with the thin beige hairline -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{zone-field}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{zone-field-hover}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{zone-hairline}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{zone-text-dim}}" />

    <!-- Controls: square lamp check boxes, steel thumbs, the amber as fill; tabs in the game's three text states -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{zone-text-dim}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{zone-text-touched}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{zone-hairline}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{zone-text-dim}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{zone-led-glow}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{zone-field}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{zone-plate}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{zone-amber}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{zone-led}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{zone-field}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{zone-plate}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{zone-plate-hover}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{zone-field}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{zone-plate}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{zone-plate-hover}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{zone-led}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{zone-text-dim}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{zone-led}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{zone-plate}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{zone-plate-lit}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{zone-text-dim}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{zone-text-bright}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{zone-steel-dark}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{zone-value}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{zone-steel}}" />

    <!-- Popups: a menu window panel with the hairline edge -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{zone-rule}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{zone-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{zone-hairline}}" />

    <!-- Section headings: cream, larger, as "Other" and "Interface" on the Options panel -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{zone-heading}}" />
</ResourceDictionary>
