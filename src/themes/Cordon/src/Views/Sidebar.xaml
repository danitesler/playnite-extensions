<!--
    Overlay on Playnite Default/Views/Sidebar.xaml. The left post of a S.T.A.L.K.E.R. menu window's frame as a compact
    rail: a 44px strip of dark frame brown (BevelTemplate on ShellBackgroundBrush, frame 12110e, darker than the panel,
    with the rust overlay)
    down the left edge, closed on its inner side by a dark seam and a lit 1px edge (BevelShadowBrush, BevelLightBrush),
    with a rivet (FrameBrush, 1:1) near its foot. Items are 44 x 40 with 16px glyphs (CustomControls/SidebarItem.xaml):
    dim at rest, the current one on a lit plate with an amber lamp. The main menu button (MainMenuButton, defined here,
    also used by Views/TopPanel.xaml when the sidebar is hidden) is 44 x 40 at the top: a beige glyph that turns amber on
    hover; items start 40px down, under a short rule.
    Right: the strip mirrors (seam on its left) and starts 52px down so the window buttons stay clear.
    Top and bottom: a 44px steel strip without rivets; the top strip keeps 160px clear for the window buttons.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid x:Name="Root" Width="44" Margin="{TemplateBinding Padding}">
                        <Control Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False"
                                 Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="Transparent" />
                        <Grid x:Name="Seam" Width="2" HorizontalAlignment="Right" IsHitTestVisible="False">
                            <Rectangle Width="1" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" Opacity="0.35" />
                            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BevelShadowBrush}" />
                        </Grid>
                        <Grid x:Name="Rivets" IsHitTestVisible="False">
                            <Ellipse Width="5" Height="5" Margin="0,0,0,8" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                     Fill="{DynamicResource FrameBrush}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="1" />
                        </Grid>
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                    DockPanel.Dock="Top" Margin="0,0,0,0">
                                <ContentPresenter Width="16" Height="16"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>
                            <Rectangle x:Name="MenuRule" DockPanel.Dock="Top" Height="1" Margin="10,0,10,4"
                                       Fill="{DynamicResource BevelShadowBrush}" />

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" Margin="0,0,0,24" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Main menu hidden (it is in the top bar): the items still start below the top bar. -->
                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemMainMenu}" Value="Collapsed">
                            <Setter Property="Margin" Value="0,52,0,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,52,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="Seam" />
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" TargetName="Seam" />
                            <Setter Property="RenderTransform" TargetName="Seam">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="-1" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Margin" Value="0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Width" Value="Auto" TargetName="Root" />
                            <Setter Property="Height" Value="44" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Rivets" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuRule" />
                            <Setter Property="Width" Value="Auto" TargetName="Seam" />
                            <Setter Property="Height" Value="2" TargetName="Seam" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="Seam" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="Seam" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,160,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,2,0,2" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="4,2,4,2" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Width" Value="Auto" TargetName="Root" />
                            <Setter Property="Height" Value="44" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Rivets" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Seam" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,2,0,2" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="4,2,4,2" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
