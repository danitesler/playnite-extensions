<!--
    Overlay on Playnite Default/Views/Library.xaml.
    The library layer is the inside of a menu window: the olive-black panel (ContentBackgroundBrush) with the grain of
    the game's panel texture over it (Images/grain.png, an original procedural overlay of specks and soft blotches,
    tiled at its own size). The optional background art (PART_ImageBackground) sits behind the views like the scene
    behind the game's menus: darkened by the panel color (ScrimBrush at 75%) and a heavy vignette (a radial gradient from clear to the panel
    color). No OpacityMask and no BitmapCache: animated covers and Play above masked art left dark boxes on scaled
    displays; the grain lies over the art. Layout and parts are Playnite's.
    Deviation: the game's menus sit over a desaturated scene; WPF has no cheap desaturation, so the art keeps its color.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid x:Name="LibraryRoot" Background="{TemplateBinding Background}"
                          d:DesignWidth="1500" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
                            <FadeImage x:Name="PART_ImageBackground"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <Border Background="{DynamicResource ScrimBrush}" Opacity="0.75" />
                            <!-- Vignette as a plain radial gradient to the panel color (no OpacityMask: animated covers above it would leave
                                 dark boxes on scaled displays, see reference.md). -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4" RadiusX="0.75" RadiusY="0.8">
                                        <GradientStop Color="#00000000" Offset="0.35" />
                                        <GradientStop Color="{Binding Background.Color, ElementName=LibraryRoot}" Offset="1" />
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <Border Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                            <Border.Background>
                                <ImageBrush ImageSource="{ThemeFile 'Images/grain.png'}" TileMode="Tile" Stretch="None"
                                            Viewport="0,0,256,256" ViewportUnits="Absolute" />
                            </Border.Background>
                        </Border>
                        <TopPanel DockPanel.Dock="Top" Grid.Row="0" />

                        <DockPanel Grid.Row="1">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}" />

                            <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                           DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}" />

                            <Grid DockPanel.Dock="Left">
                                <LibraryDetailsView x:Name="PART_ViewDetails" />
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
