<!--
    Overlay on Playnite Default/DerivedStyles/PropertyItemButton.xaml: the clickable field values of the game overview
    (a click filters the library by that value).
    Default: a value as the Options screen prints a combo value (PropertyItemForegroundBrush, ui_8 d8ba8c), amber
    (GlyphBrush) and underlined on hover, 1px vertical margin so link values and plain values stack at the same rhythm.
    Chip: when the owning ItemsControl has Tag="Chip" (platforms, genres, categories, features, tags), a small worn
    plate (PropertyItemBackgroundBrush with a 1px SlotBorderBrush edge and a lit top line), 3 x 8 padding,
    FontSizeSmall, square (ControlCornerRadius); hover brightens the plate (PropertyItemHoverBackgroundBrush) as the game
    does under the cursor. 4px gaps.
    Keyboard focus: FocusVisual on both.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                               TextWrapping="Wrap" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Background" Value="{DynamicResource PropertyItemBackgroundBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Chip" Padding="8,3,8,3" SnapsToDevicePixels="True"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1"
                                        Background="{TemplateBinding Background}">
                                    <TextBlock x:Name="Text" VerticalAlignment="Center"
                                               FontSize="{TemplateBinding FontSize}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}" />
                                </Border>
                                <Rectangle Height="1" Margin="1,1,1,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                           Fill="{DynamicResource BevelLightBrush}" Opacity="0.3" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
