<!--
    Cordon: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    The Options screen's rusted frame as a 44px band of worn steel (BevelTemplate: rust texture, lit top edge, dark
    bottom edge); the title sits on the lit plate of the current tab with a square amber lamp before it, in the title
    face; the radioactive trefoil of the Library icon is ghosted at 9% into the right end and the game's broken line
    closes the band. Caption buttons are the 40x32 WindowBarButton, so the caption and the content offset are 44
    (Default 25). PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource NormalBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource ShellBackgroundBrush}" ClipToBounds="True">
                                    <!-- The frame's steel plate: rust, lit top edge, dark bottom edge. -->
                                    <Control Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                             Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" />
                                    <!-- The radioactive trefoil of the Library icon, ghosted into the right end, and the game's broken line as the closing rule; both in a Canvas (no desired width). -->
                                    <Canvas IsHitTestVisible="False">
                                        <ContentControl Canvas.Right="130" Canvas.Top="-24" Width="92" Height="92" Opacity="0.09"
                                                        Content="{DynamicResource IconLibrary}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource TextBrush}" />
                                        <Line X1="0" Y1="0" X2="2600" Y2="0" Canvas.Top="41" Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1" StrokeDashArray="6 4" SnapsToDevicePixels="True" />
                                    </Canvas>
                                    <DockPanel LastChildFill="False">
                                        <!-- The title on the lit plate of the current tab, with the square amber lamp before it. -->
                                        <Grid DockPanel.Dock="Left" Margin="10,8,0,0" VerticalAlignment="Stretch">
                                            <Control Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                                     Background="{DynamicResource PrimaryButtonBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="12,0,20,0" VerticalAlignment="Center">
                                                <Border Width="12" Height="12" Margin="0,1,10,0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <Rectangle Width="6" Height="6" Fill="{DynamicResource GlyphBrush}" />
                                                </Border>
                                                <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                                           Foreground="{DynamicResource HeadingForegroundBrush}" TextTrimming="CharacterEllipsis"
                                                           Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,6,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
