<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml: the Play / Install button on the game page, as the lit
    plate of the current tab: BevelTemplate (Common.xaml) on PrimaryButtonBackgroundBrush (775f51, with the rust overlay
    and bevel), a SlotBorderBrush edge, the cream label (PrimaryButtonForegroundBrush) in the tab face
    (HeadingFontFamily) at FontSizeLarge, square, ButtonPadding, at least 40 tall. Left of the label sits the lamp of a
    lit toggle: a 6 x 14 amber bar (PrimaryButtonGlowBrush) in a dark housing. Hover: the lighter lit plate
    (PrimaryButtonHoverBackgroundBrush) and a soft amber halo around the lamp; pressed: PrimaryButtonPressedBackgroundBrush,
    the label 1px down. Keyboard focus: FocusVisual.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="34,6,22,6" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="Plate" Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False"
                                 Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SlotBorderBrush}" />
                        <Grid x:Name="Lamp" Width="10" Height="18" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Rectangle x:Name="Halo" Margin="-6,-6,-6,-6" Visibility="Hidden"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0.5">
                                <Rectangle.OpacityMask>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FF000000" Offset="0.2" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}"
                                    BorderThickness="1" Padding="1,1,1,1">
                                <Rectangle Fill="{DynamicResource PrimaryButtonGlowBrush}" />
                            </Border>
                        </Grid>
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
