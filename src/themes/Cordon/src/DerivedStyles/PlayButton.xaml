<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml: the Play / Install button on the game page, as the lit
    plate of the current tab: BevelTemplate (Common.xaml) on PrimaryButtonBackgroundBrush (775f51, with the rust overlay
    and bevel), a SlotBorderBrush edge, the cream label (PrimaryButtonForegroundBrush) in the tab face
    (HeadingFontFamily) at FontSizeLarge, square, ButtonPadding, at least 40 tall. Left of the label sits the lamp of a
    lit toggle: a 6 x 14 amber bar (PrimaryButtonGlowBrush) in a dark housing. Keyboard focus: FocusVisual.
    The game's UI barely moves (RESEARCH.md -> Motion): button states are instant texture and color swaps and a press
    shifts the plate and its label 1px right and down. So the motion here is small and honest:
      in  0.1s: the lighter lit plate (PrimaryButtonHoverBackgroundBrush, its own bevel layer) fades in and the lamp
          warms: its halo kindles over 0.25s and, while hovered, flickers faintly like an old filament (2.2s loop).
      out 0.2s: the plate fades back and the halo dies down (FillBehavior Stop on every exit).
    Pressed: its own darker plate (PrimaryButtonPressedBackgroundBrush) and the whole button shifts 1px right and down,
    as the engine's push offset does. The halo is a radial mask on the effect layer itself; nothing masked sits behind it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="34,6,22,6" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PushShift" X="0" Y="0" />
                        </Grid.RenderTransform>
                        <Control x:Name="Plate" Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False"
                                 Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SlotBorderBrush}" />
                        <Control x:Name="HoverPlate" Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False" Opacity="0"
                                 Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" />
                        <Control x:Name="PressPlate" Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False" Opacity="0"
                                 Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" />
                        <Grid x:Name="Lamp" Width="10" Height="18" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid x:Name="HaloFlicker" Margin="-6,-6,-6,-6" IsHitTestVisible="False">
                                <Rectangle x:Name="Halo" Visibility="Hidden" Opacity="0"
                                           Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                    <Rectangle.OpacityMask>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FF000000" Offset="0.2" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}"
                                    BorderThickness="1" Padding="1,1,1,1">
                                <Rectangle Fill="{DynamicResource PrimaryButtonGlowBrush}" />
                            </Border>
                        </Grid>
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Halo" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:2.2" BeginTime="0:0:0.25">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HaloFlicker" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.7" Value="0.8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.78" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.4" Value="0.88" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.46" Value="0.7" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.52" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HaloFlicker" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Halo" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.03" />
                                        <DoubleAnimation Storyboard.TargetName="PushShift" Storyboard.TargetProperty="X" To="1" Duration="0:0:0.03" />
                                        <DoubleAnimation Storyboard.TargetName="PushShift" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.03" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PushShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="PushShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
