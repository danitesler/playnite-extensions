<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml. An item on the steel rail: a 44 x 40 tile, its 16px
    glyph dim at rest (SidebarItemForegroundBrush, 877b74), beige under the pointer (TextBrush); the current item sits on
    a 32 x 32 lit plate (BevelTemplate on ToggleButtonCheckedBackgroundBrush, the current tab's 775f51, SlotBorderBrush
    edge) with its glyph bright (SidebarItemSelectedForegroundBrush) and a 2 x 16 amber lamp at the rail's outer edge
    (TabItemIndicatorBrush). Library and Statistics are drawn with Phosphor bold icons (the trefoil and a bar chart).
    PART_ProgressStatus (Playnite shows it while an add-on reports progress) is a 3px gauge along the tile's bottom edge.
    An item with no content is a bare marker: WarningBrush fill.
    Icon sizing (AGENTS.md "Sidebar Icon Sizing"): the fixed plate padding 14,12 leaves a 16 x 16 content area on the
    44 x 40 tile; {Binding IconPadding} is deliberately NOT used on top of it (the two stack and collapse add-on icons).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="{TemplateBinding Background}">
                        <Control x:Name="Plate" Visibility="Hidden" Width="32" Height="32"
                                 Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False"
                                 Background="{DynamicResource ToggleButtonCheckedBackgroundBrush}"
                                 BorderBrush="{DynamicResource SlotBorderBrush}" />
                        <Border x:Name="Lamp" Visibility="Hidden" Width="2" Height="16" HorizontalAlignment="Left"
                                Background="{DynamicResource TabItemIndicatorBrush}" />
                        <Border Padding="14,12">
                            <Viewbox x:Name="ItemIcon">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                        </Border>
                        <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                        IsHitTestVisible="False" Width="16" Height="16"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ContentTemplate="{DynamicResource IconTemplate}" />
                        <ProgressBar x:Name="PART_ProgressStatus" Height="3" Margin="6,0,6,1"
                                     BorderThickness="0" Background="Transparent"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Plate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Lamp" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="HorizontalAlignment" Value="Right" TargetName="Lamp" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Width" Value="16" TargetName="Lamp" />
                            <Setter Property="Height" Value="2" TargetName="Lamp" />
                            <Setter Property="HorizontalAlignment" Value="Center" TargetName="Lamp" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="Lamp" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Width" Value="16" TargetName="Lamp" />
                            <Setter Property="Height" Value="2" TargetName="Lamp" />
                            <Setter Property="HorizontalAlignment" Value="Center" TargetName="Lamp" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="Lamp" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
