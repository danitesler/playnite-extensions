<!--
    Frozen Throne Thumb: generic bevelled stone plate. ThumbBrush fill, lit top/left and dark bottom/right bevel, ControlCornerRadius,
    ThumbHoverBrush on hover, drag or when the owning Track has focus.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource ThumbBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="HoverRectangle" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="10"
                            Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelLightBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BevelShadowBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ThumbHoverBrush}" TargetName="HoverRectangle" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ThumbHoverBrush}" TargetName="HoverRectangle" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Track}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ThumbHoverBrush}" TargetName="HoverRectangle" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
