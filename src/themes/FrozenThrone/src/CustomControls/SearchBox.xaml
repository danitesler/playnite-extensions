<!--
    Frozen Throne SearchBox: inset stone well like TextBox (InputBackgroundBrush, InputBorderBrush rim, dark top/left inner edge,
    ControlCornerRadius, MinHeight 24). Search and clear icons in TextBrushDarker; hover InputHoverBorderBrush, focus within FocusBrush.
    Inner text input uses BareTextBox. Keeps PART_SeachIcon, PART_TextInpuText, PART_ClearTextIcon.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Border" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="{DynamicResource ControlBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelShadowBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <ContentControl x:Name="PART_SeachIcon" ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                                VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0"
                                                Foreground="{DynamicResource TextBrushDarker}" />
                                <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                         VerticalContentAlignment="Center" Padding="26,0,25,0" />
                                <ContentControl x:Name="PART_ClearTextIcon" ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                                FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"
                                                Foreground="{DynamicResource TextBrushDarker}" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Border" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
