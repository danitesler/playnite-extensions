<!--
    Frozen Throne icons: hand-drawn original line icons on a 24 unit grid, stroked 1.75 with round caps and joins.
    IconTemplate draws an Icon* geometry at IconSize in the inherited foreground (gold at rest, white on hover, set by the host).
    IconSmallTemplate draws the same geometry at 14px (search box glyphs). Both read the foreground from TextElement.Foreground,
    so any ContentControl or Button with Content set to a geometry and ContentTemplate set to a template works.
    Playnite's own menu icon TextBlocks (AddGameIcon, PlayIcon, ...) are deliberately not redefined here: Playnite rebuilds them from glyph and font.
    SearchTextIconTemplate and ClearTextIconTemplate (used by the search box) are redefined to draw IconSearch and IconClear.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="IconTemplate">
        <Viewbox Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="False">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="{x:Null}" StrokeThickness="1.75"
                      Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="False">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="{x:Null}" StrokeThickness="2"
                      Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Search box glyphs (Playnite keys, drawn from the theme icons). -->
    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentControl Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconSmallTemplate}" Focusable="False" IsHitTestVisible="False" />
    </DataTemplate>
    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentControl Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconSmallTemplate}" Focusable="False" IsHitTestVisible="False" />
    </DataTemplate>

    <!-- Top bar -->
