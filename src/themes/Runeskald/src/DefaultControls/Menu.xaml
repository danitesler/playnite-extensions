<!--
    Overlay on Playnite Default/DefaultControls/Menu.xaml. Every popup menu (hamburger menu, top bar dropdowns, game
    and group menus, tray) is God of War Ragnarok's equipment list on the frost-slate tablet of ContextMenu.xaml.
    Roles: TopLevelHeader and TopLevelItem (a horizontal Menu bar), SubmenuHeader and SubmenuItem (every popup menu).
    The Separator and MenuItem.SeparatorStyleKey are both redefined (the Default one points at its own sibling).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Foreground" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0,3,0,3" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource DividerTemplate}" Foreground="{TemplateBinding Foreground}" Height="9"
                             HorizontalAlignment="Stretch" VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group break in every menu, 10px: the modal rule. Fletched arrow tails at both ends, a hairline from each meeting
         the cream knot diamond in the centre. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" Margin="10,0,10,0" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="13" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="12" Height="7" VerticalAlignment="Center" Fill="{DynamicResource MenuSeparatorBrush}"
                              Data="M0,0 L3,0 L6,3 L12,3 L12,4 L6,4 L3,7 L0,7 L3,3.5 Z" />
                        <Rectangle Grid.Column="1" Height="1" Margin="0,0,3,0" VerticalAlignment="Center" Fill="{DynamicResource MenuSeparatorBrush}" />
                        <Path Grid.Column="2" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"
                              Fill="{DynamicResource HeadingForegroundBrush}"
                              Data="F0 M4.5,0 L9,4.5 L4.5,9 L0,4.5 Z M4.5,1.6 L7.4,4.5 L4.5,7.4 L1.6,4.5 Z M4.5,3.2 L5.8,4.5 L4.5,5.8 L3.2,4.5 Z" />
                        <Rectangle Grid.Column="3" Height="1" Margin="3,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource MenuSeparatorBrush}" />
                        <Path Grid.Column="4" Width="12" Height="7" VerticalAlignment="Center" Fill="{DynamicResource MenuSeparatorBrush}"
                              Data="M12,0 L9,0 L6,3 L0,3 L0,4 L6,4 L9,7 L12,7 L9,3.5 Z" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Rows of every popup menu, compact: 30px on the frost-slate tablet. Levers (docs/themes/menus.md):
        - Panel: ContextMenu.xaml (frost slate, header-band interlace on top, hanging knot diamond).
        - Row: fixed 26px icon column (16px icon at 0.8 at rest), chalk label, shortcuts in a stretched hexagon outline (the
          item cards' level shield) in cream Cinzel; checked rows draw a frost diamond socket (void well, frost rim and core).
        - Highlight (pointer or keyboard): the header band ("LEVIATHAN AXE"): frost slate (MenuItemHoverBrush) with its interlace
          and a lit foot, unrolling from the left (ScaleX 0.55 to 1) while fading in (0.13s CubicEase); the runic diamond socket
          lights frost behind the icon (scale 0.6 to 1); the label turns white and steps 2px right; the shortcut shield fills
          cream with dark ink. Out over 0.2s (FillBehavior=Stop).
        - Exit (gesture Alt+Q): rage-red label and shield at rest (5.0:1); on highlight the band turns blood red (DangerBrush)
          without its interlace, the socket rage red, the label white (DangerForegroundBrush, 6.9:1), the shield white with red ink.
        - Submenu headers: IconSubmenu on the right edge, frost while open, with a held band (no animation); submenus open on
          the same tablet, shifted up by the panel's 16px head so their first row lines up with the header.
        Recipe: docs/themes/menus.md.
    -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <Grid x:Name="MenuHover" Margin="0,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0,0.5" ClipToBounds="True">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="MenuHoverScale" ScaleX="0.55" />
                </Grid.RenderTransform>
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="0.75" Color="#E6000000" />
                        <GradientStop Offset="1" Color="#59000000" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <Rectangle x:Name="MenuBand" Fill="{DynamicResource MenuItemHoverBrush}" />
                <Rectangle x:Name="MenuKnot" Height="24" VerticalAlignment="Center" Opacity="0.32" Fill="{DynamicResource LocalRealmBlueBrush}">
                    <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/knot.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,48,24" Stretch="Fill" /></Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle x:Name="MenuFoot" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelLightBrush}" />
            </Grid>
            <Grid Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>
                <!-- the runic diamond socket (only shown on rows without an icon) -->
                <Grid x:Name="MenuSocketHost" Width="20" Height="20" Margin="-2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid x:Name="MenuSocket" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="MenuSocketScale" ScaleX="0.6" ScaleY="0.6" />
                        </Grid.RenderTransform>
                        <Path x:Name="MenuSocketFill" Stretch="Fill" Fill="{DynamicResource FrostGlowBrush}" Opacity="0.55" Data="M5,0 L10,5 L5,10 L0,5 Z" />
                        <Path x:Name="MenuSocketRim" Stretch="Fill" Stroke="{DynamicResource FrostHotBrush}" StrokeThickness="1" Data="M5,0 L10,5 L5,10 L0,5 Z" />
                    </Grid>
                </Grid>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.8" />
                <!-- checked: a frost diamond socket -->
                <Grid x:Name="GlyphPanel" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" Visibility="Collapsed">
                    <Path Stretch="Fill" Fill="{DynamicResource CheckBoxCheckMarkBkBrush}" Stroke="{DynamicResource CheckMarkBrush}" StrokeThickness="1" Data="M5,0 L10,5 L5,10 L0,5 Z" />
                    <Path Width="6" Height="6" Stretch="Fill" Fill="{DynamicResource CheckMarkBrush}" Data="M5,0 L10,5 L5,10 L0,5 Z" />
                </Grid>
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MenuLabelShift" X="0" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <!-- shortcut: the level shield, stretched -->
                <Grid x:Name="MenuKeycap" Grid.Column="2" Height="17" MinWidth="32" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Path x:Name="KeyShield" Stretch="Fill" Fill="Transparent" Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1"
                          Data="M5,0 L35,0 L40,9 L35,18 L5,18 L0,9 Z" />
                    <TextBlock x:Name="GestureText" Text="{TemplateBinding InputGestureText}" Margin="9,0,9,1" VerticalAlignment="Center" HorizontalAlignment="Center"
                               FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                               FontSize="11" Foreground="{DynamicResource LocalParchmentBrush}" />
                </Grid>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
                <Setter Property="Visibility" Value="Visible" TargetName="MenuSocketHost" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuSocketHost" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuKeycap" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuKeycap" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource NegativeRatingBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" TargetName="GestureText" />
                <Setter Property="Stroke" Value="{DynamicResource NegativeRatingBrush}" TargetName="KeyShield" />
                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" TargetName="MenuBand" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuKnot" />
                <Setter Property="Fill" Value="{DynamicResource NegativeRatingBrush}" TargetName="MenuFoot" />
                <Setter Property="Fill" Value="{DynamicResource NegativeRatingBrush}" TargetName="MenuSocketFill" />
                <Setter Property="Stroke" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuSocketRim" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" TargetName="Icon" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Setter Property="Fill" Value="{DynamicResource HeadingForegroundBrush}" TargetName="KeyShield" />
                <Setter Property="Stroke" Value="{DynamicResource HeadingForegroundBrush}" TargetName="KeyShield" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" TargetName="GestureText" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuSocket" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                            <DoubleAnimation Storyboard.TargetName="MenuHoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuSocket" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                            <DoubleAnimation Storyboard.TargetName="MenuSocketScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuSocketScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuLabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.13" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuSocket" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuSocket" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuLabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <!-- White ink on the blood band (6.9:1); the shield turns white with red ink -->
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Icon" />
                <Setter Property="Fill" Value="{DynamicResource DangerForegroundBrush}" TargetName="KeyShield" />
                <Setter Property="Stroke" Value="{DynamicResource DangerForegroundBrush}" TargetName="KeyShield" />
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" TargetName="GestureText" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held band while the submenu is open (no animation) -->
            <Grid x:Name="MenuHeld" Margin="0,1" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="1" Color="#59000000" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <Rectangle Fill="{DynamicResource MenuItemHoverBrush}" Opacity="0.7" />
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelLightBrush}" />
            </Grid>
            <Grid x:Name="MenuHover" Margin="0,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0,0.5" ClipToBounds="True">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="MenuHoverScale" ScaleX="0.55" />
                </Grid.RenderTransform>
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="0.75" Color="#E6000000" />
                        <GradientStop Offset="1" Color="#59000000" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <Rectangle Fill="{DynamicResource MenuItemHoverBrush}" />
                <Rectangle Height="24" VerticalAlignment="Center" Opacity="0.32" Fill="{DynamicResource LocalRealmBlueBrush}">
                    <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/knot.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,48,24" Stretch="Fill" /></Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelLightBrush}" />
            </Grid>
            <Grid Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="MenuSocketHost" Width="20" Height="20" Margin="-2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid x:Name="MenuSocket" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="MenuSocketScale" ScaleX="0.6" ScaleY="0.6" />
                        </Grid.RenderTransform>
                        <Path Stretch="Fill" Fill="{DynamicResource FrostGlowBrush}" Opacity="0.55" Data="M5,0 L10,5 L5,10 L0,5 Z" />
                        <Path Stretch="Fill" Stroke="{DynamicResource FrostHotBrush}" StrokeThickness="1" Data="M5,0 L10,5 L5,10 L0,5 Z" />
                    </Grid>
                </Grid>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.8" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MenuLabelShift" X="0" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <ContentControl x:Name="MenuArrow" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Focusable="False" Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource TextBrushDarker}" />
            </Grid>
            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                   HorizontalOffset="6" VerticalOffset="-16" Focusable="False" AllowsTransparency="True">
                <Grid MinWidth="200" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="0,16,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" Margin="5,0"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
                <Setter Property="Visibility" Value="Visible" TargetName="MenuSocketHost" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="MenuHeld" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="MenuArrow" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" TargetName="Icon" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="MenuArrow" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuSocket" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                            <DoubleAnimation Storyboard.TargetName="MenuHoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuSocket" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                            <DoubleAnimation Storyboard.TargetName="MenuSocketScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuSocketScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuLabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.13" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuSocket" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuSocket" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuLabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TopLevelHeader: a horizontal menu bar entry; highlighted it takes the header band. -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="Transparent">
            <Grid>
                <Control x:Name="HoverBorder" Visibility="Collapsed" Template="{DynamicResource RibbonTemplate}" Foreground="{DynamicResource MenuItemHoverBrush}" BorderBrush="{DynamicResource KnotworkBrush}" Focusable="False" />
                <TextBlock VerticalAlignment="Center" Padding="8,5" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                    <Grid MinWidth="200" Margin="0,4,0,0" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <StackPanel Margin="5,16,5,6" Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Grid>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="HoverBorder" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- TopLevelItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Style="{DynamicResource PopupBorder}">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
