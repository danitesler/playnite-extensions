<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu,
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is one panel, God of War Ragnarok's equipment tablet:
    - Panel: frost slate (PopupBackgroundBrush) lightening a step toward the foot (FrostSlateBrush), frost mottle
      (GrainTemplate in KnotworkBrush), a 1px PopupBorderBrush rim with 1px corners; along the top the header band's
      interlace (knot.png in KnotworkBrush, 8px) over a lit rule (BevelLightBrush) that fades out at both ends, with the
      band's cream knot diamond hanging from its centre (HeadingForegroundBrush).
    LocalMenuPanelTemplate is shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and
    CustomControls/FilterSelectionBox.xaml. Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Rectangle Margin="1" Fill="{DynamicResource FrostSlateBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.2" Color="#00000000" />
                        <GradientStop Offset="1" Color="#B3000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Control Template="{DynamicResource GrainTemplate}" Margin="1"
                     Foreground="{DynamicResource KnotworkBrush}" Opacity="0.10"
                     Focusable="False" IsTabStop="False" />
            <!-- the header band's interlace and its lit rule -->
            <Rectangle Height="8" Margin="1,1,1,0" VerticalAlignment="Top" Opacity="0.6" Fill="{DynamicResource KnotworkBrush}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/knot.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,16,8" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" Margin="1,9,1,0" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="0.3" Color="#FF000000" />
                        <GradientStop Offset="0.7" Color="#FF000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <!-- the knot diamond hanging from the band's centre -->
            <Path Width="11" Height="11" Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Fill="{DynamicResource HeadingForegroundBrush}"
                  Data="F0 M5.5,0 L11,5.5 L5.5,11 L0,5.5 Z M5.5,1.8 L9.2,5.5 L5.5,9.2 L1.8,5.5 Z M5.5,3.8 L7.2,5.5 L5.5,7.2 L3.8,5.5 Z" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,16,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="5,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
