<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LocalSilverRailTemplate: the field's engraved silver rail, shared by TextBox, PasswordBox and ComboBox. The menus
        end their strips in forks, so a field closes on a 2px silver rail whose two ends split into a fork of two 1px
        prongs rising 6px. Rest: the rail is the dim rule. Hover: silver (TextBrush). Keyboard focus: bright silver (GlyphBrush)
        and a cold silver glow lifts 9px off the rail (0.2s). State comes from the nearest Control above.
    -->
    <ControlTemplate x:Key="LocalSilverRailTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle x:Name="Glow" Height="9" VerticalAlignment="Bottom" Margin="2,0,2,2" Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Offset="0" Color="#40FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="Rail" Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource NormalBorderBrush}" />
            <Rectangle x:Name="ForkL1" Width="1" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,2" Fill="{DynamicResource NormalBorderBrush}" />
            <Rectangle x:Name="ForkL2" Width="1" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,2" Fill="{DynamicResource NormalBorderBrush}" />
            <Rectangle x:Name="ForkR1" Width="1" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2" Fill="{DynamicResource NormalBorderBrush}" />
            <Rectangle x:Name="ForkR2" Width="1" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,2" Fill="{DynamicResource NormalBorderBrush}" />
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <Setter TargetName="Rail" Property="Fill" Value="{DynamicResource TextBrush}" />
                <Setter TargetName="ForkL1" Property="Fill" Value="{DynamicResource TextBrush}" />
                <Setter TargetName="ForkL2" Property="Fill" Value="{DynamicResource TextBrush}" />
                <Setter TargetName="ForkR1" Property="Fill" Value="{DynamicResource TextBrush}" />
                <Setter TargetName="ForkR2" Property="Fill" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Rail" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="ForkL1" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="ForkL2" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="ForkR1" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="ForkR2" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="GlowIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="GlowIn" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <Control x:Name="FieldOverlay" Template="{DynamicResource LocalSilverRailTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Border" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless text box for hosts that draw their own chrome (search box, editable dropdown). -->
    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
