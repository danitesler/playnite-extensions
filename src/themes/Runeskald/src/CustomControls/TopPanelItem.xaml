<!--
    Runeskald: TopPanelItem. A bare 34px cell with a smoke glyph; hover fades a slate tile in under it and brightens the
    glyph. Toggled (current view, open panel): the tab strip's silver plate (brushed silver darkening a step to the right, a
    lit top line) with a black glyph. Items with Tag "Tick" (the view switches, set in TopPanel.xaml) carry the tab strip's
    5px diamond tick in the gap on their left. Colors: SidebarItemForegroundBrush, TopPanelItemHoverBackgroundBrush,
    TopPanelItemCheckedBackgroundBrush, SelectedBorderBrush, SelectedSheenBrush, SelectedForegroundBrush, FrameHoverBrush.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TopPanelItem}">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Margin" Value="5,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanelItem}">
                    <Grid>
                        <Path x:Name="Tick" Width="5" Height="5" Margin="-8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                              Fill="{DynamicResource FrameHoverBrush}" Data="M2.5,0 L5,2.5 L2.5,5 L0,2.5 Z" IsHitTestVisible="False" />
                        <Border x:Name="HoverPlate" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1"
                                Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                        <Grid x:Name="Marks" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Rectangle Fill="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                            <Rectangle Fill="{DynamicResource SelectedBorderBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0.4" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#B3000000" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource SelectedSheenBrush}" />
                            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource SelectedBorderBrush}" />
                        </Grid>
                        <Border x:Name="Border" BorderThickness="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsToggled" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Marks" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="HoverPlate" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Tick">
                            <Setter Property="Visibility" Value="Visible" TargetName="Tick" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsToggled" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
