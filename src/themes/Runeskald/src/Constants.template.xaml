<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). HeadingFontFamily is a shared key: titles and section headings. -->
    <sys:Double x:Key="FontSizeSmall">{{px:size-caption}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:size-body}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:size-lead}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:size-title}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:size-display}}</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Jost, {{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Jost, {{text:font-heading|Segoe UI}}</FontFamily>

    <!-- Shape (Playnite keys): hairline strokes, square corners (ControlCornerRadius is 0 and no other radius step is needed). -->
    <Thickness x:Key="PopupBorderThickness">{{px:stroke-hair}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:stroke-hair}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:stroke-hair}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:corner-none}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>



    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{snow}}</Color>
    <Color x:Key="TextColorDarker">{{mist}}</Color>
    <Color x:Key="TextColorDark">{{iron-ink}}</Color>
    <Color x:Key="MainColor">{{blue-iron}}</Color>
    <Color x:Key="MainColorDark">{{deep-iron}}</Color>
    <Color x:Key="HoverColor">{{polish-bright}}</Color>
    <Color x:Key="GlyphColor">{{silver}}</Color>
    <Color x:Key="HighlightGlyphColor">{{steel-hover}}</Color>
    <Color x:Key="PopupBackgroundColor">{{tray}}</Color>
    <Color x:Key="PopupBorderColor">{{bright-etch@tray}}</Color>
    <Color x:Key="BackgroundToneColor">{{blue-iron}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{blue-iron/70}}</Color>   <!-- the slot behind each cover -->
    <Color x:Key="PanelSeparatorColor">{{etch}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{etch}}</Color>
    <Color x:Key="DataChangeNotifColor">{{amber}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the theme's
         own Normal color, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{bright-etch}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{tray}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{polish}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{coal}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{sage}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{oxide-lit}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{amber}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{oxide-lit}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{blue-iron}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{coal}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{coal}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{deep-iron}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{blue-iron}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{coal/60}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{coal/85}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{mist}}" />


    <SolidColorBrush x:Key="SelectedBrush" Color="{{steel-wash}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{steel-hover}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{snow}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{vitality}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{polish}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{steel-wash}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{silver}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{silver}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{oxide}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{snow}}" />


    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{polish-bright}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{steel-wash}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{silver}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{silver-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{silver-struck}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{iron-ink}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{steel-wash}}" />


    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{coal/60}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{silver-struck}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{mist}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{silver}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{bright-etch}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{deep-iron}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{silver-lit}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{silver-lit}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{etch}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{bright-etch}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{silver}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{polish}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{bright-etch}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{silver}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{silver}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{mist}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{silver-lit}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{polish-bright}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{steel-wash}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{etch}}" />
    <SolidColorBrush x:Key="LocalParchmentBrush" Color="{{parchment}}" />
    <SolidColorBrush x:Key="LocalRealmBlueBrush" Color="{{realm-blue}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{coal}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{silver-struck}}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{snow}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{silver-lit}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{etch}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{silver}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{bright-etch}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{silver}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{mist}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{snow}}" />
    <SolidColorBrush x:Key="FrostSlateBrush" Color="{{blue-iron}}" />
    <SolidColorBrush x:Key="FrostSlateDeepBrush" Color="{{tray}}" />
    <SolidColorBrush x:Key="KnotworkBrush" Color="{{mist}}" />
    <SolidColorBrush x:Key="FrostGlowBrush" Color="{{silver-struck}}" />
    <SolidColorBrush x:Key="FrostHotBrush" Color="{{silver-lit}}" />
    <SolidColorBrush x:Key="GoldLeafBrush" Color="{{silver}}" />
    <SolidColorBrush x:Key="GoldLeafDeepBrush" Color="{{silver-struck}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{etch}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{bright-etch}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{etch}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{parchment}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{bright-etch}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{bright-etch}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{coal}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{parchment}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{bright-etch}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{silver-lit}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{coal}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{bright-etch}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{silver-lit}}" />
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{parchment}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{realm-blue}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{bright-etch}}" />
    <SolidColorBrush x:Key="LocalPlayHoverTextBrush" Color="{{snow}}" />
</ResourceDictionary>
