<!--
    Runeskald: left rail, 44px of the void with faint frost mottle, closed by a hairline on its inner side (the pause menu's
    icon column). The main menu is the HUD's round weapon socket: a 32px slate disc in a hairline ring with four ticks at the
    compass points, holding the diamond rune mark in cream. Hover lights the ring frost and breathes a frost glow in (160 ms).
    With the sidebar at the top or bottom the hairline runs along the inner edge instead. Colors: ShellBackgroundBrush,
    MainMenuButtonBackgroundBrush, MainMenuButtonForegroundBrush, FrameBrush, NormalBorderBrush, FrostHotBrush, FrostGlowBrush.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <Control x:Name="Grain" Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource KnotworkBrush}" Opacity="0.08" Focusable="False" />
                            <!-- The icon column's hairline. -->
                            <Rectangle x:Name="EdgeLine" Width="1" HorizontalAlignment="Right" Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="52" Margin="0,0,0,0"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid x:Name="MenuSocketHost" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- frost glow, collapsed at rest -->
                                        <Ellipse x:Name="MenuGlow" Width="40" Height="40" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Fill="{DynamicResource FrostGlowBrush}">
                                            <Ellipse.OpacityMask>
                                                <RadialGradientBrush>
                                                    <GradientStop Offset="0.55" Color="#99000000" />
                                                    <GradientStop Offset="1" Color="#00000000" />
                                                </RadialGradientBrush>
                                            </Ellipse.OpacityMask>
                                        </Ellipse>
                                        <!-- the four compass ticks -->
                                        <Rectangle x:Name="TickN" Width="2" Height="4" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}" IsHitTestVisible="False" />
                                        <Rectangle x:Name="TickS" Width="2" Height="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}" IsHitTestVisible="False" />
                                        <Rectangle x:Name="TickW" Width="4" Height="2" VerticalAlignment="Center" HorizontalAlignment="Left" Fill="{DynamicResource NormalBorderBrush}" IsHitTestVisible="False" />
                                        <Rectangle x:Name="TickE" Width="4" Height="2" VerticalAlignment="Center" HorizontalAlignment="Right" Fill="{DynamicResource NormalBorderBrush}" IsHitTestVisible="False" />
                                        <Ellipse x:Name="MenuDisc" Width="32" Height="32" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1" />
                                        <Ellipse Width="30" Height="30" IsHitTestVisible="False" Fill="{DynamicResource SelectedSheenBrush}" Opacity="0.1">
                                            <Ellipse.OpacityMask>
                                                <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.7" RadiusY="0.7">
                                                    <GradientStop Offset="0" Color="#FF000000" />
                                                    <GradientStop Offset="1" Color="#00000000" />
                                                </RadialGradientBrush>
                                            </Ellipse.OpacityMask>
                                        </Ellipse>
                                        <Control x:Name="MenuMark" Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                 Width="18" Height="18" Focusable="False" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Grain" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Stroke" Value="{DynamicResource FrostHotBrush}" TargetName="MenuDisc" />
                            <Setter Property="Fill" Value="{DynamicResource FrostHotBrush}" TargetName="TickN" />
                            <Setter Property="Fill" Value="{DynamicResource FrostHotBrush}" TargetName="TickS" />
                            <Setter Property="Fill" Value="{DynamicResource FrostHotBrush}" TargetName="TickW" />
                            <Setter Property="Fill" Value="{DynamicResource FrostHotBrush}" TargetName="TickE" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuGlowIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="MenuGlowIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="1" TargetName="EdgeLine" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="1" TargetName="EdgeLine" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="EdgeLine" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
