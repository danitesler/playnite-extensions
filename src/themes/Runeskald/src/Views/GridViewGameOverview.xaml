                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Control Template="{DynamicResource WorldTreeTemplate}" Foreground="{DynamicResource KnotworkBrush}" Opacity="0.22" Width="480" Height="360"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40" Focusable="False" IsHitTestVisible="False">
                                            <Control.Style>
                                                <Style TargetType="Control">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="TreeBreath">
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.16" To="0.34" Duration="0:0:2">
                                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="TreeBreath" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Control.Style>
                                        </Control>
                                        <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10" IsHitTestVisible="False">
                                            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                                <Path Stretch="Fill" Fill="{DynamicResource ShellBackgroundBrush}" Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1" Data="M5,0 L10,5 L5,10 L0,5 Z" />
                                                <Path Margin="10" Stretch="Fill" Fill="{DynamicResource FrostGlowBrush}" Data="M5,0 L10,5 L5,10 L0,5 Z">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="CoreBreath">
                                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.9" Duration="0:0:2">
                                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <RemoveStoryboard BeginStoryboardName="CoreBreath" />
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource HeadingForegroundBrush}" Margin="17" Focusable="False" />
                                            </Grid>
                                            <Grid Height="44" Margin="0,18,0,0">
                                                <Grid.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="#00000000" />
                                                        <GradientStop Offset="0.25" Color="#FF000000" />
                                                        <GradientStop Offset="0.75" Color="#FF000000" />
                                                        <GradientStop Offset="1" Color="#00000000" />
                                                    </LinearGradientBrush>
                                                </Grid.OpacityMask>
                                                <Rectangle Fill="{DynamicResource HeaderBandBrush}" />
                                                <Rectangle Height="24" VerticalAlignment="Center" Opacity="0.45" Fill="{DynamicResource KnotworkBrush}">
                                                    <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/knot.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,48,24" Stretch="Fill" /></Rectangle.OpacityMask>
                                                </Rectangle>
                                                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource StripeBrush}" />
                                            </Grid>
                                            <ContentControl Margin="0,-34,0,0" HorizontalAlignment="Center" Content="{DynamicResource LOCErrorNoGameSelected}" Focusable="False" IsTabStop="False"
                                                            FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource HeadingForegroundBrush}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" TextWrapping="Wrap" TextAlignment="Center" />
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                            <Grid Height="9" Width="240" Margin="0,20,0,0">
                                                <Rectangle Height="1" Margin="12,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}" />
                                                <Grid Height="9" IsHitTestVisible="False">
                                                    <Path Width="12" Height="7" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}"
                                                          Data="M0,0 L3,0 L6,3 L12,3 L12,4 L6,4 L3,7 L0,7 L3,3.5 Z" />
                                                    <Path Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource HeadingForegroundBrush}" Opacity="0.85"
                                                          Data="F0 M4.5,0 L9,4.5 L4.5,9 L0,4.5 Z M4.5,1.6 L7.4,4.5 L4.5,7.4 L1.6,4.5 Z M4.5,3.2 L5.8,4.5 L4.5,5.8 L3.2,4.5 Z" />
                                                    <Path Width="12" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}"
                                                          Data="M12,0 L9,0 L6,3 L0,3 L0,4 L6,4 L9,7 L12,7 L9,3.5 Z" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                        <Button x:Name="SidePanelCloseButton" Tag="{DynamicResource GameBannerHeight}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" Width="28" Height="28" Padding="0"
                                Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}"
                                Command="{MainViewModel CloseGameSideBarCommand}">
<Button.Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Visibility" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Collapsed` : `Visible`'}" />
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</Button.Style>
                            <!-- Close: a 28x28 plate that reads at rest (the theme's button plate, a rim and a bright glyph) and turns the danger color on hover. -->
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Grid Background="Transparent">
                                        <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource ShellBackgroundBrush}"
                                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" IsHitTestVisible="False" />
                                        <Border x:Name="HoverPlate" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource DangerBrush}" Opacity="0" IsHitTestVisible="False" />
                                        <ContentControl x:Name="Glyph" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                        Content="{DynamicResource IconWindowClose}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource TextBrush}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                            <Trigger.EnterActions>
                                                <BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                </Storyboard></BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard><Storyboard>
                                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                </Storyboard></BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="HoverPlate" Property="Opacity" Value="0.7" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
</Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
