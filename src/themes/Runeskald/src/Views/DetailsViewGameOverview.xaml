<Border BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,1,0"
                                            Margin="2,0,0,0" Padding="0,0,24,0">
                                        <StackPanel>
                                            <Grid x:Name="SteamScreenshotsGameScope">
                                                <!-- Plugin visibility is shared: a late Steam load must never reveal a different game's section. -->
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Game.Source.Name}" Value="Steam">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library or Steam source games in that gap; give up after 12s so a game without screenshots does not keep an empty block. When the plugin is not installed or is disabled the binding fails, FallbackValue=PluginUnavailable matches neither True nor False, and no skeleton shows. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                    <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                    <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <StackPanel Margin="0,0,0,28">
                                                    <TextBlock Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" Margin="0,4,0,0"
                                                               Style="{DynamicResource HeadingTextBlock}" />
                                                    <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />
                                                    <Grid Margin="0,5,0,5">
                                                        <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                        <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                            <Control.Style>
                                                                <Style TargetType="Control">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Control.Style>
                                                        </Control>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                            </Grid>

                                            <StackPanel Name="PART_ElemDescription" Margin="0,0,0,20">
                                                <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Margin="0,4,0,0"
                                                           Style="{DynamicResource HeadingTextBlock}" />
                                                <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />
                                                <HtmlTextView Name="PART_HtmlDescription"
                                                              Margin="0,5,0,5"
                                                              HtmlFontSize="{DynamicResource FontSize}"
                                                              HtmlFontFamily="{DynamicResource FontFamily}"
                                                              HtmlForeground="{DynamicResource TextColor}"
                                                              LinkForeground="{DynamicResource GlyphColor}"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                              pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                            </StackPanel>

                                            <StackPanel Name="PART_ElemNotes">
                                                <TextBlock Text="{DynamicResource LOCNotesLabel}" Margin="0,4,0,0"
                                                           Style="{DynamicResource HeadingTextBlock}" />
                                                <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />
                                                <TextBox Name="PART_TextNotes" IsReadOnly="True"
                                                         BorderThickness="0" Background="Transparent"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         Margin="-1,5,-1,5" Padding="0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
</Grid>
</Grid>
                            </Grid>
                        </Grid>
</Grid>

                    <Grid VerticalAlignment="Top" Height="{Binding ViewportHeight, ElementName=PART_ScrollViewHost}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Control Template="{DynamicResource WorldTreeTemplate}" Foreground="{DynamicResource KnotworkBrush}" Opacity="0.22" Width="480" Height="360"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40" Focusable="False" IsHitTestVisible="False">
                                    <Control.Style>
                                        <Style TargetType="Control">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="TreeBreath">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.16" To="0.34" Duration="0:0:2">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="TreeBreath" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Control.Style>
                                </Control>
                                <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10" IsHitTestVisible="False">
                                    <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                        <Path Stretch="Fill" Fill="{DynamicResource ShellBackgroundBrush}" Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1" Data="M5,0 L10,5 L5,10 L0,5 Z" />
                                        <Path Margin="10" Stretch="Fill" Fill="{DynamicResource FrostGlowBrush}" Data="M5,0 L10,5 L5,10 L0,5 Z">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="CoreBreath">
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.9" Duration="0:0:2">
                                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="CoreBreath" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource HeadingForegroundBrush}" Margin="17" Focusable="False" />
                                    </Grid>
                                    <Grid Height="44" Margin="0,18,0,0">
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#00000000" />
                                                <GradientStop Offset="0.25" Color="#FF000000" />
                                                <GradientStop Offset="0.75" Color="#FF000000" />
                                                <GradientStop Offset="1" Color="#00000000" />
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>
                                        <Rectangle Fill="{DynamicResource HeaderBandBrush}" />
                                        <Rectangle Height="24" VerticalAlignment="Center" Opacity="0.45" Fill="{DynamicResource KnotworkBrush}">
                                            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/knot.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,48,24" Stretch="Fill" /></Rectangle.OpacityMask>
                                        </Rectangle>
                                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource StripeBrush}" />
                                    </Grid>
                                    <ContentControl Margin="0,-34,0,0" HorizontalAlignment="Center" Content="{DynamicResource LOCErrorNoGameSelected}" Focusable="False" IsTabStop="False"
                                                    FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource HeadingForegroundBrush}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" TextWrapping="Wrap" TextAlignment="Center" />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                    <Grid Height="9" Width="240" Margin="0,20,0,0">
                                        <Rectangle Height="1" Margin="12,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}" />
                                        <Grid Height="9" IsHitTestVisible="False">
                                            <Path Width="12" Height="7" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}"
                                                  Data="M0,0 L3,0 L6,3 L12,3 L12,4 L6,4 L3,7 L0,7 L3,3.5 Z" />
                                            <Path Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource HeadingForegroundBrush}" Opacity="0.85"
                                                  Data="F0 M4.5,0 L9,4.5 L4.5,9 L0,4.5 Z M4.5,1.6 L7.4,4.5 L4.5,7.4 L1.6,4.5 Z M4.5,3.2 L5.8,4.5 L4.5,5.8 L3.2,4.5 Z" />
                                            <Path Width="12" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}"
                                                  Data="M12,0 L9,0 L6,3 L0,3 L0,4 L6,4 L9,7 L12,7 L9,3.5 Z" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Grid>
</Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>