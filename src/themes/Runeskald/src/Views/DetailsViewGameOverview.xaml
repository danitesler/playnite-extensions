<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible"
                                  Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible"
                                  x:Name="PART_ScrollViewHost">
                        <Grid x:Name="PageRoot">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border x:Name="PageSwatch" Background="{DynamicResource ContentBackgroundBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                            <Grid x:Name="PageContent">
<Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            <!-- No OpacityMask on the banner: it sits behind the animated Play button, and masked art repainted in part leaves dark seams
                                     on scaled displays. The fade is a plain gradient to the page color, read from the page's own brush. -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#00000000" Offset="0.12" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageSwatch}" Offset="0.96" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
<Grid>
                            <!-- Background art, a short band. Cached, cropped, faded at the bottom, dimmed by a veil. -->


                            <Grid HorizontalAlignment="Stretch" Margin="24,0,41,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- A short strip of art above the hero row. Collapses with the hero when the game has no background. -->
                                <Border Grid.Row="0"  IsHitTestVisible="False" x:Name="DetailsBannerSpacer" MinHeight="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 158 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="0" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="0" />
</DataTrigger>
</Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <DockPanel Margin="0,24,0,28" MaxWidth="1024" Grid.Row="1"
                                           Background="Transparent">

                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="28,0,6,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageCover}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                                Background="{DynamicResource GridItemBackgroundBrush}">
                                            <Image Name="PART_ImageCover"
                                                   Height="{Settings GameDetailsCoverHeight}"
                                                   StretchDirection="Both" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                        </Border>
                                        <Control Margin="-5" Focusable="False" IsHitTestVisible="False"
                                                 Template="{DynamicResource CornerMarksTemplate}"
                                                 Foreground="{DynamicResource GlyphBrush}" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                        <Grid Width="172" Height="44" VerticalAlignment="Center">
                                            <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                            <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                            <Control Style="{DynamicResource RunningActionIndicator}" />
                                        </Grid>
                                        <Button x:Name="PART_ButtonMoreActions" Style="{DynamicResource LocalGameActionSocket}" Width="44" Height="44" Padding="0" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="{DynamicResource LOCMoreAction}"
                                                Background="{DynamicResource SecondaryButtonBackgroundBrush}" BorderBrush="{DynamicResource SecondaryButtonBorderBrush}">
                                            <ContentControl Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                        <Button x:Name="PART_ButtonEditGame" Style="{DynamicResource LocalGameActionSocket}" Width="44" Height="44" Padding="0" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{DynamicResource LOCEditGame}"
                                                Background="{DynamicResource SecondaryButtonBackgroundBrush}" BorderBrush="{DynamicResource SecondaryButtonBorderBrush}">
                                            <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>

                                    <DockPanel VerticalAlignment="Bottom" MinHeight="44">
                                        <Image Name="PART_ImageIcon" MaxHeight="40" MaxWidth="40"
                                               DockPanel.Dock="Left" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="Fant" />
                                        <TextBlock Name="PART_TextDisplayName"
                                                   FontFamily="{DynamicResource HeadingFontFamily}"
                                                   FontSize="{DynamicResource FontSizeLargest}"
                                                   Typography.Capitals="SmallCaps"
                                                   Margin="0,0,10,0" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                </DockPanel>

                                <Grid MaxWidth="1024" Grid.Row="2" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 28 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="28,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,28,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
<StackPanel Margin="0,0,0,0" Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch" x:Name="DetailsMetadataContent">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <TextBlock Text="{DynamicResource LOCGameDetails}" Margin="0,4,0,0"
                                                   Style="{DynamicResource HeadingTextBlock}" />
                                        <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />

                                        <StackPanel Margin="0,0,0,10">
                                            <Border ClipToBounds="True" x:Name="DetailsMetadataViewport">
                                                <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-33,0,-8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-33,-24,-8" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Margin" Value="0,-8,0,-8" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-8,-24,-8" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Margin" Value="0,-8,0,-8" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-8,-24,-8" /></MultiDataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                    <Border x:Name="MetaProgress" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}"><Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers><MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
</Border>
<Grid x:Name="PART_ElemCompletionStatus" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource HeadingTextBlock}" FontWeight="Normal" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <Button Grid.Column="1" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
<Grid x:Name="PART_ElemPlayTime" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource HeadingTextBlock}" FontWeight="Normal" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextPlayTime" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
<Grid x:Name="PART_ElemLastPlayed" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource HeadingTextBlock}" FontWeight="Normal" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextLastActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
<Grid x:Name="PART_ElemRecentActivity" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource HeadingTextBlock}" FontWeight="Normal" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
<Grid x:Name="PART_ElemAdded" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource HeadingTextBlock}" FontWeight="Normal" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
<Border x:Name="MetaScores" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}"><Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers><MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
</Border>
<Grid x:Name="PART_ElemCommunityScore" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource HeadingTextBlock}" FontWeight="Normal" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                            </Grid>
<Grid x:Name="PART_ElemCriticScore" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource HeadingTextBlock}" FontWeight="Normal" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                            </Grid>
<Grid x:Name="PART_ElemUserScore" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCUserScore}" Style="{DynamicResource HeadingTextBlock}" FontWeight="Normal" FontSize="{DynamicResource FontSize}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                <TextBlock Grid.Column="1" x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                            </Grid>
<Border x:Name="MetaAbout" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}"><Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers><MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
</Border>
<Grid x:Name="PART_ElemDevelopers" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
