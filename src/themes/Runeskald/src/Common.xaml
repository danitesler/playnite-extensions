<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">


    <Geometry x:Key="LocalClaspGeometry">M2 12 L9 5 L15 11 L13 13 L9 9 L6 12 L10 16 L8 18 Z M10 13 L12 11 L16 15 L19 12 L15 8 L17 6 L23 12 L16 19 Z</Geometry>
    <ImageBrush x:Key="LocalMistMask" ImageSource="{ThemeFile 'Images/fx/mist.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalSilverLeafMask" ImageSource="{ThemeFile 'Images/fx/silver-leaf.png'}" Stretch="Fill" />

    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False">
            <Path Width="20" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Stretch="Fill" Fill="{TemplateBinding Foreground}" Data="M0,0 H20 L16,3 H7 L3,7 V10 L0,13 Z M7,6 L11,2 L15,6 L11,10 Z M11,4 L9,6 L11,8 L13,6 Z" />
            <Path Width="20" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Stretch="Fill" Fill="{TemplateBinding Foreground}" Data="M20,13 H0 L4,10 H13 L17,6 V3 L20,0 Z M13,7 L9,11 L5,7 L9,3 Z M9,9 L11,7 L9,5 L7,7 Z" />
        </Grid>
    </ControlTemplate>


    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="9" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Height="1" Margin="14,0,0,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="0.5" Color="#80000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Path Width="16" Height="9" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" Data="M0,0 L4,0 L8,4 L16,4 L16,5 L8,5 L4,9 L0,9 L4,4.5 Z" />
        </Grid>
    </ControlTemplate>


    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource LocalParchmentBrush}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>


    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Margin="-3" IsHitTestVisible="False" Focusable="False"
                             Template="{DynamicResource CornerMarksTemplate}"
                             Foreground="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing: roomier than a desktop app, like the menus (32 to 36px controls, 8px rhythm). -->
    <Thickness x:Key="ButtonPadding">18,5,18,5</Thickness> <!-- Button: 36px tall inside the 1px edge (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">10,5,10,5</Thickness> <!-- Text box, password box, dropdown: 34px (height now set by ControlHeight) -->
    <Thickness x:Key="MenuPadding">4</Thickness> <!-- Menu and context menu surface -->
    <Thickness x:Key="MenuItemPadding">14,8,14,8</Thickness> <!-- Menu item: 34px -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness> <!-- Dropdown surface -->
    <Thickness x:Key="ComboBoxItemPadding">12,7,12,7</Thickness> <!-- Dropdown item -->
    <Thickness x:Key="ListBoxItemPadding">12,7,12,7</Thickness> <!-- List box item -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness> <!-- Group box body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness> <!-- Gap under the group box header -->
    <Thickness x:Key="TooltipPadding">12,7,12,8</Thickness> <!-- Tooltip -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">20</sys:Double> <!-- Top bar and sidebar icons -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Both views start on the right. Center and Stretch flow above media. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, so the real carousel replaces it without the page jumping. Each Viewbox scales a fixed 1600px
         layout to the width its column gives it (height is unbounded in a vertical stack). The tiles are the host's
         Foreground at low opacity; the whole thing pulses while visible. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the plugin's ContentControl, visible while that control has no height. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="16"
                        Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalArmoryChoiceTemplate" TargetType="{x:Type CheckBox}">
        <Grid Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <Rectangle Height="1" Margin="8,0" VerticalAlignment="Bottom" Fill="{DynamicResource PanelSeparatorBrush}" />
            <Border x:Name="Foil" Visibility="Collapsed" Opacity="0" Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                    OpacityMask="{DynamicResource LocalSilverLeafMask}" RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                <Border.RenderTransform><ScaleTransform x:Name="FoilScale" ScaleX="0.93" /></Border.RenderTransform>
            </Border>
            <Grid Margin="9,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Path x:Name="Clasp" Width="16" Height="10" HorizontalAlignment="Center" Visibility="Collapsed"
                      Stretch="Uniform" Data="{DynamicResource LocalClaspGeometry}" Fill="{TemplateBinding Foreground}" />
                <Rectangle x:Name="Mixed" Width="9" Height="2" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" />
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Clasp" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Mixed" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter TargetName="Foil" Property="Visibility" Value="Visible" /><Setter TargetName="Foil" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Trigger.EnterActions><BeginStoryboard Name="TemperIn"><Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Foil" Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetName="Foil" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="FoilScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard Name="TemperOut"><Storyboard FillBehavior="Stop">
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Foil" Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetName="Foil" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                </Storyboard></BeginStoryboard><RemoveStoryboard BeginStoryboardName="TemperIn" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
<Style x:Key="LocalGameActionSocket" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="Lift" X="0" Y="0" />
                        </Grid.RenderTransform>
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="HoverPlate" Margin="{TemplateBinding BorderThickness}" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource ButtonHoverBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="PressedPlate" Margin="{TemplateBinding BorderThickness}" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource ButtonPressedBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Rectangle x:Name="TopEdge" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Opacity="0.6" IsHitTestVisible="False" />
                        <Rectangle x:Name="LampLine" Height="1" Margin="2,0,2,1" VerticalAlignment="Bottom" Fill="{DynamicResource FrostHotBrush}" Opacity="0" IsHitTestVisible="False" />
                        <!-- Default button: the gold leaf's embossed interlace and its lit top edge. -->
                        <Grid x:Name="Ring" Visibility="Collapsed" Margin="1" ClipToBounds="True" IsHitTestVisible="False">
                            <Rectangle Fill="{DynamicResource GoldLeafDeepBrush}" Opacity="0.22">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/knot.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,24,12" Stretch="Fill" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource PrimaryButtonBorderBrush}" />
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TopEdge" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="PressedPlate" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LampLine" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LampLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LampLine" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                <Setter Property="Padding" Value="24,4" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
<ControlTemplate x:Key="GrainTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/grain.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>
<ControlTemplate x:Key="SelectionBarTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/silver.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" VerticalAlignment="Top" Margin="0,1,0,0" Opacity="0.6" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="0.45" Color="#99000000" />
                        <GradientStop Offset="0.7" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>
<ControlTemplate x:Key="RibbonTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" ClipToBounds="True">
            <Grid.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FF000000" />
                    <GradientStop Offset="0.6" Color="#E6000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Grid.OpacityMask>
            <Rectangle Fill="{TemplateBinding Foreground}" />
            <Rectangle Height="24" VerticalAlignment="Center" Opacity="0.45" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/knot.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,48,24" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource StripeBrush}" />
        </Grid>
    </ControlTemplate>
<ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="72" Height="72">
                <Path Fill="{TemplateBinding Foreground}" Data="F0 M36,2 L70,36 L36,70 L2,36 Z M36,9 L63,36 L36,63 L9,36 Z" />
                <Path Fill="{TemplateBinding Foreground}" Data="M34,17 L36,14.5 L38,17 L38,52 L34,52 Z M34,30 L26,22 L26,27.66 L34,35.66 Z M38,30 L46,22 L46,27.66 L38,35.66 Z M34,41 L28.5,46.5 L28.5,52.16 L34,46.66 Z M38,41 L43.5,46.5 L43.5,52.16 L38,46.66 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
<ControlTemplate x:Key="EmberChainTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle x:Name="ChainH" Height="12" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/chain.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,24,12" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle x:Name="ChainV" Width="12" Visibility="Collapsed" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/chain-v.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,12,24" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="V">
                <Setter TargetName="ChainH" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ChainV" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
<ControlTemplate x:Key="BloomTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" ViewboxUnits="Absolute" Viewbox="0,0,40,40" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" ViewboxUnits="Absolute" Viewbox="40,0,16,40" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" ViewboxUnits="Absolute" Viewbox="56,0,40,40" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" ViewboxUnits="Absolute" Viewbox="0,40,40,16" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" ViewboxUnits="Absolute" Viewbox="56,40,40,16" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" ViewboxUnits="Absolute" Viewbox="0,56,40,40" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" ViewboxUnits="Absolute" Viewbox="40,56,16,40" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" ViewboxUnits="Absolute" Viewbox="56,56,40,40" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
        </Grid>
    </ControlTemplate>
<ControlTemplate x:Key="RivetsTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Path Width="5" Height="5" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}" Data="M2.5,0 L5,2.5 L2.5,5 L0,2.5 Z" />
            <Path Width="5" Height="5" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}" Data="M2.5,0 L5,2.5 L2.5,5 L0,2.5 Z" />
            <Path Width="5" Height="5" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Data="M2.5,0 L5,2.5 L2.5,5 L0,2.5 Z" />
            <Path Width="5" Height="5" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Data="M2.5,0 L5,2.5 L2.5,5 L0,2.5 Z" />
        </Grid>
    </ControlTemplate>
<ControlTemplate x:Key="WorldTreeTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/tree.png'}" Stretch="Uniform" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>
<Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>
</ResourceDictionary>
