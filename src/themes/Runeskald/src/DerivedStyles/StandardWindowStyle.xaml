<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource NormalBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource PopupBackgroundBrush}" ClipToBounds="True">
                                    <!-- Same frost-slate + grain sprite background as TopPanel and dropdown menus. -->
                                    <Rectangle Fill="{DynamicResource FrostSlateBrush}" IsHitTestVisible="False">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0.2" Color="#00000000" />
                                                <GradientStop Offset="1" Color="#B3000000" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Control Template="{DynamicResource GrainTemplate}"
                                             Foreground="{DynamicResource KnotworkBrush}" Opacity="0.10"
                                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" />

                                    <Rectangle Height="1" VerticalAlignment="Top" Margin="12,4,12,0" Fill="{DynamicResource WindowPanelSeparatorBrush}" IsHitTestVisible="False" />
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Margin="12,0,12,4" Fill="{DynamicResource WindowPanelSeparatorBrush}" IsHitTestVisible="False" />
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource NormalBorderBrush}" IsHitTestVisible="False" />
                                    <Rectangle IsHitTestVisible="False" Fill="{DynamicResource LocalRealmBlueBrush}">
                                        <Rectangle.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0" /><GradientStop Color="Transparent" Offset="0.85" /></LinearGradientBrush></Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Path Width="28" Height="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Data="M0,1 H7 L10,4 M7,1 L10,0 M11,3 L14,0 L17,3 L14,6 Z M18,4 L21,1 H28" Stroke="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                                    <DockPanel LastChildFill="False">

                                        <Grid DockPanel.Dock="Left" Margin="14,8,0,9">
                                            
                                            <StackPanel Orientation="Horizontal" Margin="18,0,22,0" VerticalAlignment="Center">
                                                <Path Data="{DynamicResource LocalClaspGeometry}" Width="22" Height="15" Stretch="Uniform" Fill="{DynamicResource GlyphBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold"
                                                           Typography.Capitals="AllSmallCaps"
                                                           Foreground="{DynamicResource LocalParchmentBrush}" TextTrimming="CharacterEllipsis"
                                                           Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <Button Style="{DynamicResource MainWindowButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource MainWindowButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource MainWindowButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
