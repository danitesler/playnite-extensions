{
  "_comment": "Runeskald menu glyphs drawn on a 24-unit grid. Neutral, favorite and destructive variants use the mist, amber and oxide palette.",
  "jobs": [
    {
      "_comment": "Media.xaml maps Playnite's *Icon keys to these files.",
      "svgDir": "icons",
      "format": "Png",
      "outDir": "src/Images/Icons",
      "size": 48,
      "color": "#BBC4C9",
      "icons": [
        "fullscreen",
        "add",
        "sync",
        "info",
        "settings",
        "addons",
        "play",
        "install",
        "links",
        "folder",
        "database",
        "desktop-shortcut",
        "star",
        "eye-closed",
        "eye",
        "sun",
        "edit",
        "random",
        "book",
        "archive",
        "history"
      ]
    },
    {
      "svgDir": "icons",
      "format": "Png",
      "outDir": "src/Images/Icons",
      "size": 48,
      "color": "#FF9283",
      "suffix": "-danger",
      "icons": [
        "exit",
        "remove"
      ]
    },
    {
      "svgDir": "icons",
      "format": "Png",
      "outDir": "src/Images/Icons",
      "size": 48,
      "color": "#E6BB56",
      "icons": [
        "star-fill"
      ]
    }
  ]
}
