<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    Spacing follows the Counter-Strike 2 Panorama rules each value is taken from (quoted per key). Panorama draws at a
    1080p reference with 16 to 28px type; Playnite's controls use 14px type, so paddings are the game's scaled by
    about 0.7 where noted and kept as they are where they are already small.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menus and dropdowns: SimpleContextMenu .ContextMenuBody (contextMenuBackground, border-radius btnBorderRadius)
         with the 1px edge WPF popups keep (.PopupPanel border rgb(65,65,65)). -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: the game draws none; a 1px selectedNavColor edge inside the control (keyboard only). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: the same edge, 3px outside the box. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading (.SettingsSectionTitleLabel: Stratum2 Black, italic, rgba(222,222,222,0.4)); callers pass capitals. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Component spacing, keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">14,5,14,5</Thickness>          <!-- .PopupButton Label margin 10px 12px 8px, x0.7 (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">8,5,8,5</Thickness>             <!-- TextEntry padding 6px 16px 6px 6px, height 36 (height now set by ControlHeight) -->
    <Thickness x:Key="MenuPadding">0,8,0,8</Thickness>              <!-- .ContextMenuBody padding 8px 0px -->
    <Thickness x:Key="MenuItemPadding">14,8,14,8</Thickness>        <!-- .ContextMenuBody Button padding 8px 14px -->
    <Thickness x:Key="ComboBoxDropDownPadding">0,8,0,8</Thickness>  <!-- DropDownMenu padding 8px 0px -->
    <Thickness x:Key="ComboBoxItemPadding">16,8,16,8</Thickness>    <!-- DropDownMenu Label padding 8px 16px -->
    <Thickness x:Key="ListBoxItemPadding">10,6,10,6</Thickness>     <!-- .mainmenu-content__container__sidebar__btn Label padding 8px, 32px rows -->
    <Thickness x:Key="GroupBoxPadding">8,0,0,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>    <!-- .SettingsSectionTitleContianer margin-bottom 12px -->
    <Thickness x:Key="TooltipPadding">10,8,10,6</Thickness>         <!-- .ShortTextTooltip #Contents padding 8px 10px 6px 10px -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">20</sys:Double>                    <!-- .mainmenu-top-navbar__radio-btn__icon 22px -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art band on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five 16:9
         thumbnails, so the real carousel replaces it without the page jumping. Square 2px corners, like the game's
         tiles. Each Viewbox scales a fixed 1600px layout to its column's width. The tiles are the host's Foreground
         at low opacity; the whole thing pulses while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="4"
                        Background="{TemplateBinding Foreground}" Opacity="0.14" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="2" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="4" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="6" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="8" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- menu-mark begin LocalClutchMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a crosshair, four ticks around a centre dot. Hover (IsMouseOver): the ticks spread 2.5px outward like a weapon blooming (0.2s cubic out; the wrapper canvases move). Open (ContextMenu.IsOpen of the nearest Border): the ticks pull in 1.5px past rest, a pale blue dot pops in (BackEase) and a thin ring closes in from 1.5 to 1 and breathes until the menu closes, the scoped-in pose; the tick rectangles move apart from the wrappers, and the exit storyboards restore every property. -->
    <ControlTemplate x:Key="LocalClutchMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Canvas x:Name="WT" Width="24" Height="24">
                    <Canvas.RenderTransform><TranslateTransform x:Name="WTT" X="0" Y="0" /></Canvas.RenderTransform>
                    <Rectangle x:Name="TT" Canvas.Left="11" Canvas.Top="2.5" Width="2" Height="5.5" Fill="{TemplateBinding Foreground}">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="TTT" X="0" Y="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
                <Canvas x:Name="WB" Width="24" Height="24">
                    <Canvas.RenderTransform><TranslateTransform x:Name="WBT" X="0" Y="0" /></Canvas.RenderTransform>
                    <Rectangle x:Name="BT" Canvas.Left="11" Canvas.Top="16" Width="2" Height="5.5" Fill="{TemplateBinding Foreground}">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="BTT" X="0" Y="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
                <Canvas x:Name="WL" Width="24" Height="24">
                    <Canvas.RenderTransform><TranslateTransform x:Name="WLT" X="0" Y="0" /></Canvas.RenderTransform>
                    <Rectangle x:Name="LT" Canvas.Left="2.5" Canvas.Top="11" Width="5.5" Height="2" Fill="{TemplateBinding Foreground}">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="LTT" X="0" Y="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
                <Canvas x:Name="WR" Width="24" Height="24">
                    <Canvas.RenderTransform><TranslateTransform x:Name="WRT" X="0" Y="0" /></Canvas.RenderTransform>
                    <Rectangle x:Name="RT" Canvas.Left="16" Canvas.Top="11" Width="5.5" Height="2" Fill="{TemplateBinding Foreground}">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="RTT" X="0" Y="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
                <Ellipse Canvas.Left="10.75" Canvas.Top="10.75" Width="2.5" Height="2.5" Fill="{TemplateBinding Foreground}" />
                <Ellipse x:Name="DotAcc" Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource GlyphBrush}" Opacity="0">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="DotS" ScaleX="0.2" ScaleY="0.2" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Ring" Canvas.Left="5" Canvas.Top="5" Width="14" Height="14" RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" Opacity="0">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="RingS" ScaleX="1.5" ScaleY="1.5" /></Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="WTT" Storyboard.TargetProperty="Y" To="-2.5" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="WBT" Storyboard.TargetProperty="Y" To="2.5" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="WLT" Storyboard.TargetProperty="X" To="-2.5" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="WRT" Storyboard.TargetProperty="X" To="2.5" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="WTT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="WBT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="WLT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="WRT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.160" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="TTT" Storyboard.TargetProperty="Y" To="1.5" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BTT" Storyboard.TargetProperty="Y" To="-1.5" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LTT" Storyboard.TargetProperty="X" To="1.5" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RTT" Storyboard.TargetProperty="X" To="-1.5" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DotS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DotS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DotAcc" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.150"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RingS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.250"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RingS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.250"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" From="0.25" To="0.8" Duration="0:0:1.000" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="TTT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BTT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LTT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RTT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="DotS" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="DotS" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="DotAcc" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.120" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RingS" Storyboard.TargetProperty="ScaleX" To="1.5" Duration="0:0:0.200" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RingS" Storyboard.TargetProperty="ScaleY" To="1.5" Duration="0:0:0.200" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.800" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalClutchMenuMarkTemplate -->
</ResourceDictionary>
