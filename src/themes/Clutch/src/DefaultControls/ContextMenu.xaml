<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is Counter-Strike 2's Panorama menu panel (LocalPanoramaMenuPanelTemplate, shared by
    ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: dark Panorama steel (PopupBackgroundBrush) with 3px corners (ControlCornerRadius), 1px PopupBorderBrush edge,
      a 2px sky-blue (GlyphBrush) top bar over a 1px navbar rule (PanelSeparatorBrush), and a subtle 8px crosshair reticle
      in the top-right corner. No DropShadowEffect.
    - Rows, rules and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalPanoramaMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <!-- Panorama navbar top rule + 48px sky-blue accent bar + top-right 8px crosshair reticle -->
            <Rectangle Height="1" Margin="1,3,1,0" VerticalAlignment="Top" Fill="{DynamicResource PanelSeparatorBrush}" Opacity="0.6" />
            <Rectangle Width="48" Height="2" Margin="1,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="{DynamicResource GlyphBrush}" />
            <Path Width="7" Height="7" Margin="0,5,7,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Data="M 3.5,0 L 3.5,2 M 3.5,5 L 3.5,7 M 0,3.5 L 2,3.5 M 5,3.5 L 7,3.5"
                  Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" Opacity="0.5" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="228" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalPanoramaMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="4,8,4,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
