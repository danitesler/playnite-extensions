<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml.
    The game's GO button (.play-menu__playbtn, mainmenu_play.css): a dark green plate at 65% with a 1px green edge,
    bold uppercase green label, and the thin bars on both ends that glow green (.play-menu__playbtn__bar, box-shadow
    rgba(6,141,6,0.77)). WPF has no box-shadow on a bar, so the glow is the same green fading inward through an opacity
    mask. The glow layers are the effect themselves; nothing masked sits behind them.
    Hover follows the game's FlatButton (csgostyles.css): brightness 1 to 1.2, label color to white, both 0.25s
    ease-in-out, and the side bars go to brightness 2. Here, animated both ways (no setters on animated parts):
      in  0.25s ease-in-out: the brighter green plate fades in, the label cross-fades to white (a white copy of the label
          fades in over the green one), the glows rise 0.35 to 0.8 and the bars 0.55 to 1.
      out 0.25s: all of it fades back; exit animations use FillBehavior Stop so no clock is left running.
    Pressed: the game flips the button away on press (rotateX 100deg, opacity 0, 0.25s); WPF has no 3D flip on a Button,
    so it gets its own deep-green layer and a short vertical squash (ScaleY to 0.92, 0.08s) that releases in 0.15s.
    Size comes from the host. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages (DataContext: Playnite's
        GameDetailsViewModel, IsRunning / IsLaunching). While the game runs Playnite swaps Play for the context action
        (RUNNING): the flat button is tinted T gold inside a 1px frame in its radius (ControlCornerRadius) with a short LED strip on its foot, blinking once every 3s like an armed C4; launching beeps fast.
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" />
                        <Grid Height="2" Margin="8,2,8,0" VerticalAlignment="Top">
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Grid Width="17" Height="17" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="RunningLedGlow" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.2">
                                <Ellipse.OpacityMask>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.OpacityMask>
                            </Ellipse>
                            <Rectangle x:Name="RunningLed" Width="5" Height="5" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.2" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.6,0 1,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningLed" Storyboard.TargetProperty="Opacity" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.1" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.68" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.13" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.13" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.26" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.72" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0.2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningLedGlow" Storyboard.TargetProperty="Opacity" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.1" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.68" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.13" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.13" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.26" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.72" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0.2" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningLed" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.1" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningLedGlow" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.1" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the scan has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="28,8,28,8" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                    <Border x:Name="Border" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PressSquash" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Grid>
                            <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.4" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.07" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.07" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid x:Name="HoverFx">
                                <Border x:Name="HoverPlate" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="PressPlate" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            <Border x:Name="RunningHoverDim" Background="{DynamicResource ScrimBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="PlayContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type sys:String}">
                                        <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <ContentPresenter x:Name="LabelLit" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              TextElement.Foreground="{DynamicResource ButtonForegroundBrush}">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type sys:String}">
                                        <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                        <!-- Bottom only: a bar along the lower edge and, on hover, light from it dissolving downward. -->
                        <Rectangle x:Name="BarBottom" Height="3" VerticalAlignment="Bottom" Margin="8,0,8,4" IsHitTestVisible="False"
                                   Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.55" />
                        <Rectangle x:Name="GlowBottom" Height="46" VerticalAlignment="Bottom" Margin="-24,0,-24,-42" Opacity="0"
                                   IsHitTestVisible="False" Fill="{DynamicResource PrimaryButtonGlowBrush}">
                            <Rectangle.OpacityMask>
                                <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.5" RadiusY="1">
                                    <GradientStop Offset="0" Color="#FF000000" />
                                    <GradientStop Offset="0.25" Color="#8C000000" />
                                    <GradientStop Offset="0.6" Color="#26000000" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </RadialGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BarBottom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="GlowBottom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.95" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.07" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.6,0 1,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1.07" KeySpline="0.6,0 1,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.07" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.07" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1.14" KeySpline="0.6,0 1,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.14" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BarBottom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="GlowBottom" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.76" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.64" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.76" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LabelLit" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LabelLit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlowBottom" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="BarBottom" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LabelLit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GlowBottom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BarBottom" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PressSquash" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressSquash" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
                    <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsRunning}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
