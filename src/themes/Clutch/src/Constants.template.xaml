<!--
    Clutch: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    The placeholders name the Counter-Strike 2 main menu's own values (tokens.css: the game's Panorama defines and
    the literal values of its component rules). Theme XAML reads brushes only, never Color keys, so ThemeModifier
    edits reach every control.

    The look: dark translucent panels over the art, light grey text, one light blue (selectedNavColor) for
    selection, focus and links, the green GO button for Play, square-ish 2 to 3px corners.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Typography (Playnite keys). The game's scale is 12 / 16 / 20 / 24 / 32 at 1080p; menus and tooltips use 14.
        Body text is Segoe UI (the game's labels default to Noto Sans); headings, tabs, buttons and the navbar use
        HeadingFontFamily, Bahnschrift, in place of the game's Stratum2 (neither game font is bundled).
    -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">32</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Bahnschrift}}, Segoe UI</FontFamily>

    <!-- Shape (Playnite keys). ControlCornerRadius is the game's btnBorderRadius. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:btnBorderRadius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-large}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:radius-full}}</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor is the navbar's selected blue, paired with black as TextColorDark (the game's selected sidebar
        button is black bold text on selectedNavColor).
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{news-text}}</Color>
    <Color x:Key="TextColorDarker">{{popup-title-text}}</Color>
    <Color x:Key="TextColorDark">#FF000000</Color>
    <Color x:Key="MainColor">{{contextMenuBackground}}</Color>
    <Color x:Key="MainColorDark">{{popup-panel-dark}}</Color>
    <Color x:Key="HoverColor">{{navbar-iconbtn-hover}}</Color>
    <Color x:Key="GlyphColor">{{selectedNavColor}}</Color>
    <Color x:Key="HighlightGlyphColor">{{selectedNavColor/25}}</Color>
    <Color x:Key="PopupBackgroundColor">{{contextMenuBackground}}</Color>
    <Color x:Key="PopupBorderColor">{{popup-border}}</Color>
    <Color x:Key="BackgroundToneColor">{{contextMenuBackground}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{tileBlurBackgroundColor}}</Color>
    <Color x:Key="PanelSeparatorColor">{{separator}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{baseBorder}}</Color>
    <Color x:Key="DataChangeNotifColor">{{warningColor}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{textentry-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{{navbar-iconbtn-hover}}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{tooltip-short}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{popupbutton-hover}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{textentry-fill}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{xpshop-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{negativeColor}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{warningColor}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{negativeColor}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{content-tabs}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{popup-panel-dark}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!--
        Shell. The game draws its navbar and panels as translucent black over the 3D scene; here the scene is the
        game's background art (Views/Library.xaml) or the window color. The rail and the top bar share one fill.
    -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{content-container}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{contentPanelBackground}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{content-container}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{textentry-fill}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{textentry-fill-hover}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{baseText}}" />

    <!-- States: the content tabs' selected blue wash; menus darken under the pointer, as in the game -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{content-tab-selected}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{selectedNavColor/16}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{selectedNavColor}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{popupbutton-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{content-tab-selected}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{contextmenu-item-hover}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{selectedNavColor}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{negativeColor}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFFFFFF" />

    <!-- Buttons: PopupButton (flat, white wash on hover) for every button; the GO button for Play and default buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{navbar-iconbtn-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{popupbutton-active}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{go-background}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{go-background-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{go-background-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{go-text}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{go-border}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{go-glow}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{content-tab-selected}}" />

    <!-- Inputs: the game's TextEntry, a 1px grey edge on the panel -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{textentry-fill}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{textentry-fill-hover}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{textentry-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{textentry-border-hover}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{baseText}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{slider-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{slider-thumb}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{slider-thumb-hover}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{slider-progress}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{progressbar-to}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{progressbar-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{scrollthumb}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{scrollthumb-hover}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{scrollthumb}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{scrollthumb-hover}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{selectedNavColor}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{content-tab-hover}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{content-tabs}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{maptile-hover}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{maptile-selected}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{navbar-iconbtn-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{content-tab-selected}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{popupbutton-hover}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{baseText}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{navbar-iconbtn-hover}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{contextmenu-separator}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{tooltip-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{tooltip-short-edge@tooltip-short}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{popup-title-band}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{popup-title-text}}" />

    <!-- Main menu: the navbar's separators, the black of the art's vignettes, section titles, the panel shadow, the game page surface -->
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{navbar-separator}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{settings-section-title}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{sidebar-separator}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{content-container}}" />
</ResourceDictionary>
