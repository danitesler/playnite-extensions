<!--
    Greenfield XP: CustomControls/SidebarItem.xaml.
    44x40 Luna Royal Blue taskbar rail items: 34x32 rounded plate, >= 16x16 icon area (no stacked padding
    with IconPadding so add-on icons never collapse), glossy #4B89F5 hover sheen, pressed #1338A0 active
    task button with 3px Luna Orange left edge pip.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{Binding Title}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Hover glossy Luna blue plate -->
                        <Border x:Name="HoverPlate" Margin="5,4" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                BorderBrush="#66FFFFFF" BorderThickness="1"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                        <!-- Selected pressed Luna taskbar plate + 3px Luna Orange left edge pip -->
                        <Border x:Name="SelectedPlate" Margin="5,4" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource TopPanelItemCheckedBackgroundBrush}"
                                BorderBrush="{DynamicResource LocalXpBlueEdgeBrush}" BorderThickness="1"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="SelectedPip" Width="3" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="0,2,2,0" Background="{DynamicResource LocalXpOrangeBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False" />

                        <!-- Icon content: fixed 18x18 box (never stacks with IconPadding) -->
                        <Grid x:Name="IconHost" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox x:Name="ItemIcon" Stretch="Uniform">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                            <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                            ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{TemplateBinding Foreground}" />
                        </Grid>

                        <ProgressBar x:Name="PART_ProgressStatus" Height="2" Margin="6,0,6,3"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource LocalXpOrangeBrush}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Replace Playnite's default Library/Statistics icons with Greenfield XP icons -->
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedPip" />
                            <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SideHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SideHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="HorizontalAlignment" Value="Right" TargetName="SelectedPip" />
                            <Setter Property="CornerRadius" Value="2,0,0,2" TargetName="SelectedPip" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Width" Value="40" />
                            <Setter Property="Height" Value="44" />
                            <Setter Property="Width" Value="22" TargetName="SelectedPip" />
                            <Setter Property="Height" Value="3" TargetName="SelectedPip" />
                            <Setter Property="HorizontalAlignment" Value="Center" TargetName="SelectedPip" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="SelectedPip" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Width" Value="40" />
                            <Setter Property="Height" Value="44" />
                            <Setter Property="Width" Value="22" TargetName="SelectedPip" />
                            <Setter Property="Height" Value="3" TargetName="SelectedPip" />
                            <Setter Property="HorizontalAlignment" Value="Center" TargetName="SelectedPip" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="SelectedPip" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
