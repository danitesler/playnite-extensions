<!--
    Greenfield XP: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Maps Windows XP Luna Blue (luna.msstyles) tokens onto Playnite palette keys, shared vocabulary keys,
    and Local* glossy gradient/rim brushes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys + shared HeadingFontFamily) -->
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSize">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">19</sys:Double>
    <sys:Double x:Key="FontSizeLargest">27</sys:Double>
    <FontFamily x:Key="FontFamily">Tahoma, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Trebuchet MS, Tahoma, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width & position (ThemeModifier edits these) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape (Playnite keys + shared radius scale) -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:xp-radius}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:xp-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:xp-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:xp-radius-xl}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:xp-radius-full}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{xp-text}}</Color>
    <Color x:Key="TextColorDarker">{{xp-text-muted}}</Color>
    <Color x:Key="TextColorDark">{{xp-text-invert}}</Color>
    <Color x:Key="MainColor">{{xp-beige}}</Color>
    <Color x:Key="MainColorDark">{{xp-window}}</Color>
    <Color x:Key="HoverColor">{{xp-row-hover}}</Color>
    <Color x:Key="GlyphColor">{{xp-select}}</Color>
    <Color x:Key="HighlightGlyphColor">{{xp-select-soft}}</Color>
    <Color x:Key="PopupBackgroundColor">{{xp-window}}</Color>
    <Color x:Key="PopupBorderColor">{{xp-btn-border}}</Color>
    <Color x:Key="BackgroundToneColor">{{xp-task-bg}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{xp-beige-shadow}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{xp-beige-shadow}}</Color>
    <Color x:Key="DataChangeNotifColor">{{xp-filter-gold}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{xp-btn-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{xp-tooltip-bg}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{xp-beige}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{xp-window}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{xp-pos}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{xp-neg}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{xp-mix}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{xp-mix}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{xp-task-bg}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{xp-beige}}" />

    <!-- Shared keys: Shell & Game page -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{xp-blue-mid}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{xp-blue-mid}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{xp-window}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{xp-window}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{xp-window}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{xp-window-soft}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{xp-green-base}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{xp-text-invert}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{xp-blue-edge}}" />
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{xp-blue-dark}}" />
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{xp-text-invert}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{xp-task-header}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{xp-task-link}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{xp-blue-mid}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{xp-text-invert}}" />

    <!-- Shared keys: States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{xp-select}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{xp-select-hi}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{xp-text-invert}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{xp-row-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{xp-select}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{xp-select}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{xp-run}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{xp-orange-deep}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{xp-danger}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{xp-text-invert}}" />

    <!-- Shared keys: Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{xp-text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{xp-beige-light}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{xp-beige-deep}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{xp-btn-border}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{xp-green-base}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{xp-green-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{xp-green-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{xp-text-invert}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{xp-green-border}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{xp-beige}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{xp-btn-border}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{xp-beige-light}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{xp-beige-deep}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{xp-task-bg}}" />

    <!-- Shared keys: Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{xp-window}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{xp-window}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{xp-input-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{xp-orange-deep}}" />

    <!-- Shared keys: Controls & Popups -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{xp-btn-border}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{xp-orange-deep}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{xp-beige-deep}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{xp-beige-light}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{xp-orange-deep}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{xp-progress-green}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{xp-window}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{xp-scroll-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{xp-scroll-thumb}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{xp-scroll-thumb-hi}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{xp-scroll-thumb}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{xp-scroll-thumb-hi}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{xp-text}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{xp-task-link}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{xp-orange}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{xp-orange-light}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{xp-beige}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{xp-orange}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{xp-select}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{xp-blue-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{xp-blue-press}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{xp-text-invert}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{xp-text-invert}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{xp-beige-light}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{xp-text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{xp-row-hover}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{xp-beige-line}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{xp-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{xp-text}}" />

    <!-- Local* Windows XP Luna Glossy Brushes & Rim Tokens -->
    <SolidColorBrush x:Key="LocalXpBlueGlossBrush" Color="{{xp-blue-gloss}}" />
    <SolidColorBrush x:Key="LocalXpBlueDarkBrush" Color="{{xp-blue-dark}}" />
    <SolidColorBrush x:Key="LocalXpBlueEdgeBrush" Color="{{xp-blue-edge}}" />
    <SolidColorBrush x:Key="LocalXpGreenGlossBrush" Color="{{xp-green-gloss}}" />
    <SolidColorBrush x:Key="LocalXpGreenCheckBrush" Color="{{xp-green-check}}" />
    <SolidColorBrush x:Key="LocalXpOrangeLightBrush" Color="{{xp-orange-light}}" />
    <SolidColorBrush x:Key="LocalXpOrangeBrush" Color="{{xp-orange}}" />
    <SolidColorBrush x:Key="LocalXpOrangeDeepBrush" Color="{{xp-orange-deep}}" />
    <SolidColorBrush x:Key="LocalXpTaskBorderBrush" Color="{{xp-task-border}}" />
    <SolidColorBrush x:Key="LocalXpTaskLinkBrush" Color="{{xp-task-link}}" />
    <SolidColorBrush x:Key="LocalXpRowHoverBorderBrush" Color="{{xp-row-hover-border}}" />
    <SolidColorBrush x:Key="LocalXpDangerGlossBrush" Color="{{xp-danger-gloss}}" />
    <SolidColorBrush x:Key="LocalXpDangerDarkBrush" Color="{{xp-danger-dark}}" />
    <SolidColorBrush x:Key="LocalXpRunHighlightBrush" Color="{{xp-run-hi}}" />
    <SolidColorBrush x:Key="LocalXpRunScrimBrush" Color="{{xp-run-scrim}}" />
    <SolidColorBrush x:Key="LocalXpBeigeLineBrush" Color="{{xp-beige-line}}" />

    <!-- Glossy Luna Royal Blue Horizontal Title Bar / Top Bar Gradient -->
    <LinearGradientBrush x:Key="LocalXpTitleBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{xp-blue-gloss}}" Offset="0.0" />
        <GradientStop Color="{{xp-blue-mid}}" Offset="0.16" />
        <GradientStop Color="{{xp-blue-mid}}" Offset="0.82" />
        <GradientStop Color="{{xp-blue-dark}}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glossy Luna Royal Blue Vertical Taskbar Rail Gradient -->
    <LinearGradientBrush x:Key="LocalXpRailBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{{xp-blue-gloss}}" Offset="0.0" />
        <GradientStop Color="{{xp-blue-mid}}" Offset="0.18" />
        <GradientStop Color="{{xp-blue-mid}}" Offset="0.82" />
        <GradientStop Color="{{xp-blue-dark}}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glossy Luna Grass Green Start / Play Gradient -->
    <LinearGradientBrush x:Key="LocalXpStartGreenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{xp-green-gloss}}" Offset="0.0" />
        <GradientStop Color="{{xp-green}}" Offset="0.22" />
        <GradientStop Color="{{xp-green-base}}" Offset="0.82" />
        <GradientStop Color="{{xp-green-press}}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glossy Luna Coral-Red Close Button Gradient -->
    <LinearGradientBrush x:Key="LocalXpCloseRedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{xp-danger-gloss}}" Offset="0.0" />
        <GradientStop Color="{{xp-danger}}" Offset="0.35" />
        <GradientStop Color="{{xp-danger-dark}}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glossy Luna Standard Push Button Face -->
    <LinearGradientBrush x:Key="LocalXpButtonFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="{{xp-beige-light}}" Offset="0.45" />
        <GradientStop Color="{{xp-beige}}" Offset="0.85" />
        <GradientStop Color="{{xp-beige-deep}}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Explorer Common Tasks Header Band Gradient -->
    <LinearGradientBrush x:Key="LocalXpTaskHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="{{xp-task-header}}" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
