<!--
    Greenfield XP: Views/Sidebar.xaml.
    44px Glossy Luna Royal Blue vertical taskbar rail closed by a #00138C edge rule,
    crowned by the Grass Green Start PART_ElemMainMenu tile hosting LocalGreenfieldXpMenuMarkTemplate.
    Turns transparent when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <!-- Glossy Luna Royal Blue vertical rail sheen -->
                            <Border x:Name="RailGloss" Background="{DynamicResource LocalXpRailBrush}" IsHitTestVisible="False" />

                            <DockPanel x:Name="DockContentHolder">
                                <!-- Glossy Grass Green Start Button (PART_ElemMainMenu) -->
                                <Border x:Name="PART_ElemMainMenu" Background="{DynamicResource LocalXpStartGreenBrush}"
                                        BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="0,0,0,1"
                                        Width="44" Height="48" Margin="0,0,0,4" CornerRadius="0,0,13,0"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Border x:Name="StartGloss" Height="14" VerticalAlignment="Top" Margin="3,2,3,0"
                                                CornerRadius="5,5,2,2" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#66FFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Control Template="{DynamicResource LocalGreenfieldXpMenuMarkTemplate}"
                                                 Focusable="False" IsTabStop="False" />
                                    </Grid>
                                </Border>

                                <!-- Luna Quick Launch grip: 2 rows of light/dark dots under the Start button -->
                                <Border x:Name="QuickLaunchGrip" Height="8" Margin="9,0,9,4" DockPanel.Dock="Top"
                                        IsHitTestVisible="False" SnapsToDevicePixels="True">
                                    <Rectangle Height="6" VerticalAlignment="Center">
                                        <Rectangle.Fill>
                                            <DrawingBrush TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute"
                                                          Viewbox="0,0,4,3" ViewboxUnits="Absolute">
                                                <DrawingBrush.Drawing>
                                                    <DrawingGroup>
                                                        <GeometryDrawing Brush="#7A0A2A8C">
                                                            <GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,1.2,1.2" /></GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                        <GeometryDrawing Brush="#B0D7E6FF">
                                                            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1.2,1.2" /></GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                    </DrawingGroup>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Border>

                                <!-- Luna notification area: lighter cyan-blue tray at the foot of the rail with three tray icons -->
                                <Border x:Name="TrayArea" DockPanel.Dock="Bottom" Height="74" Margin="0,4,1,0"
                                        BorderBrush="#FF0A4DB5" BorderThickness="0,1,0,0" CornerRadius="0,0,0,0"
                                        IsHitTestVisible="False" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF1B97EE" Offset="0" />
                                            <GradientStop Color="#FF1285E5" Offset="0.5" />
                                            <GradientStop Color="#FF0C6FD4" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Rectangle Height="1" VerticalAlignment="Top" Fill="#66FFFFFF" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Speaker -->
                                            <Canvas Width="14" Height="14" Margin="0,0,0,8">
                                                <Path Data="M1,5 L4,5 L8,2 L8,12 L4,9 L1,9 Z" Fill="#F4F8FF" Stroke="#FF0A3F9A" StrokeThickness="0.6" />
                                                <Path Data="M10,4.2 C12.2,6 12.2,8 10,9.8" Stroke="#F4F8FF" StrokeThickness="1.2" />
                                            </Canvas>
                                            <!-- Network -->
                                            <Canvas Width="14" Height="14" Margin="0,0,0,8">
                                                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="12" Height="12" Stroke="#F4F8FF" StrokeThickness="1">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FF7FE06A" Offset="0" />
                                                            <GradientStop Color="#FF2E9E34" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Path Data="M7,2 L7,12 M2,7 L12,7" Stroke="#99FFFFFF" StrokeThickness="0.8" />
                                            </Canvas>
                                            <!-- Security shield -->
                                            <Canvas Width="14" Height="14">
                                                <Path Data="M7,1 L13,3 L13,8 C13,11 10,13 7,14 C4,13 1,11 1,8 L1,3 Z" Fill="#FFE0503C" Stroke="#F4F8FF" StrokeThickness="1" />
                                                <Path Data="M7,4 L7,8.5 M7,10 L7,11" Stroke="#FFFFFFFF" StrokeThickness="1.4" />
                                            </Canvas>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>

                            <!-- Right crisp Luna navy seam -->
                            <Border x:Name="EdgeRule" Width="1" HorizontalAlignment="Right"
                                    Background="{DynamicResource LocalXpBlueEdgeBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailGloss" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TrayArea" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="QuickLaunchGrip" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TrayArea" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="QuickLaunchGrip" />
                            <Setter Property="CornerRadius" Value="0,13,13,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,108,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TrayArea" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="QuickLaunchGrip" />
                            <Setter Property="CornerRadius" Value="0,13,13,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
