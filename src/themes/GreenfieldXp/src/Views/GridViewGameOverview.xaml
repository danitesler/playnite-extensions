                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                                            <Border x:Name="Plate" Background="{DynamicResource ButtonBackgroundBrush}"
                                                    BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1"
                                                    CornerRadius="4" IsHitTestVisible="False">
                                                <Border CornerRadius="3" Background="{DynamicResource LocalXpButtonFaceBrush}" Opacity="0.85" />
                                            </Border>
                                            <Border x:Name="HoverPlate" Background="{DynamicResource LocalXpCloseRedBrush}"
                                                    BorderBrush="{DynamicResource LocalXpBlueEdgeBrush}" BorderThickness="1"
                                                    CornerRadius="4" Opacity="0" IsHitTestVisible="False">
                                                <Border CornerRadius="3" BorderBrush="#CCFFFFFF" BorderThickness="1" />
                                            </Border>
                                            <ContentControl x:Name="Glyph" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            IsHitTestVisible="False" Content="{DynamicResource IconWindowClose}"
                                                            ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{DynamicResource ButtonForegroundBrush}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                    </Storyboard></BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard><Storyboard>
                                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                                    </Storyboard></BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
