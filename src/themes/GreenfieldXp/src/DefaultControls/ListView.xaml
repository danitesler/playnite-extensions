<!--
    Greenfield XP: DefaultControls/ListView.xaml.
    Implicit ListViewItem style only (Playnite's ListView row plus the Greenfield XP RunningIndicator).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ListViewItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Grid Background="Transparent" ClipToBounds="True" SnapsToDevicePixels="True">
                        <Border x:Name="HoverPlate" Background="{DynamicResource ListItemHoverBrush}"
                                BorderBrush="{DynamicResource LocalXpRowHoverBorderBrush}" BorderThickness="1"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="SelectPlate" Background="{DynamicResource ListItemSelectedBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}"
                                    Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False" />
                            <Rectangle x:Name="RunningScan" Width="40" HorizontalAlignment="Left"
                                       Visibility="Collapsed" Opacity="0.38" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="LvScanMove" X="-40" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Border x:Name="RunningFill" Height="2" VerticalAlignment="Bottom" Margin="2,0,2,1"
                                    Background="{DynamicResource LocalXpRunHighlightBrush}" RenderTransformOrigin="0,0.5"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="LvFillScale" ScaleX="0.1" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                    BorderThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>

                        <Border x:Name="RowRoom" Padding="0">
                            <GridViewRowPresenter VerticalAlignment="Center" />
                        </Border>

                        <Border x:Name="RunningMarkPlate" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,6,0" Padding="4,3" CornerRadius="2"
                                Background="{DynamicResource RunningIndicatorBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="4" Height="4" Margin="0,0,2,0" Fill="{DynamicResource LocalXpRunHighlightBrush}" />
                                <Ellipse Width="4" Height="4" Margin="0,0,2,0" Fill="{DynamicResource SelectedForegroundBrush}" Opacity="0.75" />
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource SelectedForegroundBrush}" Opacity="0.55" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="HoverPlate" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningWash" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningFrame" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningFill" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningMarkPlate" />
                            <Setter Property="Padding" Value="0,0,36,0" TargetName="RowRoom" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="LvLaunchLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LvScanMove" Storyboard.TargetProperty="X" From="-40" To="320" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="LvFillScale" Storyboard.TargetProperty="ScaleX" From="0.08" To="1.0" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="LvLaunchLoop" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningWash" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningFrame" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningMarkPlate" />
                            <Setter Property="Padding" Value="0,0,36,0" TargetName="RowRoom" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="LvRunLoop">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="RunningFrame" Storyboard.TargetProperty="Opacity" From="0.7" To="1.0" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="LvRunLoop" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
