<!--
    Greenfield XP: DefaultControls/ContextMenu.xaml.
    Unified Windows XP Luna popup panel (LocalGreenfieldXpMenuBoardTemplate):
    - Panel: Crisp #FFFFFF card (CornerRadius 4) in a #003C74 steel-navy rim with a 6px glossy Luna Royal Blue
      vertical spine along the left edge capped by a 14px #F8B330 Luna Orange top tick.
    - Start-menu frame: when the menu is the main menu (PlacementTarget named PART_ElemMainMenu) the panel gains the
      Luna Start menu's user header (glossy Royal Blue band, white-framed avatar tile with the hilltop mark, bold
      white "Playnite" with a 1px navy shadow, orange fade-out stripe underneath) and a glossy Royal Blue footer band,
      like the Log Off / Turn Off Computer strip. Other menus (game, sort, combo) stay the plain card.
    - Reused by ContextMenu, TopPanelMenu, MenuItem submenus, and ComboBox PART_Popup.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalGreenfieldXpMenuBoardTemplate" TargetType="{x:Type Control}">
        <Border Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                CornerRadius="4" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid>
                <!-- 6px Glossy Luna Royal Blue Start-Menu left spine -->
                <Border Width="6" HorizontalAlignment="Left" CornerRadius="3,0,0,3"
                        Background="{DynamicResource LocalXpRailBrush}" />
                <!-- 14px Luna Orange cap tick at top of spine -->
                <Border Width="6" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                        CornerRadius="3,0,0,0" Background="{DynamicResource LocalXpOrangeBrush}" />
            </Grid>
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="216" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid Grid.IsSharedSizeScope="True" MinWidth="{TemplateBinding MinWidth}" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Control Grid.RowSpan="3" Template="{DynamicResource LocalGreenfieldXpMenuBoardTemplate}" Focusable="False" IsTabStop="False" />

                        <!-- Start-menu user header (main menu only) -->
                        <Border x:Name="StartHeader" Grid.Row="0" Visibility="Collapsed" Height="42"
                                Margin="1,1,1,0" CornerRadius="3,3,0,0" IsHitTestVisible="False"
                                Background="{DynamicResource LocalXpTitleBarBrush}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Margin="10,0,10,3" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="3" BorderThickness="2"
                                            BorderBrush="#F2FFFFFF" SnapsToDevicePixels="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#6FB1F7" Offset="0" />
                                                <GradientStop Color="#CFE6FF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Control Template="{DynamicResource LocalGreenfieldXpBrandMarkTemplate}"
                                                 Foreground="#1941A5" Margin="2" Focusable="False" IsTabStop="False" />
                                    </Border>
                                    <Grid Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Playnite" FontFamily="Trebuchet MS" FontSize="17" FontWeight="Bold"
                                                   Foreground="#1B2F78" Margin="1,1,0,0" />
                                        <TextBlock Text="Playnite" FontFamily="Trebuchet MS" FontSize="17" FontWeight="Bold"
                                                   Foreground="#FFFFFF" />
                                    </Grid>
                                </StackPanel>
                                <!-- Orange fade-out stripe under the header -->
                                <Rectangle Height="3" VerticalAlignment="Bottom">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFF0A24A" Offset="0" />
                                            <GradientStop Color="#FFE8841A" Offset="0.45" />
                                            <GradientStop Color="#00E8841A" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="MenuScroll" Grid.Row="1" Margin="8,4,4,4"
                                      Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>

                        <!-- Start-menu footer strip (main menu only) -->
                        <Border x:Name="StartFooter" Grid.Row="2" Visibility="Collapsed" Height="26"
                                Margin="1,0,1,1" CornerRadius="0,0,3,3" IsHitTestVisible="False"
                                Background="{DynamicResource LocalXpTitleBarBrush}">
                            <Grid>
                                <Rectangle Height="1" VerticalAlignment="Top" Fill="#66FFFFFF" />
                                <Rectangle Height="2" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFF0A24A" Offset="0" />
                                            <GradientStop Color="#00E8841A" Offset="0.6" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,12,0">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{DynamicResource LocalXpStartGreenBrush}"
                                             Stroke="#CCFFFFFF" StrokeThickness="1" />
                                    <TextBlock Text="Greenfield XP" FontFamily="Trebuchet MS" FontSize="12" FontStyle="Italic"
                                               FontWeight="Bold" Foreground="#E2EEFF" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding PlacementTarget.Name, RelativeSource={RelativeSource Self}}" Value="PART_ElemMainMenu">
                            <Setter TargetName="StartHeader" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StartFooter" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MenuScroll" Property="Margin" Value="8,4,4,4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
