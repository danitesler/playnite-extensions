<!--
    Greenfield XP: DerivedStyles/PlayButton.xaml.
    Hero Moment: Windows XP Luna Grass Green Start-style Play pill (Height 40, MinWidth 164, CornerRadius 5)
    with upper specular gloss, #F8B330 Luna Orange inner hover glow, 1px press shift, and
    RunningActionIndicator (System-Tray Teal-Cyan #0E8A9E launching sweep + running idle pulse +
    LOCCancelLabel hover on RelativeSource Self).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="164" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <!-- The Start button's bold italic "start" lettering -->
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Main Grass Green Start Pill -->
                        <Border x:Name="Plate" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                Background="{DynamicResource LocalXpStartGreenBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <!-- Upper glass specular band -->
                                <Border x:Name="TopGloss" Height="14" VerticalAlignment="Top" Margin="2,1,2,0"
                                        CornerRadius="4,4,2,2" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#66FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Running / Launching solid teal plate + dark contrast scrim + slab sweep -->
                                <Border x:Name="RunningPlate" CornerRadius="4" Background="{DynamicResource RunningIndicatorBrush}"
                                        Visibility="Collapsed" IsHitTestVisible="False" />
                                <Border x:Name="RunningBreath" CornerRadius="4" Background="{DynamicResource LocalXpRunScrimBrush}"
                                        Opacity="0.45" Visibility="Collapsed" IsHitTestVisible="False" />
                                <Rectangle x:Name="RunningScan" Width="44" HorizontalAlignment="Left"
                                           Visibility="Collapsed" Opacity="0.42" IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="SlabScanMove" X="-44" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Border x:Name="RunningFill" Height="3" VerticalAlignment="Bottom" Margin="4,0,4,2"
                                        CornerRadius="1.5" Background="{DynamicResource LocalXpRunHighlightBrush}"
                                        RenderTransformOrigin="0,0.5" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="SlabFillScale" ScaleX="0.1" />
                                    </Border.RenderTransform>
                                </Border>

                                <!-- Hover: Luna Orange warm inner glow ring -->
                                <Border x:Name="HoverGlow" CornerRadius="4"
                                        BorderBrush="{DynamicResource LocalXpOrangeBrush}" BorderThickness="2"
                                        Background="#26FDD889" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Pressed: deep forest shade -->
                                <Border x:Name="PressedPlate" CornerRadius="4" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" IsHitTestVisible="False" />

                                <!-- Running hover dim for Cancel -->
                                <Border x:Name="RunningHoverDim" CornerRadius="4" Background="{DynamicResource DangerBrush}"
                                        Opacity="0.92" Visibility="Collapsed" IsHitTestVisible="False" />

                                <!-- Content host with PlayRoom padding so running marks never overlap text -->
                                <Border x:Name="PlayRoom" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <StackPanel x:Name="PlayContent" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform x:Name="PressShift" X="0" Y="0" />
                                            </StackPanel.RenderTransform>
                                            <ContentControl x:Name="PlayGlyph" Width="14" Height="14" Margin="0,0,8,0"
                                                            Content="{DynamicResource IconPlay}"
                                                            ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{TemplateBinding Foreground}"
                                                            VerticalAlignment="Center" IsHitTestVisible="False" />
                                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                                        </StackPanel>

                                        <!-- Cancel label shown ONLY while IsRunning and hovering this button -->
                                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                                   Foreground="{DynamicResource DangerForegroundBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PlayGlyph" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningBreath" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningFill" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PlayGlyph" />
                            <Setter Property="Padding" Value="12,0,34,0" TargetName="PlayRoom" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="SlabLaunchLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SlabScanMove" Storyboard.TargetProperty="X"
                                                         From="-44" To="220" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="SlabFillScale" Storyboard.TargetProperty="ScaleX"
                                                         From="0.08" To="1.0" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="SlabLaunchLoop" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningBreath" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PlayGlyph" />
                            <Setter Property="Padding" Value="12,0,34,0" TargetName="PlayRoom" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Hidden" TargetName="PlayContent" />
                            <Setter Property="Visibility" Value="Visible" TargetName="CancelLabel" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningHoverDim" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="PressedPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TopGloss" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayPressIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="X" To="1" Duration="0:0:0.04" />
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.04" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RunningActionIndicator overlay placed over the game-page Play / ContextAction cell -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" ClipToBounds="True" SnapsToDevicePixels="True">
                        <!-- Teal-Cyan Wash & Outer Frame -->
                        <Border x:Name="RunningWash" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.18" />
                        <Border x:Name="RunningFrame" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" Opacity="0.9" />

                        <!-- Launching sweep scan band -->
                        <Rectangle x:Name="RunningScan" Width="44" HorizontalAlignment="Left" Visibility="Collapsed" Opacity="0.45">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="ScanMove" X="-44" />
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!-- Launching foot fill bar -->
                        <Border x:Name="RunningFill" Height="3" VerticalAlignment="Bottom" Margin="4,0,4,2"
                                CornerRadius="1.5" Background="{DynamicResource LocalXpRunHighlightBrush}"
                                RenderTransformOrigin="0,0.5" Visibility="Collapsed">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="FillScale" ScaleX="0.1" />
                            </Border.RenderTransform>
                        </Border>

                        <!-- 3 XP System-Tray Status Orbs anchored right inside PlayRoom clearance -->
                        <StackPanel x:Name="RunningMark" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse x:Name="Orb1" Width="5" Height="5" Margin="0,0,3,0" Fill="{DynamicResource LocalXpRunHighlightBrush}" />
                            <Ellipse x:Name="Orb2" Width="5" Height="5" Margin="0,0,3,0" Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.7" />
                            <Ellipse x:Name="Orb3" Width="5" Height="5" Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.5" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningFill" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="ActionLaunchLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="ScanMove" Storyboard.TargetProperty="X"
                                                         From="-44" To="220" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleX"
                                                         From="0.08" To="1.0" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="Orb1" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.35" Duration="0:0:0.5" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="Orb2" Storyboard.TargetProperty="Opacity"
                                                         From="0.35" To="1" BeginTime="0:0:0.2" Duration="0:0:0.5" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="Orb3" Storyboard.TargetProperty="Opacity"
                                                         From="0.35" To="1" BeginTime="0:0:0.4" Duration="0:0:0.5" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="ActionLaunchLoop" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="ActionRunLoop">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="RunningFrame" Storyboard.TargetProperty="Opacity"
                                                         From="0.7" To="1.0" Duration="0:0:1.4" />
                                        <DoubleAnimation Storyboard.TargetName="Orb1" Storyboard.TargetProperty="Opacity"
                                                         From="0.55" To="1.0" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="ActionRunLoop" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
