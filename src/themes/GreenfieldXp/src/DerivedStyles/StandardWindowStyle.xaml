<!--
    Greenfield XP: DerivedStyles/StandardWindowStyle.xaml.
    Windows XP Luna dialog window: 40px glossy Royal Blue title bar (CaptionHeight == content top margin 40)
    with LocalGreenfieldXpBrandMarkTemplate, bold white Trebuchet MS title, and glossy coral-red Close button.
    WindowDesignStyle is defined standalone (never BasedOn StandardWindowStyle).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource LocalXpBlueDarkBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- 40px Glossy Luna Royal Blue Title Band -->
                                <Border Height="40" VerticalAlignment="Top"
                                        Background="{DynamicResource LocalXpTitleBarBrush}"
                                        BorderBrush="{DynamicResource LocalXpBlueEdgeBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                    <!-- Luna title bar: 1px specular top line and a soft darker lower lip -->
                                    <Rectangle Height="1" VerticalAlignment="Top" Fill="#99FFFFFF" IsHitTestVisible="False" />
                                    <Rectangle Height="3" VerticalAlignment="Bottom" Fill="#33001A7A" IsHitTestVisible="False" />
                                    <DockPanel Margin="10,0,6,0" LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Control Width="20" Height="20" Margin="0,0,8,0"
                                                     Template="{DynamicResource LocalGreenfieldXpBrandMarkTemplate}"
                                                     Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                     IsHitTestVisible="False" />
                                            <Grid VerticalAlignment="Center">
                                                <!-- Luna 1px navy title text shadow -->
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}"
                                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                                           FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                                           Foreground="#FF0A246A" Margin="1,1,0,0" IsHitTestVisible="False" />
                                                <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                                           FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                                           Foreground="{DynamicResource WindowTitleForegroundBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </DockPanel>
                                    </Grid>
                                </Border>

                                <!-- Content pushed cleanly below 40px title band, inside the Luna blue window frame -->
                                <Border Margin="0,40,0,0" BorderBrush="{DynamicResource LocalXpRailBrush}" BorderThickness="3,0,3,3">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Name" Value="WindowSettings">
                            <Setter Property="Text" Value="{DynamicResource LOCSettingsLabel}" TargetName="PART_TextTitle" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="6" TargetName="WindowBorder" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standalone WindowDesignStyle (never BasedOn StandardWindowStyle to avoid Style.Seal crash) -->
    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
</ResourceDictionary>
