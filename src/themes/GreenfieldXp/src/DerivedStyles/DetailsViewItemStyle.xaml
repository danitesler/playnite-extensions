<!--
    Greenfield XP: DerivedStyles/DetailsViewItemStyle.xaml.
    Windows XP Explorer list rows:
    - Animated #EBF3FD sky hot-track wash + #B8D6FB rim on hover; glossy #316AC5 Royal Blue plate + white ink on select.
    - Mandatory RowHoverAction (RowHoverPlay / RowHoverInstall, 26x26 transparent plate, row Foreground) + RowHoverRoom (0,0,38,0).
    - RunningIndicator (#0E8A9E Teal-Cyan frame + wash + launching sweep + running idle pulse + 3-orb mark inside RowRoom 0,0,36,0).
    - Light-theme WindowArtForegroundBrush flip when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LocalRowHoverActionButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl Content="{TemplateBinding Content}"
                                            ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{TemplateBinding Foreground}" />
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="Glyph" />
                            <Setter Property="Width" Value="17" TargetName="Glyph" />
                            <Setter Property="Height" Value="17" TargetName="Glyph" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent" ClipToBounds="True" SnapsToDevicePixels="True">
                        <!-- Hover sky hot-track plate -->
                        <Border x:Name="HoverPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource ListItemHoverBrush}"
                                BorderBrush="{DynamicResource LocalXpRowHoverBorderBrush}" BorderThickness="1"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                        <!-- Selected glossy Luna Royal Blue plate -->
                        <Border x:Name="SelectPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource ListItemSelectedBrush}"
                                BorderBrush="{DynamicResource LocalXpBlueDarkBrush}" BorderThickness="1"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Height="10" VerticalAlignment="Top" CornerRadius="2,2,0,0" Background="#28FFFFFF" />
                        </Border>

                        <!-- Running / Launching Indicator (above hover/selection layers) -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border x:Name="RunningWash" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.16"
                                    Visibility="Collapsed" IsHitTestVisible="False" />
                            <Rectangle x:Name="RunningScan" Width="40" HorizontalAlignment="Left"
                                       Visibility="Collapsed" Opacity="0.38" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="RowScanMove" X="-40" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Border x:Name="RunningFill" Height="2" VerticalAlignment="Bottom" Margin="3,0,3,1"
                                    Background="{DynamicResource LocalXpRunHighlightBrush}" RenderTransformOrigin="0,0.5"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="RowFillScale" ScaleX="0.1" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="RunningFrame" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5"
                                    Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>

                        <!-- Row text content with RowHoverRoom & RowRoom clearance -->
                        <Border x:Name="RowRoom" Padding="0">
                            <Border x:Name="RowHoverRoom" Padding="0">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="RowSlide" X="0" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Border>

                        <!-- Running 3-orb badge anchored right -->
                        <Border x:Name="RunningMarkPlate" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,6,0" Padding="4,3" CornerRadius="2"
                                Background="{DynamicResource RunningIndicatorBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="RowOrb1" Width="4" Height="4" Margin="0,0,2,0" Fill="{DynamicResource LocalXpRunHighlightBrush}" />
                                <Ellipse x:Name="RowOrb2" Width="4" Height="4" Margin="0,0,2,0" Fill="{DynamicResource SelectedForegroundBrush}" Opacity="0.75" />
                                <Ellipse x:Name="RowOrb3" Width="4" Height="4" Fill="{DynamicResource SelectedForegroundBrush}" Opacity="0.55" />
                            </StackPanel>
                        </Border>

                        <!-- RowHoverAction -->
                        <Button x:Name="RowHoverPlay" Content="{DynamicResource IconPlay}"
                                Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LocalRowHoverActionButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="RowHoverInstall" Content="{DynamicResource IconDownload}"
                                Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LocalRowHoverActionButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Padding" Value="0,0,38,0" TargetName="RowHoverRoom" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="RowSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.10">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="RowSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowSelectIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowSelectOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningWash" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningFrame" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningFill" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningMarkPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RowHoverPlay" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RowHoverInstall" />
                            <Setter Property="Padding" Value="0" TargetName="RowHoverRoom" />
                            <Setter Property="Padding" Value="0,0,36,0" TargetName="RowRoom" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RowLaunchLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RowScanMove" Storyboard.TargetProperty="X" From="-40" To="280" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="RowFillScale" Storyboard.TargetProperty="ScaleX" From="0.08" To="1.0" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="RowOrb1" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.5" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RowLaunchLoop" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningWash" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningFrame" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningMarkPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RowHoverPlay" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RowHoverInstall" />
                            <Setter Property="Padding" Value="0" TargetName="RowHoverRoom" />
                            <Setter Property="Padding" Value="0,0,36,0" TargetName="RowRoom" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RowRunLoop">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="RunningFrame" Storyboard.TargetProperty="Opacity" From="0.7" To="1.0" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RowRunLoop" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
