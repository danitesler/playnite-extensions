<!--
    Greenfield XP: DerivedStyles/GridViewItemStyle.xaml.
    Windows XP Explorer Thumbnail covers: 5px-rounded crisp #FFFFFF frame with animated #F8B330 Luna Orange
    hover glow + subtle lift, glossy #316AC5 Royal Blue selection frame, and inset Margin="4" RunningIndicator.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="CardRoot" Margin="{Settings ItemSpacingMargin}" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Border x:Name="CardFrame" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                Background="{DynamicResource GridItemBackgroundBrush}"
                                BorderBrush="{DynamicResource LocalXpTaskBorderBrush}" BorderThickness="1" Padding="3">
                            <ContentPresenter />
                        </Border>

                        <!-- Hover Luna Orange frame -->
                        <Border x:Name="HoverFrame" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" BorderThickness="2.5"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                        <!-- Selected Luna Royal Blue frame -->
                        <Border x:Name="SelectFrame" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" BorderThickness="3"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                        <!-- Running / Launching Indicator (inset Margin="4" above selection/hover) -->
                        <Grid x:Name="RunningIndicator" Margin="4" ClipToBounds="True" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border x:Name="RunningWash" CornerRadius="3" Background="{DynamicResource RunningIndicatorBrush}"
                                    Opacity="0.22" Visibility="Collapsed" />
                            <Rectangle x:Name="RunningScan" Width="48" HorizontalAlignment="Left" Visibility="Collapsed" Opacity="0.45">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="CoverScanMove" X="-48" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Border x:Name="RunningFill" Height="3" VerticalAlignment="Bottom" Margin="4,0,4,4"
                                    CornerRadius="1.5" Background="{DynamicResource LocalXpRunHighlightBrush}"
                                    RenderTransformOrigin="0,0.5" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CoverFillScale" ScaleX="0.1" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="RunningFrame" CornerRadius="3"
                                    BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2.5"
                                    Visibility="Collapsed" />
                            <Border x:Name="RunningMarkPlate" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,6,6,0" Padding="5,3" CornerRadius="3"
                                    Background="{DynamicResource RunningIndicatorBrush}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="CovOrb1" Width="5" Height="5" Margin="0,0,3,0" Fill="{DynamicResource LocalXpRunHighlightBrush}" />
                                    <Ellipse x:Name="CovOrb2" Width="5" Height="5" Margin="0,0,3,0" Fill="{DynamicResource SelectedForegroundBrush}" Opacity="0.75" />
                                    <Ellipse x:Name="CovOrb3" Width="5" Height="5" Fill="{DynamicResource SelectedForegroundBrush}" Opacity="0.55" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CoverHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CoverHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CoverSelectIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CoverSelectOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningWash" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningFrame" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningFill" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningMarkPlate" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="CoverLaunchLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="CoverScanMove" Storyboard.TargetProperty="X" From="-48" To="260" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="CoverFillScale" Storyboard.TargetProperty="ScaleX" From="0.08" To="1.0" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="CovOrb1" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.5" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CoverLaunchLoop" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningWash" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningFrame" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningMarkPlate" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="CoverRunLoop">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="RunningFrame" Storyboard.TargetProperty="Opacity" From="0.7" To="1.0" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CoverRunLoop" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
