<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml.
    The game's dialog: a title bar of hazard stripes (HazardStripesTemplate: HazardStripeBrush on the rail black) with
    the title on a dark plate at its left (WindowTitleBackgroundBrush, bold amber HeadingForegroundBrush,
    GroupBoxHeaderPadding), over the amber-brown panel body (ExpanderBackgroundBrush, 1px brown edge, GroupBoxPadding).
    Without a header only the panel shows.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <DockPanel Background="{TemplateBinding Background}">
                        <Grid x:Name="HeaderPanel" DockPanel.Dock="Top">
                            <Control Focusable="False" IsTabStop="False"
                                     Background="{DynamicResource ShellBackgroundBrush}"
                                     Foreground="{DynamicResource HazardStripeBrush}"
                                     Template="{DynamicResource HazardStripesTemplate}" />
                            <Border HorizontalAlignment="Left" Background="{DynamicResource WindowTitleBackgroundBrush}"
                                    Padding="{DynamicResource GroupBoxHeaderPadding}">
                                <TextBlock Style="{DynamicResource BaseTextBlockStyle}" FontWeight="Bold"
                                           Foreground="{DynamicResource HeadingForegroundBrush}"
                                           FontSize="{DynamicResource GroupBoxHeaderFontSize}">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </TextBlock>
                            </Border>
                        </Grid>
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                          Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderPanel" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
