<!--
    Overlay on Playnite Default/DefaultControls/Thumb.xaml (splitters and other bare thumbs).
    A flat brown bar (ThumbBrush, the panel edge color), dim amber under the pointer, while dragged or focused
    (ThumbHoverBrush). Square.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource ThumbBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Rectangle x:Name="Bar" MinHeight="10" Fill="{TemplateBinding Background}"
                               Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource ThumbHoverBrush}" TargetName="Bar" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource ThumbHoverBrush}" TargetName="Bar" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Track}}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource ThumbHoverBrush}" TargetName="Bar" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
