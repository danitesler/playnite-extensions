<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is Need for Speed: Most Wanted's in-game amber GPS/SMS box (LocalBlacklistPanelTemplate,
    shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: square dark amber-brown box (PopupBackgroundBrush) in a 1px brown edge (PopupBorderBrush), crowned by a 7px
      black-and-amber hazard stripe header band (HazardStripesTemplate) over a 1px amber rule, with four amber L brackets
      (CornerMarksTemplate) locked on the panel corners. No shadow.
    - Rows, rules and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalBlacklistPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" />
            <!-- 7px hazard-striped header band over a 1px amber underline -->
            <Grid Height="8" Margin="1,1,1,0" VerticalAlignment="Top">
                <Control Height="7" VerticalAlignment="Top" Focusable="False" IsTabStop="False"
                         Background="{DynamicResource ShellBackgroundBrush}"
                         Foreground="{DynamicResource HazardStripeBrush}"
                         Template="{DynamicResource HazardStripesTemplate}" />
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource SelectedBrush}" />
            </Grid>
            <!-- Four amber L brackets locked on the panel corners -->
            <Control Focusable="False" IsTabStop="False" Foreground="{DynamicResource SelectedBrush}"
                     Template="{DynamicResource CornerMarksTemplate}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="236" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalBlacklistPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="4,11,4,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
