<!--
    Overlay on Playnite Default/CustomControls/GameMenu.xaml: one line, based on the theme's ContextMenu (DefaultControls/ContextMenu.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GameMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />
</ResourceDictionary>
