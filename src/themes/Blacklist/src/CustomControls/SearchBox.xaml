<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    A controls-grid cell like TextBox.xaml: black (InputBackgroundBrush) with a 1px brown edge, the amber search glyph
    10px in, olive-grey placeholder, the clear glyph on the right (amber under the pointer). Hover lifts the edge to dim
    amber; while typing the edge is amber and the L brackets sit just outside. 32px tall.
    PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon are Playnite's parts (the misspellings are Playnite's).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Chrome" SnapsToDevicePixels="True" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{DynamicResource ControlBorderThickness}">
                            <Grid>
                                <ContentControl x:Name="Glyph" Margin="10,0,0,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                                Foreground="{DynamicResource GlyphBrush}"
                                                ContentTemplate="{DynamicResource SearchTextIconTemplate}" />
                                <TextBlock x:Name="PART_SeachIcon" Margin="34,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource BaseTextBlockStyle}"
                                           Foreground="{DynamicResource TextBrushDarker}"
                                           Text="{DynamicResource LOCSearchLabel}" />
                                <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                         VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                         Padding="32,0,32,0" />
                                <ContentControl x:Name="PART_ClearTextIcon" Margin="0,0,10,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                                Background="Transparent"
                                                Foreground="{DynamicResource TextBrushDarker}"
                                                ContentTemplate="{DynamicResource ClearTextIconTemplate}" />
                            </Grid>
                        </Border>
                        <Control x:Name="Brackets" Visibility="Collapsed" Margin="-3" Focusable="False" IsTabStop="False"
                                 Foreground="{DynamicResource FocusBrush}" Template="{DynamicResource CornerMarksTemplate}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" TargetName="Chrome" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Chrome" />
                        </Trigger>
                        <Trigger SourceName="PART_ClearTextIcon" Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="PART_ClearTextIcon" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Chrome" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Brackets" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glyph" />
                            <Setter Property="Padding" Value="8,0,32,0" TargetName="PART_TextInpuText" />
                            <Setter Property="Margin" Value="10,0,0,0" TargetName="PART_SeachIcon" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
