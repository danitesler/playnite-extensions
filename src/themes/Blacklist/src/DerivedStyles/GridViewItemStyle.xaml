<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml (cover tiles).
    The main-menu carousel's selection box around a cover: hover draws a 1px dim amber outline 3px outside the tile
    (GridViewItemHoverBorderBrush); the selected tile gets that outline in amber plus the game's L brackets 6px outside
    (CornerMarksTemplate in GridViewItemSelectedBorderBrush). The item spacing (Playnite's setting) must leave the
    brackets room; the hovered or selected tile is raised above its neighbors.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <ContentPresenter />
                        <Border x:Name="HoverBorder" BorderThickness="1" Margin="-3" IsHitTestVisible="False" />
                        <Control x:Name="Brackets" Visibility="Collapsed" Margin="-6" Focusable="False" IsTabStop="False"
                                 Foreground="{DynamicResource GridViewItemSelectedBorderBrush}"
                                 Template="{DynamicResource CornerMarksTemplate}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemHoverBorderBrush}" TargetName="HoverBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="HoverBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Brackets" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
