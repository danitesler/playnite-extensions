<!--
    Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml (dialogs and secondary windows: settings, edit
    game, add-ons...). The game's dialog title bar: a 30px band of hazard stripes (HazardStripesTemplate:
    HazardStripeBrush on the rail black) with the window title on a dark plate at its left (WindowTitleBackgroundBrush,
    bold WindowTitleForegroundBrush amber) and the caption buttons (WindowBarButton) on a plate at its right, over the
    warm near-black window (WindowBackgourndBrush) with a 1px brown edge. The whole band drags the window (caption 30).
    Only StandardWindowStyle is restyled; WindowDesignStyle stays Playnite's. PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="30" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource NormalBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <ContentPresenter Margin="0,30,0,0" />
                                <Grid Height="30" VerticalAlignment="Top">
                                    <Control Focusable="False" IsTabStop="False"
                                             Background="{DynamicResource ShellBackgroundBrush}"
                                             Foreground="{DynamicResource HazardStripeBrush}"
                                             Template="{DynamicResource HazardStripesTemplate}" />
                                    <DockPanel LastChildFill="False">
                                        <Border DockPanel.Dock="Left" Background="{DynamicResource WindowTitleBackgroundBrush}" Padding="12,0,14,0">
                                            <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center" FontWeight="Bold"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                        </Border>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource WindowTitleBackgroundBrush}" Padding="4,0,4,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                                <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                                <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
