<!--
    Blacklist: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    The Need for Speed: Most Wanted (2005) menus: a warm near-black page (page 0c0a06), amber-brown panels (panel 271f0f),
    warm off-white body type with olive-grey hints, and the in-game amber (amber f9ac43) for glyphs, headers, links and
    the L brackets that mark the selection. Header bands carry black and amber-brown hazard stripes; a pressed or default
    button is a solid amber plate with dark ink. Square corners throughout.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). Placeholder syntax: see reference.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): list labels 14, panel headers 20, screen titles 30 (1080p sizes x 2/3). -->
    <sys:Double x:Key="FontSizeSmall">{{px:mw-text-sm}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:mw-text-md}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:mw-text-lg}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:mw-text-xl}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:mw-text-2xl}}</sys:Double>
    <!-- Eurostile when installed (a theme cannot ship fonts), else Bahnschrift, which Windows 10+ has. Section headings
         use the frontend's blackletter screen-title face: Old English Text MT ships with Office. -->
    <FontFamily x:Key="FontFamily">Eurostile, Eurostile Extended, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Old English Text MT, UnifrakturMaguntia, Pirata One, Bahnschrift</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys): square corners; 1px panel edges. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:mw-radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- The key glyph boxes of the prompt bar are the only rounded shape. CornerRadiusFull stays square: nothing in the
         game is round, and the repo rule keeps it off every non-square control anyway. -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:mw-key-radius}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">0</CornerRadius>
    <!-- The L brackets: 4px stroke at 1080p -->
    <Thickness x:Key="FrameThickness">{{px:mw-bracket}}</Thickness>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor (selection, checked, links) is the amber; TextColorDark is the dark ink printed on an amber plate.
        MainColor is a control fill (dark amber-brown), MainColorDark the page.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{mw-text}}</Color>
    <Color x:Key="TextColorDarker">{{mw-text-dim}}</Color>
    <Color x:Key="TextColorDark">{{mw-ink}}</Color>
    <Color x:Key="MainColor">{{mw-panel}}</Color>
    <Color x:Key="MainColorDark">{{mw-page}}</Color>
    <Color x:Key="HoverColor">{{mw-panel-raised}}</Color>
    <Color x:Key="GlyphColor">{{mw-amber}}</Color>
    <Color x:Key="HighlightGlyphColor">{{mw-amber/40}}</Color>
    <Color x:Key="PopupBackgroundColor">{{mw-bar}}</Color>
    <Color x:Key="PopupBorderColor">{{mw-edge}}</Color>
    <Color x:Key="BackgroundToneColor">{{mw-panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{mw-rule}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{mw-rule}}</Color>
    <Color x:Key="DataChangeNotifColor">{{mw-heat}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{mw-edge}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{mw-bar}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{mw-panel}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{mw-bar}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{mw-lime}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{mw-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{mw-heat}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{mw-heat}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{mw-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{mw-page}}" />

    <!-- Shell: a stripe-black rail, the header band, the views on the warm near-black page -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{mw-shell}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{mw-page}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{mw-bar}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{mw-shell}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{mw-black}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{mw-edge}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{mw-amber}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{mw-ink}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{mw-page}}" />
    <SolidColorBrush x:Key="HazardStripeBrush" Color="{{mw-stripe-bright}}" />

    <!-- States: the amber brackets frame the selection; the selected row darkens and its text turns bright -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{mw-amber}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{mw-text-bright}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{mw-panel}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{mw-select}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{mw-select}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{mw-amber}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{mw-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{mw-text-bright}}" />

    <!-- Buttons: amber type on the panel fill; pressed and default (Play) are the amber plate with dark ink -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{mw-amber}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{mw-edge}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{mw-panel-raised}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{mw-amber-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{mw-amber-strong}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{mw-amber}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{mw-amber-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{mw-ink}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{mw-select}}" />

    <!-- Inputs: a frontend cell on black; the amber edge marks focus -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{mw-shell}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{mw-black}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{mw-edge}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{mw-amber-dim}}" />

    <!-- Controls: amber box and tick, amber slider fill on the brown rail, amber progress -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{mw-amber-dim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{mw-amber}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{mw-edge}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{mw-text-bright}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{mw-amber}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{mw-edge}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{mw-amber-thumb}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{mw-amber}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{mw-edge}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{mw-edge}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{mw-amber-dim}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{mw-amber}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{mw-amber-dim}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{mw-amber}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{mw-panel}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{mw-select}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{mw-text-dim}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{mw-amber}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{mw-cell}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{mw-text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{mw-select}}" />

    <!-- Popups: the header band with a brown edge -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{mw-rule}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{mw-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{mw-amber-dim}}" />

    <!-- Headings: panel headers in amber (WORLD MAP); dialog title band -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{mw-amber}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{mw-bar}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{mw-amber}}" />
</ResourceDictionary>
