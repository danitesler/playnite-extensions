<!--
    Overlay on Playnite Default/Common.xaml. Spacing, focus and the two pieces of chrome the Most Wanted menus repeat
    everywhere, scaled from 1080p captures by 2/3:
      - the amber L brackets (4px stroke, 16px legs at 1080p: 3 and 10 here) that the game puts in the corners of a
        panel, a selected icon or a selected button (CornerMarksTemplate, drawn in the host's Foreground);
      - the 45 degree hazard stripes (33px period at 1080p, 20 here, half black, half amber-brown) that fill header
        bands, dialog title bars and the tail of the prompt bar (HazardStripesTemplate).
    List rows are 48px at 1080p (32 here): 14px text is about 19px tall, so 32 = 19 + 2 x 6.5.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: the dark header band, 1px brown edge, square -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Four L brackets in the host's Foreground, legs 10, stroke FrameThickness, flush with the host's edges. Hosts give
         it a negative margin to sit just outside the item, as the game does. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderBrush="{TemplateBinding Foreground}" BorderThickness="3,3,0,0" />
            <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                    BorderBrush="{TemplateBinding Foreground}" BorderThickness="0,3,3,0" />
            <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    BorderBrush="{TemplateBinding Foreground}" BorderThickness="3,0,0,3" />
            <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    BorderBrush="{TemplateBinding Foreground}" BorderThickness="0,0,3,3" />
        </Grid>
    </ControlTemplate>

    <!-- Hazard band: the host's Background with 10px stripes every 20px at 45 degrees in its Foreground, clipped to the
         host (up to 2600 x 64; taller hosts show the band in their top 64px). -->
    <ControlTemplate x:Key="HazardStripesTemplate" TargetType="{x:Type Control}">
        <Grid Background="{TemplateBinding Background}" ClipToBounds="True" IsHitTestVisible="False">
            <Path Fill="{TemplateBinding Foreground}" Stretch="None" SnapsToDevicePixels="False"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Data="M-64,0 h10 l-64,64 h-10z M-44,0 h10 l-64,64 h-10z M-24,0 h10 l-64,64 h-10z M-4,0 h10 l-64,64 h-10z M16,0 h10 l-64,64 h-10z M36,0 h10 l-64,64 h-10z M56,0 h10 l-64,64 h-10z M76,0 h10 l-64,64 h-10z M96,0 h10 l-64,64 h-10z M116,0 h10 l-64,64 h-10z M136,0 h10 l-64,64 h-10z M156,0 h10 l-64,64 h-10z M176,0 h10 l-64,64 h-10z M196,0 h10 l-64,64 h-10z M216,0 h10 l-64,64 h-10z M236,0 h10 l-64,64 h-10z M256,0 h10 l-64,64 h-10z M276,0 h10 l-64,64 h-10z M296,0 h10 l-64,64 h-10z M316,0 h10 l-64,64 h-10z M336,0 h10 l-64,64 h-10z M356,0 h10 l-64,64 h-10z M376,0 h10 l-64,64 h-10z M396,0 h10 l-64,64 h-10z M416,0 h10 l-64,64 h-10z M436,0 h10 l-64,64 h-10z M456,0 h10 l-64,64 h-10z M476,0 h10 l-64,64 h-10z M496,0 h10 l-64,64 h-10z M516,0 h10 l-64,64 h-10z M536,0 h10 l-64,64 h-10z M556,0 h10 l-64,64 h-10z M576,0 h10 l-64,64 h-10z M596,0 h10 l-64,64 h-10z M616,0 h10 l-64,64 h-10z M636,0 h10 l-64,64 h-10z M656,0 h10 l-64,64 h-10z M676,0 h10 l-64,64 h-10z M696,0 h10 l-64,64 h-10z M716,0 h10 l-64,64 h-10z M736,0 h10 l-64,64 h-10z M756,0 h10 l-64,64 h-10z M776,0 h10 l-64,64 h-10z M796,0 h10 l-64,64 h-10z M816,0 h10 l-64,64 h-10z M836,0 h10 l-64,64 h-10z M856,0 h10 l-64,64 h-10z M876,0 h10 l-64,64 h-10z M896,0 h10 l-64,64 h-10z M916,0 h10 l-64,64 h-10z M936,0 h10 l-64,64 h-10z M956,0 h10 l-64,64 h-10z M976,0 h10 l-64,64 h-10z M996,0 h10 l-64,64 h-10z M1016,0 h10 l-64,64 h-10z M1036,0 h10 l-64,64 h-10z M1056,0 h10 l-64,64 h-10z M1076,0 h10 l-64,64 h-10z M1096,0 h10 l-64,64 h-10z M1116,0 h10 l-64,64 h-10z M1136,0 h10 l-64,64 h-10z M1156,0 h10 l-64,64 h-10z M1176,0 h10 l-64,64 h-10z M1196,0 h10 l-64,64 h-10z M1216,0 h10 l-64,64 h-10z M1236,0 h10 l-64,64 h-10z M1256,0 h10 l-64,64 h-10z M1276,0 h10 l-64,64 h-10z M1296,0 h10 l-64,64 h-10z M1316,0 h10 l-64,64 h-10z M1336,0 h10 l-64,64 h-10z M1356,0 h10 l-64,64 h-10z M1376,0 h10 l-64,64 h-10z M1396,0 h10 l-64,64 h-10z M1416,0 h10 l-64,64 h-10z M1436,0 h10 l-64,64 h-10z M1456,0 h10 l-64,64 h-10z M1476,0 h10 l-64,64 h-10z M1496,0 h10 l-64,64 h-10z M1516,0 h10 l-64,64 h-10z M1536,0 h10 l-64,64 h-10z M1556,0 h10 l-64,64 h-10z M1576,0 h10 l-64,64 h-10z M1596,0 h10 l-64,64 h-10z M1616,0 h10 l-64,64 h-10z M1636,0 h10 l-64,64 h-10z M1656,0 h10 l-64,64 h-10z M1676,0 h10 l-64,64 h-10z M1696,0 h10 l-64,64 h-10z M1716,0 h10 l-64,64 h-10z M1736,0 h10 l-64,64 h-10z M1756,0 h10 l-64,64 h-10z M1776,0 h10 l-64,64 h-10z M1796,0 h10 l-64,64 h-10z M1816,0 h10 l-64,64 h-10z M1836,0 h10 l-64,64 h-10z M1856,0 h10 l-64,64 h-10z M1876,0 h10 l-64,64 h-10z M1896,0 h10 l-64,64 h-10z M1916,0 h10 l-64,64 h-10z M1936,0 h10 l-64,64 h-10z M1956,0 h10 l-64,64 h-10z M1976,0 h10 l-64,64 h-10z M1996,0 h10 l-64,64 h-10z M2016,0 h10 l-64,64 h-10z M2036,0 h10 l-64,64 h-10z M2056,0 h10 l-64,64 h-10z M2076,0 h10 l-64,64 h-10z M2096,0 h10 l-64,64 h-10z M2116,0 h10 l-64,64 h-10z M2136,0 h10 l-64,64 h-10z M2156,0 h10 l-64,64 h-10z M2176,0 h10 l-64,64 h-10z M2196,0 h10 l-64,64 h-10z M2216,0 h10 l-64,64 h-10z M2236,0 h10 l-64,64 h-10z M2256,0 h10 l-64,64 h-10z M2276,0 h10 l-64,64 h-10z M2296,0 h10 l-64,64 h-10z M2316,0 h10 l-64,64 h-10z M2336,0 h10 l-64,64 h-10z M2356,0 h10 l-64,64 h-10z M2376,0 h10 l-64,64 h-10z M2396,0 h10 l-64,64 h-10z M2416,0 h10 l-64,64 h-10z M2436,0 h10 l-64,64 h-10z M2456,0 h10 l-64,64 h-10z M2476,0 h10 l-64,64 h-10z M2496,0 h10 l-64,64 h-10z M2516,0 h10 l-64,64 h-10z M2536,0 h10 l-64,64 h-10z M2556,0 h10 l-64,64 h-10z M2576,0 h10 l-64,64 h-10z M2596,0 h10 l-64,64 h-10z" />
        </Grid>
    </ControlTemplate>

    <!-- Keyboard focus is the game's selection: amber brackets just outside the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Margin="-4" Focusable="False" IsTabStop="False"
                             Foreground="{DynamicResource FocusBrush}"
                             Template="{DynamicResource CornerMarksTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: a 32px row, 16 inline (the GPS dialog's Yes / No) -->
    <Thickness x:Key="ButtonPadding">16,6.5</Thickness>
    <!-- Text box, password box, dropdown: a controls-grid cell, 8 inline, 32 tall -->
    <Thickness x:Key="InputPadding">8,6.5</Thickness>
    <!-- Menu: the SMS inbox list, 4px around rows 30 tall -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">8,5.5,14,5.5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,5.5,14,5.5</Thickness>
    <!-- List box row: 8 inline, 30 tall -->
    <Thickness x:Key="ListBoxItemPadding">8,5.5</Thickness>
    <!-- Group box: a panel under a striped header band (WORLD MAP header, 12 inside) -->
    <Thickness x:Key="GroupBoxPadding">12</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">10,6</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">14</sys:Double>
    <!-- Tooltip: the prompt-bar plate, 10 / 6 -->
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Glyphs at 18px (the panel header icons, about 26px at 1080p) -->
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">340</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double>
</ResourceDictionary>
