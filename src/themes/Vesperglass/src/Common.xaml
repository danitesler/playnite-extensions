<!--
    Vesperglass: Common.xaml — spacing keys, shared white-mask ImageBrushes, architectural double-hairline frames,
    pointed-hexagonal Play plaque (LocalHexPlateTemplate), 9-slice GlowFrameTemplate, tapered copper-diamond
    DividerTemplate, Hourglass TabItemIndicatorTemplate, BrandMarkTemplate, and Astrolabe EmptyGameTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Spacing & Metric Keys -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>               <!-- Standard form inputs, combos, buttons -->
    <sys:Double x:Key="IconSize">16</sys:Double>                    <!-- Rail and top bar icons -->
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>           <!-- Default hero banner height (0..600) -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>             <!-- Default banner darkening slider (0..1) -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>               <!-- 32px control height rhythm -->
    <Thickness x:Key="InputPadding">10,5</Thickness>                <!-- 32px TextBox / PasswordBox / ComboBox -->
    <Thickness x:Key="MenuPadding">4,7,4,5</Thickness>              <!-- Compact popup board padding -->
    <Thickness x:Key="MenuItemPadding">10,5</Thickness>             <!-- 30px menu rows -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>        <!-- ComboBox popup padding -->
    <Thickness x:Key="ComboBoxItemPadding">10,5</Thickness>         <!-- ComboBox 30px item rows -->
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>          <!-- ListBox rows -->
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>      <!-- Framed GroupBox content inset -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,7</Thickness>              <!-- Dark plum tooltip padding -->

    <!-- Shared FX White-Mask ImageBrushes (allocated once, recolored by ThemeModifier via Fill/Background) -->
    <ImageBrush x:Key="LocalStarFlareMaskBrush" ImageSource="{ThemeFile 'Images/fx/star-flare.png'}" Stretch="Uniform" />
    <ImageBrush x:Key="LocalHourglassGlowMaskBrush" ImageSource="{ThemeFile 'Images/fx/hourglass-glow.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalSheenMaskBrush" ImageSource="{ThemeFile 'Images/fx/sheen-band.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalAstrolabeTileMaskBrush" ImageSource="{ThemeFile 'Images/fx/astrolabe-tile.png'}"
                TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute" Stretch="None" />

    <!-- Popup Border -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard Focus Visual (electric amethyst rim) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="1.5" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 9-Slice Arcane Bloom (bloom.png 128x128: 32px caps, 64px center; zero desired size beyond caps) -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,0,32,32" ViewboxUnits="Absolute" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="32,0,64,32" ViewboxUnits="Absolute" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="96,0,32,32" ViewboxUnits="Absolute" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,32,32,64" ViewboxUnits="Absolute" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="32,32,64,64" ViewboxUnits="Absolute" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="96,32,32,64" ViewboxUnits="Absolute" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,96,32,32" ViewboxUnits="Absolute" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="32,96,64,32" ViewboxUnits="Absolute" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="96,96,32,32" ViewboxUnits="Absolute" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Seamless Tiled Astrolabe & Floating Shards Texture -->
    <ControlTemplate x:Key="LocalAstrolabeBgTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalAstrolabeTileMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Crisp 4-Point Celestial Star Flare -->
    <ControlTemplate x:Key="LocalStarFlareTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalStarFlareMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Tapered Rose-Copper Rule Bisected by Hollow Diamond (zero fixed width — safe inside GroupBox/Statistics) -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="9" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.85" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Border Grid.Column="1" Width="6" Height="6" Margin="6,0"
                    BorderBrush="{TemplateBinding Foreground}" BorderThickness="1"
                    Background="{DynamicResource ShellBackgroundBrush}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="45" />
                </Border.RenderTransform>
            </Border>
            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.15" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Double-Hairline Architectural Frame (outer border + 2px inset inner line, content-sized safe) -->
    <ControlTemplate x:Key="DoubleFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="3" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" Opacity="0.65"
                    CornerRadius="{DynamicResource CornerRadiusSmall}" />
        </Grid>
    </ControlTemplate>

    <!-- Chamfered Copper/Amethyst Corner Marks (zero desired size — sits around hovered/selected cards & covers) -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Data="M0,10 L0,0 L10,0 L10,1.6 L1.6,1.6 L1.6,10 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M10,10 L10,0 L0,0 L0,1.6 L8.4,1.6 L8.4,10 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L0,10 L10,10 L10,8.4 L1.6,8.4 L1.6,0 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M10,0 L10,10 L0,10 L0,8.4 L8.4,8.4 L8.4,0 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <!-- Active Tab Indicator: Veilguard Glowing Twin-Triangle Hourglass + Crisp Bottom Line -->
    <ControlTemplate x:Key="TabItemIndicatorTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Margin="2,-24,2,2" Fill="{TemplateBinding Foreground}" Opacity="0.48"
                       OpacityMask="{DynamicResource LocalHourglassGlowMaskBrush}" />
            <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" />
            <Border Width="5" Height="5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-1.5"
                    Background="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Pointed-Hexagonal Plaque (11px mitered end-caps + center fill + perimeter outline + diamond tips) -->
    <ControlTemplate x:Key="LocalHexPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="11" />
            </Grid.ColumnDefinitions>
            <!-- Solid hexagonal fill across 3 columns so bevel angle stays crisp at any width -->
            <Path Grid.Column="0" Data="M 11,0 L 0,0.5 L 11,1 Z" Stretch="Fill" Fill="{TemplateBinding Background}" Margin="0,0,-0.5,0" />
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Background}" />
            <Path Grid.Column="2" Data="M 0,0 L 11,0.5 L 0,1 Z" Stretch="Fill" Fill="{TemplateBinding Background}" Margin="-0.5,0,0,0" />

            <!-- Crisp perimeter outline -->
            <Path Grid.Column="0" Data="M 11,0.6 L 0.8,20 L 11,39.4" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" Fill="Transparent" />
            <Border Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1.2,0,1.2" />
            <Path Grid.Column="2" Data="M 0,0.6 L 10.2,20 L 0,39.4" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" Fill="Transparent" />

            <!-- Left and right diamond tip accents -->
            <Border Grid.Column="0" Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                    Background="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
            </Border>
            <Border Grid.Column="2" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                    Background="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Original Vesperglass Brand Mark: Faceted Astrolabe-Hourglass Diamond -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="64" Height="64">
                <Path Fill="{TemplateBinding Foreground}"
                      Data="F0 M32,3 L56,32 L32,61 L8,32 Z M32,8.2 L51.4,32 L32,55.8 L12.6,32 Z" />
                <Path Fill="{TemplateBinding Foreground}" Data="M24.2,18.2 L39.8,18.2 L32,25.4 Z" />
                <Path Fill="{TemplateBinding Foreground}" Data="M24.2,45.8 L39.8,45.8 L32,38.6 Z" />
                <Path Fill="{DynamicResource LocalAmethystBrightBrush}"
                      Data="M32,26.2 L33.9,30.1 L37.8,32 L33.9,33.9 L32,37.8 L30.1,33.9 L26.2,32 L30.1,30.1 Z" />
                <Path Fill="{TemplateBinding Foreground}" Data="M16.2,32 L19.8,29 L23.4,32 L19.8,35 Z" />
                <Path Fill="{TemplateBinding Foreground}" Data="M40.6,32 L44.2,29 L47.8,32 L44.2,35 Z" />
                <Path Fill="{TemplateBinding Foreground}" Opacity="0.7"
                      Data="M11,16 L17,10 L19.5,12.5 L13.5,18.5 Z M53,16 L47,10 L44.5,12.5 L50.5,18.5 Z M11,48 L17,54 L19.5,51.5 L13.5,45.5 Z M53,48 L47,54 L44.5,51.5 L50.5,45.5 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- SteamScreenshots Plugin Loading Skeleton -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False">
            <Border Height="220" Background="{TemplateBinding Foreground}" Opacity="0.09"
                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}" Margin="0,0,0,8" />
            <UniformGrid Columns="5">
                <Border Height="46" Margin="0,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.09" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Height="46" Margin="0,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.07" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Height="46" Margin="0,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.09" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Height="46" Margin="0,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.07" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Height="46" Background="{TemplateBinding Foreground}" Opacity="0.09" CornerRadius="{DynamicResource CornerRadiusSmall}" />
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- Empty Game Page: Breathing Astrolabe Concentric Rings + BrandMark over LOCErrorNoGameSelected -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="136" Height="136" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <!-- Soft amethyst halo -->
                    <Control x:Name="EmptyHalo" Template="{DynamicResource GlowFrameTemplate}"
                             Foreground="{DynamicResource LocalAmethystBloomBrush}" Margin="-16" Opacity="0.34" Focusable="False">
                        <Control.Style>
                            <Style TargetType="Control">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="EmptyHaloPulse">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.22" To="0.48" Duration="0:0:2.8">
                                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="EmptyHaloPulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Control.Style>
                    </Control>

                    <!-- Concentric copper astrolabe rings -->
                    <Ellipse Width="132" Height="132" Stroke="{DynamicResource LocalCopperDimBrush}" StrokeThickness="1" Opacity="0.65" />
                    <Ellipse Width="106" Height="106" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1" StrokeDashArray="4 4" Opacity="0.55" />
                    <Ellipse Width="78" Height="78" Stroke="{DynamicResource LocalAmethystBrightBrush}" StrokeThickness="1" Opacity="0.45" />

                    <!-- Cardinal star motes -->
                    <Control Template="{DynamicResource LocalStarFlareTemplate}" Width="24" Height="24"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,8,0,0"
                             Foreground="{DynamicResource LocalAmethystBrightBrush}" Opacity="0.72" Focusable="False" />
                    <Control Template="{DynamicResource LocalStarFlareTemplate}" Width="18" Height="18"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,12"
                             Foreground="{DynamicResource LocalCopperSoftBrush}" Opacity="0.65" Focusable="False" />

                    <!-- Central Vesperglass Brand Mark -->
                    <Control Template="{DynamicResource BrandMarkTemplate}" Width="56" Height="56"
                             Foreground="{DynamicResource FrameBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                </Grid>

                <Control Template="{DynamicResource DividerTemplate}" Width="220" Margin="0,0,0,14"
                         Foreground="{DynamicResource FrameBrush}" BorderBrush="{DynamicResource LocalCopperDimBrush}" Focusable="False" />

                <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                           FontFamily="{DynamicResource HeadingFontFamily}"
                           FontSize="{DynamicResource FontSizeLarge}"
                           Foreground="{DynamicResource TextBrushDarker}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <!-- Section Heading TextBlock Style -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a Veilguard hourglass, two outlined bulbs under brass-lit caps with amethyst sand piled low. Hover: the glass turns over (180 degrees with a small overshoot), the sand swapping ends. Open (ContextMenu.IsOpen of the nearest Border): an amethyst thread of sand draws through the waist, grains keep falling down it and a four-point alabaster star flare opens over the waist and breathes until the menu closes. -->
    <ControlTemplate x:Key="LocalVesperglassMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas x:Name="Glass" Width="26" Height="26" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><RotateTransform x:Name="GlassFlip" Angle="0" /></Canvas.RenderTransform>
                    <Path Data="M7,5.4 H19 L13,12.6 Z M13,13.4 L19,20.6 H7 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeLineJoin="Miter" />
                    <Rectangle Canvas.Left="5" Canvas.Top="3" Width="16" Height="2" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="5" Canvas.Top="21" Width="16" Height="2" Fill="{TemplateBinding Foreground}" />
                    <Path Data="M13,16.4 L16.2,20.6 H9.8Z" Fill="{DynamicResource LocalAmethystBrightBrush}" />
                    <Path Data="M9.4,5.4 H16.6 L13,8.6 Z" Fill="{DynamicResource LocalAmethystBrightBrush}" Opacity="0.55" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Rectangle x:Name="Thread" Canvas.Left="12.4" Canvas.Top="9" Width="1.2" Height="11" Fill="{DynamicResource LocalAmethystBrightBrush}" RenderTransformOrigin="0.5,0" Opacity="0">
                        <Rectangle.RenderTransform><ScaleTransform x:Name="ThreadScale" ScaleY="0.1" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Ellipse x:Name="GrainA" Canvas.Left="12.1" Canvas.Top="10" Width="1.8" Height="1.8" Fill="{DynamicResource LocalAlabasterBrush}" Opacity="0">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="GrainAFall" Y="0" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="GrainB" Canvas.Left="12.1" Canvas.Top="10" Width="1.8" Height="1.8" Fill="{DynamicResource LocalAlabasterBrush}" Opacity="0">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="GrainBFall" Y="0" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Path x:Name="Flare" Data="M13,6.6 C13.5,10.2 14.4,12.2 18.4,13 C14.4,13.8 13.5,15.8 13,19.4 C12.5,15.8 11.6,13.8 7.6,13 C11.6,12.2 12.5,10.2 13,6.6Z" Fill="{DynamicResource LocalAlabasterBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><ScaleTransform x:Name="FlareScale" ScaleX="0.2" ScaleY="0.2" /></Path.RenderTransform>
                    </Path>
                </Canvas>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="GlassFlip" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GlassFlip" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Thread" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.05" Duration="0:0:0.1"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ThreadScale" Storyboard.TargetProperty="ScaleY" To="1" BeginTime="0:0:0.05" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GrainA" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.3" Duration="0:0:0.1"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GrainAFall" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.3" Duration="0:0:0.01"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GrainAFall" Storyboard.TargetProperty="Y" From="0" To="8" BeginTime="0:0:0.3" Duration="0:0:0.8" RepeatBehavior="Forever"></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GrainB" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.7" Duration="0:0:0.1"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GrainBFall" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.7" Duration="0:0:0.01"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GrainBFall" Storyboard.TargetProperty="Y" From="0" To="8" BeginTime="0:0:0.7" Duration="0:0:0.8" RepeatBehavior="Forever"></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Flare" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.15" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
