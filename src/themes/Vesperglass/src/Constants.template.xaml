<!--
    Vesperglass: Constants.xaml template (Dragon Age: The Veilguard inspired theme).
    scripts/build-theme.ps1 renders tokens.css placeholders into Constants.xaml.
    Palette maps by role: Deep Aubergine-Plum surfaces, Burnished Rose-Copper chrome & Play CTA,
    Electric Amethyst selection/focus/hourglass, Lyrium Frost Cyan running/launching,
    Vitality Emerald active filter star, and Veilguard Crimson alerts/Exit.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">13.5</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">19</sys:Double>
    <sys:Double x:Key="FontSizeLargest">28</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Cinzel, {{text:vg-font-heading|Cinzel, Georgia, Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Game page metadata pane defaults (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape & radii -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:vg-radius|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:vg-radius-sm|1}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:vg-radius-lg|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{vg-ink}}</Color>
    <Color x:Key="TextColorDarker">{{vg-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{vg-ink-dark}}</Color>
    <Color x:Key="MainColor">{{vg-panel}}</Color>
    <Color x:Key="MainColorDark">{{vg-void}}</Color>
    <Color x:Key="HoverColor">{{vg-amethyst-hover}}</Color>
    <Color x:Key="GlyphColor">{{vg-amethyst}}</Color>
    <Color x:Key="HighlightGlyphColor">{{vg-amethyst-bright}}</Color>
    <Color x:Key="PopupBackgroundColor">{{vg-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{vg-copper}}</Color>
    <Color x:Key="BackgroundToneColor">{{vg-slate}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{vg-copper-faint}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{vg-copper-faint}}</Color>
    <Color x:Key="DataChangeNotifColor">{{vg-emerald}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{vg-copper-dim}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{vg-panel}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{vg-panel}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{vg-well}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{vg-emerald}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{vg-crimson}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{vg-warning}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{vg-warning}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{vg-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{vg-page}}" />

    <!-- Shared Shell & Game Page Brushes -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{vg-void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{vg-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{vg-page}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{vg-page}}" />
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{vg-void}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{vg-void}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{vg-void}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{vg-copper-soft}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{vg-well}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{vg-panel}}" />

    <!-- Shared State Brushes -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{vg-amethyst-deep}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{vg-amethyst-sel-hi}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{vg-amethyst-bright}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{vg-ink}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{vg-amethyst-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{vg-amethyst-deep}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{vg-amethyst-deep}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{vg-lyrium}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{vg-amethyst-bright}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{vg-focus-halo}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{vg-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{vg-crimson-fg}}" />

    <!-- Shared Button Brushes -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{vg-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{vg-panel-alt}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{vg-panel-press}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{vg-copper-dim}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{vg-copper}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{vg-copper-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{vg-copper-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{vg-copper-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{vg-ink-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{vg-amethyst-bloom}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{vg-panel}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{vg-copper-dim}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{vg-panel-alt}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{vg-panel-press}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{vg-amethyst-sel-hi}}" />

    <!-- Shared Input & Control Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{vg-well}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{vg-panel}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{vg-copper-dim}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{vg-copper}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{vg-copper-dim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{vg-copper}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{vg-well}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{vg-void}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{vg-copper-hi}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{vg-amethyst-bright}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{vg-amethyst}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{vg-well}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{vg-copper-dim}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{vg-copper}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{vg-void}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{vg-copper-dim}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{vg-copper}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{vg-ink-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{vg-ink}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{vg-amethyst-bright}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{vg-copper}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{vg-copper}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{vg-amethyst-bright}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{vg-amethyst-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{vg-amethyst-sel-hi}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{vg-ink-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{vg-ink}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{vg-amethyst-bloom}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{vg-slate}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{vg-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{vg-amethyst-hover}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{vg-copper-soft}}" />

    <!-- Shared Popup, Frame & Typography Brushes -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{vg-copper-dim}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{vg-ink}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{vg-copper}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{vg-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{vg-ink}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{vg-copper}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{vg-copper-faint}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{vg-copper-hi}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{vg-copper-dim}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{vg-copper-hi}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{vg-void}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{vg-ink}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{vg-amethyst}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{vg-copper-dim}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{vg-copper-soft}}" />

    <!-- Theme-Local Accent & Running Support Brushes -->
    <SolidColorBrush x:Key="LocalCopperSoftBrush" Color="{{vg-copper-soft}}" />
    <SolidColorBrush x:Key="LocalCopperDimBrush" Color="{{vg-copper-dim}}" />
    <SolidColorBrush x:Key="LocalCopperHiBrush" Color="{{vg-copper-hi}}" />
    <SolidColorBrush x:Key="LocalCopperFaintBrush" Color="{{vg-copper-faint}}" />
    <SolidColorBrush x:Key="LocalAlabasterBrush" Color="{{vg-alabaster}}" />
    <SolidColorBrush x:Key="LocalAmethystBrightBrush" Color="{{vg-amethyst-bright}}" />
    <SolidColorBrush x:Key="LocalAmethystBloomBrush" Color="{{vg-amethyst-bloom}}" />
    <SolidColorBrush x:Key="LocalLyriumLitBrush" Color="{{vg-lyrium-lit}}" />
    <SolidColorBrush x:Key="LocalLyriumForegroundBrush" Color="{{vg-lyrium-fg}}" />
    <SolidColorBrush x:Key="LocalDangerLitBrush" Color="{{vg-crimson-lit}}" />
    <SolidColorBrush x:Key="LocalSlateWellBrush" Color="{{vg-slate}}" />
</ResourceDictionary>
