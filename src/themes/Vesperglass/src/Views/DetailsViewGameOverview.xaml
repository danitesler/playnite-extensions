                                <Control Template="{DynamicResource EmptyGameTemplate}" Foreground="{DynamicResource FrameBrush}" Focusable="False" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
