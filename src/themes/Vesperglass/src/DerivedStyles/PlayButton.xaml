<!--
    Vesperglass: PlayButton (Hero Moment), RunningActionIndicator, and SecondaryButton (40x40 More/Edit).
    - PlayButton: burnished rose-copper pointed-hexagonal plaque (LocalHexPlateTemplate) with Cinzel Bold deep-plum ink
      (6.5:1 contrast). Hover blooms a 9-slice amethyst aura (bloom.png), lights corner 4-point star flares (star-flare.png),
      and glides a diagonal crystal sheen (sheen-band.png); Press uses a separate deeper copper plate.
    - IdleHoverHost wraps all idle hover layers so Launching/Running collapse idle hover cleanly (no storyboard override).
    - Tag="ContextAction" hides PlayGlyph so LAUNCHING / RUNNING / INSTALL wear the exact same hexagonal plaque.
    - Launching & Running: solid Lyrium Frost Cyan (RunningIndicatorBrush #147E9E) plate darkened by ScrimBrush
      RunningBreath (0.5 launching, 0.24..0.42 running) under crisp white text (>6:1 worst-frame contrast),
      diagonal Lyrium RunningScan sweep while launching, PlayRoom reserving 46px right strip for the 3-socket Lyrium
      Dagger diamond runes, and Cancel shown ONLY on IsRunning + IsMouseOver (RelativeSource Self) with PlayContent Hidden.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="176" />
        <Setter Property="Padding" Value="24,4,24,4" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Base solid pointed-hexagonal plaque -->
                        <Control x:Name="BasePlate" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                 Foreground="{DynamicResource LocalCopperHiBrush}" Focusable="False" IsHitTestVisible="False" />

                        <!-- Non-animated host for ALL idle hover effects so Launching/Running collapse them cleanly -->
                        <Grid x:Name="IdleHoverHost" IsHitTestVisible="False">
                            <Control x:Name="AmethystBloom" Template="{DynamicResource GlowFrameTemplate}"
                                     Foreground="{DynamicResource PrimaryButtonGlowBrush}" Margin="-26,-22"
                                     Visibility="Collapsed" Opacity="0" Focusable="False" IsHitTestVisible="False" />
                            <Control x:Name="CopperBloom" Template="{DynamicResource GlowFrameTemplate}"
                                     Foreground="{DynamicResource LocalCopperHiBrush}" Margin="-16,-14"
                                     Visibility="Collapsed" Opacity="0" Focusable="False" IsHitTestVisible="False" />
                            <Control x:Name="HoverPlate" Template="{DynamicResource LocalHexPlateTemplate}"
                                     Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                     BorderBrush="{DynamicResource LocalAlabasterBrush}"
                                     Foreground="{DynamicResource LocalAlabasterBrush}"
                                     Visibility="Collapsed" Opacity="0" Focusable="False" IsHitTestVisible="False" />
                            <Grid x:Name="SheenHost" Margin="10,1,10,1" ClipToBounds="True" Visibility="Collapsed" IsHitTestVisible="False">
                                <Rectangle x:Name="CrystalSheen" Width="120" HorizontalAlignment="Left"
                                           Fill="{DynamicResource LocalAlabasterBrush}" Opacity="0.48"
                                           OpacityMask="{DynamicResource LocalSheenMaskBrush}">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="SheenX" X="-120" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Control x:Name="CornerStarTL" Template="{DynamicResource LocalStarFlareTemplate}"
                                     Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,-11,0,0"
                                     Foreground="{DynamicResource LocalAlabasterBrush}"
                                     Visibility="Collapsed" Opacity="0" Focusable="False" IsHitTestVisible="False" />
                            <Control x:Name="CornerStarBR" Template="{DynamicResource LocalStarFlareTemplate}"
                                     Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,-10"
                                     Foreground="{DynamicResource LocalAmethystBrightBrush}"
                                     Visibility="Collapsed" Opacity="0" Focusable="False" IsHitTestVisible="False" />
                        </Grid>

                        <!-- Separate Pressed plate -->
                        <Control x:Name="PressedPlate" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                 BorderBrush="{DynamicResource FrameBrush}"
                                 Foreground="{DynamicResource LocalCopperDimBrush}"
                                 Visibility="Collapsed" Opacity="0" Focusable="False" IsHitTestVisible="False" />

                        <!-- Running / Launching darkened ScrimBreath layer (exact hex shape, under label) -->
                        <Control x:Name="RunningBreath" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent" Foreground="Transparent"
                                 Visibility="Collapsed" Opacity="0" Focusable="False" IsHitTestVisible="False" />

                        <!-- Launching diagonal Lyrium Frost Cyan progress sweep (exact hex shape, under label) -->
                        <Control x:Name="RunningScan" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="{DynamicResource RunningIndicatorBrush}" BorderBrush="Transparent" Foreground="Transparent"
                                 Visibility="Collapsed" Opacity="0.62" Focusable="False" IsHitTestVisible="False">
                            <Control.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.22">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                    <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                </LinearGradientBrush>
                            </Control.OpacityMask>
                        </Control>

                        <!-- Running hover dim scrim (shown ONLY when IsRunning + Self.IsMouseOver, below CancelLabel) -->
                        <Control x:Name="RunningHoverDim" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent" Foreground="Transparent"
                                 Opacity="0" Focusable="False" IsHitTestVisible="False" />

                        <!-- Label host with PlayRoom (no local Padding so DataTriggers reserve the right rune strip) -->
                        <Border x:Name="PlayRoom">
                            <Grid Margin="{TemplateBinding Padding}">
                                <StackPanel x:Name="PlayContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentControl x:Name="PlayGlyph" Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                    Foreground="{TemplateBinding Foreground}" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </StackPanel>
                                <!-- Cancel label shown ONLY on IsRunning + IsMouseOver (RelativeSource Self) -->
                                <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                           FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Idle Play hover bloom + star glints + crystal sheen -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AmethystBloom" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CopperBloom" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CornerStarTL" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CornerStarBR" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SheenHost" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="AmethystBloom" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="CopperBloom" Storyboard.TargetProperty="Opacity" To="0.42" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="CornerStarTL" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="CornerStarBR" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="SheenX" Storyboard.TargetProperty="X" From="-120" To="240" Duration="0:0:0.55">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28" />
                                        <DoubleAnimation Storyboard.TargetName="AmethystBloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32" />
                                        <DoubleAnimation Storyboard.TargetName="CopperBloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28" />
                                        <DoubleAnimation Storyboard.TargetName="CornerStarTL" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="CornerStarBR" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.32" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AmethystBloom" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.32" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CopperBloom" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.32" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CornerStarTL" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.32" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CornerStarBR" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.32" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SheenHost" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.32" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayPressIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- RunningMarkRoom left="0" right="46" -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="BasePlate" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="BasePlate" Property="BorderBrush" Value="{DynamicResource LocalLyriumLitBrush}" />
                            <Setter TargetName="BasePlate" Property="Foreground" Value="{DynamicResource LocalLyriumLitBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalLyriumForegroundBrush}" />
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,46,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayLaunchingPlate">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity"
                                                         From="0.34" To="0.5" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.38,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.4" KeySpline="0.38,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.402" KeySpline="0.38,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayLaunchingPlate" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="BasePlate" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="BasePlate" Property="BorderBrush" Value="{DynamicResource LocalLyriumLitBrush}" />
                            <Setter TargetName="BasePlate" Property="Foreground" Value="{DynamicResource LocalLyriumLitBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalLyriumForegroundBrush}" />
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,46,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayRunningPlate">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.24" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.24" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayRunningPlate" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Cancel ONLY while IsRunning + pointer over PlayButton itself (RelativeSource Self, never TemplatedParent) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="RunningCancelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Game Page Action Overlay: Lyrium Frost Cyan Hex Frame + Diamond-Capped Foot Line + 3-Socket Lyrium Dagger Runes -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.92" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Control x:Name="RunningWash" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="{DynamicResource RunningIndicatorBrush}" BorderBrush="Transparent" Foreground="Transparent"
                                 Opacity="0.11" Focusable="False" />
                        <Control x:Name="RunningFrame" Template="{DynamicResource LocalHexPlateTemplate}"
                                 Background="Transparent" BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                 Foreground="{DynamicResource LocalLyriumLitBrush}" Focusable="False" />

                        <!-- Diamond-end-capped foot line 5px above bottom -->
                        <Grid Height="6" Margin="14,0,14,4" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" Height="4" Background="{DynamicResource LocalLyriumLitBrush}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                            </Border>
                            <Grid Grid.Column="1" Height="2" VerticalAlignment="Center" Margin="-1,0">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.34" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalLyriumLitBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Border Grid.Column="2" Width="4" Height="4" Background="{DynamicResource LocalLyriumLitBrush}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                            </Border>
                        </Grid>

                        <!-- 3-Socket Lyrium Dagger Diamond Runes inside the reserved 46px right strip -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,1">
                            <Border x:Name="RunningRune1" Width="5.5" Height="5.5" Margin="0,0,5,0"
                                    Background="{DynamicResource LocalLyriumLitBrush}" BorderBrush="{DynamicResource LocalLyriumForegroundBrush}" BorderThickness="0.6"
                                    Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="Rune1Scale" ScaleX="1" ScaleY="1" />
                                        <RotateTransform Angle="45" />
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="RunningRune2" Width="5.5" Height="5.5" Margin="0,0,5,0"
                                    Background="{DynamicResource LocalLyriumLitBrush}" BorderBrush="{DynamicResource LocalLyriumForegroundBrush}" BorderThickness="0.6"
                                    Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="Rune2Scale" ScaleX="1" ScaleY="1" />
                                        <RotateTransform Angle="45" />
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="RunningRune3" Width="5.5" Height="5.5"
                                    Background="{DynamicResource LocalLyriumLitBrush}" BorderBrush="{DynamicResource LocalLyriumForegroundBrush}" BorderThickness="0.6"
                                    Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="Rune3Scale" ScaleX="1" ScaleY="1" />
                                        <RotateTransform Angle="45" />
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.38,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.28" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRune1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.82" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rune1Scale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.82" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="1.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rune1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.82" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="1.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRune2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.92" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rune2Scale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.92" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="1.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rune2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.92" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="1.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRune3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.02" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rune3Scale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.02" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rune3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.02" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRune1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRune2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRune3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 40x40 Square Icon-Only Secondary Action Button (More, Edit) -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LocalCopperSoftBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="BasePlate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border Margin="3" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" Opacity="0.65"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" IsHitTestVisible="False" />
                        <Border x:Name="HoverPlate" Background="{DynamicResource SecondaryButtonHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource LocalAmethystBrightBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="PressedPlate" Background="{DynamicResource SecondaryButtonPressedBackgroundBrush}"
                                BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LocalAlabasterBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecPressIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
