<!--
    Vesperglass: DetailsViewItemStyle (Details View Library Rows).
    - Hover (IsMouseOver): smooth amethyst plum wash + copper rim + sliding left copper diamond tick + +2px content glide.
    - Click/Selection (IsSelected): Veilguard Load/Save double-bordered electric amethyst rim + vertical bright amethyst bar
      scaling in + 4-point celestial star flare popping in at top-left (BackEase 0.22).
    - RowHoverAction: transparent Play / Install hover glyphs (14px -> 17px) inheriting row Foreground, hidden during
      IsLaunching / IsRunning, with RowHoverRoom reserving 38px right padding so text never overlaps.
    - RunningIndicator: Lyrium Frost Cyan 2px frame + dark keyline + wash + diagonal sweep + diamond-capped foot line +
      RunningMarkPlate + 3 cascading Lyrium Dagger diamond runes inside 38px RowRoom.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="4,1,4,1" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="RowRoot" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Hover layer (Collapsed at rest) -->
                        <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Background="{DynamicResource ListItemHoverBrush}"
                                    BorderBrush="{DynamicResource LocalCopperDimBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border x:Name="HoverTick" Width="4.5" Height="4.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                    Background="{DynamicResource FrameBrush}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="45" />
                                        <TranslateTransform x:Name="HoverTickX" X="-5" />
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <!-- Selected layer (Veilguard Load/Save double amethyst rim + 4-point star flare, Collapsed at rest) -->
                        <Grid x:Name="SelectedLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Background="{DynamicResource ListItemSelectedBrush}"
                                    BorderBrush="{DynamicResource LocalAmethystBrightBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border Margin="2" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" Opacity="0.7"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" />
                            <Rectangle x:Name="SelectedBar" Width="2" Margin="0,3" HorizontalAlignment="Left"
                                       Fill="{DynamicResource LocalAmethystBrightBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="SelectedBarScaleY" ScaleY="0.2" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Control x:Name="SelectedStar" Template="{DynamicResource LocalStarFlareTemplate}"
                                     Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-7,-7,0,0"
                                     Foreground="{DynamicResource LocalAmethystBrightBrush}" Focusable="False" RenderTransformOrigin="0.5,0.5">
                                <Control.RenderTransform>
                                    <ScaleTransform x:Name="SelectedStarScale" ScaleX="0.5" ScaleY="0.5" />
                                </Control.RenderTransform>
                            </Control>
                        </Grid>

                        <!-- Running / Launching Indicator (AFTER hover & selection layers, BEFORE content) -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.92" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.16"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border x:Name="RunningMarkPlate" Width="44" HorizontalAlignment="Right" Margin="2"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.36">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource LocalLyriumLitBrush}" Opacity="0.42"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.22">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <!-- 2px Lyrium foot progress bar -->
                            <Grid Height="2" Margin="5,0,5,3" VerticalAlignment="Bottom">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.32" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalLyriumLitBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <!-- 2px Lyrium frame + 1px dark keyline inside -->
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1" Opacity="0.7"
                                        CornerRadius="{DynamicResource CornerRadiusSmall}" />
                            </Border>
                            <!-- 3-Socket Lyrium Dagger Diamond Runes -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,1">
                                <Border x:Name="RunningRune1" Width="5" Height="5" Margin="0,0,4,0"
                                        Background="{DynamicResource LocalLyriumLitBrush}" BorderBrush="{DynamicResource LocalLyriumForegroundBrush}" BorderThickness="0.5"
                                        Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="Rune1Scale" ScaleX="1" ScaleY="1" />
                                            <RotateTransform Angle="45" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="RunningRune2" Width="5" Height="5" Margin="0,0,4,0"
                                        Background="{DynamicResource LocalLyriumLitBrush}" BorderBrush="{DynamicResource LocalLyriumForegroundBrush}" BorderThickness="0.5"
                                        Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="Rune2Scale" ScaleX="1" ScaleY="1" />
                                            <RotateTransform Angle="45" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="RunningRune3" Width="5" Height="5"
                                        Background="{DynamicResource LocalLyriumLitBrush}" BorderBrush="{DynamicResource LocalLyriumForegroundBrush}" BorderThickness="0.5"
                                        Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="Rune3Scale" ScaleX="1" ScaleY="1" />
                                            <RotateTransform Angle="45" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Content host with RowRoom (running) and RowHoverRoom (hover action button) -->
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <Border x:Name="RowRoom">
                                <Border x:Name="RowHoverRoom">
                                    <ContentPresenter x:Name="ContentHost"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                        <ContentPresenter.RenderTransform>
                                            <TranslateTransform x:Name="RowSlideX" X="0" />
                                        </ContentPresenter.RenderTransform>
                                    </ContentPresenter>
                                </Border>
                            </Border>
                        </Border>

                        <!-- RowHoverAction: transparent Play / Install hover glyphs, hidden during Launching/Running -->
                        <Button x:Name="RowHoverPlay" Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                Width="26" Height="26" MinWidth="26" MinHeight="26" Padding="0" Focusable="False" Cursor="Hand"
                                ToolTip="{DynamicResource LOCPlayGame}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                        Foreground="{TemplateBinding Foreground}" Focusable="False" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                        <Setter TargetName="Glyph" Property="Width" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Height" Value="17" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="RowHoverInstall" Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                Width="26" Height="26" MinWidth="26" MinHeight="26" Padding="0" Focusable="False" Cursor="Hand"
                                ToolTip="{DynamicResource LOCInstallGame}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl Content="{DynamicResource IconDownload}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                        Foreground="{TemplateBinding Foreground}" Focusable="False" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                        <Setter TargetName="Glyph" Property="Width" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Height" Value="17" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverTickX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RowSlideX" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="HoverTickX" Storyboard.TargetProperty="X" To="-5" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="RowSlideX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowSelIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelectedBarScaleY" Storyboard.TargetProperty="ScaleY" From="0.2" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelectedStarScale" Storyboard.TargetProperty="ScaleX" From="0.45" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.22" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelectedStarScale" Storyboard.TargetProperty="ScaleY" From="0.45" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.22" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowSelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBarScaleY" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Running / Launching triggers (AFTER hover & selection) -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,44,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.38,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.4" KeySpline="0.38,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.402" KeySpline="0.38,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.38,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.28" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRune1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.82" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rune1Scale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.82" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="1.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rune1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.82" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="1.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRune2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.92" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rune2Scale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.92" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="1.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rune2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.92" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="1.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRune3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.02" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rune3Scale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.02" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rune3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.02" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,44,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
