<!--
    Vesperglass: StandardWindowStyle (Settings, Add-ons, Game Editor, dialogs).
    44px twilight aubergine title band (CaptionHeight=44 matching ContentPresenter top margin 0,44,0,0):
    - Subtle Astrolabe tile texture + ghosted concentric Astrolabe Rings & Floating Shards vector graphic in a zero-size Canvas.
    - Vesperglass Astrolabe-Hourglass Diamond brand mark, carved Cinzel uppercase title (WindowSettings sets LOCSettingsLabel;
      PART_TextTitle sits safely inside a Visibility="Collapsed" parent so Playnite never draws bare stray text).
    - Tapered copper-diamond closing rule & 46x44 WindowBarButton captions.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" ClipToBounds="True">
                                    <Border Background="{DynamicResource WindowTitleBackgroundBrush}" />
                                    <Control Template="{DynamicResource LocalAstrolabeBgTemplate}"
                                             Foreground="{DynamicResource FrameBrush}" Opacity="0.045"
                                             Focusable="False" IsHitTestVisible="False" />

                                    <!-- Ghosted Astrolabe Concentric Rings & Diamond Nexus in a zero-size Canvas -->
                                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-30,360,0"
                                            Width="0" Height="0" IsHitTestVisible="False" Opacity="0.22">
                                        <Ellipse Canvas.Left="48" Canvas.Top="0" Width="104" Height="104"
                                                 Stroke="{DynamicResource FrameBrush}" StrokeThickness="1.1" />
                                        <Ellipse Canvas.Left="64" Canvas.Top="16" Width="72" Height="72"
                                                 Stroke="{DynamicResource LocalAmethystBrightBrush}" StrokeThickness="1" StrokeDashArray="4 4" />
                                        <Ellipse Canvas.Left="82" Canvas.Top="34" Width="36" Height="36"
                                                 Stroke="{DynamicResource FrameBrush}" StrokeThickness="1" />
                                        <Rectangle Canvas.Left="0" Canvas.Top="52" Width="200" Height="1"
                                                   Fill="{DynamicResource LocalCopperDimBrush}" />
                                        <Path Canvas.Left="84" Canvas.Top="18" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1"
                                              Data="M 16,0 L 32,34 L 16,68 L 0,34 Z" />
                                    </Canvas>

                                    <!-- Closing copper hairline + centered hollow diamond -->
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource LocalCopperDimBrush}" IsHitTestVisible="False" />
                                    <Border Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3"
                                            Background="{DynamicResource WindowTitleBackgroundBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1"
                                            RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                        <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                                    </Border>

                                    <!-- PART_TextTitle inside Collapsed parent so Playnite never draws bare default title text -->
                                    <Border Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="{TemplateBinding Title}" x:Name="PART_TextTitle" Width="0" Height="0" Opacity="0" Foreground="Transparent" />
                                    </Border>

                                    <DockPanel Margin="14,0,146,0" LastChildFill="False" IsHitTestVisible="False">
                                        <Control DockPanel.Dock="Left" Template="{DynamicResource BrandMarkTemplate}"
                                                 Foreground="{DynamicResource LocalCopperSoftBrush}" Width="22" Height="22"
                                                 VerticalAlignment="Center" Focusable="False" />
                                        <TextBlock DockPanel.Dock="Left" Margin="10,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Text, ElementName=PART_TextTitle, Converter={StaticResource StringToUpperCaseConverter}}"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                                   FontWeight="Bold" Foreground="{DynamicResource WindowTitleForegroundBrush}" />
                                    </DockPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
