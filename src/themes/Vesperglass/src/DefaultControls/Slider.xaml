<!--
    Vesperglass: Slider — Dragon Age: The Veilguard Settings rotated-diamond double-outline thumb (SliderThumb)
    on an ultra-slim 4px recessed rail (CornerRadius="2") with copper end-cap ticks and luminous amethyst fill.
    Disables ThemeModifier's GameBannerHeight & GameBannerDarken sliders while ShowBackgroundImageOnWindow=True.
    Track.Thumb is declared LAST per WPF stacking rules.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SliderRangeButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent">
                        <Border x:Name="OuterDiamond" Width="12" Height="12"
                                Background="{DynamicResource SliderThumbBackgroundBrush}"
                                BorderBrush="{DynamicResource LocalAmethystBrightBrush}" BorderThickness="1.8"
                                HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1" />
                                    <RotateTransform Angle="45" />
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="CoreDiamond" Width="4.5" Height="4.5"
                                Background="{DynamicResource LocalCopperHiBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                IsHitTestVisible="False">
                            <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterDiamond" Property="BorderBrush" Value="{DynamicResource SliderThumbHoverBorderBrush}" />
                            <Setter TargetName="CoreDiamond" Property="Background" Value="{DynamicResource LocalAlabasterBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ThumbHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ThumbHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="OuterDiamond" Property="BorderBrush" Value="{DynamicResource LocalAlabasterBrush}" />
                            <Setter TargetName="OuterDiamond" Property="Background" Value="{DynamicResource SelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Subtle Veilguard copper end ticks -->
                        <Path Grid.Column="0" Data="M4,0 L0,3 L4,6 Z" Width="4" Height="6" Margin="0,0,5,0"
                              Fill="{DynamicResource FrameBrush}" VerticalAlignment="Center" Opacity="0.7" IsHitTestVisible="False" />
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Border Height="4" Background="{DynamicResource SliderTrackBrush}"
                                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                                    CornerRadius="2" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{DynamicResource SliderRangeButton}" Command="Slider.DecreaseLarge"
                                                  Background="{DynamicResource GlyphBrush}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{DynamicResource SliderRangeButton}" Command="Slider.IncreaseLarge"
                                                  Background="Transparent" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <Path Grid.Column="2" Data="M0,0 L4,3 L0,6 Z" Width="4" Height="6" Margin="5,0,0,0"
                              Fill="{DynamicResource FrameBrush}" VerticalAlignment="Center" Opacity="0.7" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Required Window Background rule: disable ThemeModifier banner height/darkening sliders when window art is on -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerHeight" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerDarken" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
