<!--
    Vesperglass: ContextMenu & shared LocalMenuBoardTemplate (Dragon Age: The Veilguard inspired menu).
    Panel: deep aubergine-plum glass (PopupBackgroundBrush) with 4.5% astrolabe tile texture, double rose-copper
    hairline frame, 45-degree corner facets, and a centered top hollow-diamond crest inside a 4px top margin.
    Shared by ContextMenu, Submenu popups, ComboBox dropdowns, and multi-select popups (docs/themes/menus.md).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared menu board chrome hosted across ContextMenu, Submenu, ComboBox, ComboBoxList and FilterSelectionBox -->
    <ControlTemplate x:Key="LocalMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid Margin="0,4,0,0" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Deep plum-glass board + double copper hairline -->
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Control Template="{DynamicResource LocalAstrolabeBgTemplate}"
                     Foreground="{DynamicResource FrameBrush}" Opacity="0.045" Margin="2" Focusable="False" />
            <Border Margin="3" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" Opacity="0.72"
                    CornerRadius="{DynamicResource CornerRadiusSmall}" />

            <!-- Four crisp corner facets -->
            <Path Data="M0,7 L0,0 L7,0 L7,1.4 L1.4,1.4 L1.4,7 Z" Fill="{DynamicResource LocalCopperHiBrush}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M7,7 L7,0 L0,0 L0,1.4 L5.6,1.4 L5.6,7 Z" Fill="{DynamicResource LocalCopperHiBrush}"
                  HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L0,7 L7,7 L7,5.6 L1.4,5.6 L1.4,0 Z" Fill="{DynamicResource LocalCopperHiBrush}"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M7,0 L7,7 L0,7 L0,5.6 L5.6,5.6 L5.6,0 Z" Fill="{DynamicResource LocalCopperHiBrush}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" />

            <!-- Centered top hollow-diamond Veilguard modal crest rising into the 4px top margin -->
            <Grid Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-4,0,0">
                <Border Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource FrameBrush}"
                        BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                </Border>
                <Border Width="4" Height="4" Background="{DynamicResource LocalAmethystBrightBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                </Border>
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="216" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid MinWidth="{TemplateBinding MinWidth}" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer CanContentScroll="True" Margin="5,10,5,6"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
