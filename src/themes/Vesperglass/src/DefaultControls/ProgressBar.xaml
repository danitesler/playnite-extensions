<!--
    Vesperglass: ProgressBar — Dragon Age: The Veilguard "Preparing" loading bar: recessed twilight plum rail
    flanked by pointed rose-copper diamond end-caps, filled with luminous amethyst energy.
    MinHeight="8" and Height="{TemplateBinding Height}" so PART_ProgressGlobal sets Height="12" in TopPanel
    while dialogs stay 8px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalCopperDimBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid Height="{TemplateBinding Height}" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Recessed track between diamond end-caps -->
                        <Border x:Name="PART_Track" Grid.Column="1" Margin="-2,0,-2,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1.5"
                                        Background="{TemplateBinding Foreground}">
                                    <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource LocalAmethystBrightBrush}" Opacity="0.55" />
                                </Border>
                                <Rectangle x:Name="IndeterminateGlow" Width="96" HorizontalAlignment="Left" Visibility="Collapsed"
                                           Fill="{DynamicResource LocalAmethystBrightBrush}" Opacity="0.85">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#FF000000" Offset="0.5" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="IndetShift" X="-96" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Border>

                        <!-- Left & right burnished rose-copper pointed diamond end-caps -->
                        <Border x:Name="LeftCap" Grid.Column="0" Width="6" Height="6" Margin="1,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource FrameBrush}" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                        </Border>
                        <Border x:Name="RightCap" Grid.Column="2" Width="6" Height="6" Margin="0,0,1,0" VerticalAlignment="Center"
                                Background="{DynamicResource FrameBrush}" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="BorderThickness" Value="0">
                            <Setter TargetName="LeftCap" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RightCap" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Track" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateGlow" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ProgIndetLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndetShift" Storyboard.TargetProperty="X"
                                                         From="-96" To="360" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="ProgIndetLoop" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
