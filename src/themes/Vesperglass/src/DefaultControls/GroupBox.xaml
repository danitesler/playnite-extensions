<!--
    Vesperglass: GroupBox — Content-sized double-hairline twilight plum Codex card (safe for Playnite's wrapping
    Statistics view: zero fixed widths >= 200, zero wide Paths, zero Line Stretch="Fill").
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalCopperDimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border Margin="3" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" Opacity="0.65"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" IsHitTestVisible="False" />
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <DockPanel DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}" LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="5" Height="5" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Background="{DynamicResource GlyphBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                    <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                                </Border>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.Foreground="{DynamicResource SectionHeaderBrush}" />
                            </DockPanel>
                            <ContentPresenter />
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
