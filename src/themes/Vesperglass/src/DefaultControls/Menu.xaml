<!--
    Vesperglass: Menu.xaml — Bespoke Veilguard popup menu rows and group breaks (docs/themes/menus.md).
    - Panel: LocalMenuBoardTemplate (double rose-copper hairline, chamfered facets, top hollow-diamond crest, 4.5% astrolabe tile).
    - Highlight (30px rows): deep amethyst plate + electric amethyst rim + 4-point celestial star flare sliding in from left
      + subtle copper dotted leader before shortcut + +2px label glide to alabaster (120ms enter, 200ms FillBehavior=Stop exit).
    - Group break (10px): tapered copper rule fading outward to both ends around a centered hollow copper diamond.
    - Shortcuts: recessed plum keycaps with copper rim at rest, inverting to Veilguard's iconic solid alabaster keycaps
      with deep plum ink (bold) on highlight.
    - Checked rows: 14x14 rotated copper diamond rune socket enclosing an amethyst diamond core & alabaster check.
    - Exit (Alt+Q): crimson icon & rimmed keycap at rest; solid Veilguard crimson plate with bright rim, alabaster star flare,
      alabaster label (>6.25:1) and inverted alabaster keycap on highlight.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tapered copper-diamond menu separator (10px) -->
    <Style x:Key="{x:Type Separator}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource DividerTemplate}" VerticalAlignment="Center"
                             Foreground="{DynamicResource FrameBrush}" BorderBrush="{DynamicResource MenuSeparatorBrush}"
                             Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource DividerTemplate}" VerticalAlignment="Center"
                             Foreground="{DynamicResource FrameBrush}" BorderBrush="{DynamicResource MenuSeparatorBrush}"
                             Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard Menu Row (SubmenuItemTemplateKey, 30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="Root" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated highlight plate (amethyst fill + electric rim) -->
            <Border x:Name="HighlightPlate" Background="{DynamicResource MenuItemHoverBrush}"
                    BorderBrush="{DynamicResource LocalAmethystBrightBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

            <!-- Sliding 4-point celestial star flare on the left edge -->
            <Control x:Name="StarFlare" Template="{DynamicResource LocalStarFlareTemplate}"
                     Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0"
                     Foreground="{DynamicResource LocalAmethystBrightBrush}"
                     Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False">
                <Control.RenderTransform>
                    <TranslateTransform x:Name="StarShift" X="-5" />
                </Control.RenderTransform>
            </Control>

            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <!-- Fixed 24px icon / diamond rune check column -->
                <Grid Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ContentPresenter x:Name="Icon" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Opacity="0.86" />
                    <Grid x:Name="CheckSocket" Width="14" Height="14" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="11" Height="11" Background="{DynamicResource SelectedBrush}"
                                BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                        </Border>
                        <ContentControl Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Width="9" Height="9" Foreground="{DynamicResource LocalAlabasterBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                    </Grid>
                </Grid>

                <!-- Label + subtle dotted copper leader on highlight (plain * column so shortcuts stay flush right) -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderHost" Grid.Column="0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{TemplateBinding Foreground}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="LabelShift" X="0" />
                        </TextBlock.RenderTransform>
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </TextBlock>
                    <Grid x:Name="DotLeaderWrap" Grid.Column="1" Margin="8,2,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Rectangle x:Name="DotLeader" Height="1" Fill="Transparent" Stroke="{DynamicResource LocalCopperDimBrush}"
                                   StrokeThickness="1" StrokeDashArray="1 3" Opacity="0" />
                    </Grid>
                </Grid>

                <!-- Veilguard inverting alabaster keycap shortcut badge -->
                <Border x:Name="ShortcutChip" Grid.Column="2" VerticalAlignment="Center" Padding="5,1"
                        Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource LocalCopperDimBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}">
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource LocalCopperSoftBrush}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutChip" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DotLeaderWrap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutChip" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DotLeaderWrap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckSocket" Property="Visibility" Value="Visible" />
            </Trigger>

            <!-- Exit row (Alt+Q) at rest: crimson label & crimson-rimmed keycap -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource LocalDangerLitBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource LocalDangerLitBrush}" />
                <Setter TargetName="ShortcutChip" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource LocalDangerLitBrush}" />
                <Setter TargetName="HighlightPlate" Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="HighlightPlate" Property="BorderBrush" Value="{DynamicResource LocalDangerLitBrush}" />
                <Setter TargetName="StarFlare" Property="Foreground" Value="{DynamicResource LocalAlabasterBrush}" />
            </Trigger>

            <!-- Highlight animation (pointer or keyboard) -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource LocalAlabasterBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource LocalAlabasterBrush}" />
                <Setter TargetName="Icon" Property="Opacity" Value="1" />
                <Setter TargetName="ShortcutChip" Property="Background" Value="{DynamicResource LocalAlabasterBrush}" />
                <Setter TargetName="ShortcutChip" Property="BorderBrush" Value="{DynamicResource LocalAlabasterBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StarFlare" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StarFlare" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="StarShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.22" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DotLeader" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="StarFlare" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="StarShift" Storyboard.TargetProperty="X" To="-5" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="DotLeader" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StarFlare" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Exit highlighted: pure alabaster label (>6.25:1 on Veilguard crimson) + crimson-ink inverted keycap -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Submenu Header Row (SubmenuHeaderTemplateKey, 30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="Root" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held plate while submenu is open (setter, no flicker when moving pointer into submenu) -->
            <Border x:Name="OpenPlate" Background="{DynamicResource SelectedBrush}"
                    BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Visibility="Collapsed" IsHitTestVisible="False" />

            <Border x:Name="HighlightPlate" Background="{DynamicResource MenuItemHoverBrush}"
                    BorderBrush="{DynamicResource LocalAmethystBrightBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

            <Control x:Name="StarFlare" Template="{DynamicResource LocalStarFlareTemplate}"
                     Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0"
                     Foreground="{DynamicResource LocalAmethystBrightBrush}"
                     Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False">
                <Control.RenderTransform>
                    <TranslateTransform x:Name="StarShift" X="-5" />
                </Control.RenderTransform>
            </Control>

            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.86"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis" Foreground="{TemplateBinding Foreground}">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>

                <ContentControl x:Name="Arrow" Grid.Column="3" Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource FrameBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Focusable="False" IsHitTestVisible="False" />
            </Grid>

            <Popup x:Name="Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-10"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade">
                <Grid MinWidth="212" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer CanContentScroll="True" Margin="5,10,5,6"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource LocalAlabasterBrush}" TargetName="Icon" />
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource LocalAmethystBrightBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalAlabasterBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource LocalAlabasterBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource LocalAlabasterBrush}" />
                <Setter TargetName="Icon" Property="Opacity" Value="1" />
                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource LocalAlabasterBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubHeaderIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StarFlare" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="StarFlare" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="StarShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.22" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubHeaderOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="StarFlare" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="StarShift" Storyboard.TargetProperty="X" To="-5" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StarFlare" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="{DynamicResource MenuItemPadding}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
