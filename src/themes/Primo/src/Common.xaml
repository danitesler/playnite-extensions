<!-- Overlay on Playnite Default/Common.xaml: only restyled keys live here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Overlay: overlay-bgColor, borderRadius-large, and the 1px edge shadow-floating-small starts with. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    </Style>

    <!-- Primer focus: outline 2px solid focus-outlineColor with outline-offset -2px, drawn inside the control edge.
         WPF shows FocusVisualStyle for keyboard focus only, like :focus-visible. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox and Radio focus: the same 2px focus-outlineColor outline, 2px outside the control (outline-offset 2px). -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing at Primer's medium control size (control-medium-*: 32px), keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">12,5,12,5</Thickness> <!-- Button medium: 32px, control-medium-paddingInline-normal 12px, inside a 1px border (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">12,5,12,5</Thickness> <!-- TextInput / Select medium: 32px, 12px inline (height now set by ControlHeight) -->
    <Thickness x:Key="MenuPadding">8</Thickness> <!-- ActionList padding-block 8px; items inset 8px (inset variant) -->
    <Thickness x:Key="MenuItemPadding">8,6,8,6</Thickness> <!-- ActionList item: control-medium-paddingBlock 6px, -paddingInline-condensed 8px; 32px tall -->
    <Thickness x:Key="ComboBoxDropDownPadding">8</Thickness> <!-- Select opens an ActionMenu: ActionList padding-block 8px -->
    <Thickness x:Key="ComboBoxItemPadding">8,6,8,6</Thickness> <!-- ActionList item -->
    <Thickness x:Key="ListBoxItemPadding">8,6,8,6</Thickness> <!-- ActionList item -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness> <!-- Box body padding 16px -->
    <Thickness x:Key="GroupBoxHeaderPadding">16</Thickness> <!-- Box-header padding 16px -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double> <!-- Octicons 16px -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->
    <Thickness x:Key="TooltipPadding">8,4,8,4</Thickness> <!-- Tooltip: overlay-paddingBlock-condensed 4px, -paddingInline-condensed 8px -->

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, so the real carousel replaces it without the page jumping. Each Viewbox scales a fixed 1600px
         layout to the width its column gives it (height is unbounded in a vertical stack). The tiles are the host's
         Foreground at low opacity; the whole thing pulses while visible. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the plugin's ContentControl, visible while that control has no height. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="16"
                        Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- menu-mark begin LocalPrimoMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a Primer overlay panel holding an action list, three rows of a dot and a line. Hover (IsMouseOver): the lines grow from 0.72 to full width one after another (40ms apart, 0.2s cubic out). Open (ContextMenu.IsOpen of the nearest Border): the first row is selected the Primer way, an accent bar springs up on the panel edge (BackEase) and the first dot turns accent; the exit storyboard restores every property. -->
    <ControlTemplate x:Key="LocalPrimoMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="22" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Rectangle Canvas.Left="0.75" Canvas.Top="0.75" Width="20.5" Height="16.5" RadiusX="3.5" RadiusY="3.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" />
                <Ellipse x:Name="D1" Canvas.Left="4.6" Canvas.Top="3.8" Width="2.4" Height="2.4" Fill="{TemplateBinding Foreground}" />
                <Rectangle x:Name="L1" Canvas.Left="9" Canvas.Top="4.2" Width="9" Height="1.6" RenderTransformOrigin="0,0.5" RadiusX="0.8" RadiusY="0.8" Fill="{TemplateBinding Foreground}">
                    <Rectangle.RenderTransform><ScaleTransform x:Name="L1S" ScaleX="0.72" ScaleY="1" /></Rectangle.RenderTransform>
                </Rectangle>
                <Ellipse x:Name="D2" Canvas.Left="4.6" Canvas.Top="7.8" Width="2.4" Height="2.4" Fill="{TemplateBinding Foreground}" />
                <Rectangle x:Name="L2" Canvas.Left="9" Canvas.Top="8.2" Width="9" Height="1.6" RenderTransformOrigin="0,0.5" RadiusX="0.8" RadiusY="0.8" Fill="{TemplateBinding Foreground}">
                    <Rectangle.RenderTransform><ScaleTransform x:Name="L2S" ScaleX="0.72" ScaleY="1" /></Rectangle.RenderTransform>
                </Rectangle>
                <Ellipse x:Name="D3" Canvas.Left="4.6" Canvas.Top="11.8" Width="2.4" Height="2.4" Fill="{TemplateBinding Foreground}" />
                <Rectangle x:Name="L3" Canvas.Left="9" Canvas.Top="12.2" Width="9" Height="1.6" RenderTransformOrigin="0,0.5" RadiusX="0.8" RadiusY="0.8" Fill="{TemplateBinding Foreground}">
                    <Rectangle.RenderTransform><ScaleTransform x:Name="L3S" ScaleX="0.72" ScaleY="1" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="Sel" Canvas.Left="1.9" Canvas.Top="3.2" Width="1.6" Height="3.6" RenderTransformOrigin="0.5,0.5" RadiusX="0.8" RadiusY="0.8" Fill="{DynamicResource GlyphBrush}" Opacity="0">
                    <Rectangle.RenderTransform><ScaleTransform x:Name="SelS" ScaleX="1" ScaleY="0.2" /></Rectangle.RenderTransform>
                </Rectangle>
                <Ellipse x:Name="DotAcc" Canvas.Left="4.6" Canvas.Top="3.8" Width="2.4" Height="2.4" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource GlyphBrush}" Opacity="0">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="DotAccS" ScaleX="0.2" ScaleY="0.2" /></Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="L1S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="L2S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.200" BeginTime="0:0:0.040"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="L3S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.200" BeginTime="0:0:0.080"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="L1S" Storyboard.TargetProperty="ScaleX" To="0.72" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="L2S" Storyboard.TargetProperty="ScaleX" To="0.72" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="L3S" Storyboard.TargetProperty="ScaleX" To="0.72" Duration="0:0:0.160" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SelS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.120"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DotAccS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DotAccS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DotAcc" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.120"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SelS" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.120" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="DotAccS" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="DotAccS" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="DotAcc" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.120" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalPrimoMenuMarkTemplate -->
</ResourceDictionary>
