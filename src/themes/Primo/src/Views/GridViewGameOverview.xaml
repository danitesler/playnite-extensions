<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml (grid mode, side panel).
    GitHub's repository page stacked for a narrow column, as github.com lays it out below its md breakpoint: the header
    (icon and name at fontSize 20 semibold), a row of actions (green primary Play or Install filling the width, More with
    triangle-down, Edit as a 32px IconButton), then two columns like the details view: the README and Notes Boxes on the left, and on the right (280px) the sidebar's BorderGrid:
    a heading and every metadata field Playnite can show, each a 12px semibold fgColor-muted label over its value, in
    the six sections of the details view split by 1px rules (a section whose fields are all hidden takes no space).
    16px gutters.
    The panel edge follows Playnite's panel settings. Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
<Grid>
<!-- Empty state (no game selected), Primer Blankslate: a muted octicon (fgColor-muted) over a semibold heading, centered in the visible area. Blankslate has no transition or animation, so this is static. -->
<Grid VerticalAlignment="Stretch">
<Grid.Style>
<Style TargetType="Grid">
<Setter Property="Visibility" Value="Collapsed" />
<Style.Triggers>
<DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
<Setter Property="Visibility" Value="Visible" />
</DataTrigger>
</Style.Triggers>
</Style>
</Grid.Style>
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,24">
<Viewbox Width="24" Height="24" HorizontalAlignment="Center">
<Canvas Width="16" Height="16">
<!-- octicons: cursor -->
<Path Data="F1M1.084,2.656A1.25,1.25,0,0,1,2.656,1.084L14.11,4.766C15.298,5.147,15.255,6.842,14.05,7.163L8.613,8.613 7.164,14.049C6.843,15.254,5.148,15.297,4.767,14.109z M5.933,12.841L7.2,8.087 7.253,7.929A1.25,1.25,0,0,1,8.086,7.201L12.84,5.933 2.66,2.66z" Fill="{DynamicResource TextBrushDarker}" />
</Canvas>
</Viewbox>
<TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"
FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
</StackPanel>
</Grid>

<Grid>

                        <DockPanel>
                            <DockPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DockPanel.Resources>




                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
<DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
<Setter Property="Visibility" Value="Collapsed" />
</DataTrigger>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <ScrollViewer x:Name="PART_ScrollViewHost"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
<!-- The header scrolls with the page (not pinned above it). -->
<Grid x:Name="PageRoot" Background="{DynamicResource WindowBackgourndBrush}">
<!-- Banner: the game's background art as a band at the top. Tinted at the top, darkened toward the title by a page-colored scrim, faded into the page. GameBannerHeight sets the height; 0 turns it off. Same banner as the details view: no rounded-corner clip, so the art fades smoothly into the page. -->
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
<Grid.Style>
        <Style TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Grid.Style>
<FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
<Border Background="{DynamicResource WindowBackgourndBrush}" Opacity="0.3" />
<!-- No OpacityMask on the banner: masked art repainted in part (behind the animated Play button) left dark patches on scaled displays.
     The fade is a plain gradient to the page color, read from the page brush (PageRoot). -->
<Rectangle>
<Rectangle.Fill>
<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
<GradientStop Color="#00000000" Offset="0.25" />
<GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.95" />
</LinearGradientBrush>
</Rectangle.Fill>
</Rectangle>
</Grid>
<StackPanel>
<!-- Room above the title so it sits low on the banner; gone when the banner is off or the game has no art. -->
<Border DockPanel.Dock="Top" IsHitTestVisible="False">
    <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 84 / 320'}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                    <Setter Property="Height" Value="52" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
</Border>
<!-- Repository header -->
<DockPanel DockPanel.Dock="Top" Margin="28,0,28,0">
                                    <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0"
                                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                    <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeLargest}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" />
                                </DockPanel>
<Image x:Name="PART_ImageCover" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="24,16,24,0"
                                       Stretch="Uniform" StretchDirection="Both" MaxHeight="280"
                                       RenderOptions.BitmapScalingMode="Fant">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="28,16,28,24">
                                    <Grid>
                                        <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                        <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                    </Grid>
                                    <Button x:Name="PART_ButtonMoreActions" Width="32" Height="32" Padding="0" Margin="8,0,0,0"
                                            ToolTip="{DynamicResource LOCMoreAction}">
                                        <ContentPresenter Width="16" Height="16"
                                                          Content="{DynamicResource IconOptions}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                    <Button x:Name="PART_ButtonEditGame" Width="32" Height="32" Padding="0"
                                            Margin="8,0,0,0" Focusable="False" ToolTip="{DynamicResource LOCEditGame}">
                                        <ContentPresenter Width="16" Height="16"
                                                          Content="{DynamicResource IconEdit}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                </StackPanel>

                                
                                    <StackPanel Margin="28,0,28,32">
                                        <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,1,0,0"
                                                Margin="0,0,0,24" />

                                        <Grid x:Name="OverviewLayoutGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Main column: README and Notes Boxes -->
                                            <StackPanel x:Name="DescriptionPanel" Grid.Column="0">
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library or Steam source games in that gap; give up after 12s so a game without screenshots does not keep an empty block. When the plugin is not installed or is disabled the binding fails, FallbackValue=PluginUnavailable matches neither True nor False, and no skeleton shows. -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                        <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                            <Storyboard>
                                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                        <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                            <Storyboard>
                                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <GroupBox Header="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}">
                                                        <Grid>
                                                            <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                            <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                                <Control.Style>
                                                                    <Style TargetType="Control">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Control.Style>
                                                            </Control>
                                                        </Grid>
                                                    </GroupBox>
                                                </Grid>
                                                <GroupBox x:Name="PART_ElemDescription" Margin="0,24,0,0" Header="{DynamicResource LOCGameDescriptionTitle}">
                                                    <HtmlTextView x:Name="PART_HtmlDescription"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"
                                                                  Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </GroupBox>
                                                <GroupBox x:Name="PART_ElemNotes" Header="{DynamicResource LOCNotesLabel}" Margin="0,24,0,0">
                                                    <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                             Background="{DynamicResource ControlBackgroundBrush}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" />
                                                </GroupBox>
                                            </StackPanel>

                                            <!-- Sidebar / Details Panel -->
                                            <StackPanel x:Name="DetailsPanel" Grid.Column="1" Width="{DynamicResource GridDetailsPaneWidth}" Margin="24,0,0,0" VerticalAlignment="Top">

                                                <TextBlock Text="{DynamicResource LOCGameDetails}" FontSize="{DynamicResource FontSizeLarge}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8" />

                                                <Border ClipToBounds="True">
                                                    <StackPanel Margin="0,-41,0,-8">
                                                        <Border x:Name="MetaProgress" Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <Button Grid.Column="2" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextPlayTime" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextLastActivity" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextRecentActivity" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextAdded" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCriticScore}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCUserScore}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout" Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDevelopersLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <ItemsControl Grid.Column="2" x:Name="PART_ItemsDevelopers" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCPublishersLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <ItemsControl Grid.Column="2" x:Name="PART_ItemsPublishers" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <Button Grid.Column="2" x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCSeriesLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <ItemsControl Grid.Column="2" x:Name="PART_ItemsSeries" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
