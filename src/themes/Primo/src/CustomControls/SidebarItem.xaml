<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    Primer NavList item, icon only, on the repo's compact rail: a 44x40 item holding a 32px borderRadius-medium plate
    with 16px octicons in fgColor-muted (IconPadding, 8 by default, is the only inset: 32 - 2 x 8 = 16); hover fills
    the plate with control-transparent-bgColor-hover and turns the icon fgColor-default. The current item keeps that
    fill and gets NavList's current-item bar: 4x24px, fgColor-accent, 2px rounded ends (half its width), on the item's
    left edge 2px outside the plate.
    Library and Statistics use Octicons from Media.xaml. PART_ProgressStatus is kept.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="CurrentBar" Width="4" Height="24" Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                CornerRadius="2"
                                Background="{DynamicResource GlyphBrush}" />
                        <Grid x:Name="Plate" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar x:Name="PART_ProgressStatus"
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource SelectedBrush}"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{Binding IconPadding}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Viewbox x:Name="ItemIcon">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Viewbox>
                            </Border>
                            <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                            Width="16" Height="16"
                                            ContentTemplate="{DynamicResource IconTemplate}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CurrentBar" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="CurrentBar" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="CurrentBar" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
