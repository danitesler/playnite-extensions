<!--
    Overlay on Playnite Default/DefaultControls/ComboBox.xaml.
    The trigger is Primer's Select: TextInput chrome (bgColor-default fill, 1px control-borderColor-rest edge,
    borderRadius-medium, 32px, 12px inline padding) with the triangle-down octicon in fgColor-muted 4px from the end;
    keyboard focus draws the accent border plus its 1px inset shadow as a 2px focus-outlineColor edge. The list opens
    as the menus' ActionMenu (docs/themes/menus.md): the Overlay of ContextMenu.xaml (LocalActionOverlayTemplate) around
    32px ActionList items like Menu.xaml's: the hover plate fading in with NavList's accent pill growing in the left
    gutter on hover or keyboard highlight, and the check of a single-select list in the leading slot of the selected item.
    Part names (PART_EditableTextBox, PART_Popup) are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="Border" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <DockPanel LastChildFill="False" Background="Transparent">
                                                <ToggleButton x:Name="FilterGroupIndicator" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                              Margin="0,0,-5,0" Background="Transparent" BorderThickness="0" Padding="0" Width="30" Height="28" VerticalAlignment="Center" Visibility="Collapsed"
                                                              IsHitTestVisible="False" Focusable="False" IsChecked="True"
                                                              Style="{DynamicResource ExpanderDownHeaderStyle}" />
                                                <ContentPresenter x:Name="FilterOriginalArrow" DockPanel.Dock="Right" Margin="0,0,4,0" Width="16" Height="16"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                  Content="{DynamicResource IconDropDown}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </DockPanel>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType={x:Type FilterPanel}}, FallbackValue=False}" Value="True">
                                                    <Setter TargetName="FilterOriginalArrow" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="FilterGroupIndicator" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- Content inset by Padding (InputPadding) plus room for the indicator. -->
                                <Border x:Name="FilterContentReserve" Margin="0,0,12,0" Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                                    <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                </Border>
                                <Border Margin="0,0,12,0" Padding="{TemplateBinding Padding}">
                                    <TextBox MinHeight="0" x:Name="PART_EditableTextBox" Visibility="Hidden" VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch" Focusable="True"
                                             Style="{DynamicResource BareTextBox}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" />
                                </Border>
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom" VerticalOffset="4" Focusable="False" AllowsTransparency="True">
                                    <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                        <Control Template="{DynamicResource LocalActionOverlayTemplate}" Focusable="False" IsTabStop="False" />
                                        <ScrollViewer Margin="1,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRing" BorderThickness="2" Visibility="Collapsed"
                                IsHitTestVisible="False" SnapsToDevicePixels="True"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                BorderBrush="{DynamicResource FocusBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType={x:Type FilterPanel}}, FallbackValue=False}" Value="True">
                            <Setter TargetName="FilterContentReserve" Property="Margin" Value="0,0,30,0" />
                        </DataTrigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="FocusRing" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="FocusRing" />
                        </MultiTrigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="ContentSite" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid x:Name="ListRow" Height="32" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="ListPlate" Margin="8,0" Background="{DynamicResource HoverBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="ListPill" Width="4" Height="24" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource GlyphBrush}" CornerRadius="2" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ListPillScale" ScaleY="0.34" />
                            </Border.RenderTransform>
                        </Border>
                        <Grid Margin="16,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Leading selection slot: the single-select check, 16px, 8px before the label. -->
                            <ContentPresenter x:Name="CheckIcon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Visibility="Hidden" TextElement.Foreground="{DynamicResource TextBrush}"
                                              Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <ContentPresenter x:Name="ListLabel" Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ListHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListPill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ListPill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="ListPillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ListHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListPill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="ListPill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="ListPillScale" Storyboard.TargetProperty="ScaleY" To="0.34" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" TargetName="ListRow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
