<!--
    Hexfall: spacing, focus and the shared motifs. Measurements: ../RESEARCH.md.
      BevelTemplate         a menu button: flat navy plate with a 1px steel edge
      FramedPlateTemplate   a panel frame: one 1px frame with bracket corners in the lit line colour
      RivetsTemplate        the cap bar: a gunmetal strip with a centre notch and three lamps (Options, Pause)
      SelectionBarTemplate  the selection: deep green plate in its green edge, an amber square pointer, a wash from the foot
      GlowLineTemplate      a panel's rule: a hairline that fades at both ends with a lit stretch in the middle
      GlowFrameTemplate     bloom behind a plate
      DividerTemplate       the amber double slash that opens a heading, then a rule
      ChamferTemplate       a plate with the top-left and bottom-right corners cut at 45 degrees (6px), drawn from rectangles and two triangles
      CornerMarksTemplate   corner brackets, 2px, arm 8: keyboard focus, and the lock-on frame on hover (hosts move it with Margin)
    Sprites are white masks filled with theme brushes, so ThemeModifier edits reach them. None of these report a
    desired width of their own beyond 80px (Statistics cards stay compact).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>
    <!-- Menu buttons: caps label 16px inside a 28-32px plate; list rows keep 22px on the left for the amber pointer. -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">22,7,10,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">22,7,10,7</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,0</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <!-- Menu button. Background = the plate, BorderBrush + BorderThickness = its edge. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="Control">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" IsHitTestVisible="False" />
    </ControlTemplate>
    <!-- A plate with two corners cut (top-left, bottom-right), 6px, any size: rectangles plus two triangles, so no page-colour patches.
         Background = the body, BorderBrush = the 1px edge. Hosts draw it under their content. -->
    <ControlTemplate x:Key="ChamferTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Margin="0,6" Fill="{TemplateBinding Background}" />
            <Rectangle Margin="6,0" Fill="{TemplateBinding Background}" />
            <Path Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{TemplateBinding Background}" Data="M6,0 L6,6 L0,6Z" />
            <Rectangle Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{TemplateBinding Background}" />
            <Rectangle Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{TemplateBinding Background}" />
            <Path Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{TemplateBinding Background}" Data="M0,0 L6,0 L0,6Z" />
            <Rectangle Height="1" Margin="6,0,0,0" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Height="1" Margin="0,0,6,0" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Width="1" Margin="0,6,0,0" HorizontalAlignment="Left" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Width="1" Margin="0,0,0,6" HorizontalAlignment="Right" Fill="{TemplateBinding BorderBrush}" />
            <Path Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" Data="M0,6 L6,0" />
            <Path Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" Data="M0,6 L6,0" />
        </Grid>
    </ControlTemplate>
    <!-- The cap bar: 6px gunmetal strip with a lit top line, a trapezoid notch at the centre carrying three lamps
         (amber, white, amber). Host it at the top of a panel or band; it is 10px tall and takes no width. -->
    <ControlTemplate x:Key="RivetsTemplate" TargetType="Control">
        <Grid Height="10" VerticalAlignment="Top" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Height="6" VerticalAlignment="Top" Fill="{DynamicResource CapBarBrush}" />
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource CapBarLitBrush}" />
            <Path Width="80" Height="10" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="{DynamicResource CapBarBrush}" Data="M0,0 L80,0 73,10 7,10Z" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                <Rectangle Width="12" Height="4" Fill="{DynamicResource CapLampBrush}" />
                <Rectangle Width="12" Height="4" Margin="8,0" Fill="{DynamicResource HeadingForegroundBrush}" />
                <Rectangle Width="12" Height="4" Fill="{DynamicResource CapLampBrush}" />
            </StackPanel>
        </Grid>
    </ControlTemplate>
    <!-- Panel frame. Foreground = the 1px frame. Overlay it on a panel; it draws no fill. Bracket corners (arm 7, 2px)
         in the lit frame colour. -->
    <ControlTemplate x:Key="FramedPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" />
            <Path Data="M0,7 L0,0 7,0 7,2 2,2 2,7Z" Fill="{DynamicResource FrameHoverBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L7,0 7,7 5,7 5,2 0,2Z" Fill="{DynamicResource FrameHoverBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L2,0 2,5 7,5 7,7 0,7Z" Fill="{DynamicResource FrameHoverBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M5,0 L7,0 7,7 0,7 0,5 5,5Z" Fill="{DynamicResource FrameHoverBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>
    <!-- The selection. Foreground = the green plate, BorderBrush = its edge. An amber square pointer sits 10px in; a dim wash
         rises from the plate's foot. -->
    <ControlTemplate x:Key="SelectionBarTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
            <Rectangle Fill="{DynamicResource SelectedSheenBrush}" Opacity="0.3" Margin="1">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.35" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="6" Height="6" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource HeadingMarkerBrush}" />
        </Grid>
    </ControlTemplate>
    <!-- A panel's rule, 16px tall: host it with a negative vertical margin so only the hairline takes room.
         Foreground = the hairline (fades at both ends), BorderBrush = the lit stretch in the middle (the middle 320px). -->
    <ControlTemplate x:Key="GlowLineTemplate" TargetType="Control">
        <Grid Height="16" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.18" />
                        <GradientStop Color="#FF000000" Offset="0.82" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" MaxWidth="320" VerticalAlignment="Center" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.3" />
                        <GradientStop Color="#FF000000" Offset="0.7" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="7" MaxWidth="220" VerticalAlignment="Center" Fill="{TemplateBinding BorderBrush}" Opacity="0.16">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>
    <!-- Bloom. The host decides its own bleed with a negative margin. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>
    <!-- The amber double slash the source puts before a heading ("//Imperial Archives"), then a rule for the rest of the row. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" VerticalAlignment="Center" Height="12" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Width="14" Height="12" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" Data="M5,0 L8,0 3,12 0,12Z M11,0 L14,0 9,12 6,12Z" />
            <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{DynamicResource HeadingRuleBrush}" />
        </Grid>
    </ControlTemplate>
    <!-- Corner brackets, arm 8, 2px. Foreground = their colour. Keyboard focus draws them 3px outside the control; hover
         layers host them with a Margin that animates inward (the lock-on). -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,8 L0,0 8,0 8,2 2,2 2,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L8,0 8,8 6,8 6,2 0,2Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L2,0 2,6 8,6 8,8 0,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M6,0 L8,0 8,8 0,8 0,6 6,6Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Keyboard focus: cyan corner brackets 3px outside the control. -->
    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
