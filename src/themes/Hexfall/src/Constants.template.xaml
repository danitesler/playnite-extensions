<!--
    Hexfall: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared vocabulary (scripts/data/theme-keys.json); each placeholder names the pf token that plays
    the key's role. Token-to-key table: ../AGENTS.md. Theme XAML reads brushes only, never Color keys.
    Shape: square plates with cut-corner accents. Selection is deep green with an amber pointer; brass is the one warm plate (Play, default button).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: wide geometric caps for titles (Sora, bundled), a humanist body (Segoe UI, ships with Windows). -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Sora, {{text:font-heading|Sora}}, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{pf-white}}</Color>
    <Color x:Key="TextColorDarker">{{pf-mist}}</Color>
    <Color x:Key="TextColorDark">{{pf-ink}}</Color>
    <Color x:Key="MainColor">{{pf-well}}</Color>
    <Color x:Key="MainColorDark">{{pf-hull}}</Color>
    <Color x:Key="HoverColor">{{pf-plate-hi}}</Color>
    <Color x:Key="GlyphColor">{{pf-cyan}}</Color>
    <Color x:Key="HighlightGlyphColor">{{pf-amber}}</Color>
    <Color x:Key="PopupBackgroundColor">{{pf-hull}}</Color>
    <Color x:Key="PopupBorderColor">{{pf-frame}}</Color>
    <Color x:Key="BackgroundToneColor">{{pf-hull}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{pf-line-dim}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{pf-line-dim}}</Color>
    <Color x:Key="DataChangeNotifColor">{{pf-badge}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{pf-line}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{pf-void}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{pf-plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{pf-well}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <!-- Running game: the energy resource yellow, never the cyan of selection and focus, the viridian plate or the amber markers -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{pf-status}}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{pf-go-lit}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{pf-hostile}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{pf-energy}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{pf-badge}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{pf-well}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{pf-hull}}" />

    <!-- Surfaces and art -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{pf-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{pf-hull}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{pf-void}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{pf-hull}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{pf-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{pf-void}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the darkest navy of the options and HUD frames, so a darker banner keeps the cool cast instead of plain black. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{pf-void}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{pf-gunmetal}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{pf-cyan}}" />

    <!-- Selection and states -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{pf-viridian}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{pf-viridian-edge}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{pf-ice}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{pf-plate}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{pf-viridian}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{pf-plate-hi}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{pf-cyan}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{pf-hostile}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{pf-white}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{pf-white}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{pf-ice}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{pf-line}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{pf-plate-hi}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{pf-plate-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{pf-brass}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{pf-brass-edge}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{pf-brass-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{pf-brass-void}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{pf-brass-text}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{pf-brass-hot}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{pf-olive}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{pf-well}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{pf-line}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{pf-frame}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{pf-frame}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{pf-cyan}}" />

    <!-- Tracks and thumbs -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{pf-line}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{pf-cyan}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{pf-white}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{pf-ice}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{pf-line-dim}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{pf-cyan}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{pf-slate}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{pf-steel}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{pf-slate}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{pf-steel}}" />

    <!-- Tabs, covers, shell items -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{pf-mist}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{pf-white}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{pf-olive-edge}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{pf-cyan}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{pf-cyan}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{pf-plate-hi}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{pf-olive}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{pf-mist}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{pf-ice}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{pf-cyan}}" />

    <!-- Metadata, menus, tooltips, dialogs -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{pf-plate}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{pf-mist}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{pf-plate-hi}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{pf-line-dim}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{pf-white}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{pf-frame}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{pf-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{pf-ice}}" />

    <!-- Frames and headings -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{pf-frame}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{pf-line-dim}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{pf-cyan}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{pf-line}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{pf-void}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{pf-ice}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{pf-amber}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{pf-line}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{pf-frame}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{pf-void}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{pf-void}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{pf-line-dim}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{pf-cyan}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{pf-line}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{pf-well}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{pf-viridian-edge}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{pf-plate}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{pf-line}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{pf-cyan}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{pf-amber-dim}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{pf-void}}" />
    <!-- The cap bar that crowns a panel: gunmetal body, its lit top line, the lit lamps (the white lamp is the heading colour). -->
    <SolidColorBrush x:Key="CapBarBrush" Color="{{pf-gunmetal}}" />
    <SolidColorBrush x:Key="CapBarLitBrush" Color="{{pf-gunmetal-hi}}" />
    <SolidColorBrush x:Key="CapLampBrush" Color="{{pf-amber-hot}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{pf-mist}}" />
</ResourceDictionary>
