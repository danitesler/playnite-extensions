                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Polygon.Style>
                                                </Polygon>
                                                <Polygon Points="50,0 93.3,25 93.3,75 50,100 6.7,75 6.7,25" Stretch="Fill" Width="56" Height="56" Fill="Transparent" Stroke="{DynamicResource TitleSuffixBrush}" StrokeThickness="1" Opacity="0">
