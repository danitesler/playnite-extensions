<!--
    Hexfall: gives Playnite's multi-select dropdowns the shared field height (ControlHeight), so it lines up with text boxes and buttons.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ComboBoxList}" BasedOn="{StaticResource {x:Type ComboBoxList}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
    <Style TargetType="{x:Type DdItemListSelectionBox}" BasedOn="{StaticResource {x:Type DdItemListSelectionBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
</ResourceDictionary>
