<!--
    Hexfall: GroupBox as one of the source's panels: a navy body in a 1px steel frame with the top-left and bottom-right
    corners cut (ChamferTemplate), headed by the amber double slash and the title in the display face over a hairline.
    Content-sized, no fixed widths: the rule is a stretching 1px Rectangle with no desired width and the corner
    pieces are 6px, so Statistics sections stay compact cards. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource ExpanderBackgroundBrush}"
                                 BorderBrush="{DynamicResource FrameBrush}" Focusable="False" />
                        <DockPanel Margin="1">
                            <Grid DockPanel.Dock="Top" MinHeight="34" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                <DockPanel Margin="14,8,14,7" LastChildFill="True">
                                    <Path DockPanel.Dock="Left" Width="14" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource HeadingMarkerBrush}"
                                          Data="M5,0 L8,0 3,12 0,12Z M11,0 L14,0 9,12 6,12Z" />
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                      TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                      TextElement.FontSize="{DynamicResource FontSizeSmall}"
                                                      TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{DynamicResource SectionHeaderBrush}">
                                        <ContentPresenter.Resources>
                                            <DataTemplate DataType="{x:Type sys:String}">
                                                <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                            </DataTemplate>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </DockPanel>
                                <Rectangle Height="1" Margin="14,0" VerticalAlignment="Bottom" Fill="{DynamicResource HeadingRuleBrush}" IsHitTestVisible="False" />
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
