<!--
    Hexfall: ContextMenu. Every popup menu and dropdown list (hamburger menu, top bar dropdowns via TopPanelMenu,
    GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select boxes) wears
    Planetfall's tactical command panel (LocalTacticalMenuTemplate): navy hull (PopupBackgroundBrush) inside the
    bracketed frame (FramedPlateTemplate, cyan corner brackets) crowned by the gunmetal cap bar with three lamps
    (RivetsTemplate, 10px trapezoid notch). Rows begin 12px below the top edge so the notch sits clear above them.
    Rows and the 10px amber double-slash group break are in Menu.xaml.
    Structure: Playnite Default 10.60. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalTacticalMenuTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" />
            <Control Template="{DynamicResource FramedPlateTemplate}" Foreground="{DynamicResource PopupBorderBrush}"
                     Focusable="False" IsTabStop="False" />
            <Control Template="{DynamicResource RivetsTemplate}" VerticalAlignment="Top" Margin="1,1,1,0"
                     Focusable="False" IsTabStop="False" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalTacticalMenuTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,12,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="5,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
