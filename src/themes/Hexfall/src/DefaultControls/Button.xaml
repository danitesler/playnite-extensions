<!--
    Hexfall: Button. The source's menu button: a flat navy plate, a 1px steel edge, a caps label in the display face.
    Hover lifts the plate one step and turns the edge cyan; press lifts it another. The default button is the source's
    brass action plate (OK, CLOSE, START GAME): brass fill, a double rim, a cream label; hover fades a lit gradient
    in and the rim goes hot.
    Width 41 trigger: ThemeModifier's icon buttons. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="Plate" Template="{DynamicResource BevelTemplate}" Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Focusable="False" />
                        <Grid x:Name="Brass" Visibility="Collapsed" IsHitTestVisible="False">
                            <Control Template="{DynamicResource ChamferTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Focusable="False" />
                            <Rectangle x:Name="BrassLit" Margin="1" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Opacity="0">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#8C000000" Offset="0" />
                                        <GradientStop Color="#26000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Border Margin="4" BorderBrush="{DynamicResource PrimaryButtonForegroundBrush}" BorderThickness="1" Opacity="0.3" />
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Brass" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Plate" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BrassLit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BrassLit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
