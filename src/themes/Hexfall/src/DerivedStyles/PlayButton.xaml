<!--
    Hexfall: Play, the source's brass action plate (START GAME, OK). A brass plate with two cut corners and a double rim
    (ChamferTemplate, any size), a play glyph and the label in the display face, cream, uppercase. Layers bottom to top:
    bloom, hex ping, plate, inner rim, lit gradient, hot rim, pressed plate, sheen, lock-on brackets, label.
    Hover, animated both ways (no setters on animated parts, so nothing snaps):
      in  0.18s: four corner brackets lock in from 14px out to 7px, a hex ring rings out from the plate to its full
          size, the plate lifts to lit brass (a gradient, so the label keeps contrast), the rim goes hot, the bloom
          rises, and a sheen crosses the plate once. While hovered the ring breathes in a 2.4s loop.
      out 0.32s: everything settles; every exit animation has FillBehavior Stop, so no clock is left running.
    Press, on its own layers so leaving while pressed cannot strand the hover state: the pressed plate (dark brass)
    fades in over 0.1s, the brackets close to 3px and the label dips 1px.
    Sprites are white masks filled with theme brushes. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite
        swaps Play for the context action (RUNNING); an energy-yellow hairline traces the plate and three energy cells sit
        at its foot, breathing (3s). Launching charges the cells one by one (0.75s).
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching).
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Control x:Name="RunningWash" Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource RunningIndicatorBrush}" BorderBrush="Transparent" Opacity="0.22" Focusable="False" IsTabStop="False" />
                        <Grid IsHitTestVisible="False" RenderOptions.EdgeMode="Aliased">
                            <Grid.OpacityMask>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,7,12.125" ViewportUnits="Absolute" Viewbox="0,0,7,12.125" ViewboxUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#FF000000" Geometry="M3.5,0.55 L6.52,2.3 L6.52,5.79 L3.5,7.53 L0.48,5.79 L0.48,2.3 Z M0,6.61 L3.02,8.36 L3.02,11.85 L0,13.6 L-3.02,11.85 L-3.02,8.36 Z M7,6.61 L10.02,8.36 L10.02,11.85 L7,13.6 L3.98,11.85 L3.98,8.36 Z" />
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.OpacityMask>
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.3">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                        <Control x:Name="RunningFrame" Template="{DynamicResource ChamferTemplate}" Background="Transparent" BorderBrush="{DynamicResource RunningIndicatorBrush}" Focusable="False" IsTabStop="False" />
                        <Grid Height="6" Margin="10,0,48,3" VerticalAlignment="Bottom">
                            <Grid Height="2" Margin="4,0,4,0" VerticalAlignment="Center">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,4" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Rectangle x:Name="RunningIndicatorCell1" Width="10" Height="3" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                            <Rectangle x:Name="RunningIndicatorCell2" Width="10" Height="3" Margin="2,0,0,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                            <Rectangle x:Name="RunningIndicatorCell3" Width="10" Height="3" Margin="2,0,0,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.5,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.4" KeySpline="0.5,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.402" KeySpline="0.5,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.5,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicatorCell1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicatorCell2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.65" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.77" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicatorCell3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.02" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicatorCell1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicatorCell2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicatorCell3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="26,0,26,0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid x:Name="BloomWrap" Margin="-26,-22" IsHitTestVisible="False">
                            <Control x:Name="Bloom" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0" Focusable="False" />
                        </Grid>
                        <!-- The hex ping: a flat hexagon outline around the plate that grows out to its full size as it fades in. -->
                        <Grid x:Name="PingWrap" IsHitTestVisible="False">
                            <Polygon x:Name="PingHex" Points="50,0 100,26 100,74 50,100 0,74 0,26" Stretch="Fill" Margin="-26,-22" Fill="Transparent"
                                     Stroke="{DynamicResource PrimaryButtonGlowBrush}" StrokeThickness="1" Opacity="0" IsHitTestVisible="False"
                                     RenderTransformOrigin="0.5,0.5">
                                <Polygon.RenderTransform>
                                    <ScaleTransform x:Name="PingScale" ScaleX="0.85" ScaleY="0.65" />
                                </Polygon.RenderTransform>
                            </Polygon>
                        </Grid>
                        <Control Template="{DynamicResource ChamferTemplate}" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" Focusable="False"  x:Name="PlayFill"/><Control x:Name="RunningBreath" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent" Opacity="0" />
                            <Grid IsHitTestVisible="False" RenderOptions.EdgeMode="Aliased">
                                <Grid.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,7,12.125" ViewportUnits="Absolute" Viewbox="0,0,7,12.125" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#FF000000" Geometry="M3.5,0.55 L6.52,2.3 L6.52,5.79 L3.5,7.53 L0.48,5.79 L0.48,2.3 Z M0,6.61 L3.02,8.36 L3.02,11.85 L0,13.6 L-3.02,11.85 L-3.02,8.36 Z M7,6.61 L10.02,8.36 L10.02,11.85 L7,13.6 L3.98,11.85 L3.98,8.36 Z" />
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Grid.OpacityMask>
                                <Control x:Name="RunningScan" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" BorderBrush="Transparent" Opacity="0.5">
                                    <Control.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Control.OpacityMask>
                                </Control>
                            </Grid>
                            <Control x:Name="RunningHoverDim" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent" Opacity="0" />
                        <Border Margin="4" BorderBrush="{DynamicResource PrimaryButtonForegroundBrush}" BorderThickness="1" Opacity="0.3" IsHitTestVisible="False" />
                        <Control x:Name="HoverPlate" Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" BorderBrush="Transparent"
                                 Opacity="0" IsHitTestVisible="False" Focusable="False">
                            <Control.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#8C000000" Offset="0" />
                                    <GradientStop Color="#26000000" Offset="1" />
                                </LinearGradientBrush>
                            </Control.OpacityMask>
                        </Control>
                        <Control x:Name="HotRim" Template="{DynamicResource ChamferTemplate}" Background="Transparent" BorderBrush="{DynamicResource PrimaryButtonGlowBrush}"
                                 Opacity="0" IsHitTestVisible="False" Focusable="False" />
                        <Control x:Name="PressedPlate" Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" BorderBrush="{DynamicResource PrimaryButtonBorderBrush}"
                                 Opacity="0" IsHitTestVisible="False" Focusable="False" />
                        <!-- The sheen: a soft pale band that crosses the plate once on hover. Clipped to the plate; a mask, so it follows PrimaryButtonForegroundBrush. -->
                        <Grid ClipToBounds="True" Margin="1" IsHitTestVisible="False">
                            <Rectangle x:Name="Sheen" Width="46" HorizontalAlignment="Left" Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="SheenShift" X="-60" />
                                </Rectangle.RenderTransform>
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.5" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                        <!-- Lock-on: four corner brackets that close in on the plate. -->
                        <Control x:Name="Lock" Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}" Margin="-14" Opacity="0" IsHitTestVisible="False" Focusable="False" />
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="LabelShift" Y="0" />
                            </StackPanel.RenderTransform>
                            <Viewbox x:Name="PlayGlyph" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{DynamicResource IconPlay}" Fill="{TemplateBinding Foreground}" />
                                </Canvas>
                            </Viewbox>
                            <ContentPresenter x:Name="PlayContent" VerticalAlignment="Center" RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type sys:String}">
                                        <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </StackPanel>
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter Property="Opacity" Value="0.08" TargetName="RunningBreath" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.5,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.4" KeySpline="0.5,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.402" KeySpline="0.5,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.04" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.14" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.04" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" From="0" To="0.15" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HotRim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Lock" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <ThicknessAnimation Storyboard.TargetName="Lock" Storyboard.TargetProperty="Margin" To="-7" Duration="0:0:0.18"><ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></ThicknessAnimation.EasingFunction></ThicknessAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PingHex" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PingScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PingScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" From="0" To="0.22" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="SheenShift" Storyboard.TargetProperty="X" From="-60" To="320" Duration="0:0:0.45"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.3" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The breathing loop animates PingWrap, not PingHex: two storyboards on one property replace each other,
                                     which hid the fade-in and made the ring pop in when the loop started. The exit storyboard takes the property over from its current value, so leaving mid-breath never jumps. -->
                                <BeginStoryboard x:Name="Breathe">
                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.32">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PingWrap" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HotRim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Lock" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32" />
                                        <ThicknessAnimation FillBehavior="Stop" Storyboard.TargetName="Lock" Storyboard.TargetProperty="Margin" To="-14" Duration="0:0:0.32" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PingHex" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PingWrap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.32" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PingScale" Storyboard.TargetProperty="ScaleX" To="0.85" Duration="0:0:0.32" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PingScale" Storyboard.TargetProperty="ScaleY" To="0.65" Duration="0:0:0.32" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.1" />
                                        <ThicknessAnimation Storyboard.TargetName="Lock" Storyboard.TargetProperty="Margin" To="-3" Duration="0:0:0.1"><ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></ThicknessAnimation.EasingFunction></ThicknessAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ThicknessAnimation FillBehavior="Stop" Storyboard.TargetName="Lock" Storyboard.TargetProperty="Margin" To="-7" Duration="0:0:0.18" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
        
            <!-- LAUNCHING and RUNNING come last, so the plate stays the running colour under the pointer. -->
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
