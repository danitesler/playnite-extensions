<!-- Overlay on Playnite Default/Common.xaml: only restyled keys live here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Popover Paper: elevation 8 (PopupBackgroundBrush), shape.borderRadius. MUI lifts it with shadow 8; a 1px
         divider edge stands in for the shadow on WPF's layered popups. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- ButtonBase focusVisible: Material shows keyboard focus as a state layer, not a ring. The control is filled
         with action.focus (WPF shows FocusVisualStyle for keyboard focus only). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border IsHitTestVisible="False" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing (theme.spacing: 8px unit), keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">16,5,16,5</Thickness> <!-- Button contained, medium: 6px 16px at a 24.5px line = 36.5px tall (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">12,5,12,5</Thickness> <!-- FilledInput size small, hiddenLabel: 40px tall, 12px sides (height now set by ControlHeight) -->
    <Thickness x:Key="InputBorderThickness">0,0,0,1</Thickness> <!-- FilledInput: the bottom line only -->
    <Thickness x:Key="MenuPadding">0,8,0,8</Thickness> <!-- MenuList padding 8px 0 -->
    <Thickness x:Key="MenuItemPadding">16,9,16,8</Thickness> <!-- MenuItem 6px 16px at a 24px line = 36px (minHeight auto from sm up) -->
    <Thickness x:Key="ComboBoxDropDownPadding">0,8,0,8</Thickness> <!-- Select opens a Menu: MenuList padding 8px 0 -->
    <Thickness x:Key="ComboBoxItemPadding">16,9,16,8</Thickness> <!-- MenuItem 6px 16px -->
    <Thickness x:Key="ListBoxItemPadding">16,8,16,8</Thickness> <!-- ListItemButton 8px 16px -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness> <!-- CardHeader / CardContent padding 16px -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,16</Thickness> <!-- CardHeader to CardContent -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">24</sys:Double> <!-- SvgIcon fontSize medium -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->
    <Thickness x:Key="TooltipPadding">8,4,8,4</Thickness> <!-- Tooltip 4px 8px -->

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, so the real carousel replaces it without the page jumping. Each Viewbox scales a fixed 1600px
         layout to the width its column gives it (height is unbounded in a vertical stack). The tiles are the host's
         Foreground at low opacity; the whole thing pulses while visible. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the plugin's ContentControl, visible while that control has no height. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="16"
                        Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- menu-mark begin LocalMateriaMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): three rounded bars of different lengths and a state dot, the Material menu turning into a back arrow. Hover (IsMouseOver): a ripple runs down the bars, each one nudging 3px right and back, 50ms apart (each bar sits in its own wrapper canvas). Open (ContextMenu.IsOpen of the nearest Border): the top and bottom bars shorten, rotate 40 degrees about their left ends and drop onto the middle bar, which lengthens to a shaft while the dot shrinks away, so the menu morphs into an arrow (0.3s cubic in-out); the exit storyboard restores every property. -->
    <ControlTemplate x:Key="LocalMateriaMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Canvas x:Name="W1" Width="24" Height="24">
                    <Canvas.RenderTransform><TranslateTransform x:Name="W1T" X="0" Y="0" /></Canvas.RenderTransform>
                    <Rectangle x:Name="B1" Canvas.Left="3" Canvas.Top="6" Width="18" Height="2" RenderTransformOrigin="0,0.5" RadiusX="1" RadiusY="1" Fill="{TemplateBinding Foreground}">
                        <Rectangle.RenderTransform><TransformGroup><ScaleTransform x:Name="B1S" ScaleX="1" ScaleY="1" /><RotateTransform x:Name="B1R" Angle="0" /><TranslateTransform x:Name="B1T" X="0" Y="0" /></TransformGroup></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
                <Canvas x:Name="W2" Width="24" Height="24">
                    <Canvas.RenderTransform><TranslateTransform x:Name="W2T" X="0" Y="0" /></Canvas.RenderTransform>
                    <Rectangle x:Name="B2" Canvas.Left="3" Canvas.Top="11" Width="12" Height="2" RenderTransformOrigin="0,0.5" RadiusX="1" RadiusY="1" Fill="{TemplateBinding Foreground}">
                        <Rectangle.RenderTransform><TransformGroup><ScaleTransform x:Name="B2S" ScaleX="1" ScaleY="1" /><RotateTransform x:Name="B2R" Angle="0" /><TranslateTransform x:Name="B2T" X="0" Y="0" /></TransformGroup></Rectangle.RenderTransform>
                    </Rectangle>
                    <Ellipse x:Name="Dot" Canvas.Left="16.5" Canvas.Top="10.25" Width="3.5" Height="3.5" RenderTransformOrigin="0.5,0.5" Fill="{TemplateBinding Foreground}">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="DotS" ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
                <Canvas x:Name="W3" Width="24" Height="24">
                    <Canvas.RenderTransform><TranslateTransform x:Name="W3T" X="0" Y="0" /></Canvas.RenderTransform>
                    <Rectangle x:Name="B3" Canvas.Left="3" Canvas.Top="16" Width="15" Height="2" RenderTransformOrigin="0,0.5" RadiusX="1" RadiusY="1" Fill="{TemplateBinding Foreground}">
                        <Rectangle.RenderTransform><TransformGroup><ScaleTransform x:Name="B3S" ScaleX="1" ScaleY="1" /><RotateTransform x:Name="B3R" Angle="0" /><TranslateTransform x:Name="B3T" X="0" Y="0" /></TransformGroup></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="W1T" Storyboard.TargetProperty="X"><LinearDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:0.140" Value="3"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.340" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="W2T" Storyboard.TargetProperty="X" BeginTime="0:0:0.050"><LinearDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:0.140" Value="3"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.340" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="W3T" Storyboard.TargetProperty="X" BeginTime="0:0:0.100"><LinearDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:0.140" Value="3"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.340" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="W1T" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.150" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="W2T" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.150" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="W3T" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.150" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="B1S" Storyboard.TargetProperty="ScaleX" To="0.55" Duration="0:0:0.300"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="B1R" Storyboard.TargetProperty="Angle" To="-40" Duration="0:0:0.300"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="B1T" Storyboard.TargetProperty="Y" To="5" Duration="0:0:0.300"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="B3S" Storyboard.TargetProperty="ScaleX" To="0.66" Duration="0:0:0.300"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="B3R" Storyboard.TargetProperty="Angle" To="40" Duration="0:0:0.300"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="B3T" Storyboard.TargetProperty="Y" To="-5" Duration="0:0:0.300"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="B2S" Storyboard.TargetProperty="ScaleX" To="1.5" Duration="0:0:0.300"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DotS" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DotS" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="B1S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.240" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="B1R" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.240" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="B1T" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.240" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="B3S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.240" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="B3R" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.240" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="B3T" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.240" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="B2S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.240" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="DotS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="DotS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.160" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalMateriaMenuMarkTemplate -->
</ResourceDictionary>
