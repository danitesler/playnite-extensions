<!--
    Overlay on Playnite Default/DerivedStyles/WindowBarButton.xaml (dialog title bands; the main window has its own
    MainWindowButton). MUI IconButtons, 36px circles with 18px icons for the 48px band: the action.active icon, the
    action.hover state layer on hover, the error red behind close. Playnite sets Content to the Marlett character
    ("0" minimize, "1" maximize, "2" restore, "r" close); the template maps it to an icon.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="WindowBarButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="18">
                        <!-- FontSize carries the icon size. -->
                        <ContentPresenter x:Name="Glyph"
                                          Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{DynamicResource IconWindowClose}"
                                          ContentTemplate="{DynamicResource IconTemplate}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="0">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMinimize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Content" Value="{DynamicResource IconWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="Content" Value="r" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
