<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml. MUI Button "contained": primary fill, primary.dark on hover, uppercase label.
    Motion (MUI Button.js, TouchRipple.js, createTransitions.js): the button transitions background-color over duration.short (250ms)
    on easeInOut cubic-bezier(0.4, 0, 0.2, 1); the ripple scales 0 to 1 and fades 0.1 to 0.3 over 550ms on easeInOut when pressed, and
    fades out over 550ms on release. Hover: the primary.dark plate (PrimaryButtonHoverBackgroundBrush, opaque) fades in over 0.25s.
    Pressed: a ripple in the label color, started at the center (MUI starts it at the pointer; XAML has no pointer position here)
    as an ellipse inscribed in the button scaled to 1.5, clipped to the button; on release it keeps growing while it fades out,
    so a quick click still plays the whole ripple (FillBehavior Stop on every exit animation, layer hidden at the end).
    Not drawn: the elevation change (2 to 4 to 8, no shadows) and letter spacing.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite
        swaps Play for the context action (RUNNING); a 2px Tabs indicator in the secondary colour lies along the button's
        foot, breathing (3s). Launching blinks it quickly (0.6s).
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching).
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" />
                        <Grid Height="3" Margin="4,0,4,2" VerticalAlignment="Bottom" ClipToBounds="True">
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.75" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="RunningScan" Visibility="Collapsed" Fill="{DynamicResource RunningIndicatorBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningBar1Tail" Color="#00000000" Offset="-0.35" />
                                        <GradientStop x:Name="RunningBar1TailB" Color="#FF000000" Offset="-0.349" />
                                        <GradientStop x:Name="RunningBar1Head" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningBar1HeadB" Color="#00000000" Offset="0.001" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle x:Name="RunningScanB" Visibility="Collapsed" Fill="{DynamicResource RunningIndicatorBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningBar2Tail" Color="#00000000" Offset="-0.35" />
                                        <GradientStop x:Name="RunningBar2TailB" Color="#FF000000" Offset="-0.349" />
                                        <GradientStop x:Name="RunningBar2Head" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningBar2HeadB" Color="#00000000" Offset="0.001" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScanB" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Tail" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.26" Value="1" KeySpline="0.65,0.815 0.735,0.395" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1TailB" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.349" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.26" Value="1.001" KeySpline="0.65,0.815 0.735,0.395" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.001" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Head" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.26" Value="1.9" KeySpline="0.65,0.815 0.735,0.395" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1HeadB" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.001" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.26" Value="1.901" KeySpline="0.65,0.815 0.735,0.395" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.901" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Tail" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="-2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.07" KeySpline="0.65,0.815 0.735,0.395" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2TailB" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-1.999" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="-1.999" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.071" KeySpline="0.65,0.815 0.735,0.395" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Head" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.08" KeySpline="0.65,0.815 0.735,0.395" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2HeadB" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.001" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="0.001" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.081" KeySpline="0.65,0.815 0.735,0.395" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Grid">
                        <Border x:Name="Rest" SnapsToDevicePixels="True"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="RunningBreath" Background="{DynamicResource TextBrushDark}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        <Grid Height="3" Margin="6,0,6,3" VerticalAlignment="Bottom" ClipToBounds="True" IsHitTestVisible="False">
                            <Rectangle Fill="{DynamicResource TextBrushDark}" Opacity="0.18" />
                            <Rectangle x:Name="RunningScan" Visibility="Collapsed" Fill="{DynamicResource TextBrushDark}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningBar1Tail" Color="#00000000" Offset="-0.35" />
                                        <GradientStop x:Name="RunningBar1TailB" Color="#FF000000" Offset="-0.349" />
                                        <GradientStop x:Name="RunningBar1Head" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningBar1HeadB" Color="#00000000" Offset="0.001" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle x:Name="RunningScanB" Visibility="Collapsed" Fill="{DynamicResource TextBrushDark}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningBar2Tail" Color="#00000000" Offset="-0.35" />
                                        <GradientStop x:Name="RunningBar2TailB" Color="#FF000000" Offset="-0.349" />
                                        <GradientStop x:Name="RunningBar2Head" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningBar2HeadB" Color="#00000000" Offset="0.001" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                        <Border x:Name="RunningHoverDim" Background="{DynamicResource TextBrushDark}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        
                        <Border x:Name="HoverPlate" SnapsToDevicePixels="True" Opacity="0"
                                Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Grid x:Name="RippleHost" ClipToBounds="True" IsHitTestVisible="False">
                            <Ellipse x:Name="Ripple" Fill="{DynamicResource TextBrushDark}" Opacity="0" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="RippleScale" ScaleX="0" ScaleY="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter x:Name="PlayContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScanB" />
                            <Setter Property="Opacity" Value="0.1" TargetName="RunningBreath" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Tail" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.26" Value="1" KeySpline="0.65,0.815 0.735,0.395" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1TailB" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.349" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.26" Value="1.001" KeySpline="0.65,0.815 0.735,0.395" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.001" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Head" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.26" Value="1.9" KeySpline="0.65,0.815 0.735,0.395" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1HeadB" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.001" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.26" Value="1.901" KeySpline="0.65,0.815 0.735,0.395" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.901" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Tail" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="-2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.07" KeySpline="0.65,0.815 0.735,0.395" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2TailB" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-1.999" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="-1.999" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.071" KeySpline="0.65,0.815 0.735,0.395" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Head" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.08" KeySpline="0.65,0.815 0.735,0.395" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2HeadB" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.001" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="0.001" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.081" KeySpline="0.65,0.815 0.735,0.395" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.04" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.16" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.04" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" From="0" To="0.18" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.250" Value="1" KeySpline="0.4,0,0.2,1" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.250" Value="0" KeySpline="0.4,0,0.2,1" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0:0:0.000" Value="{x:Static Visibility.Visible}" /></ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="RippleScale" Storyboard.TargetProperty="ScaleX" From="0" To="1.5" Duration="0:0:0.550"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RippleScale" Storyboard.TargetProperty="ScaleY" From="0" To="1.5" Duration="0:0:0.550"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Opacity" From="0.1" To="0.3" Duration="0:0:0.550" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RippleScale" Storyboard.TargetProperty="ScaleX" To="1.5" Duration="0:0:0.550" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RippleScale" Storyboard.TargetProperty="ScaleY" To="1.5" Duration="0:0:0.550" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.550" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0:0:0.550" Value="{x:Static Visibility.Hidden}" /></ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
        
            <!-- LAUNCHING and RUNNING come last, so the plate stays the running colour under the pointer. -->
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
