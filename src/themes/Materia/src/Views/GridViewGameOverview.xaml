                                        <!-- CardMedia -->
                                        <Grid Height="180" MaxHeight="{DynamicResource GameBannerHeight}" ClipToBounds="True" IsHitTestVisible="False" x:Name="GridCardMedia">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Margin" Value="0,0,0,16" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" Value="0">
                                                            <Setter Property="Margin" Value="0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- CardHeader: avatar and title -->
                                        <Border x:Name="GridBannerSpacer">
    <Border.Style><Style TargetType="Border">
        <Setter Property="Height" Value="{Binding ActualHeight, ElementName=GridCardMedia, Converter={StaticResource MathConverter}, ConverterParameter='x == 0 ? 24 : Max(0, 8 - x)'}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Visibility, ElementName=GridCardMedia}" Value="Collapsed"><Setter Property="Height" Value="24" /></DataTrigger>
        </Style.Triggers>
    </Style></Border.Style>
</Border>
<DockPanel Panel.ZIndex="2">
                                            <Button x:Name="InlineSidePanelCloseButton" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" Width="28" Height="28" Padding="0"
                                                Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}" Command="{MainViewModel CloseGameSideBarCommand}"
                                                Template="{Binding Template, ElementName=SidePanelCloseButton}"
                                                Visibility="{Binding Tag, ElementName=SidePanelCloseButton, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Visible` : `Collapsed`'}">
                                                    <Button.RenderTransform>
                                                        <TranslateTransform Y="{Binding ContentVerticalOffset, ElementName=PART_ScrollViewHost}" />
                                                    </Button.RenderTransform>
                                            </Button>
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,16,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                                                </Image.Clip>
                                            </Image>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLargest}"
                                                           Foreground="{DynamicResource TextBrush}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- CardActions -->
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                            </Grid>
                                            <Button Padding="0" x:Name="PART_ButtonMoreActions" Width="40" Height="40" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="{DynamicResource LOCMoreAction}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusFull}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <ContentPresenter Width="24" Height="24"
                                                                  Content="{DynamicResource IconOptions}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button Padding="0" x:Name="PART_ButtonEditGame" Width="40" Height="40" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="{DynamicResource LOCEditGame}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusFull}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <ContentPresenter Width="24" Height="24"
                                                                  Content="{DynamicResource IconEdit}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>

                                        <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,24" />
                                        <Grid x:Name="GridOverviewBody">
<Grid.Tag>
    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400">
        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Tag" ElementName="GridMetadataContent" />
    </MultiBinding>
</Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>


                                            <Grid x:Name="GridMainColumn" VerticalAlignment="Top">
<Grid.Style><Style TargetType="Grid">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
    </DataTrigger></Style.Triggers>
</Style></Grid.Style>
<Grid.MaxWidth>
    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="z == true ? x : Max(0, x - y - 24)">
        <Binding Path="ActualWidth" ElementName="GridOverviewBody" />
        <Binding Path="ActualWidth" ElementName="GridMetadataColumn" />
        <Binding Path="Tag" ElementName="GridOverviewBody" />
    </MultiBinding>
</Grid.MaxWidth>
<StackPanel>
                                        <Grid x:Name="SteamScreenshotsGameScope">
                                            <!-- Plugin visibility is shared: a late Steam load must never reveal a different game's section. -->
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.Source.Name}" Value="Steam">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library or Steam source games in that gap; give up after 12s so a game without screenshots does not keep an empty block. When the plugin is not installed or is disabled the binding fails, FallbackValue=PluginUnavailable matches neither True nor False, and no skeleton shows. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" FontWeight="Medium" Margin="0,0,0,12" />
                                                <Grid>
                                                    <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                    <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                        <Control.Style>
                                                            <Style TargetType="Control">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Control.Style>
                                                    </Control>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        </Grid>
                                        <StackPanel x:Name="PART_ElemDescription" Margin="0,24,0,0">
                                            <HtmlTextView x:Name="PART_HtmlDescription"
                                                          TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                          Tag="{DynamicResource GlyphBrush}"
                                                          HtmlFontSize="{DynamicResource FontSize}"
                                                          HtmlFontFamily="{DynamicResource FontFamily}"
                                                          HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                          LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                        </StackPanel>
                                                                                <StackPanel x:Name="PART_ElemNotes" Margin="0,24,0,0">
                                            <TextBlock Text="{DynamicResource LOCNotesLabel}" FontWeight="Medium" Margin="0,0,0,12" />
                                            <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                     Background="{DynamicResource ControlBackgroundBrush}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" />
                                        </StackPanel>
                                            </StackPanel>
</Grid>
                                            <Grid x:Name="GridMetadataColumn" VerticalAlignment="Top">
<Grid.Style><Style TargetType="Grid">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="Margin" Value="24,0,0,0" />
    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </DataTrigger></Style.Triggers>
</Style></Grid.Style>
<Border Margin="0,0,0,0" VerticalAlignment="Top" ClipToBounds="True" Tag="{DynamicResource GridDetailsPaneWidth}" x:Name="GridMetadataContent" HorizontalAlignment="Stretch">
<Border.Style>
    <Style TargetType="Border">
        <Setter Property="Width" Value="{DynamicResource GridDetailsPaneWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource GridDetailsPaneWidth}" /><Style.Triggers>
            <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /></DataTrigger>
        <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers>
    </Style>
</Border.Style>
                                            <WrapPanel x:Name="GridMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-33,0,-8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-33,-24,-8" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="GridMetadataContent" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                <Border x:Name="MetaProgress" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataContent" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
