<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details mode, right pane).
    Material Design's media detail page (Google Play's app page, in MUI parts). Hero: the background art, 360px,
    under a scrim that fades into background.default; hidden when there is no art. The content column (max 1100px,
    24px gutters) starts 200px down so the header overlaps the hero: the cover (Playnite's cover height setting) and,
    beside it, the title as Typography h4 (regular weight), then the actions: contained Play (or Install), text
    Button More, IconButton Edit (40px circle, 24px icon, action hover).
    Below, two Cards (GroupBox: Paper elevation 1): Description (and a Notes card) on the left; on the right a 380px
    Details card that holds every metadata field Playnite can show: a dense List of two-column rows (label in
    text.secondary, 120px, the value beside it) in six groups split by a Divider: progress (completion status, time
    played, last played, recent activity, added), scores, about (developers, publishers, release date, series, age
    rating, region), tags (platforms, genres, categories, features, tags, as small filled Chips), library (library,
    source, version, install size, install folder) and links. A group whose fields are all hidden takes no space, and
    neither does its Divider.
    Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"
                                  Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible">
                        <Grid x:Name="PageRoot">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
<Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
<FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
<Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
<!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
<Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
    <Rectangle.Style>
        <Style TargetType="Rectangle">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Rectangle.Style>
</Rectangle>
<Border Background="{DynamicResource WindowBackgourndBrush}" Opacity="0.2" />
<!-- No OpacityMask on the banner: masked art repainted in part (behind the animated Play button) left dark patches on scaled displays.
     The fade is a plain gradient to the page color, read from the page brush (PageRoot). -->
<Rectangle>
<Rectangle.Fill>
<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
<GradientStop Color="#00000000" Offset="0.3" />
<GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
</LinearGradientBrush>
</Rectangle.Fill>
</Rectangle>
</Grid>
<Grid>
<Grid.Style>
<Style TargetType="Grid">
<Style.Triggers>
<DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
<Setter Property="Visibility" Value="Collapsed" />
</DataTrigger>
</Style.Triggers>
</Style>
</Grid.Style>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>

                            <!-- Hero: background art under a scrim that fades into background.default -->
                            

                            <StackPanel MaxWidth="1100" VerticalAlignment="Top" Margin="24,0,41,32">
                                <Border IsHitTestVisible="False" x:Name="DetailsBannerSpacer" MinHeight="24">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 200 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="24" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="24" />
</DataTrigger>
</Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Header: cover card, then title (h4) and actions -->
                                <DockPanel>
                                    <Image x:Name="PART_ImageCover" DockPanel.Dock="Left" Margin="0,0,24,0" VerticalAlignment="Bottom"
                                           Height="{Settings GameDetailsCoverHeight}" Stretch="Uniform" StretchDirection="Both"
                                           RenderOptions.BitmapScalingMode="Fant" />
                                    <StackPanel VerticalAlignment="Bottom">
                                        <DockPanel>
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeLargest}"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                            </Grid>
                                            <Button Padding="0" x:Name="PART_ButtonMoreActions" Width="40" Height="40" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="{DynamicResource LOCMoreAction}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusFull}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <ContentPresenter Width="24" Height="24"
                                                                  Content="{DynamicResource IconOptions}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button Padding="0" x:Name="PART_ButtonEditGame" Width="40" Height="40" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="{DynamicResource LOCEditGame}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusFull}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <ContentPresenter Width="24" Height="24"
                                                                  Content="{DynamicResource IconEdit}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Cards: Description (and notes), and Details (every metadata field) -->
                                <Grid Margin="0,24,0,0" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 16 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataViewport" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="16,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<GroupBox VerticalAlignment="Top" Header="{DynamicResource LOCGameDetails}" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                        <Border ClipToBounds="True" x:Name="DetailsMetadataViewport" Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch">
<Border.Style><Style TargetType="Border"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-31,0,-6" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-31,-24,-6" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                <Border x:Name="MetaProgress" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel x:Name="PART_ElemCompletionStatus" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCCompletionStatus}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemPlayTime" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCTimePlayed}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextPlayTime" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemLastPlayed" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCLastPlayed}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextLastActivity" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemRecentActivity" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCRecentActivityLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextRecentActivity" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemAdded" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCDateAddedLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextAdded" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaScores" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel x:Name="PART_ElemCommunityScore" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCCommunityScore}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemCriticScore" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCCriticScore}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemUserScore" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCUserScore}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaAbout" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel x:Name="PART_ElemDevelopers" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCDevelopersLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsDevelopers" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemPublishers" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCPublishersLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsPublishers" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemReleaseDate" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCGameReleaseDateTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemSeries" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCSeriesLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsSeries" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemAgeRating" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCAgeRatingLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsAgeRatings" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemRegion" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCRegionLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsRegions" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaTags" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel x:Name="PART_ElemPlatform" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCPlatformsTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,3,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemGenres" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCGenresLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,3,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemCategories" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCCategoriesLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,3,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemFeatures" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCFeaturesLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,3,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemTags" Margin="0,6,0,6">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCTagsLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,3,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsTags" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaLibrary" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
