<!--
    Materia: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from
    tokens.css (MUI's CSS variables) and writes the result to the build as Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo: Playnite's
    palette keys, then shared keys for roles Playnite has none for. Each placeholder names the MUI variable that plays
    the role (palette.background.paper is mui-palette-background-paper; paper at elevation N in dark mode is
    mui-overlays-N over the paper; alpha(primary.main, selectedOpacity) is mui-palette-primary-main/16), so MUI's names
    live in tokens.css and here only. Theme XAML reads the brushes (never the Color keys), so ThemeModifier edits reach
    every control.

    Action, text and divider colors keep their alpha, as in MUI; popup surfaces and edges are flattened onto
    background.default, because WPF popups are layered windows.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): MUI's type scale is Roboto; Roboto is not bundled (Toolbox drops Fonts/), so
         Segoe UI. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">32</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys). ControlCornerRadius is theme.shape.borderRadius. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:mui-shape-borderRadius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale: borderRadius '50%' (IconButton, Radio); FilledInput rounds the top corners only -->
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">{{px:mui-shape-borderRadius}},{{px:mui-shape-borderRadius}},0,0</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor = primary.main and TextColorDark = primary.contrastText: Playnite always pairs those two (selected
        rows, play button).
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{mui-palette-text-primary}}</Color>
    <Color x:Key="TextColorDarker">{{mui-palette-text-secondary}}</Color>
    <Color x:Key="TextColorDark">{{mui-palette-primary-contrastText@mui-palette-primary-main}}</Color>
    <Color x:Key="MainColor">{{mui-palette-action-disabledBackground@mui-palette-background-default}}</Color>
    <Color x:Key="MainColorDark">{{mui-overlays-1@mui-palette-background-paper}}</Color>
    <Color x:Key="HoverColor">{{mui-palette-action-hover@mui-palette-background-default}}</Color>
    <Color x:Key="GlyphColor">{{mui-palette-primary-main}}</Color>
    <Color x:Key="HighlightGlyphColor">{{mui-palette-primary-main/50}}</Color>
    <Color x:Key="PopupBackgroundColor">{{mui-overlays-8@mui-palette-background-paper}}</Color>
    <Color x:Key="PopupBorderColor">{{mui-palette-divider@mui-overlays-8@mui-palette-background-paper}}</Color>
    <Color x:Key="BackgroundToneColor">{{mui-overlays-1@mui-palette-background-paper}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>     <!-- no frame around covers -->
    <Color x:Key="PanelSeparatorColor">#00000000</Color>         <!-- no lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{mui-palette-divider}}</Color>
    <Color x:Key="DataChangeNotifColor">{{mui-palette-warning-main}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{mui-OutlinedInput-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{{mui-palette-action-hover}}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{mui-palette-Tooltip-bg@mui-palette-background-default}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{mui-overlays-1@mui-palette-background-paper}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{mui-palette-FilledInput-bg}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{mui-palette-success-main}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{mui-palette-error-main}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{mui-palette-warning-main}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{mui-palette-error-main}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{mui-overlays-1@mui-palette-background-paper}}" />  <!-- Card: Paper elevation 1 -->
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{mui-palette-background-default}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell: the AppBar (flat on background.default, like the page) and its search -->
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{mui-palette-background-default}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{mui-AppBar-search-bg}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{mui-AppBar-search-hoverBg}}" />

    <!-- States: alpha(primary.main, selectedOpacity), action.focus -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{mui-palette-primary-main/16}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{mui-palette-primary-main/24}}" />   <!-- selectedOpacity + hoverOpacity -->
    <SolidColorBrush x:Key="FocusBrush" Color="{{mui-palette-action-focus}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{mui-palette-primary-main/16}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{mui-palette-error-main}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{mui-palette-error-contrastText}}" />

    <!-- Buttons: Button text / outlined / contained -->
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{mui-palette-primary-main/8}}" />  <!-- alpha(primary.main, hoverOpacity) -->
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{mui-palette-primary-main/16}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{mui-palette-primary-main/50}}" />         <!-- Button outlined -->
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{mui-palette-primary-dark}}" />

    <!-- Inputs: FilledInput -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{mui-palette-FilledInput-bg}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{mui-palette-FilledInput-hoverBg}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{mui-FilledInput-underline}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{mui-palette-text-primary}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{mui-palette-text-secondary}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{mui-palette-primary-main/8}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{mui-palette-LinearProgress-primaryBg}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{mui-palette-text-primary}}" />      <!-- drawn at 26%, 50% / 70% on hover / drag -->
    <SolidColorBrush x:Key="ThumbBrush" Color="{{mui-palette-text-primary}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{mui-palette-text-secondary}}" />
    <!-- Chip filled (default color): action.selected; clickable hover alpha(selectedOpacity + hoverOpacity) -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{mui-palette-action-selected}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{mui-palette-text-primary}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{mui-palette-common-white/24}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{mui-palette-common-white}}" />
</ResourceDictionary>
