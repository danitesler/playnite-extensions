<!--
    Overlay on Playnite Default/CustomControls/GameGroupMenu.xaml. Group header menu: the MUI Menu paper of
    DefaultControls/ContextMenu.xaml, which Playnite loads earlier, so the StaticResource resolves to it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GameGroupMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />
</ResourceDictionary>
