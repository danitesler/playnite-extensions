<!--
    Last Flame: TextBox. A sunken item slot: pure black fill, worn gold edge, tan caret. Hover brightens the edge to brass;
    keyboard focus within lights it tan. BareTextBox drops the chrome. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LocalEmberFieldTemplate: a broken gold frame. Two gaps break the frame line (top left, bottom right) at rest.
        Hover: a dim ember glow rises from the bottom. Keyboard focus: a torn blood-red ribbon tears in under the
        bottom-left (0.2s) and the torch flickers once along the bottom (0, 0.5, 0.2, 0.42, 0.34 over 0.32s).
        State is read from the nearest Control above; no desired size.
    -->
    <ControlTemplate x:Key="LocalEmberFieldTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle x:Name="Ember" Height="12" VerticalAlignment="Bottom" Margin="1,0,1,1" Fill="{DynamicResource WarningBrush}" Opacity="0">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Offset="0" Color="#66FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="10" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,0,0,0" Fill="{DynamicResource InputBackgroundBrush}" />
            <Rectangle Width="8" Height="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,0" Fill="{DynamicResource InputBackgroundBrush}" />
            <Path x:Name="Ribbon" Width="48" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,1"
                  Data="M0,0 H41 L44,1.2 L42,2 L48,3 L43,4 H0 Z" Fill="{DynamicResource PrimaryButtonBackgroundBrush}" RenderTransformOrigin="0,0.5">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="RibbonScale" ScaleX="0" />
                </Path.RenderTransform>
            </Path>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <Setter TargetName="Ember" Property="Opacity" Value="0.22" />
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Torch">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RibbonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ember" Storyboard.TargetProperty="Opacity">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="0.5" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="0.2" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.24" Value="0.42" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.32" Value="0.34" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Torch" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <Control x:Name="FieldOverlay" Template="{DynamicResource LocalEmberFieldTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Border" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BareTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <!-- Its own bare template, so hosts (editable dropdown, search) do not inherit the field's signature. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
