<!--
    Last Flame: GroupBox as a framed panel: soot fill inside the broken double frame, heading in tan running into the worn
    rule. Content-sized, no fixed widths: DoubleFrameTemplate uses 24 + star + 24 columns and DividerTemplate a Rectangle
    whose width comes from its host, so Statistics sections stay compact cards. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Border Background="{DynamicResource ExpanderBackgroundBrush}" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                    <ContentPresenter DockPanel.Dock="Left" ContentSource="Header" VerticalAlignment="Center"
                                                      TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                      TextElement.FontWeight="Bold"
                                                      TextElement.Foreground="{DynamicResource HeadingForegroundBrush}" />
                                    <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource HeadingRuleBrush}"
                                             Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="30" />
                                </DockPanel>
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <Control Template="{DynamicResource DoubleFrameTemplate}" Foreground="{DynamicResource FrameInnerBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
