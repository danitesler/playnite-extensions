<!--
    Last Flame: ContextMenu. Every popup menu and dropdown list (hamburger menu, top bar dropdowns via TopPanelMenu,
    GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select boxes) wears
    the Darkest Dungeon II gothic altar slate (LocalAltarMenuTemplate): soot-black PopupBackgroundBrush framed by the
    broken worn-gold double frame (DoubleFrameTemplate in FrameBrush) with a small flame-diamond crest at top-centre.
    Rows sit 8px inside the broken double frame. Rows and the 10px worn-rule group break are in Menu.xaml.
    Structure: Playnite Default 10.60. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalAltarMenuTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1" />
            <Control Template="{DynamicResource DoubleFrameTemplate}" Foreground="{DynamicResource FrameBrush}"
                     Focusable="False" IsTabStop="False" />
            <!-- Small torch-diamond crest centered on the top frame line -->
            <Grid Width="26" Height="8" Margin="0,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource GlyphBrush}" Opacity="0.7" />
                <Path Width="8" Height="8" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 4,0 L 8,4 L 4,8 L 0,4 Z" Fill="{DynamicResource PopupBackgroundBrush}"
                      Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" />
                <Path Width="3.5" Height="3.5" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 1.75,0 L 3.5,1.75 L 1.75,3.5 L 0,1.75 Z" Fill="{DynamicResource PrimaryButtonGlowBrush}" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalAltarMenuTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,9,0,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="7,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
