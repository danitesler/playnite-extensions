<!--
    Last Flame: SearchBox. The TextBox's sunken slot with a chisel glyph on each side; typing lights the edge tan and adds the
    selected-skill ticks. Keeps PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Field" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <ContentControl x:Name="PART_SeachIcon" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}"
                                                Foreground="{DynamicResource TextBrushDarker}" Margin="9,0,0,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                         Padding="33,0,28,0" VerticalContentAlignment="Center" />
                                <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,9,0" Cursor="Hand"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Control x:Name="Marks" Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource GlyphBrush}" Margin="-1" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="PART_SeachIcon" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="Marks" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
