<!--
    Last Flame: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). Token names (lf-*) live in tokens.css; each
    placeholder names the token that plays the key's role. Role map: ../AGENTS.md -> Tokens; measurements: ../RESEARCH.md.
    Theme XAML reads brushes only, never Color keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Windows ships no gothic display face; a serif carries the engraved look (no font is included). -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">32</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Georgia}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Georgia}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape: square, hard cut. The game has no rounded chrome. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{lf-bone}}</Color>
    <Color x:Key="TextColorDarker">{{lf-dust}}</Color>
    <Color x:Key="TextColorDark">{{lf-on-tan}}</Color>
    <Color x:Key="MainColor">{{lf-char}}</Color>
    <Color x:Key="MainColorDark">{{lf-soot}}</Color>
    <Color x:Key="HoverColor">{{lf-ash}}</Color>
    <Color x:Key="GlyphColor">{{lf-tan}}</Color>
    <Color x:Key="HighlightGlyphColor">{{lf-brass}}</Color>
    <Color x:Key="PopupBackgroundColor">{{lf-soot}}</Color>
    <Color x:Key="PopupBorderColor">{{lf-frame}}</Color>
    <Color x:Key="BackgroundToneColor">{{lf-ink}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{lf-iron}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{lf-iron}}</Color>
    <Color x:Key="DataChangeNotifColor">{{lf-flame}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{lf-frame}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{lf-void}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{lf-soot}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{lf-void}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{lf-verdigris}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{lf-blood-hot}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{lf-tan}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{lf-flame}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{lf-soot}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{lf-void}}" />

    <!-- Surfaces and art -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{lf-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{lf-ink}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{lf-void}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{lf-ink}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{lf-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{lf-oxblood}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the theme's
         own ArtTint color, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{lf-oxblood}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{lf-soot}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{lf-tan}}" />

    <!-- Selection and states -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{lf-wine}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{lf-tan}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{lf-bone}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{lf-char}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{lf-blood}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{lf-wine}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{lf-tan}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{lf-blood}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{lf-bone}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{lf-tan}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{lf-bone}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{lf-frame}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{lf-ash}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{lf-oxblood}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{lf-blood}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{lf-tan}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{lf-blood-hot}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{lf-blood-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{lf-bone}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{lf-flame}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{lf-wine}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{lf-void}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{lf-frame}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{lf-brass}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{lf-frame}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{lf-tan}}" />

    <!-- Tracks and thumbs -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{lf-void}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{lf-tan}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{lf-bone}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{lf-blood-hot}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{lf-void}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{lf-blood}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{lf-frame}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{lf-tan}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{lf-frame}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{lf-tan}}" />

    <!-- Tabs, covers, shell items -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{lf-dust}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{lf-bone}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{lf-blood}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{lf-tan}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{lf-tan}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{lf-char}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{lf-wine}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{lf-grey}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{lf-tan}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{lf-wine}}" />

    <!-- Metadata, menus, tooltips, dialogs -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{lf-void}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{lf-tan}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{lf-wine}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{lf-iron}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{lf-bone}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{lf-frame}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{lf-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{lf-tan}}" />

    <!-- Frames and headings -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{lf-brass}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{lf-frame}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{lf-tan}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{lf-iron}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{lf-void}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{lf-tan}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{lf-blood}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{lf-frame}}" />
</ResourceDictionary>
