<!--
    Last Flame: spacing, focus and the shared motifs. Measurements: ../RESEARCH.md.
      DoubleFrameTemplate  the broken gold double line of the game's banners and panels (9-slice of frame.png)
      CornerMarksTemplate  chisel-cut L ticks, the mark under a selected skill
      DividerTemplate      a diamond pip running into a worn gold rule
      SelectionBarTemplate the torn crimson ribbon behind a hero's name
      GlowFrameTemplate    torchlight falloff
    All sprites are white masks filled with the host's Foreground, so ThemeModifier edits reach them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">9,5</Thickness>
    <Thickness x:Key="MenuPadding">0,5</Thickness>
    <Thickness x:Key="MenuItemPadding">12,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,5</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">11,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">11,7</Thickness>
    <Thickness x:Key="GroupBoxPadding">20,16,20,20</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>
    <Thickness x:Key="TooltipPadding">11,7</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">380</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Broken double frame: 9-slice of frame.png (192px, slices 48 / 96 / 48, drawn at 24 / star / 24). Columns are
         24 + star + 24, so it never reports a wide desired size (Statistics cards stay compact). -->
    <ControlTemplate x:Key="DoubleFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" Viewbox="0,0,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" Viewbox="48,0,96,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" Viewbox="144,0,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" Viewbox="0,48,48,96" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" Viewbox="144,48,48,96" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" Viewbox="0,144,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" Viewbox="48,144,96,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" Viewbox="144,144,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Chisel-cut L ticks: filled shapes with angled ends, arm 10, 2px thick. No desired size of their own. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,11 L0,0 11,0 9,2 2,2 2,9Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L11,0 11,11 9,9 9,2 2,2Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L2,2 2,9 9,9 11,11 0,11Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M11,0 L11,11 0,11 2,9 9,9 9,2Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <!-- A diamond pip running into a worn double rule (rule.png tiles in x, so width comes only from the host). -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" VerticalAlignment="Center" Height="10" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Width="8" Height="8" Stretch="Fill" Data="M4,0 L8,4 4,8 0,4Z" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/rule.png'}" TileMode="Tile" Stretch="Fill" Viewport="0,0,1024,10" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Torn ribbon: stretched to its host. Selection in the game list, tab indicator, title underline. -->
    <ControlTemplate x:Key="SelectionBarTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/ribbon.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Torchlight falloff. The host decides its own bleed with a negative margin. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Keyboard focus: the selected-skill ticks, 3px outside the control. -->
    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): the theme's faceted torch flame on a small sconce bracket, 24x28
         (the pennant in the rail keeps its place; this sits where the old glyph did). Rest: the last flame, a tan outline with
         a dim heart facet. Hover (IsMouseOver): the flame catches (a flame-orange fill rises, 0.2s) and flickers (a 0.32s
         squash-and-stretch loop on the flame's own transform) until the pointer leaves. Open (the menu's ContextMenu.IsOpen on
         the nearest Border, which is PART_ElemMainMenu): the torch is raised: the heart burns bone white, the flame leans
         back and forth on a slow 2.6s sway and two embers rise off the tip and die out, staggered, until the menu closes.
         Hover animates FlameFill and FlickerScale, open Heart, Sway, Ember1 and Ember2, so they layer without fighting. -->
    <ControlTemplate x:Key="LocalLastFlameMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" Margin="{TemplateBinding Padding}" UseLayoutRounding="True">
            <Canvas Width="24" Height="28" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
                <Path Data="M6.5,26.5 H17.5 M12,23.5 V26.5" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1.5" />
                <Canvas x:Name="Sway" Width="24" Height="28" RenderTransformOrigin="0.5,0.9">
                    <Canvas.RenderTransform><RotateTransform x:Name="SwayTurn" Angle="0" /></Canvas.RenderTransform>
                    <Canvas x:Name="Flicker" Width="24" Height="28" RenderTransformOrigin="0.5,0.85">
                        <Canvas.RenderTransform><ScaleTransform x:Name="FlickerScale" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                        <Path x:Name="FlameFill" Data="M13,0.5 L17,6 16,9.5 19,7.5 21,13 20,18.5 15,23 9,23 4,18.5 3,13 6,8.5 7.5,12 8.5,6Z" Fill="{DynamicResource WarningBrush}" Opacity="0" />
                        <Path Data="M13,0.5 L17,6 16,9.5 19,7.5 21,13 20,18.5 15,23 9,23 4,18.5 3,13 6,8.5 7.5,12 8.5,6Z" Stroke="{DynamicResource MainMenuButtonForegroundBrush}" StrokeThickness="1.25" StrokeLineJoin="Miter" />
                        <Path Data="M12.5,10.5 L9.5,15 9,18.5 11.5,21 14.5,19.5 15.5,16Z" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1" StrokeLineJoin="Miter" />
                        <Path x:Name="Heart" Data="M12.5,10.5 L9.5,15 9,18.5 11.5,21 14.5,19.5 15.5,16Z" Fill="{DynamicResource TextBrush}" Opacity="0" />
                    </Canvas>
                </Canvas>
                <Rectangle x:Name="Ember1" Canvas.Left="11" Canvas.Top="6" Width="2.5" Height="2.5" Fill="{DynamicResource WarningBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="45" />
                            <TranslateTransform x:Name="Ember1Move" Y="0" />
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="Ember2" Canvas.Left="15" Canvas.Top="8" Width="2" Height="2" Fill="{DynamicResource TextBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="45" />
                            <TranslateTransform x:Name="Ember2Move" Y="0" />
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="FlameFill" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="FlickerScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.07" BeginTime="0:0:0.1" Duration="0:0:0.32" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="FlickerScale" Storyboard.TargetProperty="ScaleX" From="1" To="0.94" BeginTime="0:0:0.1" Duration="0:0:0.32" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FlameFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FlickerScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FlickerScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Heart" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetName="SwayTurn" Storyboard.TargetProperty="Angle" From="-4" To="4" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ember1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="Ember1Move" Storyboard.TargetProperty="Y" From="0" To="-8" Duration="0:0:1.6" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ember2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.8" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="Ember2Move" Storyboard.TargetProperty="Y" From="0" To="-7" BeginTime="0:0:0.8" Duration="0:0:1.6" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Heart" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SwayTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Ember1" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Ember1Move" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Ember2" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Ember2Move" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
