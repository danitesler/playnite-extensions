<!--
    Last Flame: grid side panel. Generated by art/gen-overviews.mjs; edit the generator, not this file.
    Same skeleton as the details view, narrower: banner, spacer x * 150 / 380 (52 with no banner, room for the close
    button), the title over the ribbon, actions under it, then text left and the framed panel right (GridDetailsPaneWidth,
    300 content width) with captions beside values. Close (CloseGameSideBarCommand) sits over the top-right corner. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="GridViewGameOverview">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewGameOverview">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="PageRoot" Background="{DynamicResource GameOverviewBackgroundBrush}" UseLayoutRounding="True">
                                    <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                        <Border Background="{DynamicResource ArtTintBrush}" Opacity="0.4" />
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0.3" />
                                                    <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Path Height="36" VerticalAlignment="Bottom" Stretch="Fill" Fill="{DynamicResource GameOverviewBackgroundBrush}" Data="M0,40 L0,14 0.0,4.1 6.5,4.6 15.5,5.4 27.5,5.6 33.3,8.5 42.8,16.2 49.3,4.7 63.4,11.2 72.6,12.5 78.9,8.0 89.1,20.0 101.2,8.7 109.4,4.8 116.5,5.2 121.7,6.8 127.3,17.8 134.0,6.6 144.2,4.6 149.8,5.0 163.0,6.0 176.4,8.3 191.9,5.5 203.2,9.6 210.4,5.2 225.5,14.0 237.9,8.0 253.5,11.2 261.1,6.1 273.7,5.2 285.4,6.3 293.2,5.1 301.3,14.7 308.1,8.2 320.7,5.0 328.4,8.9 338.3,18.7 349.2,13.5 356.5,8.3 362.6,23.7 372.2,5.2 385.7,15.6 401.1,9.4 415.3,8.5 422.9,4.7 436.3,11.3 442.6,6.2 450.9,8.5 457.8,6.7 464.1,4.1 477.6,5.1 486.7,6.2 502.5,4.8 515.7,17.6 528.4,9.8 538.4,14.9 547.5,11.7 553.0,11.1 566.5,7.4 578.3,6.0 586.3,12.5 598.3,8.8 607.5,4.1 617.8,4.0 627.4,14.8 636.2,15.5 646.1,20.2 654.6,5.7 663.8,5.3 679.4,4.1 693.1,6.5 701.2,9.2 712.0,5.4 722.5,10.1 736.7,6.9 746.2,7.7 757.6,10.9 765.4,7.7 774.5,5.3 783.0,6.3 797.4,11.4 811.3,6.5 824.4,11.2 835.7,9.5 844.6,16.6 851.3,14.0 860.2,6.6 868.5,8.1 880.7,8.7 892.8,4.6 904.9,8.0 910.7,24.1 920.6,11.2 926.4,5.0 935.5,10.0 950.5,16.8 960.1,13.1 969.0,15.1 984.4,5.8 997.0,16.2 1000,12 1000,40Z" />
                                    </Grid>
                                    <StackPanel Margin="24,0,24,26">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 150 / 380'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="52" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Margin="0,10,0,16">
                                            <DockPanel>
                                                <Image x:Name="PART_ImageIcon" MaxWidth="44" MaxHeight="44" Margin="0,0,14,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLargest}"
                                                                   FontWeight="Bold" Foreground="{DynamicResource TextShadowBrush}" TextWrapping="Wrap" Margin="2,2,-2,-2" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLargest}"
                                                                   FontWeight="Bold" Foreground="{DynamicResource HeadingForegroundBrush}" TextWrapping="Wrap" />
                                                    </Grid>
                                                    <Control Template="{DynamicResource SelectionBarTemplate}" Foreground="{DynamicResource HeadingMarkerBrush}"
                                                             Width="220" Height="12" HorizontalAlignment="Left" Margin="-4,2,0,0">
                                                        <Control.Style>
                                                            <Style TargetType="Control">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Control.Style>
                                                    </Control>
                                                </StackPanel>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                <Grid Width="172" Height="46">
                                                    <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                    <Button x:Name="PART_ButtonContextAction" />
                                                </Grid>
                                                <Button x:Name="PART_ButtonMoreActions" Width="44" Height="44" Padding="0" Margin="4,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                                    <ContentControl Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                                <Button x:Name="PART_ButtonEditGame" Width="44" Height="44" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource LOCEditGame}">
                                                    <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" Margin="0,0,0,20">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Game.PluginId}" Value="CB91DFC9-B977-43BF-8E70-55F46E410FAB" />
                                                                        <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Border Tag="{Binding Game.Id, NotifyOnTargetUpdated=True}" Visibility="Collapsed" Height="150" Margin="0,0,0,20"
                                                            Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1">
                                                        <Border.Triggers>
                                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Border.Triggers>
                                                        <Grid x:Name="SkeletonCells" Margin="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" />
                                                            <Border Grid.Column="2" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <StackPanel x:Name="PART_ElemDescription">
                                                    <DockPanel Margin="0,0,0,12">
                                                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource LOCGameDescriptionTitle}" Style="{DynamicResource HeadingTextBlock}" />
                                                        <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource HeadingRuleBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <HtmlTextView x:Name="PART_HtmlDescription" HtmlFontFamily="{DynamicResource FontFamily}" HtmlFontSize="{DynamicResource FontSize}"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}" Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlForeground="{Binding Path=(TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}" />
                                                </StackPanel>
                                                <StackPanel x:Name="PART_ElemNotes" Margin="0,24,0,0">
                                                    <DockPanel Margin="0,0,0,12">
                                                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource LOCNotesLabel}" Style="{DynamicResource HeadingTextBlock}" />
                                                        <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource HeadingRuleBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBox x:Name="PART_TextNotes" IsReadOnly="True" TextWrapping="Wrap" Style="{DynamicResource BareTextBox}" Foreground="{DynamicResource TextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Grid Grid.Column="2" VerticalAlignment="Top">
                                                <Border Background="{DynamicResource ExpanderBackgroundBrush}" Padding="18,16,18,18">
                                                    <StackPanel Width="{DynamicResource GridDetailsPaneWidth}">
                                                        <DockPanel Margin="0,0,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource LOCGameDetails}" Style="{DynamicResource HeadingTextBlock}" />
                                                            <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource HeadingRuleBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <Grid ClipToBounds="True">
                                                            <StackPanel Margin="0,-32,0,-7">
                                                                <Border x:Name="MetaProgress" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <Border x:Name="PART_ElemCompletionStatus" Margin="0,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                                                                <Button Grid.Column="2" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PropertyItemButton}" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemPlayTime" Margin="0,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                                                                <TextBlock Grid.Column="2" x:Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemLastPlayed" Margin="0,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                                                                <TextBlock Grid.Column="2" x:Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemRecentActivity" Margin="0,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                                                                <TextBlock Grid.Column="2" x:Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemAdded" Margin="0,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCDateAddedLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                                                                <TextBlock Grid.Column="2" x:Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaScores" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <Border x:Name="PART_ElemCommunityScore" Margin="0,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCCommunityScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                                                                <TextBlock Grid.Column="2" x:Name="PART_TextCommunityScore" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemCriticScore" Margin="0,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCCriticScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                                                                <TextBlock Grid.Column="2" x:Name="PART_TextCriticScore" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemUserScore" Margin="0,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCUserScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                                                                <TextBlock Grid.Column="2" x:Name="PART_TextUserScore" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaAbout" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <Border x:Name="PART_ElemDevelopers" Margin="0,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCDeveloperLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsDevelopers" Tag="">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <WrapPanel />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                </ItemsControl>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemPublishers" Margin="0,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCPublisherLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsPublishers" Tag="">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <WrapPanel />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                </ItemsControl>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemReleaseDate" Margin="0,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                                                                <Button Grid.Column="2" x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PropertyItemButton}" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemSeries" Margin="0,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
