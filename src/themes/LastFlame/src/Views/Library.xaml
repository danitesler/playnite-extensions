<!--
    Last Flame: library layer. Solid ink, no texture behind covers and rows. Background art at 0.16 under an oxblood wash,
    faded out by 70% with a plain gradient overlay (no mask). A low torchlight glow rises from the bottom centre. The top bar
    is raised (ZIndex 1) so its rule shows over the views. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid x:Name="LibraryRoot" Background="{DynamicResource ContentBackgroundBrush}"
                          d:DesignWidth="1500" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                            <FadeImage x:Name="PART_ImageBackground" Opacity="0.16"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <Border Background="{DynamicResource ArtTintBrush}" Opacity="0.45"
                                    Visibility="{Binding Visibility, ElementName=PART_ImageBackground}" />
                            <!-- No OpacityMask on library art: animated covers above it would leave dark boxes on scaled displays. -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="{Binding Background.Color, ElementName=LibraryRoot}" Offset="0.7" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <Border x:Name="FlameSwatch" Background="{DynamicResource WarningBrush}" Visibility="Collapsed" />
                        <Rectangle Grid.RowSpan="2" VerticalAlignment="Bottom" Height="460" Margin="-200,0,-200,-230" Opacity="0.07" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{Binding Background.Color, ElementName=FlameSwatch}" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <TopPanel DockPanel.Dock="Top" Grid.Row="0" Panel.ZIndex="1" />

                        <DockPanel Grid.Row="1">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}" />

                            <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                           DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}" />

                            <Grid DockPanel.Dock="Left">
                                <LibraryDetailsView x:Name="PART_ViewDetails" />
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
