<!--
    Last Flame: top bar. 52px pure black with soot grain, closed by the worn double rule. Default order: menu, search, main
    items, filter, notifications, plugin items; 132px kept clear for the caption buttons. Glyphs are the hand-cut set at
    IconSize, icons only. The notification count sits on a red diamond, the game's alert pip. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentControl Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentControl Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentControl Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentControl Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentControl Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentControl Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentControl Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentControl Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentControl Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentControl Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="5,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Margin="9,0">
                            <ContentControl Content="{DynamicResource IconFilter}" ContentTemplate="{DynamicResource IconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}" />
                            <TextBlock Text="{DynamicResource LOCFilterActiveLabel}"
                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource GlyphBrush}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       Name="TextFilter" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="Margin" Value="5,0,0,0" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Grid>
                            <ContentControl Content="{DynamicResource IconNotifications}" ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,1">
                                <Path Data="M9,0 L18,9 9,18 0,9Z" Fill="{DynamicResource DangerBrush}" />
                                <TextBlock Text="{Api Notifications.Count}" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Grid Height="52" Background="{DynamicResource TopPanelBackgroundBrush}"
                          d:DesignWidth="1280"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource NormalBorderBrush}" Opacity="0.3">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/grain.png'}" TileMode="Tile" Stretch="Fill" Viewport="0,0,256,256" ViewportUnits="Absolute" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle Height="10" VerticalAlignment="Bottom" Margin="0,0,0,-6" IsHitTestVisible="False" Fill="{DynamicResource FrameInnerBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/rule.png'}" TileMode="Tile" Stretch="Fill" Viewport="0,0,1024,10" ViewportUnits="Absolute" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <DockPanel Margin="12,9,132,9">
                            <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                    DockPanel.Dock="Left" Margin="0,0,8,0" Cursor="Hand" Width="32"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <ContentControl Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch" Style="{DynamicResource TopPanelSearchBox}"
                                       Margin="0,1,5,1" DockPanel.Dock="Left"
                                       WindowChrome.IsHitTestVisibleInChrome="True"
                                       Width="280" />

                            <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal" VerticalAlignment="Stretch" />

                            <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" DockPanel.Dock="Left" />

                            <CheckBox x:Name="PART_ToggleNotifications"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" DockPanel.Dock="Left" />

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Stretch" Margin="12,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Center" Margin="0,2">
                                <Grid MaxWidth="600" MinWidth="300">
                                    <ProgressBar Name="PART_ProgressGlobal" />
                                    <TextBlock Name="PART_TextProgressText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Style="{DynamicResource BaseTextBlockStyle}" Margin="5,0,5,0" />
                                </Grid>
                                <Button Name="PART_ButtonProgressCancel" Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True" Padding="10,0" Margin="5,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
