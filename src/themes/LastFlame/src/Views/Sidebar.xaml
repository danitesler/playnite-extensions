<!--
    Last Flame: left rail, 44px, pure black with soot grain, closed by the worn double rule. The main menu is the pennant that
    hangs from the top of the game's map screen: a double-lined banner ending in a point, carrying the theme's torch
    flame (no owner mark). With the sidebar at the top or bottom the pennant drops away and the flame sits alone.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <Rectangle IsHitTestVisible="False" Fill="{DynamicResource NormalBorderBrush}" Opacity="0.3">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/grain.png'}" TileMode="Tile" Stretch="Fill" Viewport="0,0,256,256" ViewportUnits="Absolute" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="66" Margin="0,0,0,6"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Path x:Name="Banner" Data="M4,0 L40,0 40,44 22,63 4,44Z" Fill="{DynamicResource MainMenuButtonBackgroundBrush}"
                                              Stroke="{DynamicResource FrameBrush}" StrokeThickness="1.5" />
                                        <Path x:Name="BannerInner" Data="M8,0 L36,0 36,42 22,57 8,42Z" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1" />
                                        <ContentControl x:Name="MenuFlame" Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,17,0,0" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                            <Rectangle x:Name="EdgeRule" Width="10" HorizontalAlignment="Right" Margin="0,0,-4,0" IsHitTestVisible="False" Fill="{DynamicResource FrameInnerBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/rule-v.png'}" TileMode="Tile" Stretch="Fill" Viewport="0,0,10,1024" ViewportUnits="Absolute" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Stroke" Value="{DynamicResource FrameHoverBrush}" TargetName="Banner" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="MenuFlame" />
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                            <Setter Property="Margin" Value="-4,0,0,0" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Banner" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="BannerInner" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="VerticalAlignment" Value="Center" TargetName="MenuFlame" />
                            <Setter Property="Margin" Value="0" TargetName="MenuFlame" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Banner" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="BannerInner" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="VerticalAlignment" Value="Center" TargetName="MenuFlame" />
                            <Setter Property="Margin" Value="0" TargetName="MenuFlame" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
