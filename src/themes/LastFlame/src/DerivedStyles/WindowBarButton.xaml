<!--
    Last Flame: caption buttons, 40x32, bare. Playnite passes the Marlett codes 0 / 1 / 2 / r as Content; triggers swap them
    for the hand-cut glyphs. Hover lifts to ash; close hovers crimson. MainWindowButton lives here so it is built on this
    file's WindowBarButton, not on Default's (files merge one by one).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WindowBarButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate" Background="{TemplateBinding Background}">
                        <ContentControl x:Name="Glyph" Content="{DynamicResource IconWindowMinimize}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Content" Value="{DynamicResource IconWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="r">
                            <Setter Property="Content" Value="{DynamicResource IconWindowClose}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" TargetName="Plate" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="r" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" TargetName="Plate" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MainWindowButton" TargetType="Button" BasedOn="{StaticResource WindowBarButton}" />
</ResourceDictionary>
