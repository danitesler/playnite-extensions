<!--
    Last Flame: Play, a torn crimson pennant pointing right (pennant.png, the arrow tabs of the game's camp bar), bone Georgia
    label, chisel ticks in tan. Layers bottom to top: torchlight, plate, hover plate, pressed plate, embers, ticks, label.
    Hover, animated both ways (no setters on animated parts, so nothing snaps):
      in  0.22s: the hotter plate and the torchlight fade in; embers rise through the pennant (one 256px tile in 2.6s) and
          the light flickers on its wrapper while hovered; the ticks spread 3px.
      out 0.35s: everything fades back; every exit animation has FillBehavior Stop, so no clock is left running.
    Press fades in its own dark plate, so leaving while pressed cannot strand the hover state.
    Sprites are white masks filled with theme brushes. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,0,26,0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid x:Name="LightWrap" Margin="-44,-40" IsHitTestVisible="False">
                            <Control x:Name="Light" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0.14" />
                        </Grid>
                        <Rectangle Fill="{TemplateBinding Background}">
                            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/pennant.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle x:Name="HoverPlate" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Opacity="0">
                            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/pennant.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle x:Name="PressedPlate" Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0">
                            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/pennant.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                        </Rectangle>
                        <Grid x:Name="EmberBand" Margin="6,3,18,3" ClipToBounds="True" IsHitTestVisible="False" Opacity="0" Visibility="Hidden">
                            <Canvas>
                                <Rectangle Width="384" Height="512" Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/embers.png'}" TileMode="Tile" Stretch="Fill" Viewport="0,0,128,256" ViewportUnits="Absolute" />
                                    </Rectangle.OpacityMask>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="EmberShift" Y="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Grid>
                        <Control Margin="0,2,16,2" Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource PrimaryButtonBorderBrush}" RenderTransformOrigin="0.5,0.5" x:Name="Ticks">
                            <Control.RenderTransform>
                                <ScaleTransform x:Name="TicksScale" ScaleX="1" ScaleY="1" />
                            </Control.RenderTransform>
                        </Control>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Light" Storyboard.TargetProperty="Opacity" To="0.62" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="EmberBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EmberBand" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="TicksScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TicksScale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="EmberShift" Storyboard.TargetProperty="Y" From="0" To="-256" Duration="0:0:2.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.22">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LightWrap" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="0.74" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="0.96" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.44" Value="0.68" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.70" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.88" Value="0.82" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.10" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Light" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LightWrap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="EmberBand" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="EmberShift" Storyboard.TargetProperty="Y" To="-256" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="TicksScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="TicksScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="EmberBand" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
