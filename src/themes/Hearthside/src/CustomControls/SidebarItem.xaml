<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml. A 44 x 40 cell on the dark wood rail holding a 32 x 32
    plate. At rest: no plate, a 16px glyph in muted cream (SidebarItemForegroundBrush, cream-muted c8b18a). Hover: a
    wood plate (ListItemHoverBrush, wood-mid 5d422a) and cream glyph (TextBrush). Current: the way Hearthstone marks the
    picked deck or the open tab of the Collection Manager, a lit wood plate (SelectedBrush, wood-light 765535) with a
    1px gold edge (SelectedBorderBrush, gold eecd4f), a soft gold glow 3px around it (SidebarItemSelectedGlowBrush at
    35%), and the glyph in bright gold (SidebarItemSelectedForegroundBrush, gold-light fcd237). Plates use
    ControlCornerRadius. Library and Statistics drawn with the Phosphor fill icons (cards, chart-bar).
    PART_ProgressStatus (Playnite shows it while an add-on reports progress) is a 2px mana-blue bar under the plate.
    An item with no content is a bare marker: WarningBrush fill.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="Glow" Width="38" Height="38" Visibility="Collapsed" Opacity="0.35"
                                CornerRadius="{DynamicResource CornerRadiusLarge}"
                                BorderBrush="{DynamicResource SidebarItemSelectedGlowBrush}" BorderThickness="2" />
                        <Border x:Name="Plate" Width="32" Height="32" SnapsToDevicePixels="True"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" />
                        <Border Padding="14,12">
                            <Border Padding="{Binding IconPadding}">
                                <Viewbox x:Name="ItemIcon">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Viewbox>
                            </Border>
                        </Border>
                        <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                        IsHitTestVisible="False" Width="16" Height="16"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ContentTemplate="{DynamicResource IconTemplate}" />
                        <ProgressBar x:Name="PART_ProgressStatus" Height="2" Margin="10,0,10,2"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource ProgressBarForegroundBrush}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ListItemHoverBrush}" TargetName="Plate" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" TargetName="Plate" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" TargetName="Plate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Glow" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Margin" Value="0" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Margin" Value="0" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
