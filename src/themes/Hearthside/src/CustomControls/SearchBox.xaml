<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    The well of TextBox.xaml as a search box, like the Collection Manager's search field: sunken fill
    (InputBackgroundBrush, or the host's Background), 1px brass edge (InputBorderBrush), ControlCornerRadius, top shade,
    34px tall, cream type. A Phosphor search glyph (16px, TextBrushDarker) 10px from the start, the text 8px after it.
    Hover: InputHoverBorderBrush. While typing: a gold edge (FrameHoverBrush). ShowImage="False" (filter panel fields)
    drops the glyph and shifts the text left.
    Chrome is drawn here around a chromeless text box (BareTextBox) so hosts can restyle it through Background and Height.
    Playnite hides PART_SeachIcon while the box has focus or text, so it carries the placeholder ("Search", dim);
    the glyph itself is a separate element that stays. PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon are
    Playnite's parts (all three must exist).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Chrome" SnapsToDevicePixels="True" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <ContentControl x:Name="Glyph" Margin="10,0,0,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                                Foreground="{DynamicResource TextBrushDarker}"
                                                ContentTemplate="{DynamicResource SearchTextIconTemplate}" />
                                <TextBlock x:Name="PART_SeachIcon" Margin="34,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource BaseTextBlockStyle}"
                                           Foreground="{DynamicResource TextBrushDarker}"
                                           Text="{DynamicResource LOCSearchLabel}" />
                                <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                         VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                         Padding="32,0,32,0" />
                                <ContentControl x:Name="PART_ClearTextIcon" Margin="0,0,10,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                                Background="Transparent"
                                                Foreground="{DynamicResource TextBrushDarker}"
                                                ContentTemplate="{DynamicResource ClearTextIconTemplate}" />
                            </Grid>
                        </Border>
                        <Border x:Name="Rule" Height="3" Margin="1,1,1,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.7"
                                Background="{DynamicResource BevelShadowBrush}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" TargetName="Chrome" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Chrome" />
                        </Trigger>
                        <Trigger SourceName="PART_ClearTextIcon" Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="PART_ClearTextIcon" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" TargetName="Chrome" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glyph" />
                            <Setter Property="Padding" Value="8,0,32,0" TargetName="PART_TextInpuText" />
                            <Setter Property="Margin" Value="10,0,0,0" TargetName="PART_SeachIcon" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
