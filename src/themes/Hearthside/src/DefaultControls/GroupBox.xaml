<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml. A panel of the Hearthstone box: the title in gold Belwe
    (HeadingFontFamily, HeadingForegroundBrush gold-light fcd237, GroupBoxHeaderFontSize 18) above a raised wood panel
    (ExpanderBackgroundBrush, wood-panel 3a2516) in a 1px brass ring (NormalBorderBrush, brass-dark) with
    CornerRadiusLarge, and a 1px light line inside its top edge (BevelLightBrush at 12%). Body: GroupBoxPadding (14 / 12).
    A group box without a header draws just the panel.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel Background="{TemplateBinding Background}" LastChildFill="False">
                        <StackPanel x:Name="HeaderPanel" DockPanel.Dock="Top">
                            <TextBlock Style="{DynamicResource BaseTextBlockStyle}" Margin="{DynamicResource GroupBoxHeaderMargin}"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       Foreground="{DynamicResource HeadingForegroundBrush}"
                                       FontSize="{DynamicResource GroupBoxHeaderFontSize}">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                            </TextBlock>
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource ExpanderBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusLarge}">
                            <Grid>
                                <Border Height="1" Margin="8,0,8,0" VerticalAlignment="Top" Opacity="0.12"
                                        Background="{DynamicResource BevelLightBrush}" />
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderPanel" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
