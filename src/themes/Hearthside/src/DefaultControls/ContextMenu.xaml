<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is Hearthstone's Game Menu as a tavern ledger: a grained oak board, a brass cap across
    the top with a faceted gold clasp at its centre, a thin brass foot (LocalMenuBoardTemplate, shared by ComboBox.xaml,
    CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml). The clasp rises 5px above the cap, so
    every host leaves 4px of room above the board and puts its rows 9px below the top. Rows and group rules: Menu.xaml.
    Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Control Template="{DynamicResource LocalWoodGrainTemplate}" Margin="1" Focusable="False" IsTabStop="False" />
            <!-- Brass cap with a faceted gold clasp, and a thinner foot -->
            <Border Height="2" Margin="10,0" VerticalAlignment="Top" Background="{DynamicResource FrameBrush}" />
            <Border Height="1" Margin="10,2,10,0" VerticalAlignment="Top" Background="{DynamicResource FrameInnerBrush}" Opacity="0.8" />
            <Path Width="12" Height="12" Margin="0,-5,0,0" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Data="M 6,0 L 12,6 L 6,12 L 0,6 Z" Fill="{DynamicResource GlyphBrush}"
                  Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1" />
            <Path Width="4" Height="4" Margin="0,-1,0,0" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Data="M 2,0 L 4,2 L 2,4 L 0,2 Z" Fill="{DynamicResource BevelLightBrush}" />
            <Border Height="1" Margin="10,0" VerticalAlignment="Bottom" Background="{DynamicResource FrameBrush}" Opacity="0.7" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" Margin="0,4,0,0" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,9,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="4,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
