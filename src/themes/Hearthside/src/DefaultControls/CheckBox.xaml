<!--
    Overlay on Playnite Default/DefaultControls/CheckBox.xaml.
    Brass-rimmed recessed well: checking springs the gold tick in with a BackEase pop (0.35 -> 1.0)
    and lights the brass rim gold. Hover softly scales the well rim.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Border x:Name="BulletBorder" DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{DynamicResource CheckBoxCheckMarkBkBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="BoxScale" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Grid>
                                    <ContentPresenter x:Name="CheckIcon" Visibility="Collapsed" Width="12" Height="12"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                                      TextElement.Foreground="{DynamicResource BevelLightBrush}"
                                                      Content="{DynamicResource IconCheck}"
                                                      ContentTemplate="{DynamicResource IconTemplate}">
                                        <ContentPresenter.RenderTransform>
                                            <ScaleTransform x:Name="CheckPop" ScaleX="1" ScaleY="1" />
                                        </ContentPresenter.RenderTransform>
                                    </ContentPresenter>
                                    <Border x:Name="IndeterminateIcon" Visibility="Collapsed" Width="10" Height="2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{DynamicResource GlyphBrush}" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="Label" DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="8,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="BulletBorder" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="CbHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BoxScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CbHoverIn" />
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="BoxScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="BoxScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="CbCheckPop">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckPop" Storyboard.TargetProperty="ScaleX" From="0.35" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.55" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CheckPop" Storyboard.TargetProperty="ScaleY" From="0.35" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.55" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CbCheckPop" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
