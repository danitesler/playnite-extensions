<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    Tavern box left oak pillar (44px) with carved woodgrain texture and 3-layer brass molding.
    Main menu button: glowing 32px mana-blue compass medallion with cardinal gold notches & Hearthside flame mark.
    Hover smoothly blooms the arcane halo, springs the medallion (BackEase 1.09), and rotates the compass notches +45 deg.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- Main menu button host (also reused by Views/TopPanel.xaml when the sidebar is hidden). -->
    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid x:Name="Root" Width="44" Margin="{TemplateBinding Padding}">
                        <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" />
                        <Control x:Name="WoodGrain" Template="{DynamicResource LocalWoodGrainTemplate}" IsHitTestVisible="False" />
                        <!-- 3-layer carved brass molding along the content side -->
                        <Border x:Name="EdgeGrain" Width="4" HorizontalAlignment="Right" IsHitTestVisible="False"
                                Background="{DynamicResource FrameInnerBrush}" />
                        <Border x:Name="EdgeBrassDark" Width="2" HorizontalAlignment="Right" IsHitTestVisible="False"
                                Background="{DynamicResource TopPanelSeparatorBrush}" />
                        <Border x:Name="EdgeBrass" Width="1" HorizontalAlignment="Right" IsHitTestVisible="False"
                                Background="{DynamicResource FrameBrush}" Opacity="0.85" />
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                    DockPanel.Dock="Top" Margin="0">
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="MenuOrbScale" ScaleX="1" ScaleY="1" />
                                    </Grid.RenderTransform>
                                    <!-- Arcane mana halo: gently lit at rest, blooms brightly on hover -->
                                    <Rectangle x:Name="MenuHalo" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Fill="{DynamicResource LocalManaGlowBrush}" Opacity="0.34" IsHitTestVisible="False"
                                               OpacityMask="{DynamicResource LocalHearthHaloMaskBrush}" />
                                    <Border Width="32" Height="32" CornerRadius="{DynamicResource CornerRadiusFull}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"
                                            BorderThickness="2">
                                        <Grid>
                                            <!-- Inner mana specular sheen -->
                                            <Border CornerRadius="{DynamicResource CornerRadiusFull}"
                                                    Background="{DynamicResource SliderHoverForegroundBrush}" Opacity="0.34" IsHitTestVisible="False">
                                                <Border.OpacityMask>
                                                    <RadialGradientBrush Center="0.36,0.3" GradientOrigin="0.36,0.3" RadiusX="0.72" RadiusY="0.72">
                                                        <GradientStop Color="#FF000000" Offset="0" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Border.OpacityMask>
                                            </Border>
                                            <ContentPresenter Width="15" Height="15"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Content="{DynamicResource LocalIconHearthMark}"
                                                              ContentTemplate="{DynamicResource IconTemplate}" />
                                        </Grid>
                                    </Border>
                                    <!-- Rotating 4-point cardinal gold compass notches -->
                                    <Grid Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="CompassRotate" Angle="0" />
                                        </Grid.RenderTransform>
                                        <Path Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Top"
                                              Stretch="Fill" Data="M 3,0 L 6,3 L 3,6 L 0,3 Z"
                                              Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.8" />
                                        <Path Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                              Stretch="Fill" Data="M 3,0 L 6,3 L 3,6 L 0,3 Z"
                                              Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.8" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" Margin="0,0,0,10" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Main Menu Compass Medallion hover animation (ControlTemplate-scoped, 100% WPF-safe) -->
                        <Trigger SourceName="PART_ElemMainMenu" Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="MenuMedallionIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MenuHalo" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="MenuOrbScale" Storyboard.TargetProperty="ScaleX" To="1.09" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="MenuOrbScale" Storyboard.TargetProperty="ScaleY" To="1.09" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CompassRotate" Storyboard.TargetProperty="Angle" To="45" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="MenuMedallionIn" />
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="MenuHalo" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="MenuOrbScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="MenuOrbScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CompassRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Window art on: rail turns see-through so Views/Library.xaml shows unobstructed window art -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="WoodGrain" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Left">
                            <Setter Property="Height" Value="56" TargetName="PART_ElemMainMenu" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemMainMenu}" Value="Collapsed">
                            <Setter Property="Margin" Value="0,56,0,0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,56,0,0" />
                            <Setter Property="Margin" Value="0" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeGrain" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeBrassDark" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeBrass" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Width" Value="Auto" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeGrain" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeBrassDark" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeBrass" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,160,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,4,0,4" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="4,4,4,4" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Width" Value="Auto" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeGrain" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeBrassDark" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeBrass" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,4,0,4" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="4,4,4,4" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
