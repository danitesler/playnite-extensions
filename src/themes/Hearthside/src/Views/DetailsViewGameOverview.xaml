<Grid x:Name="DetailsMainColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="MaxWidth"><Setter.Value><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="z == true ? x : Max(0, x - y - 24)"><Binding Path="ActualWidth" ElementName="DetailsOverviewBody" /><Binding Path="ActualWidth" ElementName="DetailsMetadataColumn" /><Binding Path="Tag" ElementName="DetailsOverviewBody" /></MultiBinding></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="1" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="1" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="1" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<StackPanel>
                                        <!-- Steam Screenshots add-on: its host control, and a skeleton while it loads. The bindings use FallbackValue=PluginUnavailable
                                             (not False): with the add-on missing or disabled neither the section nor the skeleton shows. The add-on hides its
                                             control and clears IsControlVisible on every game change and needs about a second, so a Steam library game shows the
                                             section (skeleton) in that gap, for at most 12 s. -->
                                        <Grid x:Name="SteamScreenshotsGameScope">
                                            <!-- Plugin visibility is shared: a late Steam load must never reveal a different game's section. -->
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.Source.Name}" Value="Steam">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                                <StackPanel>
                                                    <StackPanel Margin="0,0,0,14">
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" />
    <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource FrameBrush}" Margin="0,6,0,0" Focusable="False" IsTabStop="False" />
</StackPanel>
                                                    <Grid>
                                                        <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                        <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}"
                                                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                            <Control.Style>
                                                                <Style TargetType="Control">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Control.Style>
                                                        </Control>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        </Grid>
                                        <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemDescription}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel x:Name="PART_ElemDescription">
                                                <StackPanel Margin="0,0,0,14">
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCGameDescriptionTitle}" />
    <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource FrameBrush}" Margin="0,6,0,0" Focusable="False" IsTabStop="False" />
</StackPanel>
                                                <HtmlTextView x:Name="PART_HtmlDescription"
                                                              TextElement.Foreground="{DynamicResource TextBrush}"
                                                              Tag="{DynamicResource GlyphBrush}"
                                                              HtmlFontSize="{DynamicResource FontSize}"
                                                              HtmlFontFamily="{DynamicResource FontFamily}"
                                                              HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                              LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                              pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemNotes}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel x:Name="PART_ElemNotes">
                                                <StackPanel Margin="0,0,0,14">
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCNotesLabel}" />
    <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource FrameBrush}" Margin="0,6,0,0" Focusable="False" IsTabStop="False" />
</StackPanel>
                                                <TextBox x:Name="PART_TextNotes" Style="{DynamicResource BareTextBox}" IsReadOnly="True"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Padding="0" BorderThickness="0"
                                                         Foreground="{DynamicResource TextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
</Grid>
</Grid>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                        </Grid>
                        <Control Template="{DynamicResource EmptyGameTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Control.Style>
                                <Style TargetType="Control">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <Trigger Property="DataContext" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Control.Style>
                        </Control>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
