<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details view, right pane).
    Hearthstone's Collection Manager and deck pages: the planks of the page (ContentBackgroundBrush), the game's art as
    a banner under warm tavern light (the art, then the page wood ArtTintBrush at 35%, faded out downward by the mask
    and darkened toward the title by a page-colored scrim), the title in Belwe (HeadingFontFamily) in cream with a 2px
    black drop under it (TextOutlineBrush, the game's outlined lettering), then the actions: Play as the End Turn button
    (PlayButton: yellow, dark ink, green glow on hover), the context action and More as wood plates (Button.xaml), Edit a
    40px wood plate shown while the pointer is over the header. Steam screenshots host and skeleton, then two columns:
    description and notes on the left under gold Belwe headings (HeadingTextBlock) with an ornamented brass rule
    (DividerTemplate: a 1px line ending in a small diamond gem, FrameBrush), and the metadata pane on the right as a
    raised wood panel (ExpanderBackgroundBrush, wood-panel 3a2516) in the brass trim ring (FrameBrush, FrameThickness
    2px, CornerRadiusLarge, 16 / 14 padding): the same heading and rule, then every field Playnite can show in six
    groups (progress, scores, about, tags, library, links) split by a 1px dark brass rule (WindowPanelSeparatorBrush,
    brass-deep 73471c); a group whose fields are all hidden collapses with its rule.
    Captions are FontSizeSmall muted cream in a 112px column beside the value; values are cream body text, text links
    (PropertyItemButton) or small wood tokens (chips).
    Every PART_ of Playnite's file is kept, each once. HtmlTextView takes Color-typed properties: the brushes are set on
    TextElement.Foreground and Tag and the Colors are bound from them (the one place theme XAML reads a Color).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Placeholder for the Steam Screenshots control: a 16:9 main image over a row of five thumbnails, rounded, in the host's
         Foreground at 15 percent, pulsing. Each Viewbox scales a 1600px layout to the width its column gives it. Host: a
         Control with Foreground set and hit testing off, in a Grid next to the add-on's ContentControl. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="20"
                        Background="{TemplateBinding Foreground}" Opacity="0.15" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="2" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="4" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="6" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="8" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Control Template="{DynamicResource LocalWoodGrainTemplate}" IsHitTestVisible="False">
                            <Control.Style>
                                <Style TargetType="Control">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Control.Style>
                        </Control>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="DataContext" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible"
                                  Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible"
                                  d:DesignWidth="1280" d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Grid>
                            <!-- Banner: the game's background art as a band of GameBannerHeight (0 turns it off), under a wood wash (ArtTintBrush). Faded out downward by the mask, darkened
                                 toward the title by a page-colored scrim, and cached because it is masked. Collapsed when the game has no background
                                 art or Playnite hides the image. -->
                            <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.CacheMode>
                                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                </Grid.CacheMode>
                                <Grid>
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="Black" Offset="0.25" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                    <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <Border Background="{DynamicResource ArtTintBrush}" Opacity="0.35" />
                                    <Border Background="{DynamicResource ContentBackgroundBrush}" Opacity="0.75">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Transparent" Offset="0.1" />
                                                <GradientStop Color="Black" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                </Grid>
                            </Grid>
                            <Grid HorizontalAlignment="Stretch" MaxWidth="1280" Margin="32,0,32,32">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Room above the title: the title sits low on the banner; the spacer shrinks when there is no banner. -->
                                <Border Grid.Row="0" IsHitTestVisible="False" x:Name="DetailsBannerSpacer" MinHeight="32">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 110 / 340'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                            <Setter Property="Height" Value="32" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="32" />
</DataTrigger>
</Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="0,0,0,24" Background="Transparent">
                                    <!-- Collectible card cover frame: burnished gold rim + 4 brass corner clasps -->
                                    <Grid DockPanel.Dock="Right" Margin="24,0,0,0" VerticalAlignment="Bottom">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageCover}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageCover}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border Background="{DynamicResource FrameBrush}" BorderBrush="{DynamicResource FrameInnerBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="3">
                                            <Border x:Name="CoverFrame" CornerRadius="5" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1">
                                                <Border.CacheMode>
                                                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                                </Border.CacheMode>
                                                <Border.OpacityMask>
                                                    <VisualBrush Visual="{Binding ElementName=CoverShape}" />
                                                </Border.OpacityMask>
                                                <Grid>
                                                    <Border x:Name="CoverShape" Background="{DynamicResource ExpanderBackgroundBrush}"
                                                            CornerRadius="5" />
                                                    <Image x:Name="PART_ImageCover"
                                                           Height="{Settings GameDetailsCoverHeight}"
                                                           StretchDirection="Both" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="Fant" />
                                                </Grid>
                                            </Border>
                                        </Border>
                                        <Control Margin="-2" Template="{DynamicResource LocalCornerClaspsTemplate}"
                                                 Foreground="{DynamicResource BevelLightBrush}" IsHitTestVisible="False" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <DockPanel>
                                            <Image x:Name="PART_ImageIcon" MaxHeight="40" MaxWidth="40" DockPanel.Dock="Left" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" Margin="2,2,0,0" IsHitTestVisible="False"
                                                           FontSize="{DynamicResource FontSizeLargest}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextOutlineBrush}" Opacity="0.85" />
                                                <TextBlock x:Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLargest}" Margin="0,0,2,2"
                                                           FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                            </Grid>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" Height="42" MinWidth="156" />
                                                <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" Height="42" MinWidth="156" />
                                                <Control Style="{DynamicResource RunningActionIndicator}" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Width="42" Height="42" Padding="0" Margin="10,0,0,0"
                                                    ToolTip="{DynamicResource LOCMoreAction}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                                                    Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Width="42" Height="42" Padding="0" Margin="10,0,0,0" Focusable="False"
                                                    VerticalAlignment="Center" ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Grid.Row="2" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
<Grid Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                        <!-- Crimson wax-ribbon bookmark tab tucked beside top-right of the iron nameplate -->
                                        <Grid Panel.ZIndex="4" Width="20" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Margin="0,-10,14,0" IsHitTestVisible="False">
                                            <Path Stretch="Fill" Data="M 0,0 L 20,0 L 20,32 L 10,25 L 0,32 Z"
                                                  Fill="{DynamicResource DangerBrush}" Stroke="{DynamicResource SelectedBorderBrush}" StrokeThickness="1" />
                                            <Path Width="6" Height="6" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="Fill"
                                                  Data="M 3,0 L 6,3 L 3,6 L 0,3 Z" Fill="{DynamicResource BevelLightBrush}" />
                                        </Grid>
                                        <Border x:Name="DetailsPanel" VerticalAlignment="Top"
                                                Background="{DynamicResource ParchmentBrush}" BorderBrush="{DynamicResource FrameBrush}"
                                                BorderThickness="{DynamicResource FrameThickness}" CornerRadius="8">
                                            <Border.Resources>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource ParchmentTextBrush}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="Tag" Value="Caption">
                                                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource ParchmentLabelBrush}" />
                                                            <Setter Property="TextWrapping" Value="Wrap" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                            </Border.Resources>
                                            <Grid>
                                                <Control Template="{DynamicResource LocalParchmentGrainTemplate}" IsHitTestVisible="False" />
                                                <Border CornerRadius="6" BorderBrush="{DynamicResource ParchmentEdgeBrush}" BorderThickness="4"
                                                        Opacity="0.32" IsHitTestVisible="False" />
                                                <Control Margin="-2" Template="{DynamicResource LocalBottomCornerClaspsTemplate}"
                                                         Foreground="{DynamicResource FrameBrush}" IsHitTestVisible="False" />
                                                <StackPanel Margin="16,0,16,14" Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch" x:Name="DetailsMetadataContent">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                    <!-- Riveted Wrought-Iron & Gold Nameplate Header (Hearthstone Card Crafting / Options) -->
                                                    <Border Height="34" Margin="4,-14,26,12" Background="{DynamicResource LocalIronBrush}"
                                                            BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1.5" CornerRadius="5">
                                                        <Grid>
                                                            <Border CornerRadius="4" Background="{DynamicResource LocalIronDarkBrush}" Opacity="0.58" IsHitTestVisible="False">
                                                                <Border.OpacityMask>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#00000000" Offset="0.35" />
                                                                        <GradientStop Color="#FF000000" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.OpacityMask>
                                                            </Border>
                                                            <Border Height="1" Margin="4,0,4,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                                                    Background="{DynamicResource LocalIronEdgeBrush}" Opacity="0.75" />
                                                            <Ellipse Width="6" Height="6" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                     IsHitTestVisible="False" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1" />
                                                            <Ellipse Width="6" Height="6" Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                     IsHitTestVisible="False" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1" />
                                                            <TextBlock Text="{DynamicResource LOCGameDetails}" Margin="22,0,22,0"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLarge}"
                                                                       Foreground="{DynamicResource HeadingForegroundBrush}" />
