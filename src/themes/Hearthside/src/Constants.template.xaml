<!--
    Hearthside: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    The Hearthstone interface: dark tavern wood (wood 2e1d10, panels 3a2516) framed in brass (brass c8973d), gold for
    whatever is current or checked (gold f1c650), cream lettering outlined in black on wood (cream f5e7c8), parchment
    for tooltips and cards (parchment ecd9ae, ink 2f1d0e), and the game's signal colors: the End Turn yellow for Play
    (endturn f6c63b), the playable green as its glow, mana blue for progress and slider gems, health red for danger.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). Placeholder syntax: see reference.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): body 14, card names 16, panel titles 22, the hero title 32. -->
    <sys:Double x:Key="FontSizeSmall">{{px:hs-text-sm}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:hs-text-md}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:hs-text-lg}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:hs-text-xl}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:hs-text-2xl}}</sys:Double>
    <!-- Body: Franklin Gothic, the game's text face, which Windows ships (Medium and Book); Segoe UI after it.
         Titles: Belwe Bold (Bitstream, commercial, not shipped) when installed, else Georgia, which Windows has. -->
    <FontFamily x:Key="FontFamily">Franklin Gothic Medium, Franklin Gothic Book, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Belwe Bd BT, Belwe, Belwe Lt BT, Georgia</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys): rounded plates with a 1px brass edge, a 2px trim ring on frames. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:hs-radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <CornerRadius x:Key="CornerRadiusSmall">{{px:hs-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:hs-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:hs-radius-xl}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="FrameThickness">{{px:hs-trim}}</Thickness>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor (checked, links, the current tab) is the gold of the box's lettering. TextColorDark, the text on a
        GlyphColor fill, is the dark ink of the End Turn button. MainColor is a resting wood button.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{hs-cream}}</Color>
    <Color x:Key="TextColorDarker">{{hs-cream-muted}}</Color>
    <Color x:Key="TextColorDark">{{hs-endturn-ink}}</Color>
    <Color x:Key="MainColor">{{hs-wood-mid}}</Color>
    <Color x:Key="MainColorDark">{{hs-wood-panel}}</Color>
    <Color x:Key="HoverColor">{{hs-wood-mid}}</Color>
    <Color x:Key="GlyphColor">{{hs-gold}}</Color>
    <Color x:Key="HighlightGlyphColor">{{hs-gold/35}}</Color>
    <Color x:Key="PopupBackgroundColor">{{hs-wood-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{hs-brass-dark}}</Color>
    <Color x:Key="BackgroundToneColor">{{hs-wood-deep}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{hs-brass-deep}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{hs-brass-deep}}</Color>
    <Color x:Key="DataChangeNotifColor">{{hs-legendary}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{hs-brass-dark}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{hs-parchment}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{hs-wood-mid}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{hs-wood-pressed}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{hs-playable}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{hs-health}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{hs-endturn}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{hs-legendary}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{hs-wood-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{hs-wood-night}}" />

    <!-- Shell: the box's dark rim around the planks of the page -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{hs-wood-deep}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{hs-wood}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{hs-wood-deep}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{hs-wood-pressed}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{hs-wood-grain}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{hs-brass-dark}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{hs-mana-dark}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{hs-cream}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{hs-cream-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{hs-gold-light}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{hs-gold}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{hs-wood-grain}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{hs-wood}}" />

    <!-- States: a lit wood plate with a gold edge marks the current item; hover is lighter wood -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{hs-wood-light}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{hs-wood-light}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{hs-gold}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{hs-gold-light}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{hs-wood-mid}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{hs-wood-light}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{hs-wood-light}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{hs-playable}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{hs-health}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{hs-cream}}" />

    <!-- Buttons: wood plates on a brass edge, cream type; Play is the End Turn button (yellow, dark ink, green glow) -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{hs-cream}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{hs-brass-dark}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{hs-wood-light}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{hs-wood-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{hs-endturn}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{hs-brass-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{hs-endturn-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{hs-endturn-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{hs-endturn-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{hs-playable}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{hs-wood-light}}" />

    <!-- Inputs: a sunken well cut into the wood, brass edge, gold when focused -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{hs-wood-pressed}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{hs-wood-grain}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{hs-brass-dark}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{hs-brass}}" />

    <!-- Controls: brass boxes with a gold check; mana crystal slider and progress; a brass scroll thumb -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{hs-brass-dark}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{hs-gold}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{hs-wood-pressed}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{hs-mana}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{hs-mana-light}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{hs-mana-light}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{hs-mana}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{hs-wood-pressed}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{hs-brass-dark}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{hs-brass}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{hs-wood-deep}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{hs-brass-dark}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{hs-brass}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{hs-gold}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{hs-brass-dark}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{hs-brass}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{hs-gold-light}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{hs-wood-mid}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{hs-wood-light}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{hs-wood-mid}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{hs-cream}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{hs-wood-light}}" />

    <!-- Popups: wood menus with a brass edge; tooltips are parchment cards -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{hs-brass-deep}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{hs-ink}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{hs-parchment-edge}}" />

    <!-- Frames: the brass trim ring and its dark inner line; bevel light and shade on wood plates -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{hs-brass}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{hs-wood-grain}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{hs-gold}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{hs-gold-light}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{hs-wood-grain}}" />

    <!-- Paper: parchment cards and scrolls -->
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{hs-parchment}}" />
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{hs-parchment-edge}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{hs-ink}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{hs-ink-title}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{hs-ink-label}}" />

    <!-- Headings: gold Belwe lettering with the game's black outline -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{hs-gold-light}}" />
    <SolidColorBrush x:Key="TextOutlineBrush" Color="{{hs-outline}}" />
</ResourceDictionary>
