<!--
    Overlay on Playnite Default/Common.xaml. Spacing and focus of the Hearthstone interface, read at desktop size: wood
    plates with roomy padding (the Collection Manager's buttons and the deck list's tiles are about 36 to 40px tall at
    1080p), parchment tooltips with a generous margin around the text, and panels framed by a brass trim ring.
    Each key turns a target height into padding around 14px Franklin Gothic (about 18px tall): 36 = 18 + 2 x 8 + 2px edge.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: a wood panel (PopupBackgroundBrush, wood-panel 3a2516) on a 1px brass edge,
             medium radius. WPF popups are layered windows: no glow, no shadow. -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: the playable glow. Hearthstone rings whatever you can act on now in green; here that ring is a
         2px green line (FocusBrush, playable 29dd4f) 3px outside the control, with a softer 1px halo around it. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-4" SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1" Opacity="0.35"
                                CornerRadius="{DynamicResource CornerRadiusLarge}" />
                        <Border Margin="1" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2"
                                CornerRadius="{DynamicResource CornerRadiusLarge}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: a wood plate, 36 tall, 18 inline -->
    <Thickness x:Key="ButtonPadding">18,8</Thickness>
    <!-- Text box, password box, dropdown: a sunken well, 34 tall, 10 inline -->
    <Thickness x:Key="InputPadding">10,7</Thickness>
    <!-- Menu: a wood panel, 6px around rows 32 tall -->
    <Thickness x:Key="MenuPadding">6</Thickness>
    <Thickness x:Key="MenuItemPadding">10,7,18,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">6</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,7,18,7</Thickness>
    <!-- List box row: a deck list tile, 32 tall -->
    <Thickness x:Key="ListBoxItemPadding">10,7</Thickness>
    <!-- Group box: a wood panel in a brass ring, Belwe title above it -->
    <Thickness x:Key="GroupBoxPadding">14,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">2,0,0,8</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">18</sys:Double>
    <!-- Tooltip: a parchment card, 12 / 8 -->
    <Thickness x:Key="TooltipPadding">12,8</Thickness>
    <!-- Glyphs at 18px -->
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">320</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">270</sys:Double>
</ResourceDictionary>
