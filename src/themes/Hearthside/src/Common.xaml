<!--
    Overlay on Playnite Default/Common.xaml.
    Hearthside spacing, focus, shared white-mask FX brushes (Images/fx/*.png), and reusable Hearthstone chrome templates:
    woodgrain planks, vellum parchment texture, 9-slice arcane/playable glow aura, 4-corner riveted brass clasps,
    Collection Manager flourished brass dividers, brand compass medallion, and Tavern Hearth empty state.
    All FX masks are shared ImageBrush resources so controls never allocate per-instance brushes, and no template
    reports a desired width >= 200 (safe inside Statistics GroupBoxes).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: the playable emerald ring -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-4" SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1" Opacity="0.35"
                                CornerRadius="{DynamicResource CornerRadiusLarge}" />
                        <Border Margin="1" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2"
                                CornerRadius="{DynamicResource CornerRadiusLarge}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Spacing & Form Rhythm (ControlHeight = 32; vertical padding = 5) -->
    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">6</Thickness>
    <Thickness x:Key="MenuItemPadding">10,7,18,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">6</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,7,18,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,7</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">2,0,0,8</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">18</sys:Double>
    <Thickness x:Key="TooltipPadding">12,8</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shared white-mask FX brushes (pure white + alpha; recolored automatically by ThemeModifier) -->
    <ImageBrush x:Key="LocalWoodGrainMaskBrush" ImageSource="{ThemeFile 'Images/fx/wood-grain.png'}"
                TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalParchmentGrainMaskBrush" ImageSource="{ThemeFile 'Images/fx/parchment-grain.png'}"
                TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalCornerClaspMaskBrush" ImageSource="{ThemeFile 'Images/fx/corner-clasp.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalHearthHaloMaskBrush" ImageSource="{ThemeFile 'Images/fx/hearth-halo.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalMetalSheenMaskBrush" ImageSource="{ThemeFile 'Images/fx/metal-sheen.png'}" Stretch="Fill" />

    <!-- Shared 9-slice glow-frame masks (128x128 DIP, slice 44+40+44) -->
    <ImageBrush x:Key="LocalGlowTL" ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlowTC" ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlowTR" ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlowML" ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlowMC" ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,44,40,40" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlowMR" ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlowBL" ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlowBC" ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,84,40,44" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlowBR" ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" />

    <!-- Carved oak woodgrain overlay (subtle carved depth + faint lantern highlight) -->
    <ControlTemplate x:Key="LocalWoodGrainTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Rectangle Fill="{DynamicResource BevelShadowBrush}" Opacity="0.24" OpacityMask="{StaticResource LocalWoodGrainMaskBrush}" />
            <Rectangle Fill="{DynamicResource BevelLightBrush}" Opacity="0.035" OpacityMask="{StaticResource LocalWoodGrainMaskBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Aged vellum paper fiber overlay for parchment folio & tooltips -->
    <ControlTemplate x:Key="LocalParchmentGrainTemplate" TargetType="Control">
        <Rectangle Fill="{DynamicResource ParchmentEdgeBrush}" Opacity="0.24" IsHitTestVisible="False"
                   OpacityMask="{StaticResource LocalParchmentGrainMaskBrush}" />
    </ControlTemplate>

    <!-- 9-slice silky outer bloom (Playable emerald on Play hover, warm gold on selected cards/rail). Host Foreground = glow brush. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowTL}" />
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowTC}" />
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowTR}" />
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowML}" />
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowMC}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowMR}" />
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowBL}" />
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowBC}" />
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowBR}" />
        </Grid>
    </ControlTemplate>

    <!-- Hugging 9-slice bloom: corner cells are 32px so the sprite's bright ring (at 50% of corner cell) sits 16px inside
         the outer edge. At Margin="-15" on a button (or "-19" around a -4 SelectionBorder), the ring tucks 1px under the
         gold rim with zero gap and blooms 15px outward (Hearthstone's hovered gold buttons & cards). Host Foreground = glow brush. -->
    <ControlTemplate x:Key="LocalBloomFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowTL}" />
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowTC}" />
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowTR}" />
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowML}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowMR}" />
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowBL}" />
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowBC}" />
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalGlowBR}" />
        </Grid>
    </ControlTemplate>

    <!-- 4-corner riveted brass clasps (Images/fx/corner-clasp.png mirrored 4 ways). Host Foreground = brass/gold brush. -->
    <ControlTemplate x:Key="LocalCornerClaspsTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Rectangle Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalCornerClaspMaskBrush}" />
            <Rectangle Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalCornerClaspMaskBrush}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="1" /></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalCornerClaspMaskBrush}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="1" ScaleY="-1" /></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalCornerClaspMaskBrush}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Bottom-only 2-corner brass clasps (for Metadata Parchment Folio crowned by the top iron nameplate) -->
    <ControlTemplate x:Key="LocalBottomCornerClaspsTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Rectangle Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalCornerClaspMaskBrush}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="1" ScaleY="-1" /></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Fill="{TemplateBinding Foreground}" OpacityMask="{StaticResource LocalCornerClaspMaskBrush}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Collection Manager flourished brass divider: faceted left diamond + accent pip + tapered brass rule. Compact width (safe in GroupBox). -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="{x:Type Control}">
        <Grid Height="9" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Height="1" Margin="16,0,0,0" VerticalAlignment="Center" Background="{TemplateBinding Foreground}" Opacity="0.85" />
            <Path Width="9" Height="9" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Data="M 4.5,0 L 9,4.5 L 4.5,9 L 0,4.5 Z"
                  Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.8" />
            <Path Width="4" Height="4" Margin="11,0,0,0" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Data="M 2,0 L 4,2 L 2,4 L 0,2 Z"
                  Fill="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- Section heading: gold Belwe lettering -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Empty game page state: Tavern Hearth compass medallion with gentle mana breathing halo + Belwe prompt -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="32">
            <Grid Width="88" Height="88" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="EmptyDrift" Y="0" />
                </Grid.RenderTransform>
                <Rectangle x:Name="EmptyHalo" Width="88" Height="88" Fill="{DynamicResource LocalManaGlowBrush}" Opacity="0.32"
                           OpacityMask="{StaticResource LocalHearthHaloMaskBrush}" />
                <Border Width="54" Height="54" CornerRadius="{DynamicResource CornerRadiusFull}"
                        Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource FrameBrush}" BorderThickness="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Border CornerRadius="{DynamicResource CornerRadiusFull}" Background="{DynamicResource SliderHoverForegroundBrush}" Opacity="0.22">
                            <Border.OpacityMask>
                                <RadialGradientBrush Center="0.35,0.3" GradientOrigin="0.35,0.3" RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Color="#FF000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <ContentControl Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        TextElement.Foreground="{DynamicResource BevelLightBrush}"
                                        Content="{DynamicResource LocalIconHearthMark}" ContentTemplate="{DynamicResource IconTemplate}" />
                    </Grid>
                </Border>
                <!-- 4 cardinal gold compass notches -->
                <Path Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,13,0,0" Stretch="Fill"
                      Data="M 3.5,0 L 7,3.5 L 3.5,7 L 0,3.5 Z" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.8" />
                <Path Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,13" Stretch="Fill"
                      Data="M 3.5,0 L 7,3.5 L 3.5,7 L 0,3.5 Z" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.8" />
                <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" Stretch="Fill"
                      Data="M 3.5,0 L 7,3.5 L 3.5,7 L 0,3.5 Z" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.8" />
                <Path Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" Stretch="Fill"
                      Data="M 3.5,0 L 7,3.5 L 3.5,7 L 0,3.5 Z" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.8" />
            </Grid>
            <Control Width="140" Template="{StaticResource DividerTemplate}" Foreground="{DynamicResource FrameBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                       Foreground="{DynamicResource TextBrushDarker}" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyHearthBreath">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="EmptyHalo" Storyboard.TargetProperty="Opacity"
                                             From="0.24" To="0.58" Duration="0:0:1.8">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyDrift" Storyboard.TargetProperty="Y"
                                             From="0" To="-4" Duration="0:0:1.8">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyHearthBreath" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- menu-mark begin LocalHearthsideMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu, set into the mana medallion): a faceted mana crystal. Hover (IsMouseOver): a skewed glint sweeps across the gem (clipped to its outline, 0.5s cubic in-out) while the medallion blooms. Open (ContextMenu.IsOpen of the second Border above the control, the PART_ElemMainMenu border; the medallion is the nearest one): the gem lights from within, a mana glow that breathes (1.1s, auto-reversed) until the menu closes; exits restore every property. -->
    <ControlTemplate x:Key="LocalHearthsideMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="16" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Path Data="M8,0.8 L14,6 L8,17.2 L2,6Z" Fill="{TemplateBinding Foreground}" Opacity="0.18" />
                <Path x:Name="Glow" Data="M8,0.8 L14,6 L8,17.2 L2,6Z" Fill="{DynamicResource GlyphBrush}" Opacity="0" />
                <Canvas x:Name="GlintClip" Width="16" Height="18" Clip="M8,0.8 L14,6 L8,17.2 L2,6Z">
                    <Rectangle x:Name="Glint" Canvas.Left="-6" Canvas.Top="-2" Width="4" Height="24" Fill="{TemplateBinding Foreground}" Opacity="0.85">
                        <Rectangle.RenderTransform><TransformGroup><SkewTransform AngleX="-20" /><TranslateTransform x:Name="GlintT" X="0" Y="0" /></TransformGroup></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
                <Path Data="M8,0.8 L14,6 L8,17.2 L2,6Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" StrokeLineJoin="Round" />
                <Path Data="M2,6 H14 M8,0.8 L5.6,6 L8,17.2 M8,0.8 L10.4,6 L8,17.2" Stroke="{TemplateBinding Foreground}" StrokeThickness="0.9" Opacity="0.7" />
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="GlintT" Storyboard.TargetProperty="X" To="26" Duration="0:0:0.500"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GlintT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.400" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}, AncestorLevel=2}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.2" To="0.6" Duration="0:0:1.100" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.880" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalHearthsideMenuMarkTemplate -->
</ResourceDictionary>
