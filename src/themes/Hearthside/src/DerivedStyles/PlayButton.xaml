<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml: the Play / Install button on the game page, as
    Hearthstone's End Turn button: a yellow plate (PrimaryButtonBackgroundBrush, endturn f5c518) on a 1px dark brass edge
    (PrimaryButtonBorderBrush), ControlCornerRadius, a light line inside its top edge and a shade toward its base
    (BevelLightBrush 45%, BevelShadowBrush 30%), dark ink (PrimaryButtonForegroundBrush, endturn-ink 3a2208) in Belwe
    (HeadingFontFamily) at FontSizeLarge, ButtonPadding, at least 40 tall. Hover: the plate brightens
    (PrimaryButtonHoverBackgroundBrush) and the playable glow rings it, 2px of green (PrimaryButtonGlowBrush, playable
    29dd4f) 3px outside plus a softer 1px halo, the way the game lights End Turn green when you are out of moves.
    Pressed: the dark gold (PrimaryButtonPressedBackgroundBrush), no bevel light. Keyboard focus: FocusVisual.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite
        swaps End Turn for the context action (RUNNING); a mana-blue hairline rims the plate and a 3px mana bar lies along
        its foot, breathing (3.2s). Launching pulses like crystals refilling (0.8s).
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching).
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.5">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.24" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.12" />
                                    <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Border x:Name="RunningFrame" CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" />
                        <StackPanel Margin="0,0,0,3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal">
                            <Path x:Name="RunningGem1" Width="6" Height="8" Margin="0" Stretch="Fill" Data="M5,0 L10,6 L5,12 L0,6 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                            <Path x:Name="RunningGem2" Width="6" Height="8" Margin="2,0,0,0" Stretch="Fill" Data="M5,0 L10,6 L5,12 L0,6 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                            <Path x:Name="RunningGem3" Width="6" Height="8" Margin="2,0,0,0" Stretch="Fill" Data="M5,0 L10,6 L5,12 L0,6 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                            <Path x:Name="RunningGem4" Width="6" Height="8" Margin="2,0,0,0" Stretch="Fill" Data="M5,0 L10,6 L5,12 L0,6 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                            <Path x:Name="RunningGem5" Width="6" Height="8" Margin="2,0,0,0" Stretch="Fill" Data="M5,0 L10,6 L5,12 L0,6 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.24" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.12" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1.12" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.12" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1.24" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.24" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.53" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.68" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.71" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.86" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem4" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.89" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.04" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem5" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.07" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.22" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem4" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem5" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Border x:Name="Halo" Margin="-5" Opacity="0.35" Visibility="Hidden" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource PrimaryButtonGlowBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusLarge}" />
                        <Border x:Name="Glow" Margin="-4" Visibility="Hidden" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource PrimaryButtonGlowBrush}" BorderThickness="2"
                                CornerRadius="{DynamicResource CornerRadiusLarge}" />
                        <Border x:Name="Chrome" SnapsToDevicePixels="True" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"><Grid><Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.4" IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.24" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.12" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningHoverDim" Background="{DynamicResource ScrimBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <Grid>
                                <Border Background="{DynamicResource BevelShadowBrush}" Opacity="0.3"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.4" />
                                            <GradientStop Color="#FF000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Border x:Name="Light" Height="1" Margin="3,0,3,0" VerticalAlignment="Top"
                                        Background="{DynamicResource BevelLightBrush}" Opacity="0.45" />
                                <ContentPresenter x:Name="PlayContent" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter Property="Opacity" Value="0.12" TargetName="RunningBreath" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.24" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.12" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1.12" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.12" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1.24" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.24" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">

                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" From="0" To="0.2" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                            <Setter TargetName="Light" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
        
            <!-- LAUNCHING and RUNNING come last, so the plate stays the running colour under the pointer. -->
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WindowBackgourndBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WindowBackgourndBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
