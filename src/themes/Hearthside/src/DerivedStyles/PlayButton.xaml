<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml: the Play / Install button on the game page, as
    Hearthstone's End Turn button: a yellow plate (PrimaryButtonBackgroundBrush, endturn f5c518) on a 1px dark brass edge
    (PrimaryButtonBorderBrush), ControlCornerRadius, a light line inside its top edge and a shade toward its base
    (BevelLightBrush 45%, BevelShadowBrush 30%), dark ink (PrimaryButtonForegroundBrush, endturn-ink 3a2208) in Belwe
    (HeadingFontFamily) at FontSizeLarge, ButtonPadding, at least 40 tall. Hover: the plate brightens
    (PrimaryButtonHoverBackgroundBrush) and the playable glow rings it, 2px of green (PrimaryButtonGlowBrush, playable
    29dd4f) 3px outside plus a softer 1px halo, the way the game lights End Turn green when you are out of moves.
    Pressed: the dark gold (PrimaryButtonPressedBackgroundBrush), no bevel light. Keyboard focus: FocusVisual.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Border x:Name="Halo" Margin="-5" Opacity="0.35" Visibility="Hidden" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource PrimaryButtonGlowBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusLarge}" />
                        <Border x:Name="Glow" Margin="-4" Visibility="Hidden" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource PrimaryButtonGlowBrush}" BorderThickness="2"
                                CornerRadius="{DynamicResource CornerRadiusLarge}" />
                        <Border x:Name="Chrome" SnapsToDevicePixels="True" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Border Background="{DynamicResource BevelShadowBrush}" Opacity="0.3"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.4" />
                                            <GradientStop Color="#FF000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Border x:Name="Light" Height="1" Margin="3,0,3,0" VerticalAlignment="Top"
                                        Background="{DynamicResource BevelLightBrush}" Opacity="0.45" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                            <Setter TargetName="Light" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
