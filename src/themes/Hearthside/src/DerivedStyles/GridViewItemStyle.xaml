<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml: the frame around a cover tile in the grid view.
    Hearthstone marks the card you have picked up with a glow; here a selected tile gets a gold frame
    (GridViewItemSelectedBorderBrush, gold-light fcd237, FrameThickness 2px) 4px outside the tile with a soft halo of
    the same gold 3px beyond it (35%), CornerRadiusSmall. Under the pointer a 2px brass frame
    (GridViewItemHoverBorderBrush, brass c8973d) without the halo, so hover and selection stay apart on a mouse. The tile
    is GridViewItemTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <ContentPresenter />
                        <Border x:Name="Halo" BorderThickness="2" Margin="-7" IsHitTestVisible="False" Opacity="0.35"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Visibility="Collapsed"
                                BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" />
                        <Border x:Name="SelectionBorder" BorderThickness="2" Margin="-4" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemHoverBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="BorderThickness" Value="{DynamicResource FrameThickness}" TargetName="SelectionBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Halo" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
