<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml: collectible card frame in grid view.
    - Hover: card physically lifts off the board (Scale 1.032 + Y -3px, BackEase), smooth 9-slice arcane-brass
      glow aura fades in, brass corner clasps appear smoothly, and a diagonal foil card glint sweeps across the art.
    - Selected: burnished gold border, gold corner clasps, and gently breathing 9-slice golden outer aura.
    - Running / Launching: Mana crystal blue frame, tint, slanted legendary glint sweep, 5 mana diamonds, and cost-corner crystal.
    All inactive overlay layers stay Visibility="Collapsed" at rest.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="CardLift" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <!-- Hover arcane-blue glow hugging SelectionBorder (collapsed at rest) -->
                        <Control x:Name="HoverGlow" Margin="-19" IsHitTestVisible="False" Focusable="False"
                                 Visibility="Collapsed" Opacity="0"
                                 Foreground="{DynamicResource LocalManaGlowBrush}"
                                 Template="{DynamicResource LocalBloomFrameTemplate}" />
                        <!-- Selected golden glow hugging SelectionBorder (collapsed at rest; gently breathes while selected) -->
                        <Control x:Name="Halo" Margin="-19" IsHitTestVisible="False" Focusable="False"
                                 Visibility="Collapsed" Opacity="0"
                                 Foreground="{DynamicResource GridViewItemSelectedBorderBrush}"
                                 Template="{DynamicResource LocalBloomFrameTemplate}" />
                        <ContentPresenter />
                        <!-- Diagonal foil card glint sweep on hover -->
                        <Border x:Name="FoilGlint" Visibility="Collapsed" Opacity="0.42" IsHitTestVisible="False"
                                Background="{DynamicResource BevelLightBrush}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.55">
                                    <GradientStop x:Name="FoilTail" Color="#00000000" Offset="-0.32" />
                                    <GradientStop x:Name="FoilPeak" Color="#FF000000" Offset="-0.16" />
                                    <GradientStop x:Name="FoilHead" Color="#00000000" Offset="0" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Border x:Name="SelectionBorder" BorderThickness="2" Margin="-4" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Control x:Name="CornerClasps" Margin="-5" IsHitTestVisible="False" Focusable="False"
                                 Visibility="Collapsed" Opacity="0"
                                 Foreground="{DynamicResource FrameBrush}"
                                 Template="{DynamicResource LocalCornerClaspsTemplate}" />
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="6" Opacity="0.16" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.35">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.24" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.12" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                            <StackPanel Margin="0,0,0,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <Path x:Name="RunningGem1" Width="7" Height="10" Margin="0" Stretch="Fill" Data="M5,0 L10,6 L5,12 L0,6 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                                <Path x:Name="RunningGem2" Width="7" Height="10" Margin="2,0,0,0" Stretch="Fill" Data="M5,0 L10,6 L5,12 L0,6 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                                <Path x:Name="RunningGem3" Width="7" Height="10" Margin="2,0,0,0" Stretch="Fill" Data="M5,0 L10,6 L5,12 L0,6 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                                <Path x:Name="RunningGem4" Width="7" Height="10" Margin="2,0,0,0" Stretch="Fill" Data="M5,0 L10,6 L5,12 L0,6 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                                <Path x:Name="RunningGem5" Width="7" Height="10" Margin="2,0,0,0" Stretch="Fill" Data="M5,0 L10,6 L5,12 L0,6 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.25" />
                            </StackPanel>
                            <Rectangle Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.4">
                                <Rectangle.OpacityMask>
                                    <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="1" RadiusY="1">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Path Width="14" Height="18" Margin="6,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill"
                                  Data="M5,0 L10,6 L5,12 L0,6 Z" Fill="{DynamicResource RunningIndicatorBrush}" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemHoverBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="CardHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CornerClasps" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FoilGlint" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.48" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.032" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.32" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.032" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.32" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CornerClasps" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FoilTail" Storyboard.TargetProperty="Offset" Duration="0:0:0.46">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.32" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.46" Value="1.05" KeySpline="0.35,0 0.2,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FoilPeak" Storyboard.TargetProperty="Offset" Duration="0:0:0.46">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.16" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.46" Value="1.21" KeySpline="0.35,0 0.2,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FoilHead" Storyboard.TargetProperty="Offset" Duration="0:0:0.46">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.46" Value="1.37" KeySpline="0.35,0 0.2,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CardHoverIn" />
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="CornerClasps" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CornerClasps" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="BorderThickness" Value="{DynamicResource FrameThickness}" TargetName="SelectionBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Halo" />
                            <Setter Property="Visibility" Value="Visible" TargetName="CornerClasps" />
                            <Setter Property="Opacity" Value="1" TargetName="CornerClasps" />
                            <Setter Property="Foreground" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="CornerClasps" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="CardSelectedGlow">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity"
                                                         BeginTime="0:0:0.22" From="0.9" To="0.64" Duration="0:0:1.3"
                                                         AutoReverse="True" RepeatBehavior="Forever">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CardSelectedGlow" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.24" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.12" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1.12" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.12" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1.24" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.24" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.53" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.68" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.71" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.86" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem4" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.89" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.04" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem5" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.07" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.22" Value="1" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem4" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem5" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
