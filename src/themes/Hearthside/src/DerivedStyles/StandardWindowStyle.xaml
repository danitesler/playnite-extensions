<!--
    Hearthside: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    The inn's wood rim as a 44px band: the title sits on the game's banner ribbon (a mid-wood plate with brass top and
    bottom edges and swallowtail ends) in the title face, the carved edge closes the band (a dark grain line over a
    brass line), and a mana crystal marks the left end. The ribbon is sized by its title, so small dialogs still fit
    their content. Caption buttons are the 38x30 WindowBarButton glyphs, so the caption and the content offset are 44
    (Default: 25). PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>
    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource ShellBackgroundBrush}" ClipToBounds="True">
                                    <!-- Carved edge: brass under a dark grain line. -->
                                    <StackPanel VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <Rectangle Height="1" Fill="{DynamicResource ScrimBrush}" />
                                        <Rectangle Height="2" Fill="{DynamicResource NormalBorderBrush}" />
                                    </StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <Path DockPanel.Dock="Left" Data="M5,0 L10,6 L5,12 L0,6 Z" Width="10" Height="12" Stretch="Fill" Margin="16,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Fill="{DynamicResource ProgressBarForegroundBrush}" Stroke="{DynamicResource SliderHoverForegroundBrush}" StrokeThickness="1" />
                                        <Grid DockPanel.Dock="Left" Height="28" VerticalAlignment="Center" Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="M12,0 L12,28 L0,28 L7,14 L0,0 Z" Width="12" Height="28" Stretch="Fill" Margin="0,0,-1,0"
                                                  Fill="{DynamicResource ButtonBackgroundBrush}" Stroke="{DynamicResource InputHoverBorderBrush}" StrokeThickness="1" />
                                            <Border Grid.Column="1" Padding="10,0" Background="{DynamicResource ButtonBackgroundBrush}"
                                                    BorderBrush="{DynamicResource InputHoverBorderBrush}" BorderThickness="0,1">
                                                <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                            </Border>
                                            <Path Grid.Column="2" Data="M0,0 L12,0 L5,14 L12,28 L0,28 Z" Width="12" Height="28" Stretch="Fill" Margin="-1,0,0,0"
                                                  Fill="{DynamicResource ButtonBackgroundBrush}" Stroke="{DynamicResource InputHoverBorderBrush}" StrokeThickness="1" />
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,7,6,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
