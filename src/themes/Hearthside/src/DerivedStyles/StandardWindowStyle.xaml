<!--
    Hearthside: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    Modeled on Hearthstone's Options modal (Game UI Database id=628):
    - 44px carved oak title band with woodgrain texture and 3-layer brass lower molding.
    - Glowing Hearthside mana-blue compass brand medallion on the left.
    - Riveted wrought-iron & gold nameplate holding PART_TextTitle in bold Belwe gold, flanked by twin brass rivets.
    - 4-corner brass clasps framing the window border (IsHitTestVisible="False").
    - CaptionHeight (44) matches ContentPresenter top margin (44); WindowSettings trigger names the Settings window.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>
    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource FrameBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Subtle carved oak plank grain across the dialog body -->
                                <Control Template="{DynamicResource LocalWoodGrainTemplate}" IsHitTestVisible="False" />
                                <!-- 44px Carved Oak Title Band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource ShellBackgroundBrush}" ClipToBounds="True">
                                    <Control Template="{DynamicResource LocalWoodGrainTemplate}" IsHitTestVisible="False" />
                                    <!-- 3-layer carved brass molding closing the band -->
                                    <Grid Height="4" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <Border Height="4" VerticalAlignment="Bottom" Background="{DynamicResource FrameInnerBrush}" />
                                        <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource TopPanelSeparatorBrush}" />
                                        <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource FrameBrush}" Opacity="0.85" />
                                    </Grid>
                                    <DockPanel LastChildFill="False">
                                        <!-- Hearthside Brand Medallion -->
                                        <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="18,0,10,2" VerticalAlignment="Center"
                                                CornerRadius="{DynamicResource CornerRadiusFull}" IsHitTestVisible="False"
                                                Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                                BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1.5">
                                            <Grid>
                                                <Border CornerRadius="{DynamicResource CornerRadiusFull}"
                                                        Background="{DynamicResource SliderHoverForegroundBrush}" Opacity="0.3">
                                                    <Border.OpacityMask>
                                                        <RadialGradientBrush Center="0.35,0.3" GradientOrigin="0.35,0.3" RadiusX="0.7" RadiusY="0.7">
                                                            <GradientStop Color="#FF000000" Offset="0" />
                                                            <GradientStop Color="#00000000" Offset="1" />
                                                        </RadialGradientBrush>
                                                    </Border.OpacityMask>
                                                </Border>
                                                <ContentControl Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                TextElement.Foreground="{DynamicResource TextBrush}"
                                                                Content="{DynamicResource LocalIconHearthMark}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Grid>
                                        </Border>
                                        <!-- Riveted Wrought-Iron & Gold Title Nameplate -->
                                        <Border DockPanel.Dock="Left" Height="28" VerticalAlignment="Center" Margin="0,0,12,2"
                                                Background="{DynamicResource LocalIronBrush}" BorderBrush="{DynamicResource FrameBrush}"
                                                BorderThickness="1" CornerRadius="5">
                                            <Grid>
                                                <Border CornerRadius="4" Background="{DynamicResource LocalIronDarkBrush}" Opacity="0.55" IsHitTestVisible="False">
                                                    <Border.OpacityMask>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0.35" />
                                                            <GradientStop Color="#FF000000" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.OpacityMask>
                                                </Border>
                                                <Border Height="1" Margin="3,0,3,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                                        Background="{DynamicResource LocalIronEdgeBrush}" Opacity="0.75" />
                                                <Ellipse Width="5" Height="5" Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                         IsHitTestVisible="False" Fill="{DynamicResource SelectedBorderBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.8" />
                                                <Ellipse Width="5" Height="5" Margin="0,0,7,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         IsHitTestVisible="False" Fill="{DynamicResource SelectedBorderBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.8" />
                                                <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}" VerticalAlignment="Center"
                                                           Margin="20,0,20,0" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                                           FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource HeadingForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" Style="{DynamicResource BaseTextBlockStyle}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,8,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after title band so tall dialog contents stay visible over it -->
                                <ContentPresenter Margin="0,44,0,0" />
                                <!-- Subtle brass corner clasps framing the dialog -->
                                <Control Template="{DynamicResource LocalCornerClaspsTemplate}" Foreground="{DynamicResource FrameBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
