<!--
    Overlay on Playnite Default/DerivedStyles/PropertyItemButton.xaml: clickable metadata values inside the
    Parchment Folio tome (DetailsViewGameOverview and GridViewGameOverview).
    - Default (text link): deep chestnut ink on warm parchment; underlined & warm brass-brown on hover.
    - Chip (Tag="Chip"): dark carved-oak token with cream lettering and brass rim; hover smoothly fades in
      the lit wood fill and springs up slightly (1.045 BackEase).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"
                               Foreground="{TemplateBinding Foreground}"
                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                               TextWrapping="Wrap" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource NormalBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Background" Value="{DynamicResource PropertyItemBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ChipScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <Border x:Name="Chip" Padding="8,3,8,3" SnapsToDevicePixels="True"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Grid>
                                        <Border x:Name="ChipHover" Margin="-8,-3,-8,-3" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                                Background="{DynamicResource PropertyItemHoverBackgroundBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                                        <Border Height="1" Margin="-5,-3,-5,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                                Background="{DynamicResource BevelLightBrush}" Opacity="0.22" />
                                        <TextBlock x:Name="Text" VerticalAlignment="Center"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
                                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Name="ChipHoverIn">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipHover" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="ChipHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleX" To="1.045" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleY" To="1.045" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <RemoveStoryboard BeginStoryboardName="ChipHoverIn" />
                                        <BeginStoryboard>
                                            <Storyboard FillBehavior="Stop">
                                                <DoubleAnimation Storyboard.TargetName="ChipHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipHover" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ParchmentLabelBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
