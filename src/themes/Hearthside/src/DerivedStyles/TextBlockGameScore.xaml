<!--
    Overlay on Playnite Default/DerivedStyles/TextBlockGameScore.xaml: a score on the game page (community, critic, user)
    in Belwe (HeadingFontFamily), the face of the game's stat numbers, colored the way the board colors stats: buffed
    green (PositiveRatingBrush, playable 29dd4f), End Turn yellow for mixed (MixedRatingBrush), the health gem red when
    low (NegativeRatingBrush).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TextBlockGameScore" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Positive}">
                <Setter Property="Foreground" Value="{DynamicResource PositiveRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Negative}">
                <Setter Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Mixed}">
                <Setter Property="Foreground" Value="{DynamicResource MixedRatingBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
