<!--
    Rushdown: Common.xaml.
    Spacing & form control sizing (ControlHeight=32px, IconSize=16px, GameBannerHeight=320px, GameBannerDarken=0),
    shared neon DropShadowEffect glow resources (LocalTitleGlowEffect, LocalElementGlowEffect, LocalMagentaGlowEffect,
    LocalSubtleGlowEffect), PopupBorder, FocusVisual, shared ImageBrush white-mask FX resources, BrandMarkTemplate,
    DividerTemplate, HeadingTextBlock (glowing title), SecondaryButton, SteamScreenshotsSkeletonTemplate, and EmptyGameTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing & sizing keys (32px form controls, 16px icons, 320px hero banner) -->
    <Thickness x:Key="ButtonPadding">12,5,12,5</Thickness>
    <Thickness x:Key="InputPadding">9,5,9,5</Thickness>
    <Thickness x:Key="MenuPadding">4,5,4,5</Thickness>
    <Thickness x:Key="MenuItemPadding">8,4,10,4</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4,4,4,4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,4,8,4</Thickness>
    <Thickness x:Key="ListBoxItemPadding">8,5,8,5</Thickness>
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>
    <Thickness x:Key="TooltipPadding">10,7,10,7</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Shared SF6-inspired neon violet-magenta & Super Art score glow effects -->
    <DropShadowEffect x:Key="LocalTitleGlowEffect" Color="#FFE046FF" BlurRadius="10" ShadowDepth="0" Opacity="0.92" RenderingBias="Performance" />
    <DropShadowEffect x:Key="LocalElementGlowEffect" Color="#FF9B3CFF" BlurRadius="14" ShadowDepth="0" Opacity="0.72" RenderingBias="Performance" />
    <DropShadowEffect x:Key="LocalMagentaGlowEffect" Color="#FFE046FF" BlurRadius="12" ShadowDepth="0" Opacity="0.80" RenderingBias="Performance" />
    <DropShadowEffect x:Key="LocalSubtleGlowEffect" Color="#FF9B3CFF" BlurRadius="8" ShadowDepth="0" Opacity="0.52" RenderingBias="Performance" />
    <DropShadowEffect x:Key="LocalScorePinkGlowEffect" Color="#FFFF2B92" BlurRadius="10" ShadowDepth="0" Opacity="0.95" RenderingBias="Performance" />
    <DropShadowEffect x:Key="LocalScoreBlueGlowEffect" Color="#FF2B8BFF" BlurRadius="10" ShadowDepth="0" Opacity="0.95" RenderingBias="Performance" />
    <DropShadowEffect x:Key="LocalScoreGreenGlowEffect" Color="#FF53F83C" BlurRadius="10" ShadowDepth="0" Opacity="0.90" RenderingBias="Performance" />
    <DropShadowEffect x:Key="LocalTealGlowEffect" Color="#FF28DCE4" BlurRadius="10" ShadowDepth="0" Opacity="0.72" RenderingBias="Performance" />
    <DropShadowEffect x:Key="LocalGoldGlowEffect" Color="#FFFFB424" BlurRadius="11" ShadowDepth="0" Opacity="0.78" RenderingBias="Performance" />

    <!-- SF6 Training-Mode 6-block slanted Drive Gauge brushes (\ slant, emerald fill + bright neon lime outline) -->
    <DrawingBrush x:Key="LocalDriveBlocksBrush" TileMode="Tile" Viewport="0,0,0.1666667,1" ViewportUnits="RelativeToBoundingBox" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,28,12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource LocalDriveBlockFillBrush}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource LocalDriveBlockRimBrush}" Thickness="1.4" LineJoin="Miter" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 1.5,1.2 L 20.5,1.2 L 26,10.8 L 7,10.8 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="LocalDriveEmptyBlocksBrush" TileMode="Tile" Viewport="0,0,0.1666667,1" ViewportUnits="RelativeToBoundingBox" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,28,12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF120526">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF4A257A" Thickness="1.2" LineJoin="Miter" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 1.5,1.2 L 20.5,1.2 L 26,10.8 L 7,10.8 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Shared procedural white-mask FX brushes (recolored dynamically by ThemeModifier) -->
    <ImageBrush x:Key="LocalIceFacetMaskBrush" ImageSource="{ThemeFile 'Images/fx/ice-facet.png'}"
                TileMode="Tile" Viewport="0,0,256,64" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalPrismSplashMaskBrush" ImageSource="{ThemeFile 'Images/fx/prism-splash.png'}"
                TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalPrismSheenMaskBrush" ImageSource="{ThemeFile 'Images/fx/prism-sheen.png'}"
                Stretch="Fill" />

    <!-- Vector tiled DrawingBrush for crisp slanted 6-segment Drive Gauge ticks at any DPI -->
    <DrawingBrush x:Key="LocalDriveSegmentsMaskBrush" TileMode="Tile" Viewport="0,0,14,12" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,14,12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF000000">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 1,12 L 4.5,0 L 12.2,0 L 8.7,12 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Shared arcade chevron & Challenger Gold corner badge geometries -->
    <Geometry x:Key="LocalChevronRightGeometry">M 1,1.5 L 6.5,8 L 1,14.5 L 4.2,14.5 L 9.7,8 L 4.2,1.5 Z M 7.2,1.5 L 12.7,8 L 7.2,14.5 L 10.4,14.5 L 15.9,8 L 10.4,1.5 Z</Geometry>
    <Geometry x:Key="LocalSingleChevronGeometry">M 2,1.5 L 8.5,8 L 2,14.5 L 5.2,14.5 L 11.7,8 L 5.2,1.5 Z</Geometry>
    <Geometry x:Key="LocalChallengerCornerGeometry">M 0,0 L 16,0 L 0,16 Z</Geometry>

    <!-- PopupBorder -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LocalPanelGradientBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
        <Setter Property="Effect" Value="{DynamicResource LocalElementGlowEffect}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Keyboard FocusVisual: glowing lavender-magenta perimeter rim -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1.5"
                            Effect="{DynamicResource LocalMagentaGlowEffect}"
                            SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BrandMarkTemplate: original Rushdown 3D isometric street-graffiti hexagonal cube -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="64" Height="64">
                <Path Fill="{TemplateBinding Foreground}"
                      Data="F0 M32,7 L54,19.5 L54,44.5 L32,57 L10,44.5 L10,19.5 Z M32,12 L15.5,21.4 L32,30.8 L48.5,21.4 Z M14,25.2 L14,42.2 L30,51.3 L30,34.3 Z M50,25.2 L34,34.3 L34,51.3 L50,42.2 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M17.5,31.8 L26.5,36.9 L26.5,40.6 L17.5,35.5 Z M46.5,31.8 L37.5,36.9 L37.5,40.6 L46.5,35.5 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M51,9 L59,5 L55,14 Z M13,55 L5,59 L9,50 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M32,16.8 L39.5,21.4 L32,26.0 L24.5,21.4 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- DividerTemplate: 10px glowing Diamond-Capped Technical Callout Rule -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="10" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="5" Height="5" Margin="2,0,4,0" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource LocalTealGlowBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
            </Border>
            <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0.78" />
            <Border Grid.Column="2" Width="5" Height="5" Margin="4,0" VerticalAlignment="Center"
                    Background="{DynamicResource LocalMagentaNeonBrush}" Effect="{DynamicResource LocalSubtleGlowEffect}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
            </Border>
            <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0.78" />
            <Border Grid.Column="4" Width="5" Height="5" Margin="4,0,2,0" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource LocalTealGlowBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- HeadingTextBlock style for glowing game page section titles ("Classic Type" / "Shortcut Settings" look) -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="Effect" Value="{DynamicResource LocalTitleGlowEffect}" />
    </Style>

    <!-- SecondaryButton: 40x40 glowing cool-violet icon-only battle capsule (More, Edit) -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource LocalIdleCardGradientBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Effect="{DynamicResource LocalSubtleGlowEffect}">
                            <Grid ClipToBounds="True">
                                <Border x:Name="HoverOverlay" Background="{DynamicResource LocalActiveGradientBrush}"
                                        BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1"
                                        CornerRadius="3" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="PressedOverlay" Background="{DynamicResource SecondaryButtonPressedBackgroundBrush}"
                                        CornerRadius="3" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Rectangle Width="7" Height="2" Margin="2,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Fill="{DynamicResource LocalMagentaNeonBrush}" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Effect" Value="{DynamicResource LocalMagentaGlowEffect}" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecPressIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LocalNotesTextBox: Pause Mode translucent deep teal-indigo glass notes card -->
    <Style x:Key="LocalNotesTextBox" TargetType="TextBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource LocalTealGlassCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalTealBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Effect="{DynamicResource LocalTealGlowEffect}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SteamScreenshotsSkeletonTemplate: glowing ultraviolet loading placeholder -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False">
            <Border Height="220" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource LocalPanelGradientBrush}"
                    BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1.5" Margin="0,0,0,8"
                    Effect="{DynamicResource LocalSubtleGlowEffect}">
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.06"
                           OpacityMask="{DynamicResource LocalPrismSplashMaskBrush}" />
            </Border>
            <UniformGrid Columns="5" Height="56">
                <Border Margin="0,0,6,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource LocalIdleCardGradientBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Margin="0,0,6,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource LocalIdleCardGradientBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Margin="0,0,6,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource LocalIdleCardGradientBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Margin="0,0,6,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource LocalIdleCardGradientBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource LocalIdleCardGradientBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- EmptyGameTemplate: Glowing Fighting Ground Information-modal card + breathing 3D Isometric Cube -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid Background="Transparent" IsHitTestVisible="False">
            <Rectangle Fill="{DynamicResource LocalMagentaNeonBrush}" Opacity="0.055"
                       OpacityMask="{DynamicResource LocalPrismSplashMaskBrush}" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource LocalPanelGradientBrush}"
                    BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1.5"
                    CornerRadius="{DynamicResource CornerRadiusLarge}"
                    Effect="{DynamicResource LocalElementGlowEffect}"
                    MinWidth="380">
                <Grid>
                    <Border Margin="3" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.65" IsHitTestVisible="False" />
                    <StackPanel>
                        <Grid Height="14" VerticalAlignment="Top">
                            <Rectangle Height="2.5" VerticalAlignment="Top" Fill="{DynamicResource LocalMagentaNeonBrush}" />
                            <Path Data="M 0,0 L 22,0 L 11,9 Z" Fill="{DynamicResource LocalMagentaNeonBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Top" />
                        </Grid>
                        <StackPanel Margin="44,18,44,28" HorizontalAlignment="Center">
                            <Grid Width="136" Height="136" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Ellipse x:Name="EmptyRingOuter" Width="124" Height="124"
                                         Stroke="{DynamicResource LocalMagentaNeonBrush}" StrokeThickness="1.5"
                                         StrokeDashArray="10 5" Opacity="0.65" Effect="{DynamicResource LocalSubtleGlowEffect}"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><RotateTransform x:Name="EmptyRingRot" Angle="0" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="EmptyRingInner" Width="98" Height="98"
                                         Stroke="{DynamicResource FocusBrush}" StrokeThickness="1.5" Opacity="0.5" />
                                <Control x:Name="EmptyCubeMark" Width="64" Height="64"
                                         Template="{DynamicResource BrandMarkTemplate}"
                                         Foreground="{DynamicResource SelectedBorderBrush}"
                                         Effect="{DynamicResource LocalMagentaGlowEffect}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Control.RenderTransform><ScaleTransform x:Name="EmptyCubeScale" ScaleX="1" ScaleY="1" /></Control.RenderTransform>
                                </Control>
                            </Grid>
                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                       FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                       FontSize="24" Foreground="{DynamicResource HeadingForegroundBrush}"
                                       Effect="{DynamicResource LocalTitleGlowEffect}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                            <Control Margin="0,16,0,0" Width="220" Template="{DynamicResource DividerTemplate}"
                                     Foreground="{DynamicResource NormalBorderBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyCubeIdle">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="EmptyRingRot" Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:18" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyCubeMark" Storyboard.TargetProperty="Opacity" Duration="0:0:4.2">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="1.0" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:4.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyCubeScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:4.2">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.97" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="1.03" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:4.2" Value="0.97" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyCubeScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:4.2">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.97" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="1.03" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:4.2" Value="0.97" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyCubeIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): three slanted pure-white bars, italic like a fighting-game gauge, in a staggered stack. Hover: each bar shears further in turn (a springy skew snap) and flashes neon magenta. Open (ContextMenu.IsOpen of the nearest Border): an ice slanted frame snaps around the bars with an elastic overshoot, then a magenta scanline sweeps across them on repeat until the menu closes. -->
    <ControlTemplate x:Key="LocalRushdownMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="26" Height="26" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform x:Name="FrameScale" ScaleX="0.2" ScaleY="1" /></Canvas.RenderTransform>
                    <Path x:Name="Frame" Data="M5.5,2 H24.5 L20.5,24 H1.5Z" Stroke="{DynamicResource LocalIceLitBrush}" StrokeThickness="1.1" StrokeLineJoin="Miter" Opacity="0" />
                </Canvas>
                <Canvas Width="26" Height="26" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><SkewTransform x:Name="ShearA" AngleX="0" /></Canvas.RenderTransform>
                    <Path Data="M5.2,6.2 H22 L19.8,9.8 H3Z" Fill="{TemplateBinding Foreground}" />
                    <Path x:Name="HotA" Data="M5.2,6.2 H22 L19.8,9.8 H3Z" Fill="{DynamicResource LocalMagentaNeonBrush}" Opacity="0" />
                </Canvas>
                <Canvas Width="26" Height="26" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><SkewTransform x:Name="ShearB" AngleX="0" /></Canvas.RenderTransform>
                    <Path Data="M4.2,11.2 H17 L14.8,14.8 H2Z" Fill="{TemplateBinding Foreground}" />
                    <Path x:Name="HotB" Data="M4.2,11.2 H17 L14.8,14.8 H2Z" Fill="{DynamicResource LocalMagentaNeonBrush}" Opacity="0" />
                </Canvas>
                <Canvas Width="26" Height="26" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><SkewTransform x:Name="ShearC" AngleX="0" /></Canvas.RenderTransform>
                    <Path Data="M3.2,16.2 H20 L17.8,19.8 H1Z" Fill="{TemplateBinding Foreground}" />
                    <Path x:Name="HotC" Data="M3.2,16.2 H20 L17.8,19.8 H1Z" Fill="{DynamicResource LocalMagentaNeonBrush}" Opacity="0" />
                </Canvas>
                <Canvas Width="26" Height="26" ClipToBounds="False">
                    <Path x:Name="Scan" Data="M14.4,3.5 L11.6,22.5" Stroke="{DynamicResource LocalMagentaNeonBrush}" StrokeThickness="1.5" Opacity="0">
                        <Path.RenderTransform><TranslateTransform x:Name="ScanMove" X="-8" /></Path.RenderTransform>
                    </Path>
                </Canvas>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ShearA" Storyboard.TargetProperty="AngleX" To="-18" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="1.0" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ShearB" Storyboard.TargetProperty="AngleX" To="-18" BeginTime="0:0:0.05" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="1.0" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ShearC" Storyboard.TargetProperty="AngleX" To="-18" BeginTime="0:0:0.1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="1.0" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HotA" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HotB" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.05" Duration="0:0:0.1"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HotC" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.1"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShearA" Storyboard.TargetProperty="AngleX" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShearB" Storyboard.TargetProperty="AngleX" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShearC" Storyboard.TargetProperty="AngleX" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HotA" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HotB" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HotC" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" From="1" To="0.55" BeginTime="0:0:0.4" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="FrameScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><ElasticEase Oscillations="2" Springiness="6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Scan" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.2" Duration="0:0:0.1"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ScanMove" Storyboard.TargetProperty="X" To="-8" BeginTime="0:0:0.2" Duration="0:0:0.01"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ScanMove" Storyboard.TargetProperty="X" From="-8" To="8" BeginTime="0:0:0.2" Duration="0:0:0.9" RepeatBehavior="Forever"></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FrameScale" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Scan" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ScanMove" Storyboard.TargetProperty="X" To="-8" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
