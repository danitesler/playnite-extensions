<!--
    Rushdown: DerivedStyles/PropertyItemButton.xaml.
    Default: Battle Hub Electric Cyan text link (brightening to Prismatic White-Ice on hover).
    Tag="Chip" (on owning ItemsControl): Options capsule tag (ControlCornerRadius=4px, #1E2642 fill, #364268 border,
    2.5px left Battle Hub Cyan stripe) flipping to Prismatic White-Ice (#E4F0FC) with Neon Magenta left stripe and
    #0E1220 dark ink (16.13:1) on hover.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PropertyItemButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LinkText" Property="Foreground" Value="{DynamicResource SelectedHoverBrush}" />
                            <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="Margin" Value="0,0,5,5" />
                <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ChipPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource LocalTealGlassCardBrush}"
                                    BorderBrush="{DynamicResource LocalTealBorderBrush}" BorderThickness="1"
                                    Effect="{DynamicResource LocalTealGlowEffect}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="ChipBar" Width="2.5" HorizontalAlignment="Left"
                                            Background="{DynamicResource LocalTealGlowBrush}" IsHitTestVisible="False" />
                                    <ContentPresenter Margin="9,2.5,9,2.5" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipPlate" Property="Background" Value="{DynamicResource LocalSunburstGoldBrush}" />
                                    <Setter TargetName="ChipPlate" Property="BorderBrush" Value="{DynamicResource LocalGoldRimBrush}" />
                                    <Setter TargetName="ChipPlate" Property="Effect" Value="{DynamicResource LocalGoldGlowEffect}" />
                                    <Setter TargetName="ChipBar" Property="Background" Value="{DynamicResource TextBrushDark}" />
                                    <Setter TargetName="ChipBar" Property="Width" Value="3" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
