<!--
    Rushdown: DerivedStyles/StandardWindowStyle.xaml.
    44px Midnight Indigo title band (CaptionHeight=44 == ContentPresenter top margin 44),
    bearing sparse street-graffiti shard mist (prism-splash.png), ghosted 3D isometric cube mark,
    22px Battle Hub Cyan cube mark before Rajdhani Bold title, and Neon Magenta + Cyan closing laser rail.
    WindowSettings trigger sets PART_TextTitle to LOCSettingsLabel directly (no duplicate hidden copy).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource FrameBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Dialog body pushed strictly by CaptionHeight=44 -->
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px Fighting Ground Ultraviolet Gradient title band ("Shortcut Settings" glowing title) -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource LocalPanelGradientBrush}" ClipToBounds="True">
                                    <!-- Subtle street-graffiti shard texture across header band -->
                                    <Rectangle Fill="{DynamicResource LocalMagentaNeonBrush}" Opacity="0.065"
                                               OpacityMask="{DynamicResource LocalPrismSplashMaskBrush}" IsHitTestVisible="False" />

                                    <!-- Ghosted 3D isometric graffiti cube mark on right end of title band -->
                                    <Control Width="64" Height="64" Margin="0,-10,146,0"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Template="{DynamicResource BrandMarkTemplate}"
                                             Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                             Opacity="0.10" IsHitTestVisible="False" />

                                    <!-- Bottom Neon Magenta laser rule + centered Cyan-Magenta glowing highlight bar -->
                                    <Rectangle Height="2" VerticalAlignment="Bottom"
                                               Fill="{DynamicResource LocalMagentaNeonBrush}"
                                               Effect="{DynamicResource LocalSubtleGlowEffect}"
                                               IsHitTestVisible="False" />
                                    <Grid Width="320" Height="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                          Effect="{DynamicResource LocalMagentaGlowEffect}" IsHitTestVisible="False">
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="0.3" />
                                                <GradientStop Color="#FF000000" Offset="0.7" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>
                                        <Rectangle Fill="{DynamicResource FocusBrush}" />
                                        <Rectangle Width="120" HorizontalAlignment="Center" Fill="{DynamicResource SelectedBorderBrush}" />
                                    </Grid>

                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,2">
                                            <Control Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Template="{DynamicResource BrandMarkTemplate}"
                                                     Foreground="{DynamicResource SelectedBorderBrush}"
                                                     Effect="{DynamicResource LocalMagentaGlowEffect}" IsHitTestVisible="False" />
                                            <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontWeight="Bold"
                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       Effect="{DynamicResource LocalTitleGlowEffect}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowDesignStyle" TargetType="WindowBase" BasedOn="{StaticResource StandardWindowStyle}" />
</ResourceDictionary>
