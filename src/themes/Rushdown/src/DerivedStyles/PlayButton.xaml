<!--
    Rushdown: DerivedStyles/PlayButton.xaml (PlayButton + RunningActionIndicator).
    Hero Play Button: 45-degree top-right chamfered Fighting Ground Neon Magenta (#C4168C) slab with 1.5px Neon
    Magenta rim (#FF3CE0), subtle prismatic facet shimmer (ice-facet.png), and Rajdhani Bold uppercase white label (5.47:1).
    - Hover: brightens to #D91E9D (4.54:1), illuminates inner white-pink Information-modal glow border, sweeps diagonal
      crystal overdrive sheen (prism-sheen.png), and snaps double arcade chevrons (>>) into right edge (140ms BackEase).
    - Press: separate PressedPlate compresses to #96106A (80ms).
    - Launching / Running: keeps exact chamfered polygon shape in Drive Gauge Overdrive Green (#168736) with crisp
      white label (>= 4.61:1 unscrimmed, 6.3-9.5:1 under RunningBreath scrim). Launching sweeps slanted 6-segment Drive
      Gauge band (LocalDriveSegmentsMaskBrush) + slanted foot bar + 3 slanted Drive Impact chevrons. Running breathes
      quietly via RunningBreath (0.22-0.42, 3.0s) with staggered Drive chevron idle; hovering the button itself
      (RelativeSource Self) darkens via RunningHoverDim and swaps label to Cancel without resizing (PlayContent=Hidden).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinWidth" Value="162" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="18,0,18,0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="{DynamicResource LocalPlayGradientBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Zero-measure Canvas breaks the Measure/Arrange feedback loop from Stretch="Fill" Paths -->
                        <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Grid Width="{Binding ActualWidth, ElementName=PlayRoom}"
                                  Height="{Binding ActualHeight, ElementName=PlayRoom}"
                                  IsHitTestVisible="False">
                                <!-- Outer Neon Magenta hover halo (collapsed while launching/running) -->
                                <Grid x:Name="IdleGlowHost" IsHitTestVisible="False">
                                    <Path x:Name="GlowBorder" Margin="-3" Stretch="Fill"
                                          Data="M 0,0 L 148,0 L 164,14 L 164,46 L 0,46 Z"
                                          Stroke="{DynamicResource PrimaryButtonGlowBrush}" StrokeThickness="3"
                                          Effect="{DynamicResource LocalMagentaGlowEffect}"
                                          Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                </Grid>

                                <!-- Clip container in the exact 45-deg top-right chamfered silhouette -->
                                <Grid>
                                    <!-- Base chamfered plate with luminous ultraviolet-to-magenta gradient + neon glow -->
                                    <Path x:Name="PlayPlate" Stretch="Fill"
                                          Data="M 0,0 L 148,0 L 162,13 L 162,42 L 0,42 Z"
                                          Fill="{TemplateBinding Background}"
                                          Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5"
                                          Effect="{DynamicResource LocalMagentaGlowEffect}"
                                          IsHitTestVisible="False" />

                                    <!-- Subtle prismatic crystal facet texture across gradient slab -->
                                    <Path Stretch="Fill" Data="M 0,0 L 148,0 L 162,13 L 162,42 L 0,42 Z"
                                          Fill="{DynamicResource LocalIceLitBrush}" Opacity="0.14"
                                          OpacityMask="{DynamicResource LocalIceFacetMaskBrush}" IsHitTestVisible="False" />

                                    <!-- Idle hover host (collapsed when launching/running) -->
                                    <Grid x:Name="IdleHoverHost" IsHitTestVisible="False">
                                        <Path x:Name="HoverPlate" Stretch="Fill"
                                              Data="M 0,0 L 148,0 L 162,13 L 162,42 L 0,42 Z"
                                              Fill="{DynamicResource LocalPlayHoverGradientBrush}"
                                              Stroke="{DynamicResource LocalIceLitBrush}" StrokeThickness="1.5"
                                              Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Inner white-pink Information modal glow rim -->
                                <Path x:Name="HoverInnerRim" Margin="2.5" Stretch="Fill"
                                      Data="M 0,0 L 145,0 L 157,12 L 157,37 L 0,37 Z"
                                      Stroke="{DynamicResource LocalIceLitBrush}" StrokeThickness="1"
                                      Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Diagonal crystal overdrive sheen sweep -->
                                <Grid x:Name="SheenHost" ClipToBounds="True" Visibility="Collapsed">
                                    <Rectangle x:Name="SheenLayer"
                                               Fill="{DynamicResource DangerForegroundBrush}" Opacity="0"
                                               OpacityMask="{DynamicResource LocalPrismSheenMaskBrush}" IsHitTestVisible="False">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="SheenSlide" X="-120" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Grid>

                            <!-- Separate pressed plate -->
                            <Path x:Name="PressedPlate" Stretch="Fill"
                                  Data="M 0,0 L 148,0 L 162,13 L 162,42 L 0,42 Z"
                                  Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                  Stroke="{DynamicResource LocalMagentaNeonBrush}" StrokeThickness="1.5"
                                  Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                            <!-- RunningBreath scrim (darkens green plate during launching & running; never fades plate) -->
                            <Path x:Name="RunningBreath" Stretch="Fill"
                                  Data="M 0,0 L 148,0 L 162,13 L 162,42 L 0,42 Z"
                                  Fill="{DynamicResource ScrimBrush}"
                                  Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                            <!-- RunningScan: slanted 6-segment Drive Gauge progress sweep during launching -->
                            <Grid x:Name="RunningScanHost" Visibility="Collapsed" IsHitTestVisible="False"
                                  OpacityMask="{DynamicResource LocalDriveSegmentsMaskBrush}">
                                <Path x:Name="RunningScan" Stretch="Fill"
                                      Data="M 0,0 L 148,0 L 162,13 L 162,42 L 0,42 Z"
                                      Fill="{DynamicResource LocalDriveLimeBrush}" Opacity="0.20">
                                    <Path.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Path.OpacityMask>
                                </Path>
                            </Grid>

                            <!-- RunningHoverDim: second scrim faded in ONLY with Cancel label -->
                            <Path x:Name="RunningHoverDim" Stretch="Fill"
                                  Data="M 0,0 L 148,0 L 162,13 L 162,42 L 0,42 Z"
                                  Fill="{DynamicResource ScrimBrush}"
                                  Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            </Grid>
                        </Canvas>

                        <!-- Content room: reserves 36px right strip during launching/running so 3 Drive chevrons never touch text -->
                        <!-- RunningMarkRoom left="0" right="36" -->
                        <Border x:Name="PlayRoom" Padding="0" MinWidth="162" Height="42">
                                <StackPanel x:Name="PlayContent" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"
                                            Effect="{DynamicResource LocalTitleGlowEffect}">
                                    <ContentControl x:Name="PlayGlyph" Margin="0,0,8,0"
                                                    Content="{DynamicResource IconPlay}"
                                                    ContentTemplate="{DynamicResource IconTemplate}"
                                                    Foreground="{TemplateBinding Foreground}"
                                                    VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False" />
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                </StackPanel>
                            </Border>

                            <!-- Double arcade chevron (>>) sliding into right edge on idle Play hover -->
                            <Grid x:Name="IdleCursorHost" IsHitTestVisible="False">
                                <Path x:Name="PlayCursor" Data="{DynamicResource LocalChevronRightGeometry}"
                                      Width="14" Height="11" Stretch="Uniform"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                      Fill="{DynamicResource DangerForegroundBrush}"
                                      Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="PlayCursorSlide" X="-8" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>

                            <!-- Cancel label: shown ONLY while IsRunning=True AND button itself IsMouseOver=True -->
                            <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,0,36,0"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource DangerForegroundBrush}"
                                       Effect="{DynamicResource LocalTitleGlowEffect}"
                                       Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Idle Play hover animation (white-pink inner rim + diagonal sheen + >> arcade chevron) -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverInnerRim" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SheenHost" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlayCursor" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="HoverInnerRim" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="PlayCursor" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PlayCursorSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.22" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SheenLayer" Storyboard.TargetProperty="Opacity" From="0" To="0.52" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SheenSlide" Storyboard.TargetProperty="X" From="-110" To="24" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="HoverInnerRim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="SheenLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="PlayCursor" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="PlayCursorSlide" Storyboard.TargetProperty="X" To="-8" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverInnerRim" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SheenHost" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlayCursor" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Separate pressed plate trigger -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayPressIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- LAUNCHING state: solid Drive Gauge Overdrive Green chamfered plate + slanted 6-segment scan -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource LocalDriveBrightBrush}" />
                            <Setter TargetName="PlayPlate" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleGlowHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleCursorHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScanHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,36,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity"
                                                         From="0.45" To="0.58" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.42" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.42" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.42" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.422" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.422" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING state: solid Drive Gauge Overdrive Green chamfered plate + quiet RunningBreath idle pulse -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource LocalDriveBrightBrush}" />
                            <Setter TargetName="PlayPlate" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleGlowHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleCursorHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,36,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.22" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.22" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING + hover ON THE BUTTON ITSELF (RelativeSource Self): Cancel without resize -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.05" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="PlayCancelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RunningActionIndicator: overlaid on the game page Play / ContextAction cell copying the 45-deg chamfered plate -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.94" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Grid.OpacityMask>
                            <DrawingBrush Stretch="Fill">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="#FF000000" Geometry="M 0,0 L 148,0 L 162,13 L 162,42 L 0,42 Z" />
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Grid.OpacityMask>
                        <!-- Subtle overlay wash copying the chamfered plate (<= 0.12 so white label contrast stays high) -->
                        <Border x:Name="RunningWash"
                                Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.10" />
                        <!-- 1.5px RunningFrame copying PlayButton's exact chamfered silhouette -->
                        <Border x:Name="RunningFrame"
                                BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5" />
                        <!-- Slanted 6-segment Drive Gauge foot track 3.5px above bottom -->
                        <Grid Height="3" Margin="6,0,6,3.5" VerticalAlignment="Bottom"
                              OpacityMask="{DynamicResource LocalDriveSegmentsMaskBrush}">
                            <Rectangle Fill="{DynamicResource LocalDriveBrightBrush}" Opacity="0.32" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalDriveLimeBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <!-- 3 slanted Drive Impact chevrons in the reserved 36px right strip -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,9,0">
                            <Path x:Name="ActChev1" Width="6" Height="10" Margin="0,0,2,0" Stretch="Fill"
                                  Data="M 0,0 L 3.5,0 L 6,5 L 3.5,10 L 0,10 L 2.5,5 Z"
                                  Fill="{DynamicResource LocalDriveLimeBrush}" Opacity="0.55">
                                <Path.RenderTransform><TranslateTransform x:Name="ActChev1X" X="0" /></Path.RenderTransform>
                            </Path>
                            <Path x:Name="ActChev2" Width="6" Height="10" Margin="0,0,2,0" Stretch="Fill"
                                  Data="M 0,0 L 3.5,0 L 6,5 L 3.5,10 L 0,10 L 2.5,5 Z"
                                  Fill="{DynamicResource LocalDriveLimeBrush}" Opacity="0.7">
                                <Path.RenderTransform><TranslateTransform x:Name="ActChev2X" X="0" /></Path.RenderTransform>
                            </Path>
                            <Path x:Name="ActChev3" Width="6" Height="10" Stretch="Fill"
                                  Data="M 0,0 L 3.5,0 L 6,5 L 3.5,10 L 0,10 L 2.5,5 Z"
                                  Fill="{DynamicResource LocalDriveLimeBrush}" Opacity="0.55">
                                <Path.RenderTransform><TranslateTransform x:Name="ActChev3X" X="0" /></Path.RenderTransform>
                            </Path>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
