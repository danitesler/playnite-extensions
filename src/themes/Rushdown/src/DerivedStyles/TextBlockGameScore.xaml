<!--
    Rushdown: DerivedStyles/TextBlockGameScore.xaml.
    SF6 Super Art Gauge glowing bold score numerals (paired with slanted magenta-pink / electric-blue bars in overviews).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="TextBlockGameScore" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Effect" Value="{DynamicResource LocalTitleGlowEffect}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Positive}">
                <Setter Property="Effect" Value="{DynamicResource LocalScoreGreenGlowEffect}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Mixed}">
                <Setter Property="Effect" Value="{DynamicResource LocalScoreBlueGlowEffect}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Negative}">
                <Setter Property="Effect" Value="{DynamicResource LocalScorePinkGlowEffect}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
