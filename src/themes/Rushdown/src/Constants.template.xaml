<!--
    Rushdown: Constants.xaml template. scripts/build-theme.ps1 renders tokens.css into Constants.xaml.
    Luminous ultraviolet-indigo to electric royal-purple and neon magenta gradients inspired by Street Fighter 6
    Fighting Ground / Shortcut Settings / Control Type modals, with glowing titles, neon perimeter blooms,
    On/Off toggle switches, Electric Cyan secondary telemetry, and Drive Gauge Overdrive Green running cues.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (bundled static Barlow & Rajdhani in src/Typography/, Consolas native) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">13.5</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">40</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow, {{text:rd-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Rajdhani, {{text:rd-font-heading|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:rd-font-mono|Consolas}}</FontFamily>

    <!-- Usable metadata content width & switchable position -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape & bounded corner radius scale -->
    <Thickness x:Key="PopupBorderThickness">1.5</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:rd-radius-sm|2}}</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">{{px:rd-radius-md|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:rd-radius-lg|6}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:rd-radius-xl|8}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:rd-radius-full|999}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{rd-white}}</Color>
    <Color x:Key="TextColorDarker">{{rd-muted}}</Color>
    <Color x:Key="TextColorDark">{{rd-ink}}</Color>
    <Color x:Key="MainColor">{{rd-surface}}</Color>
    <Color x:Key="MainColorDark">{{rd-panel}}</Color>
    <Color x:Key="HoverColor">{{rd-surface-hover}}</Color>
    <Color x:Key="GlyphColor">{{rd-cyan}}</Color>
    <Color x:Key="HighlightGlyphColor">{{rd-cyan-wash}}</Color>
    <Color x:Key="PopupBackgroundColor">{{rd-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{rd-border-strong}}</Color>
    <Color x:Key="BackgroundToneColor">{{rd-shell}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{rd-border-subtle}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{rd-border-subtle}}</Color>
    <Color x:Key="DataChangeNotifColor">{{rd-spray-orange}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{rd-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{rd-panel}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{rd-surface-raised}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{rd-off-bg}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{rd-drive-run}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{rd-crimson}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{rd-challenger-gold}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{rd-spray-orange}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{rd-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{rd-shell}}" />

    <!-- Shell & Game page -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{rd-shell}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{rd-canvas}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{rd-shell}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{rd-void}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{rd-panel}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{rd-surface}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{rd-pure-white}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{rd-border}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{rd-magenta-neon}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{rd-cyan}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{rd-scrim}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{rd-canvas}}" />
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{rd-magenta-tint}}" />

    <!-- States (Luminous Violet -> Neon Magenta Active + Glowing Pure White Ink) -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{rd-grad-mid}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{rd-grad-hover-end}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{rd-ice-rim}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{rd-pure-white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{rd-surface-raised}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{rd-grad-mid}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{rd-grad-mid}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{rd-drive-run}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{rd-cyan}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{rd-cyan-wash}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{rd-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{rd-pure-white}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{rd-white}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{rd-pure-white}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{rd-white}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{rd-surface-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{rd-surface-pressed}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{rd-border-strong}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{rd-magenta}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{rd-ice-rim}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{rd-magenta-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{rd-magenta-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{rd-pure-white}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{rd-magenta-glow}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{rd-surface-raised}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{rd-border-strong}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{rd-surface-hover}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{rd-surface-pressed}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{rd-grad-mid}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{rd-void}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{rd-panel}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{rd-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{rd-magenta-neon}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{rd-off-border}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{rd-magenta-neon}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{rd-grad-hover-end}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{rd-void}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{rd-ice-lit}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{rd-magenta-neon}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{rd-pure-white}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{rd-drive-run}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{rd-void}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{rd-magenta-neon}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{rd-ice-lit}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{rd-void}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{rd-royal-lit}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{rd-magenta-neon}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{rd-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{rd-pure-white}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{rd-magenta-neon}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{rd-cyan}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{rd-void}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{rd-cyan}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{rd-ice-rim}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{rd-surface-raised}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{rd-grad-mid}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{rd-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{rd-pure-white}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{rd-surface-raised}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{rd-white}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{rd-grad-mid}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{rd-cyan}}" />

    <!-- Popups, Frames & Typography -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{rd-border}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{rd-white}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{rd-border-strong}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{rd-panel}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{rd-pure-white}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{rd-border-strong}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{rd-ink}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{rd-magenta-neon}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{rd-cyan-band}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{rd-pure-white}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{rd-bevel-light}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{rd-bevel-shadow}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{rd-pure-white}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{rd-cyan}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{rd-magenta-neon}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{rd-border}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{rd-magenta-neon}}" />

    <!-- Theme-local decorative solid brushes -->
    <SolidColorBrush x:Key="LocalIceFacetBrush" Color="{{rd-ice-facet}}" />
    <SolidColorBrush x:Key="LocalIceLitBrush" Color="{{rd-ice-lit}}" />
    <SolidColorBrush x:Key="LocalMagentaNeonBrush" Color="{{rd-magenta-neon}}" />
    <SolidColorBrush x:Key="LocalMagentaBrush" Color="{{rd-magenta}}" />
    <SolidColorBrush x:Key="LocalMagentaDeepBrush" Color="{{rd-magenta-deep}}" />
    <SolidColorBrush x:Key="LocalVioletGlowBrush" Color="{{rd-violet-glow}}" />
    <SolidColorBrush x:Key="LocalCyanWashBrush" Color="{{rd-cyan-wash}}" />
    <SolidColorBrush x:Key="LocalCyanHoverBrush" Color="{{rd-cyan-hover}}" />
    <SolidColorBrush x:Key="LocalRoyalBrush" Color="{{rd-royal}}" />
    <SolidColorBrush x:Key="LocalRoyalLitBrush" Color="{{rd-royal-lit}}" />
    <SolidColorBrush x:Key="LocalRoyalWashBrush" Color="{{rd-royal-wash}}" />
    <SolidColorBrush x:Key="LocalDriveBrightBrush" Color="{{rd-drive-bright}}" />
    <SolidColorBrush x:Key="LocalDriveLimeBrush" Color="{{rd-drive-lime}}" />
    <SolidColorBrush x:Key="LocalDriveBlockFillBrush" Color="{{rd-drive-block-fill}}" />
    <SolidColorBrush x:Key="LocalDriveBlockRimBrush" Color="{{rd-drive-block-rim}}" />
    <SolidColorBrush x:Key="LocalScorePinkBrush" Color="{{rd-score-pink}}" />
    <SolidColorBrush x:Key="LocalScoreBlueBrush" Color="{{rd-score-blue}}" />
    <SolidColorBrush x:Key="LocalTealBorderBrush" Color="{{rd-teal-border}}" />
    <SolidColorBrush x:Key="LocalTealGlowBrush" Color="{{rd-teal-glow}}" />
    <SolidColorBrush x:Key="LocalTealTextBrush" Color="{{rd-teal-text}}" />
    <SolidColorBrush x:Key="LocalTealBarBrush" Color="{{rd-teal-bar}}" />
    <SolidColorBrush x:Key="LocalGoldStartBrush" Color="{{rd-gold-start}}" />
    <SolidColorBrush x:Key="LocalGoldRimBrush" Color="{{rd-gold-rim}}" />
    <SolidColorBrush x:Key="LocalChallengerGoldBrush" Color="{{rd-challenger-gold}}" />
    <SolidColorBrush x:Key="LocalDangerLitBrush" Color="{{rd-crimson-lit}}" />
    <SolidColorBrush x:Key="LocalOffBgBrush" Color="{{rd-off-bg}}" />
    <SolidColorBrush x:Key="LocalOffBorderBrush" Color="{{rd-off-border}}" />
    <SolidColorBrush x:Key="LocalOffFgBrush" Color="{{rd-off-fg}}" />

    <!-- Theme-local cool ultraviolet -> electric royal-purple -> neon magenta gradients -->
    <LinearGradientBrush x:Key="LocalPanelGradientBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="{{rd-surface}}" Offset="0" />
        <GradientStop Color="{{rd-panel}}" Offset="0.52" />
        <GradientStop Color="{{rd-panel-deep}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalShellGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{{rd-shell}}" Offset="0" />
        <GradientStop Color="{{rd-panel}}" Offset="0.6" />
        <GradientStop Color="{{rd-shell}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalIdleCardGradientBrush" StartPoint="0,0" EndPoint="1,0.4">
        <GradientStop Color="{{rd-card-start}}" Offset="0" />
        <GradientStop Color="{{rd-card-end}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalActiveGradientBrush" StartPoint="0,0" EndPoint="1,0.35">
        <GradientStop Color="{{rd-grad-start}}" Offset="0" />
        <GradientStop Color="{{rd-grad-mid}}" Offset="0.48" />
        <GradientStop Color="{{rd-grad-end}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalActiveHoverGradientBrush" StartPoint="0,0" EndPoint="1,0.35">
        <GradientStop Color="{{rd-grad-hover-start}}" Offset="0" />
        <GradientStop Color="{{rd-magenta}}" Offset="0.46" />
        <GradientStop Color="{{rd-grad-hover-end}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalPlayGradientBrush" StartPoint="0,0" EndPoint="1,0.55">
        <GradientStop Color="{{rd-play-start}}" Offset="0" />
        <GradientStop Color="{{rd-play-mid}}" Offset="0.52" />
        <GradientStop Color="{{rd-play-end}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalPlayHoverGradientBrush" StartPoint="0,0" EndPoint="1,0.55">
        <GradientStop Color="{{rd-grad-hover-start}}" Offset="0" />
        <GradientStop Color="{{rd-magenta-lit}}" Offset="0.5" />
        <GradientStop Color="{{rd-grad-hover-end}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalOnSwitchGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{{rd-on-start}}" Offset="0" />
        <GradientStop Color="{{rd-on-end}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalHeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{{rd-royal}}" Offset="0" />
        <GradientStop Color="{{rd-grad-mid}}" Offset="0.6" />
        <GradientStop Color="{{rd-grad-end}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalScrollThumbGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{rd-violet-glow}}" Offset="0" />
        <GradientStop Color="{{rd-magenta-neon}}" Offset="0.5" />
        <GradientStop Color="{{rd-violet-glow}}" Offset="1" />
    </LinearGradientBrush>

    <!-- Pause Mode Translucent Deep Teal-Indigo Glass & Sunburst Amber-Gold Gradients -->
    <LinearGradientBrush x:Key="LocalTealGlassCardBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="{{rd-teal-card-top}}" Offset="0" />
        <GradientStop Color="{{rd-teal-card}}" Offset="0.52" />
        <GradientStop Color="{{rd-teal-deep}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalTealTabActiveBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{rd-teal-tab-top}}" Offset="0" />
        <GradientStop Color="{{rd-teal-tab-bot}}" Offset="0.72" />
        <GradientStop Color="{{rd-teal-glow}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalTealRibbonBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{{rd-teal-tab-top}}" Offset="0" />
        <GradientStop Color="{{rd-teal-tab-bot}}" Offset="0.75" />
        <GradientStop Color="{{rd-teal-border}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalSunburstGoldBrush" StartPoint="0,0" EndPoint="1,0.3">
        <GradientStop Color="{{rd-gold-start}}" Offset="0" />
        <GradientStop Color="{{rd-gold-mid}}" Offset="0.52" />
        <GradientStop Color="{{rd-gold-end}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalSunburstGoldHoverBrush" StartPoint="0,0" EndPoint="1,0.3">
        <GradientStop Color="{{rd-gold-mid}}" Offset="0" />
        <GradientStop Color="{{rd-gold-end}}" Offset="0.6" />
        <GradientStop Color="{{rd-gold-rim}}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
