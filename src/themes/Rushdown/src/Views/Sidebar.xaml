<!--
    Rushdown: Views/Sidebar.xaml.
    44px midnight indigo rail closed by a 1px steel-indigo hairline + 76px Battle Hub Cyan segment,
    crowned by a 44x48 isometric graffiti cube Main Menu tile with 2.5px Neon Magenta laser top trim.
    Turns transparent when ShowBackgroundImageOnWindow=True. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <DockPanel x:Name="DockContentHolder">
                                <!-- Isometric street-graffiti cube Main Menu tile -->
                                <Border x:Name="PART_ElemMainMenu" Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                        Width="44" Height="48" Margin="0,0,0,6"
                                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,0,1"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Border x:Name="MenuHoverPlate" Background="{DynamicResource LocalActiveGradientBrush}"
                                                BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1"
                                                Effect="{DynamicResource LocalMagentaGlowEffect}"
                                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                            <Rectangle Fill="{DynamicResource LocalIceLitBrush}" Opacity="0.16"
                                                       OpacityMask="{DynamicResource LocalIceFacetMaskBrush}" />
                                        </Border>
                                        <Control x:Name="MenuMark" Width="22" Height="22"
                                                 Template="{DynamicResource BrandMarkTemplate}"
                                                 Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                 Effect="{DynamicResource LocalTitleGlowEffect}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsHitTestVisible="False" />
                                        <Rectangle x:Name="MenuLaserTrim" Height="2.5" VerticalAlignment="Top"
                                                   Fill="{DynamicResource LocalMagentaNeonBrush}"
                                                   Effect="{DynamicResource LocalSubtleGlowEffect}"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                            <!-- Subtle steel-indigo right border + 76px Battle Hub Cyan segment -->
                            <Border x:Name="RailDivider" Width="1" HorizontalAlignment="Right" IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" Background="{DynamicResource NormalBorderBrush}">
                                <Rectangle Height="76" Margin="0,48,0,0" VerticalAlignment="Top"
                                           Fill="{DynamicResource FocusBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Background" Value="Transparent" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailDivider" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuLaserTrim" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuMark" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="MenuHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="RailDivider" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,6,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,136,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailDivider" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,6,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailDivider" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
