<!--
    Rushdown: Media.xaml.
    Bespoke 45-degree chamfered street-arcade vector geometries authored in Rushdown's crisp geometric stencil style
    (24x24 canvas). Menu item icons are the theme's own PNG set (art/menu-icons.json, docs/themes/menu-icons.md).
-->
<ResourceDictionary xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
