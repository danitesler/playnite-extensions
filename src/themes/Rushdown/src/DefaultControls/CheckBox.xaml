<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Street Fighter 6 Shortcut Settings On / Off glowing pill switch CheckBox -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource LocalOffBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalOffBorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0"
                              Width="44"
                              Height="22"
                              VerticalAlignment="Center">
                            <!-- Off state recessed slate plate -->
                            <Border x:Name="OffPlate"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}">
                                <TextBlock x:Name="OffText"
                                           Text="Off"
                                           FontFamily="{DynamicResource FontFamily}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource LocalOffFgBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <!-- On state glowing purple-to-magenta gradient pill (collapsed at rest) -->
                            <Border x:Name="OnPlate"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource LocalOnSwitchGradientBrush}"
                                    BorderBrush="{DynamicResource SelectedBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Effect="{DynamicResource LocalMagentaGlowEffect}">
                                <TextBlock x:Name="OnText"
                                           Text="On"
                                           FontFamily="{DynamicResource FontFamily}"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SelectedForegroundBrush}"
                                           Effect="{DynamicResource LocalTitleGlowEffect}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <!-- Indeterminate state -->
                            <Border x:Name="IndeterminatePlate"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource NormalBrush}"
                                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Effect="{DynamicResource LocalSubtleGlowEffect}">
                                <Rectangle Width="10"
                                           Height="2"
                                           Fill="{DynamicResource SelectedBorderBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ContentPresenter x:Name="ContentPresenter"
                                          Grid.Column="1"
                                          Margin="10,0,0,0"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OffPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="OnPlate" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="OffPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminatePlate" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OffPlate" Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                            <Setter TargetName="OffPlate" Property="Effect" Value="{DynamicResource LocalSubtleGlowEffect}" />
                            <Setter TargetName="OffText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OnPlate" Property="Background" Value="{DynamicResource LocalActiveHoverGradientBrush}" />
                            <Setter TargetName="OnPlate" Property="BorderBrush" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
