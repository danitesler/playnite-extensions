<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- SF6 Pause Mode Luminous Aqua-Teal Glass TabControl ([LB] Special Moves | Perks | Escape [RB]) -->
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalTealBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnDef0" />
                            <ColumnDefinition x:Name="ColumnDef1" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="RowDef0" Height="Auto" />
                            <RowDefinition x:Name="RowDef1" Height="*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="HeaderStrip"
                                Grid.Column="0"
                                Grid.Row="0"
                                Panel.ZIndex="1"
                                Background="{DynamicResource LocalTealBarBrush}"
                                BorderBrush="{DynamicResource LocalTealBorderBrush}"
                                BorderThickness="0,1,0,1">
                            <TabPanel x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      Background="Transparent"
                                      Margin="4,0,4,0"
                                      KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <Border x:Name="ContentPanel"
                                Grid.Column="0"
                                Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="0"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter TargetName="RowDef0" Property="Height" Value="*" />
                            <Setter TargetName="RowDef1" Property="Height" Value="Auto" />
                            <Setter TargetName="HeaderStrip" Property="Grid.Row" Value="1" />
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter TargetName="RowDef0" Property="Height" Value="*" />
                            <Setter TargetName="RowDef1" Property="Height" Value="0" />
                            <Setter TargetName="ColumnDef0" Property="Width" Value="Auto" />
                            <Setter TargetName="ColumnDef1" Property="Width" Value="*" />
                            <Setter TargetName="HeaderStrip" Property="Grid.Column" Value="0" />
                            <Setter TargetName="HeaderStrip" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HeaderStrip" Property="BorderThickness" Value="0,0,1,0" />
                            <Setter TargetName="HeaderPanel" Property="Margin" Value="0,4,0,4" />
                            <Setter TargetName="ContentPanel" Property="Grid.Column" Value="1" />
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter TargetName="RowDef0" Property="Height" Value="*" />
                            <Setter TargetName="RowDef1" Property="Height" Value="0" />
                            <Setter TargetName="ColumnDef0" Property="Width" Value="*" />
                            <Setter TargetName="ColumnDef1" Property="Width" Value="Auto" />
                            <Setter TargetName="HeaderStrip" Property="Grid.Column" Value="1" />
                            <Setter TargetName="HeaderStrip" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HeaderStrip" Property="BorderThickness" Value="1,0,0,0" />
                            <Setter TargetName="HeaderPanel" Property="Margin" Value="0,4,0,4" />
                            <Setter TargetName="ContentPanel" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <!-- Keep TextBrush on TabItem itself so tab pages inherit light text (src/themes/AGENTS.md Tab colours) -->
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7,16,7" />
        <Setter Property="Margin" Value="1,2,1,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="TabRoot" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="HoverPlate"
                                Visibility="Collapsed"
                                Background="{DynamicResource LocalTealGlassCardBrush}"
                                BorderBrush="{DynamicResource LocalTealBorderBrush}"
                                BorderThickness="1"
                                IsHitTestVisible="False" />
                        <!-- Pause Mode active tab: luminous Aqua-Teal glass + crisp 1.5px pure white border + cyan bloom -->
                        <Border x:Name="SelectedPlate"
                                Visibility="Collapsed"
                                Background="{DynamicResource LocalTealTabActiveBrush}"
                                BorderBrush="{DynamicResource PrimaryButtonForegroundBrush}"
                                BorderThickness="1.5"
                                Effect="{DynamicResource LocalTealGlowEffect}"
                                IsHitTestVisible="False" />
                        <TextBlock x:Name="HeaderText"
                                   Margin="{TemplateBinding Padding}"
                                   Foreground="{DynamicResource LocalTealTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter TargetName="HeaderText" Property="HorizontalAlignment" Value="Left" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter TargetName="HeaderText" Property="HorizontalAlignment" Value="Left" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                            <Setter TargetName="HeaderText" Property="Effect" Value="{DynamicResource LocalTealGlowEffect}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
