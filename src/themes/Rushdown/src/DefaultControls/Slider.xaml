<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Needle"
                            Background="{DynamicResource SliderThumbBackgroundBrush}"
                            BorderBrush="{DynamicResource SelectedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="1"
                            Effect="{DynamicResource LocalMagentaGlowEffect}"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Needle" Property="Background" Value="{DynamicResource SliderHoverForegroundBrush}" />
                            <Setter TargetName="Needle" Property="BorderBrush" Value="{DynamicResource SliderThumbHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Needle" Property="Background" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="Needle" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LocalSliderThumbVertical" TargetType="{x:Type Thumb}" BasedOn="{StaticResource SliderThumb}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="8" />
    </Style>

    <Style x:Key="SliderRangeButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="4"
                                VerticalAlignment="Center"
                                CornerRadius="2"
                                Background="{DynamicResource LocalActiveGradientBrush}"
                                Effect="{DynamicResource LocalSubtleGlowEffect}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LocalSliderRangeButtonVertical" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <Border Width="4"
                                HorizontalAlignment="Center"
                                CornerRadius="2"
                                Background="{DynamicResource FocusBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LocalSliderTrackRepeatButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="LocalHorizontalSlider" TargetType="{x:Type Slider}">
        <Grid MinHeight="22" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MinHeight="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TickBar x:Name="TopTick"
                     Grid.Row="0"
                     Height="4"
                     Visibility="Collapsed"
                     Placement="Top"
                     Fill="{DynamicResource TextBrushDarker}" />
            <Border x:Name="TrackBackground"
                    Grid.Row="1"
                    Height="4"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SliderTrackBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2" />
            <Track x:Name="PART_Track" Grid.Row="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderRangeButton}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource LocalSliderTrackRepeatButton}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Style="{StaticResource SliderThumb}" />
                </Track.Thumb>
            </Track>
            <TickBar x:Name="BottomTick"
                     Grid.Row="2"
                     Height="4"
                     Visibility="Collapsed"
                     Placement="Bottom"
                     Fill="{DynamicResource TextBrushDarker}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackBackground" Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalVerticalSlider" TargetType="{x:Type Slider}">
        <Grid MinWidth="22" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MinWidth="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TickBar x:Name="TopTick"
                     Grid.Column="0"
                     Width="4"
                     Visibility="Collapsed"
                     Placement="Left"
                     Fill="{DynamicResource TextBrushDarker}" />
            <Border x:Name="TrackBackground"
                    Grid.Column="1"
                    Width="4"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SliderTrackBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2" />
            <Track x:Name="PART_Track" Grid.Column="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource LocalSliderRangeButtonVertical}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource LocalSliderTrackRepeatButton}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Style="{StaticResource LocalSliderThumbVertical}" />
                </Track.Thumb>
            </Track>
            <TickBar x:Name="BottomTick"
                     Grid.Column="2"
                     Width="4"
                     Visibility="Collapsed"
                     Placement="Right"
                     Fill="{DynamicResource TextBrushDarker}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template" Value="{StaticResource LocalHorizontalSlider}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource LocalVerticalSlider}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerHeight" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerDarken" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
