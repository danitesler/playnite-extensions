<!--
    Rushdown: DefaultControls/ContextMenu.xaml.
    Panel signature: Street Fighter 6 Fighting Ground Information / Shortcut Settings modal board
    (LocalMenuBoardTemplate) — deep luminous ultraviolet gradient (#260A52 -> #1C063E -> #14042E),
    double glowing neon violet perimeter frame with outer purple bloom (LocalElementGlowEffect),
    crowned by a 2.5px Neon Magenta top laser rule dipping at top-center into the Information downward
    V-notch pointer, and sparse 5.5% graffiti shard mist (prism-splash.png).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared glowing board chrome hosted by ContextMenu, SubmenuHeader popups, and ComboBox popups -->
    <ControlTemplate x:Key="LocalMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid Margin="6" IsHitTestVisible="False">
            <Border Background="{DynamicResource LocalPanelGradientBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="{DynamicResource CornerRadiusLarge}"
                    Effect="{DynamicResource LocalElementGlowEffect}"
                    SnapsToDevicePixels="True" />
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource SelectedBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusLarge}"
                    Opacity="0.32"
                    SnapsToDevicePixels="True"
                    ClipToBounds="True">
                <Grid>
                    <!-- Inner double frame line (Shortcut Settings / Information modal style) -->
                    <Border Margin="2.5" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.7" />
                    <!-- Subtle shard mist texture -->
                    <Rectangle Fill="{DynamicResource LocalMagentaNeonBrush}" Opacity="0.055"
                               OpacityMask="{DynamicResource LocalPrismSplashMaskBrush}" />
                    <!-- 2.5px Neon Magenta top laser crown + downward Information V-notch -->
                    <Grid Height="10" VerticalAlignment="Top">
                        <Rectangle Height="2.5" VerticalAlignment="Top" Fill="{DynamicResource LocalMagentaNeonBrush}" />
                        <Path Data="M 0,0 L 18,0 L 9,7 Z" HorizontalAlignment="Center" VerticalAlignment="Top"
                              Fill="{DynamicResource LocalMagentaNeonBrush}" />
                    </Grid>
                    <!-- Thin Electric Cyan bottom accent tick -->
                    <Rectangle Height="1.5" Width="64" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Fill="{DynamicResource FocusBrush}" Opacity="0.72" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="MinWidth" Value="236" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="12,18,12,12"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
