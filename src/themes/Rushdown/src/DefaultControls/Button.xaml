<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource LocalIdleCardGradientBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="12,5,12,5" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CornerRadiusSmall}"
                            Effect="{DynamicResource LocalSubtleGlowEffect}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="TopAccent"
                                    Height="1"
                                    VerticalAlignment="Top"
                                    Margin="1,0,1,0"
                                    Background="{DynamicResource SelectedBorderBrush}"
                                    Opacity="0.28"
                                    IsHitTestVisible="False" />
                            <Border x:Name="HoverSheen"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource LocalIceFacetMaskBrush}"
                                    Opacity="0.16"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    IsHitTestVisible="False" />
                            <ContentPresenter x:Name="ContentPresenter"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Pause Mode Sunburst Amber-Gold Confirm button ("Confirm" / Save / OK) -->
                        <Trigger Property="IsDefault" Value="True">
                            <Setter Property="Background" Value="{DynamicResource LocalSunburstGoldBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource LocalGoldRimBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter TargetName="RootBorder" Property="Effect" Value="{DynamicResource LocalGoldGlowEffect}" />
                            <Setter TargetName="TopAccent" Property="Background" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                            <Setter TargetName="TopAccent" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource LocalActiveGradientBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
                            <Setter TargetName="RootBorder" Property="Effect" Value="{DynamicResource LocalMagentaGlowEffect}" />
                            <Setter TargetName="ContentPresenter" Property="Effect" Value="{DynamicResource LocalTitleGlowEffect}" />
                            <Setter TargetName="HoverSheen" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TopAccent" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource LocalSunburstGoldHoverBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                            <Setter TargetName="RootBorder" Property="Effect" Value="{DynamicResource LocalGoldGlowEffect}" />
                            <Setter TargetName="ContentPresenter" Property="Effect" Value="{x:Null}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource LocalMagentaNeonBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            <Setter TargetName="RootBorder" Property="Effect" Value="{DynamicResource LocalMagentaGlowEffect}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Width" Value="41">
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
