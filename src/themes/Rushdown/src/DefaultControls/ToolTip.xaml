<!--
    Rushdown: DefaultControls/ToolTip.xaml.
    Information modal tooltip card: deep ultraviolet gradient board with glowing double neon violet rim,
    outer purple bloom (LocalElementGlowEffect), and Neon Magenta top laser rule with downward V-notch.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource TooltipBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TooltipForegroundBrush}" />
        <Setter Property="Padding" Value="{DynamicResource TooltipPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Grid Margin="6">
                        <Border Background="{DynamicResource LocalPanelGradientBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Effect="{DynamicResource LocalElementGlowEffect}"
                                SnapsToDevicePixels="True" />
                        <Border Background="Transparent"
                                BorderBrush="{DynamicResource SelectedBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Opacity="0.35"
                                SnapsToDevicePixels="True" ClipToBounds="True">
                            <Grid>
                                <Rectangle Height="2.5" VerticalAlignment="Top" Fill="{DynamicResource LocalMagentaNeonBrush}" IsHitTestVisible="False" />
                                <Path Data="M 0,0 L 14,0 L 7,6 Z" HorizontalAlignment="Center" VerticalAlignment="Top"
                                      Fill="{DynamicResource LocalMagentaNeonBrush}" IsHitTestVisible="False" />
                                <ContentPresenter Margin="10,11,10,8" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
