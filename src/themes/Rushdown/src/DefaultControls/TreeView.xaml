<!--
    Rushdown: DefaultControls/TreeView.xaml.
    Settings & Add-ons navigation tree (docs/themes/settings-screens.md):
    - Minimal bare 28px Barlow body-font rows (zero idle boxes/cards).
    - Separate animated layers: soft cyan hover wash (HoverPlate), selected held royal-indigo wash (SelectedPlate) +
      3px Prismatic White-Ice left edge bar (SelectedBar) + Battle Hub Cyan diamond indicator pip (SelectedPip) + bright label.
    - WindowSettings (248px) and WindowExtensions (280px) triggers set VerticalScrollBarVisibility=Visible
      and HorizontalScrollBarVisibility=Disabled so expanding nodes never jumps the layout.
    - Sized 14x14 expander toggle hidden on leaf items so labels stay aligned; Playnite Separator items non-selectable.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LocalTreeExpanderToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="14" Height="14">
                        <ContentControl x:Name="ExpGlyph" Content="{DynamicResource IconSubmenu}"
                                        ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{DynamicResource FocusBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ExpGlyph" Property="Content" Value="{DynamicResource IconDropDown}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Margin" Value="0,0,0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="RowGrid" Grid.Row="0" MinHeight="28" Background="Transparent" SnapsToDevicePixels="True">
                            <!-- Soft violet hover wash (collapsed at rest) -->
                            <Border x:Name="HoverPlate" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Background="{DynamicResource LocalCyanHoverBrush}"
                                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            <!-- Selected luminous violet-to-magenta gradient bar -->
                            <Border x:Name="SelectedPlate" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Background="{DynamicResource LocalActiveGradientBrush}"
                                    BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1"
                                    Effect="{DynamicResource LocalSubtleGlowEffect}"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            <!-- 3px glowing lavender-white left accent bar -->
                            <Border x:Name="SelectedBar" Width="3" Margin="0,3,0,3" HorizontalAlignment="Left"
                                    CornerRadius="1.5" Background="{DynamicResource SelectedBorderBrush}"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            <!-- Glowing diamond indicator pip -->
                            <Border x:Name="SelectedPip" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,9,0" Background="{DynamicResource SelectedBorderBrush}"
                                    Effect="{DynamicResource LocalSubtleGlowEffect}"
                                    RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                            </Border>

                            <DockPanel Margin="8,2,20,2" VerticalAlignment="Center">
                                <ToggleButton x:Name="Expander" DockPanel.Dock="Left"
                                              Width="14" Height="14"
                                              Style="{StaticResource LocalTreeExpanderToggle}"
                                              IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press" VerticalAlignment="Center" />
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="MaxWidth" Value="184" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DockPanel>
                        </Grid>

                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="18,1,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" SourceName="RowGrid" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeSelectIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPip" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedPip" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeSelectOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedPip" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPip" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding Header.Tag, RelativeSource={RelativeSource Self}}" Value="TreeSeparator">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="RowGrid" Property="MinHeight" Value="12" />
                            <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,6,4,6" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="{x:Type Separator}">
                <Setter Property="Tag" Value="TreeSeparator" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Separator}">
                            <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource NormalBorderBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowSettings">
                <Setter Property="Width" Value="248" />
                <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowExtensions">
                <Setter Property="Width" Value="280" />
                <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
