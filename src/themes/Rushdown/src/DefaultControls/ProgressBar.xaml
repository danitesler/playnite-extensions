<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- SF6 Training-Mode 6-block slanted Drive Gauge ProgressBar (\ emerald fill + neon lime outline) -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="RootGrid"
                          Height="{TemplateBinding Height}"
                          MinHeight="10"
                          Background="Transparent"
                          SnapsToDevicePixels="True">
                        <!-- 6 recessed empty slanted Drive Gauge slots -->
                        <Border x:Name="PART_Track"
                                Background="{DynamicResource LocalDriveEmptyBlocksBrush}" />
                        <!-- Determinate fill clipping 1:1 over the full 6-block Drive Gauge grid -->
                        <Grid x:Name="PART_Indicator"
                              HorizontalAlignment="Left"
                              ClipToBounds="True">
                            <Rectangle Width="{Binding ActualWidth, ElementName=PART_Track}"
                                       Height="{Binding ActualHeight, ElementName=PART_Track}"
                                       HorizontalAlignment="Left"
                                       Fill="{DynamicResource LocalDriveBlocksBrush}"
                                       Effect="{DynamicResource LocalScoreGreenGlowEffect}" />
                        </Grid>
                        <!-- Indeterminate sweep across the 6 slanted Drive blocks -->
                        <Grid x:Name="IndeterminateTrack"
                              Visibility="Collapsed"
                              ClipToBounds="True">
                            <Rectangle Fill="{DynamicResource LocalDriveBlocksBrush}"
                                       Effect="{DynamicResource LocalScoreGreenGlowEffect}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="IndetTail" Color="#00000000" Offset="-0.35" />
                                        <GradientStop x:Name="IndetMid" Color="#FF000000" Offset="-0.1" />
                                        <GradientStop x:Name="IndetHead" Color="#00000000" Offset="0.15" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateTrack" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndetTail" Storyboard.TargetProperty="Offset" From="-0.35" To="0.85" Duration="0:0:1.25" />
                                        <DoubleAnimation Storyboard.TargetName="IndetMid" Storyboard.TargetProperty="Offset" From="-0.1" To="1.1" Duration="0:0:1.25" />
                                        <DoubleAnimation Storyboard.TargetName="IndetHead" Storyboard.TargetProperty="Offset" From="0.15" To="1.35" Duration="0:0:1.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootGrid" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
