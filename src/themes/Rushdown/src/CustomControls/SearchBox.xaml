<!--
    Rushdown: CustomControls/SearchBox.xaml.
    Deep void search well with persistent magnifier outside PART_SeachIcon
    (TextBrushDarker at rest; GlyphBrush Battle Hub Cyan when focused or nonempty).
    PART_ClearTextIcon carries an explicit full-hit transparent Border template.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Field" Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1.2" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <ContentControl x:Name="Glyph" Focusable="False"
                                                Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}"
                                                Foreground="{DynamicResource GlyphBrush}" Margin="9,0,0,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" />
                                <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                                <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                         Padding="32,0,28,0" VerticalContentAlignment="Center" />
                                <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}"
                                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,7,0" Cursor="Hand"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ContentControl.Template>
                                        <ControlTemplate TargetType="ContentControl">
                                            <Border Background="Transparent" Padding="4">
                                                <ContentPresenter ContentSource="Content" />
                                            </Border>
                                        </ControlTemplate>
                                    </ContentControl.Template>
                                </ContentControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                            <Setter TargetName="Field" Property="Effect" Value="{DynamicResource LocalSubtleGlowEffect}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            <Setter TargetName="Field" Property="Effect" Value="{DynamicResource LocalMagentaGlowEffect}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
