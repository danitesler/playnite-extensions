<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml.
    A column of the pause menu's lobby screen: the title on its own 38px header plate (PAUSE_BG), white condensed
    capitals 10px in, 3px above the body; the body sits on the page with no card. Padding comes from GroupBoxPadding
    and the gap under the header from GroupBoxHeaderMargin.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel Background="{TemplateBinding Background}">
                        <Border DockPanel.Dock="Top" MinHeight="38" Background="{DynamicResource ExpanderBackgroundBrush}"
                                Margin="{DynamicResource GroupBoxHeaderMargin}" Padding="10,0,10,0">
                            <TextBlock Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeLarge}"
                                       FontFamily="{DynamicResource HeadingFontFamily}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource HeadingForegroundBrush}">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                  RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </TextBlock>
                        </Border>
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
