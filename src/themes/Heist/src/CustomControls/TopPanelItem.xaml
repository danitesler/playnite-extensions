<!--
    Overlay on Playnite Default/CustomControls/TopPanelItem.xaml.
    An item of the top bar as a pause menu tab: a square PAUSE_BG plate 38px tall, 4px from its neighbours, under an
    8px bar (46px in all). Icon items are 38px square; the view switches are text tabs (their templates are in
    Views/TopPanel.xaml). Under the pointer the plate gets the menus' 8% white wash; toggled (the current view, the
    open explorer panel) it is the selected tab: a solid white plate with black content and the freemode blue bar over
    it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TopPanelItem}">
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Height" Value="46" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="9,0,9,0" />
        <Setter Property="ToolTip" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanelItem}">
                    <DockPanel>
                        <Border x:Name="Bar" DockPanel.Dock="Top" Height="8" Background="{TemplateBinding BorderBrush}" />
                        <Grid x:Name="Plate" Background="{TemplateBinding Background}">
                            <Border x:Name="Hover" Background="{DynamicResource TopPanelItemHoverBackgroundBrush}" Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Grid>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Hover" />
                        </Trigger>
                        <Trigger Property="IsToggled" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Hover" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsToggled" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TabItemIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
