<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    A keyboard entry field in the pause menu's terms: a square plate (its host sets the fill; PAUSE_BG on the tab
    strip), a 1px edge that lightens under the pointer and turns freemode blue while typing, white text.
    PART_SeachIcon doubles as the placeholder (Playnite hides it while the field has focus or text): the search glyph
    and "Search" in the menus' grey. PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Field" Background="{TemplateBinding Background}" BorderThickness="1"
                            BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}">
                        <Grid>
                            <StackPanel x:Name="PART_SeachIcon" Orientation="Horizontal" IsHitTestVisible="False"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"
                                        TextElement.Foreground="{DynamicResource TextBrushDarker}">
                                <ContentPresenter Width="16" Height="16" VerticalAlignment="Center"
                                                  Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" />
                                <TextBlock Text="{DynamicResource LOCSearchLabel}" Margin="8,0,0,1" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSize}"
                                           Foreground="{DynamicResource TextBrushDarker}" />
                            </StackPanel>
                            <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     VerticalContentAlignment="Center" Padding="10,0,30,0" />
                            <ContentControl x:Name="PART_ClearTextIcon" Width="14" Height="14" Cursor="Hand"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"
                                            Foreground="{DynamicResource TextBrushDarker}"
                                            Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Field" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Field" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ClearTextIcon">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="PART_ClearTextIcon" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
