<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    On the rail: a pause menu row turned square, a 44px PAUSE_BG plate with a 20px white glyph, 3px under the one
    above; the menus' 8% white wash under the pointer, and the current item is the selected row: a solid white plate
    with a black glyph. Library is IconLibrary, Statistics IconStatistics; add-on items keep their own icon, scaled
    into the 20px box. The title is the tooltip. Docked at the top or bottom, views become text tabs (condensed
    capitals on the same plates, white with black text when current) and buttons stay icons.
    PART_ProgressStatus is a 3px freemode blue bar along the bottom of the plate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="ToolTip" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid x:Name="Root" Background="{DynamicResource ButtonBackgroundBrush}">
                        <Border x:Name="Plate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Grid>
                                <Grid x:Name="IconHost" Width="20" Height="20"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox x:Name="ItemIcon">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    </Viewbox>
                                    <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                    ContentTemplate="{DynamicResource IconTemplate}" />
                                </Grid>
                                <ProgressBar x:Name="PART_ProgressStatus" Height="3" VerticalAlignment="Bottom"
                                             BorderThickness="0" Background="Transparent" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="Label" Visibility="Collapsed" Margin="18,0,18,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{Binding Title, Converter={StaticResource StringToUpperCaseConverter}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" TargetName="Root" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="IconHost" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Label" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <!-- Docked at the top or bottom: a view is a text tab over the full height of the strip. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings SidebarPosition}" Value="Top" />
                                <Condition Binding="{Binding Type}" Value="View" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="IconHost" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Label" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings SidebarPosition}" Value="Bottom" />
                                <Condition Binding="{Binding Type}" Value="View" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="IconHost" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Label" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Settings SidebarPosition}" Value="Top" />
                    <Condition Binding="{Binding Type}" Value="View" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Settings SidebarPosition}" Value="Bottom" />
                    <Condition Binding="{Binding Type}" Value="View" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </MultiDataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
