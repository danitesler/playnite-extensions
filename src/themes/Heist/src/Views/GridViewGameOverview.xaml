<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml: the game panel beside the cover grid.
    The same page as the details view, narrower: art band, the name in condensed type, Play as the current tab and
    square Options and edit plates under it, Steam screenshots, then description and notes beside the metadata pane,
    whose fields are stat row plates with the caption above the value. The panel lies on the light panel (black at
    30%) with a 1px separator toward the grid; a square close button sits over the top-right corner. Every PART_
    element of Playnite's file is kept, plus PART_ImageBackground for the band.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            Background="{DynamicResource GameOverviewBackgroundBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" Margin="0,20,0,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <Grid>
                                    <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.CacheMode>
                                            <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                        </Grid.CacheMode>
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Black" Offset="0" />
                                                <GradientStop Color="Black" Offset="0.45" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <!-- Darkens the art toward the title: black, clear at the top, 70% at the bottom. -->
                                        <Rectangle Fill="{DynamicResource ScrimBrush}">
                                            <Rectangle.OpacityMask>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#00000000" Offset="0.2" />
                                                    <GradientStop Color="#B2000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Grid>
                                    <StackPanel Margin="24,0,24,24">
                                        <Border IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="170" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <DockPanel Margin="0,16,0,16">
                                            <Image x:Name="PART_ImageIcon" MaxHeight="36" MaxWidth="36" DockPanel.Dock="Left" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" MinWidth="180" Height="48" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" MinWidth="180" Height="48" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Width="48" Height="48" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                                <ContentControl Width="20" Height="20" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Width="48" Height="48" Padding="0" Margin="8,0,0,0" Focusable="False">
                                                <ContentControl Width="20" Height="20" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" VerticalAlignment="Top" Width="{DynamicResource GridDetailsPaneWidth}" Margin="24,0,0,0"
                                                    Background="Transparent" Padding="0"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <Border ClipToBounds="True">
                                                    <StackPanel Margin="0,-12,0,-3">
                                                        <Border x:Name="MetaProgress" Margin="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemCompletionStatus" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <Button x:Name="PART_ButtonCompletionStatus" Margin="10,0,10,9" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemPlayTime" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <TextBlock x:Name="PART_TextPlayTime" Margin="10,0,10,9" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemLastPlayed" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <TextBlock x:Name="PART_TextLastActivity" Margin="10,0,10,9" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemRecentActivity" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <TextBlock x:Name="PART_TextRecentActivity" Margin="10,0,10,9" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemAdded" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <TextBlock x:Name="PART_TextAdded" Margin="10,0,10,9" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" Margin="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemCommunityScore" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <TextBlock x:Name="PART_TextCommunityScore" Margin="10,0,10,9" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemCriticScore" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <TextBlock x:Name="PART_TextCriticScore" Margin="10,0,10,9" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemUserScore" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCUserScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <TextBlock x:Name="PART_TextUserScore" Margin="10,0,10,9" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout" Margin="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemDevelopers" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCDevelopersLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <ItemsControl x:Name="PART_ItemsDevelopers" Margin="10,0,10,9" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemPublishers" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCPublishersLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <ItemsControl x:Name="PART_ItemsPublishers" Margin="10,0,10,9" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemReleaseDate" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <Button x:Name="PART_ButtonReleaseDate" Margin="10,0,10,9" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemSeries" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCSeriesLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <ItemsControl x:Name="PART_ItemsSeries" Margin="10,0,10,9" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemAgeRating" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <ItemsControl x:Name="PART_ItemsAgeRatings" Margin="10,0,10,9" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemRegion" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCRegionLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <ItemsControl x:Name="PART_ItemsRegions" Margin="10,0,10,9" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaTags" Margin="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemPlatform" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCPlatformsTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="10,3,7,7">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemGenres" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCGenresLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="10,3,7,7">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemCategories" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCCategoriesLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <ItemsControl x:Name="PART_ItemsCategories" Tag="Chip" Margin="10,3,7,7">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemFeatures" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <ItemsControl x:Name="PART_ItemsFeatures" Tag="Chip" Margin="10,3,7,7">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemTags" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCTagsLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <ItemsControl x:Name="PART_ItemsTags" Tag="Chip" Margin="10,3,7,7">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaLibrary" Margin="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemLibrary" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <Button x:Name="PART_ButtonLibrary" Margin="10,0,10,9" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemSource" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCSourceLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <Button x:Name="PART_ButtonSource" Margin="10,0,10,9" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemVersion" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCVersionLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <Button x:Name="PART_ButtonVersion" Margin="10,0,10,9" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemInstallSize" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <TextBlock x:Name="PART_TextInstallSize" Margin="10,0,10,9" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemInstallDirectory" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <Button x:Name="PART_ButtonInstallDirectory" Margin="10,0,10,9" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaLinks" Margin="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemLinks" Margin="0,0,0,3" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                                    <TextBlock Text="{DynamicResource LOCLinksLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="10,8,10,3" />
                                                                    <ItemsControl x:Name="PART_ItemsLinks" Margin="10,0,10,9" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <StackPanel>
                                        <Grid Margin="0,0,0,24">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library games in that gap; give up after 12s. With the plugin missing or disabled the binding falls back to PluginUnavailable, which matches neither True nor False. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <StackPanel>
                                                <ContentControl Content="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" Focusable="False" IsTabStop="False" Margin="14,12,14,12">
                                                    <ContentControl.ContentTemplate>
                                                        <DataTemplate>
                                                            <Border BorderThickness="0,0,0,2" BorderBrush="{DynamicResource HeadingForegroundBrush}" Padding="0,0,0,6">
                                                                <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}"
                                                                           FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                                                           Foreground="{DynamicResource HeadingForegroundBrush}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ContentControl.ContentTemplate>
                                                </ContentControl>
                                                <Grid>
                                                    <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                    <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}"
                                                             Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                        <Control.Style>
                                                            <Style TargetType="Control">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Control.Style>
                                                    </Control>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                                <StackPanel x:Name="PART_ElemDescription" Margin="0,0,0,12" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                    <ContentControl Content="{DynamicResource LOCGameDescriptionTitle}" Focusable="False" IsTabStop="False" Margin="0,0,0,12">
                                                        <ContentControl.ContentTemplate>
                                                            <DataTemplate>
                                                                <Border BorderThickness="0,0,0,2" BorderBrush="{DynamicResource HeadingForegroundBrush}" Padding="0,0,0,6">
                                                                    <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}"
                                                                               FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                                                               Foreground="{DynamicResource HeadingForegroundBrush}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ContentControl.ContentTemplate>
                                                    </ContentControl>
                                                    <HtmlTextView x:Name="PART_HtmlDescription" Margin="14,0,14,14"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}" Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </StackPanel>
                                                <StackPanel x:Name="PART_ElemNotes" Margin="0,0,0,12" Background="{DynamicResource ExpanderBackgroundBrush}">
                                                    <ContentControl Content="{DynamicResource LOCNotesLabel}" Focusable="False" IsTabStop="False" Margin="0,0,0,12">
                                                        <ContentControl.ContentTemplate>
                                                            <DataTemplate>
                                                                <Border BorderThickness="0,0,0,2" BorderBrush="{DynamicResource HeadingForegroundBrush}" Padding="0,0,0,6">
                                                                    <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}"
                                                                               FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                                                               Foreground="{DynamicResource HeadingForegroundBrush}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ContentControl.ContentTemplate>
                                                    </ContentControl>
                                                    <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                             AcceptsReturn="True" TextWrapping="Wrap" Margin="13,0,13,14" Padding="0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Width="32" Height="32" Padding="0"
                                    Command="{MainViewModel CloseGameSideBarCommand}" Background="{DynamicResource PopupBackgroundBrush}">
                                <ContentControl Width="14" Height="14" Focusable="False" IsTabStop="False"
                                                Content="{DynamicResource IconWindowClose}" ContentTemplate="{DynamicResource IconTemplate}" />
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
