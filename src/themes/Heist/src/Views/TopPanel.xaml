<!--
    Overlay on Playnite Default/Views/TopPanel.xaml.
    The pause menu's header and tab strip, stacked over the library:
      - a 56px header row with the title at the left in large condensed capitals (the place of the game's title; here
        the localized "Library"), a running task and the notifications at the right, and 150px kept clear for the
        caption buttons, where the game prints the player's name, time and money;
      - under it the tab strip: every top bar item is a pause menu tab, a square PAUSE_BG plate 38px tall and 4px from
        the next, under an 8px bar that is freemode blue over the current one (CustomControls/TopPanelItem.xaml). The
        view switches are text tabs 120px wide in condensed capitals; the other items are 38px icon tabs. Playnite's
        two section separators are plain Canvases, drawn here as 12px of space. Search and the filter toggle close the
        strip at the right, as plates of the same height;
      - 3px under the strip the library begins, as the game's content panel starts 3px under its tabs.
    With the sidebar docked at the top the sidebar holds the header, so this bar keeps the strip only.
    TopPanelMenu, the toggles and the item templates keep Playnite's keys. All PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <!-- The view switches: text tabs (the item's localized title in capitals, centered in at least 120px). -->
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <TextBlock MinWidth="96" Margin="12,0,12,0" VerticalAlignment="Center" TextAlignment="Center"
                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                   Text="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=TopPanelItem}, Converter={StaticResource StringToUpperCaseConverter}}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <TextBlock MinWidth="96" Margin="12,0,12,0" VerticalAlignment="Center" TextAlignment="Center"
                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                   Text="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=TopPanelItem}, Converter={StaticResource StringToUpperCaseConverter}}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <TextBlock MinWidth="96" Margin="12,0,12,0" VerticalAlignment="Center" TextAlignment="Center"
                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                   Text="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=TopPanelItem}, Converter={StaticResource StringToUpperCaseConverter}}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" TextElement.Foreground="{DynamicResource WarningBrush}" Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <!-- Looked up from code for the main menu and the top bar's dropdowns; the surface from DefaultControls/ContextMenu.xaml. -->
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <!-- Filters: an icon tab at the end of the strip; while a filter applies, its label shows and it is the selected
         tab: white plate, black text, the blue bar over it. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel>
                        <Border x:Name="Bar" DockPanel.Dock="Top" Height="8" Background="Transparent" />
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Hover" Background="{DynamicResource TopPanelItemHoverBackgroundBrush}" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,9,0">
                                <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" VerticalAlignment="Center"
                                                  Content="{DynamicResource IconFilter}" ContentTemplate="{DynamicResource IconTemplate}" />
                                <ContentPresenter x:Name="TextFilter" Margin="8,0,4,0" VerticalAlignment="Center"
                                                  Content="{DynamicResource LOCFilterActiveLabel}">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" />
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Hover" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Hover" />
                            <Setter Property="Background" Value="{DynamicResource TabItemIndicatorBrush}" TargetName="Bar" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TabItemIndicatorBrush}" TargetName="Bar" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Notifications: the bell in the header with a red count badge (HUD_COLOUR_RED); hidden while there is nothing
         to show. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                              Content="{DynamicResource IconNotifications}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <Border MinWidth="15" Height="15" Padding="4,0,4,0" Margin="0,3,2,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Background="{DynamicResource DangerBrush}">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="10" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                           Foreground="{DynamicResource DangerForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The search field of CustomControls/SearchBox.xaml as a tab-height plate: 260px wide, 38px tall. -->
    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Width" Value="260" />
        <Setter Property="Height" Value="38" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <DockPanel x:Name="Bar" Margin="24,0,24,3" Background="{DynamicResource TopPanelBackgroundBrush}">
                        <!-- Header row: the title at the left; a running task and the notifications at the right. -->
                        <DockPanel x:Name="Header" DockPanel.Dock="Top" Height="56" Margin="0,0,150,0">
                            <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource MainMenuButton}"
                                    DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Bottom">
                                <ContentPresenter Width="20" Height="20"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <CheckBox x:Name="PART_ToggleNotifications" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" />

                            <!-- A running task: its caption over a 4px bar, then Cancel. Playnite collapses the parts
                                 while nothing runs, so this takes no room then. -->
                            <Grid DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="12,0,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="260" MinWidth="60" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Name="PART_TextProgressText" Margin="0,0,0,5"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Right"
                                               FontFamily="{DynamicResource HeadingFontFamily}"
                                               FontSize="{DynamicResource FontSizeLarge}"
                                               Foreground="{DynamicResource TextBrush}"
                                               Style="{DynamicResource BaseTextBlockStyle}" />
                                    <ProgressBar Name="PART_ProgressGlobal" Height="4" />
                                </StackPanel>
                                <Button Name="PART_ButtonProgressCancel" Grid.Column="1"
                                        Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Margin="10,0,0,0" />
                            </Grid>

                            <!-- The title: the game's header title (Chalet Comprime, about 40px cap height at 1080p). -->
                            <ContentControl x:Name="Title" Content="{DynamicResource LOCLibrary}" Focusable="False" IsTabStop="False"
                                            VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLargest}"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,-4"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </DockPanel>

                        <!-- The tab strip. -->
                        <DockPanel x:Name="Strip" Height="46" Margin="0,6,0,0">
                            <CheckBox x:Name="PART_ToggleFilter" DockPanel.Dock="Right"
                                      ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" />

                            <SearchBox x:Name="PART_TextMainSearch" DockPanel.Dock="Right" Margin="4,0,0,0"
                                       Style="{StaticResource TopPanelSearchBox}"
                                       WindowChrome.IsHitTestVisibleInChrome="True" />

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Bottom" Margin="8,0,4,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <!-- Playnite adds two plain Canvas separators around the view switches: 12px of space. -->
                            <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <StackPanel.Resources>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Width" Value="8" />
                                        <Setter Property="Height" Value="38" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </StackPanel.Resources>
                            </StackPanel>
                        </DockPanel>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Header" />
                            <Setter Property="Margin" Value="0,8,0,0" TargetName="Strip" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
