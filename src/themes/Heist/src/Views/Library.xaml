<!--
    Overlay on Playnite Default/Views/Library.xaml.
    The world behind the pause menu: the selected game's background art (when Playnite shows it: Settings,
    Appearance) fills the whole library, behind the header and tab strip too, blurred (the game fades a screen blur in
    when it pauses) and tinted black, more at the top where the header sits (ScrimBrush: 84% at the top, the map tab's
    PAUSEMAP_TINT, easing to 55%). The library itself lies on the light panel (black at 30%), so the art shows
    through as the world shows through the menu. Blur and tint sit inside a bitmap cache.
    PART_ImageBackground and the PART_View* names are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.RowSpan="2" ClipToBounds="True" IsHitTestVisible="False">
                            <Grid.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                            </Grid.CacheMode>
                            <FadeImage x:Name="PART_ImageBackground" Margin="-40"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FadeImage.Effect>
                                    <BlurEffect Radius="28" KernelType="Gaussian" RenderingBias="Performance" />
                                </FadeImage.Effect>
                            </FadeImage>
                        </Grid>

                        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                            <Grid.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                            </Grid.CacheMode>
                            <Rectangle Fill="{DynamicResource ScrimBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#D7000000" />
                                        <GradientStop Offset="0.3" Color="#8C000000" />
                                        <GradientStop Offset="1" Color="#8C000000" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>

                        <TopPanel Grid.Row="0" />

                        <DockPanel Grid.Row="1" Background="{DynamicResource ContentBackgroundBrush}">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}" />

                            <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                           DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}" />

                            <Grid DockPanel.Dock="Left">
                                <LibraryDetailsView x:Name="PART_ViewDetails" />
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
