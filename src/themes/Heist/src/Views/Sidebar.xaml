<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    The pause menu has no rail; this one is drawn from its parts: a 64px column on the light panel (black at 30%)
    whose items are the menu's square PAUSE_BG plates, 3px apart like its list rows (CustomControls/SidebarItem.xaml).
    The main menu button (PART_ElemMainMenu, this theme's wanted star) sits on top on a freemode blue plate, level with
    the header row. Docked at the top or bottom the rail becomes a strip: 56px tall, the views as text tabs and 150px
    kept clear on the right for the caption buttons. Views/MainWindow.xaml docks it with Playnite's Sidebar position.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Main menu button: the white star on a freemode blue plate, the white selected plate with a black star under
         the pointer. Also used by Views/TopPanel.xaml, which sets its own size. -->
    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Width="44" Background="{DynamicResource ShellBackgroundBrush}">
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                    DockPanel.Dock="Top" Margin="0,4,0,3">
                                <ContentPresenter Width="18" Height="18"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <ScrollViewer x:Name="ScrollSidebarItems" DockPanel.Dock="Top"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="True">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Height" Value="56" TargetName="BorderContentHolder" />
                            <Setter Property="Width" Value="Auto" TargetName="BorderContentHolder" />
                            <Setter Property="Margin" Value="12,6,8,6" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,150,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Height" Value="56" TargetName="BorderContentHolder" />
                            <Setter Property="Width" Value="Auto" TargetName="BorderContentHolder" />
                            <Setter Property="Margin" Value="12,6,8,6" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
