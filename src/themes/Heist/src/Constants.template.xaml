<!--
    Heist: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    The placeholders name the GTA V frontend's own values (tokens.css: HUD colour names from hudcolor.dat and the
    pause menu's plates). Theme XAML reads brushes only, never Color keys, so ThemeModifier edits reach every control.

    The look: square plates of translucent black, white text, the selected row or tab a solid white plate with black
    text, one blue (HUD_COLOUR_FREEMODE) for the header stripe, the tab bar and the progress bars. No corners anywhere.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Typography (Playnite keys). The menu sets its rows at about 14px at 1080p and the tabs and titles larger.
        Body text is Segoe UI in place of Chalet London; tabs, titles, buttons and captions use HeadingFontFamily,
        Bahnschrift SemiCondensed, in place of the condensed Chalet Comprime (neither game font is bundled).
    -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Bahnschrift SemiCondensed}}, Bahnschrift, Segoe UI</FontFamily>

    <!-- Shape (Playnite keys). The frontend draws only square plates. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-large}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:radius}}</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor is the selected plate's white and TextColorDark the black text on it, so Playnite's own views
        select the GTA way too.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{hud-white}}</Color>
    <Color x:Key="TextColorDarker">{{hud-grey}}</Color>
    <Color x:Key="TextColorDark">{{hud-black}}</Color>
    <Color x:Key="MainColor">{{pause-popup}}</Color>
    <Color x:Key="MainColorDark">{{pause-window}}</Color>
    <Color x:Key="HoverColor">{{pause-plate-hover}}</Color>
    <Color x:Key="GlyphColor">{{hud-white}}</Color>
    <Color x:Key="HighlightGlyphColor">{{hud-white/25}}</Color>
    <Color x:Key="PopupBackgroundColor">{{pause-popup}}</Color>
    <Color x:Key="PopupBorderColor">{{pause-popup-edge}}</Color>
    <Color x:Key="BackgroundToneColor">{{pause-popup}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{pause-plate}}</Color>
    <Color x:Key="PanelSeparatorColor">{{pause-rule}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{pause-rule}}</Color>
    <Color x:Key="DataChangeNotifColor">{{hud-yellow}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{pause-input-edge}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{{pause-plate-hover}}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{pause-tooltip}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{pause-plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{pause-input}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{hud-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{hud-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{hud-yellow}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{hud-yellow}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{pause-plate}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{pause-window}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!--
        Shell. The game lays its pause menu as translucent black over the frozen, blurred world; here the world is the
        game's background art (Views/Library.xaml) or the window color. The rail and the tab strip share one plate.
    -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{hud-panel-light}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{hud-panel-light}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{pause-plate}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{pause-plate-strong}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{pause-stripe}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{hud-pure-white}}" />

    <!-- States: the selected row is a white plate with black text; a row under the pointer lightens -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{hud-pure-white}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{hud-black}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{pause-plate-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{hud-freemode}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{hud-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{hud-pure-white}}" />

    <!-- Buttons: black plates that turn white with black text under the pointer, like menu rows -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{hud-greylight}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{hud-pure-white}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{hud-greylight}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{hud-black}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{hud-freemode}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{hud-freemode}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{hud-white}}" />

    <!-- Inputs: a black field with a thin white edge -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{pause-input}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{pause-input-hover}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{pause-input-edge}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{pause-input-edge-hover}}" />

    <!-- Controls: white ticks and thumbs, greydark rails, freemode blue fills -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{hud-pure-white}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{slider-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{hud-pure-white}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{slider-fill}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{hud-freemode}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{pause-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{pause-rule-strong}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{pause-rule-strong}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{pause-stripe}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{pause-plate-hover}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{pause-plate}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{pause-rule-strong}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{pause-plate-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{pause-plate}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{hud-white}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{pause-rule}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{hud-white}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{pause-popup-edge}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{pause-stripe}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{hud-pure-white}}" />

    <!-- Pause menu: the header stripe, the black of the world tint, section titles, the game page surface -->
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{pause-stripe}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{pause-heading}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{pause-rule}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{hud-panel-light}}" />
</ResourceDictionary>
