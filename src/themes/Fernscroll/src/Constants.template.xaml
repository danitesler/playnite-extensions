<!--
    Fernscroll: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    A warm storybook parchment light theme inspired by Snufkin: Melody of Moominvalley:
      - Parchment sheet workspace, deep plum-espresso ink, dark plum double-framed Quest Cards & selection plaques
      - Snufkin pine-green swallowtail ribbon for Play & primary Save
      - Crimson Quest Shield (!) for filter/notification badges & danger close
      - Twilight nocturne valley indigo for live Launching / Running states

    Keys follow the shared theme vocabulary (scripts/data/theme-keys.json). Theme XAML reads brushes only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Pathway Gothic One (tall condensed headings, unmodified OFL), Barlow Semi Condensed
         (clean storybook narrow body rows/trees/metadata), Patrick Hand (hand-lettered notes/tooltips). -->
    <sys:Double x:Key="FontSizeSmall">13</sys:Double>
    <sys:Double x:Key="FontSize">15</sys:Double>
    <sys:Double x:Key="FontSizeLarge">17</sys:Double>
    <sys:Double x:Key="FontSizeLarger">22</sys:Double>
    <sys:Double x:Key="FontSizeLargest">36</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow Semi Condensed, Barlow Semi Condensed, Bahnschrift SemiCondensed, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Pathway Gothic One, Pathway Gothic One, Bahnschrift Condensed, Segoe UI</FontFamily>
    <FontFamily x:Key="NoteFontFamily">./Typography/#Patrick Hand, Patrick Hand, Segoe Print</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- Usable metadata content width; applied inside the Dark Plum Quest Card's padding and inset frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <!-- Game page metadata pane: Left, Center / Stretch (full-width divider-free 3/2/1-col item grid above content), or Right. ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape scale: subtle organic square corners; never pill radius on wide bars. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:mv-radius-md}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:mv-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:mv-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:mv-radius-xl}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">10000</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{mv-ink}}</Color>
    <Color x:Key="TextColorDarker">{{mv-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{mv-cream}}</Color>
    <Color x:Key="MainColor">{{mv-paper-soft}}</Color>
    <Color x:Key="MainColorDark">{{mv-paper-hi}}</Color>
    <Color x:Key="HoverColor">{{mv-wash-strong}}</Color>
    <Color x:Key="GlyphColor">{{mv-pine}}</Color>
    <Color x:Key="HighlightGlyphColor">{{mv-pine-hi}}</Color>
    <Color x:Key="PopupBackgroundColor">{{mv-paper-hi}}</Color>
    <Color x:Key="PopupBorderColor">{{mv-ink-deep}}</Color>
    <Color x:Key="BackgroundToneColor">{{mv-paper-soft}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{mv-ink-rule}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{mv-ink-rule}}</Color>
    <Color x:Key="DataChangeNotifColor">{{mv-crimson}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{mv-ink-faint}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{mv-plum}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{mv-plum}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{mv-paper-hi}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{mv-pine-ink}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{mv-crimson}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{mv-gold-ink}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{mv-gold-ink}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{mv-paper-soft}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{mv-paper}}" />

    <!-- Shell surfaces -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{mv-paper-soft}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{mv-paper}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{mv-paper}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{mv-paper}}" />
    <!-- Solid parchment tint for ThemeModifier banner darkening so hero art veils gently into storybook paper -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{mv-paper}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{mv-paper}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{mv-paper-hi}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{mv-plum}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{mv-ink-rule}}" />

    <!-- States & selection -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{mv-plum}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{mv-plum-hi}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{mv-plum-border}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{mv-wash-strong}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{mv-plum}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{mv-wash-strong}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{mv-indigo}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{mv-pine-soft}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{mv-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{mv-cream}}" />

    <!-- Running & launching game indicator: Twilight Nocturne Indigo (distinct from Pine Play, Plum selection, Crimson filter) -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{mv-indigo}}" />

    <!-- Buttons: Snufkin Pine Green swallowtail ribbon for Play/Primary; Dark Plum inset-framed plaques for standard buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{mv-plum-hi}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{mv-plum-deep}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{mv-ink-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{mv-pine}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{mv-plum-border}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{mv-pine-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{mv-pine-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{mv-gold}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{mv-plum}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{mv-ink-deep}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{mv-plum-hi}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{mv-plum-deep}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{mv-plum}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{mv-paper-hi}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{mv-ink-faint}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{mv-ink-deep}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{mv-ink-muted}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{mv-ink-deep}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{mv-plum-hi}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{mv-ink-rule}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{mv-plum}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{mv-gold}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{mv-pine-hi}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{mv-pine}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{mv-ink-rule}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{mv-plum}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{mv-ink-deep}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{mv-plum}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{mv-ink-deep}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{mv-ink-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{mv-ink}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{mv-ink-deep}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{mv-ink-rule}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{mv-gold}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{mv-plum}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{mv-wash-strong}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{mv-plum}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{mv-ink-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{mv-gold-soft}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{mv-plum-chip}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{mv-plum-hi}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{mv-plum-rim}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{mv-ink-deep}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{mv-gold}}" />

    <!-- Dark Plum Quest Card metadata folio & Popups -->
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{mv-plum}}" />
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{mv-plum-border}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{mv-gold-soft}}" />
    <SolidColorBrush x:Key="ParchmentLinkBrush" Color="{{mv-gold-soft}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{mv-gold-ink}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{mv-ink-rule}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{mv-cream}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{mv-ink-deep}}" />

    <!-- Typography & Dialog Chrome -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{mv-ink-deep}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{mv-crimson}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{mv-pine}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{mv-ink}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{mv-ink}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{mv-paper-soft}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{mv-ink-deep}}" />

    <!-- Light theme text fallback drawn over live window background art -->
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{mv-cream}}" />
</ResourceDictionary>
