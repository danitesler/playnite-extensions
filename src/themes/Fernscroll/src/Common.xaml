<!--
    Fernscroll: Common.xaml. Spacing, focus visual, and shared storybook templates.
    Measurements from ../RESEARCH.md:
      ControlHeight = 32 (shared repo form field height), IconSize = 16, GameBannerHeight = 256, GameBannerDarken = 0.
      GlowFrameTemplate     9-slice sunbeam watercolor bloom (Images/fx/bloom.png, 320x112, corners 28 drawn at 14)
      GrainTemplate         seamless cold-press paper tooth (Images/fx/paper-grain.png, 256x256)
      DividerTemplate       botanical double-spiral curl + tapered pen divider (Images/fx/taper-rule.png)
      BrandMarkTemplate     Fernscroll botanical reed-note & twin-scroll mark
      CornerMarksTemplate   crisp ink corner brackets for keyboard focus
      LocalPlaqueDistress   vintage print speckles overlay on dark plum plaques (Images/fx/plaque-distress.png)
      LocalScrollCurlLeft / Right  botanical scroll flourishes flanking titles and section headings
      EmptyGameTemplate     ivory Loading-style tip card with inset ink frame, Fernscroll mark & drifting melody wisps
    No fixed width >= 200 inside templates (Statistics cards stay compact).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    </Style>

    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">11,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">10,6,12,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6,12,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">14,10,14,0</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">16</sys:Double>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>

    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">256</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- 9-slice soft sunbeam bloom (Images/fx/bloom.png, 320x112, pad 28 drawn at 14). Host Foreground = glow. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,0,28,28" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="28,0,264,28" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="292,0,28,28" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,28,28,56" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="28,28,264,56" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="292,28,28,56" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,84,28,28" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="28,84,264,28" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="292,84,28,28" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Cold-press parchment tooth tile (Images/fx/paper-grain.png 256x256). Host Foreground + Opacity. -->
    <ControlTemplate x:Key="GrainTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/paper-grain.png'}" TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Vintage print speckles overlay on dark plum plaques (Images/fx/plaque-distress.png 256x128). -->
    <ControlTemplate x:Key="LocalPlaqueDistressTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/plaque-distress.png'}" TileMode="Tile" Viewport="0,0,256,128" ViewportUnits="Absolute" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Tapered pen-ink divider rule (Images/fx/taper-rule.png 360x10). Compact desired size so GroupBox stays content-sized. -->
    <ControlTemplate x:Key="LocalTaperRuleTemplate" TargetType="Control">
        <Rectangle Height="6" Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/taper-rule.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Botanical double-spiral ink scroll curls flanking headings -->
    <ControlTemplate x:Key="LocalScrollCurlLeftTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="32" Height="16">
                <Path Data="{DynamicResource LocalScrollCurlGeometry}"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalScrollCurlRightTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform>
                <ScaleTransform ScaleX="-1" ScaleY="1" />
            </Viewbox.RenderTransform>
            <Canvas Width="32" Height="16">
                <Path Data="{DynamicResource LocalScrollCurlGeometry}"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Crimson Quest Shield badge (!) -->
    <ControlTemplate x:Key="LocalQuestShieldTemplate" TargetType="Control">
        <Grid Width="22" Height="26" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Data="{DynamicResource LocalQuestShieldGeometry}" Stretch="Fill" Fill="{TemplateBinding Background}" />
            <Path Data="{DynamicResource LocalQuestShieldGeometry}" Stretch="Fill" Margin="2.5"
                  Stroke="{DynamicResource SelectedBorderBrush}" StrokeThickness="1" Opacity="0.85" />
            <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"
                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="14" FontWeight="Bold"
                       Foreground="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- Tapered pen divider with subtle botanical curl prefix (used under game title) -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="12" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Control Width="20" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                     Template="{DynamicResource LocalScrollCurlLeftTemplate}" Foreground="{TemplateBinding Foreground}" />
            <Rectangle Grid.Column="1" Height="6" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/taper-rule.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Fernscroll brand mark -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="64" Height="64">
                <Path Data="{DynamicResource LocalBrandMarkGeometry}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Crisp 8px corner brackets for keyboard focus -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,8 L0,0 8,0 8,2 2,2 2,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L8,0 8,8 6,8 6,2 0,2Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L2,0 2,6 8,6 8,8 0,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M6,0 L8,0 8,8 0,8 0,6 6,6Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBoxFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Steam Screenshots loading placeholder: breathes calmly while visible -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel x:Name="Root" IsHitTestVisible="False" Opacity="0.45">
            <Border Background="{TemplateBinding Foreground}" Opacity="0.28" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{TemplateBinding Foreground}" Opacity="0.28" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Grid.Column="2" Background="{TemplateBinding Foreground}" Opacity="0.28" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="4" Background="{TemplateBinding Foreground}" Opacity="0.28" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="6" Background="{TemplateBinding Foreground}" Opacity="0.28" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="8" Background="{TemplateBinding Foreground}" Opacity="0.28" CornerRadius="{DynamicResource ControlCornerRadius}" />
            </Grid>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Breathe">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0.45" To="0.95" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Breathe" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- EmptyGameTemplate: Loading-screen ivory tip card with inset ink hairline, Fernscroll seal & drifting melody wisps.
         Animation runs strictly while visible via ControlTemplate.Triggers (named Transform, no Style trigger Transform). -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusSmall}" Padding="26,20">
            <Grid>
                <Border Margin="-20,-14" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" Opacity="0.48" IsHitTestVisible="False" />
                <Control Margin="-20,-14" Template="{DynamicResource LocalPlaqueDistressTemplate}"
                         Foreground="{DynamicResource TextBrush}" Opacity="0.06" IsHitTestVisible="False" Focusable="False" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="240" Height="116" HorizontalAlignment="Center" ClipToBounds="True">
                        <Canvas Width="240" Height="116" IsHitTestVisible="False" Opacity="0.34">
                            <Rectangle x:Name="MelodyStrip" Canvas.Left="0" Canvas.Top="-2" Width="640" Height="120" Fill="{DynamicResource GlyphBrush}">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="MelodyShift" X="0" />
                                </Rectangle.RenderTransform>
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/melody-wisps.png'}" TileMode="Tile" Viewport="0,0,320,120" ViewportUnits="Absolute" Stretch="Fill" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Canvas>
                        <Ellipse x:Name="CompassOuter" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Stroke="{DynamicResource WindowPanelSeparatorBrush}" StrokeThickness="1" StrokeDashArray="4 6" Opacity="0.65" />
                        <Ellipse Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" Opacity="0.35" />
                        <Control x:Name="Seal" Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Template="{DynamicResource BrandMarkTemplate}" Foreground="{TemplateBinding Foreground}" Opacity="0.88" Focusable="False" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                        <Control Width="22" Height="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Template="{DynamicResource LocalScrollCurlLeftTemplate}" Foreground="{TemplateBinding Foreground}" Focusable="False" />
                        <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource NoteFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                   Foreground="{TemplateBinding Foreground}" />
                        <Control Width="22" Height="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                 Template="{DynamicResource LocalScrollCurlRightTemplate}" Foreground="{TemplateBinding Foreground}" Focusable="False" />
                    </StackPanel>
                    <Control Width="210" Height="6" HorizontalAlignment="Center"
                             Template="{DynamicResource LocalTaperRuleTemplate}" Foreground="{DynamicResource WindowPanelSeparatorBrush}" Focusable="False" />
                </StackPanel>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyMelodyLoop">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="MelodyShift" Storyboard.TargetProperty="X" From="0" To="-320" Duration="0:0:10" />
                            <DoubleAnimation Storyboard.TargetName="CompassOuter" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="40" Duration="0:0:18" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Seal" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.72" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyMelodyLoop" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a harmonica made of three reed bars with four slots each, in the host plate cream. Hover: the stack inhales (scale up) and a gold breath dot runs along the middle bar. Open (ContextMenu.IsOpen of the nearest Border): the top reed slides right and the bottom reed left like a harmonica slide, the middle bar goes out and a gold quaver rises in and bobs until the menu closes. -->
    <ControlTemplate x:Key="LocalFernscrollMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform x:Name="StackScale" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                    <Canvas x:Name="ReedTop" Width="24" Height="24">
                        <Canvas.RenderTransform><TranslateTransform x:Name="ReedTopMove" X="0" /></Canvas.RenderTransform>
                        <Rectangle Canvas.Left="2" Canvas.Top="3" Width="20" Height="5" RadiusX="1.2" RadiusY="1.2" Fill="{TemplateBinding Foreground}" />
                        <Rectangle Canvas.Left="6.3" Canvas.Top="4.2" Width="1.4" Height="2.6" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" /><Rectangle Canvas.Left="10.3" Canvas.Top="4.2" Width="1.4" Height="2.6" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" /><Rectangle Canvas.Left="14.3" Canvas.Top="4.2" Width="1.4" Height="2.6" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" /><Rectangle Canvas.Left="18.3" Canvas.Top="4.2" Width="1.4" Height="2.6" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" />
                    </Canvas>
                    <Canvas x:Name="ReedMid" Width="24" Height="24">
                        <Canvas.RenderTransform><TranslateTransform x:Name="ReedMidMove" X="0" /></Canvas.RenderTransform>
                        <Rectangle Canvas.Left="2" Canvas.Top="9.5" Width="20" Height="5" RadiusX="1.2" RadiusY="1.2" Fill="{TemplateBinding Foreground}" />
                        <Rectangle Canvas.Left="6.3" Canvas.Top="10.7" Width="1.4" Height="2.6" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" /><Rectangle Canvas.Left="10.3" Canvas.Top="10.7" Width="1.4" Height="2.6" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" /><Rectangle Canvas.Left="14.3" Canvas.Top="10.7" Width="1.4" Height="2.6" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" /><Rectangle Canvas.Left="18.3" Canvas.Top="10.7" Width="1.4" Height="2.6" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" />
                    </Canvas>
                    <Canvas x:Name="ReedBot" Width="24" Height="24">
                        <Canvas.RenderTransform><TranslateTransform x:Name="ReedBotMove" X="0" /></Canvas.RenderTransform>
                        <Rectangle Canvas.Left="2" Canvas.Top="16" Width="20" Height="5" RadiusX="1.2" RadiusY="1.2" Fill="{TemplateBinding Foreground}" />
                        <Rectangle Canvas.Left="6.3" Canvas.Top="17.2" Width="1.4" Height="2.6" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" /><Rectangle Canvas.Left="10.3" Canvas.Top="17.2" Width="1.4" Height="2.6" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" /><Rectangle Canvas.Left="14.3" Canvas.Top="17.2" Width="1.4" Height="2.6" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" /><Rectangle Canvas.Left="18.3" Canvas.Top="17.2" Width="1.4" Height="2.6" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" />
                    </Canvas>
                </Canvas>
                <Canvas Width="24" Height="24">
                    <Ellipse x:Name="Breath" Canvas.Left="2" Canvas.Top="10.8" Width="3.4" Height="3.4" Fill="{DynamicResource FrameHoverBrush}" Opacity="0">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="BreathMove" X="0" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
                <Canvas x:Name="Note" Width="24" Height="24" Opacity="0">
                    <Canvas.RenderTransform><TranslateTransform x:Name="NoteMove" Y="5" /></Canvas.RenderTransform>
                    <Ellipse Canvas.Left="6.5" Canvas.Top="12" Width="6.4" Height="4.6" Fill="{DynamicResource FrameHoverBrush}" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-22" /></Ellipse.RenderTransform></Ellipse>
                    <Rectangle Canvas.Left="11.9" Canvas.Top="4.5" Width="1.4" Height="10" Fill="{DynamicResource FrameHoverBrush}" />
                    <Path Data="M13.3,4.7 C16.6,5.4 18.6,7 17.8,10.4" Stroke="{DynamicResource FrameHoverBrush}" StrokeThickness="1.5" StrokeStartLineCap="Flat" />
                </Canvas>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="StackScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StackScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Breath" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BreathMove" Storyboard.TargetProperty="X" To="15.6" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="StackScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="StackScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Breath" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BreathMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ReedTopMove" Storyboard.TargetProperty="X" To="3.5" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
