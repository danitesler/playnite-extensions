<!--
    Fernscroll: GridViewItemTemplate.
    Cover card with PART_PanelHost, PART_ImageCover, FallbackName (Dark Plum storybook plate with
    botanical reed-note mark), and 42x42 GridTilePlayButton (Pine Green) + GridTileButton (Dark Plum)
    rising 10px with BackEase and 60ms stagger on hover. Root Border Background="Transparent".
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- GridTileButton (Info): a wax-and-ink seal from the sketchbook. A round Dark Plum blot with an inset cream print rim; hover swells
         the seal and lights a gold ring, press sinks it. GridTilePlayButton below is the pine swallowtail bookmark ribbon. -->
    <Style x:Key="GridTileButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="SealScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Ellipse x:Name="Ring" Margin="1" StrokeThickness="2" Opacity="0" IsHitTestVisible="False"
                                 Stroke="{DynamicResource GridViewItemHoverBorderBrush}" />
                        <Ellipse x:Name="Plate" Margin="5"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                        <Ellipse Margin="8" StrokeThickness="1" Opacity="0.4" IsHitTestVisible="False"
                                 Stroke="{DynamicResource SelectedBorderBrush}" />
                        <ContentControl x:Name="Glyph"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="16" Height="16"
                                        IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Setter TargetName="Plate" Property="Stroke" Value="{DynamicResource GridViewItemHoverBorderBrush}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SealIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SealScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SealScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="SealIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GridTilePlayButton: a swallowtail bookmark ribbon (Pine Green, the game's Play ribbon) with a cream stitched rim. Hover: the ribbon
         unrolls 5px longer from its top edge and its rim turns Sunbeam Gold. The glyph rides the upper body, clear of the notch. -->
    <Style x:Key="GridTilePlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GridTileButton}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid RenderTransformOrigin="0.5,0">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RibbonScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Path x:Name="Ribbon" Stretch="Fill" StrokeThickness="1" StrokeLineJoin="Miter"
                                  Margin="6,2,6,2" Data="M0,0 L36,0 L36,44 L18,34 L0,44 Z"
                                  Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" />
                            <Path Stretch="Fill" StrokeThickness="1" Opacity="0.45" IsHitTestVisible="False"
                                  Margin="9,5,9,8" StrokeDashArray="2 2" Data="M0,0 L30,0 L30,34 L15,26 L0,34 Z"
                                  Stroke="{DynamicResource ParchmentLabelBrush}" />
                        </Grid>
                        <ContentControl x:Name="Glyph"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,8"
                                        Width="18" Height="18"
                                        IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ribbon" Property="Stroke" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RibbonIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RibbonScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RibbonIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Ribbon" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Name="PART_PanelHost"
                                    Width="{Settings GridItemWidth}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top">
                            <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}" ClipToBounds="True">
                                <Border Background="{DynamicResource NormalBrush}"
                                        BorderBrush="{DynamicResource NormalBorderBrush}"
                                        BorderThickness="1" />
                                <Image Name="PART_ImageCover"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       StretchDirection="Both"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Stretch="{Settings CoverArtStretch}" />
                                <Border x:Name="FallbackName" Visibility="Collapsed" Background="{DynamicResource ParchmentBrush}">
                                    <Grid>
                                        <Border Margin="4"
                                                BorderBrush="{DynamicResource SelectedBorderBrush}"
                                                BorderThickness="1"
                                                Opacity="0.3"
                                                IsHitTestVisible="False" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                                            <Control Width="34" Height="34" Margin="0,0,0,8"
                                                     Template="{DynamicResource BrandMarkTemplate}"
                                                     Foreground="{DynamicResource ParchmentLabelBrush}"
                                                     Opacity="0.72" Focusable="False" IsHitTestVisible="False" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="{DynamicResource FontSizeLarge}"
                                                       Foreground="{DynamicResource ParchmentTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="UninstalledWash"
                                        Background="{DynamicResource ScrimBrush}"
                                        Opacity="0.45"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False" />
                                <Rectangle x:Name="Shade" Opacity="0" IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.25" />
                                            <GradientStop Color="#CC1A1315" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0,10,0,0">
                                    <Button Name="PART_ButtonPlay"
                                            Style="{StaticResource GridTilePlayButton}"
                                            Margin="0,0,5,0"
                                            Content="{DynamicResource IconPlay}"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                        <Button.RenderTransform>
                                            <TranslateTransform x:Name="PlayShift" Y="10" />
                                        </Button.RenderTransform>
                                    </Button>
                                    <Button Name="PART_ButtonInfo"
                                            Style="{StaticResource GridTileButton}"
                                            Margin="5,0,0,0"
                                            Content="{DynamicResource IconInfo}"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                        <Button.RenderTransform>
                                            <TranslateTransform x:Name="InfoShift" Y="10" />
                                        </Button.RenderTransform>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="GridGameTitle"
                                       Text="{Binding DisplayName}"
                                       FontSize="{DynamicResource FontSize}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Padding="4,6,4,4"
                                       Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter TargetName="PART_ButtonPlay" Property="Content" Value="{DynamicResource IconDownload}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="UninstalledWash" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="FallbackName" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_ButtonPlay" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="PART_ButtonInfo" Property="IsHitTestVisible" Value="True" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="PlayShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.06" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="InfoShift" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.06" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="PlayShift" Storyboard.TargetProperty="Y" To="10" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="InfoShift" Storyboard.TargetProperty="Y" To="10" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
