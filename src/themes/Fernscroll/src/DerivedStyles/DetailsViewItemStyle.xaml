<!--
    Fernscroll: DetailsViewItemStyle (left game list rows).
    Installed games in deep ink (TextBrush), uninstalled in sepia taupe (TextBrushDarker); switches
    to WindowArtForegroundBrush over window background art before hover/select. Selected rows become
    Dark Plum beveled pointed SAVE-#1 plaques (3-column Grid so bevel angles never stretch) with
    SelectedForegroundBrush cream text. Launching/Running glows in Twilight Nocturne Indigo
    (#2a547e) with melody-wisps sweep, 2px foot line, and floating eighth note + diamond motes inside
    a reserved 42px right RowRoom strip.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid>
                    <Grid Background="Transparent" Margin="2,1" SnapsToDevicePixels="True">
                        <Border x:Name="HoverRectangle"
                                Visibility="Collapsed"
                                Background="{DynamicResource ListItemHoverBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False" />

                        <Grid x:Name="SelectedPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SelectedPlateScale" ScaleX="1" />
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                            </Grid.ColumnDefinitions>
                            <Polygon Grid.Column="0" Points="10,0 10,32 0,16" Stretch="Fill"
                                     Fill="{DynamicResource ListItemSelectedBrush}" />
                            <Rectangle Grid.Column="1" Margin="-0.5,0"
                                       Fill="{DynamicResource ListItemSelectedBrush}" />
                            <Polygon Grid.Column="2" Points="0,0 10,16 0,32" Stretch="Fill"
                                     Fill="{DynamicResource ListItemSelectedBrush}" />
                            <Grid Grid.Column="0" Grid.ColumnSpan="3" Margin="2.5,2" Opacity="0.38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="9" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="9" />
                                </Grid.ColumnDefinitions>
                                <Polygon Grid.Column="0" Points="9,0 9,28 0,14" Stretch="Fill"
                                         Fill="{DynamicResource SelectedBorderBrush}" />
                                <Rectangle Grid.Column="1" Margin="-0.5,0"
                                           Fill="{DynamicResource SelectedBorderBrush}" />
                                <Polygon Grid.Column="2" Points="0,0 9,14 0,28" Stretch="Fill"
                                         Fill="{DynamicResource SelectedBorderBrush}" />
                            </Grid>
                            <Grid Grid.Column="0" Grid.ColumnSpan="3" Margin="3.5,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                </Grid.ColumnDefinitions>
                                <Polygon Grid.Column="0" Points="8,0 8,26 0,13" Stretch="Fill"
                                         Fill="{DynamicResource ListItemSelectedBrush}" />
                                <Rectangle Grid.Column="1" Margin="-0.5,0"
                                           Fill="{DynamicResource ListItemSelectedBrush}" />
                                <Polygon Grid.Column="2" Points="0,0 8,13 0,26" Stretch="Fill"
                                         Fill="{DynamicResource ListItemSelectedBrush}" />
                            </Grid>
                        </Grid>

                        <Path x:Name="SelectedPip"
                              Visibility="Collapsed"
                              Width="6" Height="6"
                              Stretch="Fill"
                              Margin="7,0,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Data="M 3,0 L 6,3 L 3,6 L 0,3 Z"
                              Fill="{DynamicResource PrimaryButtonGlowBrush}"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0.5"
                              IsHitTestVisible="False">
                            <Path.RenderTransform>
                                <ScaleTransform x:Name="PipScale" ScaleX="0.3" ScaleY="0.3" />
                            </Path.RenderTransform>
                        </Path>

                        <Grid x:Name="RunningIndicator"
                              Visibility="Collapsed"
                              Opacity="0.84"
                              IsHitTestVisible="False"
                              SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash"
                                    Background="{DynamicResource RunningIndicatorBrush}"
                                    Opacity="0.16"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border x:Name="RunningMarkPlate"
                                    Visibility="Visible"
                                    Width="42"
                                    HorizontalAlignment="Right"
                                    Margin="2"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource RunningIndicatorBrush}"
                                    Opacity="0.38">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningScan"
                                    Visibility="Collapsed"
                                    Opacity="0.62"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/melody-wisps.png'}"
                                                    TileMode="Tile"
                                                    Viewport="0,0,160,64"
                                                    ViewportUnits="Absolute"
                                                    Stretch="Fill" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Border>
                            <Border x:Name="RunningFrame"
                                    BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                    BorderThickness="2"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border BorderBrush="{DynamicResource SelectedBorderBrush}"
                                        BorderThickness="1"
                                        Opacity="0.55"
                                        CornerRadius="3" />
                            </Border>
                            <Grid Height="2" Margin="6,0,6,3" VerticalAlignment="Bottom">
                                <Rectangle RadiusX="1" RadiusY="1"
                                           Fill="{DynamicResource RunningIndicatorBrush}"
                                           Opacity="0.32" />
                                <Rectangle x:Name="RunningFill"
                                           RadiusX="1" RadiusY="1"
                                           Fill="{DynamicResource RunningIndicatorBrush}"
                                           RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Grid x:Name="RunningNotesHost"
                                  Margin="0,0,10,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Width="28" Height="22">
                                <Path x:Name="RunningNoteHalo"
                                      Data="M 5.2,1.6 L 10.5,0 L 10.5,2.6 L 6.6,3.8 L 6.6,10.5 C 6.6,12.2 5.0,13.5 3.1,13.5 C 1.4,13.5 0,12.4 0,10.9 C 0,9.4 1.4,8.2 3.1,8.2 C 3.9,8.2 4.6,8.4 5.2,8.9 Z"
                                      Width="12" Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource SelectedForegroundBrush}"
                                      StrokeThickness="2.2"
                                      StrokeLineJoin="Round"
                                      Fill="{DynamicResource SelectedForegroundBrush}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="NoteHaloSlide" Y="0" />
                                            <RotateTransform x:Name="NoteHaloTilt" Angle="0" />
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="RunningNote"
                                      Data="M 5.2,1.6 L 10.5,0 L 10.5,2.6 L 6.6,3.8 L 6.6,10.5 C 6.6,12.2 5.0,13.5 3.1,13.5 C 1.4,13.5 0,12.4 0,10.9 C 0,9.4 1.4,8.2 3.1,8.2 C 3.9,8.2 4.6,8.4 5.2,8.9 Z"
                                      Width="12" Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="{DynamicResource RunningIndicatorBrush}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="NoteSlide" Y="0" />
                                            <RotateTransform x:Name="NoteTilt" Angle="0" />
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="RunningMoteA"
                                      Data="M 3,0 L 3.8,2.2 L 6,3 L 3.8,3.8 L 3,6 L 2.2,3.8 L 0,3 L 2.2,2.2 Z"
                                      Width="6" Height="6"
                                      Stretch="Fill"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Margin="1,1,0,0"
                                      Fill="{DynamicResource PrimaryButtonGlowBrush}"
                                      Opacity="0.85">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="MoteASlide" Y="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="RunningMoteB"
                                      Data="M 2.5,0 L 3.2,1.8 L 5,2.5 L 3.2,3.2 L 2.5,5 L 1.8,3.2 L 0,2.5 L 1.8,1.8 Z"
                                      Width="5" Height="5"
                                      Stretch="Fill"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,1,2"
                                      Fill="{DynamicResource SelectedForegroundBrush}"
                                      Opacity="0.75">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="MoteBSlide" Y="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Grid>

                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <!-- RunningMarkRoom left="0" right="42": keeps the trailing floating note clear of long titles. -->
                            <Border x:Name="RowRoom">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="RowHoverRoom">
                                        <ContentPresenter>
                                            <ContentPresenter.RenderTransform>
                                                <TranslateTransform x:Name="ContentShift" X="0" />
                                            </ContentPresenter.RenderTransform>
                                        </ContentPresenter>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <!-- RowHoverAction: play (installed) or install (not installed) button on the row's right edge, only while the row is hovered; hidden while launching or running. -->
                    <Button x:Name="RowHoverPlay" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCPlayGame}"
                            Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                            <Condition Binding="{Binding IsInstalled}" Value="True" />
                                            <Condition Binding="{Binding IsRunning}" Value="False" />
                                            <Condition Binding="{Binding IsLaunching}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <ContentControl Focusable="False" Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" /><Setter TargetName="Glyph" Property="Width" Value="17" /><Setter TargetName="Glyph" Property="Height" Value="17" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="RowHoverInstall" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCInstallGame}"
                            Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                            <Condition Binding="{Binding IsInstalled}" Value="False" />
                                            <Condition Binding="{Binding IsRunning}" Value="False" />
                                            <Condition Binding="{Binding IsLaunching}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <ContentControl Focusable="False" Content="{DynamicResource IconDownload}" ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" /><Setter TargetName="Glyph" Property="Width" Value="17" /><Setter TargetName="Glyph" Property="Height" Value="17" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="HoverExit" />
                                <BeginStoryboard Name="HoverEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ContentShift" Storyboard.TargetProperty="X"
                                                         To="3" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="HoverExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="ContentShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="Visibility" Duration="0:0:0.20">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="HoverEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="HoverRectangle" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningWash" Property="Margin" Value="10,0" />
                            <Setter TargetName="RunningWash" Property="CornerRadius" Value="0" />
                            <Setter TargetName="RunningFrame" Property="Margin" Value="10,0" />
                            <Setter TargetName="RunningFrame" Property="CornerRadius" Value="0" />
                            <Setter TargetName="RunningFrame" Property="BorderThickness" Value="0,2,0,2" />
                            <Setter TargetName="RunningScan" Property="Margin" Value="10,0" />
                            <Setter TargetName="RunningScan" Property="CornerRadius" Value="0" />
                            <Setter TargetName="RunningMarkPlate" Property="CornerRadius" Value="0" />
                            <Setter TargetName="RunningMarkPlate" Property="Margin" Value="2,2,10,2" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="SelectExit" />
                                <BeginStoryboard Name="SelectEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPip" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlateScale" Storyboard.TargetProperty="ScaleX"
                                                         From="0.94" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPip" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="PipScale" Storyboard.TargetProperty="ScaleX"
                                                         From="0.3" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PipScale" Storyboard.TargetProperty="ScaleY"
                                                         From="0.3" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="SelectExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedPip" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility" Duration="0:0:0.14">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPip" Storyboard.TargetProperty="Visibility" Duration="0:0:0.14">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="SelectEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,42,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.45" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.452" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteSlide" Storyboard.TargetProperty="Y" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-2.0" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="2.5" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteHaloSlide" Storyboard.TargetProperty="Y" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-2.0" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="2.5" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteTilt" Storyboard.TargetProperty="Angle" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="7" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="-7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteHaloTilt" Storyboard.TargetProperty="Angle" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="7" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="-7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoteASlide" Storyboard.TargetProperty="Y" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="-5" KeySpline="0.2,0.8 0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMoteA" Storyboard.TargetProperty="Opacity" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0.2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoteBSlide" Storyboard.TargetProperty="Y" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.7" Value="-6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMoteB" Storyboard.TargetProperty="Opacity" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,42,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.76" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.76" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteSlide" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-2.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteHaloSlide" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-2.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteTilt" Storyboard.TargetProperty="Angle" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="-4" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteHaloTilt" Storyboard.TargetProperty="Angle" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="-4" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMoteA" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMoteB" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.95" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.95" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- RowHoverAction: keep the row text clear of the hover button (26px + 8px margin + gap). -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
