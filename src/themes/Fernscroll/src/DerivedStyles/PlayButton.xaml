<!--
    Fernscroll: PlayButton & RunningActionIndicator.
    Hero Play / Install ribbon shaped as Snufkin's notched swallowtail pine-green banner
    (MELODY OF MOOMINVALLEY) with sunbeam-gold GlowFrame halo, inset cream hairline frame, gold
    botanical scroll curls gliding outward on hover, and sunbeam shimmer sweep. Switching to
    Twilight Nocturne Indigo while Launching/Running with PlayRoom clearance (right="26"), CancelLabel
    via RelativeSource Self, and RunningActionIndicator floating eighth note + diamond motes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.88" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Grid IsHitTestVisible="False">
                            <Grid.OpacityMask>
                                <VisualBrush Stretch="Fill">
                                    <VisualBrush.Visual>
                                        <Grid Width="160" Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                            </Grid.ColumnDefinitions>
                                            <Polygon Grid.Column="0" Points="0,0 16,0 16,40 0,40 9,20" Stretch="Fill" Fill="Black" />
                                            <Rectangle Grid.Column="1" Margin="-0.5,0" Fill="Black" />
                                            <Polygon Grid.Column="2" Points="0,0 16,0 7,20 16,40 0,40" Stretch="Fill" Fill="Black" />
                                        </Grid>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Grid.OpacityMask>
                            <Border x:Name="RunningWash"
                                    Background="{DynamicResource RunningIndicatorBrush}"
                                    Opacity="0.22" />
                            <Border x:Name="RunningFrame"
                                    BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                    BorderThickness="2" />
                        </Grid>
                        <Grid Height="2" Margin="20,0,20,5" VerticalAlignment="Bottom">
                            <Rectangle RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}"
                                       Opacity="0.35" />
                            <Rectangle x:Name="RunningFill"
                                       RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Grid x:Name="RunningNotesHost"
                              Margin="0,0,16,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Width="22" Height="22">
                            <Path x:Name="RunningNoteHalo"
                                  Data="M 5.2,1.6 L 10.5,0 L 10.5,2.6 L 6.6,3.8 L 6.6,10.5 C 6.6,12.2 5.0,13.5 3.1,13.5 C 1.4,13.5 0,12.4 0,10.9 C 0,9.4 1.4,8.2 3.1,8.2 C 3.9,8.2 4.6,8.4 5.2,8.9 Z"
                                  Width="11" Height="14"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stroke="{DynamicResource SelectedForegroundBrush}"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  Fill="{DynamicResource SelectedForegroundBrush}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="NoteHaloSlide" Y="0" />
                                        <RotateTransform x:Name="NoteHaloTilt" Angle="0" />
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                            <Path x:Name="RunningNote"
                                  Data="M 5.2,1.6 L 10.5,0 L 10.5,2.6 L 6.6,3.8 L 6.6,10.5 C 6.6,12.2 5.0,13.5 3.1,13.5 C 1.4,13.5 0,12.4 0,10.9 C 0,9.4 1.4,8.2 3.1,8.2 C 3.9,8.2 4.6,8.4 5.2,8.9 Z"
                                  Width="11" Height="14"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="{DynamicResource PrimaryButtonGlowBrush}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="NoteSlide" Y="0" />
                                        <RotateTransform x:Name="NoteTilt" Angle="0" />
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                            <Path x:Name="RunningMoteA"
                                  Data="M 3,0 L 3.8,2.2 L 6,3 L 3.8,3.8 L 3,6 L 2.2,3.8 L 0,3 L 2.2,2.2 Z"
                                  Width="5" Height="5"
                                  Stretch="Fill"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Fill="{DynamicResource SelectedForegroundBrush}"
                                  Opacity="0.85">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="MoteASlide" Y="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningActionLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteSlide" Storyboard.TargetProperty="Y" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-4" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="4" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteHaloSlide" Storyboard.TargetProperty="Y" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-4" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="4" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteTilt" Storyboard.TargetProperty="Angle" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="7" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="-7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteHaloTilt" Storyboard.TargetProperty="Angle" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="7" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="-7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoteASlide" Storyboard.TargetProperty="Y" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="-5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningActionLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningActionSteady">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.78" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.78" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteSlide" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-2.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteHaloSlide" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-2.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMoteA" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningActionFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningActionSteady" />
                                <RemoveStoryboard BeginStoryboardName="RunningActionFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="38,0" />
        <Setter Property="MinWidth" Value="184" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border Margin="-6" IsHitTestVisible="False">
                            <Control x:Name="Glow"
                                     Template="{DynamicResource GlowFrameTemplate}"
                                     Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                     Opacity="0.18" IsHitTestVisible="False" Focusable="False" />
                        </Border>

                        <!-- Swallowtail silhouette (3-column Grid so end V-notch angles stay crisp at any width) -->
                        <Grid x:Name="Rest" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <Polygon Grid.Column="0" Points="0,0 16,0 16,40 0,40 9,20" Stretch="Fill"
                                     Fill="{TemplateBinding Background}" />
                            <Rectangle Grid.Column="1" Margin="-0.5,0"
                                       Fill="{TemplateBinding Background}" />
                            <Polygon Grid.Column="2" Points="0,0 16,0 7,20 16,40 0,40" Stretch="Fill"
                                     Fill="{TemplateBinding Background}" />
                        </Grid>

                        <Grid x:Name="RunningScan" Visibility="Collapsed" Opacity="0.6" IsHitTestVisible="False">
                            <Grid.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=Rest}" Stretch="None" />
                            </Grid.OpacityMask>
                            <Border>
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.5" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                                <Rectangle Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0.45">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/melody-wisps.png'}"
                                                    TileMode="Tile"
                                                    Viewport="0,0,160,64"
                                                    ViewportUnits="Absolute"
                                                    Stretch="Fill" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Border>
                        </Grid>

                        <Grid x:Name="HoverFx" IsHitTestVisible="False">
                            <Grid x:Name="HoverPlate" Opacity="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>
                                <Polygon Grid.Column="0" Points="0,0 16,0 16,40 0,40 9,20" Stretch="Fill"
                                         Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                                <Rectangle Grid.Column="1" Margin="-0.5,0"
                                           Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                                <Polygon Grid.Column="2" Points="0,0 16,0 7,20 16,40 0,40" Stretch="Fill"
                                         Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            </Grid>
                            <Grid x:Name="PressedPlate" Opacity="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>
                                <Polygon Grid.Column="0" Points="0,0 16,0 16,40 0,40 9,20" Stretch="Fill"
                                         Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                                <Rectangle Grid.Column="1" Margin="-0.5,0"
                                           Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                                <Polygon Grid.Column="2" Points="0,0 16,0 7,20 16,40 0,40" Stretch="Fill"
                                         Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                            </Grid>
                            <Grid x:Name="Sweep" ClipToBounds="True" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                                <Grid.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=Rest}" Stretch="Fill" />
                                </Grid.OpacityMask>
                                <Canvas>
                                    <Canvas Opacity="0.24">
                                        <Canvas.RenderTransform>
                                            <TranslateTransform x:Name="SweepX" X="-90" />
                                        </Canvas.RenderTransform>
                                        <Path Data="M0,48 L16,48 L44,0 L28,0 Z" Fill="{DynamicResource PrimaryButtonGlowBrush}" />
                                        <Path Canvas.Left="22" Data="M0,48 L7,48 L35,0 L28,0 Z" Fill="{DynamicResource SelectedForegroundBrush}" />
                                    </Canvas>
                                </Canvas>
                            </Grid>
                        </Grid>

                        <Border x:Name="RunningHoverDim"
                                Background="{DynamicResource ScrimBrush}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=Rest}" Stretch="Fill" />
                            </Border.OpacityMask>
                        </Border>

                        <!-- Subtle inset cream trim inside ribbon top & bottom -->
                        <Border Margin="15,2.5,15,2.5"
                                BorderBrush="{DynamicResource SelectedBorderBrush}"
                                BorderThickness="0,1,0,1"
                                Opacity="0.34"
                                IsHitTestVisible="False" />

                        <!-- Flanking botanical gold scroll curls gliding outward on hover -->
                        <Control x:Name="CurlLeft"
                                 Template="{DynamicResource LocalScrollCurlLeftTemplate}"
                                 Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="12,0,0,0"
                                 Opacity="0.72"
                                 IsHitTestVisible="False"
                                 Focusable="False">
                            <Control.RenderTransform>
                                <TranslateTransform x:Name="LeftCurlSlide" X="0" />
                            </Control.RenderTransform>
                        </Control>
                        <Control x:Name="CurlRight"
                                 Template="{DynamicResource LocalScrollCurlRightTemplate}"
                                 Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"
                                 Opacity="0.72"
                                 IsHitTestVisible="False"
                                 Focusable="False">
                            <Control.RenderTransform>
                                <TranslateTransform x:Name="RightCurlSlide" X="0" />
                            </Control.RenderTransform>
                        </Control>

                        <!-- RunningMarkRoom left="0" right="26": keeps RUNNING / LAUNCHING / Cancel clear of RunningActionIndicator. -->
                        <Border x:Name="PlayRoom">
                            <ContentPresenter x:Name="PlayContent"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>

                        <TextBlock x:Name="CancelLabel"
                                   Text="{DynamicResource LOCCancelLabel}"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CurlLeft" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CurlRight" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,26,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,26,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.5" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.502" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.502" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CurlLeft" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CurlRight" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,26,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,26,0" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="CurlLeft" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="CurlRight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="LeftCurlSlide" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RightCurlSlide" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SweepX" Storyboard.TargetProperty="X" From="-90" To="420"
                                                         Duration="0:0:1.4" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.26" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26" />
                                        <DoubleAnimation Storyboard.TargetName="CurlLeft" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.26" />
                                        <DoubleAnimation Storyboard.TargetName="CurlRight" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.26" />
                                        <DoubleAnimation Storyboard.TargetName="LeftCurlSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="RightCurlSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="SweepX" Storyboard.TargetProperty="X" To="420" Duration="0:0:0.24" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.24" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsRunning}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
