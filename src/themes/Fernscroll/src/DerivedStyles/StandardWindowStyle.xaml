<!--
    Fernscroll: StandardWindowStyle (Settings, Add-ons, Game Editor, Progress and Dialog windows).
    44px parchment-soft title band with the Fernscroll botanical mark, symmetrical ink scroll flourishes
    flanking the Pathway Gothic One heading title (with PART_TextTitle inside a Collapsed Border so Playnite never
    paints unstyled bare text over the band), ghosted reed-note watermark, tapered ink bottom rule, and 44x44
    WindowBarButton caption controls. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome ResizeBorderThickness="5" CaptionHeight="44" CornerRadius="0"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Subtle cold-press parchment tooth over dialog body -->
                                <Control Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource HeadingForegroundBrush}"
                                         Opacity="0.03" IsHitTestVisible="False" Focusable="False" />

                                <!-- 44px Title Band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}" ClipToBounds="True">
                                    <!-- Ghosted Fernscroll watermark in clipped Canvas so small dialogs stay content-sized -->
                                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0" IsHitTestVisible="False">
                                        <Control Canvas.Left="-186" Canvas.Top="-10" Width="64" Height="64"
                                                 Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource HeadingForegroundBrush}"
                                                 Opacity="0.06" Focusable="False" IsHitTestVisible="False" />
                                    </Canvas>
                                    <!-- Tapered pen bottom rule -->
                                    <Control VerticalAlignment="Bottom" Margin="8,0,8,-2"
                                             Template="{DynamicResource LocalTaperRuleTemplate}" Foreground="{DynamicResource HeadingRuleBrush}"
                                             IsHitTestVisible="False" Focusable="False" />

                                    <!-- PART_TextTitle hidden inside a Collapsed Border so Playnite's visibility toggle cannot paint unstyled text -->
                                    <Border Visibility="Collapsed">
                                        <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}" />
                                    </Border>

                                    <DockPanel Margin="14,0,0,0" LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button x:Name="PART_ButtonMinimize" Style="{DynamicResource WindowBarButton}" Content="0" />
                                            <Button x:Name="PART_ButtonMaximize" Style="{DynamicResource WindowBarButton}" Content="1" />
                                            <Button x:Name="PART_ButtonClose" Style="{DynamicResource WindowBarButton}" Content="r" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Control Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource GlyphBrush}"
                                                     Focusable="False" IsHitTestVisible="False" />
                                            <Control Width="22" Height="11" Margin="0,0,7,0" VerticalAlignment="Center"
                                                     Template="{DynamicResource LocalScrollCurlLeftTemplate}" Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                     Focusable="False" IsHitTestVisible="False" />
                                            <TextBlock x:Name="DisplayTitle"
                                                       Text="{Binding Text, ElementName=PART_TextTitle, Converter={StaticResource StringToUpperCaseConverter}}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Control Width="22" Height="11" Margin="7,0,0,0" VerticalAlignment="Center"
                                                     Template="{DynamicResource LocalScrollCurlRightTemplate}" Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                     Focusable="False" IsHitTestVisible="False" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>

                                <!-- Drawn after title band with top offset equal to CaptionHeight (44) -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="DisplayTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="PART_ButtonMinimize" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_ButtonMaximize" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="PART_ButtonMaximize" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_ButtonMaximize" Property="Content" Value="2" />
                            <Setter TargetName="WindowBorder" Property="Padding" Value="8" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter TargetName="WindowBorder" Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
