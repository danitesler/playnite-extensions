<!--
    Fernscroll: game overview (Details).
    Warm botanical cream reading folio with parchment-faded HeroArt banner (GameBannerHeight /
    GameBannerDarken + 0.5 floor fade to PageRoot.Background.Color), proportional MathConverter banner
    spacer, framed CoverFrame, Swallowtail Pine Green hero Play ribbon + RunningActionIndicator,
    equal 40x40 Dark Plum More/Edit square buttons, Dark Plum Quest Card metadata folio crowned
    by Quest Shield (!), responsive GameDetailsPanePosition (Left/Right/Center/Stretch) breakpoints,
    SteamScreenshotsGameScope, curl-flanked tapered section headings, and EmptyGameTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <Border BorderBrush="{DynamicResource HeadingRuleBrush}">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer x:Name="PART_ScrollViewHost"
                                      CanContentScroll="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Visible">
                            <Grid x:Name="PageRoot" UseLayoutRounding="True">
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Background" Value="Transparent" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Control Template="{DynamicResource GrainTemplate}"
                                         Foreground="{DynamicResource HeadingForegroundBrush}"
                                         Opacity="0.03"
                                         IsHitTestVisible="False"
                                         Focusable="False" />

                                <!-- Hero Banner Art + GameBannerDarken (0.5 floor) + bottom fade into PageRoot.Background.Color -->
                                <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                    <Setter Property="Height" Value="0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                    <Setter Property="Height" Value="0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                    <Setter Property="Height" Value="0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                        <Rectangle.Style>
                                            <Style TargetType="{x:Type Rectangle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <Rectangle Height="80" VerticalAlignment="Top" Opacity="0.38">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.04" />
                                                <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.56" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>

                                <StackPanel Panel.ZIndex="2" Margin="28,0,28,28">
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Border x:Name="DetailsBannerSpacer" MinHeight="14" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 112 / 268'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                        <Setter Property="Height" Value="14" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
                                                        <Setter Property="Height" Value="14" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Header row: Title (left) + Action Ribbon Bar (right) -->
                                    <DockPanel Margin="0,8,0,20" LastChildFill="True">
                                        <Border x:Name="CoverFrame" Visibility="Collapsed">
                                            <Image x:Name="PART_ImageCover" />
                                        </Border>

                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Bottom"
                                                    Margin="20,0,0,0">
                                            <StackPanel.Resources>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Width" Value="42" />
                                                    <Setter Property="Height" Value="42" />
                                                    <Setter Property="MinWidth" Value="42" />
                                                    <Setter Property="MinHeight" Value="42" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type Button}">
                                                                <Grid Background="Transparent" SnapsToDevicePixels="True">
                                                                    <Border x:Name="Plate"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                                    <Border Margin="2"
                                                                            BorderBrush="{DynamicResource SelectedBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="2"
                                                                            Opacity="0.34"
                                                                            IsHitTestVisible="False" />
                                                                    <Border x:Name="HoverPlate"
                                                                            Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                                            Opacity="0" IsHitTestVisible="False" />
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="HoverPlate" Property="Opacity" Value="1" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </StackPanel.Resources>
                                            <Grid MinWidth="200" Height="46">
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                                <Control Style="{DynamicResource RunningActionIndicator}" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions"
                                                    Width="42" Height="42"
                                                    Margin="12,0,0,0"
                                                    ToolTip="{DynamicResource LOCMoreAction}">
                                                <ContentControl Width="18" Height="18"
                                                                Content="{DynamicResource IconOptions}"
                                                                ContentTemplate="{DynamicResource IconTemplate}"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame"
                                                    Width="42" Height="42"
                                                    Margin="8,0,0,0"
                                                    ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Width="18" Height="18"
                                                                Content="{DynamicResource IconEdit}"
                                                                ContentTemplate="{DynamicResource IconTemplate}"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel VerticalAlignment="Bottom">
                                            <DockPanel>
                                                <Image x:Name="PART_ImageIcon"
                                                       MaxWidth="48" MaxHeight="48"
                                                       Margin="0,0,14,0"
                                                       DockPanel.Dock="Left"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="Fant" />
                                                <Grid VerticalAlignment="Center">
                                                    <TextBlock x:Name="PART_TextDisplayName"
                                                               FontFamily="{DynamicResource HeadingFontFamily}"
                                                               FontSize="{DynamicResource FontSizeLargest}"
                                                               Foreground="Transparent"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName, Converter={StaticResource StringToUpperCaseConverter}}"
                                                               FontFamily="{DynamicResource HeadingFontFamily}"
                                                               FontSize="{DynamicResource FontSizeLargest}"
                                                               TextWrapping="Wrap"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Margin="0,10,0,0" x:Name="DetailsOverviewBody">
                                        <Grid.Tag>
                                            <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400">
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                <Binding Path="Tag" ElementName="DetailsMetadataContent" />
                                            </MultiBinding>
                                        </Grid.Tag>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}">
                                            <Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>

                                            <!-- Crowned Quest Shield overlapping top edge of Metadata Quest Card -->
                                            <Control Template="{DynamicResource LocalQuestShieldTemplate}"
                                                     Width="26" Height="30"
                                                     Background="{DynamicResource HeadingMarkerBrush}"
                                                     Foreground="{DynamicResource SelectedForegroundBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Top"
                                                     Margin="0,0,0,0"
                                                     Panel.ZIndex="4"
                                                     IsHitTestVisible="False"
                                                     Focusable="False" />

                                            <Border x:Name="DetailsMetadataContent"
                                                    Tag="{DynamicResource GameDetailsPaneWidth}"
                                                    Margin="0,14,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource ParchmentBrush}"
                                                    BorderBrush="{DynamicResource ParchmentEdgeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    TextElement.Foreground="{DynamicResource ParchmentTextBrush}">
                                                <Border.Style><Style TargetType="Border"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                <Border.Resources>
                                                    <Style TargetType="{x:Type Hyperlink}">
                                                        <Setter Property="Foreground" Value="{DynamicResource ParchmentLinkBrush}" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ParchmentTextBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Resources>
                                                <Grid ClipToBounds="True" Margin="0">
                                                    <Control Template="{DynamicResource LocalPlaqueDistressTemplate}"
                                                             Margin="3" IsHitTestVisible="False" Focusable="False" />
                                                    <Border Margin="3"
                                                            BorderBrush="{DynamicResource SelectedBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            Opacity="0.34"
                                                            IsHitTestVisible="False" />

                                                    <StackPanel Margin="16,20,16,16">
                                                        <!-- Quest Card Header: GAME DETAILS flanked by gold botanical scroll curls -->
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="6" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Control Template="{DynamicResource LocalScrollCurlLeftTemplate}"
                                                                         Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                                                         IsHitTestVisible="False" Focusable="False" />
                                                                <ContentPresenter Content="{DynamicResource LOCGameDetails}" VerticalAlignment="Center">
                                                                    <ContentPresenter.Resources>
                                                                        <DataTemplate DataType="{x:Type sys:String}">
                                                                            <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}"
                                                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                                                       Foreground="{DynamicResource ParchmentTitleBrush}" />
                                                                        </DataTemplate>
                                                                    </ContentPresenter.Resources>
                                                                </ContentPresenter>
                                                                <Control Template="{DynamicResource LocalScrollCurlRightTemplate}"
                                                                         Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                                                         VerticalAlignment="Center" Margin="8,0,0,0"
                                                                         IsHitTestVisible="False" Focusable="False" />
                                                            </StackPanel>
                                                            <Border Grid.Row="2" Height="1" Background="{DynamicResource SelectedBorderBrush}" Opacity="0.28" />
                                                        </Grid>

                                                        <Grid x:Name="DetailsMetadataViewport">
                                                            <WrapPanel x:Name="DetailsMetadataGroups" Grid.IsSharedSizeScope="True" UseLayoutRounding="False">
                                                                <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,0,-24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Margin" Value="0,-3,0,-3" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-3,-24,-3" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Margin" Value="0,-3,0,-3" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-3,-24,-3" /></MultiDataTrigger></Style.Triggers></Style></WrapPanel.Style>
                                                                <WrapPanel.Tag>
                                                                    <Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" />
                                                                </WrapPanel.Tag>
                                                                <Border x:Name="MetaProgress"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers><MultiDataTrigger>
    <MultiDataTrigger.Conditions>
        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
    </MultiDataTrigger.Conditions>
    <Setter Property="Visibility" Value="Collapsed" />
</MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
</Border>
<Grid x:Name="PART_ElemCompletionStatus" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,3,0,3" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,3,24,3" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MetaLabels" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{DynamicResource LOCCompletionStatus}" Foreground="{DynamicResource ParchmentLabelBrush}" FontSize="13.5" VerticalAlignment="Top" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="116" />
                                                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                        <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PropertyItemButton}" />
                                                                    </Grid>
                                                                </Grid>
<Grid x:Name="PART_ElemPlayTime" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,3,0,3" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,3,24,3" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MetaLabels" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{DynamicResource LOCTimePlayed}" Foreground="{DynamicResource ParchmentLabelBrush}" FontSize="13.5" VerticalAlignment="Top" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="116" />
                                                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                        <TextBlock x:Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ParchmentTextBrush}" />
                                                                    </Grid>
                                                                </Grid>
<Grid x:Name="PART_ElemLastPlayed" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,3,0,3" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,3,24,3" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MetaLabels" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{DynamicResource LOCLastPlayed}" Foreground="{DynamicResource ParchmentLabelBrush}" FontSize="13.5" VerticalAlignment="Top" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="116" />
                                                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                        <TextBlock x:Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ParchmentTextBrush}" />
                                                                    </Grid>
                                                                </Grid>
<Grid x:Name="PART_ElemRecentActivity" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,3,0,3" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,3,24,3" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MetaLabels" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{DynamicResource LOCRecentActivityLabel}" Foreground="{DynamicResource ParchmentLabelBrush}" FontSize="13.5" VerticalAlignment="Top" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="116" />
                                                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                        <TextBlock x:Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ParchmentTextBrush}" />
