<!--
    Fernscroll: Button & LoadMoreButton.
    Dark woodblock plum plaque with warm inset cream print rim, subtle woodblock flecks,
    smooth sunbeam-gold hover border, and preserved ThemeModifier Width="41" icon-button scaling.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="BasePlate"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Control Template="{DynamicResource LocalPlaqueDistressTemplate}"
                                 Margin="2" IsHitTestVisible="False" Focusable="False" />
                        <Border x:Name="InnerRim"
                                Margin="2"
                                BorderBrush="{DynamicResource SelectedBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Opacity="0.32"
                                IsHitTestVisible="False" />
                        <Border x:Name="HoverPlate"
                                Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="PressedPlate"
                                Background="{DynamicResource ButtonPressedBackgroundBrush}"
                                BorderBrush="{DynamicResource PrimaryButtonGlowBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="PART_Content"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="BasePlate" Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                            <Setter TargetName="BasePlate" Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                            <Setter TargetName="InnerRim" Property="Opacity" Value="0.48" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.20" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Width" Value="41">
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="Margin" Value="0,6" />
    </Style>
</ResourceDictionary>
