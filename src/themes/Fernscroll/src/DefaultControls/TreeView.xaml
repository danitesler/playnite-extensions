<!--
    Fernscroll: TreeView & TreeViewItem.
    Settings and Add-ons navigation rail in warm muted parchment (NormalBrush), 28px bare rows in
    body font (FontFamily / FontSize) with Dark Plum SelectedPlate, slim Sunbeam Gold bar, trailing
    botanical scroll curl on active selection, and reserved ScrollBar visibility in WindowSettings
    (252px) and WindowExtensions (280px).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
        <Style.Resources>
            <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
                <Setter Property="Tag" Value="FernscrollNavigationDivider" />
                <Setter Property="Background" Value="{DynamicResource HeadingRuleBrush}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </Style.Resources>
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer Focusable="False"
                                      Padding="0,8"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowSettings">
                <Setter Property="Width" Value="252" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowExtensions">
                <Setter Property="Width" Value="280" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,4,12,4" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Grid x:Name="SelectionBorder" Background="Transparent" MinHeight="28" Margin="10,1,8,1">
                            <Border x:Name="HoverPlate"
                                    Background="{DynamicResource ListItemHoverBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <Border x:Name="SelectedPlate"
                                    Background="{DynamicResource SelectedBrush}"
                                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <Border x:Name="SelectedInnerRim"
                                    Margin="2"
                                    BorderBrush="{DynamicResource SelectedBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <Rectangle x:Name="SelectedBar"
                                       Width="3"
                                       HorizontalAlignment="Left"
                                       Margin="0,5"
                                       RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}"
                                       Opacity="0"
                                       IsHitTestVisible="False" />
                            <Path x:Name="Marker"
                                  Data="{DynamicResource LocalScrollCurlGeometry}"
                                  Width="16" Height="11"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Stroke="{DynamicResource SelectedForegroundBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0"
                                  IsHitTestVisible="False" />
                            <DockPanel Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                <ToggleButton x:Name="Expander"
                                              ClickMode="Press"
                                              DockPanel.Dock="Left"
                                              Width="14" Height="16"
                                              Margin="0,0,6,0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Style>
                                        <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseStyle}">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                        <Grid Background="Transparent">
                                                            <Path x:Name="CollapsedChevron"
                                                                  Width="7" Height="10"
                                                                  Data="M 1,1 L 6,5 L 1,9"
                                                                  Stretch="Uniform"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                                  StrokeThickness="1.8"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                            <Path x:Name="ExpandedChevron"
                                                                  Width="10" Height="7"
                                                                  Data="M 1,1 L 5,6 L 9,1"
                                                                  Stretch="Uniform"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                                  StrokeThickness="1.8"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  Visibility="Collapsed" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="CollapsedChevron" Property="Visibility" Value="Collapsed" />
                                                                <Setter TargetName="ExpandedChevron" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <ContentPresenter x:Name="PART_Header"
                                                  ContentSource="Header"
                                                  DockPanel.Dock="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,22,0"
                                                  RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="180"
                                                       FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DockPanel>
                        </Grid>
                        <Border x:Name="ItemsHost" Margin="14,0,0,0" BorderThickness="0">
                            <ItemsPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="SelectionBorder">
                            <Setter TargetName="HoverPlate" Property="Opacity" Value="1" />
                            <Setter TargetName="Marker" Property="Opacity" Value="0.28" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="HoverPlate" Property="Opacity" Value="0" />
                            <Setter TargetName="SelectedPlate" Property="Opacity" Value="1" />
                            <Setter TargetName="SelectedInnerRim" Property="Opacity" Value="0.32" />
                            <Setter TargetName="SelectedBar" Property="Opacity" Value="1" />
                            <Setter TargetName="Marker" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Header.Tag, RelativeSource={RelativeSource Self}}" Value="FernscrollNavigationDivider">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="IsSelected" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                            <ContentPresenter ContentSource="Header" Margin="16,6" IsHitTestVisible="False" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
