<!--
    Fernscroll: ListView, GridViewColumnHeader, & ListViewItem.
    Parchment column headers and list container; Dark Plum pointed SAVE-#1 selection plaque
    (SelectedForegroundBrush cream text) and Twilight Nocturne Indigo running-game indicator
    with melody-wisps sweep, 2px foot line, and staggered floating music note + diamond motes
    inside reserved right-side RowRoom.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                    <Grid Margin="0" Background="{TemplateBinding Background}">
                        <Border x:Name="HoverTint"
                                Background="{DynamicResource ListItemHoverBrush}"
                                Opacity="0" IsHitTestVisible="False" />
                        <Border Padding="10,7"
                                BorderBrush="{DynamicResource HeadingRuleBrush}"
                                BorderThickness="0,0,0,1"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Margin="0,0,-8,0">
                            <Thumb.Style>
                                <Style TargetType="{x:Type Thumb}">
                                    <Setter Property="Width" Value="16" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="Transparent" Padding="6,4">
                                                    <Rectangle HorizontalAlignment="Center" Width="1" Fill="{DynamicResource HeadingRuleBrush}" Opacity="0.7" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Thumb.Style>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverTint" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static GridView.GridViewScrollViewerStyleKey}" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <ScrollViewer DockPanel.Dock="Top"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Focusable="False">
                                <GridViewHeaderRowPresenter Columns="{Binding Path=TemplatedParent.View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderContainerStyle="{Binding Path=TemplatedParent.View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderTemplate="{Binding Path=TemplatedParent.View.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderTemplateSelector="{Binding Path=TemplatedParent.View.ColumnHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                                            AllowsColumnReorder="{Binding Path=TemplatedParent.View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderContextMenu="{Binding Path=TemplatedParent.View.ColumnHeaderContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderToolTip="{Binding Path=TemplatedParent.View.ColumnHeaderToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    KeyboardNavigation.DirectionalNavigation="Local"
                                                    CanContentScroll="True"
                                                    CanHorizontallyScroll="False"
                                                    CanVerticallyScroll="False" />
                        </DockPanel>
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Orientation="Horizontal"
                                   Grid.Row="1"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListView}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListView}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ScrollViewer Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Grid Margin="2,1" SnapsToDevicePixels="True">
                        <Border x:Name="HoverRectangle"
                                Visibility="Collapsed"
                                Background="{DynamicResource ListItemHoverBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />

                        <Grid x:Name="SelectedPlate" Visibility="Collapsed" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                            </Grid.ColumnDefinitions>
                            <Polygon Grid.Column="0" Points="10,0 10,32 0,16" Stretch="Fill"
                                     Fill="{DynamicResource ListItemSelectedBrush}" />
                            <Rectangle Grid.Column="1" Margin="-0.5,0"
                                       Fill="{DynamicResource ListItemSelectedBrush}" />
                            <Polygon Grid.Column="2" Points="0,0 10,16 0,32" Stretch="Fill"
                                     Fill="{DynamicResource ListItemSelectedBrush}" />
                            <Grid Grid.Column="0" Grid.ColumnSpan="3" Margin="2.5,2" Opacity="0.38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="9" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="9" />
                                </Grid.ColumnDefinitions>
                                <Polygon Grid.Column="0" Points="9,0 9,28 0,14" Stretch="Fill"
                                         Fill="{DynamicResource SelectedBorderBrush}" />
                                <Rectangle Grid.Column="1" Margin="-0.5,0"
                                           Fill="{DynamicResource SelectedBorderBrush}" />
                                <Polygon Grid.Column="2" Points="0,0 9,14 0,28" Stretch="Fill"
                                         Fill="{DynamicResource SelectedBorderBrush}" />
                            </Grid>
                            <Grid Grid.Column="0" Grid.ColumnSpan="3" Margin="3.5,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                </Grid.ColumnDefinitions>
                                <Polygon Grid.Column="0" Points="8,0 8,26 0,13" Stretch="Fill"
                                         Fill="{DynamicResource ListItemSelectedBrush}" />
                                <Rectangle Grid.Column="1" Margin="-0.5,0"
                                           Fill="{DynamicResource ListItemSelectedBrush}" />
                                <Polygon Grid.Column="2" Points="0,0 8,13 0,26" Stretch="Fill"
                                         Fill="{DynamicResource ListItemSelectedBrush}" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="RunningIndicator"
                              Visibility="Collapsed"
                              Opacity="0.82"
                              IsHitTestVisible="False"
                              SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash"
                                    Background="{DynamicResource RunningIndicatorBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Opacity="0.16" />
                            <Border x:Name="RunningMarkPlate"
                                    Visibility="Visible"
                                    Width="42"
                                    HorizontalAlignment="Right"
                                    Margin="2"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource RunningIndicatorBrush}"
                                    Opacity="0.38">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningScan"
                                    Visibility="Collapsed"
                                    Opacity="0.6"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.5" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/melody-wisps.png'}"
                                                    TileMode="Tile"
                                                    Viewport="0,0,128,48"
                                                    ViewportUnits="Absolute"
                                                    Stretch="Fill" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Border>
                            <Grid Height="2" Margin="10,0,10,3" VerticalAlignment="Bottom">
                                <Rectangle RadiusX="1" RadiusY="1"
                                           Fill="{DynamicResource RunningIndicatorBrush}"
                                           Opacity="0.32" />
                                <Rectangle x:Name="RunningFill"
                                           RadiusX="1" RadiusY="1"
                                           Fill="{DynamicResource RunningIndicatorBrush}"
                                           RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Border x:Name="RunningFrame"
                                    BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                    BorderThickness="2"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border BorderBrush="{DynamicResource SelectedBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Opacity="0.55" />
                            </Border>
                            <Grid x:Name="RunningNotesHost"
                                  Margin="0,0,10,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Width="28" Height="22">
                                <Path x:Name="RunningNoteHalo"
                                      Data="M 5.2,1.6 L 10.5,0 L 10.5,2.6 L 6.6,3.8 L 6.6,10.5 C 6.6,12.2 5.0,13.5 3.1,13.5 C 1.4,13.5 0,12.4 0,10.9 C 0,9.4 1.4,8.2 3.1,8.2 C 3.9,8.2 4.6,8.4 5.2,8.9 Z"
                                      Width="12" Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource SelectedForegroundBrush}"
                                      StrokeThickness="2.2"
                                      StrokeLineJoin="Round"
                                      Fill="{DynamicResource SelectedForegroundBrush}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="NoteHaloSlide" Y="0" />
                                            <RotateTransform x:Name="NoteHaloTilt" Angle="0" />
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="RunningNote"
                                      Data="M 5.2,1.6 L 10.5,0 L 10.5,2.6 L 6.6,3.8 L 6.6,10.5 C 6.6,12.2 5.0,13.5 3.1,13.5 C 1.4,13.5 0,12.4 0,10.9 C 0,9.4 1.4,8.2 3.1,8.2 C 3.9,8.2 4.6,8.4 5.2,8.9 Z"
                                      Width="12" Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="{DynamicResource RunningIndicatorBrush}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="NoteSlide" Y="0" />
                                            <RotateTransform x:Name="NoteTilt" Angle="0" />
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="RunningMoteA"
                                      Data="M 3,0 L 3.8,2.2 L 6,3 L 3.8,3.8 L 3,6 L 2.2,3.8 L 0,3 L 2.2,2.2 Z"
                                      Width="6" Height="6"
                                      Stretch="Fill"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Margin="1,1,0,0"
                                      Fill="{DynamicResource PrimaryButtonGlowBrush}"
                                      Opacity="0.85">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="MoteASlide" Y="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="RunningMoteB"
                                      Data="M 2.5,0 L 3.2,1.8 L 5,2.5 L 3.2,3.2 L 2.5,5 L 1.8,3.2 L 0,2.5 L 1.8,1.8 Z"
                                      Width="5" Height="5"
                                      Stretch="Fill"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,1,2"
                                      Fill="{DynamicResource SelectedForegroundBrush}"
                                      Opacity="0.75">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="MoteBSlide" Y="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Grid>

                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <!-- RunningMarkRoom left="0" right="42": reserves the right-edge strip for the floating melody note so long titles truncate cleanly before it. -->
                            <Border x:Name="RowRoom">
                                <Grid ClipToBounds="True">
                                    <GridViewRowPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                          VerticalAlignment="Stretch" />
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Selector.IsSelected" Value="True">
                            <Setter TargetName="SelectedPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverRectangle" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningWash" Property="Margin" Value="10,0" />
                            <Setter TargetName="RunningWash" Property="CornerRadius" Value="0" />
                            <Setter TargetName="RunningFrame" Property="Margin" Value="10,0" />
                            <Setter TargetName="RunningFrame" Property="CornerRadius" Value="0" />
                            <Setter TargetName="RunningFrame" Property="BorderThickness" Value="0,2,0,2" />
                            <Setter TargetName="RunningScan" Property="Margin" Value="10,0" />
                            <Setter TargetName="RunningScan" Property="CornerRadius" Value="0" />
                            <Setter TargetName="RunningMarkPlate" Property="CornerRadius" Value="0" />
                            <Setter TargetName="RunningMarkPlate" Property="Margin" Value="2,2,10,2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverRectangle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,42,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.5" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.502" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.502" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteSlide" Storyboard.TargetProperty="Y" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-2.0" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="2.5" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteHaloSlide" Storyboard.TargetProperty="Y" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-2.0" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="2.5" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteTilt" Storyboard.TargetProperty="Angle" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="7" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="-7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteHaloTilt" Storyboard.TargetProperty="Angle" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="7" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="-7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoteASlide" Storyboard.TargetProperty="Y" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="-5" KeySpline="0.2,0.8 0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMoteA" Storyboard.TargetProperty="Opacity" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoteBSlide" Storyboard.TargetProperty="Y" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.7" Value="-6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMoteB" Storyboard.TargetProperty="Opacity" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,42,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.76" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.76" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteSlide" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-2.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteHaloSlide" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-2.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteTilt" Storyboard.TargetProperty="Angle" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="-4" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteHaloTilt" Storyboard.TargetProperty="Angle" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="-4" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMoteA" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMoteB" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.95" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.95" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Selector.IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
