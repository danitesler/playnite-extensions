<!--
    Fernscroll: TabControl & TabItem.
    Matches Snufkin's Settings / Inventory header tabs: muted taupe when inactive, flanking left/right
    botanical scroll curls + deep ink underline on the active tab, over a tapered rule divider.
    HeaderText is recolored via TargetName for clear contrast while keeping Foreground="TextBrush" on TabItem.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="HeaderStrip"
                              Background="{DynamicResource TabControlHeaderBackgroundBrush}"
                              Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3" />
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      IsItemsHost="True"
                                      Background="Transparent"
                                      KeyboardNavigation.TabIndex="1" />
                            <Control Grid.Row="1"
                                     Template="{DynamicResource LocalTaperRuleTemplate}"
                                     IsHitTestVisible="False"
                                     Focusable="False" />
                        </Grid>
                        <Border x:Name="ContentPanel"
                                Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                KeyboardNavigation.TabNavigation="Local"
                                KeyboardNavigation.DirectionalNavigation="Contained">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter TargetName="HeaderStrip" Property="Grid.Row" Value="1" />
                            <Setter TargetName="HeaderStrip" Property="Margin" Value="0,10,0,0" />
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="TabStripPlacement" Value="Left">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource TabControlHeaderBackgroundBrush}"
                                        BorderBrush="{DynamicResource HeadingRuleBrush}"
                                        BorderThickness="0,0,1,0"
                                        Margin="0,0,12,0">
                                    <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                                </Border>
                                <Border Grid.Column="1" Background="{TemplateBinding Background}">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent"
                                                      Margin="{TemplateBinding Padding}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Right">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{TemplateBinding Background}">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent"
                                                      Margin="{TemplateBinding Padding}" />
                                </Border>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource TabControlHeaderBackgroundBrush}"
                                        BorderBrush="{DynamicResource HeadingRuleBrush}"
                                        BorderThickness="1,0,0,0"
                                        Margin="12,0,0,0">
                                    <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="HoverWash"
                                Background="{DynamicResource ListItemHoverBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Margin="2,2,2,4"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Control x:Name="CurlLeft"
                                     Template="{DynamicResource LocalScrollCurlLeftTemplate}"
                                     Margin="0,0,7,0"
                                     Visibility="Hidden"
                                     IsHitTestVisible="False"
                                     Focusable="False" />
                            <TextBlock x:Name="HeaderText"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       FontSize="{DynamicResource FontSizeLarge}"
                                       Foreground="{DynamicResource TabItemForegroundBrush}">
                                <ContentPresenter x:Name="ContentSite"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                                            <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </TextBlock>
                            <Control x:Name="CurlRight"
                                     Template="{DynamicResource LocalScrollCurlRightTemplate}"
                                     Margin="7,0,0,0"
                                     Visibility="Hidden"
                                     IsHitTestVisible="False"
                                     Focusable="False" />
                        </StackPanel>
                        <Border x:Name="HoverIndicator"
                                Height="2"
                                Margin="18,0,18,1"
                                CornerRadius="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource TabItemHoverIndicatorBrush}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="SelectedIndicator"
                                Height="2.5"
                                Margin="14,0,14,1"
                                CornerRadius="1.25"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource TabItemIndicatorBrush}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                            <Setter TargetName="HoverWash" Property="Opacity" Value="0.6" />
                            <Setter TargetName="HoverIndicator" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                            <Setter TargetName="HoverWash" Property="Opacity" Value="0" />
                            <Setter TargetName="HoverIndicator" Property="Opacity" Value="0" />
                            <Setter TargetName="SelectedIndicator" Property="Opacity" Value="1" />
                            <Setter TargetName="CurlLeft" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CurlRight" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemForegroundBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HeaderText" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
