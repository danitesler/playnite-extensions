<!--
    Fernscroll: ContextMenu. Every menu and dropdown list (the hamburger menu, the top bar dropdowns through
    TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select
    boxes) is a page from Snufkin's Quest Card folio, the storybook's own Settings sheet:
    - Panel (LocalMenuSheetTemplate, shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and
      CustomControls/FilterSelectionBox.xaml): warm parchment with a cold-press paper tooth, a deep ink edge and the
      printed inset hairline 3px inside it; the hairline breaks at the foot for a pine twin-scroll flourish (~o~).
      Rows sit 6px below the top and 8px above the foot, so the flourish has room without clipping.
    Rows, group breaks and marked rows: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuSheetTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Control Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource TextBrush}" Opacity="0.06"
                     Margin="1" Focusable="False" IsTabStop="False" />
            <!-- Printed inset hairline, as on the SAVING SNIFF quest card -->
            <Border Margin="3" BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusSmall}" />
            <!-- Foot flourish: the hairline breaks for a pine twin scroll around an ink seed -->
            <Grid Height="8" Margin="0,0,0,1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <Border Margin="-3,0" Background="{DynamicResource PopupBackgroundBrush}" />
                <StackPanel Orientation="Horizontal">
                    <Control Template="{DynamicResource LocalScrollCurlLeftTemplate}" Foreground="{DynamicResource GlyphBrush}"
                             Width="16" Height="8" Focusable="False" IsTabStop="False" />
                    <Ellipse Width="4" Height="4" Margin="2,0" VerticalAlignment="Center" Fill="{DynamicResource PopupBorderBrush}" />
                    <Control Template="{DynamicResource LocalScrollCurlRightTemplate}" Foreground="{DynamicResource GlyphBrush}"
                             Width="16" Height="8" Focusable="False" IsTabStop="False" />
                </StackPanel>
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuSheetTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,6,0,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="5,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
