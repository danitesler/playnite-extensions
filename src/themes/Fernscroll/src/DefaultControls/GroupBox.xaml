<!--
    Fernscroll: GroupBox.
    Hand-lettered Pathway Gothic One section title flanked by subtle scroll curls over a star-column
    tapered rule so groups (including Statistics cards) remain strictly content-sized.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource HeadingRuleBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,6,0,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="HeaderBand" Grid.Row="0" Margin="0,2,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Control Grid.Column="0"
                                         Template="{DynamicResource LocalScrollCurlLeftTemplate}"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False"
                                         Focusable="False" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                                            <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Control Grid.Column="2"
                                         Template="{DynamicResource LocalScrollCurlRightTemplate}"
                                         Margin="7,0,0,0"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False"
                                         Focusable="False" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Control Grid.Column="0"
                                         Template="{DynamicResource LocalTaperRuleTemplate}"
                                         IsHitTestVisible="False"
                                         Focusable="False" />
                            </Grid>
                        </Grid>
                        <Border Grid.Row="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderBand" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderBand" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
