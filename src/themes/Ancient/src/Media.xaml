<!--
    Overlay on Playnite Default/Media.xaml.
    Icon set: original line artwork drawn for this theme (nothing taken or traced from the game), sized like the
    dashboard's small control icons (27px search, gear and return buttons at 1080p): plain, heavy, square-shouldered
    shapes. 24 grid, 1.75 wide strokes, round joins, flat caps, drawn by IconTemplate in the inherited foreground;
    IconSmallTemplate uses a 2.25 stroke for 12 to 16px hosts.

    Playnite's own menu icons (main menu, game menu) stay the Default theme's glyphs, recolored through TextBrush.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Geometry x:Key="IconSearch">M10.5 4 A6.5 6.5 0 1 1 10.5 17 A6.5 6.5 0 1 1 10.5 4 Z M15.2 15.2 L20.5 20.5</Geometry>
    <Geometry x:Key="IconClear">M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5</Geometry>
    <Geometry x:Key="IconViewSettings">M4 7 H9 M13 7 H20 M9 4.5 V9.5 M4 17 H13 M17 17 H20 M13 14.5 V19.5</Geometry>
    <Geometry x:Key="IconFilterPresets">M7 4 H17 V20 L12 16 L7 20 Z</Geometry>
    <Geometry x:Key="IconGroup">M4 5 H20 V9 H4 Z M4 12 H20 M4 16 H20 M4 20 H14</Geometry>
    <Geometry x:Key="IconSort">M7 4.5 V19 M4 16 L7 19 L10 16 M17 19.5 V5 M14 8 L17 5 L20 8</Geometry>
    <Geometry x:Key="IconDetailsView">M4 5 H20 V19 H4 Z M10 5 V19 M13 9 H17 M13 12.5 H17 M13 16 H15.5</Geometry>
    <Geometry x:Key="IconGridView">M4 4 H10.5 V10.5 H4 Z M13.5 4 H20 V10.5 H13.5 Z M4 13.5 H10.5 V20 H4 Z M13.5 13.5 H20 V20 H13.5 Z</Geometry>
    <Geometry x:Key="IconListView">M4 6 H5.5 M4 12 H5.5 M4 18 H5.5 M9 6 H20 M9 12 H20 M9 18 H20</Geometry>
    <Geometry x:Key="IconUpdate">M12 4 V15 M7.5 10.5 L12 15 L16.5 10.5 M5 19.5 H19</Geometry>
    <Geometry x:Key="IconExplorer">M4 6 H10 L12 8 H20 V19 H4 Z M4 11 H20</Geometry>
    <Geometry x:Key="IconRandom">M4.5 4.5 H19.5 V19.5 H4.5 Z M8.5 8.5 H9.5 M14.5 14.5 H15.5 M12 12 H12.01 M14.5 8.5 H15.5 M8.5 14.5 H9.5</Geometry>
    <Geometry x:Key="IconViewRandom">M4 7.5 H8 L16 16.5 H20 M17.5 14 L20 16.5 L17.5 19 M4 16.5 H8 L10.5 13.7 M13.5 10.3 L16 7.5 H20 M17.5 5 L20 7.5 L17.5 10</Geometry>
    <Geometry x:Key="IconFilter">M4 5 H20 L14 12.5 V19 L10 17 V12.5 Z</Geometry>
    <Geometry x:Key="IconNotifications">M7 16 V10.5 A5 5 0 0 1 17 10.5 V16 L19 18 H5 Z M10 20.5 H14</Geometry>
    <!-- Main menu: an original faceted keystone, not the game's logo. -->
    <Geometry x:Key="IconMainMenu">M12 3 L20.5 8 L18 19 L12 21 L6 19 L3.5 8 Z M12 3 V21 M3.5 8 L12 12 L20.5 8</Geometry>
    <Geometry x:Key="IconLibrary">M5 4.5 H9 V19.5 H5 Z M11 4.5 H15 V19.5 H11 Z M16.5 5.5 L19.8 4.8 L21.5 18.8 L18.2 19.5 Z</Geometry>
    <Geometry x:Key="IconStatistics">M4 20 H20 M7 17 V12 M11 17 V7 M15 17 V10 M19 17 V5</Geometry>
    <Geometry x:Key="IconWindowMinimize">M6.5 12 H17.5</Geometry>
    <Geometry x:Key="IconWindowMaximize">M6.5 6.5 H17.5 V17.5 H6.5 Z</Geometry>
    <Geometry x:Key="IconWindowRestore">M9 9 V6 H18 V15 H15 M6 9 H15 V18 H6 Z</Geometry>
    <Geometry x:Key="IconWindowClose">M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5</Geometry>
    <!-- The dashboard dropdown arrow is a solid chevron; drawn here as a stroke. -->
    <Geometry x:Key="IconDropDown">M7 10 L12 15 L17 10</Geometry>
    <Geometry x:Key="IconSubmenu">M10 7 L15 12 L10 17</Geometry>
    <Geometry x:Key="IconCheck">M5.5 12.5 L10 17 L18.5 7.5</Geometry>
    <Geometry x:Key="IconAdd">M12 5 V19 M5 12 H19</Geometry>
    <Geometry x:Key="IconEdit">M5 19 L6 15 L15.5 5.5 L18.5 8.5 L9 18 Z</Geometry>
    <Geometry x:Key="IconRemove">M5 7 H19 M9.5 7 V4.5 H14.5 V7 M6.5 7 L7.5 20 H16.5 L17.5 7</Geometry>
    <Geometry x:Key="IconOptions">M6 12 H6.01 M12 12 H12.01 M18 12 H18.01</Geometry>
    <Geometry x:Key="IconPlay">M8 5 L19 12 L8 19 Z</Geometry>
    <Geometry x:Key="IconInfo">M12 3.5 A8.5 8.5 0 1 1 12 20.5 A8.5 8.5 0 1 1 12 3.5 Z M12 11 V16.5 M12 7.5 H12.01</Geometry>

    <!-- Content = one of the geometries above, drawn as a stroke in the inherited foreground. The host sets the size. -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" StrokeThickness="1.75"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" StrokeThickness="2.25"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentPresenter Width="18" Height="18"
                          Content="{DynamicResource IconSearch}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource IconClear}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
</ResourceDictionary>
