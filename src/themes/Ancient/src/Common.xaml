<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    The Dota 2 dashboard is built from a few marks: bevelled plates (a vertical two-stop gradient with a lit top and
    left edge and a dark bottom and right edge), paired separator lines (1px black next to 1px faint grey), and
    uppercase labels. BevelTemplate and DividerTemplate are those marks, drawn from brushes of the hosting Control.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- The dashboard's ButtonBevel / PlayButton plate ([CSS] dotastyles.css .ButtonBevel, play.css .PlayButton):
         the host's Background, darkened toward the top (the gradient's first stop) by BevelShadowBrush through a
         mask, 1px lit edges top and left, 1px dark edges bottom and right. Host: a Control stretched behind the
         content, hit testing off. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle Fill="{DynamicResource BevelShadowBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#55000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.55" />
            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.55" />
        </Grid>
    </ControlTemplate>

    <!-- The dashboard's separator ([CSS] dashboard.css #VerticalSeparator): 1px black over 1px faint light line,
         here laid horizontally and fading out to the right. Host: a Control; 2px tall, as wide as its parent. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="{x:Type Control}">
        <StackPanel Height="2" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <StackPanel.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="Black" Offset="0.6" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </StackPanel.OpacityMask>
            <Rectangle Height="1" Fill="{DynamicResource BevelShadowBrush}" />
            <Rectangle Height="1" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
        </StackPanel>
    </ControlTemplate>

    <!-- Caption above a block: the title font, semibold, in the muted label grey ([CSS] .ButtonDark Label). -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <!-- Keyboard focus (keyboard only): a 1px pale teal outline, 2px outside the control. The game has none. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="1" Stroke="{DynamicResource FocusBrush}"
                               SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing. The game draws at 1080p with 36px buttons (min-height 36, padding 4,10), 41px dropdowns
         (padding 4,8) and 36px text entries (padding 5,7,3,7); Playnite's 14px body text gives the same heights here. -->
    <Thickness x:Key="ButtonPadding">16,4,16,4</Thickness> <!-- .ButtonBevel: 36px, uppercase label (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">8,4,8,4</Thickness> <!-- TextEntry: 34px (height now set by ControlHeight) -->
    <Thickness x:Key="MenuPadding">0</Thickness> <!-- DropDownMenu: items run edge to edge -->
    <Thickness x:Key="MenuItemPadding">16,7,16,6</Thickness> <!-- DropDownMenu Label: padding 6,0,2,16 -->
    <Thickness x:Key="ComboBoxDropDownPadding">0</Thickness> <!-- DropDownMenu -->
    <Thickness x:Key="ComboBoxItemPadding">16,7,16,6</Thickness> <!-- DropDownMenu Label -->
    <Thickness x:Key="ListBoxItemPadding">12,6,12,6</Thickness> <!-- List box item -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness> <!-- Group box body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness> <!-- Gap under the group box header -->
    <Thickness x:Key="TooltipPadding">12,8,12,8</Thickness> <!-- tooltip_base.css #Contents padding 16 at 18px text -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">20</sys:Double> <!-- Top strip and sidebar icons -->
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails. The tiles are the host's Foreground at low opacity; the whole thing pulses while visible.
         Host: a Control with Foreground set and hit testing off, next to the plugin's ContentControl. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" Background="{TemplateBinding Foreground}" Opacity="0.15" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <UniformGrid Width="1600" Height="173" Rows="1" Columns="5">
                    <Border Margin="0,0,13,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="6,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="6,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="6,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="13,0,0,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                </UniformGrid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Box-shadow glow of the dashboard (Images/fx/glow-frame.png, generated by art/fx.py): a white 9-slice mask drawn in the host's
         Foreground, so every glow follows the brush the host passes (ThemeModifier edits included). The sprite's lit edge sits at
         inset 32 (slices 44 / 40 / 44, the empty centre is skipped); the host goes at Margin -32 around the element it lights.
         Columns are 44 + star + 44, so it reports no large desired size. No BitmapCache on glow layers. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,84,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>
    <!-- Empty game page: the keystone as the dashboard's loading mark. The outline floats over a breathing blue-white glow, two dashed rune rings sway
         against each other, a ghost keystone spreads outward and fades, motes drift up, and the white SearchingAnimation wash (2s) stays on the mark.
         Everything runs on named transforms and opacities from ControlTemplate.Triggers (never a Style trigger), and stops with the page. -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Grid Width="340" Height="250" HorizontalAlignment="Center">
                <Ellipse x:Name="EmptyKeyGlow" Width="300" Height="300" Fill="{DynamicResource SidebarItemSelectedGlowBrush}" Opacity="0.3" IsHitTestVisible="False">
                    <Ellipse.OpacityMask>
                        <RadialGradientBrush>
                            <GradientStop Color="#CC000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.72" />
                        </RadialGradientBrush>
                    </Ellipse.OpacityMask>
                </Ellipse>
                <Ellipse Width="228" Height="228" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1" StrokeDashArray="1.5 7" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform x:Name="EmptyKeyRingA" Angle="-10" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="188" Height="188" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1" StrokeDashArray="14 6 2 6" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform x:Name="EmptyKeyRingB" Angle="10" /></Ellipse.RenderTransform>
                </Ellipse>
                <!-- the ghost keystone that spreads and fades -->
                <Grid Width="120" Height="120" Opacity="0" x:Name="EmptyKeyEcho" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="EmptyKeyEchoScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                    <Path Data="M12 2.5 L20.5 7.4 L18.4 18.6 L12 21.4 L5.6 18.6 L3.5 7.4 Z" Stretch="Uniform" StrokeThickness="1" StrokeLineJoin="Round" Stroke="{DynamicResource SelectedForegroundBrush}" Margin="2" />
                </Grid>
                <Grid Width="120" Height="120" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><TranslateTransform x:Name="EmptyKeyFloat" Y="0" /></Grid.RenderTransform>
                    <Path Data="M12 2.5 L20.5 7.4 L18.4 18.6 L12 21.4 L5.6 18.6 L3.5 7.4 Z" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round" Stroke="{DynamicResource TextBrushDarker}" Margin="2" />
                    <Path Data="M12 7 L16.2 9.4 L15.1 15.6 L12 17 L8.9 15.6 L7.8 9.4 Z" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round" Stroke="{DynamicResource TextBrushDarker}" Margin="33" />
                    <Grid x:Name="EmptyKeyWash" Opacity="0">
                        <Path Data="M12 2.5 L20.5 7.4 L18.4 18.6 L12 21.4 L5.6 18.6 L3.5 7.4 Z" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round" Stroke="{DynamicResource SelectedForegroundBrush}" Margin="2" />
                        <Path Data="M12 7 L16.2 9.4 L15.1 15.6 L12 17 L8.9 15.6 L7.8 9.4 Z" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round" Stroke="{DynamicResource SelectedForegroundBrush}" Margin="33" />
                    </Grid>
                </Grid>
                <!-- motes -->
                <Path x:Name="EmptyKeyMoteA" Data="M3,0 L6,3 3,6 0,3 Z" Fill="{DynamicResource SelectedForegroundBrush}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="92,0,0,40">
                    <Path.RenderTransform><TranslateTransform x:Name="EmptyKeyMoteAShift" Y="0" /></Path.RenderTransform>
                </Path>
                <Path x:Name="EmptyKeyMoteB" Data="M3,0 L6,3 3,6 0,3 Z" Fill="{DynamicResource SidebarItemSelectedGlowBrush}" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,84,60">
                    <Path.RenderTransform><TranslateTransform x:Name="EmptyKeyMoteBShift" Y="0" /></Path.RenderTransform>
                </Path>
                <Path x:Name="EmptyKeyMoteC" Data="M3,0 L6,3 3,6 0,3 Z" Fill="{DynamicResource TextBrushDarker}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="40,0,0,26">
                    <Path.RenderTransform><TranslateTransform x:Name="EmptyKeyMoteCShift" Y="0" /></Path.RenderTransform>
                </Path>
            </Grid>
            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,6,0,0"
                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold"
                       Typography.Capitals="AllSmallCaps" Foreground="{DynamicResource TextBrushDarker}" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyKeyIdle">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="EmptyKeyGlow" Storyboard.TargetProperty="Opacity" From="0.15" To="0.45" Duration="0:0:3.6" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyKeyRingA" Storyboard.TargetProperty="Angle" From="-10" To="10" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyKeyRingB" Storyboard.TargetProperty="Angle" From="10" To="-10" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyKeyFloat" Storyboard.TargetProperty="Y" From="0" To="-7" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyKeyWash" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="EmptyKeyEchoScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.9" Duration="0:0:4" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyKeyEchoScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.9" Duration="0:0:4" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyKeyEcho" Storyboard.TargetProperty="Opacity" From="0.5" To="0" Duration="0:0:4" RepeatBehavior="Forever" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyKeyMoteA" Storyboard.TargetProperty="Opacity" Duration="0:0:5" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.9" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:5" Value="0" KeySpline="0.4,0,0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="EmptyKeyMoteAShift" Storyboard.TargetProperty="Y" From="0" To="-70" Duration="0:0:5" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyKeyMoteB" Storyboard.TargetProperty="Opacity" Duration="0:0:6" BeginTime="0:0:1.5" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.9" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:6" Value="0" KeySpline="0.4,0,0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="EmptyKeyMoteBShift" Storyboard.TargetProperty="Y" From="0" To="-84" Duration="0:0:6" BeginTime="0:0:1.5" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyKeyMoteC" Storyboard.TargetProperty="Opacity" Duration="0:0:4.5" BeginTime="0:0:3" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0.8" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:4.5" Value="0" KeySpline="0.4,0,0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="EmptyKeyMoteCShift" Storyboard.TargetProperty="Y" From="0" To="-60" Duration="0:0:4.5" BeginTime="0:0:3" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyKeyIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
