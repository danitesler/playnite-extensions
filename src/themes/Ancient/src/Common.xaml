<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    The Dota 2 dashboard is built from a few marks: bevelled plates (a vertical two-stop gradient with a lit top and
    left edge and a dark bottom and right edge), paired separator lines (1px black next to 1px faint grey), and
    uppercase labels. BevelTemplate and DividerTemplate are those marks, drawn from brushes of the hosting Control.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- The dashboard's ButtonBevel / PlayButton plate ([CSS] dotastyles.css .ButtonBevel, play.css .PlayButton):
         the host's Background, darkened toward the top (the gradient's first stop) by BevelShadowBrush through a
         mask, 1px lit edges top and left, 1px dark edges bottom and right. Host: a Control stretched behind the
         content, hit testing off. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle Fill="{DynamicResource BevelShadowBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#55000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.55" />
            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.55" />
        </Grid>
    </ControlTemplate>

    <!-- The dashboard's separator ([CSS] dashboard.css #VerticalSeparator): 1px black over 1px faint light line,
         here laid horizontally and fading out to the right. Host: a Control; 2px tall, as wide as its parent. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="{x:Type Control}">
        <StackPanel Height="2" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <StackPanel.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="Black" Offset="0.6" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </StackPanel.OpacityMask>
            <Rectangle Height="1" Fill="{DynamicResource BevelShadowBrush}" />
            <Rectangle Height="1" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
        </StackPanel>
    </ControlTemplate>

    <!-- Caption above a block: the title font, semibold, in the muted label grey ([CSS] .ButtonDark Label). -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <!-- Keyboard focus (keyboard only): a 1px pale teal outline, 2px outside the control. The game has none. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="1" Stroke="{DynamicResource FocusBrush}"
                               SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing. The game draws at 1080p with 36px buttons (min-height 36, padding 4,10), 41px dropdowns
         (padding 4,8) and 36px text entries (padding 5,7,3,7); Playnite's 14px body text gives the same heights here. -->
    <Thickness x:Key="ButtonPadding">16,4,16,4</Thickness> <!-- .ButtonBevel: 36px, uppercase label (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">8,4,8,4</Thickness> <!-- TextEntry: 34px (height now set by ControlHeight) -->
    <Thickness x:Key="MenuPadding">0</Thickness> <!-- DropDownMenu: items run edge to edge -->
    <Thickness x:Key="MenuItemPadding">16,7,16,6</Thickness> <!-- DropDownMenu Label: padding 6,0,2,16 -->
    <Thickness x:Key="ComboBoxDropDownPadding">0</Thickness> <!-- DropDownMenu -->
    <Thickness x:Key="ComboBoxItemPadding">16,7,16,6</Thickness> <!-- DropDownMenu Label -->
    <Thickness x:Key="ListBoxItemPadding">12,6,12,6</Thickness> <!-- List box item -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness> <!-- Group box body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness> <!-- Gap under the group box header -->
    <Thickness x:Key="TooltipPadding">12,8,12,8</Thickness> <!-- tooltip_base.css #Contents padding 16 at 18px text -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">20</sys:Double> <!-- Top strip and sidebar icons -->
    <sys:Double x:Key="GameBannerHeight">340</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails. The tiles are the host's Foreground at low opacity; the whole thing pulses while visible.
         Host: a Control with Foreground set and hit testing off, next to the plugin's ContentControl. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" Background="{TemplateBinding Foreground}" Opacity="0.15" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <UniformGrid Width="1600" Height="173" Rows="1" Columns="5">
                    <Border Margin="0,0,13,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="6,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="6,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="6,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="13,0,0,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                </UniformGrid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Box-shadow glow of the dashboard (Images/fx/glow-frame.png, generated by art/fx.py): a white 9-slice mask drawn in the host's
         Foreground, so every glow follows the brush the host passes (ThemeModifier edits included). The sprite's lit edge sits at
         inset 32 (slices 44 / 40 / 44, the empty centre is skipped); the host goes at Margin -32 around the element it lights.
         Columns are 44 + star + 44, so it reports no large desired size. No BitmapCache on glow layers. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,84,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
