<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    A top bar tab of the Dota 2 dashboard ([CSS] dashboard.css .TopBarMenuItem), on the left rail:
    - Left or right rail (the intended layout): icon only, 64x52, muted at rest ([CSS] #777f88), white on hover,
      white over the blue glow when current; the title is the tooltip.
    - Top or bottom bar (fallback): the title only, uppercase in the title font, 18px semibold ([CSS] font-size 18px,
      font-family titleFont, font-weight semi-bold, text-transform uppercase), centered in a cell at least 140px wide
      ([CSS] #TopBarHeroes width 164px) with 24px either side. Muted grey at rest ([CSS] color #777f88: TextBrushDarker);
      white under the pointer ([CSS] :hover color white); white with a blue glow behind it when current
      ([CSS] :selected text-shadow 0 0 20px #3382ff: SidebarItemSelectedGlowBrush as a radial wash, since WPF text
      has no glow). No dividers, no underline: the game marks the current tab by the glow alone.
    Library and Statistics get this theme's icons; add-on items keep their own icon. PART_ProgressStatus is a 2px bar
    along the edge facing the library.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="{TemplateBinding Background}">
                        <!-- The selected glow: a soft blue ellipse behind the label. -->
                        <Rectangle x:Name="Glow" Fill="{DynamicResource SidebarItemSelectedGlowBrush}" Opacity="0"
                                   Margin="6,8,6,8" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="#70000000" Offset="0" />
                                    <GradientStop Color="#30000000" Offset="0.45" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>

                        <Grid x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid x:Name="IconHost" Width="22" Height="22">
                                <Viewbox x:Name="ItemIcon">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Viewbox>
                                <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                ContentTemplate="{DynamicResource IconTemplate}" />
                            </Grid>
                            <TextBlock x:Name="Title" Visibility="Collapsed" Margin="24,2,24,0" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="18" FontWeight="SemiBold"
                                       Text="{Binding Title, Converter={StaticResource StringToUpperCaseConverter}}" />
                        </Grid>

                        <ProgressBar x:Name="PART_ProgressStatus" Width="2" HorizontalAlignment="Right"
                                     BorderThickness="0" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="Glow" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="PART_ProgressStatus" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Visible" TargetName="Title" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="IconHost" />
                            <Setter Property="Margin" Value="0,10,0,10" TargetName="Glow" />
                            <Setter Property="Width" Value="{x:Static sys:Double.NaN}" TargetName="PART_ProgressStatus" />
                            <Setter Property="Height" Value="2" TargetName="PART_ProgressStatus" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="PART_ProgressStatus" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="PART_ProgressStatus" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Visible" TargetName="Title" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="IconHost" />
                            <Setter Property="Margin" Value="0,10,0,10" TargetName="Glow" />
                            <Setter Property="Width" Value="{x:Static sys:Double.NaN}" TargetName="PART_ProgressStatus" />
                            <Setter Property="Height" Value="2" TargetName="PART_ProgressStatus" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="PART_ProgressStatus" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="PART_ProgressStatus" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="MinWidth" Value="140" />
                <Setter Property="Height" Value="62" />
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="MinWidth" Value="140" />
                <Setter Property="Height" Value="62" />
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
