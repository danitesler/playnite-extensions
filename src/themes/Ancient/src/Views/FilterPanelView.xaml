<!--
    Overlay on Playnite Default/Views/FilterPanelView.xaml: Playnite's panel on the dashboard's side panel slate (NormalBrush, the
    chat panel #161E24), so it reads over the library's background art. Layout, parts and keyed styles stay
    Playnite's (BasedOn the Default style, which loads before this file).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type FilterPanel}" BasedOn="{StaticResource {x:Type FilterPanel}}">
        <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
    </Style>
</ResourceDictionary>
