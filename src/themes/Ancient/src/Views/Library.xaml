<!--
    Overlay on Playnite Default/Views/Library.xaml.
    Like the dashboard, where the black strip and the pages float over the menu scene
    ([CSS] dashboard.css #DashboardCore, #TopBarSecondaryTabs), the game's background art fills the whole library
    layer, the strip (TopPanel) included: it fades out toward the bottom and the left, then a vignette in the
    layer's own brush darkens its edges so the list stays readable. The fades are plain gradients, not opacity masks
    (masked art behind animated controls leaves dark seams on scaled displays). PART_ImageBackground and the PART_View* names are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid Background="{DynamicResource ContentBackgroundBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.RowSpan="2" IsHitTestVisible="False">
                            <!-- Plain gradients in the layer's own brush, no OpacityMask and no BitmapCache: the animated top bar items, PLAY and
                                 the cover hover sit over this art, and masked art repainted in part left dark seams on scaled displays. -->
                            <Border x:Name="LayerSwatch" Background="{DynamicResource ContentBackgroundBrush}" Visibility="Collapsed" />
                            <FadeImage x:Name="PART_ImageBackground" HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <!-- Faded toward the left (art at 25% at the edge, full from 35%) -->
                            <Rectangle Opacity="0.75">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{Binding Background.Color, ElementName=LayerSwatch}" />
                                        <GradientStop Offset="0.35" Color="#00000000" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- Faded toward the bottom (full to the middle, gone at the foot) -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0.5" Color="#00000000" />
                                        <GradientStop Offset="1" Color="{Binding Background.Color, ElementName=LayerSwatch}" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Border Background="{DynamicResource ContentBackgroundBrush}" Opacity="0.5" />
                            <!-- Vignette: the layer's brush closing in from the edges. -->
                            <Rectangle Opacity="0.88">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.8" RadiusY="0.9">
                                        <GradientStop Offset="0.45" Color="#00000000" />
                                        <GradientStop Offset="1" Color="{Binding Background.Color, ElementName=LayerSwatch}" />
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <TopPanel Grid.Row="0" />

                        <DockPanel Grid.Row="1">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}" />

                            <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                           DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}" />

                            <Grid DockPanel.Dock="Left">
                                <LibraryDetailsView x:Name="PART_ViewDetails" />
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
