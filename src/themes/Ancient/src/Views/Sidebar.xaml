<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    The Dota 2 dashboard top bar ([CSS] dashboard.css #TopBar, #TopBarMainContent, #TopBarMainNav). Intended layout:
    Sidebar position = Top. Then it is a 64px band across the window (the game's tabs are 60px): the slate bar
    (ShellBackgroundBrush) shading darker toward its top, a paired rule under it (1px black, 1px faint light, as the
    game's #VerticalSeparator), the home button at the left, a paired vertical separator, then the tabs
    (SidebarItem.xaml). 146px on the right stay clear for the caption buttons.
    Left and right make a 64px icon rail with the same slate; bottom is a strip.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Home button ([CSS] #DOTASettingsButton wash #444a55, hover #9999aa): the keystone glyph in the gear grey,
         lighter under the pointer, no plate. Also used by Views/TopPanel.xaml when the sidebar is hidden. -->
    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid x:Name="Root" Background="{DynamicResource ShellBackgroundBrush}">
                        <!-- The bar's shading: darker at the window edge, lit toward the content (sideways on a rail). -->
                        <Rectangle x:Name="Shade" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.45" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Black" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle x:Name="ShadeTop" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.55" IsHitTestVisible="False"
                                   Visibility="Collapsed">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Black" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="0.85" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>

                        <!-- Paired rule on the edge facing the library: black, then faint light. -->
                        <Border x:Name="RuleOuter" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                        <Border x:Name="RuleInner" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,1,0"
                                Margin="0,0,1,0" IsHitTestVisible="False" />

                        <DockPanel x:Name="DockContentHolder" Margin="0,0,2,0">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}" DockPanel.Dock="Top">
                                <ContentPresenter Width="26" Height="26"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <!-- The game's #VerticalSeparator: 2px wide, 36px tall, black then faint light. -->
                            <StackPanel x:Name="Separator" DockPanel.Dock="Top" Orientation="Vertical" Width="36"
                                        HorizontalAlignment="Center" Margin="0,0,0,8" IsHitTestVisible="False">
                                <Rectangle x:Name="SeparatorDark" Height="1" Fill="{DynamicResource BevelShadowBrush}" />
                                <Rectangle x:Name="SeparatorLight" Height="1" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
                            </StackPanel>

                            <ScrollViewer x:Name="ScrollSidebarItems" DockPanel.Dock="Top"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="True">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="RuleOuter" />
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="RuleInner" />
                            <Setter Property="Margin" Value="1,0,0,0" TargetName="RuleInner" />
                            <Setter Property="Margin" Value="2,0,0,0" TargetName="DockContentHolder" />
                            <Setter Property="Margin" Value="0,36,0,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="OpacityMask" TargetName="Shade">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Color="Black" Offset="0" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Shade" />
                            <Setter Property="Visibility" Value="Visible" TargetName="ShadeTop" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="RuleOuter" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="RuleInner" />
                            <Setter Property="Margin" Value="0,0,0,1" TargetName="RuleInner" />
                            <Setter Property="Margin" Value="0,0,0,2" TargetName="DockContentHolder" />
                            <Setter Property="Margin" Value="8,0,0,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="Separator" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="Separator" />
                            <Setter Property="Width" Value="2" TargetName="Separator" />
                            <Setter Property="Height" Value="36" TargetName="Separator" />
                            <Setter Property="Margin" Value="4,0,12,0" TargetName="Separator" />
                            <Setter Property="VerticalAlignment" Value="Center" TargetName="Separator" />
                            <Setter Property="Width" Value="1" TargetName="SeparatorDark" />
                            <Setter Property="Height" Value="36" TargetName="SeparatorDark" />
                            <Setter Property="Width" Value="1" TargetName="SeparatorLight" />
                            <Setter Property="Height" Value="36" TargetName="SeparatorLight" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,146,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Shade" />
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="RuleOuter" />
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="RuleInner" />
                            <Setter Property="Margin" Value="0,1,0,0" TargetName="RuleInner" />
                            <Setter Property="Margin" Value="0,2,0,0" TargetName="DockContentHolder" />
                            <Setter Property="Margin" Value="8,0,0,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Separator" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
