<!--
    Overlay on Playnite Default/Views/TopPanel.xaml.
    The Dota 2 dashboard's secondary strip under the top bar ([CSS] dashboard.css #TopBarSecondaryTabs,
    #TopBarSearchContainer): a 52px black band (TopPanelBackgroundBrush, [CSS] #000000aa) that thins out toward the
    right. Playnite's view, sort, group and filter buttons are icons in the strip's muted teal-grey at the left, where
    the game puts its secondary tabs; the search box sits at the right like the game's (350px, [CSS] #TopBarSearchBox).
    While the sidebar is not at the top this is the topmost bar, so 146px stay clear on the right for the caption
    buttons. The main menu button shows here only while the sidebar is hidden. All PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" TextElement.Foreground="{DynamicResource DataChangeNotifBrush}" Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <!-- Looked up from code for the main menu; the popup surface from DefaultControls/ContextMenu.xaml. -->
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <!-- Filter toggle: muted icon, white on hover and while the panel is open; gold label while a filter applies
         (the game marks active states in gold, [CSS] goldColor). -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="{TemplateBinding Background}" Padding="8,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" VerticalAlignment="Center" Content="{DynamicResource IconFilter}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <TextBlock x:Name="TextFilter" Text="{DynamicResource LOCFilterActiveLabel}"
                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource DataChangeNotifBrush}"
                                       Margin="8,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bell with a count badge (the game's unread badge: a dark grey pill, [CSS] .SecondaryTabButton #UnreadBadge);
         hidden while there is nothing to show. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconNotifications}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <Border MinWidth="16" Height="14" Padding="4,0,4,0" Margin="0,3,1,0" CornerRadius="7"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource DangerBrush}">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The game's top bar search: 350px, 2px faint teal edge, brighter on hover ([CSS] #TopBarSearchBox). -->
    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Width" Value="350" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Grid>
                        <!-- The black strip, full strength over the left 80%, thinning out toward the right edge. -->
                        <Rectangle Fill="{DynamicResource TopPanelBackgroundBrush}" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Black" Offset="0" />
                                    <GradientStop Color="Black" Offset="0.8" />
                                    <GradientStop Color="#66000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Border x:Name="Bar" Height="52" Padding="12,0,146,0">
                            <DockPanel>
                                <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource MainMenuButton}"
                                        DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                    <ContentPresenter Width="24" Height="24"
                                                      Content="{DynamicResource IconMainMenu}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Border>

                                <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal"
                                            VerticalAlignment="Center" DockPanel.Dock="Left" />

                                <CheckBox x:Name="PART_ToggleFilter" DockPanel.Dock="Left"
                                          ToolTip="{DynamicResource LOCFilters}"
                                          Style="{DynamicResource TopPanelFilterToggle}" />

                                <SearchBox x:Name="PART_TextMainSearch" DockPanel.Dock="Right"
                                           Style="{StaticResource TopPanelSearchBox}"
                                           WindowChrome.IsHitTestVisibleInChrome="True" />

                                <CheckBox x:Name="PART_ToggleNotifications" DockPanel.Dock="Right" Margin="0,0,16,0"
                                          Style="{DynamicResource TopPanelNotificationsToggle}" />

                                <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="8,0,8,0"
                                            DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                                <!-- Progress: a 2px green bar under its caption, with Cancel. Playnite collapses the parts
                                     while nothing runs, so this takes no room then. -->
                                <Grid VerticalAlignment="Center" Margin="20,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="260" MinWidth="60" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Name="PART_TextProgressText" Margin="0,0,0,5"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextBrushDarker}"
                                                   Style="{DynamicResource BaseTextBlockStyle}" />
                                        <ProgressBar Name="PART_ProgressGlobal" Height="2" />
                                    </StackPanel>
                                    <Button Name="PART_ButtonProgressCancel" Grid.Column="1"
                                            Content="{DynamicResource LOCCancelLabel}"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            Margin="12,0,0,0" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Padding" Value="12,0,24,0" TargetName="Bar" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
