<!--
    Ancient: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from tokens.css and
    writes the result to the build as Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json): Playnite's palette keys, then shared keys for
    roles Playnite has none for. Each placeholder names the Dota 2 dashboard token that plays the role. Theme XAML reads
    brushes only, so ThemeModifier edits reach every control.

    Layers, deepest first: void (window), deck (library), topbar (navigation bar), chat and tooltip slate (panels),
    popup (dialogs, menus). The dashboard's two-stop gradients are drawn as a fill plus BevelShadowBrush through an
    OpacityMask, so each fill here is the gradient's lighter stop.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography. HeadingFontFamily is the game's title font (tabs, titles, buttons); nothing is bundled. -->
    <sys:Double x:Key="FontSizeSmall">{{px:size-caption}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:size-body}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:size-lead}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:size-title}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:size-display}}</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Georgia}}</FontFamily>

    <!-- Shape: square corners everywhere, 1px strokes (2px on dark buttons, dropdowns and check boxes). -->
    <Thickness x:Key="PopupBorderThickness">{{px:stroke-hair}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:stroke-hair}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:stroke-hair}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:corner-none}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Thickness x:Key="InputBorderThickness">{{px:stroke-hair}}</Thickness>
    <Thickness x:Key="FrameThickness">{{px:stroke-frame}}</Thickness>

    <!--
        Playnite palette. GlyphColor is the pale teal of a ticked check box; TextColorDark is the dark ink on it.
        TextColor is the game's baseText, TextColorDarker its muted button label. HoverColor is a white veil so one
        value works on every surface.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{text}}</Color>
    <Color x:Key="TextColorDarker">{{text-soft}}</Color>
    <Color x:Key="TextColorDark">{{ink}}</Color>
    <Color x:Key="MainColor">{{chat}}</Color>
    <Color x:Key="MainColorDark">{{deck}}</Color>
    <Color x:Key="HoverColor">{{veil-strong}}</Color>
    <Color x:Key="GlyphColor">{{tick}}</Color>
    <Color x:Key="HighlightGlyphColor">{{nav-glow-wash}}</Color>
    <Color x:Key="PopupBackgroundColor">{{menu}}</Color>
    <Color x:Key="PopupBorderColor">{{bevel-shadow}}</Color>
    <Color x:Key="BackgroundToneColor">{{chat}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{chat}}</Color>
    <Color x:Key="PanelSeparatorColor">{{line}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{line}}</Color>
    <Color x:Key="DataChangeNotifColor">{{gold}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{frame}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{tooltip}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{bevel}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{bevel-shadow}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{win}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{lose}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{mixed}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{lose}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{chat}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{void}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell: the navigation bar, the black secondary strip, the library layer -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{topbar}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{deck}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{strip}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{bevel-shadow}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{gear}}" />

    <!-- States: the nav's blue glow marks what is current, a white veil what is hovered -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{nav-glow-wash}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{nav-glow-wash}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{veil}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{nav-glow-soft}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{menu-hover}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{tick}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{nav-glow}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{danger}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{white}}" />

    <!-- Buttons: ButtonBevel grey, the green PLAY DOTA button -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{frame}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{bevel-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{bevel-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{play}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{play-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{play-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{nav-glow-wash}}" />

    <!-- Inputs: TextEntry, a dark well with a grey 1px edge -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{input}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{bevel-shadow}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{input-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{frame-hover}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{frame}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{frame-lit}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{tick-halo}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{bevel-shadow}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{slider-thumb}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{slider-thumb-hover}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{play}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{bevel-shadow}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{scroll}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{frame-lit}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{scroll}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{frame-lit}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{text-subtab}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{off-white}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{nav-glow}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{dark-fill}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{dark-fill-hover}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{bevel-shadow}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{white}}" />

    <!-- Frames: the bevel's lit and shaded edges, the slot around covers -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{off-white}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{bevel-shadow}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{play-light}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{bevel-shadow}}" />
</ResourceDictionary>
