<!--
    Overlay on Playnite Default/DefaultControls/Menu.xaml. Every popup menu (hamburger menu, top bar dropdowns, game
    and group menus, tray) is the dashboard's DropDownMenu ([CSS] dotastyles.css DropDownMenu Label) on the slate panel
    of ContextMenu.xaml. Roles: TopLevelHeader and TopLevelItem (a horizontal Menu bar, unchanged), SubmenuHeader and
    SubmenuItem (every popup menu). The Separator and MenuItem.SeparatorStyleKey are both defined here. Playnite's
    MenuItem style is kept; it picks these templates up by key.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Height="1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group break in every menu: the dashboard's paired rule ([CSS] dashboard.css #VerticalSeparator laid flat): a 1px
         black line over a 1px faint light line, edge to edge, 6px tall. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="6" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center">
                            <Rectangle Height="1" Fill="{DynamicResource BevelShadowBrush}" />
                            <Rectangle Height="1" Fill="{DynamicResource BevelLightBrush}" Opacity="0.5" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TopLevelHeader -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border">
            <Grid>
                <Border x:Name="HoverBorder" Background="{DynamicResource HoverBrush}" Visibility="Collapsed"
                        />
                <TextBlock VerticalAlignment="Center" Padding="{DynamicResource MenuItemPadding}" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>
                <Popup Placement="Bottom" VerticalOffset="0" IsOpen="{TemplateBinding IsSubmenuOpen}"
                       AllowsTransparency="True" Focusable="False">
                    <Border SnapsToDevicePixels="True" Padding="{DynamicResource MenuPadding}"
                            BorderBrush="{DynamicResource PopupBorderBrush}"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            BorderThickness="{DynamicResource PopupBorderThickness}"
                           >
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="HoverBorder" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- TopLevelItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Padding="{DynamicResource MenuItemPadding}" Background="Transparent">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" TargetName="Border" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Rows of every popup menu, compact: 30px edge to edge on the DropDownMenu slate (ContextMenu.xaml).
        - Row: fixed 26px icon column (icon 16, at 0.6 at rest), baseText label, shortcuts in the pale tick teal at the
          caption size; a checked row shows the dashboard's tick box (a pale teal square with an ink check).
        - Highlight (pointer or keyboard): the DropDownMenu Label:hover fill (#585e62) with the top tab's blue nav glow
          washing in from the left, and a 3px blue bar on the left edge that opens from its centre; the label, icon and
          shortcut turn white. 0.15s ease-in-out in, 0.2s out (dotastyles.css hover timings).
        - Exit (gesture Alt+Q) is the one marked row: the GC "scary" red fill with a loser-red wash and bar, white label.
        - Submenu headers: the theme's line chevron at the right edge (muted, blue while open, white highlighted) and a
          held fill with the blue bar while open; their submenus open on the same panel.
        Recipe: docs/themes/menus.md.
    -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <Grid x:Name="MenuHover" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Rectangle x:Name="MenuFill" Fill="{DynamicResource MenuItemHoverBrush}" />
                <Rectangle x:Name="MenuWash" Fill="{DynamicResource SidebarItemSelectedGlowBrush}" Opacity="0.4">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.6" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>
            <Rectangle x:Name="MenuBar" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource SidebarItemSelectedGlowBrush}"
                       RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="MenuBarScale" ScaleY="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Grid Margin="12,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.6" />
                <Border x:Name="TickBox" Width="12" Height="12" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource GlyphBrush}" Visibility="Collapsed">
                    <ContentPresenter Width="10" Height="10" TextElement.Foreground="{DynamicResource TextBrushDark}"
                                      Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}" />
                </Border>
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <TextBlock x:Name="GestureText" Grid.Column="2" Margin="18,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{TemplateBinding InputGestureText}" FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource GlyphBrush}" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="TickBox" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GestureText" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GestureText" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" TargetName="MenuFill" />
                <Setter Property="Fill" Value="{DynamicResource NegativeRatingBrush}" TargetName="MenuWash" />
                <Setter Property="Fill" Value="{DynamicResource NegativeRatingBrush}" TargetName="MenuBar" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="GestureText" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuGlowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuBarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuGlowOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuBarScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held fill and bar while the submenu is open (setters, so moving into the submenu never flickers) -->
            <Rectangle x:Name="MenuHeld" Fill="{DynamicResource MenuItemHoverBrush}" Opacity="0.7" Visibility="Collapsed" IsHitTestVisible="False" />
            <Rectangle x:Name="MenuHeldBar" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource SidebarItemSelectedGlowBrush}"
                       Visibility="Collapsed" IsHitTestVisible="False" />
            <Grid x:Name="MenuHover" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Rectangle Fill="{DynamicResource MenuItemHoverBrush}" />
                <Rectangle Fill="{DynamicResource SidebarItemSelectedGlowBrush}" Opacity="0.4">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.6" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>
            <Rectangle x:Name="MenuBar" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource SidebarItemSelectedGlowBrush}"
                       RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="MenuBarScale" ScaleY="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Grid Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.6" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <ContentPresenter x:Name="MenuChevron" Grid.Column="3" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                  Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconTemplate}" />
            </Grid>
            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                   HorizontalOffset="1" VerticalOffset="-5" Focusable="False" AllowsTransparency="True">
                <Grid MinWidth="200" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalDropDownMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="1,5,1,4" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Visibility" Value="Visible" TargetName="MenuHeld" />
                <Setter Property="Visibility" Value="Visible" TargetName="MenuHeldBar" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SidebarItemSelectedGlowBrush}" TargetName="MenuChevron" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuChevron" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuGlowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuBarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuGlowOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuBarScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
