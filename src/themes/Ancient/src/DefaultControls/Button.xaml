<!--
    Overlay on Playnite Default/DefaultControls/Button.xaml.
    The dashboard's grey ButtonBevel ([CSS] dotastyles.css .ButtonBevel): slate fill #373d45 to #4d5860
    (ButtonBackgroundBrush plus the bevel shade, BevelTemplate), lit top and left edge, dark bottom and right edge,
    36px tall, the label uppercase and white ([CSS] .ButtonBevel Label: text-transform uppercase, color #ffffff).
    Hover lightens the plate ([CSS] :hover #4c5561 to #6c7d88: ButtonHoverBackgroundBrush); pressed goes to the flat
    grey and nudges the label down 1px ([CSS] :active #393939 to #555555, Label translateY 1px). The default button
    (IsDefault) is the green of PLAY DOTA ([CSS] .ButtonBevel.Green / play.css). Keyboard focus: FocusVisual.
    Only string content is uppercased (Playnite's StringToUpperCaseConverter returns "" for anything else).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" /> <!-- fixed-width buttons (ThemeModifier icon buttons) keep their glyph unclipped; auto-width ones get the padding below -->
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False"
                                 Background="{TemplateBinding Background}" />
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform" TargetName="Content">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- ThemeModifier icon buttons: the plugin sets Width=41 on them (editor and constants tabs).
                 Square 41x41 with a small centred glyph; fixed-width only, auto-width buttons keep ButtonPadding. -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="FontSize" Value="16" />
            </Trigger>
            <Trigger Property="Width" Value="NaN">
                <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
