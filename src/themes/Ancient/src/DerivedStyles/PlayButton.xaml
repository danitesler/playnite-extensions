<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml.
    The PLAY DOTA button ([CSS] play.css .PlayButton): bright green at the top fading dark toward the bottom
    (#5Aa15E to #87d69533 over the dashboard: PrimaryButtonBackgroundBrush with a bottom shade), a 1px light edge on the
    top and left (#ffffff44: BevelLightBrush), a dark edge on the bottom and right (#00000088: BevelShadowBrush), and a
    bold white uppercase label (28px bold, letter-spacing 3px in the game; bold here at FontSizeLarger).
    Motion from the game's stylesheet: the button transitions box-shadow, background-color, opacity and transform over
    0.2s ease-in-out; hovered it gets `brightness: 1.2` and the box-shadow glow grows from #002a6644 to #414f4daa
    (8px blur, 8px spread). Here, animated both ways (nothing the storyboards touch is set by a trigger setter):
      in  0.2s ease-in-out: the light green fills in from the bottom (Lift, the brightness), the bottom shade thins, and the
          glow (Bloom, GlowFrameTemplate in PrimaryButtonBackgroundBrush, Images/fx/glow-frame.png) rises from 0 to 0.3.
      out 0.2s ease-in-out: back again; exit animations use FillBehavior Stop so no clock is left running.
    Pressed (the game's :active takes the gradient's bottom stop to white): its own layer, the deep green plate
    (PrimaryButtonPressedBackgroundBrush) fades in over 0.05s, with a 1px label nudge; out over 0.12s.
    The Lift and Shade masks are the effect layers themselves; no art with an OpacityMask sits behind this button.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages (DataContext: Playnite's
        GameDetailsViewModel, IsRunning / IsLaunching). While the game runs Playnite swaps Play for the context action
        (RUNNING): the plate is tinted the "in game" green inside a 1px square frame with a lit segment along its top, fading in and out like the SearchingAnimation.
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" />
                        <Grid Height="3" Margin="5,2,5,0" VerticalAlignment="Top">
                            <Grid.OpacityMask>
                                <DrawingBrush TileMode="Tile" Viewbox="0,0,5,3" ViewboxUnits="Absolute" Viewport="0,0,5,3" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#FF000000">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,1,3" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.OpacityMask>
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <StackPanel Margin="0,0,8,3" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Path x:Name="RunningChev1" Width="5" Height="9" Stretch="Fill" Data="M0,0 L4,5 L0,10" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" StrokeLineJoin="Miter" />
                            <Path x:Name="RunningChev2" Width="5" Height="9" Margin="-1,0,0,0" Stretch="Fill" Data="M0,0 L4,5 L0,10" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" StrokeLineJoin="Miter" />
                            <Path x:Name="RunningChev3" Width="5" Height="9" Margin="-1,0,0,0" Stretch="Fill" Data="M0,0 L4,5 L0,10" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" StrokeLineJoin="Miter" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningChev1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningChev2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.12" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.22" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.62" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningChev3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.24" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.34" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.74" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.2" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningChev1" Storyboard.TargetProperty="Opacity" Duration="0:0:3">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningChev2" Storyboard.TargetProperty="Opacity" Duration="0:0:3">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningChev3" Storyboard.TargetProperty="Opacity" Duration="0:0:3">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the scan has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Grid" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Hover glow sits 4px below the plate. -->
                        <Control x:Name="Bloom" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource PrimaryButtonBackgroundBrush}"
                                 Margin="-32" Opacity="0" IsHitTestVisible="False">
                            <Control.RenderTransform>
                                <TranslateTransform Y="4" />
                            </Control.RenderTransform>
                        </Control>
                        <Rectangle x:Name="Plate" Fill="{TemplateBinding Background}" />
                        <Rectangle x:Name="RunningBreath" Fill="{DynamicResource ShellBackgroundBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Rectangle x:Name="RunningScan" Visibility="Collapsed" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.4" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.7" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                    <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle x:Name="RunningHoverDim" Fill="{DynamicResource ShellBackgroundBrush}" Opacity="0" IsHitTestVisible="False" />
                        <!-- Hover: the light green rising from the bottom. -->
                        <Rectangle x:Name="Lift" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Opacity="0">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <!-- Rest: the translucent bottom stop lets the dark page through. -->
                        <Rectangle x:Name="Shade" Fill="{DynamicResource BevelShadowBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="#90000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle x:Name="PressPlate" Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0" />
                        <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
                        <Rectangle Width="1" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" />
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.55" />
                        <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.55" />
                        <ContentPresenter x:Name="PlayContent"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="ContentNudge" Y="0" />
                            </ContentPresenter.RenderTransform>
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Lift" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.88" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.7" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.702" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.702" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Lift" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.68" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3" Value="0.68" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                                        <DoubleAnimation Storyboard.TargetName="ContentNudge" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ContentNudge" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </DataTrigger>
                    <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsRunning}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
