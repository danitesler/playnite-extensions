<!--
    Overlay on Playnite Default/CustomControls/GameGroupMenu.xaml. Takes the theme's ContextMenu (DefaultControls/ContextMenu.xaml) through BasedOn.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GameGroupMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />
</ResourceDictionary>
