<!--
    Overlay on Playnite Default/Common.xaml. Spacing and focus of the Cyberpunk 2077 menus, scaled from 1080p
    captures by 2/3: list rows 50px tall with a 4px gap (34 and 3 here), labels 8px in from the row edge (6), values 9px
    from the right, menu screen margins 98px (64), sections split by tapered 2px rules.
    Playnite lays most controls out by padding, so each control key turns the row height into padding around 14px text
    (about 19px tall): 34 = 19 + 2 x 7.5.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: the inventory tooltip panel (blue-black), 1px dark edge, square -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Keyboard focus is the game's selection: the red edge (FrameThickness) drawn just outside the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="{DynamicResource FrameThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: a row, 34 tall, 16 inline -->
    <Thickness x:Key="ButtonPadding">16,7.5</Thickness>
    <!-- Text box, password box, dropdown: label inset 6 (8px at 1080p), 34 tall -->
    <Thickness x:Key="InputPadding">8,7.5</Thickness>
    <!-- Menu on the tooltip panel: 6px around rows 30 tall, 3px apart (rows 50 / gap 4 at 1080p, a little denser for
         Playnite's long game menu) -->
    <Thickness x:Key="MenuPadding">6</Thickness>
    <Thickness x:Key="MenuItemPadding">8,5.5,14,5.5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">6</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,5.5,14,5.5</Thickness>
    <!-- List box row: 6 inline, 30 tall -->
    <Thickness x:Key="ListBoxItemPadding">8,5.5</Thickness>
    <!-- Group box: the menu screen section, title over a tapered rule, no fill -->
    <Thickness x:Key="GroupBoxPadding">0,12,0,4</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,4</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">18</sys:Double>
    <!-- Tooltip: tooltip panel, 10 / 6 -->
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Glyphs at 18px (the game's hint and row icons, about 26px at 1080p) -->
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">340</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double>
</ResourceDictionary>
