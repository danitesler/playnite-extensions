                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemSource" Margin="0,6,0,6">
                                                            <TextBlock Text="{DynamicResource LOCSourceLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <Button x:Name="PART_ButtonSource" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemVersion" Margin="0,6,0,6">
                                                            <TextBlock Text="{DynamicResource LOCVersionLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
