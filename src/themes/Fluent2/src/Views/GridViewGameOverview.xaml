                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemInstallSize" Margin="0,6,0,6">
                                                            <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <TextBlock x:Name="PART_TextInstallSize" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemInstallDirectory" Margin="0,6,0,6">
                                                            <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <Button x:Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaLinks" Margin="0,10,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel x:Name="PART_ElemLinks" Margin="0,6,0,6">
                                                            <TextBlock Text="{DynamicResource LOCLinksLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsLinks" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
</Grid>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
