<!--
    Overlay on Playnite Default/Common.xaml. Spacing and focus of Counter-Strike 1.6's VGUI (ClientScheme.res and the
    Steam / GoldSrc olive skin): Verdana 12px labels, buttons about 24px tall with the label 14px in from the edge,
    1px bevels (lit top and left, dark bottom and right), square corners, dotted keyboard focus.
    Playnite lays most controls out by padding, so each control key turns the VGUI control height into padding around
    12px text (about 15px tall): 24 = 15 + 2 x 4.5.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menus, dropdowns and popovers: the translucent black menu (WindowBG) with a lit olive 1px edge, square. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Keyboard focus is the classic dotted rectangle (VGUI ButtonFocusBorder), drawn 3px outside the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="3" SnapsToDevicePixels="True" Stroke="{DynamicResource FocusBrush}"
                               StrokeThickness="1" StrokeDashArray="1 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Raised plate (VGUI TitleButtonBorder): the host's Background with 1px lit edges on top and left and 1px dark
         edges on the bottom and right. Host: a Control stretched behind the content, hit testing off. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BevelShadowBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Sunken plate (VGUI BaseBorder): dark edges on top and left, lit edges on the bottom and right. Used for
         inputs, lists and pressed buttons. Same host contract as BevelTemplate. -->
    <ControlTemplate x:Key="BevelInsetTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelShadowBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Left" Fill="{DynamicResource BevelShadowBrush}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BevelLightBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Section caption: the Steam skin's gold, bold Verdana (DialogTitle font). -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>

    <!-- Button: 24px tall (15px text + 2 x 4.5), label 14 in -->
    <Thickness x:Key="ButtonPadding">14,5</Thickness>
    <!-- Text box, password box, dropdown: 22px tall field, label 6 in -->
    <Thickness x:Key="InputPadding">6,5</Thickness>
    <!-- Menu: 2px around rows 22px tall (the buy menu rows) -->
    <Thickness x:Key="MenuPadding">2</Thickness>
    <Thickness x:Key="MenuItemPadding">8,3.5,14,3.5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">2</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">6,3.5,10,3.5</Thickness>
    <!-- List box row: 22px, 8 in -->
    <Thickness x:Key="ListBoxItemPadding">8,3.5</Thickness>
    <!-- Group box: etched 1px frame with the gold title cut into it -->
    <Thickness x:Key="GroupBoxPadding">10,8,10,10</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,6</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">12</sys:Double>
    <!-- Tooltip: olive panel, 8 / 4 -->
    <Thickness x:Key="TooltipPadding">8,4</Thickness>
    <!-- Glyphs at 16px, the compact rail's size -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>

    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <!-- Empty game page: a CS 1.6 radar in a sunken VGUI box. A sweep arm with a fading wedge turns once every 6s (linear, as the game's UI does not ease),
         three blips light as it passes and die back, a ping ring spreads from the centre, the crosshair breathes, and the console prompt below
         keeps its blinking block cursor. All motion is on named transforms and opacities, started from ControlTemplate.Triggers (never a Style trigger). -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Grid Width="340" Height="236" HorizontalAlignment="Center">
                <Control Template="{DynamicResource BevelInsetTemplate}" Background="{DynamicResource InputBackgroundBrush}" Focusable="False" IsTabStop="False" />
                <Grid Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1" Opacity="0.5" />
                    <Ellipse Width="134" Height="134" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1" Opacity="0.4" />
                    <Ellipse Width="68" Height="68" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1" Opacity="0.3" />
                    <Grid x:Name="EmptyAceCross">
                        <Rectangle Width="1" Height="200" Fill="{DynamicResource TextBrushDarker}" Opacity="0.45" />
                        <Rectangle Width="200" Height="1" Fill="{DynamicResource TextBrushDarker}" Opacity="0.45" />
                    </Grid>
                    <Ellipse Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5" x:Name="EmptyAcePing">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="EmptyAcePingScale" ScaleX="0.1" ScaleY="0.1" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Canvas Width="200" Height="200" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><RotateTransform x:Name="EmptyAceSweep" Angle="0" /></Canvas.RenderTransform>
                        <Path Data="M100,100 L100,0 A100,100 0 0 0 50,13.4 Z" Fill="{DynamicResource GlyphBrush}" Opacity="0.16" />
                        <Path Data="M100,100 L100,0 A100,100 0 0 0 75,6.7 Z" Fill="{DynamicResource GlyphBrush}" Opacity="0.2" />
                        <Rectangle Canvas.Left="99.25" Canvas.Top="0" Width="1.5" Height="100" Fill="{DynamicResource GlyphBrush}" />
                    </Canvas>
                    <Rectangle x:Name="EmptyAceBlipA" Width="6" Height="6" Margin="140,52,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" Opacity="0.2" />
                    <Rectangle x:Name="EmptyAceBlipB" Width="6" Height="6" Margin="62,128,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" Opacity="0.2" />
                    <Rectangle x:Name="EmptyAceBlipC" Width="6" Height="6" Margin="118,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource DangerBrush}" Opacity="0.2" />
                    <Rectangle Width="6" Height="6" Fill="{DynamicResource TextBrush}" />
                </Grid>
                <!-- bracket ticks in the box corners -->
                <Rectangle Width="10" Height="1" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource TextBrushDarker}" />
                <Rectangle Width="1" Height="10" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource TextBrushDarker}" />
                <Rectangle Width="10" Height="1" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource TextBrushDarker}" />
                <Rectangle Width="1" Height="10" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource TextBrushDarker}" />
                <Rectangle Width="10" Height="1" Margin="10,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource TextBrushDarker}" />
                <Rectangle Width="1" Height="10" Margin="10,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource TextBrushDarker}" />
                <Rectangle Width="10" Height="1" Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource TextBrushDarker}" />
                <Rectangle Width="1" Height="10" Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource TextBrushDarker}" />
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock Text="]" Margin="0,0,8,0" FontFamily="Lucida Console, Courier New" FontSize="{DynamicResource FontSizeLarge}"
                           Foreground="{DynamicResource TextBrushDarker}" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" FontFamily="Lucida Console, Courier New" FontSize="{DynamicResource FontSizeLarge}"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Rectangle x:Name="EmptyAceCursor" Width="9" Height="16" Margin="6,0,0,0" Fill="{DynamicResource TextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyAceIdle">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="EmptyAceSweep" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:6" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="EmptyAcePingScale" Storyboard.TargetProperty="ScaleX" From="0.1" To="1" Duration="0:0:3" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyAcePingScale" Storyboard.TargetProperty="ScaleY" From="0.1" To="1" Duration="0:0:3" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyAcePing" Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:3" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="EmptyAceCross" Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyAceBlipA" Storyboard.TargetProperty="Opacity" Duration="0:0:6" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:6" Value="0.2" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyAceBlipC" Storyboard.TargetProperty="Opacity" Duration="0:0:6" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:2.55" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:2.65" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:6" Value="0.2" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyAceBlipB" Storyboard.TargetProperty="Opacity" Duration="0:0:6" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:3.7" Value="0.2" /><LinearDoubleKeyFrame KeyTime="0:0:3.8" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:6" Value="0.2" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyAceCursor" Storyboard.TargetProperty="Opacity" Duration="0:0:1.4" RepeatBehavior="Forever">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyAceIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- menu-mark begin LocalAceMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a C4 charge, a case with antenna, a two digit display and a dim LED, shown at 18px wide. Hover (IsMouseOver): a scan cursor sweeps the display in five stepped moves of 2px (0.32s, discrete keyframes, VGUI has no easing). Open (ContextMenu.IsOpen of the nearest Border): the amber LED blinks once a second and the second digit ticks in the opposite phase (a 1s loop) until the menu closes, the bomb is planted; exits restore every property. -->
    <ControlTemplate x:Key="LocalAceMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Viewbox Width="18" Height="14.7" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Canvas Width="22" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Rectangle Canvas.Left="1" Canvas.Top="4" Width="20" Height="13" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" />
                <Path Data="M16,4 V1 H19" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" />
                <Rectangle Canvas.Left="4" Canvas.Top="7" Width="9" Height="7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
                <Rectangle Canvas.Left="5.5" Canvas.Top="8.5" Width="2" Height="4" Fill="{TemplateBinding Foreground}" Opacity="0.7" />
                <Rectangle Canvas.Left="9" Canvas.Top="8.5" Width="2" Height="4" Fill="{TemplateBinding Foreground}" Opacity="0.7" />
                <Rectangle Canvas.Left="15" Canvas.Top="8" Width="3" Height="3" Fill="{TemplateBinding Foreground}" Opacity="0.45" />
                <Rectangle x:Name="Scan" Canvas.Left="4.5" Canvas.Top="7.5" Width="1" Height="6" Fill="{TemplateBinding Foreground}" Opacity="0">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="ScanT" X="0" Y="0" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="LedOn" Canvas.Left="15" Canvas.Top="8" Width="3" Height="3" Fill="{DynamicResource GlyphBrush}" Opacity="0" />
                <Rectangle x:Name="Tick" Canvas.Left="9" Canvas.Top="8.5" Width="2" Height="4" Fill="{DynamicResource GlyphBrush}" Opacity="0" />
            </Canvas>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scan" Storyboard.TargetProperty="Opacity"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="1" /></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScanT" Storyboard.TargetProperty="X"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.080" Value="2" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.160" Value="4" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.240" Value="6" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.320" Value="8" /></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Scan" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.060" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ScanT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.060" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LedOn" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="1" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.500" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.000" Value="0" /></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.500" Value="1" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.000" Value="0" /></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LedOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.060" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.060" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalAceMenuMarkTemplate -->
</ResourceDictionary>
