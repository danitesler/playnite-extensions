<!--
    CS 1.6: WindowBarButton. Title-bar button of a dialog or main window: a small raised olive plate (BevelTemplate,
    ButtonBackgroundBrush) with a pale olive glyph (ButtonForegroundBrush). Content is either a Marlett character
    (the Default windows) or an Icon geometry. Hover fills with ButtonHoverBackgroundBrush; pressed swaps to the sunken
    plate. The close button (named PART_ButtonClose) turns DangerBrush with DangerForegroundBrush on hover.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="WindowBarButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Margin" Value="2,0,2,0" />
        <Setter Property="Padding" Value="3,1,3,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <ControlTemplate.Resources>
                        <DataTemplate DataType="{x:Type Geometry}">
                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                                <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
                                    <Path Data="{Binding}"
                                          Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                                </Canvas>
                            </Viewbox>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Control x:Name="Plate" Template="{DynamicResource BevelTemplate}"
                                 Background="{TemplateBinding Background}"
                                 IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="Marlett" TextElement.FontSize="16" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Template" Value="{DynamicResource BevelInsetTemplate}" />
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Name, RelativeSource={RelativeSource Self}}" Value="PART_ButtonClose" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
