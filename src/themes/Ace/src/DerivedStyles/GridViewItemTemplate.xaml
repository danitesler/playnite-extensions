<!--
    GridViewItemTemplate (overlay on Default/DerivedStyles/GridViewItemTemplate.xaml). Cover tile: the cover art with a
    1px SlotBorderBrush edge drawn over it (the 2px selection frame and the stepped hover rings are GridViewItemStyle), the
    name overlay for covers without art and the uninstalled / hover darkening in ScrimBrush. Square, no radius.
    Hover is GoldSrc-flat, not smooth: the ScrimBrush shade pops in at half strength, then full, 40ms apart and the two VGUI buttons
    (GridTileButton: 36px bevelled plates with pixel glyphs) step up into place, Info 60ms after Play: 8px, 4px, 0 in
    40ms frames, no scaling (scaling would blur the 16-unit pixel glyphs). Leaving drops them the same way
    (FillBehavior Stop). The uninstalled darkening is its own static layer.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- GridTileButton: a VGUI button. A 36px square bevelled plate (BevelTemplate, square corners) with a 16px pixel glyph
         (IconPlay / IconInfo / IconDownload from Media.xaml), snapped to whole pixels. Background = plate, Tag = hover plate,
         Foreground = glyph; Play overrides all three with the amber fill and black ink. Hover is a stepped frame swap, not a
         fade (the original arms instantly): the hover plate goes 0, 0.5, 1 in two 50ms steps and back. Pressed swaps to the
         sunken plate and nudges the glyph 1px, instantly. -->
    <Style x:Key="GridTileButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Tag" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" Background="Transparent">
                        <Control x:Name="Plate" Template="{DynamicResource BevelTemplate}" Background="{TemplateBinding Background}"
                                 IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                        <Border x:Name="HoverPlate" Margin="1" Background="{TemplateBinding Tag}" Opacity="0" IsHitTestVisible="False" />
                        <ContentControl x:Name="Glyph" Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16"
                                        Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Template" Value="{DynamicResource BevelInsetTemplate}" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Glyph" Property="Margin" Value="2,2,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="{DynamicResource GridItemBackgroundBrush}">
                        <StackPanel Name="PART_PanelHost"
                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                            <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}">
                                <Image Name="PART_ImageCover"
                                       RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="{Settings CoverArtStretch}" />
                                <Grid x:Name="TextGameName" Visibility="Collapsed">
                                    <Border Background="{DynamicResource ScrimBrush}" Opacity="0.6" />
                                    <TextBlock Text="{Binding DisplayName}"
                                           TextWrapping="Wrap" Margin="5"
                                           Style="{StaticResource BaseTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Darken uninstalled (static) and the hover shade (animated) are separate layers. -->
                                <Border Background="{DynamicResource ScrimBrush}" Opacity="0.67" x:Name="BorderUninstalled" Visibility="Collapsed" />
                                <Border Background="{DynamicResource ScrimBrush}" x:Name="BorderMouseOver" Opacity="0" />
                                <Border BorderThickness="1" BorderBrush="{DynamicResource SlotBorderBrush}" IsHitTestVisible="False" />
                                <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="120" StretchDirection="DownOnly"
                                         Name="GameControls" Visibility="Hidden">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <Button Name="PART_ButtonPlay" Style="{StaticResource GridTileButton}" Background="{DynamicResource PrimaryButtonBackgroundBrush}" Tag="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Foreground="{DynamicResource PrimaryButtonForegroundBrush}" Margin="0,0,6,0"
                                                Content="{DynamicResource IconPlay}" Opacity="0" RenderTransformOrigin="0.5,0.5">

                                            <Button.RenderTransform>
                                                <TransformGroup>

                                                    <TranslateTransform x:Name="PlayRise" Y="8" />
                                                </TransformGroup>
                                            </Button.RenderTransform>
                                        </Button>
                                        <Button Name="PART_ButtonInfo" Style="{StaticResource GridTileButton}" Margin="6,0,0,0"
                                                Content="{DynamicResource IconInfo}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <TransformGroup>

                                                    <TranslateTransform x:Name="InfoRise" Y="8" />
                                                </TransformGroup>
                                            </Button.RenderTransform>
                                        </Button>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Padding="2,5,2,5" Grid.Row="1" Grid.Column="0"
                                       Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="{DynamicResource IconDownload}" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderUninstalled" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" /></ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.040" Value="1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayRise" Storyboard.TargetProperty="Y" BeginTime="0:0:0.0"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="8" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.040" Value="4" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.080" Value="0" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.06"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.040" Value="1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InfoRise" Storyboard.TargetProperty="Y" BeginTime="0:0:0.06"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="8" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.040" Value="4" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.080" Value="0" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0.335" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.040" Value="0.67" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0.335" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.040" Value="0" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PlayRise" Storyboard.TargetProperty="Y" BeginTime="0:0:0.0"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="8" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.0"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="InfoRise" Storyboard.TargetProperty="Y" BeginTime="0:0:0.0"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="8" /></DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0:0:0.04" Value="{x:Static Visibility.Hidden}" /></ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
