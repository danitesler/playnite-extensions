<!--
    CS 1.6: PropertyItemButton. Metadata value button Playnite styles from code. Default: an amber text link
    (TextBrush) that underlines on hover. When the owning ItemsControl has Tag="Chip" it becomes a small square chip:
    PropertyItemBackgroundBrush fill, PropertyItemForegroundBrush text, 1px SlotBorderBrush edge,
    PropertyItemHoverBackgroundBrush on hover, ControlCornerRadius corners.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Margin" Value="0,4,6,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                        <TextBlock x:Name="Label" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="{x:Static TextDecorations.Underline}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PropertyItemBackgroundBrush}" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SlotBorderBrush}" />
                            <Setter TargetName="Chip" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Chip" Property="Padding" Value="6,2,6,2" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                            <Setter TargetName="Label" Property="TextDecorations" Value="{x:Null}" />
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
