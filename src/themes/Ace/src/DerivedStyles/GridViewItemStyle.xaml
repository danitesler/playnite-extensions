<!--
    Ace grid cover tile: selection is a static white 2px frame; hover is an amber 2px frame.
    Hover rings use trigger setters so they disappear as soon as IsMouseOver is false, without holding animation clocks.
    Both rings remain non-interactive and inside the item's spacing margin.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <Border x:Name="SelectionBorder" BorderThickness="2" Margin="-2" />
                        <Border x:Name="HoverInner" BorderThickness="1" Margin="-1" Opacity="0" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                        <Border x:Name="HoverOuter" BorderThickness="1" Margin="-2" Opacity="0" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                        <ContentPresenter />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Setter TargetName="HoverInner" Property="Opacity" Value="1" />
                            <Setter TargetName="HoverOuter" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="SelectionBorder"/>
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
