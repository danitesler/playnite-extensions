<!--
    Ace: PlayButton. The one amber control: a raised bevelled plate (BevelTemplate) filled with
    PrimaryButtonBackgroundBrush, black ink (PrimaryButtonForegroundBrush), square corners, ButtonPadding. Keyboard
    focus is the dotted FocusVisual.
    Hover arms immediately, without a delayed frame or fade, and clears immediately on pointer exit.
    The white hover plate uses PrimaryButtonHoverBackgroundBrush inside the bevel lines.
    Pressed swaps to the sunken plate (BevelInsetTemplate, PrimaryButtonPressedBackgroundBrush) and nudges the label
    1px, instantly, like the original depressed state. All interaction states use immediate trigger setters.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <!-- Keep the padding hit-testable; the decorative plate ignores mouse input. -->
                    <Grid x:Name="Grid" SnapsToDevicePixels="True" Background="Transparent">
                        <Control x:Name="Plate" Template="{DynamicResource BevelTemplate}"
                                 Background="{TemplateBinding Background}"
                                 IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                        <Border x:Name="HoverPlate" Margin="1" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverPlate" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Template" Value="{DynamicResource BevelInsetTemplate}" />
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
