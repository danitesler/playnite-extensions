<!--
    ContextMenu (overlay on Default/DefaultControls/ContextMenu.xaml). Every menu and dropdown list (the hamburger menu,
    the top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is Counter-Strike 1.6's buy menu on a VGUI frame (LocalBuyMenuPanelTemplate,
    shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: the black WindowBG panel inside the raised 1px VGUI bevel (lit olive top and left, deep olive bottom and
      right), square, with a 6px olive Steam title band across the top and an amber HUD tick at its left end. Rows sit
      9px below the top (band 6 + shadow line 1 + 2) and 2px inside the bevel.
    Rows, group breaks and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <ControlTemplate x:Key="LocalBuyMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Rectangle Fill="{DynamicResource PopupBackgroundBrush}" />
            <!-- Olive Steam title band with its shadow line, and the amber HUD tick -->
            <Rectangle Height="6" VerticalAlignment="Top" Fill="{DynamicResource WindowTitleBackgroundBrush}" />
            <Rectangle Height="1" Margin="0,6,0,0" VerticalAlignment="Top" Fill="{DynamicResource BevelShadowBrush}" />
            <Rectangle Width="12" Height="2" Margin="6,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="{DynamicResource GlyphBrush}" />
            <!-- Raised VGUI bevel: lit top and left, deep bottom and right -->
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BevelShadowBrush}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalBuyMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="2,9,2,3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
