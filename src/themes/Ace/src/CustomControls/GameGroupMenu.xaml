<!-- GameGroupMenu (overlay on Default/CustomControls/GameGroupMenu.xaml): the theme's black ContextMenu popup, resolved through BasedOn. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GameGroupMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />
</ResourceDictionary>
