<!--
    Ace: DetailsViewGameOverview (details view game page)
    Black page (GameOverviewBackgroundBrush); the banner art fades down into it under a scrim. Bold amber Verdana title
    with the game icon; Steam screenshots, description and notes (gold captions over a 1px rule) on the left; ONE metadata
    pane on the right: a black box with a 1px square edge, six collapsing groups split by 1px rules, dim beige captions
    and amber values. Rhythm: 12px above and below each group rule, 8px above and below each field. Square corners.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Steam Screenshots skeleton: a 16:9 main frame over five thumbnails, square, pulsing in the host foreground. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Pulse" Width="320" Height="220" Opacity="0.25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0" Fill="{TemplateBinding Foreground}" />
                <UniformGrid Grid.Row="2" Rows="1" Columns="5">
                    <Rectangle Margin="0,0,3,0" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Margin="1.5,0,1.5,0" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Margin="1.5,0,1.5,0" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Margin="1.5,0,1.5,0" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Margin="3,0,0,0" Fill="{TemplateBinding Foreground}" />
                </UniformGrid>
            </Grid>
        </Viewbox>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                         From="0.25" To="0.6" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1280"
                                  d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid Background="{DynamicResource GameOverviewBackgroundBrush}">
                            <!-- Banner: a band of GameBannerHeight, masked to fade down into the page, a scrim darkening it toward the title. Collapses with the background art. The BitmapCache wrapper keeps the opacity masks cheap. -->
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" Height="{DynamicResource GameBannerHeight}" IsHitTestVisible="False">
                                <Grid.CacheMode>
                                    <BitmapCache />
                                </Grid.CacheMode>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid ClipToBounds="True">
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="Black" Offset="0.4" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    <Rectangle Fill="{DynamicResource ScrimBrush}" Opacity="0.6">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="Transparent" Offset="0.3" />
                                                <GradientStop Color="Black" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                            </Grid>

                            <Grid HorizontalAlignment="Stretch" Margin="20,0,20,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Room above the title: scales with the banner (x * 180 / 320 at the default banner height), 0 or the fallback when the banner is off. -->
                                <Border Grid.Row="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 180 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Header: icon and title, the actions beside them -->
                                <DockPanel MaxWidth="1024" Grid.Row="1" Margin="0,0,0,24" Background="Transparent">
                                    <Image Name="PART_ImageCover" VerticalAlignment="Bottom"
                                           DockPanel.Dock="Right" Margin="20,0,0,0"
                                           Height="{Settings GameDetailsCoverHeight}"
                                           StretchDirection="Both" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="Fant" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Bottom" Margin="20,0,0,4">
                                        <Grid Width="150">
                                            <Button Name="PART_ButtonPlayAction" Height="40" Style="{DynamicResource PlayButton}" />
                                            <Button Name="PART_ButtonContextAction" Height="40" />
                                        </Grid>
                                        <Button Name="PART_ButtonMoreActions"
                                                Content="{DynamicResource LOCMoreAction}"
                                                Width="150" Height="40" Margin="8,0,0,0" />
                                        <Button x:Name="PART_ButtonEditGame" Margin="8,0,0,0" Height="40" Focusable="False"
                                                Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                    <Image Name="PART_ImageIcon" MaxHeight="48" MaxWidth="48"
                                           DockPanel.Dock="Left" Margin="0,0,12,0"
                                           VerticalAlignment="Bottom"
                                           RenderOptions.BitmapScalingMode="Fant" />
                                    <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource FontFamily}"
                                               FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold"
                                               TextWrapping="Wrap" VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource TextBrush}" />
                                </DockPanel>

                                <!-- Two columns: screenshots, description and notes on the left, the metadata pane on the right -->
                                <DockPanel MaxWidth="1024" Grid.Row="2">
                                    <Border DockPanel.Dock="Right" Width="{DynamicResource GameDetailsPaneWidth}" VerticalAlignment="Top"
                                            Background="{DynamicResource ExpanderBackgroundBrush}"
                                            BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" Padding="14,12">
                                        <Border.Resources>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="VerticalAlignment" Value="Top" />
                                            </Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                        </Border.Resources>
                                        <!-- Groups draw a 1px rule on top; the wrapper pulls the first one out of view. Margins: -(2 x 12 + 1 + 8) top, -8 bottom. -->
                                        <Border ClipToBounds="True">
                                            <StackPanel Margin="0,-33,0,-8">
                                                <Border x:Name="MetaProgress" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource MenuSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCCompletionStatus}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <Button Name="PART_ButtonCompletionStatus" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCTimePlayed}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextPlayTime" Grid.Column="1" VerticalAlignment="Top" TextWrapping="Wrap" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCLastPlayed}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextLastActivity" Grid.Column="1" VerticalAlignment="Top" TextWrapping="Wrap" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextRecentActivity" Grid.Column="1" VerticalAlignment="Top" TextWrapping="Wrap" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextAdded" Grid.Column="1" VerticalAlignment="Top" TextWrapping="Wrap" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaScores" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource MenuSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCCommunityScore}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextCommunityScore" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{DynamicResource TextBlockGameScore}" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCCriticScore}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextCriticScore" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{DynamicResource TextBlockGameScore}" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCUserScore}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextUserScore" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{DynamicResource TextBlockGameScore}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaAbout" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource MenuSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCDeveloperLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsDevelopers" Grid.Column="1" VerticalAlignment="Top" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCPublisherLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsPublishers" Grid.Column="1" VerticalAlignment="Top" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <Button Name="PART_ButtonReleaseDate" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCSeriesLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsSeries" Grid.Column="1" VerticalAlignment="Top" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsAgeRatings" Grid.Column="1" VerticalAlignment="Top" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemRegion" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCRegionLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsRegions" Grid.Column="1" VerticalAlignment="Top" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaTags" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource MenuSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid x:Name="PART_ElemPlatform" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCPlatformTitle}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsPlatforms" Grid.Column="1" Tag="Chip" VerticalAlignment="Top">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemGenres" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCGenreLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsGenres" Grid.Column="1" Tag="Chip" VerticalAlignment="Top">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemCategories" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCGameCategoriesTitle}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsCategories" Grid.Column="1" Tag="Chip" VerticalAlignment="Top">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemFeatures" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsFeatures" Grid.Column="1" Tag="Chip" VerticalAlignment="Top">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemTags" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCTagsLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsTags" Grid.Column="1" Tag="Chip" VerticalAlignment="Top">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaLibrary" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource MenuSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid x:Name="PART_ElemLibrary" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <Button Name="PART_ButtonLibrary" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemSource" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCSourceLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <Button Name="PART_ButtonSource" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemVersion" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCVersionLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <Button Name="PART_ButtonVersion" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemInstallSize" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextInstallSize" Grid.Column="1" VerticalAlignment="Top" TextWrapping="Wrap" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemInstallDirectory" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <Button Name="PART_ButtonInstallDirectory" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaLinks" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource MenuSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid x:Name="PART_ElemLinks" Margin="0,8,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCLinksLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsLinks" Grid.Column="1" VerticalAlignment="Top" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Border>

                                    <StackPanel Margin="0,0,24,0">
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second. The skeleton shows for Steam games in that gap, for at most 12s. With the plugin missing or disabled the binding falls back to PluginUnavailable, which matches neither value. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <StackPanel Margin="0,0,0,24">
                                                <TextBlock Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" Margin="0" Style="{DynamicResource HeadingTextBlock}" />
                                                <Border Height="1" Margin="0,6,0,10" Background="{DynamicResource MenuSeparatorBrush}" />
                                                <Grid>
                                                    <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                    <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}"
                                                             Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                        <Control.Style>
                                                            <Style TargetType="Control">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Control.Style>
                                                    </Control>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Name="PART_ElemDescription" Margin="0,0,0,24">
                                            <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Margin="0" Style="{DynamicResource HeadingTextBlock}" />
                                            <Border Height="1" Margin="0,6,0,10" Background="{DynamicResource MenuSeparatorBrush}" />
                                            <HtmlTextView Name="PART_HtmlDescription"
                                                          TextElement.Foreground="{DynamicResource TextBrush}"
                                                          Tag="{DynamicResource HeadingForegroundBrush}"
                                                          HtmlFontSize="{DynamicResource FontSize}"
                                                          HtmlFontFamily="{DynamicResource FontFamily}"
                                                          HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                          LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                        </StackPanel>
                                        <StackPanel Name="PART_ElemNotes" Margin="0,0,0,24">
                                            <TextBlock Text="{DynamicResource LOCNotesLabel}" Margin="0" Style="{DynamicResource HeadingTextBlock}" />
                                            <Border Height="1" Margin="0,6,0,10" Background="{DynamicResource MenuSeparatorBrush}" />
                                            <TextBox Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" Margin="-1,0,-1,0" Padding="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
