<!--
    Ace: DetailsViewGameOverview (details view game page)
    Black page (GameOverviewBackgroundBrush); the banner art fades down into it under a scrim (gradients, no OpacityMask), and with no game selected a console prompt shows instead of the page. Bold amber Verdana title
    with the game icon; Steam screenshots, description and notes (gold captions over a 1px rule) on the left; ONE metadata
    pane on the right: a black box with a 1px square edge, six collapsing groups split by 1px rules, dim beige captions
    and amber values. Rhythm: 12px above and below each group rule, 8px above and below each field. Square corners.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Steam Screenshots skeleton: a 16:9 main frame over five thumbnails, square, pulsing in the host foreground. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Pulse" Width="320" Height="220" Opacity="0.25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0" Fill="{TemplateBinding Foreground}" />
                <UniformGrid Grid.Row="2" Rows="1" Columns="5">
                    <Rectangle Margin="0,0,3,0" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Margin="1.5,0,1.5,0" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Margin="1.5,0,1.5,0" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Margin="1.5,0,1.5,0" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Margin="3,0,0,0" Fill="{TemplateBinding Foreground}" />
                </UniformGrid>
            </Grid>
        </Viewbox>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                             From="0.25" To="0.6" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible"
                                  Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible"
                                  d:DesignWidth="1280"
                                  d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid x:Name="PageRoot" Background="{DynamicResource GameOverviewBackgroundBrush}">
                            <!-- Banner: a band of GameBannerHeight, fading down into the page through plain gradients (no OpacityMask: the Play button animates over it), a scrim darkening it toward the title. Collapses with the background art. -->
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" Height="{DynamicResource GameBannerHeight}" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid ClipToBounds="True">
                                    <Border x:Name="ScrimSwatch" Background="{DynamicResource ScrimBrush}" Visibility="Collapsed" />
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    <!-- No OpacityMask or BitmapCache on the banner: masked art repainted in part (behind the animated Play button) left dark seams
                                         on scaled displays. The scrim and the fade into the page are plain gradients. -->
                                    <Rectangle Opacity="0.6">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.3" />
                                                <GradientStop Color="{Binding Background.Color, ElementName=ScrimSwatch}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.4" />
                                                <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Grid>

                            <Grid HorizontalAlignment="Stretch" Margin="20,0,20,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Room above the title: scales with the banner (x * 180 / 320 at the default banner height), 0 or the fallback when the banner is off. -->
                                <Border Grid.Row="0" x:Name="DetailsBannerSpacer" MinHeight="20">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 180 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="20" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="20" />
</DataTrigger>
</Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Header: icon and title, the actions beside them -->
                                <DockPanel MaxWidth="1024" Grid.Row="1" Margin="0,0,0,24" Background="Transparent">
                                    <Image Name="PART_ImageCover" VerticalAlignment="Bottom"
                                           DockPanel.Dock="Right" Margin="20,0,0,0"
                                           Height="{Settings GameDetailsCoverHeight}"
                                           StretchDirection="Both" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="Fant" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Bottom" Margin="20,0,0,4">
                                        <Grid Width="150">
                                            <Button Name="PART_ButtonPlayAction" Height="40" Style="{DynamicResource PlayButton}" />
                                            <Button Name="PART_ButtonContextAction" Height="40" />
                                        </Grid>
                                        <Button Name="PART_ButtonMoreActions"
                                                Width="40" Height="40" Margin="4,0,0,0"
                                                ToolTip="{DynamicResource LOCMoreAction}" Padding="0">
                                            <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                            Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                        </Button>
                                        <Button Padding="0" Width="40" x:Name="PART_ButtonEditGame" Margin="4,0,0,0" Height="40" Focusable="False"
                                                Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}" ToolTip="{DynamicResource LOCEditGame}">
                                        </Button>
                                    </StackPanel>
                                    <Image Name="PART_ImageIcon" MaxHeight="48" MaxWidth="48"
                                           DockPanel.Dock="Left" Margin="0,0,12,0"
                                           VerticalAlignment="Bottom"
                                           RenderOptions.BitmapScalingMode="Fant" />
                                    <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource FontFamily}"
                                               FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold"
                                               TextWrapping="Wrap" VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource TextBrush}" />
                                </DockPanel>

                                <!-- Two columns: screenshots, description and notes on the left, the metadata pane on the right -->
                                <Grid MaxWidth="1024" Grid.Row="2" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataViewport" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<Border VerticalAlignment="Top"
                                            Background="{DynamicResource ExpanderBackgroundBrush}"
                                            BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                        <Border.Resources>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="VerticalAlignment" Value="Top" />
                                            </Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                        </Border.Resources>
                                        <!-- Groups draw a 1px rule on top; the wrapper pulls the first one out of view. Margins: -(2 x 8 + 1 + 4) top, -4 bottom. -->
                                        <Border ClipToBounds="True" x:Name="DetailsMetadataViewport" Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch">
<Border.Style><Style TargetType="Border"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-21,0,-4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-21,-24,-4" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                <Border x:Name="MetaProgress" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource MenuSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Margin" Value="0,8,0,0" /><Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,0" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid x:Name="PART_ElemCompletionStatus" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCCompletionStatus}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <Button Name="PART_ButtonCompletionStatus" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemPlayTime" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCTimePlayed}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextPlayTime" Grid.Column="1" VerticalAlignment="Top" TextWrapping="Wrap" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemLastPlayed" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCLastPlayed}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextLastActivity" Grid.Column="1" VerticalAlignment="Top" TextWrapping="Wrap" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemRecentActivity" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextRecentActivity" Grid.Column="1" VerticalAlignment="Top" TextWrapping="Wrap" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemAdded" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextAdded" Grid.Column="1" VerticalAlignment="Top" TextWrapping="Wrap" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaScores" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource MenuSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Margin" Value="0,8,0,0" /><Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,0" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid x:Name="PART_ElemCommunityScore" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCCommunityScore}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextCommunityScore" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{DynamicResource TextBlockGameScore}" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemCriticScore" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCCriticScore}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextCriticScore" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{DynamicResource TextBlockGameScore}" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemUserScore" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCUserScore}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Name="PART_TextUserScore" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{DynamicResource TextBlockGameScore}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaAbout" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource MenuSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Margin" Value="0,8,0,0" /><Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,0" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid x:Name="PART_ElemDevelopers" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCDeveloperLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsDevelopers" Grid.Column="1" VerticalAlignment="Top" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemPublishers" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCPublisherLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsPublishers" Grid.Column="1" VerticalAlignment="Top" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemReleaseDate" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <Button Name="PART_ButtonReleaseDate" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemSeries" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCSeriesLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsSeries" Grid.Column="1" VerticalAlignment="Top" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemAgeRating" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsAgeRatings" Grid.Column="1" VerticalAlignment="Top" />
                                                        </Grid>
                                                        <Grid x:Name="PART_ElemRegion" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCRegionLabel}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsRegions" Grid.Column="1" VerticalAlignment="Top" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaTags" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource MenuSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Margin" Value="0,8,0,0" /><Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,0" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid x:Name="PART_ElemPlatform" Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCPlatformTitle}" Margin="0,0,10,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" />
                                                            <ItemsControl Name="PART_ItemsPlatforms" Grid.Column="1" Tag="Chip" VerticalAlignment="Top">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
