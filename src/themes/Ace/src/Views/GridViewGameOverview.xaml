<!--
    Ace: GridViewGameOverview (grid view side panel game page)
    Black page (GameOverviewBackgroundBrush); the banner art fades down into it under a scrim. Bold amber Verdana title
    with the game icon; Steam screenshots, description and notes (gold captions over a 1px rule) on the left; ONE metadata
    pane on the right: a black box with a 1px square edge, six collapsing groups split by 1px rules, dim beige captions
    and amber values. Rhythm: 12px above and below each group rule, 8px above and below each field. Square corners.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Steam Screenshots skeleton: a 16:9 main frame over five thumbnails, square, pulsing in the host foreground. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Pulse" Width="320" Height="220" Opacity="0.25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0" Fill="{TemplateBinding Foreground}" />
                <UniformGrid Grid.Row="2" Rows="1" Columns="5">
                    <Rectangle Margin="0,0,3,0" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Margin="1.5,0,1.5,0" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Margin="1.5,0,1.5,0" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Margin="1.5,0,1.5,0" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Margin="3,0,0,0" Fill="{TemplateBinding Foreground}" />
                </UniformGrid>
            </Grid>
        </Viewbox>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                             From="0.25" To="0.6" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border x:Name="PageRoot" Background="{DynamicResource GameOverviewBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Empty state (no game selected): the GoldSrc console prompt, "]" then Playnite's "No game selected" and a block cursor that blinks
                                 in whole frames (0.5s on, 0.5s off, no fade), in a sunken VGUI box. Centered in the visible area; the blink runs only while this shows. -->
                            <Grid VerticalAlignment="Center">
                                <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24">
                                    <Control Template="{DynamicResource BevelInsetTemplate}" Background="{DynamicResource InputBackgroundBrush}"
                                             IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                                    <StackPanel Orientation="Horizontal" Margin="18,12,18,12">
                                        <TextBlock Text="]" Margin="0,0,8,0" FontFamily="Lucida Console, Courier New" FontSize="{DynamicResource FontSizeLarge}"
                                                   Foreground="{DynamicResource TextBrushDarker}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" FontFamily="Lucida Console, Courier New" FontSize="{DynamicResource FontSizeLarge}"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                        <Rectangle Width="9" Height="16" Margin="6,0,0,0" Fill="{DynamicResource TextBrush}" VerticalAlignment="Center">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="CursorBlink">
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                                                                        </DoubleAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="CursorBlink" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <ScrollViewer HorizontalAlignment="Stretch"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                              x:Name="PART_ScrollViewHost">
                                    <Grid>
                                            <!-- Banner: a band of GameBannerHeight, fading down into the page through plain gradients (no OpacityMask: the Play button animates over it), a scrim darkening it toward the title. Collapses with the background art. -->
                                            <Grid x:Name="HeroArt" VerticalAlignment="Top" Height="{DynamicResource GameBannerHeight}" IsHitTestVisible="False">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid ClipToBounds="True">
                                                    <Border x:Name="ScrimSwatch" Background="{DynamicResource ScrimBrush}" Visibility="Collapsed" />
                                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                               HorizontalAlignment="Center" VerticalAlignment="Top" />
                                                    <Border Background="{DynamicResource ScrimBrush}" Opacity="0.7" IsHitTestVisible="False" />
                                                    <!-- No OpacityMask or BitmapCache on the banner: masked art repainted in part (behind the animated Play button) left dark seams
                                         on scaled displays. The scrim and the fade into the page are plain gradients. -->
                                    <Rectangle Opacity="0.6">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.3" />
                                                <GradientStop Color="{Binding Background.Color, ElementName=ScrimSwatch}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.4" />
                                                <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                                </Grid>
                                            </Grid>

                                        <Grid HorizontalAlignment="Stretch" Margin="20,0,20,0">
                                            <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                                <!-- Room above the title: scales with the banner (x * 90 / 320 at the default banner height), 0 or the fallback when the banner is off. -->
                                                <Border Grid.Row="0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 90 / 320'}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                                    <Setter Property="Height" Value="24" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                            <!-- Header: title and compact right-aligned actions share one row. -->
                                            <DockPanel Grid.Row="1" Margin="0,0,0,20">
                                                <Grid DockPanel.Dock="Right" Margin="16,0,0,0" Background="Transparent" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Name="PART_ButtonPlayAction" Grid.Column="0"
                                                            Height="40" Style="{DynamicResource PlayButton}" />
                                                    <Button Name="PART_ButtonContextAction"
                                                            Height="40" Grid.Column="0" />
                                                    <Button Width="40" Name="PART_ButtonMoreActions"
                                                            Height="40" Grid.Column="1" Margin="4,0,0,0"
                                                ToolTip="{DynamicResource LOCMoreAction}" Padding="0">
                                            <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                            Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                        </Button>
                                                    <Button Padding="0" Width="40" x:Name="PART_ButtonEditGame" Grid.Column="2" Margin="4,0,0,0" Height="40" Focusable="False"
                                                            Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}" ToolTip="{DynamicResource LOCEditGame}">
                                                    </Button>
                                                </Grid>
                                                <DockPanel VerticalAlignment="Center">
                                                    <Image Name="PART_ImageIcon" DockPanel.Dock="Left" MaxHeight="32" MaxWidth="32"
                                                           RenderOptions.BitmapScalingMode="Fant" Margin="0,0,10,0"
                                                           VerticalAlignment="Center" />
                                                    <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource FontFamily}"
                                                               FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                </DockPanel>
                                            </DockPanel>

                                            <!-- Two columns: screenshots, description and notes on the left, the narrower metadata pane on the right -->
                                            <DockPanel Grid.Row="2">
                                                <Border DockPanel.Dock="Right" VerticalAlignment="Top" Margin="24,0,0,24"
                                                        Background="{DynamicResource ExpanderBackgroundBrush}"
                                                        BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1" Padding="14,12">
                                                    <Border.Resources>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="VerticalAlignment" Value="Top" />
                                                        </Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                    </Border.Resources>
                                                    <!-- Groups draw a 1px rule on top; the wrapper pulls the first one out of view. Margins: -(2 x 12 + 1 + 8) top, -8 bottom. -->
                                                    <Border ClipToBounds="True" Width="{DynamicResource GridDetailsPaneWidth}">
                                                        <StackPanel Margin="0,-33,0,-8">
                                                            <Border x:Name="MetaProgress" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource MenuSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Grid x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCCompletionStatus}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <Button Grid.Column="2" Name="PART_ButtonCompletionStatus" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCTimePlayed}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <TextBlock Grid.Column="2" Name="PART_TextPlayTime" VerticalAlignment="Top" TextWrapping="Wrap" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCLastPlayed}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <TextBlock Grid.Column="2" Name="PART_TextLastActivity" VerticalAlignment="Top" TextWrapping="Wrap" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCDateAddedLabel}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <TextBlock Grid.Column="2" Name="PART_TextAdded" VerticalAlignment="Top" TextWrapping="Wrap" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaScores" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource MenuSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Grid x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCCommunityScore}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <TextBlock Grid.Column="2" Name="PART_TextCommunityScore" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCCriticScore}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <TextBlock Grid.Column="2" Name="PART_TextCriticScore" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCUserScore}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <TextBlock Grid.Column="2" Name="PART_TextUserScore" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaAbout" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource MenuSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Grid x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCDeveloperLabel}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <ItemsControl Grid.Column="2" Name="PART_ItemsDevelopers" VerticalAlignment="Top" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCPublisherLabel}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <ItemsControl Grid.Column="2" Name="PART_ItemsPublishers" VerticalAlignment="Top" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <Button Grid.Column="2" Name="PART_ButtonReleaseDate" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCSeriesLabel}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <ItemsControl Grid.Column="2" Name="PART_ItemsSeries" VerticalAlignment="Top" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <ItemsControl Grid.Column="2" Name="PART_ItemsAgeRatings" VerticalAlignment="Top" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemRegion" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCRegionLabel}" TextWrapping="Wrap"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                        <ItemsControl Grid.Column="2" Name="PART_ItemsRegions" VerticalAlignment="Top" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaTags" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource MenuSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Grid x:Name="PART_ElemPlatform" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCPlatformTitle}" TextWrapping="Wrap"
