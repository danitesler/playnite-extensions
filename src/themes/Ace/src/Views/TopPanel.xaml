<!--
    Ace: top panel. Overlay on Default Views/TopPanel.xaml.
    40px olive strip (TopPanelBackgroundBrush) with a 1px bevel line (TopPanelSeparatorBrush) along its bottom. Order as in
    the Default theme: main menu (when the sidebar is hidden), search box, main items (icon-only view switches, group, sort,
    view settings), filter toggle, notifications, plugin items. The right 110px stay clear for the window buttons
    (3 x 28 plus a gap). All glyphs are Icon geometries through IconTemplate at IconSize; TopPanelItem shows the Title tooltip.
    TopPanelSearchBox is a sunken black field with amber text (TopPanelSearchBoxBackgroundBrush).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Content="{DynamicResource IconViewSettings}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Content="{DynamicResource IconFilterPresets}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Content="{DynamicResource IconGroup}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Content="{DynamicResource IconSort}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Content="{DynamicResource IconDetailsView}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Content="{DynamicResource IconGridView}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Content="{DynamicResource IconListView}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          TextElement.Foreground="{DynamicResource WarningBrush}"
                          Content="{DynamicResource IconUpdate}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Content="{DynamicResource IconExplorer}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Content="{DynamicResource IconRandom}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Content="{DynamicResource IconViewRandom}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Content="{DynamicResource IconSearch}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Grid.IsSharedSizeScope="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search box: sunken black field, amber text, dim beige search and clear icons, lit edge while it has focus. -->
    <Style x:Key="TopPanelSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Field" Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}" CornerRadius="0" />
                        <Control Template="{DynamicResource BevelInsetTemplate}" Background="Transparent" />
                        <Border x:Name="FocusEdge" BorderThickness="1" BorderBrush="Transparent"
                                CornerRadius="0" IsHitTestVisible="False" />
                        <ContentControl x:Name="Glyph"
                                        ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0"
                                        Foreground="{DynamicResource GlyphBrush}" Panel.ZIndex="1" IsHitTestVisible="False" />
                            <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                        <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                 Foreground="{DynamicResource TextBrush}"
                                 VerticalContentAlignment="Center" Padding="26,0,24,0" />
                        <ContentControl x:Name="PART_ClearTextIcon"
                                        ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"
                                        Foreground="{DynamicResource TextBrushDarker}">
                            <ContentControl.Template>
                                <ControlTemplate TargetType="ContentControl">
                                    <Border Background="Transparent">
                                        <ContentPresenter ContentSource="Content" />
                                    </Border>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusEdge" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                        </Trigger>

                        <!-- Keep the magnifier visible while Playnite hides its placeholder. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter toggle: 28px bevelled olive button; with an active filter it is sunken with an amber glyph and the label. -->
    <!-- Filter active: a small square in the notification accent (DataChangeNotifBrush) on the icon's top-right corner, no text. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="0" />
                        <Control x:Name="PlateRaised" Template="{DynamicResource BevelTemplate}" Background="Transparent" />
                        <Control x:Name="PlateInset" Template="{DynamicResource BevelInsetTemplate}"
                                 Background="Transparent" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Margin="5,0,5,0" VerticalAlignment="Center">
                            <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Content="{DynamicResource IconFilter}"
                                              ContentTemplate="{DynamicResource IconTemplate}" />
                            <Rectangle x:Name="TextFilter" Visibility="Collapsed" IsHitTestVisible="False" Margin="-4,-18,-4,0" VerticalAlignment="Center" Width="7" Height="7" Fill="{DynamicResource DataChangeNotifBrush}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" TargetName="Fill" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PlateRaised" />
                            <Setter Property="Visibility" Value="Visible" TargetName="PlateInset" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource True}">
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Notifications toggle: bevelled olive button with a square count badge (DangerBrush); sunken while the panel is open. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="0" />
                        <Control x:Name="PlateRaised" Template="{DynamicResource BevelTemplate}" Background="Transparent" />
                        <Control x:Name="PlateInset" Template="{DynamicResource BevelInsetTemplate}"
                                 Background="Transparent" Visibility="Collapsed" />
                        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          Content="{DynamicResource IconNotifications}"
                                          ContentTemplate="{DynamicResource IconTemplate}" />
                        <Border CornerRadius="0" Width="15" Height="15"
                                Background="{DynamicResource DangerBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="{Api Notifications.Count}" FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource DangerForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PlateRaised" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlateInset" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Border MinHeight="40" BorderBrush="{DynamicResource TopPanelSeparatorBrush}"
                            Background="{DynamicResource TopPanelBackgroundBrush}"
                            d:DesignWidth="1280"
                            d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Margin="0,0,110,0">
                            <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource MainMenuButton}"
                                    DockPanel.Dock="Left" Width="28" Height="28" VerticalAlignment="Center"
                                     Margin="6,0,0,0">
                                <Grid>
                                    <Control Template="{DynamicResource BevelTemplate}" Background="Transparent" />
                                    <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Content="{DynamicResource IconMainMenu}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Grid>
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch" Style="{DynamicResource TopPanelSearchBox}"
                                       Width="180" Height="24" VerticalAlignment="Center" Margin="6,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True" DockPanel.Dock="Left" HorizontalAlignment="Left" />

                            <CheckBox x:Name="PART_ToggleFilter" Style="{DynamicResource TopPanelFilterToggle}" ToolTip="{DynamicResource LOCFilters}" DockPanel.Dock="Left" />

                            <!-- Keep sorting first even though Playnite inserts it after view settings and grouping. -->
                            <Grid x:Name="PART_PanelMainItems" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="{x:Type TopPanelItem}" BasedOn="{StaticResource {x:Type TopPanelItem}}">
                                        <Style.Triggers>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSortSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="0" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSearchButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="1" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGeneralViewSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="2" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelFilterPresetsSelectionTemplate}">
                                                <Setter Property="Grid.Column" Value="3" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGroupSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="4" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchDetailsViewTemplate}">
                                                <Setter Property="Grid.Column" Value="6" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchGridViewTemplate}">
                                                <Setter Property="Grid.Column" Value="7" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchListViewTemplate}">
                                                <Setter Property="Grid.Column" Value="8" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelUpdateButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="9" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="10" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelViewSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="11" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelExplorerSwitchTemplate}">
                                                <Setter Property="Grid.Column" Value="12" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Grid.Column" Value="5" />
                                    </Style>
                                </Grid.Resources>
                            </Grid>


                            <!-- A light track keeps dark text readable over both the track and the amber fill. -->
                            <DockPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,6,0" Visibility="{Binding Visibility, ElementName=PART_ProgressGlobal}">
                                <Button Name="PART_ButtonProgressCancel" DockPanel.Dock="Right" Content="{DynamicResource LOCCancelLabel}" Height="28" Margin="6,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True" />
                                <Grid Width="220">
                                    <ProgressBar Name="PART_ProgressGlobal" Height="24" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                                    <TextBlock Name="PART_TextProgressText" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrushDark}"
                                               FontSize="{DynamicResource FontSizeLarge}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Grid>
                            </DockPanel>
                            <!-- A single icon row: horizontal scrolling handles overflow without covering the captions. -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"
                                          Margin="0,3,0,3" Focusable="False" HorizontalContentAlignment="Stretch">
                                <ScrollViewer.Resources>
                                    <!-- Only the scrollbar and actual actions intercept caption input; empty toolbar space drags the window. -->
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                                    </Style>
                                </ScrollViewer.Resources>
                                <DockPanel LastChildFill="False">


                                    <CheckBox x:Name="PART_ToggleNotifications" Style="{DynamicResource TopPanelNotificationsToggle}" DockPanel.Dock="Left" />
                                    <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center" DockPanel.Dock="{Settings PluginTopPanelAlignment}" />
                                </DockPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
