<!--
    Checkpost: left rail, 44px of booth metal (ShellBackgroundBrush) closed by a 2px lifted seam, the desk front of the stamp bar. Three hex
    bolts sit at its foot (sparse decor; hidden while the sidebar sits at the top or bottom and while window art is on). The main menu is the
    rubber-stamp mark on an olive ledged plate; on hover a lime plate steps in over it and the mark turns ink. The current item is a lime
    key-cap plate with a red seal pip on the rail edge (SidebarItem.xaml).
    Colors: ShellBackgroundBrush, MainMenuButtonForegroundBrush, LocalOliveBrush, LocalLimeBrush, LocalDeskLitBrush.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <!-- Three hex bolts at the rail's foot. Fixed width: nothing here may ask for more than the rail. -->
                            <StackPanel x:Name="RailLattice" Width="40" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                <Rectangle Width="6" Height="6" Fill="{DynamicResource LocalDeskLitBrush}" />
                                <Rectangle Width="6" Height="6" Margin="0,10,0,0" Fill="{DynamicResource LocalDeskLitBrush}" />
                                <Rectangle Width="6" Height="6" Margin="0,10,0,0" Fill="{DynamicResource LocalDeskLitBrush}" />
                            </StackPanel>
                            <Rectangle x:Name="EdgeLine" Width="2" HorizontalAlignment="Right" Fill="{DynamicResource LocalDeskLitBrush}" IsHitTestVisible="False" />
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="52" Margin="0,0,0,0"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid x:Name="MenuSocketHost" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center" SnapsToDevicePixels="True">
                <Control x:Name="MenuPlate" Width="36" Height="36" Template="{DynamicResource LocalLedge3Template}"
                         IsHitTestVisible="False" Focusable="False" IsTabStop="False" Background="{DynamicResource LocalOliveBrush}" BorderBrush="{DynamicResource LocalOliveDeepBrush}" />
                <Control x:Name="MenuMark" Template="{DynamicResource LocalCheckpostMenuMarkTemplate}" Focusable="False" IsTabStop="False"
                         Foreground="{DynamicResource MainMenuButtonForegroundBrush}" Margin="0,0,0,2" />
            </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailLattice" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailLattice" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="2" TargetName="EdgeLine" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailLattice" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="2" TargetName="EdgeLine" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="EdgeLine" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
