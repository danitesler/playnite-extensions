                                            <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource LocalDisplayFontFamily}" FontSize="40"
                                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Grid>
                                </DockPanel>
