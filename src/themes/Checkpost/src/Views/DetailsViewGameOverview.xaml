                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource LocalVoidBrush}">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="0.54" />
                                            <GradientStop Color="#29000000" Offset="0.54" />
                                            <GradientStop Color="#29000000" Offset="0.614" />
                                            <GradientStop Color="#57000000" Offset="0.614" />
                                            <GradientStop Color="#57000000" Offset="0.689" />
                                            <GradientStop Color="#8A000000" Offset="0.689" />
                                            <GradientStop Color="#8A000000" Offset="0.77" />
                                            <GradientStop Color="#BD000000" Offset="0.77" />
                                            <GradientStop Color="#BD000000" Offset="0.85" />
                                            <GradientStop Color="#E6000000" Offset="0.85" />
                                            <GradientStop Color="#E6000000" Offset="0.925" />
                                            <GradientStop Color="#FF000000" Offset="0.925" />
                                            <GradientStop Color="#FF000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Rectangle Height="10" VerticalAlignment="Top" Fill="{DynamicResource LocalVoidBrush}" />
                            </Grid>
                            <StackPanel Margin="28,0,28,28">
