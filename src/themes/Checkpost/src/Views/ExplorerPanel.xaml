<!--
    Overlay on Playnite Default/Views/ExplorerPanel.xaml.
    The explorer panel is a LocalOliveDeepBrush board on the void with a 1px moss-deep rule on its inner edge, 16px header padding and the list sunk into a void well
    (1px moss-deep border, 12px inset) so the olive-deep row wash reads against it. PART_SelectFields, PART_SelectItems and PART_ButtonClose are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ExplorerPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ExplorerPanel}">
                    <Border BorderBrush="{DynamicResource LocalMossDeepBrush}"
                           >
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource LocalOliveDeepBrush}" />
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ExplorerPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="16,12,12,8">
                                <Button Style="{DynamicResource FilterPresetButtonAction}"
                                        Width="28" MinWidth="28" MaxWidth="28" Height="28" MinHeight="0" MaxHeight="28"
                                        DockPanel.Dock="Right" Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Name="PART_ButtonClose">
                                    <ContentControl Width="14" Height="14" Focusable="False" Content="{DynamicResource IconWindowClose}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <ComboBox Name="PART_SelectFields" MaxDropDownHeight="Auto"
                                          DockPanel.Dock="Left" />
                            </DockPanel>
                            <Border DockPanel.Dock="Top" Margin="12,0,12,12" Background="{DynamicResource LocalVoidBrush}"
                                    BorderBrush="{DynamicResource LocalMossDeepBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                                <ListBox Name="PART_SelectItems"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </Border>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
