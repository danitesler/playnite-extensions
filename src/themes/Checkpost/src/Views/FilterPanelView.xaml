<!--
    Overlay on Playnite Default/Views/FilterPanelView.xaml.
    The filter panel is a LocalOliveDeepBrush board on the void with a 1px moss-deep rule on its inner edge. Each field caption is a DAY tab (an olive plate with
    3px cut corners, Pixelify Sans 17px) followed by a 1px moss-deep hairline that fills the row; fields and preset controls are 28px, 16px side margins, the
    preset buttons are bare pixel glyphs. The parts, and the keyed styles Playnite applies from code, keep their keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FilterPanelCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="16,4,16,8" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="{StaticResource False}">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Margin" Value="16,14,16,6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Label}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource LocalOliveBrush}" CornerRadius="{DynamicResource CornerRadiusLarge}" Padding="9,1,11,3">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Border Grid.Column="1" Height="1" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                Background="{DynamicResource LocalMossDeepBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource False}">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelFilterSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border Style="{DynamicResource HighlightBorder}" Background="{TemplateBinding Background}">
                        <Grid>
                            <ContentControl x:Name="PART_SeachIcon" ContentTemplate="{DynamicResource SearchTextIconTemplate}" Visibility="Collapsed" />
                            <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}" MinHeight="0"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,28,0" />
                            <ContentControl x:Name="PART_ClearTextIcon" ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="16,0,16,0" />
        <Setter Property="ShowImage" Value="False" />
    </Style>

    <Style x:Key="FilterPanelFilterSelectionBox" TargetType="FilterSelectionBox" BasedOn="{StaticResource {x:Type FilterSelectionBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <Style x:Key="FilterPanelFilterEnumSelectionBox" TargetType="FilterEnumSelectionBox" BasedOn="{StaticResource {x:Type FilterEnumSelectionBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <Style x:Key="FilterPanelFilterStringSelectionBox" TargetType="FilterStringSelectionBox" BasedOn="{StaticResource {x:Type FilterStringSelectionBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <!-- Bare pixel-glyph buttons (preset add / rename / delete, panel close): dim at rest, an olive plate steps in over two frames on hover and the glyph turns cream. -->
    <Style x:Key="FilterPresetButtonAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True" Background="Transparent">
                        <Border x:Name="HoverPlate" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource ButtonBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverPlate" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PresetHoverIn">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PresetHoverIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverPlate" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type FilterPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPanel}">
                    <Border BorderBrush="{DynamicResource LocalMossDeepBrush}"
                           >
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource LocalOliveDeepBrush}" />
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings FilterPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <DockPanel Margin="16,12,12,8" DockPanel.Dock="Top">
                                <Button Style="{StaticResource FilterPresetButtonAction}"
                                        Width="28" MinWidth="28" MaxWidth="28" Height="28" MinHeight="0" MaxHeight="28"
                                        DockPanel.Dock="Right" VerticalAlignment="Center"
                                        Name="PART_ButtonClose">
                                    <ContentControl Width="14" Height="14" Focusable="False" Content="{DynamicResource IconWindowClose}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button DockPanel.Dock="Left" Content="{StaticResource LOCClearFilters}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Style="{StaticResource SimpleButton}"
                                        Name="PART_ButtonClear" />
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,0,16,8">
                                <Button Width="28" MinWidth="28" MaxWidth="28" Padding="0" Height="28" MinHeight="0" MaxHeight="28" x:Name="PART_ButtonDeleteFilter"
                                        Style="{DynamicResource FilterPresetButtonAction}">
                                    <ContentControl Width="16" Height="16" Focusable="False" Content="{DynamicResource IconRemove}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button Width="28" MinWidth="28" MaxWidth="28" Padding="0" Height="28" MinHeight="0" MaxHeight="28" x:Name="PART_ButtonRenameFilter"
                                        Style="{DynamicResource FilterPresetButtonAction}">
                                    <ContentControl Width="16" Height="16" Focusable="False" Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button Width="28" MinWidth="28" MaxWidth="28" Padding="0" Height="28" MinHeight="0" MaxHeight="28" x:Name="PART_ButtonSaveFilter"
                                        Style="{DynamicResource FilterPresetButtonAction}">
                                    <ContentControl Width="16" Height="16" Focusable="False" Content="{DynamicResource IconAdd}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <ComboBox Height="28" MinHeight="0" x:Name="PART_ComboFilterPresets"
                                          DockPanel.Dock="Left" VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          DockPanel.Dock="Top" Padding="0,0,0,16">
                                <StackPanel x:Name="PART_PanelItemsHost" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
