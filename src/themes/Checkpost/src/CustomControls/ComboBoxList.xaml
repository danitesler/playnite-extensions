<!--
    Overlay on Playnite Default/CustomControls/ComboBoxList.xaml: multi-select dropdowns. The closed field is the ComboBox's form field:
    a LocalOliveDeepBrush fill in a 1px LocalMossDeepBrush border with 2px corners, a 28px chevron cell (IconDropDown, 12px, LocalDimBrush) behind a
    hairline, the same border states (hover LocalDimBrush; keyboard focus and an open list lime) and the same single-step chevron flip.
    It fills whatever height it is given, so it sits at the shared 32px (ControlHeight) and at the filter panel's 28px.
    The popup wears the shared board (LocalMenuBoardTemplate, ContextMenu.xaml) and drops in 4px over three frames when the toggle opens it
    (4px of transparent room above the board, so the popup is offset up by 1px to sit 3px under the field).
    Playnite's named parts are kept; the template triggers use SourceName="MainToggle" (these controls have no IsDropDownOpen).
    Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="ComboBoxListBaseTemplate" TargetType="{x:Type ComboBoxListBase}">
        <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="Field" IsHitTestVisible="False" Background="{DynamicResource LocalOliveDeepBrush}" BorderBrush="{DynamicResource LocalMossDeepBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Grid Margin="1" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <!-- text keeps clear of the clear button (24px) and the chevron cell (28px) -->
                <TextBlock x:Name="PART_TextFilterString"
                           Style="{StaticResource BaseTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           Margin="9,0,24,0" />
                <Rectangle Grid.Column="1" Width="1" Margin="0,6,0,6" HorizontalAlignment="Left" Fill="{DynamicResource LocalMossDeepBrush}" />
                <ContentControl x:Name="Chevron" Grid.Column="1" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Focusable="False" IsTabStop="False" RenderTransformOrigin="0.5,0.5"
                                Foreground="{DynamicResource LocalDimBrush}"
                                Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconTemplate}">
                    <ContentControl.RenderTransform>
                        <RotateTransform x:Name="ChevronTurn" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
            <ToggleButton x:Name="MainToggle"
                          BorderThickness="0" Focusable="False"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <Button x:Name="PART_ButtonClearFilter"
                    Margin="0,0,28,0" Width="24" FontSize="18" MinHeight="0"
                    Foreground="{DynamicResource TextBrushDarker}" HorizontalAlignment="Right"
                    BorderThickness="0" Padding="3,0,3,0"
                    ContentTemplate="{DynamicResource ClearTextIconTemplate}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True" Name="Popup" VerticalOffset="-1"
                   IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False"
                   MaxHeight="300" MinWidth="{Binding ActualWidth, ElementName=MainToggle}">
                <Grid x:Name="ListBoard" Margin="0,4,0,0" SnapsToDevicePixels="True">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ListDrop" />
                    </Grid.RenderTransform>
                    <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <Grid Margin="6,6,9,9">
                        <ItemsControl x:Name="PART_ItemsPanel" />
                    </Grid>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource LocalDimBrush}" TargetName="Field" />
            </Trigger>
            <Trigger SourceName="MainToggle" Property="IsChecked" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource LocalLimeBrush}" TargetName="Field" />
                <Setter Property="Foreground" Value="{DynamicResource LocalLimeBrush}" TargetName="Chevron" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="ListDropIn">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ListBoard" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.75" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ListDrop" Storyboard.TargetProperty="Y">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="-2" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                    <BeginStoryboard x:Name="ChevronFlip">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="180" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.02" Value="180" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="ListDropIn" />
                    <RemoveStoryboard BeginStoryboardName="ChevronFlip" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="FilterComboBoxListTemplate" TargetType="{x:Type ComboBoxListBase}">
        <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="Field" IsHitTestVisible="False" Background="{DynamicResource LocalOliveDeepBrush}" BorderBrush="{DynamicResource LocalMossDeepBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Grid Margin="1" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PART_TextFilterString"
                           Style="{StaticResource BaseTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           Margin="9,0,24,0" />
                <Rectangle Grid.Column="1" Width="1" Margin="0,6,0,6" HorizontalAlignment="Left" Fill="{DynamicResource LocalMossDeepBrush}" />
                <ContentControl x:Name="Chevron" Grid.Column="1" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Focusable="False" IsTabStop="False" RenderTransformOrigin="0.5,0.5"
                                Foreground="{DynamicResource LocalDimBrush}"
                                Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconTemplate}">
                    <ContentControl.RenderTransform>
                        <RotateTransform x:Name="ChevronTurn" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
            <ToggleButton x:Name="MainToggle"
                          BorderThickness="0" Focusable="False"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <Button x:Name="PART_ButtonClearFilter"
                    Margin="0,0,28,0" Width="24" FontSize="18" MinHeight="0"
                    Foreground="{DynamicResource TextBrushDarker}" HorizontalAlignment="Right"
                    BorderThickness="0" Padding="3,0,3,0"
                    ContentTemplate="{DynamicResource ClearTextIconTemplate}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True" Name="Popup" VerticalOffset="-1"
                   IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False"
                   MaxHeight="300" MinWidth="{Binding ActualWidth, ElementName=MainToggle}">
                <Grid x:Name="ListBoard" Margin="0,4,0,0" SnapsToDevicePixels="True">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ListDrop" />
                    </Grid.RenderTransform>
                    <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <Grid Margin="6,6,9,9">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="2,2,2,5" Name="PART_ElemSearchHost">
                            <CheckBox DockPanel.Dock="Right"
                                      x:Name="PART_ToggleSelectedOnly"
                                      ToolTip="{DynamicResource LOCOnlyItemsSelectedTooltip}"
                                      FontFamily="{DynamicResource FontIcoFont}" />
                            <SearchBox DockPanel.Dock="Left" Margin="0,0,5,0" x:Name="PART_SearchBox" />
                        </DockPanel>
                        <ItemsControl x:Name="PART_ItemsPanel" Grid.Row="1" />
                    </Grid>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource LocalDimBrush}" TargetName="Field" />
            </Trigger>
            <Trigger SourceName="MainToggle" Property="IsChecked" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource LocalLimeBrush}" TargetName="Field" />
                <Setter Property="Foreground" Value="{DynamicResource LocalLimeBrush}" TargetName="Chevron" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="ListDropIn">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ListBoard" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.75" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ListDrop" Storyboard.TargetProperty="Y">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="-2" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                    <BeginStoryboard x:Name="ChevronFlip">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="180" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.02" Value="180" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="ListDropIn" />
                    <RemoveStoryboard BeginStoryboardName="ChevronFlip" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ComboBoxList}" BasedOn="{StaticResource {x:Type ComboBoxList}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
    <Style TargetType="{x:Type DdItemListSelectionBox}" BasedOn="{StaticResource {x:Type DdItemListSelectionBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
</ResourceDictionary>
