<!--
    Checkpost: SidebarItem. A 44x40 cell on the booth-metal rail with a 16px pixel glyph. Idle glyphs are dim green-grey; hover steps in an
    olive-deep key-cap square and whitens the glyph. Current: a lime key-cap plate (36x34, 2px lower edge, ink glyph) that snaps in over two
    steps, and a red seal pip on the rail's edge. Fixed 14,12 padding sizes the glyph; IconPadding is not added on top (it would collapse
    the Viewbox). Library and Statistics use the theme's glyphs.
    Colors: SidebarItemForegroundBrush, SidebarItemSelectedForegroundBrush, LocalOliveDeepBrush, LocalLimeBrush, LocalMossBrush, LocalSealBrush.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="Plate" Width="34" Height="32" SnapsToDevicePixels="True" Background="{TemplateBinding Background}" />
                        <!-- Hover: an olive-deep key-cap square. -->
                        <Border x:Name="HoverPlate" Width="34" Height="32" Background="{DynamicResource LocalOliveDeepBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        <!-- Current: the lime key-cap plate, the red seal pip on the rail edge. -->
                        <Grid x:Name="Marks" Visibility="Collapsed" IsHitTestVisible="False" Width="36" Height="34" HorizontalAlignment="Center" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="MarkScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border Margin="0,2,0,0" Background="{DynamicResource LocalMossBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border Margin="0,0,0,2" Background="{DynamicResource SelectedBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border Width="4" Height="12" Margin="0,0,-4,2" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource LocalSealBrush}" />
                        </Grid>
                        <Border x:Name="GlyphHost" Padding="14,12" Margin="0,0,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="GlyphShift" X="0" />
                            </Border.RenderTransform>
                            <Viewbox x:Name="ItemIcon">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                        </Border>
                        <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                        Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ContentTemplate="{DynamicResource IconTemplate}" />
                        <ProgressBar x:Name="PART_ProgressStatus" Height="2" Margin="10,0,10,2" BorderThickness="0" Background="Transparent"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Hidden" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Marks" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.9" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.9" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
