<!--
    Checkpost: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json); each placeholder names the token that plays the key's role.
    Black void pages, olive plates (control fills, panels), booth brown for the shell. Selection is lime paper with ink,
    Play is the stamp green with a cream label, danger the deepened red, running is amber (nothing else uses it).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Typography: Zilla Slab (Regular, Bold) is the body face, Pixelify Sans (Regular, feature-stripped copy: no liga / dlig) the pixel face for
         titles, the Play stamp, headings and the DAY band at 17px and up (its c reads as o below that), Consolas carries ledger numerals.
         Both bundled faces live in src/Typography. -->
    <sys:Double x:Key="FontSizeSmall">{{px:size-caption}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:size-body}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:size-lead}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:size-title}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:size-display}}</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Zilla Slab, {{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Pixelify Sans, {{text:font-display|Segoe UI}}</FontFamily>
    <FontFamily x:Key="LocalDisplayFontFamily">./Typography/#Pixelify Sans, {{text:font-display|Segoe UI}}</FontFamily>
    <!-- Metadata width defaults (usable content, inside the pane's padding and frame). -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>
    <!-- Shape: pixel corners (2px), 1px hairlines and 2px rims; the ledge under a stamp or plate is 3px. -->
    <Thickness x:Key="PopupBorderThickness">{{px:stroke-rim}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:stroke-hair}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:stroke-rim}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:corner-medium}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:corner-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:corner-large}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:corner-xlarge}}</CornerRadius>
    <sys:Double x:Key="LocalLedge">3</sys:Double>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{text}}</Color>
    <Color x:Key="TextColorDarker">{{dim}}</Color>
    <Color x:Key="TextColorDark">{{ink}}</Color>
    <Color x:Key="MainColor">{{olive}}</Color>
    <Color x:Key="MainColorDark">{{olive-deep}}</Color>
    <Color x:Key="HoverColor">{{olive-lit}}</Color>
    <Color x:Key="GlyphColor">{{lime}}</Color>
    <Color x:Key="HighlightGlyphColor">{{lime/35}}</Color>
    <Color x:Key="PopupBackgroundColor">{{olive-deep}}</Color>
    <Color x:Key="PopupBorderColor">{{moss}}</Color>
    <Color x:Key="BackgroundToneColor">{{olive-deep}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{olive-deep}}</Color>   <!-- the slot behind each cover -->
    <Color x:Key="PanelSeparatorColor">{{desk-edge}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{olive}}</Color>
    <Color x:Key="DataChangeNotifColor">{{seal}}</Color>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <!-- Banner darkening color: the title screen's olive extrusion shade, so a darker banner reads as the booth in shadow, not grey. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{olive-deep}}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{moss-deep}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{paper-blue}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{olive}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{olive-deep}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{ok}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{red-lit}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{amber}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{amber}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{olive-deep}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{void}}" />
    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->
    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{desk}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{desk}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{olive-deep}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{lime-lit}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{amber}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{olive-deep}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{olive-lit}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{olive-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{stamp}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{stamp-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{stamp}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{olive-deep}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{dim}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{moss}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{olive-deep}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{lime-lit}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{dim}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{olive-deep}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{moss-deep}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{moss}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{desk/70}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{moss}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{moss}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{dim}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{desk-lit}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{lime}}" />
    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{moss-deep}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{olive-deep}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{moss-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{stamp-ledge}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{moss-deep}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{dim}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{moss-deep}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{dim}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{moss-deep}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{moss-deep}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{olive-lit}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{olive}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{desk-edge}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{lime-lit}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{olive}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{moss-deep}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{olive-deep}}" />
    <SolidColorBrush x:Key="TextOutlineBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{olive}}" />
    <!-- Theme-only: the palette steps, stamp and paper colours, washes (Local prefix = no ThemeModifier entry, no shared meaning). -->
    <SolidColorBrush x:Key="LocalVoidBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="LocalDeskBrush" Color="{{desk}}" />
    <SolidColorBrush x:Key="LocalDeskLitBrush" Color="{{desk-lit}}" />
    <SolidColorBrush x:Key="LocalDeskEdgeBrush" Color="{{desk-edge}}" />
    <SolidColorBrush x:Key="LocalOliveBrush" Color="{{olive}}" />
    <SolidColorBrush x:Key="LocalOliveDeepBrush" Color="{{olive-deep}}" />
    <SolidColorBrush x:Key="LocalOliveLitBrush" Color="{{olive-lit}}" />
    <SolidColorBrush x:Key="LocalMossBrush" Color="{{moss}}" />
    <SolidColorBrush x:Key="LocalMossDeepBrush" Color="{{moss-deep}}" />
    <SolidColorBrush x:Key="LocalTextBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="LocalDimBrush" Color="{{dim}}" />
    <SolidColorBrush x:Key="LocalFaintBrush" Color="{{faint}}" />
    <SolidColorBrush x:Key="LocalLimeBrush" Color="{{lime}}" />
    <SolidColorBrush x:Key="LocalLimeLitBrush" Color="{{lime-lit}}" />
    <SolidColorBrush x:Key="LocalCreamBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="LocalPeachBrush" Color="{{peach}}" />
    <SolidColorBrush x:Key="LocalInkBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="LocalInkSoftBrush" Color="{{ink-soft}}" />
    <SolidColorBrush x:Key="LocalRedBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="LocalRedLitPlateBrush" Color="{{red-lit-plate}}" />
    <SolidColorBrush x:Key="LocalSealBrush" Color="{{seal}}" />
    <SolidColorBrush x:Key="LocalRedLitBrush" Color="{{red-lit}}" />
    <SolidColorBrush x:Key="LocalRedLedgeBrush" Color="{{red-ledge}}" />
    <SolidColorBrush x:Key="LocalStampBrush" Color="{{stamp}}" />
    <SolidColorBrush x:Key="LocalStampLitBrush" Color="{{stamp-lit}}" />
    <SolidColorBrush x:Key="LocalStampLedgeBrush" Color="{{stamp-ledge}}" />
    <SolidColorBrush x:Key="LocalOkBrush" Color="{{ok}}" />
    <SolidColorBrush x:Key="LocalAmberBrush" Color="{{amber}}" />
    <SolidColorBrush x:Key="LocalAmberLedgeBrush" Color="{{amber-ledge}}" />
    <SolidColorBrush x:Key="LocalPaperPinkBrush" Color="{{paper-pink}}" />
    <SolidColorBrush x:Key="LocalPaperPinkLitBrush" Color="{{paper-pink-lit}}" />
    <SolidColorBrush x:Key="LocalPaperEdgeBrush" Color="{{paper-edge}}" />
    <SolidColorBrush x:Key="LocalPaperInkBrush" Color="{{paper-ink}}" />
    <SolidColorBrush x:Key="LocalPaperSoftBrush" Color="{{paper-soft}}" />
    <SolidColorBrush x:Key="LocalPaperBlueBrush" Color="{{paper-blue}}" />
    <SolidColorBrush x:Key="LocalEdgeBrush" Color="{{edge}}" />
    <SolidColorBrush x:Key="LocalScrimBrush" Color="{{scrim}}" />
    <SolidColorBrush x:Key="LocalShadeBrush" Color="{{shade}}" />
</ResourceDictionary>
