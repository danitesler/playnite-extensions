<!--
    Checkpost: TreeView, the Settings section list. A bare column on the void closed by a 1px dotted moss-deep rule. Rows are 30px lines in the body face (Zilla Slab,
    TextBrushDarker at rest, no plate). Hover steps a LocalOliveDeepBrush wash in over two frames (100ms) and brightens the label. The chosen section is the report's
    olive plate with a 3px lime bar on its left edge and a bold TextBrush label; plate and bar step in together (two frames). Expanders are 8px pixel triangles
    (IconSubmenu / IconDropDown) in LocalMossBrush; parent labels sit 28px in, child rows are indented 34px (every row is full width, so plates never shift).
    Width triggers for WindowSettings / WindowExtensions keep the scroll lane reserved (Visible, never Auto).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Keyboard focus on a full-width row: the dotted frame sits inside the row, so the scroll viewer never clips it. -->
    <Style x:Key="LocalTreeRowFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="3,2,3,2" IsHitTestVisible="False" SnapsToDevicePixels="True" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1" StrokeDashArray="1 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
        <Style.Resources>
            <!-- Section breaks in the Settings tree: tagged so the item style below can make them inert. -->
            <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
                <Setter Property="Tag" Value="BrushNavigationDivider" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </Style.Resources>
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <Grid>
                            <ScrollViewer Focusable="False" Padding="8,8,0,8"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter />
                            </ScrollViewer>
                            <!-- The column's right edge: a dotted rule (1px dots on a 3px pitch). -->
                            <Border Width="1" HorizontalAlignment="Right" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                <Border.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,1,3" ViewportUnits="Absolute" Viewbox="0,0,1,3" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="{DynamicResource LocalMossDeepBrush}">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,1,1" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowSettings">
                <Setter Property="Width" Value="252" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowExtensions">
                <Setter Property="Width" Value="280" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="Normal" /> <!-- every item sets its own, so a bold selected parent does not make its children bold -->
        <Setter Property="Padding" Value="12,0,10,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource LocalTreeRowFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Grid x:Name="SelectionBorder" Background="Transparent" MinHeight="30">
                            <Border x:Name="HoverPlate" Background="{DynamicResource LocalOliveDeepBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="SelectedPlate" Background="{DynamicResource LocalOliveBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Visibility="Collapsed" Opacity="1" IsHitTestVisible="False" />
                            <Border x:Name="SelectedBar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource LocalLimeBrush}"
                                    Visibility="Collapsed" Opacity="1" IsHitTestVisible="False" />
                            <DockPanel Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                <ToggleButton x:Name="Expander" ClickMode="Press" DockPanel.Dock="Left" Width="16" Height="16" Margin="0"
                                              IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Style>
                                        <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseStyle}">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                        <Grid Background="Transparent">
                                                            <ContentControl x:Name="Collapsed" Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                                            Foreground="{DynamicResource LocalMossBrush}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                            <ContentControl x:Name="Expanded" Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                                            Foreground="{DynamicResource LocalMossBrush}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" TargetName="Expanded" />
                                                                <Setter Property="Visibility" Value="Collapsed" TargetName="Collapsed" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" DockPanel.Dock="Left" VerticalAlignment="Center" RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="190"
                                                       FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DockPanel>
                        </Grid>
                        <!-- Children are full-width rows too (their labels are indented by Padding, below); the arrow and the plate carry the hierarchy. -->
                        <Border x:Name="ItemsHost" Margin="0">
                            <ItemsPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemsHost" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="Visibility" Value="Hidden" TargetName="Expander" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="SelectionBorder">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="Opacity" Value="1" TargetName="HoverPlate" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowHoverIn">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RowHoverIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedBar" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalTextBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowSelectIn">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RowSelectIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- A row under an expanded parent is a child: its label lines up 34px in (18 pad + the 16px expander slot, which a leaf keeps Hidden). -->
            <DataTrigger Binding="{Binding Path=Parent.IsExpanded, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="True">
                <Setter Property="Padding" Value="18,0,10,0" />
            </DataTrigger>
            <!-- TreeView wraps Separator objects in TreeViewItem containers; suppress interaction on that container too. -->
            <DataTrigger Binding="{Binding Header.Tag, RelativeSource={RelativeSource Self}}" Value="BrushNavigationDivider">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="IsSelected" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                            <ContentPresenter ContentSource="Header" Margin="14,6,14,6" IsHitTestVisible="False" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
