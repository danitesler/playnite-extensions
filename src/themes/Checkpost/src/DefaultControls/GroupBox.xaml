<!--
    Checkpost: GroupBox, the Statistics page's card and the settings groups. A content-sized olive-deep panel (LocalOliveDeepBrush, 1px LocalMossDeepBrush border, 2px
    corners) whose title is the report's DAY tab: an olive plate with 3px cut corners holding the label in Pixelify Sans 17px, then a 1px moss-deep hairline that fills
    the rest of the row. No fixed widths and no stretching shapes (the hairline is a Border with no width): the card sizes to its content.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource LocalOliveDeepBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalMossDeepBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border SnapsToDevicePixels="True" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid x:Name="HeaderHost" DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource LocalOliveBrush}" CornerRadius="{DynamicResource CornerRadiusLarge}" Padding="12,2,12,3">
                                    <TextBlock Style="{DynamicResource HeadingTextBlock}" FontSize="17" VerticalAlignment="Center">
                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                          RecognizesAccessKey="True" />
                                    </TextBlock>
                                </Border>
                                <Border Grid.Column="1" Height="1" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Background="{DynamicResource LocalMossDeepBrush}" />
                            </Grid>
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderHost" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
