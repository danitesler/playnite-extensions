<!--
    Checkpost: ProgressBar. A square track (ProgressBarTrackBrush, 1px LocalMossDeepBrush border) with a flat fill (ProgressBarForegroundBrush), no rounding and no
    gloss, like the game's clock and progress ticks. The track takes Background, BorderBrush and BorderThickness from its host: a host that sets BorderThickness 0
    and a Transparent Background (the sidebar items' PART_ProgressStatus) gets a bare, transparent track, so no rule is ever drawn under a sidebar item.
    Indeterminate is a hard-edged third of the bar that steps across in twelve jumps.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalMossDeepBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Margin="{TemplateBinding BorderThickness}" Background="{TemplateBinding Foreground}" />
                        <Border x:Name="IndeterminateBar" Visibility="Collapsed" Margin="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Foreground}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-0.33" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="0" />
                                    <GradientStop Color="Black" Offset="0.33" />
                                    <GradientStop Color="Transparent" Offset="0.33" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="IndeterminateBar" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateSlide">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IndeterminateBar"
                                                                       Storyboard.TargetProperty="(Border.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-0.33" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="-0.22" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="-0.11" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.75" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.11" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.25" Value="0.22" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.5" Value="0.33" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.75" Value="0.44" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="0.55" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.25" Value="0.66" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.5" Value="0.77" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.75" Value="0.88" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="IndeterminateSlide" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
