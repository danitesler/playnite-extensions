<!--
    Checkpost: CheckBox. A 20x20 olive-deep box with a 2px LocalMossBrush border and 1px corners, like the report screen's field boxes. Hover lights the border lime
    (CheckBoxHoverBorderBrush), pressed turns it cream. Checked fills the box with lime paper (CheckMarkBrush) standing on a 3px LocalMossBrush lower edge and stamps
    an ink pixel tick (IconCheck, 14px) in over two discrete steps (scale 0.6 to 1). Indeterminate is a lime bar.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Border x:Name="BulletBorder" Background="{DynamicResource CheckBoxCheckMarkBkBrush}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="2" CornerRadius="1" />
                                <Grid x:Name="CheckedPlate" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Border x:Name="CheckedLedge" Background="{DynamicResource LocalMossBrush}" CornerRadius="1" />
                                    <Border x:Name="CheckedFace" Margin="0,0,0,3" Background="{DynamicResource CheckMarkBrush}" CornerRadius="1" />
                                </Grid>
                                <Grid x:Name="CheckIcon" Visibility="Collapsed" Margin="0,0,0,3" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="CheckScale" ScaleX="1" ScaleY="1" />
                                    </Grid.RenderTransform>
                                    <ContentControl Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False"
                                                    Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource LocalInkBrush}" />
                                </Grid>
                                <Border x:Name="IndeterminateIcon" Visibility="Collapsed" Width="10" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource CheckMarkBrush}" IsHitTestVisible="False" />
                            </Grid>
                            <ContentPresenter DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="BulletBorder" />
                            <Setter Property="Background" Value="{DynamicResource LocalLimeLitBrush}" TargetName="CheckedFace" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource LocalCreamBrush}" TargetName="BulletBorder" />
                            <Setter Property="Margin" Value="0,1,0,2" TargetName="CheckedFace" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckedPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CheckStamp">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CheckStamp" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
