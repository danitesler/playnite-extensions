<!--
    Checkpost: ToggleButton. The Button's ghost word (bare label, dotted LocalMossBrush underline, olive plate stepping in over 100ms on hover, deep olive when
    pressed). Checked it turns into a lime paper plate (ToggleButtonCheckedBackgroundBrush) on a 3px LocalMossBrush ledge with an ink bold label, no underline;
    hover lightens it to LocalLimeLitBrush and pressing drops the face onto its ledge.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True" Background="Transparent">
                        <Border x:Name="Ledge" Margin="0,3,0,0" Visibility="Collapsed" IsHitTestVisible="False" Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Face" IsHitTestVisible="False" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="HoverFace" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource ButtonBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Grid x:Name="UnderlineHost" Margin="12,0,12,5" VerticalAlignment="Bottom" Height="1" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Control Template="{DynamicResource DividerTemplate}" Focusable="False" IsTabStop="False" />
                            <Border x:Name="UnderlineLit" Visibility="Collapsed" Height="1" IsHitTestVisible="False">
                                <Border.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,3,1" ViewportUnits="Absolute" Viewbox="0,0,3,1" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="{DynamicResource LocalLimeBrush}">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,1,1" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <Grid x:Name="ContentHost" IsHitTestVisible="False">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverFace" Property="Opacity" Value="1" />
                            <Setter TargetName="UnderlineLit" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ToggleHoverIn">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverFace" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="ToggleHoverIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverFace" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ledge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Face" Property="Margin" Value="0,0,0,3" />
                            <Setter TargetName="HoverFace" Property="Margin" Value="0,0,0,3" />
                            <Setter TargetName="ContentHost" Property="Margin" Value="0,0,0,3" />
                            <Setter TargetName="HoverFace" Property="Background" Value="{DynamicResource LocalLimeLitBrush}" />
                            <Setter TargetName="UnderlineHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Face" Property="Margin" Value="0,3,0,0" />
                            <Setter TargetName="HoverFace" Property="Margin" Value="0,3,0,0" />
                            <Setter TargetName="ContentHost" Property="Margin" Value="0,3,0,0" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ToggleButtonCheckedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalMossBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalInkBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
