<!--
    Checkpost: TabControl. The rulebook's bookmark tabs: a row of 28px plates standing on a one-pixel moss-deep rule (no frame around the strip). Idle tabs are
    LocalOliveDeepBrush with a TextBrushDarker label, hover steps LocalOliveBrush in over two frames, the selected tab is lime paper with an ink label and a 2px
    TabItemIndicatorBrush (red) bar under it. Every tab reserves the 2px for the bar, so selecting never moves anything. Labels are Pixelify Sans 17px, never bold.
    With a Left or Right strip (the game editor) the rule and the bar move to the strip's inner edge. The TabItem keeps Foreground = TextBrush (tab pages inherit it)
    and every header colour is set on the header TextBlock through TargetName.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnDefinition0" />
                            <ColumnDefinition x:Name="ColumnDefinition1" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" x:Name="RowDefinition0" />
                            <RowDefinition Height="*" x:Name="RowDefinition1" />
                        </Grid.RowDefinitions>
                        <Border x:Name="HeaderBorder" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,4,0,10" Padding="0"
                                Background="{DynamicResource TabControlHeaderBackgroundBrush}" BorderBrush="{DynamicResource LocalMossDeepBrush}" BorderThickness="0,0,0,1">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Panel.ZIndex="1" Width="Auto" Height="Auto" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <Border x:Name="ContentPanel" Grid.Column="0" Grid.Row="1"
                                KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local" Background="{DynamicResource ControlBackgroundBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition1" Value="Auto" />
                            <Setter Property="Grid.Row" TargetName="HeaderBorder" Value="1"/>
                            <Setter Property="BorderThickness" TargetName="HeaderBorder" Value="0,1,0,0" />
                            <Setter Property="Margin" TargetName="HeaderBorder" Value="0,10,0,4" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter Property="Grid.Row" TargetName="HeaderBorder" Value="0" />
                            <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Grid.Column" TargetName="ContentPanel" Value="1" />
                            <Setter Property="Width" TargetName="ColumnDefinition0" Value="Auto" />
                            <Setter Property="Width" TargetName="ColumnDefinition1" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition1" Value="0" />
                            <Setter Property="Grid.Column" TargetName="HeaderBorder" Value="0"/>
                            <Setter Property="HorizontalAlignment" TargetName="HeaderBorder" Value="Left" />
                            <Setter Property="VerticalAlignment" TargetName="HeaderBorder" Value="Stretch" />
                            <Setter Property="BorderThickness" TargetName="HeaderBorder" Value="0,0,1,0" />
                            <Setter Property="Margin" TargetName="HeaderBorder" Value="0,0,18,0"/>
                            <Setter Property="Margin" TargetName="ContentPanel" Value="0,0,0,0"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter Property="Grid.Row" TargetName="HeaderBorder" Value="0" />
                            <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Grid.Column" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Width" TargetName="ColumnDefinition0" Value="*" />
                            <Setter Property="Width" TargetName="ColumnDefinition1" Value="Auto" />
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition1" Value="0" />
                            <Setter Property="Grid.Column" TargetName="HeaderBorder" Value="1"/>
                            <Setter Property="HorizontalAlignment" TargetName="HeaderBorder" Value="Left" />
                            <Setter Property="VerticalAlignment" TargetName="HeaderBorder" Value="Stretch" />
                            <Setter Property="BorderThickness" TargetName="HeaderBorder" Value="1,0,0,0" />
                            <Setter Property="Margin" TargetName="HeaderBorder" Value="18,0,0,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- The whole tab page inherits this colour (the edit dialog's labels set none), so it stays the normal text colour. Header colours are set on the header TextBlock only. -->
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="TabGrid" Background="Transparent" Margin="0,0,3,0" MinHeight="30">
                        <Border x:Name="TabPlate" Margin="0,0,0,2" IsHitTestVisible="False" Background="{DynamicResource LocalOliveDeepBrush}" CornerRadius="2,2,0,0" />
                        <Border x:Name="HoverPlate" Margin="0,0,0,2" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource LocalOliveBrush}" CornerRadius="2,2,0,0" />
                        <Border x:Name="SelectedPlate" Margin="0,0,0,2" Visibility="Collapsed" Opacity="1" IsHitTestVisible="False" Background="{DynamicResource LocalLimeBrush}" CornerRadius="2,2,0,0" />
                        <Border x:Name="SelectedBar" Height="2" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource TabItemIndicatorBrush}" />
                        <TextBlock x:Name="TextContent" Padding="14,2,14,2" Margin="0,0,0,2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="17" Foreground="{DynamicResource TextBrushDarker}">
                            <ContentPresenter x:Name="ContentSite" RecognizesAccessKey="True" ContentSource="Header"
                                              HorizontalAlignment="Center" Margin="2,0" VerticalAlignment="Center" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- A vertical strip (the game editor's section list): plates are rows, the bar moves to the strip's inner edge. -->
                        <DataTrigger Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Left">
                            <Setter TargetName="TabGrid" Property="Margin" Value="0,0,0,3" />
                            <Setter TargetName="TabPlate" Property="Margin" Value="0,0,2,0" />
                            <Setter TargetName="HoverPlate" Property="Margin" Value="0,0,2,0" />
                            <Setter TargetName="SelectedPlate" Property="Margin" Value="0,0,2,0" />
                            <Setter TargetName="TabPlate" Property="CornerRadius" Value="2,0,0,2" />
                            <Setter TargetName="HoverPlate" Property="CornerRadius" Value="2,0,0,2" />
                            <Setter TargetName="SelectedPlate" Property="CornerRadius" Value="2,0,0,2" />
                            <Setter TargetName="SelectedBar" Property="Height" Value="NaN" />
                            <Setter TargetName="SelectedBar" Property="Width" Value="2" />
                            <Setter TargetName="SelectedBar" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="SelectedBar" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="TextContent" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="TextContent" Property="Margin" Value="0,0,2,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Right">
                            <Setter TargetName="TabGrid" Property="Margin" Value="0,0,0,3" />
                            <Setter TargetName="TabPlate" Property="Margin" Value="2,0,0,0" />
                            <Setter TargetName="HoverPlate" Property="Margin" Value="2,0,0,0" />
                            <Setter TargetName="SelectedPlate" Property="Margin" Value="2,0,0,0" />
                            <Setter TargetName="TabPlate" Property="CornerRadius" Value="0,2,2,0" />
                            <Setter TargetName="HoverPlate" Property="CornerRadius" Value="0,2,2,0" />
                            <Setter TargetName="SelectedPlate" Property="CornerRadius" Value="0,2,2,0" />
                            <Setter TargetName="SelectedBar" Property="Height" Value="NaN" />
                            <Setter TargetName="SelectedBar" Property="Width" Value="2" />
                            <Setter TargetName="SelectedBar" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="SelectedBar" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="TextContent" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="TextContent" Property="Margin" Value="2,0,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Bottom">
                            <Setter TargetName="TabPlate" Property="Margin" Value="0,2,0,0" />
                            <Setter TargetName="HoverPlate" Property="Margin" Value="0,2,0,0" />
                            <Setter TargetName="SelectedPlate" Property="Margin" Value="0,2,0,0" />
                            <Setter TargetName="TabPlate" Property="CornerRadius" Value="0,0,2,2" />
                            <Setter TargetName="HoverPlate" Property="CornerRadius" Value="0,0,2,2" />
                            <Setter TargetName="SelectedPlate" Property="CornerRadius" Value="0,0,2,2" />
                            <Setter TargetName="SelectedBar" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="TextContent" Property="Margin" Value="0,2,0,0" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="HoverPlate" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="TextContent" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TabHoverIn">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="TabHoverIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedBar" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalInkBrush}" TargetName="TextContent" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TabSelectIn">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="TabSelectIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
