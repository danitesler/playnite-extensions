<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, top bar
    dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's
    multi-select boxes) is one Checkpost board: an inspection-booth form on the void, a document with a hard shadow.
    Levers (docs/themes/menus.md, BRIEF.md section 5):
    - Panel: LocalMenuBoardTemplate, a flat LocalOliveDeepBrush board in a 2px LocalMossBrush rim with 2px corners, and a 3px
      LocalEdgeBrush hard shadow plate behind it, shifted down and right (a second Border, no DropShadowEffect). Rows start 6px inside the
      rim edge on the left and top (2px rim + 4px padding) and 9px from the right and bottom (the 3px shadow counted in).
    - Entrance: the board hops down 4px in two discrete steps while it fades in over three frames (0.4 / 0.75 / 1, 40ms apart), from
      ControlTemplate triggers (here on IsOpen; the submenu, ComboBox and multi-select popups do the same on their own open flag).
      The popup root keeps 4px of transparent room above the board so the hop is not clipped; popups that follow a field offset up by that.
    - Highlight: a lime paper slip (LocalSlipTemplate: lime face, LocalMossBrush lower edge, three void punch dots), animated in Menu.xaml and ComboBox.xaml.
    - Icons: LocalMenuCheckTemplate (checked rows, the chosen ComboBox item), a pixel IconCheck in lime in the 26px icon column.
    Shared by Menu.xaml, ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml.
    Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The board: the shadow plate (shifted 3px down and right) behind the body, whose rim is 2px. -->
    <ControlTemplate x:Key="LocalMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Margin="3,3,0,0" Background="{DynamicResource LocalEdgeBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="0,0,3,3" Background="{DynamicResource LocalOliveDeepBrush}" BorderBrush="{DynamicResource LocalMossBrush}" BorderThickness="2"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Grid>
    </ControlTemplate>
    <!-- Checked row and chosen ComboBox item: the pixel IconCheck in the host's Foreground (lime at rest, ink on the slip), 16x16 in the icon column. -->
    <ControlTemplate x:Key="LocalMenuCheckTemplate" TargetType="{x:Type Control}">
        <ContentControl Width="16" Height="16" IsHitTestVisible="False" Focusable="False" IsTabStop="False" SnapsToDevicePixels="True"
                        Foreground="{TemplateBinding Foreground}" Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconTemplate}" />
    </ControlTemplate>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource LocalOliveDeepBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalMossBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="240" Margin="0,4,0,0" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="MenuDrop" />
                        </Grid.RenderTransform>
                        <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="6,6,9,9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuDropIn">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuPanel" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.75" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuDrop" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="-2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="MenuDropIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
