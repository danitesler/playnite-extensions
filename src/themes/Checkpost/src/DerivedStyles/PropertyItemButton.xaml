<!--
    Checkpost: PropertyItemButton. Values only appear inside the metadata permit sheet (pink paper LocalPaperPinkBrush, edge
    LocalPaperEdgeBrush, ink LocalPaperInkBrush), so every colour here is a paper colour.
    Link (default): permit ink text with a 1px dotted underline in the paper edge colour (a TextDecoration with a 1 on 2 off dash,
    so a wrapped value is underlined line by line); on hover the text turns seal red and the underline goes solid in the same red.
    Chip (the owning ItemsControl has Tag Chip): a field box, an outlined box with a 1px paper-edge border and a lit pink fill,
    13px ink text, padding 8,1,8,2, 1px corners; on hover the box fills with ink and the text turns pink (the box is the whole
    hit area). Static setters only, nothing blurs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource LocalPaperInkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <!-- The underline is a TextDecoration written inline, so each value gets its own pen (a shared resource pen with a
                             DynamicResource brush resolved to nothing once two values used it). A 1px line, 1px dots on a 3px pitch, in the
                             paper edge colour (the ledger's dotted rule); it follows a wrapped value line by line. Hover swaps it for the
                             plain underline, which is drawn in the text's own (red) colour. -->
                        <TextBlock x:Name="Value" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                   TextWrapping="Wrap">
                            <TextBlock.TextDecorations>
                                <TextDecorationCollection>
                                    <TextDecoration Location="Underline" PenOffset="1" PenOffsetUnit="Pixel" PenThicknessUnit="Pixel">
                                        <TextDecoration.Pen>
                                            <Pen Thickness="1" Brush="{DynamicResource LocalPaperEdgeBrush}">
                                                <Pen.DashStyle>
                                                    <DashStyle Dashes="1 2" />
                                                </Pen.DashStyle>
                                            </Pen>
                                        </TextDecoration.Pen>
                                    </TextDecoration>
                                </TextDecorationCollection>
                            </TextBlock.TextDecorations>
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Value" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LocalRedBrush}" />
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalPaperInkBrush}" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ChipBox" MinHeight="22" Padding="8,1,8,2" SnapsToDevicePixels="True"
                                    Background="{DynamicResource LocalPaperPinkLitBrush}" BorderBrush="{DynamicResource LocalPaperEdgeBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}">
                                <TextBlock x:Name="ChipText" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipBox" Property="Background" Value="{DynamicResource LocalPaperInkBrush}" />
                                    <Setter TargetName="ChipBox" Property="BorderBrush" Value="{DynamicResource LocalPaperInkBrush}" />
                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource LocalPaperPinkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource LocalPaperSoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
