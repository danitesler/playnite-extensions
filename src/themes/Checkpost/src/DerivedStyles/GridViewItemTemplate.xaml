<!--
    Checkpost: cover content. Parts from Playnite Default 10.60: PART_PanelHost, PART_ImageCover, PART_ButtonPlay, PART_ButtonInfo;
    the empty-cover name, the under-cover name and the darken-uninstalled rules are kept.
    Brushes: ExpanderBackgroundBrush and SlotBorderBrush (the empty slot), ScrimBrush (shades), LocalCreamBrush (glyphs), the stamp
    brushes (Play) and the olive brushes (Info).
    The cover is a flat card: art, its slot background and both shades are clipped by one OpacityMask to a 2px radius, so the corners
    stay clear and the library behind shows through. The tile buttons sit above the mask, outside it, so they animate over a stable
    layer. A cover with no image is a slot with a 2px rim and the name in Pixelify Sans 17px.
    Hover, in whole-pixel steps: the shade steps in (two frames); the Play and Info stamps drop in one after the other, Info 60ms after
    Play, each stepping down from 4px above (-4, -2, 0); leaving steps the shade and the stamps out in 80ms and hides the panel at the
    end (FillBehavior Stop).
    GridTileButton is a 50x50 plate: a flat face over a 3px ledge, 2px corners, a 32px pixel glyph (2x the 16-unit grid). Play is the
    stamp-green face with IconPlay; Info (Tag Info) is the olive face with IconInfo. Hover lifts the face 2px in two steps (named
    TranslateTransform Lift), lights the face and turns the glyph lime; a press drops the face onto the ledge. The whole square is
    the hit area.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="GridTileButton" TargetType="Button">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalStampLedgeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LocalCreamBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <!-- The hard ledge, then the face over it. The face lifts with Lift and drops onto the ledge when pressed. -->
                        <Border x:Name="Ledge" Margin="0,3,0,0" Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <Grid x:Name="Face" Margin="0,0,0,3" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="Lift" Y="0" />
                            </Grid.RenderTransform>
                            <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LocalStampLitBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border x:Name="HoverPlate" Visibility="Collapsed" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Viewbox Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentControl x:Name="Glyph" Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}"
                                                Foreground="{TemplateBinding Foreground}" Focusable="False" IsTabStop="False" />
                            </Viewbox>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Info">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource LocalMossDeepBrush}" />
                            <Setter TargetName="HoverPlate" Property="Background" Value="{DynamicResource LocalOliveLitBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource LocalLimeBrush}" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="TileHoverOut" />
                                <BeginStoryboard Name="TileHoverIn">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="-1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="-2" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="TileHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="-1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="TileHoverIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Press: the face drops onto the ledge (the margin; the lift is cancelled while it is down). -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="0,3,0,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="TilePressIn">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="TilePressIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Info is the olive plate on a black ledge, with a cream glyph. -->
            <Trigger Property="Tag" Value="Info">
                <Setter Property="Background" Value="{DynamicResource LocalOliveBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalEdgeBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalCreamBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="{DynamicResource GridItemBackgroundBrush}" CornerRadius="2">
                        <StackPanel Name="PART_PanelHost"
                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                            <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}">
                                <!-- Flat cover and shades: one mask. The tile buttons stay outside it. -->
                                <Grid x:Name="CoverHost" ClipToBounds="True">
                                    <Grid.OpacityMask>
                                        <VisualBrush Stretch="Fill">
                                            <VisualBrush.Visual>
                                                <Border Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}" CornerRadius="2" Background="Black" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Grid.OpacityMask>
                                    <Border x:Name="CoverBlob" Background="{DynamicResource ExpanderBackgroundBrush}" />
                                    <Image Name="PART_ImageCover"
                                           RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Stretch="{Settings CoverArtStretch}" />
                                    <Grid x:Name="TextGameName" Visibility="Collapsed">
                                        <TextBlock Text="{Binding DisplayName}" FontFamily="{DynamicResource LocalDisplayFontFamily}" FontSize="17"
                                                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="10"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <!-- Darken uninstalled (static) and the hover shade (stepped) are separate layers. -->
                                    <Border x:Name="BorderUninstalled" Background="{DynamicResource ScrimBrush}" Opacity="0.62" Visibility="Collapsed" />
                                    <Border x:Name="BorderMouseOver" Background="{DynamicResource ScrimBrush}" Opacity="0" />
                                </Grid>
                                <!-- The empty slot's rim, in the same card shape. -->
                                <Border x:Name="CoverRim" Visibility="Collapsed" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="2"
                                        CornerRadius="2" IsHitTestVisible="False" />
                                <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" StretchDirection="DownOnly" MaxWidth="190"
                                         Name="GameControls" Visibility="Hidden">
                                    <StackPanel Orientation="Horizontal" Margin="8">
                                        <Button Name="PART_ButtonPlay" Style="{StaticResource GridTileButton}" Margin="0,0,8,0"
                                                Content="{DynamicResource IconPlay}" Opacity="0">
                                            <Button.RenderTransform>
                                                <TranslateTransform x:Name="PlayRise" Y="-4" />
                                            </Button.RenderTransform>
                                        </Button>
                                        <Button Name="PART_ButtonInfo" Style="{StaticResource GridTileButton}" Tag="Info" Margin="0"
                                                Content="{DynamicResource IconInfo}" Opacity="0">
                                            <Button.RenderTransform>
                                                <TranslateTransform x:Name="InfoRise" Y="-4" />
                                            </Button.RenderTransform>
                                        </Button>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Padding="2,5,2,5" Grid.Row="1" Grid.Column="0"
                                       Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="{DynamicResource IconDownload}" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderUninstalled" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" TargetName="CoverRim" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.28" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="0.55" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <!-- Play drops in first: visible at once, stepping down from 4px above. -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayRise" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="-2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <!-- Info follows 60ms later. -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InfoRise" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="-2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.14" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.28" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PlayRise" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="-4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="InfoRise" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="-4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
