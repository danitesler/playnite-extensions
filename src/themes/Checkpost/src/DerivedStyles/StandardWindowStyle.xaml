<!--
    Checkpost: StandardWindowStyle. Every dialog and the Settings window: the report screen's header as a 44px booth-metal band (LocalDeskBrush) closed by a 2px
    LocalOliveDeepBrush rule. Left to right: the stamp mark in a 28px olive plate, a 1px moss-deep hairline, the olive DAY tab (stepped 5px cut corners) holding the
    title in uppercase Pixelify Sans 19px, a second hairline, then the caption buttons (WindowBarButton, 46px, bare; close is red). CaptionHeight 44 equals the
    content's top margin. PART_TextTitle stays inside a collapsed parent: Playnite sets its Text and it must never draw by itself (the visible tab reads it).
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource NormalBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource LocalDeskBrush}" ClipToBounds="True">
                                    <!-- The band's closing rule: 2px olive-deep. -->
                                    <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource LocalOliveDeepBrush}" IsHitTestVisible="False" />
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The stamp mark on a 28px olive plate with a 3px olive-deep lower edge. -->
                                        <Grid Grid.Column="0" Width="28" Height="28" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                            <Border Background="{DynamicResource LocalOliveDeepBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                                            <Border Margin="0,0,0,3" Background="{DynamicResource LocalOliveBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                                            <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource LocalCreamBrush}" Width="16" Height="16" Margin="0,0,0,3"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                        </Grid>
                                        <Border x:Name="HairLeft" Grid.Column="1" Height="1" Margin="12,0,12,0" VerticalAlignment="Center" Background="{DynamicResource LocalMossDeepBrush}" IsHitTestVisible="False" />
                                        <!-- The DAY tab: olive plate, corners cut in two pixel steps (no wide shapes, the tab is as wide as its title). -->
                                        <Grid x:Name="TitleTab" Grid.Column="2" Height="28" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                            <Border Margin="4,0,4,0" Background="{DynamicResource LocalOliveBrush}" />
                                            <Border Width="2" Margin="2,2,0,2" HorizontalAlignment="Left" Background="{DynamicResource LocalOliveBrush}" />
                                            <Border Width="2" Margin="0,4,0,4" HorizontalAlignment="Left" Background="{DynamicResource LocalOliveBrush}" />
                                            <Border Width="2" Margin="0,2,2,2" HorizontalAlignment="Right" Background="{DynamicResource LocalOliveBrush}" />
                                            <Border Width="2" Margin="0,4,0,4" HorizontalAlignment="Right" Background="{DynamicResource LocalOliveBrush}" />
                                            <!-- The title lives here only as Playnite's text holder (hidden in a collapsed parent); the visible copy reads its Text. -->
                                            <Border Visibility="Collapsed" Width="0" Height="0" Opacity="0">
                                                <TextBlock Text="{TemplateBinding Title}" Foreground="Transparent" x:Name="PART_TextTitle" />
                                            </Border>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextTitle, Converter={StaticResource StringToUpperCaseConverter}}" FontFamily="{DynamicResource LocalDisplayFontFamily}" FontSize="19"
                                                       Foreground="{DynamicResource TextBrush}" Margin="22,0,22,1" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                        </Grid>
                                        <Border x:Name="HairRight" Grid.Column="3" Height="1" Margin="12,0,12,0" VerticalAlignment="Center" Background="{DynamicResource LocalMossDeepBrush}" IsHitTestVisible="False" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="2,0,0,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <!-- A dialog with no title shows no empty tab: the two hairlines meet into one rule. -->
                        <DataTrigger Binding="{Binding Text, ElementName=PART_TextTitle}" Value="">
                            <Setter TargetName="TitleTab" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HairLeft" Property="Margin" Value="12,0,0,0" />
                            <Setter TargetName="HairRight" Property="Margin" Value="0,0,12,0" />
                        </DataTrigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource LocalDeskEdgeBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
