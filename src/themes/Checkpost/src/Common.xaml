<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Checkpost shared pieces, drawn from Papers, Please's report screens, stamp bar and documents (RESEARCH.md, BRIEF.md).
        Every plate is a flat face over a hard ledge (the face's Margin leaves the ledge showing at the bottom), the corners are
        2px pixel steps, rules are one-pixel dotted lines; no blur, no DropShadowEffect. A pressed plate drops onto its ledge.
          LocalLedge2Template / LocalLedge3Template / LocalLedge4Template
                                plate: Background = face, BorderBrush = ledge colour, ControlCornerRadius corners
          LocalWellTemplate     recessed well: Background fill with a 2px BorderBrush strip along the top edge (inputs, cells)
          LocalPanelTemplate    olive panel: Background body, BorderBrush rim 2px, a 3px LocalVoidBrush hard shadow under it
          LocalSlipTemplate     paper slip: Background = paper, BorderBrush = the 2px lower edge, Foreground = the three punched dots
          LocalDotsTemplate     three 4px squares in the host's Foreground, the last at 35% (the typewriter dots of the running mark)
          LocalPointerTemplate / LocalPointerRightTemplate  pixel triangle (down / right), Foreground fill
          LocalSealTemplate     the red seal octagon, Foreground fill
          DividerTemplate       dotted rule (the ledger total line): 1px tall, 1px dots on a 3px pitch, LocalMossBrush
          BrandMarkTemplate     the rubber-stamp mark, Foreground fill
          LocalBulletinTemplate the empty-page sheet: cream paper, hatched text blocks, a caret that blinks while visible
        Hosts are plain Controls behind the content (IsHitTestVisible False).
    -->
    <ControlTemplate x:Key="LocalLedge2Template" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="0,0,0,2" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalLedge3Template" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="0,0,0,3" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalLedge4Template" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="0,0,0,4" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalWellTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Height="2" VerticalAlignment="Top" Background="{TemplateBinding BorderBrush}" CornerRadius="2,2,0,0" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalPanelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource LocalVoidBrush}" CornerRadius="{DynamicResource CornerRadiusLarge}" />
            <Border Margin="0,0,0,3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="{DynamicResource CornerRadiusLarge}" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalSlipTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
            <Border Margin="0,0,0,2" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
            <StackPanel Margin="6,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Rectangle Width="3" Height="3" Fill="{TemplateBinding Foreground}" />
                <Rectangle Width="3" Height="3" Margin="0,3,0,0" Fill="{TemplateBinding Foreground}" />
                <Rectangle Width="3" Height="3" Margin="0,3,0,0" Fill="{TemplateBinding Foreground}" />
            </StackPanel>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalDotsTemplate" TargetType="{x:Type Control}">
        <StackPanel IsHitTestVisible="False" Orientation="Horizontal" SnapsToDevicePixels="True">
            <Rectangle Width="4" Height="4" Fill="{TemplateBinding Foreground}" />
            <Rectangle Width="4" Height="4" Margin="3,0,0,0" Fill="{TemplateBinding Foreground}" />
            <Rectangle Width="4" Height="4" Margin="3,0,0,0" Fill="{TemplateBinding Foreground}" Opacity="0.35" />
        </StackPanel>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalPointerTemplate" TargetType="{x:Type Control}">
        <Viewbox IsHitTestVisible="False" Stretch="Uniform">
            <Canvas Width="16" Height="16">
                <Path Data="{DynamicResource LocalPointerGeometry}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalPointerRightTemplate" TargetType="{x:Type Control}">
        <Viewbox IsHitTestVisible="False" Stretch="Uniform">
            <Canvas Width="16" Height="16">
                <Path Data="{DynamicResource LocalPointerGeometry}" Fill="{TemplateBinding Foreground}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="-90" CenterX="8" CenterY="8" />
                    </Path.RenderTransform>
                </Path>
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalSealTemplate" TargetType="{x:Type Control}">
        <Viewbox IsHitTestVisible="False" Stretch="Uniform">
            <Canvas Width="16" Height="16">
                <Path Data="{DynamicResource LocalSealGeometry}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <!-- Group break (metadata, details groups) and menu rules: a dotted line, 1px tall, 1px dots on a 3px pitch. No wide children: the tile is a brush. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Border IsHitTestVisible="False" Height="1" SnapsToDevicePixels="True">
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,3,1" ViewportUnits="Absolute" Viewbox="0,0,3,1" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="{DynamicResource LocalMossBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,1" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>
    </ControlTemplate>
    <!-- The same dotted rule in the permit's taupe, for the metadata sheet's group breaks (paper, not void). -->
    <ControlTemplate x:Key="LocalPaperDividerTemplate" TargetType="Control">
        <Border IsHitTestVisible="False" Height="1" SnapsToDevicePixels="True">
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,3,1" ViewportUnits="Absolute" Viewbox="0,0,3,1" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="{DynamicResource LocalPaperEdgeBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,1" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>
    </ControlTemplate>
    <!-- The brand mark: a rubber stamp seen from the front, over two dotted impressions. Foreground fill. -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox IsHitTestVisible="False" Stretch="Uniform">
            <Canvas Width="16" Height="16">
                <Path Data="{DynamicResource LocalMarkGeometry}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <!-- Headings are Pathway Gothic One (narrow caps in the game's bulletin headlines), set 17px and up. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>
    <!-- Keyboard focus: a dotted 1px frame 3px outside the control (the game's dotted rules, lit). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" IsHitTestVisible="False" SnapsToDevicePixels="True" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1" StrokeDashArray="1 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Component spacing: 30px menu rows, 32px fields and buttons (a 3px ledge counts inside the 32px), 2px rims eat one pixel of vertical padding. -->
    <Thickness x:Key="ButtonPadding">16,5,16,5</Thickness> <!-- Button: ghost word on a dotted line, olive plate on hover -->
    <Thickness x:Key="InputPadding">10,5,10,5</Thickness> <!-- Text box, password box; 32px with ControlHeight -->
    <Thickness x:Key="MenuPadding">4</Thickness> <!-- Menu panel inset: 2px rim plus 4px, rows 30px -->
    <Thickness x:Key="MenuItemPadding">6,5,8,5</Thickness> <!-- Menu item: 30px row -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness> <!-- Dropdown board inset -->
    <Thickness x:Key="ComboBoxItemPadding">10,5,8,5</Thickness> <!-- Dropdown row -->
    <Thickness x:Key="ListBoxItemPadding">10,5,10,5</Thickness> <!-- List box item -->
    <Thickness x:Key="GroupBoxPadding">14,12,14,12</Thickness> <!-- Olive panel body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness> <!-- Gap under the panel's DAY-tab title -->
    <Thickness x:Key="TooltipPadding">10,5,10,6</Thickness> <!-- Tooltip slip -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double> <!-- Top bar and sidebar icons -->
    <sys:Double x:Key="GameBannerHeight">224</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         stepped void bands. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Both views start on the right. Center and Stretch flow above media. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->
    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, cut by 16px gutters, so the real carousel replaces it without the page jumping.
         Each Viewbox scales a fixed 1600px layout to the width its column gives it. The tiles are the host's Foreground at
         low opacity; the whole thing pulses while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,6,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.45" Value="0.7" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.9" Value="0.45" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1.35" Value="0.7" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- More / Edit: olive squares on a hard 3px ledge. Hover lifts the face in two 1px steps and lights the glyph lime; pressed it drops onto its
         ledge. Background = face, BorderBrush = ledge, Foreground = glyph. -->
    <Style x:Key="LocalGameActionSocket" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource LocalOliveDeepBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalEdgeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LocalTextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Ledge" Margin="0,3,0,0" IsHitTestVisible="False" Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Grid x:Name="FaceHost" Margin="0,0,0,3" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="Lift" />
                            </Grid.RenderTransform>
                            <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LocalMossDeepBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource LocalOliveBrush}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource LocalLimeBrush}" />
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource LocalLimeBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ActionHoverIn"><Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="-1" />
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="-2" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ActionHoverOut"><Storyboard>
                                    <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="-1" />
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="FaceHost" Property="Margin" Value="0,3,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LocalGameActionEditSocket" TargetType="{x:Type Button}" BasedOn="{StaticResource LocalGameActionSocket}">
        <Setter Property="Background" Value="{DynamicResource LocalOliveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalEdgeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LocalTextBrush}" />
    </Style>
    <!-- Empty game page: the Official Bulletin. A cream sheet (210x250) with a header rule, a block headline, hatched text blocks and a
         red seal stamped in the corner; an ink caret after the headline blinks in whole steps while the host is visible (removed on exit). -->
    <ControlTemplate x:Key="LocalBulletinTemplate" TargetType="{x:Type Control}">
        <Grid Width="210" Height="250" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Margin="0,0,0,3" Background="{DynamicResource LocalCreamBrush}" CornerRadius="1" />
            <Border Height="3" VerticalAlignment="Bottom" Background="{DynamicResource LocalMossBrush}" CornerRadius="0,0,1,1" />
            <StackPanel Margin="16,16,16,19" Opacity="0.9">
                <Rectangle Height="2" Fill="{DynamicResource LocalInkBrush}" />
                <Rectangle Height="4" Margin="0,3,0,0" Fill="{DynamicResource LocalInkSoftBrush}" Opacity="0.35" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Rectangle Width="112" Height="12" Fill="{DynamicResource LocalInkBrush}" />
                    <Rectangle x:Name="BulletinCaret" Width="6" Height="12" Margin="4,0,0,0" Fill="{DynamicResource LocalInkBrush}" />
                </StackPanel>
                <Rectangle Width="84" Height="6" Margin="0,5,0,0" HorizontalAlignment="Left" Fill="{DynamicResource LocalInkSoftBrush}" />
                <Rectangle Height="4" Margin="0,16,0,0" Fill="{DynamicResource LocalInkSoftBrush}" Opacity="0.35" />
                <Rectangle Height="4" Margin="0,4,0,0" Fill="{DynamicResource LocalInkSoftBrush}" Opacity="0.35" />
                <Rectangle Width="150" Height="4" Margin="0,4,0,0" HorizontalAlignment="Left" Fill="{DynamicResource LocalInkSoftBrush}" Opacity="0.35" />
                <Rectangle Height="4" Margin="0,12,0,0" Fill="{DynamicResource LocalInkSoftBrush}" Opacity="0.35" />
                <Rectangle Height="4" Margin="0,4,0,0" Fill="{DynamicResource LocalInkSoftBrush}" Opacity="0.35" />
                <Rectangle Height="4" Margin="0,4,0,0" Fill="{DynamicResource LocalInkSoftBrush}" Opacity="0.35" />
                <Rectangle Width="120" Height="4" Margin="0,4,0,0" HorizontalAlignment="Left" Fill="{DynamicResource LocalInkSoftBrush}" Opacity="0.35" />
            </StackPanel>
            <Control Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,26" Focusable="False" IsTabStop="False"
                     Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource LocalSealBrush}" Opacity="0.85" RenderTransformOrigin="0.5,0.5">
                <Control.RenderTransform>
                    <RotateTransform Angle="-12" />
                </Control.RenderTransform>
            </Control>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BulletinBlinkStory">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BulletinCaret" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="BulletinBlinkStory" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>
</ResourceDictionary>
