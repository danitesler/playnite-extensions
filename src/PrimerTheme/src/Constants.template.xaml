<!--
    Primer Theme: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from tokens.css
    (Primer's functional CSS variables) and writes the result to the build as Constants.xaml.

    Keys are Primer's token names in Pascal case: bgColor-default is PrimerBgColorDefaultColor /
    PrimerBgColorDefaultBrush, control-transparent-bgColor-hover is PrimerControlTransparentBgColorHover,
    borderRadius-medium is PrimerBorderRadiusMedium. Translucent tokens (control-transparent-*, bgColor-accent-muted)
    keep their alpha, as in Primer; popup edges are flattened onto the overlay, because WPF popups are layered windows.

    Theme XAML reads these keys with DynamicResource only: Playnite parses each theme file on its own before merging.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). fontStack-sansSerif resolves to Segoe UI on Windows; Mona Sans is not bundled. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys) -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:borderRadius-medium}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- borderRadius-* -->
    <CornerRadius x:Key="PrimerBorderRadiusSmall">{{px:borderRadius-small}}</CornerRadius>
    <CornerRadius x:Key="PrimerBorderRadiusMedium">{{px:borderRadius-medium}}</CornerRadius>
    <CornerRadius x:Key="PrimerBorderRadiusLarge">{{px:borderRadius-large}}</CornerRadius>
    <CornerRadius x:Key="PrimerBorderRadiusFull">9999</CornerRadius>

    <!-- Functional colors -->
    <Color x:Key="PrimerBgColorDefaultColor">{{bgColor-default}}</Color>
    <Color x:Key="PrimerBgColorMutedColor">{{bgColor-muted}}</Color>
    <Color x:Key="PrimerBgColorInsetColor">{{bgColor-inset}}</Color>
    <Color x:Key="PrimerBgColorAccentEmphasisColor">{{bgColor-accent-emphasis}}</Color>
    <Color x:Key="PrimerBgColorAccentMutedColor">{{bgColor-accent-muted}}</Color>
    <Color x:Key="PrimerFgColorDefaultColor">{{fgColor-default}}</Color>
    <Color x:Key="PrimerFgColorMutedColor">{{fgColor-muted}}</Color>
    <Color x:Key="PrimerFgColorAccentColor">{{fgColor-accent}}</Color>
    <Color x:Key="PrimerFgColorOnEmphasisColor">{{fgColor-onEmphasis}}</Color>
    <Color x:Key="PrimerFgColorDangerColor">{{fgColor-danger}}</Color>
    <Color x:Key="PrimerBorderColorDefaultColor">{{borderColor-default}}</Color>
    <Color x:Key="PrimerBorderColorMutedColor">{{borderColor-muted}}</Color>
    <Color x:Key="PrimerBorderColorEmphasisColor">{{borderColor-emphasis}}</Color>
    <Color x:Key="PrimerFocusOutlineColorColor">{{focus-outlineColor}}</Color>
    <Color x:Key="PrimerOverlayBgColorColor">{{overlay-bgColor}}</Color>

    <!-- Component tokens -->
    <Color x:Key="PrimerControlBgColorRestColor">{{control-bgColor-rest}}</Color>
    <Color x:Key="PrimerControlBgColorHoverColor">{{control-bgColor-hover}}</Color>
    <Color x:Key="PrimerControlBgColorActiveColor">{{control-bgColor-active}}</Color>
    <Color x:Key="PrimerControlFgColorRestColor">{{control-fgColor-rest}}</Color>
    <Color x:Key="PrimerControlBorderColorRestColor">{{control-borderColor-rest}}</Color>
    <Color x:Key="PrimerControlBorderColorEmphasisColor">{{control-borderColor-emphasis}}</Color>
    <Color x:Key="PrimerControlCheckedBgColorRestColor">{{control-checked-bgColor-rest}}</Color>
    <Color x:Key="PrimerControlCheckedBgColorHoverColor">{{control-checked-bgColor-hover}}</Color>
    <Color x:Key="PrimerControlTransparentBgColorHoverColor">{{control-transparent-bgColor-hover}}</Color>
    <Color x:Key="PrimerControlTransparentBgColorActiveColor">{{control-transparent-bgColor-active}}</Color>
    <Color x:Key="PrimerControlTransparentBgColorSelectedColor">{{control-transparent-bgColor-selected}}</Color>
    <Color x:Key="PrimerControlKnobBgColorRestColor">{{controlKnob-bgColor-rest}}</Color>
    <Color x:Key="PrimerControlKnobBorderColorRestColor">{{controlKnob-borderColor-rest}}</Color>
    <Color x:Key="PrimerButtonPrimaryBgColorRestColor">{{button-primary-bgColor-rest}}</Color>
    <Color x:Key="PrimerButtonPrimaryBgColorHoverColor">{{button-primary-bgColor-hover}}</Color>
    <Color x:Key="PrimerButtonPrimaryFgColorRestColor">{{button-primary-fgColor-rest}}</Color>
    <Color x:Key="PrimerButtonDangerBgColorHoverColor">{{button-danger-bgColor-hover}}</Color>
    <Color x:Key="PrimerButtonDangerFgColorHoverColor">{{button-danger-fgColor-hover}}</Color>
    <Color x:Key="PrimerUnderlineNavBorderColorActiveColor">{{underlineNav-borderColor-active}}</Color>
    <Color x:Key="PrimerTooltipBgColorColor">{{tooltip-bgColor}}</Color>
    <Color x:Key="PrimerTooltipFgColorColor">{{tooltip-fgColor}}</Color>
    <Color x:Key="PrimerProgressBarTrackBgColorColor">{{progressBar-track-bgColor}}</Color>
    <Color x:Key="PrimerProgressBarBgColorSuccessColor">{{progressBar-bgColor-success}}</Color>

    <SolidColorBrush x:Key="PrimerBgColorDefaultBrush" Color="{DynamicResource PrimerBgColorDefaultColor}" />
    <SolidColorBrush x:Key="PrimerBgColorMutedBrush" Color="{DynamicResource PrimerBgColorMutedColor}" />
    <SolidColorBrush x:Key="PrimerBgColorInsetBrush" Color="{DynamicResource PrimerBgColorInsetColor}" />
    <SolidColorBrush x:Key="PrimerBgColorAccentEmphasisBrush" Color="{DynamicResource PrimerBgColorAccentEmphasisColor}" />
    <SolidColorBrush x:Key="PrimerBgColorAccentMutedBrush" Color="{DynamicResource PrimerBgColorAccentMutedColor}" />
    <SolidColorBrush x:Key="PrimerFgColorDefaultBrush" Color="{DynamicResource PrimerFgColorDefaultColor}" />
    <SolidColorBrush x:Key="PrimerFgColorMutedBrush" Color="{DynamicResource PrimerFgColorMutedColor}" />
    <SolidColorBrush x:Key="PrimerFgColorAccentBrush" Color="{DynamicResource PrimerFgColorAccentColor}" />
    <SolidColorBrush x:Key="PrimerFgColorOnEmphasisBrush" Color="{DynamicResource PrimerFgColorOnEmphasisColor}" />
    <SolidColorBrush x:Key="PrimerFgColorDangerBrush" Color="{DynamicResource PrimerFgColorDangerColor}" />
    <SolidColorBrush x:Key="PrimerBorderColorDefaultBrush" Color="{DynamicResource PrimerBorderColorDefaultColor}" />
    <SolidColorBrush x:Key="PrimerBorderColorMutedBrush" Color="{DynamicResource PrimerBorderColorMutedColor}" />
    <SolidColorBrush x:Key="PrimerBorderColorEmphasisBrush" Color="{DynamicResource PrimerBorderColorEmphasisColor}" />
    <SolidColorBrush x:Key="PrimerFocusOutlineColorBrush" Color="{DynamicResource PrimerFocusOutlineColorColor}" />
    <SolidColorBrush x:Key="PrimerOverlayBgColorBrush" Color="{DynamicResource PrimerOverlayBgColorColor}" />
    <SolidColorBrush x:Key="PrimerControlBgColorRestBrush" Color="{DynamicResource PrimerControlBgColorRestColor}" />
    <SolidColorBrush x:Key="PrimerControlBgColorHoverBrush" Color="{DynamicResource PrimerControlBgColorHoverColor}" />
    <SolidColorBrush x:Key="PrimerControlBgColorActiveBrush" Color="{DynamicResource PrimerControlBgColorActiveColor}" />
    <SolidColorBrush x:Key="PrimerControlFgColorRestBrush" Color="{DynamicResource PrimerControlFgColorRestColor}" />
    <SolidColorBrush x:Key="PrimerControlBorderColorRestBrush" Color="{DynamicResource PrimerControlBorderColorRestColor}" />
    <SolidColorBrush x:Key="PrimerControlBorderColorEmphasisBrush" Color="{DynamicResource PrimerControlBorderColorEmphasisColor}" />
    <SolidColorBrush x:Key="PrimerControlCheckedBgColorRestBrush" Color="{DynamicResource PrimerControlCheckedBgColorRestColor}" />
    <SolidColorBrush x:Key="PrimerControlCheckedBgColorHoverBrush" Color="{DynamicResource PrimerControlCheckedBgColorHoverColor}" />
    <SolidColorBrush x:Key="PrimerControlTransparentBgColorHoverBrush" Color="{DynamicResource PrimerControlTransparentBgColorHoverColor}" />
    <SolidColorBrush x:Key="PrimerControlTransparentBgColorActiveBrush" Color="{DynamicResource PrimerControlTransparentBgColorActiveColor}" />
    <SolidColorBrush x:Key="PrimerControlTransparentBgColorSelectedBrush" Color="{DynamicResource PrimerControlTransparentBgColorSelectedColor}" />
    <SolidColorBrush x:Key="PrimerControlKnobBgColorRestBrush" Color="{DynamicResource PrimerControlKnobBgColorRestColor}" />
    <SolidColorBrush x:Key="PrimerControlKnobBorderColorRestBrush" Color="{DynamicResource PrimerControlKnobBorderColorRestColor}" />
    <SolidColorBrush x:Key="PrimerButtonPrimaryBgColorRestBrush" Color="{DynamicResource PrimerButtonPrimaryBgColorRestColor}" />
    <SolidColorBrush x:Key="PrimerButtonPrimaryBgColorHoverBrush" Color="{DynamicResource PrimerButtonPrimaryBgColorHoverColor}" />
    <SolidColorBrush x:Key="PrimerButtonPrimaryFgColorRestBrush" Color="{DynamicResource PrimerButtonPrimaryFgColorRestColor}" />
    <SolidColorBrush x:Key="PrimerButtonDangerBgColorHoverBrush" Color="{DynamicResource PrimerButtonDangerBgColorHoverColor}" />
    <SolidColorBrush x:Key="PrimerButtonDangerFgColorHoverBrush" Color="{DynamicResource PrimerButtonDangerFgColorHoverColor}" />
    <SolidColorBrush x:Key="PrimerUnderlineNavBorderColorActiveBrush" Color="{DynamicResource PrimerUnderlineNavBorderColorActiveColor}" />
    <SolidColorBrush x:Key="PrimerTooltipBgColorBrush" Color="{DynamicResource PrimerTooltipBgColorColor}" />
    <SolidColorBrush x:Key="PrimerTooltipFgColorBrush" Color="{DynamicResource PrimerTooltipFgColorColor}" />
    <SolidColorBrush x:Key="PrimerProgressBarTrackBgColorBrush" Color="{DynamicResource PrimerProgressBarTrackBgColorColor}" />
    <SolidColorBrush x:Key="PrimerProgressBarBgColorSuccessBrush" Color="{DynamicResource PrimerProgressBarBgColorSuccessColor}" />

    <!--
        Playnite palette keys, mapped to Primer's functional tokens. Every Playnite view and control the theme does not
        restyle reads these. Primer has two accents: GlyphColor (selection, checked, links) is the blue
        bgColor-accent-emphasis, paired with fgColor-onEmphasis as TextColorDark; primary buttons are green (button-primary).
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{fgColor-default}}</Color>
    <Color x:Key="TextColorDarker">{{fgColor-muted}}</Color>
    <Color x:Key="TextColorDark">{{fgColor-onEmphasis}}</Color>
    <Color x:Key="MainColor">{{control-bgColor-rest}}</Color>
    <Color x:Key="MainColorDark">{{bgColor-muted}}</Color>
    <Color x:Key="HoverColor">{{control-transparent-bgColor-hover@bgColor-default}}</Color>
    <Color x:Key="GlyphColor">{{bgColor-accent-emphasis}}</Color>
    <Color x:Key="HighlightGlyphColor">{{bgColor-accent-emphasis/50}}</Color>
    <Color x:Key="PopupBackgroundColor">{{overlay-bgColor}}</Color>
    <Color x:Key="PopupBorderColor">{{overlay-borderColor@overlay-bgColor}}</Color>
    <Color x:Key="BackgroundToneColor">{{bgColor-muted}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>     <!-- no frame around covers -->
    <Color x:Key="PanelSeparatorColor">#00000000</Color>         <!-- no lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{borderColor-default}}</Color>
    <Color x:Key="DataChangeNotifColor">{{fgColor-attention}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{DynamicResource PrimerControlBorderColorRestColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource PrimerControlTransparentBgColorHoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{DynamicResource PrimerTooltipBgColorColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource PrimerBgColorMutedColor}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource PrimerBgColorDefaultColor}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{fgColor-success}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{DynamicResource PrimerFgColorDangerColor}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{fgColor-attention}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource PrimerFgColorDangerColor}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{DynamicResource PrimerBgColorMutedColor}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{DynamicResource PrimerBgColorDefaultColor}" />
</ResourceDictionary>
