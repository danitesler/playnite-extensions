<!--
    Primer Theme: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from tokens.css
    (Primer's functional CSS variables) and writes the result to the build as Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo: Playnite's
    palette keys, then shared keys for roles Playnite has none for. Each placeholder names the Primer token that plays
    the role, so Primer's names live in tokens.css and here only. Theme XAML reads the brushes (never the Color keys),
    so ThemeModifier edits reach every control.

    Translucent tokens (control-transparent-*) keep their alpha, as in Primer; popup edges are flattened onto the
    overlay, because WPF popups are layered windows.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). fontStack-sansSerif resolves to Segoe UI on Windows; Mona Sans is not bundled. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys). ControlCornerRadius is the medium step of the radius scale. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:borderRadius-medium}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale: borderRadius-small / -large / -full (topic tags, the 2em pill) -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:borderRadius-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:borderRadius-large}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        Primer has two accents: GlyphColor (selection, checked, links) is the blue bgColor-accent-emphasis, paired with
        fgColor-onEmphasis as TextColorDark; primary buttons are green (PrimaryButton* below).
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{fgColor-default}}</Color>
    <Color x:Key="TextColorDarker">{{fgColor-muted}}</Color>
    <Color x:Key="TextColorDark">{{fgColor-onEmphasis}}</Color>
    <Color x:Key="MainColor">{{control-bgColor-rest}}</Color>
    <Color x:Key="MainColorDark">{{bgColor-muted}}</Color>
    <Color x:Key="HoverColor">{{control-transparent-bgColor-hover@bgColor-default}}</Color>
    <Color x:Key="GlyphColor">{{bgColor-accent-emphasis}}</Color>
    <Color x:Key="HighlightGlyphColor">{{bgColor-accent-emphasis/50}}</Color>
    <Color x:Key="PopupBackgroundColor">{{overlay-bgColor}}</Color>
    <Color x:Key="PopupBorderColor">{{overlay-borderColor@overlay-bgColor}}</Color>
    <Color x:Key="BackgroundToneColor">{{bgColor-muted}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>     <!-- no frame around covers -->
    <Color x:Key="PanelSeparatorColor">#00000000</Color>         <!-- no lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{borderColor-default}}</Color>
    <Color x:Key="DataChangeNotifColor">{{fgColor-attention}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{control-borderColor-rest}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{{control-transparent-bgColor-hover}}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{tooltip-bgColor}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{control-bgColor-rest}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{bgColor-default}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{fgColor-success}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{fgColor-danger}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{fgColor-attention}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{fgColor-danger}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{bgColor-muted}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{bgColor-default}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell: GitHub's dark header band across the window -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{bgColor-inset}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{bgColor-inset}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{control-transparent-bgColor-selected}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{focus-outlineColor}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{button-danger-bgColor-hover}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{button-danger-fgColor-hover}}" />

    <!-- Buttons: Button default (control-*), Button primary (button-primary-*) -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{control-fgColor-rest}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{control-bgColor-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{control-bgColor-active}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{button-primary-bgColor-rest}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{button-primary-bgColor-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{button-primary-fgColor-rest}}" />

    <!-- Inputs: TextInput -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{bgColor-default}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{control-borderColor-emphasis}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{control-transparent-bgColor-hover}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{controlKnob-bgColor-rest}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{fgColor-muted}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{progressBar-bgColor-success}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{progressBar-track-bgColor}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{borderColor-default}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{fgColor-muted}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{borderColor-default}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{fgColor-muted}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{underlineNav-borderColor-active}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{borderColor-emphasis}}" />
    <!-- topic-tag: bgColor-accent-muted fill and fgColor-accent text; hover bgColor-accent-emphasis with fgColor-onEmphasis -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{bgColor-accent-muted}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{fgColor-accent}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{bgColor-accent-emphasis}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{borderColor-muted}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{tooltip-fgColor}}" />
</ResourceDictionary>
