<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml.
    Primer Box (GitHub's bordered box, as on settings pages): 1px borderColor-default edge, borderRadius-medium,
    page background; the header is a Box-header row (bgColor-muted, 16px padding, 1px borderColor-default line under
    it) with the title at fontWeight semibold; the body has 16px padding (PrimerBoxPadding). Without a header the
    body sits directly in the box.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource PrimerFgColorDefaultBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimerBorderColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource PrimerBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="{DynamicResource PrimerBorderRadiusMedium}">
                        <DockPanel>
                            <Border x:Name="Header" DockPanel.Dock="Top" SnapsToDevicePixels="True"
                                    Background="{DynamicResource PrimerBgColorMutedBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"
                                    CornerRadius="5,5,0,0"
                                    Padding="{DynamicResource PrimerBoxHeaderPadding}">
                                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                           Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </TextBlock>
                            </Border>
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                              Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Header" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
