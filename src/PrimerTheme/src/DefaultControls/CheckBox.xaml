<!--
    Overlay on Playnite Default/DefaultControls/CheckBox.xaml.
    Primer Checkbox: 16px, bgColor-default fill, 1px control-borderColor-emphasis edge, borderRadius-small; checked
    and indeterminate fill with control-checked-bgColor-rest and draw Primer's own 12x9 mark (or the 10x2 dash) in
    fgColor-onEmphasis. The label sits 8px away. Keyboard focus is the 2px focus outline 2px outside the box.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimerFgColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimerControlBorderColorEmphasisBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource PrimerFocusOutlineOffset}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Border x:Name="Box" DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center"
                                    CornerRadius="{DynamicResource PrimerBorderRadiusSmall}" SnapsToDevicePixels="True"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Background="{DynamicResource CheckBoxCheckMarkBkBrush}">
                                <Grid>
                                    <Path x:Name="CheckIcon" Visibility="Collapsed" Width="10.5" Height="8" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="{DynamicResource PrimerFgColorOnEmphasisBrush}"
                                          Data="F0 M11.78,0.22 a0.75,0.75 0 0 1 0,1.061 L4.52,8.541 a0.75,0.75 0 0 1 -1.062,0 L0.202,5.285 a0.75,0.75 0 0 1 1.061,-1.061 l2.725,2.723 L10.718,0.22 a0.75,0.75 0 0 1 1.062,0 Z" />
                                    <Path x:Name="IndeterminateIcon" Visibility="Collapsed" Width="8" Height="1.6" Stretch="Fill"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="{DynamicResource PrimerFgColorOnEmphasisBrush}"
                                          Data="F0 M0,1 a1,1 0 0 1 1,-1 h8 a1,1 0 1 1 0,2 H1 a1,1 0 0 1 -1,-1 Z" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="Label" DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="8,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter Property="Margin" Value="0" TargetName="Label" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon" />
                            <Setter Property="Background" Value="{DynamicResource PrimerControlCheckedBgColorRestBrush}" TargetName="Box" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimerControlCheckedBgColorRestBrush}" TargetName="Box" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Setter Property="Background" Value="{DynamicResource PrimerControlCheckedBgColorRestBrush}" TargetName="Box" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimerControlCheckedBgColorRestBrush}" TargetName="Box" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
