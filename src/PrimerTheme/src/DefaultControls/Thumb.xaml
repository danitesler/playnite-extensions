<!--
    Overlay on Playnite Default/DefaultControls/Thumb.xaml (thumbs outside scroll bars).
    GitHub's scrollbar thumb, as in DefaultControls/ScrollViewer.xaml: borderColor-default with borderRadius-small
    corners, fgColor-muted on hover and while dragging.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource PrimerBorderColorDefaultBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bar" MinHeight="10" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource PrimerBorderRadiusSmall}"
                            Background="{TemplateBinding Background}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimerFgColorMutedBrush}" TargetName="Bar" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimerFgColorMutedBrush}" TargetName="Bar" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
