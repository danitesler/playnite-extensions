<!--
    Overlay on Playnite Default/DerivedStyles/WindowBarButton.xaml (title bars of dialogs; the main window uses
    PrimerWindowButton in DerivedStyles/MainWindowStyle.xaml).
    Primer IconButton, invisible variant, drawn with octicons (Media.xaml) instead of Marlett: fgColor-muted at rest,
    control-transparent-bgColor-hover behind fgColor-default on hover, borderRadius-medium; close takes the danger
    hover (button-danger-bgColor-hover, button-danger-fgColor-hover). Playnite's window templates set Content to the
    Marlett character ("0" minimize, "1" maximize, "2" restore, "r" close); the template maps it to an icon. The
    buttons stay compact for the 25px title band of dialogs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="WindowBarButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimerFgColorMutedBrush}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="2,0,2,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource PrimerBorderRadiusMedium}">
                        <!-- FontSize carries the icon size. -->
                        <ContentPresenter x:Name="Glyph"
                                          Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{DynamicResource PrimerOcticonWindowClose}"
                                          ContentTemplate="{DynamicResource PrimerOcticonTemplate}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="0">
                            <Setter Property="Content" Value="{DynamicResource PrimerOcticonWindowMinimize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Content" Value="{DynamicResource PrimerOcticonWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Content" Value="{DynamicResource PrimerOcticonWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimerFgColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource PrimerControlTransparentBgColorHoverBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="Content" Value="r" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource PrimerButtonDangerFgColorHoverBrush}" />
                <Setter Property="Background" Value="{DynamicResource PrimerButtonDangerBgColorHoverBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
