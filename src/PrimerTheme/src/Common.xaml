<!--
    Primer kit override of Shadcn/Desktop/Common.xaml (whole file replaced, so PopupBorder is repeated).
    Primer focus: outline 2px solid focus-outlineColor, outline-offset -2px (drawn inside the control edge).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnPopupRadius}" />
    </Style>

    <Style x:Key="ShadcnFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ShadcnRadiusMd}"
                            BorderBrush="{DynamicResource ShadcnRingBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Control metrics for Primer (medium control size, 32px). Kit controls read these with DynamicResource, so each kit
        sets its design system's spacing here instead of replacing whole control files.
    -->
    <Thickness x:Key="ShadcnButtonPadding">12,5,12,5</Thickness> <!-- Button medium: 32px, padding-inline 12px, inside a 1px border -->
    <Thickness x:Key="ShadcnInputPadding">12,5,12,5</Thickness> <!-- TextInput / Select medium: 32px, padding-inline 12px -->
    <CornerRadius x:Key="ShadcnPopupRadius">12</CornerRadius> <!-- Overlay borderRadius-large -->
    <Thickness x:Key="ShadcnMenuPadding">8</Thickness> <!-- ActionMenu overlay: ActionList padding-block 8px, items inset 8px -->
    <Thickness x:Key="ShadcnMenuItemPadding">8,6,8,6</Thickness> <!-- ActionList item: 6px 8px, min-height 32px -->
    <CornerRadius x:Key="ShadcnMenuItemRadius">6</CornerRadius> <!-- ActionList item borderRadius-medium -->
    <Thickness x:Key="ShadcnListItemPadding">8,6,8,6</Thickness> <!-- ActionList item: 6px 8px -->
    <CornerRadius x:Key="ShadcnCardRadius">6</CornerRadius> <!-- Box borderRadius-medium -->
    <Thickness x:Key="ShadcnCardPadding">16</Thickness> <!-- Box / Blankslate padding 16px -->
    <Thickness x:Key="ShadcnCardTitleMargin">0,0,0,16</Thickness> <!-- Box header to body -->
    <sys:Double x:Key="ShadcnIconSize">16</sys:Double> <!-- Octicons 16px -->
    <Thickness x:Key="ShadcnTooltipPadding">8,4,8,4</Thickness> <!-- Tooltip overlay-padding-condensed -->
</ResourceDictionary>
