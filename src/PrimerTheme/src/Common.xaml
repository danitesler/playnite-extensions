<!-- Overlay on Playnite Default/Common.xaml: only restyled keys live here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Overlay: overlay-bgColor, borderRadius-large, and the 1px edge shadow-floating-small starts with. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource PrimerBorderRadiusLarge}" />
    </Style>

    <!-- Primer focus: outline 2px solid focus-outlineColor with outline-offset -2px, drawn inside the control edge.
         WPF shows FocusVisualStyle for keyboard focus only, like :focus-visible. -->
    <Style x:Key="PrimerFocusOutline">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource PrimerBorderRadiusMedium}"
                            BorderBrush="{DynamicResource PrimerFocusOutlineColorBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox and Radio focus: the same 2px focus-outlineColor outline, 2px outside the control (outline-offset 2px). -->
    <Style x:Key="PrimerFocusOutlineOffset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource PrimerBorderRadiusMedium}"
                            BorderBrush="{DynamicResource PrimerFocusOutlineColorBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing at Primer's medium control size (control-medium-*: 32px), named after the component. -->
    <Thickness x:Key="PrimerButtonPadding">12,5,12,5</Thickness> <!-- Button medium: 32px, control-medium-paddingInline-normal 12px, inside a 1px border -->
    <Thickness x:Key="PrimerTextInputPadding">12,5,12,5</Thickness> <!-- TextInput / Select medium: 32px, 12px inline -->
    <Thickness x:Key="PrimerActionListPadding">8</Thickness> <!-- ActionList padding-block 8px; items inset 8px (inset variant) -->
    <Thickness x:Key="PrimerActionListItemPadding">8,6,8,6</Thickness> <!-- ActionList item: control-medium-paddingBlock 6px, -paddingInline-condensed 8px; 32px tall -->
    <Thickness x:Key="PrimerBoxPadding">16</Thickness> <!-- Box body padding 16px -->
    <Thickness x:Key="PrimerBoxHeaderPadding">16</Thickness> <!-- Box-header padding 16px -->
    <sys:Double x:Key="PrimerOcticonSize">16</sys:Double> <!-- Octicons 16px -->
    <Thickness x:Key="PrimerTooltipPadding">8,4,8,4</Thickness> <!-- Tooltip: overlay-paddingBlock-condensed 4px, -paddingInline-condensed 8px -->
</ResourceDictionary>
