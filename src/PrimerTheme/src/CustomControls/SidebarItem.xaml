<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    Primer NavList item, icon only: 32px, borderRadius-medium, 16px octicons in fgColor-muted; hover fills with
    control-transparent-bgColor-hover and turns the icon fgColor-default. The current item keeps that fill and gets
    NavList's current-item bar: 4x24px, fgColor-accent, rounded, 8px outside the item's left edge.
    Library and Statistics use Octicons from Media.xaml. PART_ProgressStatus is kept.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource PrimerFgColorMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid>
                        <Border x:Name="CurrentBar" Width="4" Height="24" Margin="-8,0,0,0" Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource PrimerBorderRadiusMedium}"
                                Background="{DynamicResource PrimerBgColorAccentEmphasisBrush}" />
                        <ProgressBar x:Name="PART_ProgressStatus"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource PrimerControlTransparentBgColorHoverBrush}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <Border Background="{TemplateBinding Background}"
                                Padding="{Binding IconPadding}"
                                CornerRadius="{DynamicResource PrimerBorderRadiusMedium}">
                            <Viewbox x:Name="ItemIcon">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                        </Border>
                        <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                        Width="16" Height="16"
                                        ContentTemplate="{DynamicResource PrimerOcticonTemplate}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CurrentBar" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource PrimerOcticonLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource PrimerOcticonStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="CurrentBar" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="CurrentBar" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimerFgColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource PrimerControlTransparentBgColorHoverBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimerFgColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource PrimerControlTransparentBgColorHoverBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource PrimerFgColorDangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
