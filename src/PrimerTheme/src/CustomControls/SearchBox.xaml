<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    Primer TextInput with a leading visual: the search octicon (16px, fgColor-muted) 12px from the start, the text 8px
    after it; bgColor-default fill, 1px control-borderColor-rest edge, borderRadius-medium, 32px. Keyboard focus draws
    the accent border plus its 1px inset shadow as a 2px focus-outlineColor edge, like DefaultControls/TextBox.xaml.
    The chrome is drawn here around a chromeless text box so hosts can restyle it through Background / BorderBrush /
    BorderThickness / Height (the AppHeader search in Views/TopPanel.xaml).
    Playnite's code hides PART_SeachIcon while the box has focus or text, so it carries the "Search" placeholder;
    the icon itself stays. ShowImage="False" (filter panel fields) drops the icon and the placeholder.
    PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon are Playnite's parts (all three must exist).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource PrimerBgColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimerControlBorderColorRestBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimerFgColorDefaultBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Chrome" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource PrimerBorderRadiusMedium}">
                            <Grid>
                                <ContentControl x:Name="Glyph" Margin="12,0,0,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                                Foreground="{DynamicResource PrimerFgColorMutedBrush}"
                                                ContentTemplate="{DynamicResource SearchTextIconTemplate}" />
                                <TextBlock x:Name="PART_SeachIcon" Margin="36,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource BaseTextBlockStyle}"
                                           Foreground="{DynamicResource PrimerFgColorMutedBrush}"
                                           Text="{DynamicResource LOCSearchLabel}" />
                                <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource PrimerBareTextBox}"
                                         VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                         Padding="34,0,32,0" />
                                <ContentControl x:Name="PART_ClearTextIcon" Margin="0,0,10,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                                Background="Transparent"
                                                Foreground="{DynamicResource PrimerFgColorMutedBrush}"
                                                ContentTemplate="{DynamicResource ClearTextIconTemplate}" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRing" BorderThickness="2" Visibility="Collapsed"
                                IsHitTestVisible="False" SnapsToDevicePixels="True"
                                CornerRadius="{DynamicResource PrimerBorderRadiusMedium}"
                                BorderBrush="{DynamicResource PrimerFocusOutlineColorBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="FocusRing" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glyph" />
                            <Setter Property="Padding" Value="10,0,32,0" TargetName="PART_TextInpuText" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
