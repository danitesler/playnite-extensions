<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    shadcn Input with a leading search icon (the command/search pattern): h-9, px-3, input/30 fill, input border,
    ring border + 3px ring/50 halo while focused. The chrome is drawn here around a chromeless text box so hosts can
    restyle it through Background / BorderBrush / BorderThickness / Height (the top bar search in Views/TopPanel.xaml
    is the filled, borderless variant).
    Playnite's code hides PART_SeachIcon while the box has focus or text, so it carries the "Search" placeholder;
    the search glyph itself stays. ShowImage="False" (filter panel fields) drops the glyph and the placeholder.
    PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon are Playnite's parts (all three must exist).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{DynamicResource ShadcnInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ShadcnFieldBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="FocusRing" Margin="-3" BorderThickness="3" Visibility="Collapsed"
                                IsHitTestVisible="False" SnapsToDevicePixels="True"
                                CornerRadius="{DynamicResource ShadcnRadiusLg}"
                                BorderBrush="{DynamicResource ShadcnRingFocusBrush}" />
                        <Border x:Name="Chrome" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ShadcnFieldRadius}">
                            <Grid>
                                <ContentControl x:Name="Glyph" Margin="12,0,0,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                                                ContentTemplate="{DynamicResource SearchTextIconTemplate}" />
                                <TextBlock x:Name="PART_SeachIcon" Margin="36,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource BaseTextBlockStyle}"
                                           Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                                           Text="{DynamicResource LOCSearchLabel}" />
                                <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource ShadcnBareTextBox}"
                                         VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                         Padding="34,0,32,0" />
                                <ContentControl x:Name="PART_ClearTextIcon" Margin="0,0,10,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                                Background="Transparent"
                                                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                                                ContentTemplate="{DynamicResource ClearTextIconTemplate}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ShadcnRingBrush}" TargetName="Chrome" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FocusRing" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glyph" />
                            <Setter Property="Padding" Value="10,0,32,0" TargetName="PART_TextInpuText" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
