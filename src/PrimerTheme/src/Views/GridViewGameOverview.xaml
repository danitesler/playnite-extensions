<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml (grid mode, side panel).
    GitHub's repository page stacked for a narrow column, as github.com lays it out below its md breakpoint: the header
    (icon and name at fontSize 20 semibold), a row of actions (green primary Play or Install filling the width, More with
    triangle-down, Edit as a 32px IconButton), then the sidebar's BorderGrid sections (Details with links, topic tags and
    octicon rows; Statistics), then the README Box (Description) and the Notes Box. 16px gutters.
    The panel edge follows Playnite's panel settings. Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <DockPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DockPanel.Resources>

                            <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,12,12,0"
                                    Content="r" FontFamily="Marlett"
                                    Style="{DynamicResource SimpleButton}"
                                    Command="{MainViewModel CloseGameSideBarCommand}" />

                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCErrorNoGameSelected}"
                                       Margin="16,24,16,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrushDarker}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <Image x:Name="PART_ImageCover" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="16,0,16,16"
                                       Stretch="Uniform" StretchDirection="Both" MaxHeight="280"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       Tag="{DynamicResource ShowCoverImage}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                    <DataTrigger.Value>
                                                        <sys:Boolean>False</sys:Boolean>
                                                    </DataTrigger.Value>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- Repository header -->
                                <DockPanel DockPanel.Dock="Top" Margin="16,0,16,0">
                                    <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0"
                                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                    <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" />
                                </DockPanel>

                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,16,16,16">
                                    <Grid>
                                        <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                        <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                    </Grid>
                                    <Button x:Name="PART_ButtonMoreActions" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource LOCMoreAction}" VerticalAlignment="Center" />
                                            <ContentPresenter Width="16" Height="16" Margin="4,0,0,0"
                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                              Content="{DynamicResource IconDropDown}"
                                                              ContentTemplate="{DynamicResource IconTemplate}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PART_ButtonEditGame" Width="32" Height="32" Padding="0"
                                             Margin="8,0,0,0" Focusable="False">
                                        <ContentPresenter Width="16" Height="16"
                                                          Content="{DynamicResource IconEdit}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                </StackPanel>

                                <ScrollViewer x:Name="PART_ScrollViewHost"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,0,16,24">
                                        <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,1,0,0"
                                                Margin="0,0,0,16" />

                                        <Grid x:Name="OverviewLayoutGrid" Tag="{DynamicResource OverviewDetailsAsTab}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <TabControl x:Name="OverviewTabs" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                        SelectedIndex="0" VerticalAlignment="Top" Margin="0,0,0,12">
                                                <TabControl.Style>
                                                    <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=OverviewLayoutGrid}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabControl.Style>
                                                <TabItem Header="{DynamicResource LOCGameDescriptionTitle}" />
                                                <TabItem Header="{DynamicResource LOCGameDetails}" />
                                            </TabControl>

                                            <!-- Main column: README and Notes Boxes -->
                                            <StackPanel x:Name="DescriptionPanel" Grid.Row="1" Grid.Column="0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Tag, ElementName=OverviewLayoutGrid}" Value="True" />
                                                                    <Condition Binding="{Binding SelectedIndex, ElementName=OverviewTabs}" Value="1" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <GroupBox x:Name="PART_ElemDescription" Header="{DynamicResource LOCGameDescriptionTitle}">
                                                    <HtmlTextView x:Name="PART_HtmlDescription"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"
                                                                  Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </GroupBox>
                                                <GroupBox Header="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" Margin="0,16,0,0"
                                                          Visibility="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                </GroupBox>
                                                <GroupBox x:Name="PART_ElemNotes" Header="{DynamicResource LOCNotesLabel}" Margin="0,16,0,0">
                                                    <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                             Background="{DynamicResource ControlBackgroundBrush}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" />
                                                </GroupBox>
                                            </StackPanel>

                                            <!-- Sidebar / Details Panel -->
                                            <StackPanel x:Name="DetailsPanel" Grid.Row="1">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Grid.Column" Value="1" />
                                                        <Setter Property="Width" Value="260" />
                                                        <Setter Property="Margin" Value="16,0,0,0" />
                                                        <Setter Property="VerticalAlignment" Value="Top" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=OverviewLayoutGrid}" Value="True">
                                                                <Setter Property="Grid.Column" Value="0" />
                                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                <Setter Property="Width" Value="Auto" />
                                                                <Setter Property="Margin" Value="0" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Tag, ElementName=OverviewLayoutGrid}" Value="True" />
                                                                    <Condition Binding="{Binding SelectedIndex, ElementName=OverviewTabs}" Value="0" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="{DynamicResource LOCGameDetails}" FontSize="{DynamicResource FontSizeLarge}"
                                                           FontWeight="SemiBold" Margin="0,0,0,8" />

                                                <DockPanel x:Name="PART_ElemLinks" Margin="0,8,0,0">
                                                    <ContentPresenter DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top"
                                                                      ToolTip="{DynamicResource LOCLinksLabel}"
                                                                      TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                      Content="{DynamicResource IconLink}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                    <ItemsControl x:Name="PART_ItemsLinks" />
                                                </DockPanel>

                                                <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,16,0,4"
                                                              ToolTip="{DynamicResource LOCGenresLabel}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>

                                                <DockPanel x:Name="PART_ElemPlatform" Margin="0,8,0,0">
                                                    <ContentPresenter DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top"
                                                                      ToolTip="{DynamicResource LOCPlatformTitle}"
                                                                      TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                      Content="{DynamicResource IconPlatform}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                    <ItemsControl x:Name="PART_ItemsPlatforms" />
                                                </DockPanel>
                                                <DockPanel x:Name="PART_ElemDevelopers" Margin="0,8,0,0">
                                                    <ContentPresenter DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top"
                                                                      ToolTip="{DynamicResource LOCDeveloperLabel}"
                                                                      TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                      Content="{DynamicResource IconDeveloper}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                    <ItemsControl x:Name="PART_ItemsDevelopers" />
                                                </DockPanel>
                                                <DockPanel x:Name="PART_ElemPublishers" Margin="0,8,0,0">
                                                    <ContentPresenter DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top"
                                                                      ToolTip="{DynamicResource LOCPublisherLabel}"
                                                                      TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                      Content="{DynamicResource IconPublisher}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                    <ItemsControl x:Name="PART_ItemsPublishers" />
                                                </DockPanel>
                                                <DockPanel x:Name="PART_ElemReleaseDate" Margin="0,8,0,0">
                                                    <ContentPresenter DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top"
                                                                      ToolTip="{DynamicResource LOCGameReleaseDateTitle}"
                                                                      TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                      Content="{DynamicResource IconReleaseDate}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                    <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                </DockPanel>
                                                <DockPanel x:Name="PART_ElemLibrary" Margin="0,8,0,0">
                                                    <ContentPresenter DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top"
                                                                      ToolTip="{DynamicResource LOCGameProviderTitle}"
                                                                      TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                      Content="{DynamicResource IconGameProvider}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                    <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                </DockPanel>

                                                <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,1,0,0"
                                                        Margin="0,16,0,0" Padding="0,16,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{DynamicResource LOCStatistics}" FontSize="{DynamicResource FontSizeLarge}"
                                                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                                                        <DockPanel x:Name="PART_ElemPlayTime" Margin="0,8,0,0">
                                                            <ContentPresenter DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top"
                                                                              ToolTip="{DynamicResource LOCTimePlayed}"
                                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                              Content="{DynamicResource IconPlayTime}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                            <TextBlock x:Name="PART_TextPlayTime" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemLastPlayed" Margin="0,8,0,0">
                                                            <ContentPresenter DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top"
                                                                              ToolTip="{DynamicResource LOCLastPlayed}"
                                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                              Content="{DynamicResource IconLastPlayed}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                            <TextBlock x:Name="PART_TextLastActivity" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemCompletionStatus" Margin="0,8,0,0">
                                                            <ContentPresenter DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top"
                                                                              ToolTip="{DynamicResource LOCCompletionStatus}"
                                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                              Content="{DynamicResource IconCompletionStatus}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                            <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
