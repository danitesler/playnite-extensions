<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    GitHub-style navigation rail on the page color, no border. Its top 64px is painted in the header color and holds
    the three-bars menu button (PART_ElemMainMenu), so the header band spans the window like GitHub's AppHeader.
    Items below are NavList items (CustomControls/SidebarItem.xaml) with 16px gutters.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- IconButton, invisible, medium: 32px, borderRadius-medium, fgColor-muted; also used by Views/TopPanel.xaml. -->
    <Style x:Key="PrimerAppHeaderMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="{DynamicResource PrimerBorderRadiusMedium}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimerFgColorMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimerControlTransparentBgColorHoverBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimerFgColorDefaultBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid x:Name="Root" Background="Transparent" Margin="{TemplateBinding Padding}">
                        <Border x:Name="HeaderBand" Height="64" VerticalAlignment="Top"
                                Background="{DynamicResource PrimerBgColorInsetBrush}" />
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource PrimerAppHeaderMenuButton}"
                                    DockPanel.Dock="Top" Margin="16,16,16,16" HorizontalAlignment="Center">
                                <ContentPresenter Width="16" Height="16" Content="{DynamicResource PrimerOcticonMainMenu}" ContentTemplate="{DynamicResource PrimerOcticonTemplate}" />
                            </Border>

                            <!-- The gutter is the panel's margin, not the ScrollViewer's padding: the scroll presenter
                                 clips, and the current-item bar sits 8px outside the item. -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" Margin="16" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemMainMenu}" Value="Collapsed">
                            <Setter Property="Margin" Value="0,64,0,0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Margin" Value="16,80,16,16" TargetName="PART_ElemMainMenu" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Background" Value="{DynamicResource PrimerBgColorInsetBrush}" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderBand" />
                            <Setter Property="Margin" Value="16,16,8,16" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="8,16,8,16" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Margin" Value="0,0,140,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderBand" />
                            <Setter Property="Margin" Value="16,8,8,8" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="8" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
