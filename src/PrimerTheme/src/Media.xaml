    <!-- Content = one of the geometries above, drawn in the inherited foreground. The host sets the size. -->
    <DataTemplate x:Key="ShadcnIconTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="16" Height="16">
                <Path Data="{Binding}"
                      Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource ShadcnIconSearch}"
                          ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource ShadcnIconClear}"
                          ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>

    <TextBlock x:Key="ExitIcon" Text="&#xef1d;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="AddFavoritesIcon" Text="&#xef25;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="RemoveGameIcon" Text="&#xec53;" FontFamily="{DynamicResource FontIcoFont}" Foreground="{DynamicResource ShadcnDestructiveBrush}"
               FontWeight="Light" />
</ResourceDictionary>
