{
    "_comment": "SVG icon packs for scripts/render-icons.ps1. url placeholders: {ref}, {name}, {variant}, {variantSuffix}, {size}, {folder}. Add a pack by adding an entry; any other pack works ad hoc with -UrlTemplate or -SvgDir.",
    "packs": {
        "octicons": {
            "url": "https://raw.githubusercontent.com/primer/octicons/{ref}/icons/{name}-{size}.svg",
            "ref": "main",
            "size": "16",
            "license": "MIT"
        },
        "lucide": {
            "url": "https://raw.githubusercontent.com/lucide-icons/lucide/{ref}/icons/{name}.svg",
            "ref": "main",
            "license": "ISC"
        },
        "tabler": {
            "url": "https://raw.githubusercontent.com/tabler/tabler-icons/{ref}/icons/{variant}/{name}.svg",
            "ref": "main",
            "variant": "outline",
            "variants": ["outline", "filled"],
            "license": "MIT"
        },
        "heroicons": {
            "url": "https://raw.githubusercontent.com/tailwindlabs/heroicons/{ref}/optimized/{size}/{variant}/{name}.svg",
            "ref": "master",
            "size": "24",
            "variant": "outline",
            "variants": ["outline", "solid"],
            "license": "MIT"
        },
        "phosphor": {
            "url": "https://raw.githubusercontent.com/phosphor-icons/core/{ref}/assets/{variant}/{name}{variantSuffix}.svg",
            "ref": "main",
            "variant": "regular",
            "variants": ["thin", "light", "regular", "bold", "fill", "duotone"],
            "variantSuffix": { "thin": "-thin", "light": "-light", "bold": "-bold", "fill": "-fill", "duotone": "-duotone" },
            "license": "MIT"
        },
        "feather": {
            "url": "https://raw.githubusercontent.com/feathericons/feather/{ref}/icons/{name}.svg",
            "ref": "main",
            "license": "MIT"
        },
        "material-symbols": {
            "url": "https://raw.githubusercontent.com/google/material-design-icons/{ref}/symbols/web/{name}/materialsymbols{variant}/{name}_24px.svg",
            "ref": "master",
            "variant": "outlined",
            "variants": ["outlined", "rounded", "sharp"],
            "license": "Apache-2.0"
        },
        "fluent": {
            "_names": "snake_case names, e.g. arrow_download; {folder} is the Title Case folder (Arrow Download).",
            "url": "https://raw.githubusercontent.com/microsoft/fluentui-system-icons/{ref}/assets/{folder}/SVG/ic_fluent_{name}_{size}_{variant}.svg",
            "ref": "main",
            "size": "20",
            "variant": "regular",
            "variants": ["regular", "filled"],
            "license": "MIT"
        }
    }
}
