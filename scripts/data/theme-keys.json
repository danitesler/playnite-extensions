{
    "description": "Shared resource vocabulary for every theme in this repo. A theme's XAML may define only Playnite's own keys (scripts/data/playnite-theme-api.json) and the keys below. Names follow <Control>[<Variant>][<State>]<Part><Type> with Playnite's control names; general roles drop the control. A key means the same thing in every theme; each theme defines the ones its design uses (required ones always). Descriptions double as the ThemeModifier 'Edit constants' labels.",
    "types": {
        "Brush": ["SolidColorBrush", "LinearGradientBrush"],
        "CornerRadius": ["CornerRadius"],
        "Thickness": ["Thickness"],
        "Double": ["Double"],
        "Style": ["Style"],
        "DataTemplate": ["DataTemplate"],
        "Geometry": ["Geometry"]
    },
    "groups": ["Shell", "States", "Buttons", "Inputs", "Controls", "Popups", "Shape", "Spacing", "Styles", "Icons"],
    "playnitePalette": {
        "TextBrush": "Text and icons",
        "TextBrushDarker": "Secondary text and icons",
        "TextBrushDark": "Text and icons on GlyphBrush (checked marks, selected rows, accent buttons)",
        "GlyphBrush": "Accent: checked, selected, links, slider and progress fill",
        "HighlightGlyphBrush": "Translucent accent",
        "HoverBrush": "Hover fill of navigation items, ghost buttons and rows",
        "NormalBrush": "Control surface",
        "NormalBrushDark": "Darker control surface",
        "NormalBorderBrush": "Control edges (buttons, inputs, check boxes)",
        "ButtonBackgroundBrush": "Button fill",
        "ControlBackgroundBrush": "Transparent control background",
        "CheckBoxCheckMarkBkBrush": "Unchecked check box and radio fill",
        "PopupBackgroundBrush": "Menus, dropdowns, popovers",
        "PopupBorderBrush": "Popup edge",
        "TooltipBackgroundBrush": "Tooltip fill",
        "ExpanderBackgroundBrush": "Cards: group boxes and expanders",
        "WindowBackgourndBrush": "Window and dialog background",
        "WindowPanelSeparatorBrush": "Dividers and card edges",
        "PanelSeparatorBrush": "Lines between library panels",
        "GridItemBackgroundBrush": "Frame behind covers",
        "WarningBrush": "Warnings, errors, the update icon",
        "DataChangeNotifBrush": "Unsaved-change marker",
        "PositiveRatingBrush": "Positive rating",
        "NegativeRatingBrush": "Negative rating",
        "MixedRatingBrush": "Mixed rating"
    },
    "keys": [
        { "key": "ShellBackgroundBrush", "type": "Brush", "group": "Shell", "description": "Main window frame around the sidebar and views, when it differs from the window background" },
        { "key": "ContentBackgroundBrush", "type": "Brush", "group": "Shell", "description": "Content layer the library sits on, over the window background" },
        { "key": "TopPanelBackgroundBrush", "type": "Brush", "group": "Shell", "description": "Top bar band (also the sidebar's top when it continues the band)" },
        { "key": "TopPanelSearchBoxBackgroundBrush", "type": "Brush", "group": "Shell", "description": "Search box in the top bar" },
        { "key": "TopPanelSearchBoxHoverBackgroundBrush", "type": "Brush", "group": "Shell", "description": "Search box in the top bar, hovered" },
        { "key": "MainMenuButtonBackgroundBrush", "type": "Brush", "group": "Shell", "description": "Main menu button fill" },
        { "key": "MainMenuButtonForegroundBrush", "type": "Brush", "group": "Shell", "description": "Main menu button icon" },

        { "key": "SelectedBrush", "type": "Brush", "group": "States", "required": true, "description": "Selected or current item: list rows, navigation item, toggled button" },
        { "key": "SelectedHoverBrush", "type": "Brush", "group": "States", "description": "Selected item under the pointer" },
        { "key": "SelectedForegroundBrush", "type": "Brush", "group": "States", "description": "Text and icon of the selected item" },
        { "key": "ListItemHoverBrush", "type": "Brush", "group": "States", "description": "Hover fill of list rows (list boxes, library details rows)" },
        { "key": "ListItemSelectedBrush", "type": "Brush", "group": "States", "description": "Selected list box item" },
        { "key": "MenuItemHoverBrush", "type": "Brush", "group": "States", "description": "Hover fill of menu and dropdown items" },
        { "key": "FocusBrush", "type": "Brush", "group": "States", "required": true, "description": "Keyboard focus indicator and focused input edge" },
        { "key": "FocusHaloBrush", "type": "Brush", "group": "States", "description": "Translucent ring around a focused input or dragged thumb" },
        { "key": "DangerBrush", "type": "Brush", "group": "States", "required": true, "description": "Destructive fill: close button hover, error badges" },
        { "key": "DangerForegroundBrush", "type": "Brush", "group": "States", "required": true, "description": "Text and icons on DangerBrush" },

        { "key": "ButtonForegroundBrush", "type": "Brush", "group": "Buttons", "description": "Button text, when it is not the text color" },
        { "key": "ButtonHoverBackgroundBrush", "type": "Brush", "group": "Buttons", "required": true, "description": "Button hovered" },
        { "key": "ButtonPressedBackgroundBrush", "type": "Brush", "group": "Buttons", "required": true, "description": "Button pressed" },
        { "key": "ButtonBorderBrush", "type": "Brush", "group": "Buttons", "description": "Outlined button edge, when it is not the control edge" },
        { "key": "PrimaryButtonBackgroundBrush", "type": "Brush", "group": "Buttons", "description": "Default button and Play, when not the accent" },
        { "key": "PrimaryButtonHoverBackgroundBrush", "type": "Brush", "group": "Buttons", "required": true, "description": "Default button and Play, hovered" },
        { "key": "PrimaryButtonForegroundBrush", "type": "Brush", "group": "Buttons", "description": "Default button and Play text, when not TextBrushDark" },
        { "key": "ToggleButtonCheckedBackgroundBrush", "type": "Brush", "group": "Buttons", "description": "Toggle button, on" },

        { "key": "InputBackgroundBrush", "type": "Brush", "group": "Inputs", "required": true, "description": "Text box, password box, dropdown and search box fill" },
        { "key": "InputHoverBackgroundBrush", "type": "Brush", "group": "Inputs", "description": "Input fill, hovered" },
        { "key": "InputBorderBrush", "type": "Brush", "group": "Inputs", "description": "Input edge, when it is not the control edge" },
        { "key": "InputHoverBorderBrush", "type": "Brush", "group": "Inputs", "description": "Input edge, hovered" },
        { "key": "InputUnderlineBrush", "type": "Brush", "group": "Inputs", "description": "Input bottom edge" },
        { "key": "InputHoverUnderlineBrush", "type": "Brush", "group": "Inputs", "description": "Input bottom edge, hovered" },

        { "key": "CheckBoxBorderBrush", "type": "Brush", "group": "Controls", "description": "Check box and radio edge, when it is not the control edge" },
        { "key": "CheckBoxHoverBorderBrush", "type": "Brush", "group": "Controls", "description": "Check box and radio edge, hovered" },
        { "key": "CheckBoxCheckedHoverBackgroundBrush", "type": "Brush", "group": "Controls", "description": "Hover halo of a checked check box or radio" },
        { "key": "SliderTrackBrush", "type": "Brush", "group": "Controls", "description": "Slider rail" },
        { "key": "SliderThumbBackgroundBrush", "type": "Brush", "group": "Controls", "description": "Slider thumb fill" },
        { "key": "SliderThumbHoverBorderBrush", "type": "Brush", "group": "Controls", "description": "Slider thumb edge, hovered or dragged" },
        { "key": "SliderHoverForegroundBrush", "type": "Brush", "group": "Controls", "description": "Slider fill, hovered" },
        { "key": "ProgressBarForegroundBrush", "type": "Brush", "group": "Controls", "description": "Progress fill, when not the accent" },
        { "key": "ProgressBarTrackBrush", "type": "Brush", "group": "Controls", "required": true, "description": "Progress rail" },
        { "key": "ScrollBarThumbBrush", "type": "Brush", "group": "Controls", "required": true, "description": "Scroll bar thumb" },
        { "key": "ScrollBarThumbHoverBrush", "type": "Brush", "group": "Controls", "description": "Scroll bar thumb, hovered or dragged" },
        { "key": "ScrollBarTrackBrush", "type": "Brush", "group": "Controls", "description": "Scroll bar rail" },
        { "key": "ThumbBrush", "type": "Brush", "group": "Controls", "required": true, "description": "Thumbs outside the theme's scroll bars and sliders (the implicit Thumb style)" },
        { "key": "ThumbHoverBrush", "type": "Brush", "group": "Controls", "description": "Other thumbs, hovered or dragged" },
        { "key": "TabItemIndicatorBrush", "type": "Brush", "group": "Controls", "description": "Selected tab indicator, when not the accent" },
        { "key": "TabItemHoverIndicatorBrush", "type": "Brush", "group": "Controls", "description": "Tab indicator, hovered" },
        { "key": "TabControlHeaderBackgroundBrush", "type": "Brush", "group": "Controls", "description": "Tab strip fill" },
        { "key": "GridViewItemHoverBorderBrush", "type": "Brush", "group": "Controls", "required": true, "description": "Cover outline, hovered" },
        { "key": "GridViewItemSelectedBorderBrush", "type": "Brush", "group": "Controls", "description": "Cover outline, selected (the accent when a theme does not define it)" },
        { "key": "TopPanelItemHoverBackgroundBrush", "type": "Brush", "group": "Controls", "description": "Top bar view buttons, hovered" },
        { "key": "TopPanelItemCheckedBackgroundBrush", "type": "Brush", "group": "Controls", "description": "Top bar view buttons, on" },

        { "key": "MenuSeparatorBrush", "type": "Brush", "group": "Popups", "description": "Menu separator, when it is not the divider color" },
        { "key": "TooltipForegroundBrush", "type": "Brush", "group": "Popups", "description": "Tooltip text, when it is not the text color" },

        { "key": "CornerRadiusSmall", "type": "CornerRadius", "group": "Shape", "description": "Radius step below ControlCornerRadius" },
        { "key": "CornerRadiusLarge", "type": "CornerRadius", "group": "Shape", "description": "Radius step above ControlCornerRadius" },
        { "key": "CornerRadiusXLarge", "type": "CornerRadius", "group": "Shape", "description": "Radius step above CornerRadiusLarge" },
        { "key": "CornerRadiusFull", "type": "CornerRadius", "group": "Shape", "description": "Pill or circle" },
        { "key": "InputCornerRadius", "type": "CornerRadius", "group": "Shape", "description": "Input corners, when not ControlCornerRadius" },
        { "key": "InputBorderThickness", "type": "Thickness", "group": "Shape", "description": "Input edge, when not ControlBorderThickness" },
        { "key": "MainWindowInsetCornerGeometry", "type": "Geometry", "group": "Shape", "description": "Mask that rounds a corner of the inset content card" },

        { "key": "ButtonPadding", "type": "Thickness", "group": "Spacing", "required": true, "description": "Button" },
        { "key": "InputPadding", "type": "Thickness", "group": "Spacing", "required": true, "description": "Text box, password box, dropdown" },
        { "key": "MenuPadding", "type": "Thickness", "group": "Spacing", "required": true, "description": "Menu and context menu surface" },
        { "key": "MenuItemPadding", "type": "Thickness", "group": "Spacing", "required": true, "description": "Menu item" },
        { "key": "ComboBoxDropDownPadding", "type": "Thickness", "group": "Spacing", "required": true, "description": "Dropdown surface" },
        { "key": "ComboBoxItemPadding", "type": "Thickness", "group": "Spacing", "required": true, "description": "Dropdown item" },
        { "key": "ListBoxItemPadding", "type": "Thickness", "group": "Spacing", "required": true, "description": "List box item" },
        { "key": "GroupBoxPadding", "type": "Thickness", "group": "Spacing", "required": true, "description": "Group box (card) body" },
        { "key": "GroupBoxHeaderMargin", "type": "Thickness", "group": "Spacing", "description": "Gap under the group box header" },
        { "key": "GroupBoxHeaderPadding", "type": "Thickness", "group": "Spacing", "description": "Group box header, when it has its own band" },
        { "key": "GroupBoxHeaderFontSize", "type": "Double", "group": "Spacing", "description": "Group box title size", "themeModifier": "12,28" },
        { "key": "TooltipPadding", "type": "Thickness", "group": "Spacing", "required": true, "description": "Tooltip" },
        { "key": "IconSize", "type": "Double", "group": "Spacing", "required": true, "description": "Top bar and sidebar icon size", "themeModifier": "12,32" },

        { "key": "FocusVisual", "type": "Style", "group": "Styles", "required": true, "description": "Keyboard focus visual for buttons, toggles, tabs" },
        { "key": "CheckBoxFocusVisual", "type": "Style", "group": "Styles", "description": "Keyboard focus visual for check boxes and radios, when it differs" },
        { "key": "BareTextBox", "type": "Style", "group": "Styles", "required": true, "description": "Text box without chrome, for hosts that draw their own (search box, editable dropdown)" },
        { "key": "MainWindowButton", "type": "Style", "group": "Styles", "required": true, "description": "Main window minimize, maximize, close" },
        { "key": "MainMenuButton", "type": "Style", "group": "Styles", "required": true, "description": "Main menu button (PART_ElemMainMenu)" },
        { "key": "TopPanelSearchBox", "type": "Style", "group": "Styles", "required": true, "description": "Search box in the top bar" },
        { "key": "SliderRangeButton", "type": "Style", "group": "Styles", "required": true, "description": "Filled part of the slider track" },
        { "key": "SliderThumb", "type": "Style", "group": "Styles", "required": true, "description": "Slider thumb" },
        { "key": "ScrollBarThumb", "type": "Style", "group": "Styles", "required": true, "description": "Scroll bar thumb" },
        { "key": "MainWindowInsetCorner", "type": "Style", "group": "Styles", "description": "Corner mask path for an inset content card" },

        { "key": "IconTemplate", "type": "DataTemplate", "group": "Icons", "required": true, "description": "Draws an Icon* geometry in the inherited foreground" },
        { "key": "IconSmallTemplate", "type": "DataTemplate", "group": "Icons", "description": "Small variant of IconTemplate" },
        { "key": "IconSearch", "type": "Geometry", "group": "Icons", "required": true, "description": "Search" },
        { "key": "IconClear", "type": "Geometry", "group": "Icons", "required": true, "description": "Clear text" },
        { "key": "IconViewSettings", "type": "Geometry", "group": "Icons", "required": true, "description": "View settings" },
        { "key": "IconFilterPresets", "type": "Geometry", "group": "Icons", "required": true, "description": "Filter presets" },
        { "key": "IconGroup", "type": "Geometry", "group": "Icons", "required": true, "description": "Grouping" },
        { "key": "IconSort", "type": "Geometry", "group": "Icons", "required": true, "description": "Sorting" },
        { "key": "IconDetailsView", "type": "Geometry", "group": "Icons", "required": true, "description": "Details view" },
        { "key": "IconGridView", "type": "Geometry", "group": "Icons", "required": true, "description": "Grid view" },
        { "key": "IconListView", "type": "Geometry", "group": "Icons", "required": true, "description": "List view" },
        { "key": "IconUpdate", "type": "Geometry", "group": "Icons", "required": true, "description": "Update available" },
        { "key": "IconExplorer", "type": "Geometry", "group": "Icons", "required": true, "description": "Explorer panel" },
        { "key": "IconRandom", "type": "Geometry", "group": "Icons", "required": true, "description": "Random game" },
        { "key": "IconViewRandom", "type": "Geometry", "group": "Icons", "required": true, "description": "Random game from the view" },
        { "key": "IconFilter", "type": "Geometry", "group": "Icons", "required": true, "description": "Filter panel" },
        { "key": "IconNotifications", "type": "Geometry", "group": "Icons", "required": true, "description": "Notifications" },
        { "key": "IconMainMenu", "type": "Geometry", "group": "Icons", "required": true, "description": "Main menu" },
        { "key": "IconLibrary", "type": "Geometry", "group": "Icons", "required": true, "description": "Sidebar: library" },
        { "key": "IconStatistics", "type": "Geometry", "group": "Icons", "required": true, "description": "Sidebar: statistics" },
        { "key": "IconWindowMinimize", "type": "Geometry", "group": "Icons", "required": true, "description": "Window minimize" },
        { "key": "IconWindowMaximize", "type": "Geometry", "group": "Icons", "required": true, "description": "Window maximize" },
        { "key": "IconWindowRestore", "type": "Geometry", "group": "Icons", "required": true, "description": "Window restore" },
        { "key": "IconWindowClose", "type": "Geometry", "group": "Icons", "required": true, "description": "Window close" },
        { "key": "IconDropDown", "type": "Geometry", "group": "Icons", "description": "Dropdown indicator" },
        { "key": "IconSubmenu", "type": "Geometry", "group": "Icons", "description": "Submenu indicator" },
        { "key": "IconCheck", "type": "Geometry", "group": "Icons", "description": "Check mark (selected menu or dropdown item, check box)" },
        { "key": "IconAdd", "type": "Geometry", "group": "Icons", "description": "Add or save" },
        { "key": "IconEdit", "type": "Geometry", "group": "Icons", "description": "Edit or rename" },
        { "key": "IconRemove", "type": "Geometry", "group": "Icons", "description": "Remove or delete" }
    ]
}
